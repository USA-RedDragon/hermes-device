{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>USA-RedDragon/renovate-configs"
    ],
    "packageRules": [
        {
            "description": "Each Hermes release gets its own PR at once, so the Hermes compatibility check runs on it before the Flux upgrade PR is merged. Merge it by hand: see docs/hermes-upgrade.md in talaria-hub.",
            "matchPackageNames": [
                "NousResearch/hermes-agent"
            ],
            "groupName": null,
            "schedule": [
                "at any time"
            ],
            "minimumReleaseAge": "0 days",
            "dependencyDashboardApproval": false,
            "automerge": false
        }
    ]
}
