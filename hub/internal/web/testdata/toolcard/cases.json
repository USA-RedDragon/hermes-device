[
 {"name": "terminal ok", "call": {"name": "terminal", "args": {"command": "go test ./...\ngo vet ./..."}, "res": {"output": "ok", "exit_code": 0}, "out": "ok", "computer": "upstairs-pc"},
  "blocks": true, "want": {"icon": "terminal", "title": "Ran go test ./... go vet ./...", "status": "Exit 0 on upstairs-pc", "state": "ok", "blocks": ["Command", "Output"]}},
 {"name": "terminal without a computer", "call": {"name": "terminal", "args": {"command": "ls"}, "res": {"output": "a", "exit_code": 0}, "out": "a"},
  "want": {"icon": "terminal", "title": "Ran ls", "status": "Exit 0", "state": "ok"}},
 {"name": "terminal failing", "call": {"name": "terminal", "args": {"command": "false"}, "res": {"output": "", "exit_code": 1}, "failed": true, "computer": "upstairs-pc"},
  "want": {"icon": "terminal", "title": "Ran false", "status": "Exit 1 on upstairs-pc", "state": "bad"}},
 {"name": "terminal that could not run", "call": {"name": "terminal", "args": {"command": "x"}, "res": {"error": "Command timed out after 180 seconds"}, "failed": true},
  "want": {"icon": "terminal", "title": "Ran x", "status": "Failed: Command timed out after 180 seconds", "state": "bad"}},
 {"name": "terminal running", "call": {"name": "terminal", "args": {"command": "sleep 60"}, "done": false},
  "want": {"icon": "terminal", "title": "Running sleep 60", "status": "", "state": "run"}},
 {"name": "terminal in the background", "call": {"name": "terminal", "args": {"command": "make build", "background": true}, "res": {"output": "Background process started", "session_id": "proc_ab12", "exit_code": 0}, "computer": "upstairs-pc"},
  "want": {"icon": "terminal", "title": "Started in the background: make build", "status": "Running in the background", "state": "ok"}},
 {"name": "process kill names the command from the result", "call": {"name": "process_manage", "args": {"action": "kill", "session_id": "proc_ab12"}, "res": {"status": "killed", "command": "make build"}},
  "want": {"icon": "stop", "title": "Stopped background command make build", "status": "Stopped", "state": "ok"}},
 {"name": "process kill names the command from an earlier call", "learn": [{"name": "terminal", "args": {"command": "tail -f log", "background": true}, "res": {"session_id": "proc_cd34567890ab"}}],
  "call": {"name": "process_manage", "args": {"action": "kill", "session_id": "cd34"}, "res": {"status": "killed"}},
  "want": {"icon": "stop", "title": "Stopped background command tail -f log", "status": "Stopped", "state": "ok"}},
 {"name": "process kill falls back to the id", "call": {"name": "process_manage", "args": {"action": "kill", "session_id": "proc_zz"}, "res": {"status": "killed"}},
  "want": {"icon": "stop", "title": "Stopped background command proc_zz", "status": "Stopped", "state": "ok"}},
 {"name": "process kill of an exited command", "call": {"name": "process_manage", "args": {"action": "kill", "session_id": "p"}, "res": {"status": "already_exited", "command": "true", "exit_code": 0}},
  "want": {"icon": "stop", "title": "Stopped background command true", "status": "Exited 0", "state": "ok"}},
 {"name": "process wait that finished", "call": {"name": "process_manage", "args": {"action": "wait", "session_id": "p", "timeout": 60}, "res": {"status": "exited", "command": "sleep 5", "exit_code": 0}},
  "want": {"icon": "clock", "title": "Waited for background command sleep 5", "status": "Exited 0", "state": "ok"}},
 {"name": "process wait that timed out", "call": {"name": "process_manage", "args": {"action": "wait", "session_id": "p", "timeout": 38}, "res": {"status": "timeout", "command": "sleep 500"}},
  "want": {"icon": "clock", "title": "Waited for background command sleep 500", "status": "Still running after waiting 38 s", "state": "ok"}},
 {"name": "process wait running", "call": {"name": "process_manage", "args": {"action": "wait", "session_id": "p"}, "done": false},
  "want": {"icon": "clock", "title": "Waiting for background command p", "status": "", "state": "run"}},
 {"name": "process poll", "call": {"name": "process_manage", "args": {"action": "poll", "session_id": "p"}, "res": {"status": "running", "command": "npm start", "output_preview": "x"}},
  "want": {"icon": "activity", "title": "Checked background command npm start", "status": "Still running", "state": "ok"}},
 {"name": "process log", "call": {"name": "process_manage", "args": {"action": "log", "session_id": "p"}, "res": {"status": "exited", "command": "npm test", "output": "a\nb", "total_lines": 120, "exit_code": 1}},
  "want": {"icon": "list", "title": "Read the output of background command npm test", "status": "120 lines", "state": "ok"}},
 {"name": "process list", "call": {"name": "process_manage", "args": {"action": "list"}, "res": {"processes": [{"session_id": "a", "command": "x"}, {"session_id": "b", "command": "y"}]}},
  "want": {"icon": "list", "title": "Listed background commands", "status": "2 commands", "state": "ok"}},
 {"name": "process id that is no command", "call": {"name": "process_manage", "args": {"action": "kill", "session_id": "nope"}, "res": {"status": "not_found", "error": "No process with ID nope"}, "failed": true},
  "want": {"icon": "stop", "title": "Stopped background command nope", "status": "Failed: No process with ID nope", "state": "bad"}},
 {"name": "delegate spawn one", "call": {"name": "delegate_task", "args": {"goal": "measure the antenna", "context": "board rev B"}, "res": {"status": "dispatched", "mode": "background", "count": 1, "goals": ["measure the antenna"], "subagent_ids": ["sa-1"]}},
  "blocks": true, "want": {"icon": "bot", "title": "Started subagent: measure the antenna", "status": "Running in the background", "state": "ok", "blocks": ["Goal", "Context"]}},
 {"name": "delegate spawn several", "call": {"name": "delegate_task", "args": {"tasks": [{"goal": "a"}, {"goal": "b"}, {"goal": "c"}]}, "res": {"status": "dispatched", "count": 3}},
  "want": {"icon": "bot", "title": "Started 3 subagents", "status": "Running in the background", "state": "ok"}},
 {"name": "delegate steer names the goal", "learn": [{"name": "delegate_task", "args": {"goal": "measure the antenna"}, "res": {"goals": ["measure the antenna"], "subagent_ids": ["sa-1"]}}],
  "call": {"name": "delegate_task", "args": {"action": "steer", "subagent_id": "sa-1", "message": "use the VNA"}, "res": {"action": "steer", "subagent_id": "sa-1", "status": "queued"}},
  "blocks": true, "want": {"icon": "compass", "title": "Message to subagent: measure the antenna", "status": "Delivered at its next step", "state": "ok", "blocks": ["Message"]}},
 {"name": "delegate steer falls back to the id", "call": {"name": "delegate_task", "args": {"action": "steer", "subagent_id": "sa-9", "message": "x"}, "res": {"status": "queued"}},
  "want": {"icon": "compass", "title": "Message to subagent: sa-9", "status": "Delivered at its next step", "state": "ok"}},
 {"name": "delegate stop", "learn": [{"name": "delegate_task", "args": {}, "res": {"subagents": [{"subagent_id": "sa-2", "goal": "scan the logs"}]}}],
  "call": {"name": "delegate_task", "args": {"action": "stop", "subagent_id": "sa-2"}, "res": {"status": "interrupt_requested", "subagent_id": "sa-2"}},
  "want": {"icon": "stop", "title": "Stopped subagent: scan the logs", "status": "Stopped", "state": "ok"}},
 {"name": "delegate list", "call": {"name": "delegate_task", "args": {"action": "list"}, "res": {"action": "list", "count": 1, "subagents": [{"subagent_id": "sa-2", "goal": "g"}]}},
  "want": {"icon": "list", "title": "Listed subagents", "status": "1 subagent running", "state": "ok"}},
 {"name": "delegate steer that failed", "call": {"name": "delegate_task", "args": {"action": "steer", "subagent_id": "sa-3", "message": "x"}, "res": {"error": "No live subagent 'sa-3' in this conversation's spawn tree."}, "failed": true},
  "want": {"icon": "compass", "title": "Message to subagent: sa-3", "status": "Failed: No live subagent 'sa-3' in this conversation's spawn tree.", "state": "bad"}},
 {"name": "message to a chat", "call": {"name": "agent_send", "args": {"to": "build", "text": "hi"}, "res": {"message_id": "am_1", "to": "build", "delivery": "queued"}},
  "blocks": true, "want": {"icon": "mail", "title": "Message to chat build", "status": "Queued", "state": "ok", "blocks": ["Message"]}},
 {"name": "message to the parent", "call": {"name": "agent_send", "args": {"to": "parent", "text": "done"}, "res": {"message_id": "am_2", "to": "parent", "delivery": "delivered"}},
  "want": {"icon": "mail", "title": "Message to parent", "status": "Delivered", "state": "ok"}},
 {"name": "search files with matches", "call": {"name": "search_files", "args": {"pattern": "TODO", "path": "internal"}, "res": {"total_count": 3, "matches": [{"path": "a.go", "line": 1}, {"path": "a.go", "line": 2}, {"path": "b.go", "line": 3}]}},
  "want": {"icon": "search", "title": "Searched files for TODO in internal", "status": "3 matches in 2 files", "state": "ok"}},
 {"name": "search files by name", "call": {"name": "search_files", "args": {"pattern": "*.go", "target": "files"}, "res": {"total_count": 2, "files": ["a.go", "b.go"]}},
  "want": {"icon": "search", "title": "Searched files for *.go", "status": "2 files", "state": "ok"}},
 {"name": "search files with one match", "call": {"name": "search_files", "args": {"pattern": "x", "path": "."}, "res": {"total_count": 1, "matches": [{"path": "a", "line": 1}]}},
  "want": {"icon": "search", "title": "Searched files for x in .", "status": "1 match in 1 file", "state": "ok"}},
 {"name": "read a file", "call": {"name": "read_file", "args": {"path": "/home/u/Projects/app/main.go"}, "res": {"content": "     1|package main\n     2|\n     3|func main() {}\n", "total_lines": 3}},
  "want": {"icon": "file", "title": "Read main.go", "status": "3 lines", "state": "ok"}},
 {"name": "read a file that is missing", "call": {"name": "read_file", "args": {"path": "nope.txt"}, "res": {"error": "File not found: nope.txt"}, "failed": true},
  "want": {"icon": "file", "title": "Read nope.txt", "status": "Failed: File not found: nope.txt", "state": "bad"}},
 {"name": "patch with a diff", "call": {"name": "patch", "args": {"path": "internal/a.go", "old_string": "a", "new_string": "b\nc"}, "res": {"success": true}, "diff": "--- a/internal/a.go\n+++ b/internal/a.go\n@@ -1 +1,2 @@\n-a\n+b\n+c\n"},
  "want": {"icon": "edit", "title": "Edited internal/a.go", "status": "+2 -1", "state": "ok"}},
 {"name": "patch without a diff", "call": {"name": "patch", "args": {"path": "a.go", "old_string": "a\nb", "new_string": "c"}, "res": {"success": true}},
  "blocks": true, "want": {"icon": "edit", "title": "Edited a.go", "status": "+1 -2", "state": "ok", "blocks": ["Diff"]}},
 {"name": "patch in the patch format", "call": {"name": "patch", "args": {"mode": "patch", "patch": "*** Begin Patch\n*** Update File: src/x.go\n@@\n-a\n+b\n*** End Patch"}, "res": {"success": true}},
  "want": {"icon": "edit", "title": "Edited src/x.go", "status": "Done", "state": "ok"}},
 {"name": "write a file", "call": {"name": "write_file", "args": {"path": "notes.md", "content": "one\ntwo\nthree\n"}, "res": {"bytes_written": 14}},
  "want": {"icon": "filenew", "title": "Wrote notes.md", "status": "+3 -0", "state": "ok"}},
 {"name": "edit that failed", "call": {"name": "patch", "args": {"path": "a.go", "old_string": "zz", "new_string": "y"}, "res": {"error": "Could not find the text to replace"}, "failed": true},
  "want": {"icon": "edit", "title": "Edited a.go", "status": "Failed: Could not find the text to replace", "state": "bad"}},
 {"name": "web search", "call": {"name": "web_search", "args": {"query": "go 1.26 release"}, "res": {"data": {"web": [{"url": "a"}, {"url": "b"}]}}},
  "want": {"icon": "globe", "title": "Searched the web for go 1.26 release", "status": "2 results", "state": "ok"}},
 {"name": "web extract", "call": {"name": "web_extract", "args": {"urls": ["https://go.dev/doc/devel/release", "https://example.com/x"]}, "res": {"results": [{}, {}]}},
  "want": {"icon": "globe", "title": "Read go.dev and 1 more", "status": "2 pages", "state": "ok"}},
 {"name": "browser navigate", "call": {"name": "browser_navigate", "args": {"url": "https://example.com/a?b=1"}, "res": {"ok": true}},
  "want": {"icon": "globe", "title": "Opened example.com", "status": "Done", "state": "ok"}},
 {"name": "browser click that failed", "call": {"name": "browser_click", "args": {"ref": "e5"}, "res": {"error": "No such ref"}, "failed": true},
  "want": {"icon": "cursor", "title": "Clicked e5", "status": "Failed: No such ref", "state": "bad"}},
 {"name": "memory add", "call": {"name": "memory", "args": {"action": "add", "target": "user", "content": "x"}, "res": {"success": true}},
  "want": {"icon": "database", "title": "Saved to your profile", "status": "Done", "state": "ok"}},
 {"name": "skill view", "call": {"name": "skill_view", "args": {"name": "github"}, "res": {"success": true}},
  "want": {"icon": "book", "title": "Read skill github", "status": "Done", "state": "ok"}},
 {"name": "unknown tool", "call": {"name": "frobnicate", "args": {"target": "the widget", "n": 3}, "res": {"ok": true}},
  "want": {"icon": "tool", "title": "frobnicate: the widget", "status": "Done", "state": "ok"}},
 {"name": "unknown tool without arguments", "call": {"name": "frobnicate", "args": {}, "res": null},
  "want": {"icon": "tool", "title": "frobnicate", "status": "Done", "state": "ok"}},
 {"name": "unknown tool that failed", "call": {"name": "frobnicate", "args": {}, "res": null, "failed": true, "out": "Traceback: boom\nmore"},
  "want": {"icon": "tool", "title": "frobnicate", "status": "Failed: Traceback: boom", "state": "bad"}}
]
