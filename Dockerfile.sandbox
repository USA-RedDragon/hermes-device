# Agent sandbox: one per person, running "talaria run" as a service device
# (docs/protocol.md section 8.10). Works with a read-only root filesystem: HOME,
# caches and TMPDIR are on the /work volume.
#
# It has a browser of its own (docs/browser.md section 5.2): talaria run starts
# a headless Firefox ESR on a profile in /work and installs the Talaria
# extension in it, so the browser tools work here as on a computer. Alpine's
# firefox-esr runs on all three platforms and is the smallest build that
# supports the extension (tab groups need Firefox 139; ESR 140 has them).
FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

RUN apk add --no-cache \
      bash build-base ca-certificates coreutils curl fd git gzip jq less nodejs npm \
      openssh-client py3-pip python3 ripgrep tar tini unzip zstd \
      firefox-esr font-dejavu \
 && printf '%s\n' 'export PATH="/work/.local/bin:$PATH"' > /etc/profile.d/work-local-bin.sh \
 && addgroup -g 568 agent \
 && adduser -D -u 568 -G agent -h /work -s /bin/bash agent

ARG TARGETPLATFORM
COPY $TARGETPLATFORM/talaria /usr/local/bin/talaria
# The name before the rename, for pods and scripts that still run it.
RUN ln -s talaria /usr/local/bin/hermes-device

ENV HOME=/work \
    TMPDIR=/work/.cache/tmp \
    XDG_CACHE_HOME=/work/.cache \
    XDG_CONFIG_HOME=/work/.config \
    XDG_DATA_HOME=/work/.local/share \
    npm_config_prefix=/work/.local \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PATH=/work/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    TALARIA_DEVICE_ROOTS=/work \
    TALARIA_DEVICE_SHELL=bash \
    TALARIA_STORE_KEYRING=false \
    TALARIA_GATEWAY_SPLICE=false \
    TALARIA_BROWSER_ENABLED=true \
    TALARIA_BROWSER_HEADLESS=true \
    TALARIA_BROWSER_FIREFOX_COMMAND=firefox-esr \
    MOZ_CRASHREPORTER_DISABLE=1 \
    TALARIA_UPDATE_AUTO=false

USER 568:568
WORKDIR /work
VOLUME /work
ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/talaria", "run"]
