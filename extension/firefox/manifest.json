{
  "manifest_version": 2,
  "name": "Hermes browser control",
  "version": "0.2.0",
  "description": "Lets your Hermes agent use tabs in its own tab group, through the local hermes-device daemon.",
  "browser_specific_settings": {
    "gecko": {
      "id": "browser@hermes-device",
      "strict_min_version": "139.0",
      "update_url": "https://github.com/USA-RedDragon/hermes-device/releases/latest/download/updates.json",
      "data_collection_permissions": {"required": ["none"]}
    }
  },
  "permissions": ["nativeMessaging", "tabs", "tabGroups", "scripting", "webRequest", "webRequestBlocking", "dns", "identity", "storage", "<all_urls>"],
  "background": {"scripts": ["defaults.js", "hub.js", "background.js"], "persistent": true},
  "browser_action": {"default_title": "Hermes: not connected", "default_popup": "popup.html"},
  "options_ui": {"page": "options.html"}
}
