@@ -0,0 +1,167 @@
+"""``terminal.auto_background_seconds``: a foreground command still running after N seconds is
+handed to the process registry as a notify-on-complete background session (not killed), and the
+model is told its session_id and not to re-run it. Off by default; backends and sessions that
+cannot take the handoff keep the plain foreground wait.
+"""
+import json
+import re
+import threading
+import time
+
+import pytest
+
+from hermes_cli.config_defaults import DEFAULT_CONFIG
+from tools import process_registry_wait_policy as wait_policy
+from tools.process_registry import process_registry
+from tools.terminal_tool import _yield_kwargs, terminal_tool
+from tools.terminal_tool_background import auto_background_seconds
+
+pytestmark = pytest.mark.platforms("linux")
+
+
+@pytest.fixture
+def auto_bg(monkeypatch, tmp_path):
+    """Set ``terminal.auto_background_seconds`` for the test; completion delivery is possible."""
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(wait_policy, "_can_deliver_completion", lambda: True)
+
+    def set_seconds(value):
+        terminal = {} if value is None else {"auto_background_seconds": value}
+        monkeypatch.setattr(wait_policy, "_effective_config", lambda: {"terminal": terminal})
+    return set_seconds
+
+
+def test_default_is_off(auto_bg):
+    assert DEFAULT_CONFIG["terminal"]["auto_background_seconds"] == 0
+    auto_bg(None)
+    assert auto_background_seconds() is None
+    auto_bg(0)
+    assert auto_background_seconds() is None
+    auto_bg("not a number")
+    assert auto_background_seconds() is None
+
+
+def test_off_runs_in_the_foreground_until_exit(auto_bg):
+    auto_bg(0)
+    r = json.loads(terminal_tool("echo alpha; sleep 0.6; echo omega", task_id="auto-bg-off", timeout=30))
+    assert r["exit_code"] == 0
+    assert "alpha" in r["output"] and "omega" in r["output"]
+    assert "session_id" not in r and r.get("status") != "auto_backgrounded"
+
+
+def test_command_finishing_before_the_threshold_is_a_normal_result(auto_bg):
+    auto_bg(5)
+    t0 = time.monotonic()
+    r = json.loads(terminal_tool("echo quick", task_id="auto-bg-fast", timeout=30))
+    assert time.monotonic() - t0 < 5
+    assert r["exit_code"] == 0 and "quick" in r["output"]
+    assert "session_id" not in r and r.get("status") != "auto_backgrounded"
+
+
+@pytest.mark.live_system_guard_bypass
+def test_command_exceeding_the_threshold_moves_to_background(auto_bg):
+    """Real signal delivery is required for the cleanup kill (see test_terminal_yield_to_background)."""
+    auto_bg(0.5)
+    t0 = time.monotonic()
+    r = json.loads(terminal_tool("echo started; sleep 30; echo done", task_id="auto-bg-slow", timeout=60))
+    elapsed = time.monotonic() - t0
+    sid = r.get("session_id")
+    try:
+        assert elapsed < 10, elapsed
+        assert r["status"] == "auto_backgrounded"
+        assert r["exit_code"] is None and "started" in r["output"]
+        assert r["notify_on_complete"] is True
+        assert sid in r["note"] and "Do NOT re-run it" in r["note"]
+        after = re.search(r"still running after ([0-9.]+)s", r["note"])
+        assert after and 0.5 <= float(after.group(1)) < 10
+        session = process_registry.get(sid)
+        assert session is not None and session.notify_on_complete is True
+        assert process_registry.poll(sid)["status"] == "running"
+    finally:
+        if sid:
+            process_registry.kill_process(sid)
+    evt = process_registry.completion_queue.get(timeout=5)
+    assert evt["session_id"] == sid
+
+
+def test_threshold_at_or_above_timeout_is_ignored(auto_bg):
+    auto_bg(30)
+    kw = _yield_kwargs("sleep 1", 30, env_type="local", cwd="/", effective_task_id="t", task_id="t",
+                       session_key="")
+    assert "yield_handler" in kw and "yield_after" not in kw
+    auto_bg(5)
+    kw = _yield_kwargs("sleep 1", 30, env_type="local", cwd="/", effective_task_id="t", task_id="t",
+                       session_key="")
+    assert kw["yield_after"] == 5
+
+
+@pytest.mark.parametrize("env_type", ["docker", "ssh", "modal", "device"])
+def test_backends_without_handoff_keep_the_foreground_wait(auto_bg, env_type):
+    auto_bg(1)
+    assert _yield_kwargs("sleep 1", 30, env_type=env_type, cwd="/", effective_task_id="t", task_id="t",
+                         session_key="") == {}
+
+
+def test_session_that_cannot_receive_a_completion_stays_off(auto_bg, monkeypatch):
+    auto_bg(1)
+    monkeypatch.setattr(wait_policy, "_can_deliver_completion", lambda: False)
+    assert auto_background_seconds() is None
+
+
+@pytest.mark.parametrize("handler_result", ["decline", "raise"])
+def test_handler_that_cannot_take_the_process_falls_back_once(handler_result):
+    """A declined or failed handoff is not retried every poll, and the command still runs to its
+    natural exit exactly once (no kill, no second copy)."""
+    from tools.environments.local import LocalEnvironment
+
+    calls = []
+
+    def handler(proc, output_so_far):
+        calls.append(output_so_far)
+        if handler_result == "raise":
+            raise RuntimeError("cannot adopt")
+
+    env = LocalEnvironment()
+    try:
+        result = env.execute("echo alpha; sleep 0.8; echo omega", timeout=20, yield_handler=handler,
+                             yield_after=0.2)
+    finally:
+        env.cleanup()
+    assert result["returncode"] == 0
+    assert result["output"].count("alpha") == 1 and "omega" in result["output"]
+    assert len(calls) == 1 and "alpha" in calls[0]
+
+
+def test_yield_after_without_a_handler_is_inert():
+    from tools.environments.local import LocalEnvironment
+
+    env = LocalEnvironment()
+    try:
+        result = env.execute("sleep 0.4; echo omega", timeout=20, yield_after=0.1)
+    finally:
+        env.cleanup()
+    assert result["returncode"] == 0 and "omega" in result["output"]
+
+
+def test_user_yield_keeps_its_own_reason():
+    """A mid-command user message still hands over as a plain yield, not an auto-background."""
+    from tools import interrupt as interrupt_mod
+    from tools.environments.local import LocalEnvironment
+
+    env = LocalEnvironment()
+    procs = []
+
+    def handler(proc, output_so_far):
+        procs.append(proc)
+        return {"output": output_so_far, "returncode": None, "yielded_session_id": "proc_test"}
+
+    tid = threading.current_thread().ident
+    try:
+        interrupt_mod.request_yield(tid)
+        result = env.execute("sleep 5", timeout=20, yield_handler=handler, yield_after=30)
+        assert result["yield_reason"] == "user_message"
+    finally:
+        interrupt_mod.consume_yield(tid)
+        for proc in procs:
+            env._kill_process(proc)
+        env.cleanup()
