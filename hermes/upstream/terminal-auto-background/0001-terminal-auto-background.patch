+def auto_background_seconds() -> Optional[float]:
+    """``terminal.auto_background_seconds`` when a foreground command may be moved to the
+    background after that long, else None. 0 (the default) or an unreadable value is off, and so
+    is any session that cannot receive the completion notice (one-shot runs, cron, Kanban
+    workers, stateless API sessions, delegated subagents, notifications off): there the command
+    keeps running in the foreground until it exits or times out."""
+    from hermes_cli.config import cfg_get
+    from tools.process_registry_wait_policy import _can_deliver_completion, _effective_config
+    try:
+        seconds = float(cfg_get(_effective_config(), "terminal", "auto_background_seconds", default=0) or 0)
+        return seconds if seconds > 0 and _can_deliver_completion() else None
+    except Exception:
+        logger.debug("terminal.auto_background_seconds unreadable; auto-background off", exc_info=True)
+        return None
+
