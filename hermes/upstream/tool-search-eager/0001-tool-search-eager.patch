+    def test_eager_tool_and_toolset_never_defer(self, monkeypatch):
+        """tools.tool_search.eager keeps named tools, and every tool of a named toolset, out of
+        the bridge; a tool that defer names itself still defers inside an eager toolset."""
+        import tools.tool_search as ts
+        toolsets = {"mcp_notes_fetch": "mcp-notes", "mcp_notes_query": "mcp-notes",
+                    "web_open": "web-plugin", "web_tabs": "web-plugin", "other_tool": "other-plugin"}
+        monkeypatch.setattr(ts, "_registry_toolset", toolsets.get)
+        eager = frozenset({"mcp_notes_fetch", "web-plugin"})
+        assert not ts.is_deferrable_tool_name("mcp_notes_fetch", eager_tools=eager)
+        assert ts.is_deferrable_tool_name("mcp_notes_query", eager_tools=eager)
+        assert not ts.is_deferrable_tool_name("web_open", eager_tools=eager)
+        assert ts.is_deferrable_tool_name("other_tool", eager_tools=eager)
+        assert not ts.is_deferrable_tool_name(
+            "mcp_notes_fetch", frozenset({"mcp_notes_fetch"}), eager_tools=eager)
+        assert ts.is_deferrable_tool_name("web_tabs", frozenset({"web_tabs"}), eager_tools=eager)
+        assert ts.is_deferrable_tool_name("web_open", eager_tools=frozenset())
+
+        visible, deferred = ts.classify_tools([_td(n) for n in toolsets], eager_tools=eager)
+        assert {td["function"]["name"] for td in visible} == {"mcp_notes_fetch", "web_open", "web_tabs"}
+        assert {td["function"]["name"] for td in deferred} == {"mcp_notes_query", "other_tool"}
+
+    def test_eager_config_reaches_assembly_and_bridge_scope(self, monkeypatch):
+        """The configured eager list keeps a plugin toolset direct in the assembled tools array,
+        and tool_call refuses it with the call-it-directly correction."""
+        import tools.tool_search as ts
+        toolsets = {"web_open": "web-plugin", "other_tool": "other-plugin"}
+        monkeypatch.setattr(ts, "_registry_toolset", toolsets.get)
+        cfg = ts.ToolSearchConfig.from_raw({"enabled": "on", "eager": ["web-plugin"]})
+        monkeypatch.setattr(ts, "load_config_readonly", lambda: cfg)
+        defs = [_td("terminal", "Run shell"), _td("web_open", "Open a page"), _td("other_tool", "Other")]
+
+        names = {td["function"]["name"] for td in ts.assemble_tool_defs(
+            defs, context_length=200_000, config=cfg).tool_defs}
+        assert {"terminal", "web_open", ts.TOOL_SEARCH_NAME} <= names
+        assert "other_tool" not in names
+        assert ts.scoped_deferrable_names(defs) == frozenset({"other_tool"})
+        assert ts.is_deferrable_tool_name("other_tool")
+        assert not ts.is_deferrable_tool_name("web_open")
+
