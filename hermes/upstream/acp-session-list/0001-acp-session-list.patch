 cli-config.yaml.example                       |  5 +++
 hermes_cli/config_defaults.py                 |  3 ++
 .../test_gateway_catalog_sources.py           | 41 +++++++++++++++++++
 website/docs/user-guide/sessions.md           |  7 ++++
 5 files changed, 83 insertions(+), 3 deletions(-)
 create mode 100644 tests/acp_adapter/test_gateway_catalog_sources.py

