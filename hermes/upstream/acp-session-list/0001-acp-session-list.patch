index dee1cc402b..da967bb77d 100644
--- a/acp_adapter/catalog.py
+++ b/acp_adapter/catalog.py
@@ -8,7 +8,31 @@ from acp_adapter.session import (
 )
 
 
-def read_catalog_rows(path):
+DEFAULT_LIST_SOURCES = ("acp",)
+
+
+def list_sources(hermes_home):
+    """``sessions.acp_list_sources`` from *hermes_home*'s own config.yaml: the session sources
+    ``session/list`` offers (``hermes sessions list --source`` labels). The default when the key is
+    unset, empty or unreadable."""
+    from hermes_cli.config import load_config_readonly
+    from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+
+    token = set_hermes_home_override(str(hermes_home))
+    try:
+        sessions_cfg = load_config_readonly().get("sessions") or {}
+    except Exception:
+        return DEFAULT_LIST_SOURCES
+    finally:
+        reset_hermes_home_override(token)
+    raw = sessions_cfg.get("acp_list_sources") if isinstance(sessions_cfg, dict) else None
+    if isinstance(raw, str):
+        raw = [raw]
+    sources = tuple(dict.fromkeys(str(item).strip() for item in raw or () if str(item).strip()))
+    return sources or DEFAULT_LIST_SOURCES
+
+
+def read_catalog_rows(path, sources=DEFAULT_LIST_SOURCES):
     path = Path(path)
     if not path.exists():
         return {}
@@ -16,7 +40,7 @@ def read_catalog_rows(path):
     # The owner stores an editor thread as ``local`` with ``created_source='acp'``; the surface
     # reader matches both labels in SQL, before the LIMIT.
     with SessionDB(db_path=path, read_only=True) as db:
-        rows = SurfaceLabelReader(db).list_sessions_rich(source="acp", limit=1000)
+        rows = SurfaceLabelReader(db).list_sessions_rich(sources=list(sources), limit=1000)
         return {str(row["id"]): dict(row) for row in rows}
 
 
@@ -66,7 +90,7 @@ def catalog_sessions(path, cwd=None):
     normalized = _normalize_cwd_for_compare(cwd) if cwd else None
     owners = read_local_owners(path)
     results = {}
-    for sid, row in read_catalog_rows(path).items():
+    for sid, row in read_catalog_rows(path, list_sources(Path(path).parent)).items():
         # The listing projects a compressed chat's tip; the editor must hold the logical id.
         sid = row.get("_lineage_root_id") or sid
         sid = owners.get(sid, sid)
