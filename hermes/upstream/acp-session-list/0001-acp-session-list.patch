diff --git a/tests/acp_adapter/test_gateway_catalog_sources.py b/tests/acp_adapter/test_gateway_catalog_sources.py
new file mode 100644
index 0000000000..59637b79ec
--- /dev/null
+++ b/tests/acp_adapter/test_gateway_catalog_sources.py
@@ -0,0 +1,41 @@
+"""``sessions.acp_list_sources`` widens session/list to chats other surfaces started."""
+import pytest
+
+from acp_adapter.catalog import catalog_sessions
+from hermes_state import SessionDB
+
+
+def _store(home, workspace):
+    db_path = home / 'state.db'
+    with SessionDB(db_path) as db:
+        for sid, source, created in (('editor-thread', 'local', 'acp'), ('tui-chat', 'local', 'tui'),
+                                     ('desktop-chat', 'local', 'desktop'), ('hub-chat', 'gui', None),
+                                     ('cli-chat', 'local', 'cli'), ('telegram-chat', 'telegram', None)):
+            db.create_session(session_id=sid, source=source, cwd=str(workspace))
+            if created:
+                db._execute_write(lambda conn, sid=sid, created=created: conn.execute(
+                    'UPDATE sessions SET created_source = ? WHERE id = ?', (created, sid)))
+            db.append_message(sid, 'user', 'saved turn')
+        db.create_session(session_id='other-folder', source='tui', cwd=str(home / 'elsewhere'))
+        db.append_message('other-folder', 'user', 'saved turn')
+    return db_path
+
+
+def _listed(db_path, cwd):
+    return {row['session_id'] for row in catalog_sessions(db_path, cwd)}
+
+
+@pytest.mark.parametrize('config', [None, 'sessions:\n  show_subagents: false\n',
+                                    'sessions:\n  acp_list_sources: []\n'])
+def test_default_lists_editor_threads_only(tmp_path, config):
+    if config is not None:
+        (tmp_path / 'config.yaml').write_text(config)
+    assert _listed(_store(tmp_path, tmp_path), str(tmp_path)) == {'editor-thread'}
+
+
+def test_configured_sources_list_tui_desktop_and_cli_chats_in_the_folder(tmp_path):
+    (tmp_path / 'config.yaml').write_text('sessions:\n  acp_list_sources: [acp, tui, gui, cli]\n')
+    db_path = _store(tmp_path, tmp_path)
+    assert _listed(db_path, str(tmp_path)) == {'editor-thread', 'tui-chat', 'desktop-chat', 'hub-chat', 'cli-chat'}
+    assert 'other-folder' in _listed(db_path, None)
+    assert 'telegram-chat' not in _listed(db_path, None)
diff --git a/website/docs/user-guide/sessions.md b/website/docs/user-guide/sessions.md
index bf7c48f35c..7ca4de34aa 100644
--- a/website/docs/user-guide/sessions.md
+++ b/website/docs/user-guide/sessions.md
@@ -142,6 +142,13 @@ Each session is tagged with its source platform:
 
 A session compressed mid-conversation continues under the same source: the compression child of a `--source tool` or `oneshot` run is tagged the same way, so it inherits the same picker visibility.
 
+An ACP editor's session list offers only sessions an editor started. To also offer chats started in the TUI, Desktop or the CLI, list those sources in `sessions.acp_list_sources` (default `[acp]`). The editor's folder filter still applies:
+
+```yaml
+sessions:
+  acp_list_sources: [acp, tui, gui, cli]
+```
+
