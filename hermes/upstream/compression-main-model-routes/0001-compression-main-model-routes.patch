diff --git a/tests/agent/test_compression_main_model_route.py b/tests/agent/test_compression_main_model_route.py
new file mode 100644
index 0000000000..f4d1a886b6
--- /dev/null
+++ b/tests/agent/test_compression_main_model_route.py
@@ -0,0 +1,160 @@
+"""``auxiliary.compression.main_model_providers`` / ``main_model_when_larger``: chats that summarise on
+their own main model keep the main window's trigger, every other chat keeps the configured route."""
+
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from agent.auxiliary_task_config import session_auxiliary_scope
+from agent.context_compressor import ContextCompressor
+from agent.conversation_compression_feasibility import (
+    ensure_compression_feasibility_checked, revalidate_compression_feasibility,
+)
+from agent.conversation_compression_route import summarises_on_main_model
+from hermes_cli.config import DEFAULT_CONFIG
+from run_agent import AIAgent
+
+AUX_WINDOW = 131_072
+LOCAL = ("local-model", "custom", "http://localhost:11434/v1", 131_072)
+CLOUD = ("big-model", "acme-cloud", "https://api.example.com/v1", 1_000_000)
+
+
+def _aux_config(**extra):
+    return {"compression": {"provider": "custom", "model": "small-model", "base_url": "http://localhost:11434/v1",
+                            "context_length": AUX_WINDOW, **extra}}
+
+
+def _make_agent(route, threshold_percent=0.50) -> AIAgent:
+    model, provider, base_url, window = route
+    agent = AIAgent.__new__(AIAgent)
+    agent.model, agent.provider, agent.base_url = model, provider, base_url
+    agent.api_key, agent.api_mode = "sk-main", "chat_completions"
+    agent.quiet_mode = True
+    agent.log_prefix = ""
+    agent.compression_enabled = True
+    agent._print_fn = None
+    agent.suppress_status_output = False
+    agent._stream_consumers = []
+    agent._executing_tools = False
+    agent._mute_post_response = False
+    agent.status_callback = None
+    agent.tool_progress_callback = None
+    agent._compression_warning = None
+    agent._aux_compression_context_length_config = None
+    agent._custom_providers = []
+    agent.tools = []
+    agent._emit_status = lambda message: None
+    agent.context_compressor = ContextCompressor(
+        model, config_context_length=window, threshold_percent=threshold_percent, quiet_mode=True,
+        provider=provider, base_url=base_url, api_key="sk-main", api_mode="chat_completions",
+    )
+    return agent
+
+
+def _switch(agent, route):
+    model, provider, base_url, window = route
+    agent.model, agent.provider, agent.base_url = model, provider, base_url
+    agent.context_compressor.update_model(model, window, base_url=base_url, api_key="sk-main",
+                                          provider=provider, api_mode="chat_completions")
+    revalidate_compression_feasibility(agent)
+
+
+@pytest.fixture
+def aux_lookups():
+    client = MagicMock(base_url="http://localhost:11434/v1", api_key="")
+    with patch("agent.auxiliary_client.get_text_auxiliary_client", return_value=(client, "small-model")) as aux, \
+         patch("agent.model_metadata.get_model_context_length", return_value=AUX_WINDOW):
+        yield aux
+
+
+def _summary_call(compressor):
+    captured = {}
+
+    def _capture(**kwargs):
+        captured.update(kwargs)
+        response = MagicMock()
+        response.choices[0].message.content = "summary"
+        response.choices[0].finish_reason = "stop"
+        return response
+
+    with patch("agent.context_compressor.call_llm", side_effect=_capture):
+        compressor._call_summary_llm("prompt", 0.0)
+    return captured
+
+
+def test_defaults_keep_the_configured_route_and_the_aux_clamp(aux_lookups):
+    defaults = DEFAULT_CONFIG["auxiliary"]["compression"]
+    assert defaults["main_model_providers"] == [] and defaults["main_model_when_larger"] is False
+    agent = _make_agent(CLOUD)
+    with session_auxiliary_scope(_aux_config(main_model_providers=[], main_model_when_larger=False)):
+        agent._check_compression_model_feasibility()
+        assert agent.context_compressor.threshold_tokens == AUX_WINDOW
+        call = _summary_call(agent.context_compressor)
+    assert "provider" not in call and "model" not in call
+    assert call["task"] == "compression"
+
+
+def test_listed_provider_summarises_on_main_model_at_its_own_threshold(aux_lookups):
+    agent = _make_agent(CLOUD, threshold_percent=0.30)
+    with session_auxiliary_scope(_aux_config(main_model_providers=["ACME-Cloud"])):
+        agent._check_compression_model_feasibility()
+        compressor = agent.context_compressor
+        assert compressor.threshold_tokens == 300_000
+        assert compressor._aux_context_ceiling is None
+        aux_lookups.assert_not_called()
+        call = _summary_call(compressor)
+    assert (call["provider"], call["model"], call["base_url"], call["api_key"]) == (
+        "acme-cloud", "big-model", "https://api.example.com/v1", "sk-main")
+    assert getattr(call["task"], "route_authoritative", False) is True
+
+
+def test_unlisted_provider_keeps_the_aux_route(aux_lookups):
+    agent = _make_agent(LOCAL, threshold_percent=0.75)
+    with session_auxiliary_scope(_aux_config(main_model_providers=["acme-cloud"])):
+        agent._check_compression_model_feasibility()
+        assert agent.context_compressor.threshold_tokens == 98_304
+        call = _summary_call(agent.context_compressor)
+    assert "provider" not in call and "model" not in call
+
+
+@pytest.mark.parametrize("route,main_model", [(CLOUD, True), (LOCAL, False)])
+def test_when_larger_compares_the_main_window_with_the_measured_aux_window(aux_lookups, route, main_model):
+    agent = _make_agent(route)
+    compressor = agent.context_compressor
+    with session_auxiliary_scope(_aux_config(main_model_when_larger=True)):
+        assert summarises_on_main_model(compressor) is False
+        agent._check_compression_model_feasibility()
+        assert compressor._aux_context_window == AUX_WINDOW
+        assert summarises_on_main_model(compressor) is main_model
+        assert compressor._aux_context_ceiling is None
+        assert compressor.threshold_tokens == (500_000 if main_model else 98_304)
+        assert ("provider" in _summary_call(compressor)) is main_model
+
+
+def test_mid_session_switch_follows_the_current_provider(aux_lookups):
+    agent = _make_agent(LOCAL)
+    compressor = agent.context_compressor
+    with session_auxiliary_scope(_aux_config(main_model_providers=["acme-cloud"])):
+        agent._check_compression_model_feasibility()
+        _switch(agent, CLOUD)
+        assert compressor.threshold_tokens == 500_000
+        assert _summary_call(compressor)["model"] == "big-model"
+        _switch(agent, LOCAL)
+        assert compressor.threshold_tokens == 98_304
+        assert "model" not in _summary_call(compressor)
+
+
+def test_listing_a_provider_later_releases_an_installed_clamp(aux_lookups):
+    from agent.model_metadata import MINIMUM_CONTEXT_LENGTH
+
+    agent = _make_agent(CLOUD)
+    compressor = agent.context_compressor
+    with session_auxiliary_scope(_aux_config()):
+        ensure_compression_feasibility_checked(agent, MINIMUM_CONTEXT_LENGTH)
+        assert compressor.threshold_tokens == AUX_WINDOW
+        assert agent._compression_warning
+    with session_auxiliary_scope(_aux_config(main_model_providers="acme-cloud")):
+        ensure_compression_feasibility_checked(agent, MINIMUM_CONTEXT_LENGTH)
+    assert compressor.threshold_tokens == 500_000
+    assert compressor._aux_context_ceiling is None
+    assert agent._compression_warning is None
diff --git a/website/docs/user-guide/configuration.md b/website/docs/user-guide/configuration.md
index 84bd856e7e..a6d40794dd 100644
--- a/website/docs/user-guide/configuration.md
+++ b/website/docs/user-guide/configuration.md
@@ -1167,6 +1167,17 @@ auxiliary:
 ```
 Points at a custom OpenAI-compatible endpoint. Uses `OPENAI_API_KEY` for auth.
 
+**Keep large-context chats on their own model:**
+```yaml
+auxiliary:
+  compression:
+    model: qwen3:4b
+    base_url: http://localhost:11434/v1
+    main_model_providers: [anthropic, openrouter]  # these chats summarise on their own main model
+    main_model_when_larger: false                  # true: also any chat whose window is larger than the compression model's
+```
+A chat whose current main provider is in `main_model_providers` sends its compression summary to its own main model on its own endpoint, and its trigger follows its own window and `compression.threshold` (Hermes does not lower it to the compression model's window). With `main_model_when_larger: true` the same applies to any chat whose main context window is larger than the compression model's measured window. Every other chat uses the configured compression route. Hermes checks the chat's provider each time it compresses, so a chat switched to another model mid-session follows the new route. Both settings are off by default.
+
 ### How the three knobs interact
 
 | `auxiliary.compression.provider` | `auxiliary.compression.base_url` | Result |
