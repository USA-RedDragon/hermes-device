diff --git a/agent/conversation_compression_route.py b/agent/conversation_compression_route.py
new file mode 100644
index 0000000000..501cb3575c
--- /dev/null
+++ b/agent/conversation_compression_route.py
@@ -0,0 +1,86 @@
+"""Which model writes a chat's compression summary: the ``auxiliary.compression`` route, or the chat's own
+main model.
+
+``auxiliary.compression.main_model_providers`` lists main providers whose chats summarise on their own main
+model, and ``auxiliary.compression.main_model_when_larger`` does the same for a chat whose main window is
+larger than the compression model's measured window. Both are read when the feasibility probe runs and again
+when each summary is sent, so a chat switched to another provider mid-session follows its current route.
+A chat on its own main model keeps the main window's trigger (``compression.threshold``): the probe never
+lowers it to the compression model's window."""
+
+from __future__ import annotations
+
+import logging
+from typing import Any, Optional
+
+logger = logging.getLogger("agent.conversation_compression")
+
+
+def _main_model_settings() -> tuple[frozenset[str], bool]:
+    """``(main_model_providers, main_model_when_larger)`` as configured now; the defaults (no providers,
+    flag off) when config cannot be read, so every chat keeps the configured compression route."""
+    try:
+        from agent.auxiliary_task_config import _get_auxiliary_task_config
+        cfg = _get_auxiliary_task_config("compression")
+    except Exception:
+        logger.debug("Compression config unreadable; summarising on the configured route", exc_info=True)
+        return frozenset(), False
+    raw = cfg.get("main_model_providers") or []
+    if isinstance(raw, str):
+        raw = [raw]
+    providers = frozenset(str(p).strip().lower() for p in raw if str(p or "").strip())
+    return providers, cfg.get("main_model_when_larger") is True
+
+
+def main_model_route_identity() -> tuple:
+    """The main-model settings as part of the route the feasibility latch compares."""
+    providers, when_larger = _main_model_settings()
+    return (",".join(sorted(providers)), str(when_larger))
+
+
+def summarises_on_main_model(compressor: Any) -> bool:
+    """True when this chat's summary goes to its own main model instead of ``auxiliary.compression``: its
+    provider is listed, or ``main_model_when_larger`` is on and its window is larger than the compression
+    model's window the last probe measured (unmeasured: the configured route)."""
+    providers, when_larger = _main_model_settings()
+    provider = str(getattr(compressor, "provider", "") or "").strip().lower()
+    if provider and provider in providers:
+        return True
+    window = getattr(compressor, "_aux_context_window", None)
+    if not when_larger or not isinstance(window, int) or window <= 0:
+        return False
+    return int(getattr(compressor, "context_length", 0) or 0) > window
+
+
+def restore_main_window_trigger(compressor: Any) -> None:
+    """Drop an installed aux ceiling and recompute the trigger from the main window."""
+    if getattr(compressor, "_aux_context_ceiling", None) is None:
+        return
+    compressor._aux_context_ceiling = None
+    compressor.update_model(compressor.model, compressor.context_length, base_url=compressor.base_url,
+                            api_key=compressor.api_key, provider=compressor.provider,
+                            api_mode=compressor.api_mode)
+
+
+def keeps_main_model_summariser(agent: Any, aux_context: Optional[int] = None) -> bool:
+    """Record the compression model's measured window (None before the probe measures it) and report
+    whether this chat summarises on its own main model. When it does, an aux ceiling from an earlier probe
+    and its "auto-lowered" notice are dropped, so the trigger follows the main window again."""
+    compressor = agent.context_compressor
+    compressor._aux_context_window = aux_context
+    if not summarises_on_main_model(compressor):
+        return False
+    restore_main_window_trigger(compressor)
+    if getattr(agent, "_last_feasibility_notice", None) is not None:
+        agent._last_feasibility_notice = None
+        agent._compression_warning = None
+    return True
+
+
+def _aux_inherits_main_route(agent: Any, aux_model: str, aux_base_url: str) -> bool:
+    """True when the auxiliary compression client is the main model on the main endpoint."""
+    from hermes_cli.route_identity import normalize_route_base_url
+    if str(aux_model or "").strip().lower() != str(getattr(agent, "model", "") or "").strip().lower():
+        return False
+    main_base = normalize_route_base_url(str(getattr(agent, "base_url", "") or ""))
+    return not main_base or normalize_route_base_url(aux_base_url) == main_base
