+    """A client that handed the session back with a plain detach armed no orphan close: the turn does not
+    arm one either, so the row stays open as it was."""
+    runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
+    try:
+        _configure(authority, 'sessions:\n  unviewed_completion_turns: 5\n')
+        target = await _deliver(runner, authority, ref, _PROCESS)
+        seen = _turns(runner, authority, target)
+        await authority._drain(ref)
+        assert len(seen) == 1
+        assert authority.db.get_session(target)['ended_at'] is None
+        assert authority.orphan_closes == {}
+    finally:
+        authority.db.close()
