+    """A viewer that vanished is not the user closing the chat: the turn reopens the row, and the orphan
+    close is armed again so the row ends once the turn settles, as after any unviewed turn."""
+    runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
+    try:
+        _configure(authority, 'sessions:\n  unviewed_completion_turns: 5\n')
