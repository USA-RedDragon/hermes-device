+        await authority._drain(ref)
+        assert len(seen) == 1 and _notes(authority, target) == []
+        assert authority.db.get_session(target)['ended_at'] is None
+        assert ref.session_id in authority.orphan_closes
+    finally:
+        for handle in authority.orphan_closes.values():
+            handle.cancel()
+        authority.db.close()
