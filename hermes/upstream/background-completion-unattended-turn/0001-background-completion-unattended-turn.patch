diff --git a/tests/gateway/test_unviewed_completion_turns.py b/tests/gateway/test_unviewed_completion_turns.py
new file mode 100644
index 0000000000..4823095188
--- /dev/null
+++ b/tests/gateway/test_unviewed_completion_turns.py
@@ -0,0 +1,277 @@
+"""``sessions.unviewed_completion_turns``: a background process's exit runs as a turn with no viewer.
+
+#134889 LC-7 writes a completion for a local session no viewer is watching into it as a note, with no
+model call. An agent that started a long ``notify_on_complete`` job and ended its turn to wait then
+never resumes until someone attaches. With the opt-in set, the exit runs as the turn a viewer would
+have got, through the same FIFO: at most that many in a row with nobody watching, and never in a chat
+the user closed. The default keeps the note.
+"""
+from pathlib import Path
+
+import pytest
+
+from tests.gateway.test_session_end_delegations import _PROCESS, _admissions, _deliver, _local
+from tests.gateway.test_unviewed_completion_notes import _human, _process_event, _target, _turns
+from tools import async_delegation as delegation
+
+
+@pytest.fixture(autouse=True)
+def _no_delegations():
+    delegation._reset_for_tests()
+    yield
+    delegation._reset_for_tests()
+
+
+def _configure(authority, text):
+    (Path(authority.db.db_path).parent / 'config.yaml').write_text(text)
+
+
+def _notes(authority, target, marker='RESULT_'):
+    return [m for m in authority.db.get_messages(target)
+            if marker in str(m.get('content')) and (m.get('display_metadata') or {}).get('completion_note')]
+
+
+def _exit(runner, authority, ref, name):
+    """A finished ``notify_on_complete`` process, as the watcher hands it to the gateway."""
+    target = _target(runner, authority, ref)
+    return runner._deliver_completion_notification(f'[finished] RESULT_{name}',
+                                                   dict(_process_event(authority, ref, target, name)))
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('config', ['', 'sessions:\n  unviewed_completion_turns: 0\n',
+                                    'sessions:\n  unviewed_completion_turns: true\n'],
+                         ids=['unset', 'zero', 'bool'])
+async def test_default_keeps_the_note(tmp_path, monkeypatch, config):
+    runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
+    try:
+        _configure(authority, config)
+        target = await _deliver(runner, authority, ref, _PROCESS)
+
+        async def no_turn(event):
+            raise AssertionError('the default must not start a turn with no viewer')
+        runner._handle_message = no_turn
+        await authority._drain(ref)
+        assert len(_notes(authority, target)) == 1
+        assert [r['outcome'] for r in _admissions(authority, ref)] == ['completed']
+    finally:
+        authority.db.close()
+
+
+@pytest.mark.asyncio
+async def test_unviewed_exit_runs_as_a_turn_and_is_stored(tmp_path, monkeypatch):
+    """The turn is the ordinary one: its output lands in the session's history, where a viewer that
+    attaches later reads it, and no note is written for the same exit."""
+    runner, authority, ref, actor = await _local(tmp_path, monkeypatch)
+    try:
+        _configure(authority, 'sessions:\n  unviewed_completion_turns: 5\n')
+        target = await _deliver(runner, authority, ref, _PROCESS)
+        assert not authority.sessions[ref.session_id].subscribers
+        seen = []
+
+        async def turn(event):
+            seen.append(event.text)
+            authority.db.append_message(target, 'assistant', 'REACTED to the finished job')
+            return 'REACTED to the finished job'
+        runner._handle_message = turn
+        await authority._drain(ref)
+        assert seen == [f'[finished] RESULT_{_PROCESS[1]}']
+        assert _notes(authority, target) == []
+        assert [r['outcome'] for r in _admissions(authority, ref)] == ['completed']
+        snapshot = await authority.attach(actor, ref, history=True)
+        assert any('REACTED' in str(m.get('content')) for m in snapshot.history)
+    finally:
+        authority.db.close()
+
+
+@pytest.mark.asyncio
+async def test_viewer_attached_is_unchanged(tmp_path, monkeypatch):
+    runner, authority, ref, actor = await _local(tmp_path, monkeypatch)
+    try:
+        target = await _deliver(runner, authority, ref, _PROCESS)
+        authority.sessions[ref.session_id].subscribers['viewer'] = actor
+        seen = _turns(runner, authority, target)
+        await authority._drain(ref)
+        assert [text for text, _ in seen] == [f'[finished] RESULT_{_PROCESS[1]}']
+        assert _notes(authority, target) == []
+    finally:
+        authority.db.close()
+
+
+@pytest.mark.asyncio
+async def test_busy_session_runs_the_exit_after_the_running_input(tmp_path, monkeypatch):
+    """An exit that arrives while a turn holds the FIFO waits behind it; a second exit arriving
+    meanwhile folds into the queued one, so both reach the agent in one turn."""
+    runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
+    try:
+        _configure(authority, 'sessions:\n  unviewed_completion_turns: 5\n')
+        target = _target(runner, authority, ref)
+        _human(authority, ref, 'human', 'FIRST')
+        await _deliver(runner, authority, ref, _PROCESS)
+        assert await _exit(runner, authority, ref, 'proc_second') is True
+        assert [r['status'] for r in _admissions(authority, ref)] == ['terminal', 'queued']
+        seen = _turns(runner, authority, target)
+        await authority._drain(ref)
+        assert len(seen) == 2 and seen[0] == ('FIRST', 0)
+        assert all(f'RESULT_{name}' in seen[1][0] for name in (_PROCESS[1], 'proc_second'))
+        assert _notes(authority, target) == []
+    finally:
+        authority.db.close()
+
+
+@pytest.mark.asyncio
+async def test_unviewed_turns_stop_at_the_limit_until_the_user_returns(tmp_path, monkeypatch):
+    """An agent that relaunches a failing job on each exit would run itself without end: past the limit
+    the exit is a note, and the user's own message starts the count again."""
+    runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
+    try:
+        _configure(authority, 'sessions:\n  unviewed_completion_turns: 2\n')
+        target = _target(runner, authority, ref)
+        seen = _turns(runner, authority, target, 'proc_loop')
+        for i in range(4):
+            assert await _exit(runner, authority, ref, f'proc_loop{i}') is True
+            await authority._drain(ref)
+        assert [f'proc_loop{i}' in text for i, (text, _) in enumerate(seen)] == [True, True]
+        assert len(_notes(authority, target, 'proc_loop')) == 2
+        _human(authority, ref, 'back', 'what happened?')
+        await authority._drain(ref)
+        assert await _exit(runner, authority, ref, 'proc_loop_after') is True
+        await authority._drain(ref)
+        assert len(seen) == 4 and 'proc_loop_after' in seen[-1][0]
+    finally:
+        authority.db.close()
+
+
+@pytest.mark.asyncio
+async def test_attaching_a_viewer_counts_afresh(tmp_path, monkeypatch):
+    runner, authority, ref, actor = await _local(tmp_path, monkeypatch)
+    try:
+        _configure(authority, 'sessions:\n  unviewed_completion_turns: 1\n')
+        target = _target(runner, authority, ref)
+        seen = _turns(runner, authority, target, 'proc_seen')
+        assert await _exit(runner, authority, ref, 'proc_seen0') is True
+        await authority._drain(ref)
+        snapshot = await authority.attach(actor, ref, history=False)
+        await authority.detach(actor, snapshot.subscription_id)
+        assert await _exit(runner, authority, ref, 'proc_seen1') is True
+        await authority._drain(ref)
+        assert len(seen) == 2 and _notes(authority, target, 'proc_seen') == []
+    finally:
+        authority.db.close()
+
+
+@pytest.mark.asyncio
+async def test_count_survives_the_session_leaving_memory(tmp_path, monkeypatch):
+    """An idle session with no viewer is retired between exits and restored for the next one: the
+    in-a-row count is the authority's, so the limit still holds."""
+    runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
+    try:
+        _configure(authority, 'sessions:\n  unviewed_completion_turns: 1\n')
+        target = _target(runner, authority, ref)
+        seen = _turns(runner, authority, target, 'proc_gone')
+        assert await _exit(runner, authority, ref, 'proc_gone0') is True
+        await authority._drain(ref)
+        live = authority.sessions[ref.session_id]
+        authority.sessions[ref.session_id] = type(live)(source=live.source, route=live.route)
+        assert await _exit(runner, authority, ref, 'proc_gone1') is True
+        await authority._drain(ref)
+        assert len(seen) == 1 and len(_notes(authority, target, 'proc_gone')) == 1
+    finally:
+        authority.db.close()
+
+
+@pytest.mark.asyncio
+async def test_unreadable_config_keeps_the_note(tmp_path, monkeypatch):
+    import hermes_cli.config_effective as effective
+    runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
+    try:
+        _configure(authority, 'sessions:\n  unviewed_completion_turns: 5\n')
+        target = await _deliver(runner, authority, ref, _PROCESS)
+
+        def broken(*_args, **_kwargs):
+            raise OSError('config unreadable')
+        monkeypatch.setattr(effective, 'load_user_config_effective', broken)
+        seen = _turns(runner, authority, target)
+        await authority._drain(ref)
+        assert seen == [] and len(_notes(authority, target)) == 1
+        assert [r['outcome'] for r in _admissions(authority, ref)] == ['completed']
+    finally:
+        authority.db.close()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('closed', ['refused', 'pending_after_restart', 'ended'])
+async def test_chat_the_user_closed_keeps_the_note(tmp_path, monkeypatch, closed):
+    """Exit or /new ends the chat's work. The dispatch refusal says so in memory; after a restart only
+    the stored close (re-armed, still pending) or the row's end reason does."""
+    from gateway.session_viewer_close import _PendingClose
+    runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
+    try:
+        _configure(authority, 'sessions:\n  unviewed_completion_turns: 5\n')
+        target = await _deliver(runner, authority, ref, _PROCESS)
+        if closed == 'refused':
+            delegation.refuse_for_session((authority.profile_id, ref.session_id),
+                                          session_key=authority.sessions[ref.session_id].route)
+        elif closed == 'pending_after_restart':
+            authority.pending_closes[ref.session_id] = _PendingClose('tui_close')
+        else:
+            authority.db.end_session(target, 'cli_close')
+        seen = _turns(runner, authority, target)
+        await authority._drain(ref)
