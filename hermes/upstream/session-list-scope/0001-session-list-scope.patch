diff --git a/tests/gateway/test_session_list_audience.py b/tests/gateway/test_session_list_audience.py
new file mode 100644
index 0000000000..6bc151b01d
--- /dev/null
+++ b/tests/gateway/test_session_list_audience.py
@@ -0,0 +1,151 @@
+"""``session.list`` with an ``audience`` lists only what ``filter_session_list`` plugin hooks keep for it."""
+from types import SimpleNamespace
+
+import pytest
+
+from tests.gateway.test_session_mutation_model_busy import _owner
+
+
+def _judge(monkeypatch, keep):
+    """Register a ``filter_session_list`` callback that judges audience ``alice`` (keeping *keep*) and
+    abstains for every other one; returns the calls it saw."""
+    from hermes_cli import plugins
+    calls = []
+
+    def judge(audience, session_ids, **kwargs):
+        calls.append((audience, list(session_ids)))
+        if audience != 'alice':
+            return None
+        return [sid for sid in session_ids if sid in keep]
+    manager = plugins.get_plugin_manager()
+    monkeypatch.setattr(manager, '_discovered', True)
+    monkeypatch.setitem(manager._hooks, 'filter_session_list', [judge])
+    return calls
+
+
+@pytest.mark.asyncio
+async def test_live_listing_keeps_only_the_audience_sessions(tmp_path, monkeypatch):
+    from gateway.session_local import create_local_session
+    from gateway.session_local_recovery import transcript_target
+
+    async def handle(event):
+        return 'ok'
+    store, db, authority, owner, mine = _owner(tmp_path, monkeypatch, handle)
+    elsewhere = tmp_path / 'elsewhere'
+    elsewhere.mkdir()
+    other = create_local_session(authority, owner.actor, dict(request_id='o', source='gui', cwd=str(elsewhere),
+                                                              model='frozen', toolsets=[]))
+    try:
+        for ref, text in ((mine, 'mine'), (other, 'other')):
+            target = transcript_target(authority, ref)
+            db.append_message(target, 'user', f'{text} question')
+            db.append_message(target, 'assistant', f'{text} answer')
+            db.set_session_title(target, f'{text} chat')
+        calls = _judge(monkeypatch, {mine.session_id})
+
+        async def listing(**params):
+            reply = await owner.dispatch({'id': 1, 'method': 'session.list', 'params': params})
+            return reply.get('result', {}).get('sessions'), reply.get('error')
+
+        both = {mine.session_id, other.session_id}
+        sessions, _ = await listing()
+        assert {row['session_id'] for row in sessions} == both
+        assert calls == []  # no audience: no hook runs, the listing is unchanged
+        sessions, _ = await listing(audience='alice')
+        assert [row['session_id'] for row in sessions] == [mine.session_id]
+        assert calls[-1][0] == 'alice' and set(calls[-1][1]) == both
+        [row], _ = await listing(audience='alice', picker=True)
+        assert (row['session_id'], row['preview'], row['last_reply']) == (mine.session_id, 'mine question', 'mine answer')
+        sessions, _ = await listing(audience='alice', workspace=str(tmp_path), picker=True)
+        assert [row['session_id'] for row in sessions] == [mine.session_id]
+        # Params that widen a listing stay inside the audience.
+        assert (await listing(audience='alice', workspace=str(elsewhere), picker=True))[0] == []
+        assert (await listing(audience='alice', workspace=str(elsewhere)))[0] == []
+        sessions, _ = await listing(audience='alice', include_hidden=True, limit=200)
+        assert [row['session_id'] for row in sessions] == [mine.session_id]
+        assert (await listing(audience='alice', title='other chat'))[0] == []
+        [row], _ = await listing(audience='alice', title='mine chat')
+        assert row['session_id'] == mine.session_id
+        assert {row['session_id'] for row in (await listing(title='other chat'))[0]} == {other.session_id}
+    finally:
+        await owner.close()
+        store.close_all_db_handles()
+
+
+@pytest.mark.asyncio
+async def test_audience_nobody_judges_is_refused(tmp_path, monkeypatch):
+    async def handle(event):
+        return 'ok'
+    store, _db, _authority, owner, mine = _owner(tmp_path, monkeypatch, handle)
+    try:
+        async def error(**params):
+            reply = await owner.dispatch({'id': 1, 'method': 'session.list', 'params': params})
+            assert 'result' not in reply, reply
+            return reply['error']['data']
+
+        _judge(monkeypatch, {mine.session_id})
+        for params in ({'audience': 'bob'}, {'audience': 'bob', 'scope': 'stored'}, {'audience': 'bob', 'title': 'x'},
+                       {'audience': 'bob', 'picker': True, 'workspace': str(tmp_path)}):
+            assert (await error(**params))['field'] == 'audience', params
+        for bad in ('', 7, ['alice']):
+            assert (await error(audience=bad))['reason'] == 'invalid_params'
+
+        from hermes_cli import plugins
+
+        def broken(**kwargs):
+            raise RuntimeError('state unavailable')
+        plugins.get_plugin_manager()._hooks['filter_session_list'] = [broken]
+        assert (await error(audience='alice'))['field'] == 'audience'  # a failing judge fails closed
+    finally:
+        await owner.close()
+        store.close_all_db_handles()
+
+
+@pytest.mark.asyncio
+async def test_stored_listing_keeps_only_the_audience_rows(tmp_path, monkeypatch):
+    from gateway import run
+    from gateway.config import GatewayConfig
+    from gateway.session import SessionStore
+    from gateway.session_authority import initialize_session_authority
+    from gateway.session_controls import AuthorityConnection
+
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    monkeypatch.setattr(run, '_load_gateway_config', lambda: {'platform_toolsets': {'cli': []}})
+    store = SessionStore(tmp_path / 'sessions', GatewayConfig())
+    db = store._db
+    repo = tmp_path / 'repo'
+    for sid, cwd in (('mine', repo / 'pkg'), ('theirs', repo / 'pkg'), ('newest', tmp_path / 'other')):
+        db.create_session(sid, source='cli', model='m', cwd=str(cwd))
+        db.append_message(sid, 'user', f'{sid} question')
+        db.append_message(sid, 'assistant', f'{sid} answer')
+        db.end_session(sid, 'cli_exit')
+    db._write_sql('UPDATE sessions SET git_repo_root=? WHERE id IN (?, ?)', (str(repo), 'mine', 'theirs'))
+    runner = SimpleNamespace(session_store=store, _session_db=db, adapters={}, _draining=False,
+                             _cached_agent_for=lambda route: None)
+    runner._adapter_for_source = lambda source: runner.adapters.get(source.platform)
+    authority = await initialize_session_authority(runner, profile_id=str(tmp_path), instance_id='owner')
+    native = AuthorityConnection(authority, object(), {'provider': 'local', 'user_id': 'native',
+        'profile_id': str(tmp_path), 'instance_id': 'owner'})
+    try:
+        async def listing(**params):
+            reply = await native.dispatch({'id': 1, 'method': 'session.list', 'params': {'scope': 'stored', **params}})
+            assert 'result' in reply, reply
+            return [row['id'] for row in reply['result']['sessions']]
+
+        assert await listing() == ['newest', 'theirs', 'mine']
+        assert await listing(limit=1) == ['newest']
+        calls = _judge(monkeypatch, {'mine'})
+        assert await listing() == ['newest', 'theirs', 'mine'] and calls == []
+        # Judged before the page is cut: the audience's one row is the page, though two newer rows precede it.
+        assert await listing(audience='alice', limit=1) == ['mine']
+        assert len(calls) == 1  # one hook call for the whole page
+        assert await listing(audience='alice', workspace=str(repo)) == ['mine']
+        assert await listing(audience='alice', workspace=str(tmp_path / 'other')) == []
+        assert await listing(audience='alice', include_hidden=True) == ['mine']
+        reply = await native.dispatch({'id': 2, 'method': 'session.list', 'params': {
+            'scope': 'stored', 'audience': 'alice', 'workspace': str(repo), 'picker': True}})
+        [row] = reply['result']['sessions']
+        assert (row['id'], row['preview'], row['last_reply']) == ('mine', 'mine question', 'mine answer')
+    finally:
+        await native.close()
+        store.close_all_db_handles()
