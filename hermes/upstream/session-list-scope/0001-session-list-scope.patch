+    candidates = _stored_candidates(authority, actor, db, include_hidden, workspace)
     while len(sessions) < limit:
+        # A scoped page judges candidates in batches: one hook call per batch, not per row.
+        wanted = limit - len(sessions) if audience is None else max(limit - len(sessions), _AUDIENCE_BATCH)
+        batch = list(itertools.islice(candidates, wanted))
