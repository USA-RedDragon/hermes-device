+LIST_AUDIENCE_HOOK = 'filter_session_list'
+_AUDIENCE_BATCH = 50
+
+
+def visible_to(audience, session_ids):
+    """The ids among *session_ids* that *audience* may see, as the ``filter_session_list`` plugin hooks
+    judge them (a hook returns the ids it keeps, or None for an audience it does not judge). Every hook
+    that judges *audience* must keep an id. Fails closed: no hook judging *audience* is a refusal, so a
+    scoped listing never falls back to the unscoped one."""
+    from hermes_cli.plugins import invoke_hook
+    ids = list(dict.fromkeys(session_ids))
+    answers = [answer for answer in invoke_hook(LIST_AUDIENCE_HOOK, audience=audience, session_ids=list(ids))
+               if isinstance(answer, (list, tuple, set, frozenset))]
+    if not answers:
+        raise RuntimeStoreError('invalid_params', field='audience', detail='no plugin judges this audience')
+    kept = set(ids)
+    for answer in answers:
+        kept &= {sid for sid in answer if isinstance(sid, str)}
+    return kept
+
+
+def stored_picker_sessions(authority, actor, *, limit, include_hidden=False, workspace=None, picker=False,
+                           audience=None):
     """Offer legacy local rows only to the same native transport that may resume them.
 
     Canonical sessions are already in the live feed. Old local rows have no policy
     receipt until explicit resume; listing them must not claim or restore anything.
     *workspace*: only the folder's rows (``hermes -c``'s rule). *picker*: each row carries the picker
     fields, from the columns the listing already read (``gateway/session_picker_fields.py``).
+    *audience*: only the rows ``visible_to`` keeps for it, judged before the page is cut to *limit*.
     """
