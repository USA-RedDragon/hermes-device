+# Session project skills: a plugin that knows which project a chat works in (project-memory) registers a
+# provider. Its skills dir, kept in the Hermes home and written only through skill_manage, is a project
+# root for that chat and its subagents, so it needs no trust entry and no quarantine scan.
+_SKILLS_PROVIDER: Optional[tuple[Callable[[str], Optional[str]], Callable[[str], Optional[Path]],
+                                 Optional[Callable[[str], list[str]]]]] = None
+_SESSION_HINT: contextvars.ContextVar[Optional[str]] = contextvars.ContextVar("project_skills_session", default=None)
+_PROJECT_OVERRIDE: contextvars.ContextVar[Optional[str]] = contextvars.ContextVar(
+    "project_skills_project", default=None)
+
+
+def register_project_skills_provider(current: Callable[[str], Optional[str]],
+                                     skills_dir: Callable[[str], Optional[Path]],
+                                     terms: Optional[Callable[[str], list[str]]] = None) -> None:
+    """``current(session_id)`` is the slug of the session's project or None; ``skills_dir(slug)`` is that
+    project's skills dir (it need not exist yet); ``terms(slug)`` lists words that name the project (its
+    repository name, folders), which a global skill should not contain. The last registration wins."""
+    global _SKILLS_PROVIDER
+    _SKILLS_PROVIDER = (current, skills_dir, terms)
+
+
+@contextlib.contextmanager
+def project_skills_session(session_id: Optional[str]):
+    """Name the session whose project the skill lookups inside the block use, where the session context
+    variable is not bound yet (the prompt build) or belongs to another turn."""
+    token = _SESSION_HINT.set(session_id or None)
+    try:
+        yield
+    finally:
+        _SESSION_HINT.reset(token)
+
+
+@contextlib.contextmanager
+def project_skills_project(slug: Optional[str]):
+    """Use this project's skills inside the block whatever the session is: the replay of an approved
+    staged skill write, which runs with no chat."""
+    token = _PROJECT_OVERRIDE.set(slug or None)
+    try:
+        yield
+    finally:
+        _PROJECT_OVERRIDE.reset(token)
+
+
+def session_hint() -> Optional[str]:
+    return _SESSION_HINT.get()
+
+
+def _session_id_now() -> str:
+    if (hint := _SESSION_HINT.get()):
+        return hint
+    try:
+        from gateway.session_context import _SESSION_ID, _UNSET
+        value = _SESSION_ID.get()
+    except Exception:
+        return ""
+    return "" if value is _UNSET or not isinstance(value, str) else value
+
+
+def current_project_slug() -> Optional[str]:
+    """The slug of the project the current session works in, or None (no provider, no project, no session)."""
+    if (override := _PROJECT_OVERRIDE.get()):
+        return override
+    if _SKILLS_PROVIDER is None:
+        return None
+    session_id = _session_id_now()
+    if not session_id:
+        return None
+    try:
+        return _SKILLS_PROVIDER[0](session_id) or None
+    except Exception:
+        logger.debug("project skills provider failed", exc_info=True)
+        return None
+
+
+def session_project_skills_dir() -> Optional[Path]:
+    """The current project's skills dir (it may not exist yet), or None outside a project."""
+    if _SKILLS_PROVIDER is None or not (slug := current_project_slug()):
+        return None
+    try:
+        return _SKILLS_PROVIDER[1](slug)
+    except Exception:
+        logger.debug("project skills provider failed", exc_info=True)
+        return None
+
+
+def current_project_terms() -> list[str]:
+    """Words that name the current project, for the check that keeps a global skill generic."""
+    if _SKILLS_PROVIDER is None or _SKILLS_PROVIDER[2] is None or not (slug := current_project_slug()):
+        return []
+    try:
+        return [t for t in _SKILLS_PROVIDER[2](slug) if isinstance(t, str) and t]
+    except Exception:
+        logger.debug("project skills provider failed", exc_info=True)
+        return []
+
+
+def is_session_project_path(path) -> bool:
+    """True when *path* is inside the current project's skills dir."""
+    root = session_project_skills_dir()
+    if root is None:
+        return False
+    try:
+        return Path(path).resolve().is_relative_to(root.resolve())
+    except OSError:
+        return False
+
+
 def get_project_skills_dirs() -> list[Path]:
-    """Trusted project-local skill dirs for the current cwd (may be empty)."""
+    """Project skill dirs for the current session: the project's own dir from the registered provider
+    (when it exists), then the trusted project-local dirs of the cwd (may be empty)."""
     root = _current_project_root(trusted=True)
-    return _candidate_project_skills_dirs(root) if root is not None else []
+    dirs = _candidate_project_skills_dirs(root) if root is not None else []
+    own = session_project_skills_dir()
+    if own is not None and own.is_dir():
+        own = own.resolve()
+        dirs = [own, *[d for d in dirs if d != own]]
+    return dirs
 
 
