+"""Project skills and global skills: placement, visibility per project, name clashes, subagents."""
+
+import json
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+
+from agent import skill_utils
+from tools import skills_tool
+from tools.skill_manager_tool import SKILL_MANAGE_SCHEMA, skill_manage
+
+SESSIONS = {"chat-a": "proj-a", "child-a": "proj-a", "chat-b": "proj-b"}
+
+
+def _content(name, description="Use when testing.", body="Step 1: do it."):
+    return f"---\nname: {name}\ndescription: {description}\n---\n\n# {name}\n\n{body}\n"
+
+
+@pytest.fixture
+def env(tmp_path):
+    glob, projects = tmp_path / "skills", tmp_path / "projects"
+    glob.mkdir()
+    skill_utils.register_project_skills_provider(
+        SESSIONS.get, lambda slug: projects / slug / "skills",
+        lambda slug: {"proj-a": ["demo-app"], "proj-b": ["other"]}.get(slug, []))
+    with patch("tools.skill_manager_tool.SKILLS_DIR", glob), patch("tools.skills_tool.SKILLS_DIR", glob), \
+         patch("agent.skill_utils.get_all_skills_dirs", return_value=[glob]), \
+         patch("agent.skill_utils.get_skills_dir", return_value=glob), \
+         patch("tools.skill_overlap.configured_threshold", return_value=0.0):
+        yield glob, projects
+    skill_utils._SKILLS_PROVIDER = None
+
+
+def _manage(session, *ops):
+    return json.loads(skill_manage(action="", name="", operations=list(ops), session_id=session))
+
+
+def _create(session, name, scope=None, **kw):
+    op = {"action": "create", "name": name, "content": _content(name, **kw)}
+    if scope:
+        op["scope"] = scope
+    return _manage(session, op)
+
+
+def _names(session):
+    with skill_utils.project_skills_session(session):
+        found = json.loads(skills_tool.skills_list(task_id=None))
+    return {s["name"]: s.get("scope", "global") for s in found.get("skills", [])}
+
+
+def _view(session, name):
+    with skill_utils.project_skills_session(session):
+        return json.loads(skills_tool.skill_view(name))
+
+
+class TestPlacement:
+    def test_project_scope_lands_in_the_project_dir(self, env):
+        glob, projects = env
+        res = _create("chat-a", "demo-layout", "project")
+        assert res["success"], res
+        assert (projects / "proj-a" / "skills" / "demo-layout" / "SKILL.md").is_file()
+        assert not (glob / "demo-layout").exists()
+
+    def test_global_scope_lands_in_the_global_dir(self, env):
+        glob, projects = env
+        assert _create("chat-a", "flux-steps", "global")["success"]
+        assert (glob / "flux-steps" / "SKILL.md").is_file()
+        assert not (projects / "proj-a").exists()
+
+    def test_in_a_project_scope_is_required_on_create(self, env):
+        res = _create("chat-a", "demo-layout")
+        assert res["success"] is False and "scope" in res["error"]
+
+    def test_no_project_means_global_and_project_scope_is_refused(self, env):
+        glob, _ = env
+        assert _create("unbound", "plain-skill")["success"]
+        assert (glob / "plain-skill" / "SKILL.md").is_file()
+        res = _create("unbound", "x-skill", "project")
+        assert res["success"] is False and "no project" in res["error"].lower()
+
+    def test_bad_scope_value_is_refused(self, env):
+        assert _create("chat-a", "demo-layout", "team")["success"] is False
+
+    def test_global_skill_naming_the_project_gets_a_warning(self, env):
+        res = _manage("chat-a", {"action": "create", "name": "deploy-it", "scope": "global",
+                                 "content": _content("deploy-it", body="Run it in the demo-app repo.")})
+        assert res["success"]
+        assert "demo-app" in res["results"][0]["scope_warning"]
+
+    def test_project_skill_naming_the_project_is_fine(self, env):
+        res = _manage("chat-a", {"action": "create", "name": "deploy-it", "scope": "project",
+                                 "content": _content("deploy-it", body="Run it in the demo-app repo.")})
+        assert res["success"] and "scope_warning" not in res["results"][0]
+
+    def test_schema_documents_scope_and_placement_rule(self):
+        desc = SKILL_MANAGE_SCHEMA["description"]
+        assert "scope='project'" in desc and "generic" in desc
+        branches = SKILL_MANAGE_SCHEMA["parameters"]["properties"]["operations"]["items"]["anyOf"]
+        assert all("scope" in b["properties"] for b in branches)
+
+    def test_guidance_mentions_project_skills(self):
+        from agent.prompt_builder import SKILLS_GUIDANCE
+        from tools.memory_tool import MEMORY_SCHEMA
+        assert "project skill" in SKILLS_GUIDANCE and "generically" in SKILLS_GUIDANCE
+        assert "project skill" in MEMORY_SCHEMA["description"]
+
+    def test_edits_follow_the_skill_into_the_project_dir(self, env):
+        _, projects = env
+        _create("chat-a", "demo-layout", "project")
+        res = _manage("chat-a", {"action": "patch", "name": "demo-layout", "old_string": "do it",
+                                 "new_string": "do it well"})
+        assert res["success"] and res["results"][0]["scope"] == "project"
+        assert "do it well" in (projects / "proj-a" / "skills" / "demo-layout" / "SKILL.md").read_text()
+
+
+class TestVisibility:
+    def test_project_skill_is_listed_only_in_its_project(self, env):
+        _create("chat-a", "demo-layout", "project")
+        _create("chat-a", "generic-steps", "global")
+        assert _names("chat-a") == {"demo-layout": "project", "generic-steps": "global"}
+        assert _names("chat-b") == {"generic-steps": "global"}
+        assert _names("unbound") == {"generic-steps": "global"}
+
+    def test_project_skill_cannot_be_viewed_elsewhere(self, env):
+        _create("chat-a", "demo-layout", "project")
+        assert _view("chat-a", "demo-layout")["success"] is True
+        assert _view("chat-a", "demo-layout")["scope"] == "project"
+        assert _view("chat-b", "demo-layout")["success"] is False
+        assert _view("unbound", "demo-layout")["success"] is False
+
+    def test_global_skill_view_is_not_marked(self, env):
+        _create("chat-a", "generic-steps", "global")
+        assert "scope" not in _view("chat-a", "generic-steps")
+
+    def test_prompt_index_marks_project_skills_per_project(self, env):
+        from agent import prompt_builder as pb
+        _create("chat-a", "demo-layout", "project", description="Use when touching the demo layout.")
+        _create("chat-a", "generic-steps", "global")
+        with skill_utils.project_skills_session("chat-a"):
+            a = pb.build_skills_system_prompt(skills_dir_override=env[0])
+        with skill_utils.project_skills_session("chat-b"):
+            b = pb.build_skills_system_prompt(skills_dir_override=env[0])
+        assert "demo-layout: [project]" in a and "generic-steps" in a
+        assert "demo-layout" not in b and "generic-steps" in b
+
+    def test_project_skill_is_not_quarantined_or_trusted_by_path(self, env):
+        _, projects = env
+        _create("chat-a", "demo-layout", "project")
+        smd = projects / "proj-a" / "skills" / "demo-layout" / "SKILL.md"
+        with skill_utils.project_skills_session("chat-a"):
+            assert skill_utils.is_quarantined_project_skill(smd) is False
+
+
+class TestClash:
+    def test_project_skill_wins_in_its_project_only(self, env):
+        _create("chat-a", "shared-name", "global", description="Global one.")
+        _create("chat-a", "shared-name", "project", description="Project one.")
+        assert _view("chat-a", "shared-name")["description"] == "Project one."
+        assert _view("chat-b", "shared-name")["description"] == "Global one."
+        listing = _names("chat-a")
+        assert listing["shared-name"] == "project"
+
+    def test_edit_prefers_the_project_copy_and_scope_reaches_the_global_one(self, env):
+        glob, projects = env
+        _create("chat-a", "shared-name", "global")
+        _create("chat-a", "shared-name", "project")
+        _manage("chat-a", {"action": "patch", "name": "shared-name", "old_string": "do it", "new_string": "P"})
+        _manage("chat-a", {"action": "patch", "name": "shared-name", "scope": "global", "old_string": "do it",
+                           "new_string": "G"})
+        assert "P" in (projects / "proj-a" / "skills" / "shared-name" / "SKILL.md").read_text()
+        assert "G" in (glob / "shared-name" / "SKILL.md").read_text()
+
+    def test_create_clash_is_per_scope(self, env):
+        assert _create("chat-a", "shared-name", "global")["success"]
+        assert _create("chat-a", "shared-name", "project")["success"]
+        assert _create("chat-a", "shared-name", "project")["success"] is False
+
+
+class TestSubagents:
+    def test_subagent_sees_its_parents_project_skills(self, env):
+        _create("chat-a", "demo-layout", "project")
+        assert _names("child-a")["demo-layout"] == "project"
+        assert _view("child-a", "demo-layout")["success"] is True
+
+    def test_subagent_of_another_project_does_not(self, env):
+        _create("chat-a", "demo-layout", "project")
+        assert "demo-layout" not in _names("chat-b")
+
+    def test_tool_handlers_resolve_the_project_from_the_call_session(self, env):
+        _create("chat-a", "demo-layout", "project")
+        listed = json.loads(skills_tool._in_session("child-a", skills_tool.skills_list, task_id=None))
+        assert "demo-layout" in {s["name"] for s in listed["skills"]}
+        listed = json.loads(skills_tool._in_session("chat-b", skills_tool.skills_list, task_id=None))
+        assert "demo-layout" not in {s["name"] for s in listed["skills"]}
