--- /dev/null
+++ b/tests/agent/test_tool_outcome_metadata.py
@@ -0,0 +1,62 @@
+"""sessions.tool_outcome_metadata: a stored tool result carries how long its call ran and whether it failed."""
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from tests.agent.test_tool_call_incremental_persistence import (
+    _attach_real_session_db, _durable_messages, _make_agent, _mock_tool_call,
+)
+
+
+def _run(tmp_path, executor_mode, enabled, result):
+    agent = _make_agent()
+    db_path = Path(tmp_path) / "state.db"
+    db = _attach_real_session_db(agent, db_path, "outcome")
+    messages = [{"role": "user", "content": "look it up"},
+                {"role": "assistant", "content": "", "tool_calls": [
+                    {"id": "call-1", "type": "function", "function": {"name": "web_search", "arguments": "{}"}}]}]
+    agent._flush_messages_to_session_db(messages)
+    try:
+        with (patch("model_tools.handle_function_call", return_value=result),
+              patch("agent.tool_executor._tool_outcome_metadata_enabled", return_value=enabled),
+              patch("agent.tool_executor.maybe_persist_tool_result", side_effect=lambda **kw: kw["content"])):
+            getattr(agent, f"_execute_tool_calls_{executor_mode}")(
+                SimpleNamespace(content="", tool_calls=[_mock_tool_call(call_id="call-1")]), messages, "task-1")
+    finally:
+        db.close()
+    return messages[-1], _durable_messages(db_path, "outcome")[-1]
+
+
+@pytest.mark.parametrize("executor_mode", ["sequential", "concurrent"])
+def test_outcome_is_stored_with_the_result_when_on(tmp_path, executor_mode):
+    live, durable = _run(tmp_path, executor_mode, True, '{"error": "no network"}')
+    outcome = durable["display_metadata"]["tool_outcome"]
+    assert outcome["is_error"] is True and isinstance(outcome["duration_ms"], int) and outcome["duration_ms"] >= 0
+    assert live["display_metadata"]["tool_outcome"] == outcome
+    # The model never sees it: display_metadata is persistence-only.
+    assert '"tool_outcome"' not in durable["content"]
+
+
+@pytest.mark.parametrize("executor_mode", ["sequential", "concurrent"])
+def test_nothing_is_stored_when_off(tmp_path, executor_mode):
+    live, durable = _run(tmp_path, executor_mode, False, '{"results": []}')
+    assert "tool_outcome" not in (durable.get("display_metadata") or {})
+    assert "tool_outcome" not in (live.get("display_metadata") or {})
+
+
+def test_the_key_defaults_off_and_reads_the_config(monkeypatch):
+    from agent import tool_executor
+    from hermes_cli.config_defaults import DEFAULT_CONFIG
+
+    assert DEFAULT_CONFIG["sessions"]["tool_outcome_metadata"] is False
+    monkeypatch.setattr("hermes_cli.config.load_config", lambda: {"sessions": {"tool_outcome_metadata": True}})
+    assert tool_executor._tool_outcome_metadata_enabled() is True
+    monkeypatch.setattr("hermes_cli.config.load_config", lambda: {"sessions": {}})
+    assert tool_executor._tool_outcome_metadata_enabled() is False
+
+    def broken():
+        raise OSError("unreadable")
+    monkeypatch.setattr("hermes_cli.config.load_config", broken)
+    assert tool_executor._tool_outcome_metadata_enabled() is False
