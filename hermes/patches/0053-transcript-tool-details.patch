@@ -0,0 +1,92 @@
+"""``session.transcript`` with ``tool_details``: tool calls with their arguments and capped results, so a
+reader can show each call and what it returned after the turn (the hub's subagent view)."""
+import json
+
+import pytest
+
+from tests.gateway.test_session_mutation_model_busy import _owner
+
+
+async def _call(connection, method, **params):
+    return await connection.dispatch({'id': 1, 'method': method, 'params': params})
+
+
+def _seed(db, target):
+    db.append_message(target, 'user', 'count the rows')
+    db.append_message(target, 'assistant', '', tool_calls=[
+        {'id': 'call-a', 'type': 'function', 'function': {'name': 'terminal', 'arguments': json.dumps(
+            {'command': 'wc -l ' + 'x' * 40})}},
+        {'id': 'call-b', 'type': 'function', 'function': {'name': 'read_file', 'arguments': '{"path": "a.txt"}'}}])
+    db.append_message(target, 'tool', '{"output": "' + 'y' * 50 + '", "exit_code": 1}', tool_name='terminal',
+                      tool_call_id='call-a', display_metadata={'tool_outcome': {'duration_ms': 1200, 'is_error': True}})
+    db.append_message(target, 'tool', 'line one', tool_name='read_file', tool_call_id='call-b')
+    db.append_message(target, 'assistant', 'There are 3 rows.')
+
+
+@pytest.mark.asyncio
+async def test_tool_details_list_calls_and_cap_results(tmp_path, monkeypatch):
+    from gateway.session_local_recovery import transcript_target
+
+    async def handle(event):
+        return 'ok'
+    store, db, authority, owner, ref = _owner(tmp_path, monkeypatch, handle)
+    _seed(db, transcript_target(authority, ref))
+    reply = await _call(owner, 'session.transcript', session_id=ref.session_id, tool_details=30)
+    rows = reply['result']['rows']
+    assert [r['role'] for r in rows] == ['user', 'assistant', 'tool', 'tool', 'assistant'], rows
+    calls = rows[1]['tool_calls']
+    assert [(c['id'], c['name']) for c in calls] == [('call-a', 'terminal'), ('call-b', 'read_file')]
+    assert calls[0]['args'] == {'command': ('wc -l ' + 'x' * 40)[:30]}
+    assert rows[1]['text'] == '' and isinstance(rows[1]['row_id'], int)
+    first, second = rows[2], rows[3]
+    full = '{"output": "' + 'y' * 50 + '", "exit_code": 1}'
+    assert (first['result'], first['result_size']) == (full[:30], len(full))
+    assert first['display_metadata']['tool_outcome'] == {'duration_ms': 1200, 'is_error': True}
+    assert (second['result'], second['result_size'], second['tool_call_id']) == ('line one', 8, 'call-b')
+    assert 'tool_calls' not in rows[4]
+
+    # Without the option the rows are as before: no call-only assistant row, no results.
+    plain = (await _call(owner, 'session.transcript', session_id=ref.session_id))['result']['rows']
+    assert [r['role'] for r in plain] == ['user', 'tool', 'tool', 'assistant'], plain
+    assert not any('result' in r or 'tool_calls' in r for r in plain)
+
+
+@pytest.mark.asyncio
+async def test_a_page_after_the_call_lists_no_calls_again(tmp_path, monkeypatch):
+    """A page that starts at a result labels it from its earlier call without showing that call twice."""
+    from gateway.session_local_recovery import transcript_target
+
+    async def handle(event):
+        return 'ok'
+    store, db, authority, owner, ref = _owner(tmp_path, monkeypatch, handle)
+    _seed(db, transcript_target(authority, ref))
+    seen, cursor = [], None
+    for _ in range(10):
+        reply = (await _call(owner, 'session.transcript', session_id=ref.session_id, limit=2, tool_details=100,
+                             **({'cursor': cursor} if cursor else {})))['result']
+        if not reply['rows']:
+            break
+        seen += reply['rows']
+        cursor = reply['next_cursor']
