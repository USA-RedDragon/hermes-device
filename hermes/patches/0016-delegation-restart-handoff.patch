@@ -0,0 +1,500 @@
+"""Background subagents that survive a graceful gateway restart (``delegation.restart_handoff``).
+
+At dispatch, ``unit_handoff`` records what a later gateway needs to rebuild each child of a background unit:
+its stored session and ``subagent_id``, goal, context, role and the route it ran on (without secrets), plus the
+dispatching agent's route and session context. On a restart stop the gateway calls
+``async_delegation.hand_off_for_restart``: each child stops at a clean point (out of its tool call, or at the
+grace bound) and keeps its tool state, so the background processes it started are handed off with the gateway's
+own (``terminal.process_handoff_backends``). At the next gateway's start, ``resume_handed_off_delegations``
+rebuilds every unfinished child on its saved route and continues its stored transcript under the same delegation
+id. The unit then completes like any other: one completion event, the usual delivery.
+
+A tool call cut by the restart reads as interrupted in the child's transcript: the agent loop writes a cancelled
+result naming the gateway restart, and a call the process died inside gets a synthetic interrupted result here
+before the child continues.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import re
+import threading
+import time
+from dataclasses import replace
+from pathlib import Path
+from typing import Any, Callable, Optional
+
+from tools.delegate_tool_child_run import (
+    _close_child, _detach_child, _fabricated_entry, _release_handed_off_child, _signal_child_stop,
+)
+
+logger = logging.getLogger("tools.delegate_tool")  # log-record parity with the origin module
+
+RESTART_TOOL_REASON = "gateway restart"
+RESUME_MESSAGE = (
+    "[The gateway restarted while you were working on this task. Your conversation so far is above. A tool call "
+    "that was running when it stopped is marked as interrupted: check its effects before you run it again. "
+    "Check background processes you started with the process tool before you rely on them: some may have stopped "
+    "with the gateway. Continue the task.]"
+)
+CUT_TOOL_RESULT = (
+    "Interrupted by a gateway restart before it returned; its outcome is unknown. Check its effects before you "
+    "run it again."
+)
+_SPEC_VERSION = 1
+# Credential-like names: any "key", "secret", "password", "auth", "cookie" or "credential", or ending in a
+# singular "token" (``access_token``, but not ``max_tokens``).
+_SECRET_KEY = re.compile(r"key|secret|passw|auth|cookie|credential|token$", re.IGNORECASE)
+# The dispatching agent's fields a child's construction reads (tools/delegate_tool_config.py): never its key.
+_PARENT_FIELDS = (
+    "model", "provider", "requested_provider", "base_url", "api_mode", "acp_command", "acp_args", "enabled_toolsets",
+    "disabled_toolsets", "reasoning_config", "max_tokens", "openrouter_min_coding_score", "providers_allowed",
+    "providers_ignored", "providers_order", "provider_sort", "provider_require_parameters", "provider_data_collection",
+    "capabilities",
+)
+
+
+class _NotResumable(Exception):
+    """Why one child cannot be resumed; it is then reported interrupted, as without a handoff."""
+
+
+def _jsonable(value: Any) -> Any:
+    try:
+        return json.loads(json.dumps(value, default=str))
+    except (TypeError, ValueError):
+        return None
+
+
+def _strip_secrets(value: Any) -> tuple[Any, bool]:
+    """``(value without secret-named keys at any depth, whether any were dropped)``."""
+    if isinstance(value, dict):
+        out, dropped = {}, False
+        for key, item in value.items():
+            if isinstance(key, str) and _SECRET_KEY.search(key):
+                dropped = dropped or item not in (None, "")
+                continue
+            if key == "base_url" and isinstance(item, str) and "?" in item:
+                dropped = True  # a query string can carry a key
+                continue
+            out[key], inner = _strip_secrets(item)
+            dropped = dropped or inner
+        return out, dropped
+    if isinstance(value, list):
+        items = [_strip_secrets(item) for item in value]
+        return [item for item, _ in items], any(inner for _, inner in items)
+    return value, False
+
+
+# ── Dispatch: what the next gateway needs ───────────────────────────────────
+def unit_handoff(unit: Any, slot_key: Optional[str]) -> tuple[Optional[dict], Optional[Callable]]:
+    """``(spec, handoff_fn)`` for one background unit, or ``(None, None)`` when the unit is not handed off
+    (``delegation.restart_handoff`` off, a multiplexed secondary profile, or nothing usable to record)."""
+    from tools.delegate_tool_config import _get_restart_handoff, _get_worktree_isolation
+    if not _get_restart_handoff() or _get_worktree_isolation():
+        return None, None  # a child's isolated worktree is finalized when it stops: nothing to resume into
+    from hermes_constants import get_hermes_home, get_routing_process_hermes_home, hermes_home_key
+    if hermes_home_key(get_hermes_home()) != hermes_home_key(get_routing_process_hermes_home()):
+        return None, None  # only the launch profile's ledger is adopted at the next start
+    try:
+        spec = _unit_spec(unit, slot_key)
+    except Exception:
+        logger.warning("delegation.restart_handoff: could not record a background unit; it stops with the gateway",
+                       exc_info=True)
+        return None, None
+    return spec, _handoff_fn({i: child for i, _, child in unit.children})
+
+
+def _unit_spec(unit: Any, slot_key: Optional[str]) -> dict[str, Any]:
+    parent = unit.parent_agent
+    children = {}
+    for i, task, child in unit.children:
+        route = getattr(child, "_delegate_task_route", None)
+        if route is None:
+            raise ValueError(f"task {i} has no recorded route")
+        children[str(i)] = {
+            "goal": task["goal"], "context": task.get("context"), "role": task.get("role"),
+            "subagent_id": getattr(child, "_subagent_id", None), "session_id": getattr(child, "session_id", None),
+            "route": _route_spec(route),
+            "task": _jsonable({k: v for k, v in task.items() if k != "images"}),
+            "output_schema": _jsonable(getattr(child, "_delegate_output_schema", None)),
+            "images": _jsonable(list(getattr(child, "_delegate_images", None) or [])) or None,
+            "transcript": getattr(child, "_live_transcript_path", None),
+            "max_iterations": getattr(child, "max_iterations", None)}
+    return {
+        "version": _SPEC_VERSION, "parent": _parent_snapshot(parent), "session": _session_snapshot(parent),
+        "children": children, "top_role": unit.top_role, "max_children": unit.max_children,
+        "task_count": len(unit.task_list), "live_deleg_id": unit.live_deleg_id, "group": unit.group,
+        "slot_key": slot_key}
+
+
+def _route_spec(route: Any) -> dict[str, Any]:
+    """A route as the next gateway resolves it again: the provider's answer, never a credential. A route that
+    carried one is asked of the provider again at resume (``reask``)."""
+    from agent.delegation_provider import ROUTE_KEYS
+    spec: dict[str, Any] = {"backend": route.backend, "label": route.label}
+    if route.profile_home is not None:
+        return {**spec, "profile_home": str(route.profile_home)}
+    clean, dropped = _strip_secrets(
+        {k: v for k, v in (route.routing_cfg or {}).items() if k in ROUTE_KEYS and k != "label"})
+    return {**spec, "route": _jsonable(clean) or {}, **({"reask": True} if dropped else {})}
+
+
+def _parent_snapshot(parent: Any) -> dict[str, Any]:
+    from agent.prompt_cache_scope import conversation_id
+    from tools.delegate_tool_progress import _resolve_workspace_hint
+    snap = {name: _jsonable(getattr(parent, name, None)) for name in _PARENT_FIELDS}
+    overrides, dropped = _strip_secrets(_jsonable(getattr(parent, "request_overrides", None)) or {})
+    snap.update(
+        session_id=getattr(parent, "session_id", None), delegate_depth=getattr(parent, "_delegate_depth", 0),
+        subagent_id=getattr(parent, "_subagent_id", None), conversation_id=conversation_id(parent),
+        workspace=_resolve_workspace_hint(parent), request_overrides=None if dropped else overrides,
+        current_task_id=_jsonable(getattr(parent, "_current_task_id", None)))
+    from tools.delegate_tool_config import _inherit_parent_endpoint
+    live_url, _ = _inherit_parent_endpoint(parent, getattr(parent, "base_url", None), None)
+    if live_url:
+        snap["base_url"] = live_url  # the endpoint the parent's client calls, as an inheriting child takes it
+    chain, dropped = _strip_secrets(_jsonable(getattr(parent, "_fallback_chain", None)))
+    snap["fallback_chain"] = None if dropped else chain
+    if snap["enabled_toolsets"] is None and getattr(parent, "valid_tool_names", None):
+        snap["valid_tool_names"] = sorted(parent.valid_tool_names)
+    try:
+        from tools.terminal_tool import get_session_cwd
+        snap["cwd"] = get_session_cwd(getattr(parent, "_current_task_id", None))
+    except Exception:
+        snap["cwd"] = None
+    return snap
+
+
+def _session_snapshot(parent: Any) -> dict[str, str]:
+    """The dispatching turn's session context (platform, chat, user, route keys): what tools that route by the
+    conversation read, such as a device terminal backend. Child construction rebinds HERMES_SESSION_ID to the
+    child, so the parent's own id is stamped back."""
+    try:
+        from gateway.session_context import _SESSION_VARS
+    except Exception:
+        return {}
+    snap = {var.name: value for var in _SESSION_VARS if isinstance(value := var.get(), str)}
+    if getattr(parent, "session_id", None):
+        snap["HERMES_SESSION_ID"] = str(parent.session_id)
+    return snap
+
+
+def _bind_session(snapshot: dict[str, str]) -> None:
+    from gateway.session_context import _SESSION_VARS
+    for var in _SESSION_VARS:
+        if isinstance(snapshot.get(var.name), str):
+            var.set(snapshot[var.name])
+
+
+# ── Restart: stop each child at a clean point ───────────────────────────────
+def _in_tool(child: Any) -> bool:
+    try:
+        return bool(child.get_activity_summary().get("current_tool"))
+    except Exception:
+        return False
+
+
+def _child_state(child: Any) -> dict[str, Any]:
+    """What the child reached that only this process knows: its working directory and current session id."""
+    state: dict[str, Any] = {"session_id": getattr(child, "session_id", None)}
+    try:
+        from tools.delegate_tool_routes import child_profile_scope
+        from tools.terminal_tool import get_session_cwd
+        with child_profile_scope(child):
+            state["cwd"] = get_session_cwd(getattr(child, "_subagent_id", None))
+    except Exception:
+        pass
+    return state
+
+
+def _handoff_fn(children: dict[int, Any]) -> Callable[[float, dict], None]:
+    """Stop each child as soon as it is not inside a tool call, and every child by ``deadline``. A stopped child
+    keeps its tool state (``_release_handed_off_child``); a call cut at the deadline is cancelled with the reason
+    ``gateway restart``, which the child's transcript shows."""
+    def hand_off(deadline: float, state: dict) -> None:
+        pending = dict(children)
+        while pending:
+            last = time.monotonic() >= deadline
+            for index, child in list(pending.items()):
+                if last or not _in_tool(child):
+                    state[str(index)] = _child_state(child)
+                    child._delegate_restart_handoff = True
+                    _signal_child_stop(child, tool_reason=RESTART_TOOL_REASON)
+                    del pending[index]
+            if pending:
+                time.sleep(0.25)
+    return hand_off
+
+
+# ── Next gateway: resume ────────────────────────────────────────────────────
+def resume_handed_off_delegations() -> int:
+    """Gateway start: run every unit the previous gateway handed off. With ``delegation.restart_handoff`` now off,
+    each unit is delivered at once with its unfinished children interrupted, as without a handoff."""
+    from tools.async_delegation import adopt_handed_off_delegations
+    from tools.delegate_tool_config import _get_restart_handoff
+    return adopt_handed_off_delegations(_resume_unit if _get_restart_handoff() else _not_resumed)
+
+
+def _not_resumed(unit: dict) -> tuple:
+    from tools.async_delegation import _handoff_fallback_result
+    result = _handoff_fallback_result(
+        unit, unit["kept"], "Interrupted by a gateway restart; delegation.restart_handoff is off, so it was not resumed.")
+    return (lambda: result), None, None, None
+
+
+def _resume_unit(unit: dict) -> tuple:
+    if (unit.get("handoff") or {}).get("version") != _SPEC_VERSION:
+        raise ValueError("unknown restart handoff record")
+    resumed = _ResumedUnit(unit)
+    return resumed.run, resumed.interrupt, resumed.progress, resumed.hand_off
+
+
+class _ResumeParent:
+    """The dispatching agent as a resumed child's construction reads it, rebuilt from the handoff record. Its
+    credential is resolved again only for a child that inherits the parent's route (``inherit_endpoint``)."""
+
+    def __init__(self, snap: dict[str, Any], session_db: Any):
+        for name in _PARENT_FIELDS:
+            setattr(self, name, snap.get(name))
+        if snap.get("valid_tool_names"):
+            self.valid_tool_names = list(snap["valid_tool_names"])
+        self.session_id = snap.get("session_id")
+        self._delegate_depth = int(snap.get("delegate_depth") or 0)
+        self._subagent_id = snap.get("subagent_id")
+        self._inherited_conversation_id = snap.get("conversation_id")
+        self.terminal_cwd, self.cwd = snap.get("workspace"), None
+        self.request_overrides = dict(snap.get("request_overrides") or {})
+        self._fallback_chain = snap.get("fallback_chain")
+        self.api_key, self._client_kwargs, self.client, self._credential_pool = None, {}, None, None
+        self.prefill_messages, self._print_fn, self.tool_progress_callback = None, None, None
+        self._session_db, self._memory_manager = session_db, None
+        self._current_task_id = snap.get("current_task_id")
+        self._active_children, self._active_children_lock = [], threading.Lock()
+        self._interrupt_requested = False
+        self.session_estimated_cost_usd, self.session_cost_source, self.session_cost_status = 0.0, "none", "unknown"
+        self._endpoint_error: Optional[str] = None
+        self._endpoint_checked = False
+
+    def inherit_endpoint(self, required: bool) -> None:
+        """Resolve the parent's credential for its own endpoint. ``required`` (a child that inherits the whole
+        route) refuses the resume when that endpoint no longer resolves to the one the parent ran on."""
+        if not self._endpoint_checked:
+            self._endpoint_checked = True
+            try:
+                from hermes_cli.runtime_provider import resolve_runtime_provider
+                runtime = resolve_runtime_provider(requested=self.requested_provider or self.provider,
+                                                   target_model=self.model)
+                if str(runtime.get("base_url") or "").rstrip("/") != str(self.base_url or "").rstrip("/"):
+                    raise ValueError("the parent's endpoint resolves elsewhere now")
+                self.api_key = runtime.get("api_key") or None
+                self._client_kwargs = {"api_key": self.api_key, "base_url": self.base_url}
+            except Exception as exc:
+                self._endpoint_error = str(exc)
+        if required and self._endpoint_error:
+            raise _NotResumable(f"cannot resolve the parent's route again: {self._endpoint_error}")
+
+
+class _ResumedUnit:
+    """One adopted unit: rebuild its unfinished children, run them, join with the children that had finished."""
+
+    def __init__(self, unit: dict):
+        self.unit, self.spec, self.kept = unit, unit["handoff"], dict(unit["kept"])
+        self.delegation_id = unit["delegation_id"]
+        self.children: dict[int, Any] = {}
+        self._stopped = self._handing_off = False
+
+    def interrupt(self) -> None:
+        self._stopped = True
+        for child in list(self.children.values()):
+            _signal_child_stop(child, "Async delegation cancelled")
+
+    def progress(self) -> tuple:
+        from tools.delegate_tool_dispatch import _batch_progress_token
+        return _batch_progress_token(list(self.children.values()))
+
+    def hand_off(self, deadline: float, state: dict) -> None:
+        self._stopped = self._handing_off = True  # a child not built yet stays unfinished for the next gateway
+        _handoff_fn(dict(self.children))(deadline, state)
+
+    def run(self) -> dict[str, Any]:
+        from hermes_state_registry import acquire, release_or_close
+        _bind_session(self.spec.get("session") or {})
+        goals = list(self.unit.get("goals") or [])
+        indexes = list(self.unit.get("task_indexes") or range(len(goals)))
+        results: dict[int, dict] = {i: self.kept[i] for i in indexes if i in self.kept}
+        db = acquire()
+        try:
+            parent = _ResumeParent(self.spec.get("parent") or {}, db)
+            built = []
+            for i in (i for i in indexes if i not in results):
+                if self._stopped:
+                    break
+                child_spec = (self.spec.get("children") or {}).get(str(i))
+                try:
+                    if child_spec is None:
+                        raise _NotResumable("the handoff record has no entry for it")
+                    child = self._build(i, child_spec, parent, db)
+                except Exception as exc:
+                    logger.warning("Async delegation %s: task %d cannot be resumed: %s", self.delegation_id, i, exc)
+                    results[i] = _fabricated_entry(
+                        i, "interrupted", f"Interrupted by a gateway restart and could not be resumed: {exc}", None)
+                    continue
+                self.children[i] = child
+                built.append((i, {"goal": child_spec["goal"]}, child))
+            if self._stopped:  # stopped while building: nothing runs here
+                for _, _, child in built:
+                    _detach_child(parent, child)
+                    if self._handing_off:  # unfinished: its tool state stays for the next gateway
+                        child._delegate_restart_handoff = True
+                        _release_handed_off_child(child)
+                    else:
+                        _close_child(child, "Failed to close a resumed subagent that was stopped")
+                built = []
+            combined = self._execute(built, goals, parent) if built else {}
+        finally:
+            release_or_close(db)
+        for entry in combined.get("results") or []:
+            results[entry["task_index"]] = entry
+        for i in indexes:
+            results.setdefault(i, _fabricated_entry(i, "interrupted", "Stopped before it was resumed", None))
+        out = {**combined, "results": [results[i] for i in indexes],
+               "total_duration_seconds": round(time.time() - (self.unit.get("dispatched_at") or time.time()), 2)}
+        if self.spec.get("live_deleg_id"):
+            out["delegation_id"] = self.spec["live_deleg_id"]
+        if self.spec.get("group") is not None:
+            out["group"] = self.spec["group"]
+        return out
+
+    def _execute(self, built: list, goals: list, parent: Any) -> dict[str, Any]:
+        from tools.delegate_tool_dispatch import _Batch, _execute_and_aggregate
+        task_count = int(self.spec.get("task_count") or len(goals))
+        writers: list = [None] * task_count
+        paths: list = [""] * task_count
+        for i, _task, child in built:
+            if i < task_count:
+                writers[i] = getattr(child, "_delegate_live_writer", None)
+                paths[i] = getattr(child, "_live_transcript_path", None) or ""
+        batch = _Batch(
+            [{"goal": goals[i] if i < len(goals) else ""} for i in range(task_count)], built, parent,
+            {"model": None, "provider": None}, None, self.spec.get("top_role") or "leaf",
+            int(self.spec.get("max_children") or len(built)), self.spec.get("live_deleg_id"), writers, paths,
+            "", self.unit.get("origin_ui_session_id") or "", None, None, False, time.monotonic(),
+            group=self.spec.get("group"), unit_id=self.delegation_id)
+        combined = _execute_and_aggregate(batch, honor_parent_interrupt=False)
+        if combined.get("live_transcripts"):
+            combined["live_transcripts"] = [p for p in combined["live_transcripts"] if p]
+        for _, _, child in built:
+            _detach_child(parent, child)
+        return combined
+
+    def _build(self, index: int, spec: dict, parent: _ResumeParent, db: Any) -> Any:
+        from tools.delegate_tool import (
+            DEFAULT_MAX_ITERATIONS, _build_child_preserving_parent_tools, _load_config, _normalize_role, _route_overrides,
+        )
+        from tools.delegate_tool_sessions import stored_child_session
+        from tools.delegate_tool_tuning import pin_child_service_tier
+        from tools.delegation_output_schema import append_output_contract
+        subagent_id = spec.get("subagent_id")
+        session_id = (stored_child_session(db, subagent_id, [self.unit.get("parent_session_id") or ""])
+                      if subagent_id else None) or spec.get("session_id")
+        row = db.get_session(session_id) if session_id else None
+        if row is None:
+            raise _NotResumable("its stored session is missing")
+        if row.get("ended_at") and row.get("end_reason") != "compression":
+            db.reopen_session(session_id)
+        cut = _close_cut_tool_calls(db, session_id)
+        if cut:
+            logger.info("Async delegation %s: task %d had %d tool call(s) cut by the restart", self.delegation_id,
+                        index, cut)
+        history = db.get_messages_as_conversation(session_id, repair_alternation=True)
+        cfg = _load_config()
+        route = self._route(index, spec, parent, cfg)
+        schema = spec.get("output_schema")
+        context = append_output_contract(spec.get("context"), schema) if isinstance(schema, dict) else spec.get("context")
+        child = _build_child_preserving_parent_tools(
+            task_index=index, goal=spec["goal"], context=context, toolsets=None, model=route.creds["model"],
+            max_iterations=spec.get("max_iterations") or cfg.get("max_iterations", DEFAULT_MAX_ITERATIONS),
+            task_count=int(self.spec.get("task_count") or 1), parent_agent=parent,
+            role=_normalize_role(spec.get("role") or self.spec.get("top_role")),
+            resume_session_id=session_id, subagent_id=subagent_id, **_route_overrides(route))
+        pin_child_service_tier(child, route.creds)
+        if isinstance(schema, dict):
+            child._delegate_output_schema = schema
+        if spec.get("images") and not history:
+            child._delegate_images = list(spec["images"])
+        self._attach_transcript(index, spec, child)
+        if route.report() is not None:
+            child._delegate_route = route.report()
+        child._delegate_task_route = route
+        if live := self.spec.get("live_deleg_id"):
+            child._delegation_id = live
+            if isinstance(ident := getattr(child, "_progress_identity_ref", None), dict):
+                ident["delegation_id"] = live
+        # No stored turn means the child never started its conversation: it starts on its goal.
+        child._delegate_resume = {"cwd": spec.get("cwd"), **({"history": history, "message": RESUME_MESSAGE}
+                                                              if history else {})}
+        return child
+
+    def _attach_transcript(self, index: int, spec: dict, child: Any) -> None:
+        path = spec.get("transcript")
+        if not path:
+            return
+        from tools.delegation_live_log import LiveTranscriptWriter, wrap_progress_callback
+        writer = LiveTranscriptWriter.reopen(self.spec.get("live_deleg_id") or self.delegation_id, index, path)
+        if writer.path is not None and writer._ok:
+            child.tool_progress_callback = wrap_progress_callback(getattr(child, "tool_progress_callback", None), writer)
+            child._live_transcript_path = str(writer.path)
+            child._delegate_live_writer = writer
+
+    def _route(self, index: int, spec: dict, parent: _ResumeParent, cfg: dict) -> Any:
+        """The route the child ran on, from the record; the provider is asked again only for a route that carried
+        a credential, and its answer must match the recorded one."""
+        from tools.delegate_tool_routes import _profile_route, _route_to_task_route
+        saved = spec.get("route") or {}
+        backend, label = saved.get("backend") or "default", saved.get("label")
+        if saved.get("profile_home"):
+            return replace(_profile_route(Path(saved["profile_home"])), backend=backend, label=label)
+        route = dict(saved.get("route") or {})
+        if saved.get("reask"):
+            route = _ask_again(index, spec, route, backend, cfg)
+        if not route.get("profile"):
+            parent.inherit_endpoint(required=not route.get("provider") and not route.get("base_url"))
+        if label:
+            route["label"] = label
+        return _route_to_task_route(route, parent, {}, cfg, backend)
+
+
+def _ask_again(index: int, spec: dict, saved: dict, backend: str, cfg: dict) -> dict[str, Any]:
+    """Route a task again on its backend (under the parent's bound session context) and accept the answer only when
+    it is the recorded route plus the credentials the record left out."""
+    from tools.delegate_tool_routes import _active_provider, _declared_parameters, _route_one, _with_inherited_fallback
+    config = {**cfg, "backend": backend}
+    provider = _active_provider(config)
+    fresh = _with_inherited_fallback(
+        _route_one(provider, _declared_parameters(provider, config), index, spec.get("task") or {"goal": spec["goal"]},
+                   config), config)
+    if _jsonable(_strip_secrets({k: v for k, v in fresh.items() if k != "label"})[0]) != saved:
+        raise _NotResumable(f"delegation backend '{backend}' routes it differently now")
+    return {k: v for k, v in fresh.items() if k != "label"}
+
+
+def _close_cut_tool_calls(db: Any, session_id: str) -> int:
+    """A transcript that ends inside a tool round (the process died while the call ran) gets an interrupted result
+    for each unanswered call, so the child sees the cut instead of losing the call. Returns how many."""
+    messages = db.get_messages_as_conversation(session_id)
+    last = next((i for i in range(len(messages) - 1, -1, -1) if messages[i].get("role") != "tool"), None)
+    if last is None or messages[last].get("role") != "assistant" or not messages[last].get("tool_calls"):
+        return 0
+    answered = {str(m.get("tool_call_id") or "") for m in messages[last + 1:]}
+    cut = 0
+    for call in messages[last]["tool_calls"]:
+        call = call if isinstance(call, dict) else {}
+        call_id = str(call.get("id") or call.get("call_id") or "")
+        if not call_id or call_id in answered:
+            continue
+        name = (call.get("function") or {}).get("name") or call.get("name")
+        db.append_message(session_id, "tool", content=json.dumps({"status": "interrupted", "error": CUT_TOOL_RESULT}),
+                          tool_name=name, tool_call_id=call_id)
+        cut += 1
+    return cut
