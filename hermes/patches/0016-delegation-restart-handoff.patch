+        return 0
+    try:
+        from gateway.status import get_process_start_time
+        owner_started_at = get_process_start_time(os.getpid())
+    except Exception:
+        owner_started_at = None
+    now, claimed = time.time(), []
+    with _DB_LOCK, _transaction() as conn:
+        rows = conn.execute("""SELECT delegation_id, origin_session, origin_ui_session_id, parent_session_id,
+                      dispatched_at, task_json, origin_session_id, result_json
+               FROM async_delegations WHERE state='handed_off' ORDER BY dispatched_at, delegation_id""").fetchall()
+        for row in rows:
+            if conn.execute("""UPDATE async_delegations SET state='running', owner_pid=?, owner_started_at=?, updated_at=?
+                   WHERE delegation_id=? AND state='handed_off'""",
+                            (os.getpid(), owner_started_at, now, row[0])).rowcount:
+                claimed.append(row)
+    for delegation_id, session_key, origin_ui, parent_id, dispatched_at, task_json, origin_sid, result_json in claimed:
+        task, partial = _json_object(task_json), _json_object(result_json)
+        kept = {r["task_index"]: r for r in partial.get("results") or []
+                if isinstance(r, dict) and isinstance(r.get("task_index"), int)}
+        spec = task.get("handoff") if isinstance(task.get("handoff"), dict) else {}
+        record: dict[str, Any] = {
+            "delegation_id": delegation_id, "goal": task.get("goal", ""), "goals": list(task.get("goals") or []),
+            "context": task.get("context"), "toolsets": task.get("toolsets"), "role": task.get("role"),
+            "model": task.get("model"), "session_key": session_key or "", "origin_ui_session_id": origin_ui or "",
+            "origin_session_id": origin_sid or "", "parent_session_id": parent_id,
+            **{k: task[k] for k in _ROUTING_KEYS if task.get(k)},
+            "status": "running", "dispatched_at": dispatched_at or now, "completed_at": None, "is_batch": True,
+            "slot_key": spec.get("slot_key") or delegation_id, "handoff": spec,
+            **({"task_transcripts": dict(task["task_transcripts"])} if task.get("task_transcripts") else {}),
+            **({"task_indexes": list(task["task_indexes"])} if task.get("task_indexes") is not None else {}),
+            "_finished_children": dict(kept), "_context": contextvars.copy_context(),
+            "_progress_token": None, "_progress_ts": now, "_interrupted_at": None}
+        try:
+            runner, interrupt_fn, progress_fn, handoff_fn = make_runner({**record, "kept": dict(kept)})
+        except Exception as exc:
+            logger.warning("Async delegation %s: cannot resume after the restart", delegation_id, exc_info=True)
+            fallback = _handoff_fallback_result(record, kept, f"Could not be resumed after a gateway restart: {exc}")
+            runner, interrupt_fn, progress_fn, handoff_fn = (lambda f=fallback: f), None, None, None
+        record.update(interrupt_fn=interrupt_fn, progress_fn=progress_fn,
+                      **({"handoff_fn": handoff_fn} if callable(handoff_fn) else {}))
+        with _records_lock:
+            _records[delegation_id] = record
+            live_units = sum(1 for r in _records.values() if r.get("status") in _LIVE_STATES)
+        try:
+            _submit_worker(_get_executor(max(_DEFAULT_MAX_ASYNC_CHILDREN, live_units)), delegation_id, runner,
+                           _batch_status, _batch_crash, " batch", record["dispatched_at"])
+        except Exception as exc:  # pragma: no cover - pool submit failure is rare
+            logger.error("Async delegation %s: could not schedule the resumed unit", delegation_id, exc_info=True)
+            _finalize(delegation_id, _handoff_fallback_result(record, kept, f"Could not be resumed: {exc}"), "error")
+            continue
+        if progress_fn is not None:
+            _ensure_stale_monitor()
+        logger.info("Adopted background delegation %s from the previous gateway", delegation_id)
+    return len(claimed)
+
