+# ── Restart handoff (delegation.restart_handoff) ────────────────────────────
+# A child that stopped for the handoff with one of these is resumed by the next gateway; any other
+# entry (completed, or a failure of its own) is the child's result and is kept.
+_RESUMABLE_STATUSES = frozenset({"interrupted", "stalled"})
+
