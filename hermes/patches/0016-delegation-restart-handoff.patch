+def hand_off_for_restart(grace_seconds: float, timeout_seconds: float) -> int:
+    """Restart only: hand every running unit dispatched with a ``handoff`` to the next gateway; returns how many.
+
+    Each unit's row turns ``handed_off`` first, so a process killed from here on is still resumed. Its
+    ``handoff_fn(deadline, state)`` then stops each child at a clean point: out of its tool call, or at
+    ``grace_seconds`` at the latest. When the unit finalizes, children that finished keep their entries and the
+    others are left for the next gateway (``adopt_handed_off_delegations``). Waits up to ``timeout_seconds``."""
+    require_ledger_owner()
+    with _records_lock:
+        targets = [r for r in _records.values() if r.get("status") in _ACTIVE_STATES and callable(r.get("handoff_fn"))]
+        for record in targets:
+            record.update(_handoff=True, _handoff_state={},
+                          _handoff_finished=frozenset(record.get("_finished_children") or ()))
+    if not targets:
+        return 0
+    ids = [r["delegation_id"] for r in targets]
+    now = time.time()
+    with _DB_LOCK, _transaction() as conn:
+        for delegation_id in ids:
+            conn.execute("UPDATE async_delegations SET state='handed_off', updated_at=? "
+                         "WHERE delegation_id=? AND state='running'", (now, delegation_id))
+    deadline = time.monotonic() + max(0.0, grace_seconds)
+    for record in targets:
+        threading.Thread(target=_call_handoff, args=(record, deadline), daemon=True,
+                         name=f"async-delegate-handoff-{record['delegation_id']}").start()
+    end = time.monotonic() + max(grace_seconds, timeout_seconds)
+    while time.monotonic() < end:
+        with _records_lock:
+            if not any((_records.get(i) or {}).get("status") in _LIVE_STATES for i in ids):
+                break
+        time.sleep(0.2)
+    with _records_lock:
+        handed = sum(1 for i in ids if (_records.get(i) or {}).get("status") == "handed_off")
+        unsettled = sum(1 for i in ids if (_records.get(i) or {}).get("status") in _LIVE_STATES)
+    if unsettled:
+        logger.warning("Restart handoff: %d background delegation(s) did not stop in time; the next gateway "
+                       "resumes them from their stored transcripts", unsettled)
+    if handed:
+        logger.info("Handed %d background delegation(s) to the next gateway", handed)
+    return handed
+
+
+def _call_handoff(record: dict[str, Any], deadline: float) -> None:
+    fn, state = record.get("handoff_fn"), record.get("_handoff_state")
+    if not callable(fn):
+        return
+    try:
+        fn(deadline, state)
+    except Exception:
+        logger.warning("Async delegation %s: restart handoff failed to stop its children", record.get("delegation_id"),
+                       exc_info=True)
+
+
+def _hand_off_unit(record: dict[str, Any], result: dict[str, Any]) -> bool:
+    """Persist a unit stopped by ``hand_off_for_restart`` as ``handed_off``. False when nothing is left to resume
+    (every child finished) or the write fails: the unit is then delivered as usual."""
+    indexes = list(record.get("task_indexes") or range(len(record.get("goals") or [])))
+    entries = {r["task_index"]: r for r in result.get("results") or []
+               if isinstance(r, dict) and isinstance(r.get("task_index"), int)}
+    finished = record.get("_handoff_finished") or frozenset()
+    resume = [i for i in indexes
+              if i not in finished and (entries.get(i) or {}).get("status", "interrupted") in _RESUMABLE_STATUSES]
+    if not resume:
+        return False
+    kept = [redact_child_result(entries[i]) for i in indexes if i in entries and i not in resume]
+    try:
+        if not _persist_handoff(record["delegation_id"], kept, resume, record.get("_handoff_state") or {}):
+            logger.warning("Async delegation %s: another gateway owns it now; not delivered here",
+                           record.get("delegation_id"))
+            return True
+    except Exception:
+        logger.error("Async delegation %s: could not record the restart handoff; delivering it as interrupted",
+                     record.get("delegation_id"), exc_info=True)
+        return False
+    logger.info("Async delegation %s: %d child(ren) handed to the next gateway, %d finished",
+                record.get("delegation_id"), len(resume), len(kept))
+    return True
+
+
+def _persist_handoff(delegation_id: str, kept: list, resume: list, state: dict) -> bool:
+    """Record the handoff on the unit's row; False when this process no longer owns the row."""
+    now = time.time()
+    with _DB_LOCK, _transaction() as conn:
+        row = conn.execute("SELECT task_json FROM async_delegations WHERE delegation_id=?", (delegation_id,)).fetchone()
+        if row is None:
+            raise LookupError(delegation_id)
+        task = _json_object(row[0])
+        spec = task.get("handoff") if isinstance(task.get("handoff"), dict) else {}
+        children = spec.get("children") if isinstance(spec.get("children"), dict) else {}
+        for key, extra in state.items():
+            if isinstance(children.get(key), dict) and isinstance(extra, dict):
+                children[key].update(extra)
+        task["handoff"] = {**spec, "children": children, "resume": list(resume), "handed_off_at": now}
+        return bool(conn.execute("""UPDATE async_delegations SET state='handed_off', updated_at=?, task_json=?,
+                      result_json=?
+               WHERE delegation_id=? AND state IN ('running','finalizing','handed_off') AND owner_pid=?""",
+                     (now, json.dumps(task), json.dumps({"results": kept, "partial": True}), delegation_id,
+                      os.getpid())).rowcount)
+
+
+def _handoff_fallback_result(record: dict[str, Any], kept: dict, error: str) -> dict[str, Any]:
+    """Combined result for an adopted unit that cannot run: the kept entries, every other child interrupted."""
+    indexes = record.get("task_indexes") or range(len(record.get("goals") or []))
+    return {"results": [kept.get(i) or {"task_index": i, "status": "interrupted", "summary": None, "error": error,
+                                        "api_calls": 0, "duration_seconds": 0} for i in indexes]}
+
+
+def adopt_handed_off_delegations(make_runner: Callable[[dict], tuple]) -> int:
+    """Gateway start: claim this home's ``handed_off`` units and run each as a live unit of this process.
+
+    ``make_runner(unit)`` receives the unit's record fields plus ``kept`` (task_index -> entry of a child that
+    already finished) and returns ``(runner, interrupt_fn, progress_fn, handoff_fn)``. The runner's combined result
+    finalizes the unit like a first run: one completion event and the usual delivery. The claim is one conditional
+    update, so two processes never both adopt a unit. Returns how many were adopted."""
+    require_ledger_owner()
