diff --git a/tests/tools/test_delegation_restart_handoff.py b/tests/tools/test_delegation_restart_handoff.py
new file mode 100644
index 0000000000..275c8cbecb
--- /dev/null
+++ b/tests/tools/test_delegation_restart_handoff.py
@@ -0,0 +1,500 @@
+"""delegation.restart_handoff: background subagents survive a graceful gateway restart.
+
+The old gateway stops each child at a clean point and leaves the unit ``handed_off`` in the ledger (children that
+finished keep their entries); the next gateway adopts it and resumes the rest from their stored transcripts under
+the same delegation id. Two registry lifetimes are simulated with ``_reset_for_tests`` over one real ``state.db``;
+the child runner and child agents are fakes.
+"""
+
+import json
+import queue
+import sqlite3
+import subprocess
+import sys
+import threading
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_constants import get_hermes_home
+from tests.waiting import wait_until
+from tools import async_delegation as ad
+from tools import delegate_tool_handoff as handoff
+from tools.process_registry import process_registry
+
+PARENT = "parent-sid"
+ROUTE_KEY = "agent:main:telegram:dm:alice"
+
+
+@pytest.fixture(autouse=True)
+def _clean_state():
+    ad._reset_for_tests()
+    _drain(process_registry.completion_queue)
+    yield
+    ad._reset_for_tests()
+    _drain(process_registry.completion_queue)
+
+
+def _drain(q) -> list:
+    items = []
+    while True:
+        try:
+            items.append(q.get_nowait())
+        except queue.Empty:
+            return items
+
+
+def _completions(delegation_id: str) -> list:
+    return [e for e in _drain(process_registry.completion_queue)
+            if isinstance(e, dict) and e.get("type") == "async_delegation" and e.get("delegation_id") == delegation_id]
+
+
+def _row(delegation_id: str) -> dict:
+    conn = sqlite3.connect(get_hermes_home() / "state.db")
+    try:
+        conn.row_factory = sqlite3.Row
+        return dict(conn.execute("SELECT * FROM async_delegations WHERE delegation_id=?", (delegation_id,)).fetchone())
+    finally:
+        conn.close()
+
+
+def _set_row(delegation_id: str, **cols) -> None:
+    conn = sqlite3.connect(get_hermes_home() / "state.db")
+    try:
+        conn.execute(f"UPDATE async_delegations SET {', '.join(f'{k}=?' for k in cols)} WHERE delegation_id=?",
+                     (*cols.values(), delegation_id))
+        conn.commit()
+    finally:
+        conn.close()
+
+
+def _dead_pid() -> int:
+    proc = subprocess.Popen([sys.executable, "-c", "pass"])
+    proc.wait()
+    return proc.pid
+
+
+def _entry(i: int, status: str, summary=None) -> dict:
+    return {"task_index": i, "status": status, "summary": summary, "api_calls": 1, "duration_seconds": 1}
+
+
+def _spec(n: int) -> dict:
+    return {"version": 1, "parent": {"session_id": PARENT}, "task_count": n, "live_deleg_id": "deleg_call",
+            "children": {str(i): {"goal": f"task {i}", "subagent_id": f"sa-{i}-0000", "session_id": f"child-{i}",
+                                  "route": {"backend": "default", "route": {}}} for i in range(n)}}
+
+
+def _dispatch(runner, handoff_fn, n=3, delegation_id="deleg_call"):
+    handle = ad.dispatch_async_delegation_batch(
+        goals=[f"task {i}" for i in range(n)], context=None, toolsets=None, role="leaf", model="m",
+        session_key=ROUTE_KEY, parent_session_id=PARENT, runner=runner, delegation_id=delegation_id,
+        handoff=_spec(n), handoff_fn=handoff_fn)
+    assert handle["status"] == "dispatched"
+    return handle["delegation_id"]
+
+
+def _old_gateway_unit(*, finish_on_stop=False):
+    """A unit whose child 0 finished before the restart and whose children 1 and 2 run until stopped."""
+    started, stop = threading.Event(), threading.Event()
+    calls = []
+
+    def runner():
+        ad.record_unit_child("deleg_call", _entry(0, "completed", "early result"))
+        started.set()
+        stop.wait(10)
+        late = "completed" if finish_on_stop else "interrupted"
+        return {"results": [_entry(0, "completed", "early result"), _entry(1, late), _entry(2, late)]}
+
+    def handoff_fn(deadline, state):
+        calls.append(deadline)
+        state["1"] = {"cwd": "/work/one", "session_id": "child-1b"}
+        stop.set()
+
+    delegation_id = _dispatch(runner, handoff_fn)
+    assert started.wait(5)
+    return delegation_id, calls
+
+
+def _resume_with(results_for):
+    seen = {}
+
+    def make_runner(unit):
+        seen.update(unit)
+        return (lambda: {"results": [unit["kept"].get(i) or results_for(i) for i in range(3)]}), None, None, None
+    return make_runner, seen
+
+
+def test_off_by_default(monkeypatch):
+    from hermes_cli.config_defaults import DEFAULT_CONFIG
+    assert DEFAULT_CONFIG["delegation"]["restart_handoff"] is False
+    monkeypatch.setattr("tools.delegate_tool._load_config", lambda: {})
+    assert handoff.unit_handoff(SimpleNamespace(children=[]), None) == (None, None)
+    release = threading.Event()
+    handle = ad.dispatch_async_delegation_batch(
+        goals=["a"], context=None, toolsets=None, role="leaf", model="m", session_key=ROUTE_KEY,
+        parent_session_id=PARENT, runner=lambda: release.wait(5) and {"results": [_entry(0, "completed")]})
+    assert ad.hand_off_for_restart(0.1, 0.1) == 0  # no handoff record: interrupted as before
+    assert _row(handle["delegation_id"])["state"] == "running"
+    release.set()
+    wait_until(lambda: _completions(handle["delegation_id"]), what="the unit delivered as usual")
+
+
+def test_finished_children_are_kept_and_the_rest_resume_on_the_next_gateway():
+    delegation_id, calls = _old_gateway_unit()
+    assert ad.hand_off_for_restart(1.0, 5.0) == 1
+    assert calls and _completions(delegation_id) == []  # nothing delivered by the old gateway
+    row = _row(delegation_id)
+    assert row["state"] == "handed_off"
+    assert [r["task_index"] for r in json.loads(row["result_json"])["results"]] == [0]
+    spec = json.loads(row["task_json"])["handoff"]
+    assert spec["resume"] == [1, 2]
+    assert spec["children"]["1"]["cwd"] == "/work/one" and spec["children"]["1"]["session_id"] == "child-1b"
+
+    # Old gateway gone: no recovery path marks the row unknown or delivers it.
+    _set_row(delegation_id, owner_pid=_dead_pid())
+    ad._reset_for_tests()
+    assert ad.recover_abandoned_delegations() == 0
+    assert ad.restore_undelivered_completions(queue.Queue()) == 0
+    assert ad.sweep_orphaned_completions(queue.Queue(), now=time.time() + 3600) == 0
+    assert _row(delegation_id)["state"] == "handed_off"
+
+    make_runner, seen = _resume_with(lambda i: _entry(i, "completed", f"resumed {i}"))
+    assert ad.adopt_handed_off_delegations(make_runner) == 1
+    assert ad.adopt_handed_off_delegations(make_runner) == 0  # one adopter only
+    assert set(seen["kept"]) == {0} and seen["handoff"]["resume"] == [1, 2]
+    assert seen["session_key"] == ROUTE_KEY and seen["parent_session_id"] == PARENT
+
+    events = wait_until(lambda: _completions(delegation_id), what="the resumed unit's completion")
+    assert len(events) == 1
+    event = events[0]
+    assert event["status"] == "completed" and event["session_key"] == ROUTE_KEY
+    assert [(r["task_index"], r["summary"]) for r in event["results"]] == [
+        (0, "early result"), (1, "resumed 1"), (2, "resumed 2")]
+    wait_until(lambda: _row(delegation_id)["state"] == "completed", what="the durable completion")
+    assert _row(delegation_id)["delivery_state"] == "pending"
+    assert ad.claim_completion_delivery(delegation_id, "first") is True
+    assert ad.claim_completion_delivery(delegation_id, "second") is False
+    assert _completions(delegation_id) == []
+
+
+def test_next_gateway_with_the_option_off_delivers_interrupted(monkeypatch):
+    delegation_id, _ = _old_gateway_unit()
+    assert ad.hand_off_for_restart(1.0, 5.0) == 1
+    ad._reset_for_tests()
+    monkeypatch.setattr("tools.delegate_tool._load_config", lambda: {"restart_handoff": False})
+    assert handoff.resume_handed_off_delegations() == 1
+    event = wait_until(lambda: _completions(delegation_id), what="the interrupted completion")[0]
+    assert [(r["task_index"], r["status"]) for r in event["results"]] == [
+        (0, "completed"), (1, "interrupted"), (2, "interrupted")]
+    assert "restart_handoff is off" in event["results"][1]["error"]
+
+
+def test_unit_that_finished_during_the_handoff_is_delivered_as_usual():
+    delegation_id, _ = _old_gateway_unit(finish_on_stop=True)
+    assert ad.hand_off_for_restart(1.0, 5.0) == 0
+    event = wait_until(lambda: _completions(delegation_id), what="the normal completion")[0]
+    assert [r["status"] for r in event["results"]] == ["completed"] * 3
+    assert _row(delegation_id)["state"] == "completed"
+
+
+def test_process_killed_during_the_handoff_is_still_resumed():
+    wedged = threading.Event()
+
+    def runner():
+        ad.record_unit_child("deleg_call", _entry(0, "completed", "early result"))
+        wedged.wait(10)
+        return {"results": []}
+
+    delegation_id = _dispatch(runner, lambda deadline, state: None)
+    wait_until(lambda: json.loads(_row(delegation_id)["result_json"] or "{}").get("results"), what="child 0 recorded")
+    assert ad.hand_off_for_restart(0.05, 0.3) == 0  # the unit never settles before the process "dies"
+    assert _row(delegation_id)["state"] == "handed_off"
+    ad._reset_for_tests()
+    wedged.set()  # the dead process's worker finds no record: nothing is finalized twice
+
+    make_runner, seen = _resume_with(lambda i: _entry(i, "completed", f"resumed {i}"))
+    assert ad.adopt_handed_off_delegations(make_runner) == 1
+    assert set(seen["kept"]) == {0}
+    event = wait_until(lambda: _completions(delegation_id), what="the resumed completion")[0]
+    assert [r["summary"] for r in event["results"]] == ["early result", "resumed 1", "resumed 2"]
+
+
+def test_a_runner_that_cannot_be_built_reports_interrupted():
+    delegation_id, _ = _old_gateway_unit()
+    assert ad.hand_off_for_restart(1.0, 5.0) == 1
+    ad._reset_for_tests()
+
+    def broken(unit):
+        raise RuntimeError("record unreadable")
+
+    assert ad.adopt_handed_off_delegations(broken) == 1
+    event = wait_until(lambda: _completions(delegation_id), what="the fallback completion")[0]
+    assert [r["status"] for r in event["results"]] == ["completed", "interrupted", "interrupted"]
+    assert "record unreadable" in event["results"][2]["error"]
+
+
+# ── Stopping children at a clean point ───────────────────────────────────────
+class _Child:
+    def __init__(self, tool=None):
+        self.tool, self.stops, self._subagent_id, self.session_id = tool, [], "sa-0-test", "child-0"
+
+    def get_activity_summary(self):
+        return {"current_tool": self.tool}
+
+    def hard_interrupt(self, message=None, *, tool_reason=None):
+        self.stops.append(tool_reason)
+
+
+def test_children_stop_after_their_tool_call_or_at_the_deadline():
+    busy, idle, stuck = _Child("terminal"), _Child(), _Child("terminal")
+    state = {}
+    worker = threading.Thread(target=handoff._handoff_fn({0: busy, 1: idle}), args=(time.monotonic() + 10, state))
+    worker.start()
+    wait_until(lambda: idle.stops, what="the idle child stopped")
+    assert busy.stops == []  # still inside its tool call
+    busy.tool = None
+    worker.join(5)
+    assert busy.stops == [handoff.RESTART_TOOL_REASON] and idle.stops == [handoff.RESTART_TOOL_REASON]
+    assert busy._delegate_restart_handoff is True and set(state) == {"0", "1"}
+
+    handoff._handoff_fn({0: stuck})(time.monotonic() + 0.2, {})
+    assert stuck.stops == [handoff.RESTART_TOOL_REASON]  # cut at the bound: its call reads "gateway restart"
+
+
+def test_handed_off_child_keeps_its_tool_state():
+    from tools.delegate_tool_child_run import _ChildRun
+    calls = []
+    child = SimpleNamespace(
+        _delegate_restart_handoff=True, session_id="child-0", close=lambda: calls.append("close"),
+        release_clients=lambda: calls.append("release"),
+        _finalize_owned_session_row=lambda: calls.append(("finalize", child._end_session_on_close)))
+    run = _ChildRun(child, SimpleNamespace(), 0, "goal", None, None)
+    run.cleanup(heartbeat=SimpleNamespace(stop=lambda: None), child_pool=None, leased_cred_id=None,
+                close_deferred=False)
+    assert calls == ["release", ("finalize", False)]  # processes, terminal and the session row stay open
+
+
+# ── Resuming a child ─────────────────────────────────────────────────────────
+def _session_db():
+    from hermes_state_registry import acquire
+    return acquire()
+
+
+def _stored_child(db, *, cut: bool):
+    db.create_session(session_id=PARENT, source="telegram")
+    db.create_session(session_id="child-1", source="subagent", parent_session_id=PARENT,
+                      model_config={"_delegate_from": PARENT, "_subagent_id": "sa-1-abcd"})
+    db.append_message("child-1", "user", content="task 1")
+    calls = [{"id": "call_a", "type": "function", "function": {"name": "read_file", "arguments": "{}"}},
+             {"id": "call_b", "type": "function", "function": {"name": "terminal", "arguments": "{}"}}]
+    db.append_message("child-1", "assistant", content="", tool_calls=calls)
+    db.append_message("child-1", "tool", content="file text", tool_name="read_file", tool_call_id="call_a")
+    if not cut:
+        db.append_message("child-1", "tool", content="[Tool execution cancelled - terminal was abandoned: gateway "
+                          "restart]", tool_name="terminal", tool_call_id="call_b")
+        db.append_message("child-1", "assistant", content="Operation interrupted.")
+    db.end_session("child-1", "agent_close")
+
+
+def test_a_tool_call_cut_by_the_restart_reads_as_interrupted():
+    db = _session_db()
+    _stored_child(db, cut=True)
+    assert handoff._close_cut_tool_calls(db, "child-1") == 1
+    assert handoff._close_cut_tool_calls(db, "child-1") == 0
+    tail = db.get_messages_as_conversation("child-1")[-1]
+    assert tail["role"] == "tool" and tail["tool_call_id"] == "call_b"
+    assert json.loads(tail["content"]) == {"status": "interrupted", "error": handoff.CUT_TOOL_RESULT}
+
+
+def test_a_closed_interrupted_turn_is_left_as_written():
+    db = _session_db()
+    _stored_child(db, cut=False)
+    assert handoff._close_cut_tool_calls(db, "child-1") == 0
+
+
+def _resume_unit():
+    child = {"goal": "task 1", "context": "ctx", "role": None, "subagent_id": "sa-1-abcd", "session_id": "child-1",
+             "cwd": "/work/one", "route": {"backend": "model_map", "label": "quick",
+                                           "route": {"base_url": "http://ollama.example.com/v1", "model": "qwen"}}}
+    spec = {"version": 1, "parent": {"session_id": PARENT, "model": "main", "provider": "custom",
+                                     "base_url": "http://ollama.example.com/v1"},
+            "children": {"1": child}, "task_count": 2, "live_deleg_id": "deleg_call", "top_role": "leaf"}
+    return {"delegation_id": "deleg_call", "parent_session_id": PARENT, "goals": ["task 0", "task 1"],
+            "handoff": spec, "kept": {}}
+
+
+@pytest.fixture
+def resume_seams(monkeypatch):
+    built = {}
+
+    def build(**kwargs):
+        built.update(kwargs)
+        return SimpleNamespace(_progress_identity_ref={})
+
+    monkeypatch.setattr("tools.delegate_tool._build_child_preserving_parent_tools", build)
