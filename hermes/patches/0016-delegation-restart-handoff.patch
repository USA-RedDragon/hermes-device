@@ -1874,6 +1874,28 @@ class GatewayShutdownMixin(GatewaySessionEndMixin):
         cap = getattr(getattr(runner, "config", None), "restart_agent_cleanup_seconds", 0) or 0
         return float(cap) if cap > 0 else None
 
+    # How long a restart handoff waits for stopped background subagents to record their state, past the grace.
+    _DELEGATION_HANDOFF_SETTLE_S = 30.0
+
+    async def _stop_hand_off_delegations(self, ctx: GatewayShutdownMixin._StopContext) -> None:
+        """Restart only (``delegation.restart_handoff``): stop each running background subagent at a clean point and
+        hand it to the next gateway, which resumes it. Runs before the process handoff, so the processes the
+        subagents started are handed off with the rest, and before any kill sweep. Bounded by what the shutdown
+        watchdog's leash has left."""
+        if not getattr(self, "_restart_requested", False):
+            return
+        from tools.delegate_tool_config import _get_restart_handoff, _get_restart_handoff_grace_seconds
+        if not _get_restart_handoff():
+            return
+        from tools.async_delegation import hand_off_for_restart
+        settle = GatewayShutdownMixin._DELEGATION_HANDOFF_SETTLE_S
+        budget = max(1.0, _effective_watchdog_leash(self) - ctx.elapsed() - settle)
+        grace = min(_get_restart_handoff_grace_seconds(), budget)
+        try:
+            await asyncio.to_thread(hand_off_for_restart, grace, min(budget, grace + settle))
+        except Exception:
+            logger.warning("Background delegation handoff failed; they are interrupted as usual", exc_info=True)
+
     async def _stop_hand_off_processes(self) -> None:
