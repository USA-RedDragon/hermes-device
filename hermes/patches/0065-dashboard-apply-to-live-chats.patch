+def test_frozen_local_session_runs_the_profiles_current_toolsets(monkeypatch, tmp_path):
+    """A gateway-socket session froze its toolsets at creation; with the key on, its next turn runs the
+    profile's current ones, so a toolset turned off in the dashboard is gone from its next message."""
+    import gateway.session_policy as sp
+
+    live = {"dashboard": {"apply_to_live_chats": True}}
+    monkeypatch.setattr(sp, "profile_config", lambda authority: live)
+    monkeypatch.setattr(sp, "_resolve_toolsets", lambda params, config, source, safe, posture: {"terminal", "web"})
+    import agent.onboarding_session as onboarding
+    monkeypatch.setattr(onboarding, "onboarding_chat_toolsets", lambda enabled, db, session_id: enabled)
+    authority = types.SimpleNamespace(db=types.SimpleNamespace(db_path=str(tmp_path / "state.db")))
+    assert sp.policy_turn_toolsets(authority, _policy(), {}, "sid") == ["terminal", "web"]
+
+    # Off: the frozen set, as upstream.
+    live["dashboard"]["apply_to_live_chats"] = False
+    assert sp.policy_turn_toolsets(authority, _policy(), {}, "sid") == ["memory", "terminal", "web"]
+    live["dashboard"]["apply_to_live_chats"] = True
+    # A session's own toolset pick, an editor's MCP set, safe mode and following sessions keep their own way.
+    import json as _json
+    for p in (_policy(request_json=_json.dumps({"toolsets": ["memory"]})), _policy(editor_mcp_json="{}"),
+              _policy(safe_mode=True), _policy(ignore_user_config=True), _policy(source="api")):
+        assert sp.policy_turn_toolsets(authority, p, {}, "sid") == ["memory", "terminal", "web"]
+    following = _policy(follows_profile=True)
+    following.current_toolsets = lambda config: ("web",)
+    assert sp.policy_turn_toolsets(authority, following, {}, "sid") == ["web"]
