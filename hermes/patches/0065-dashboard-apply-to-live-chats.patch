+def test_live_refresh_reresolves_each_open_chats_toolsets(monkeypatch, _isolate_hermes_home):
+    """The real gateway's refresh rebuilds every open chat's tools from the saved toolsets."""
+    import tui_gateway.server as server
+    import tools.mcp_tool_agent as mta
+    from hermes_cli import dashboard_live
+
+    seen = []
+    monkeypatch.setattr(mta, "refresh_agent_mcp_tools",
+                        lambda agent, **kw: seen.append((agent, kw.get("enabled_override"), kw.get("preserve_prefix"))))
+    monkeypatch.setattr(server, "_emit", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_session_info", lambda agent, sess: {})
+    agent = types.SimpleNamespace(platform="cli", enabled_toolsets=["web", "terminal"], disabled_toolsets=None)
+    monkeypatch.setitem(server._sessions, "sid-live", {"agent": agent, "session_key": "k", "profile_home": None})
+    _gate(True)
+    assert dashboard_live.apply("tools") is True
+    assert [s[0] for s in seen] == [agent]
