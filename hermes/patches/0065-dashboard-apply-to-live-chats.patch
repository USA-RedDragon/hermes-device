new file mode 100644
index 0000000000..dbab07355a
--- /dev/null
+++ b/tests/hermes_cli/test_dashboard_apply_to_live_chats.py
@@ -0,0 +1,237 @@
+"""``dashboard.apply_to_live_chats``: dashboard changes reach open chats on their next message.
+
+Without the key a toolset, MCP server, skill or SOUL.md change saved through the dashboard reached only
+chats started after it. With it, the routes refresh the live gateway chats (tools, MCP) or record a
+profile-wide prompt refresh (skills, SOUL.md) before they answer, and say so with ``applied_live``.
+Off (the default) keeps upstream's behavior and answers exactly as before.
+"""
+import sys
+import types
+
+import pytest
+
+
+def _reset_caches():
+    import hermes_cli.config as cfg
+
+    cfg._LOAD_CONFIG_CACHE.clear()
+    cfg._RAW_CONFIG_CACHE.clear()
+
+
+@pytest.fixture
+def client(monkeypatch, _isolate_hermes_home):
+    try:
+        from starlette.testclient import TestClient
+    except ImportError:
+        pytest.skip("fastapi/starlette not installed")
+    import hermes_state
+    from hermes_constants import get_hermes_home
+    from hermes_cli.web_server import app, _SESSION_HEADER_NAME, _SESSION_TOKEN
+
+    monkeypatch.setattr(hermes_state, "DEFAULT_DB_PATH", get_hermes_home() / "state.db")
+    _reset_caches()
+    c = TestClient(app)
+    c.headers[_SESSION_HEADER_NAME] = _SESSION_TOKEN
+    yield c
+    _reset_caches()
+
+
+def _gate(on):
+    from hermes_cli.config import load_config, save_config
+
+    cfg = load_config()
+    cfg.setdefault("dashboard", {})["apply_to_live_chats"] = on
+    cfg["mcp_servers"] = {"calendar": {"url": "https://calendar.example/mcp", "enabled": True}}
+    save_config(cfg)
+    _reset_caches()
+
+
+@pytest.fixture
+def gateway(monkeypatch):
+    """The in-process gateway with its refresh and RPC entry recorded instead of run."""
+    import tui_gateway.server as server
+    import tools.mcp_tool_agent as mta
+
+    calls = []
+
+    def _refresh_live_sessions(*args, **kwargs):
+        assert server._mcp_reload_lock.locked(), "refresh runs under the reload lock"
+        calls.append(("refresh", args, kwargs))
+
+    def handle_request(req):
+        calls.append(("rpc", req["method"], req["params"]))
+        return {"jsonrpc": "2.0", "id": req["id"], "result": {"status": "reloaded"}}
+
+    monkeypatch.setattr(server, "_refresh_live_sessions", _refresh_live_sessions)
+    monkeypatch.setattr(server, "handle_request", handle_request)
+    monkeypatch.setattr(mta, "reprobe_tool_availability", lambda: calls.append(("reprobe",)))
+    return calls
+
+
+def _epoch():
+    from hermes_state import SessionDB
+
+    db = SessionDB()
+    try:
+        return db.prompt_refresh_epoch("any-session")
+    finally:
+        db.close()
+
+
+def _a_toolset():
+    from hermes_cli.tools_config import _get_effective_configurable_toolsets
+
+    return next(name for name, _, _ in _get_effective_configurable_toolsets() if name not in {"stt"})
+
+
+def test_off_by_default_changes_nothing_live(client, gateway):
+    from hermes_cli.config_defaults import DEFAULT_CONFIG
+
+    assert DEFAULT_CONFIG["dashboard"]["apply_to_live_chats"] is False
+    _gate(False)
+    r = client.put(f"/api/tools/toolsets/{_a_toolset()}", json={"enabled": False})
+    assert r.status_code == 200, r.text
+    assert "applied_live" not in r.json()
+    r = client.put("/api/mcp/servers/calendar/enabled", json={"enabled": False})
+    assert r.status_code == 200, r.text
+    assert "applied_live" not in r.json()
+    r = client.put("/api/skills/toggle", json={"name": "some-skill", "enabled": False})
+    assert "applied_live" not in r.json()
+    assert gateway == []
+    assert _epoch() == 0
+
+
+def test_toolset_toggle_refreshes_live_chats(client, gateway):
+    _gate(True)
+    r = client.put(f"/api/tools/toolsets/{_a_toolset()}", json={"enabled": False})
+    assert r.status_code == 200, r.text
+    assert r.json()["applied_live"] is True
+    assert [c[0] for c in gateway] == ["reprobe", "refresh"]
+
+
+def test_mcp_changes_reload_servers_in_the_gateway(client, gateway):
+    _gate(True)
+    r = client.put("/api/mcp/servers/calendar/enabled", json={"enabled": False})
+    assert r.status_code == 200, r.text
