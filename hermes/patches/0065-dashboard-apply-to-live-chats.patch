+def _policy(**kw):
+    import json as _json
+
+    base = dict(follows_profile=False, safe_mode=False, ignore_user_config=False, editor_mcp_json=None, source="gui",
+                request_json=_json.dumps({"source": "gui"}), coding_posture=False, toolsets=("memory", "terminal", "web"))
+    base.update(kw)
+    p = types.SimpleNamespace(**base)
+    p.current_toolsets = lambda config: p.toolsets
+    return p
+
