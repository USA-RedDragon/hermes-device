diff --git a/hermes_cli/dashboard_live.py b/hermes_cli/dashboard_live.py
new file mode 100644
index 0000000000..385e637c07
--- /dev/null
+++ b/hermes_cli/dashboard_live.py
@@ -0,0 +1,150 @@
+"""``dashboard.apply_to_live_chats``: dashboard changes reach open chats on their next message.
+
+The agent of an open chat keeps the tool list and the system prompt it was built with, so a toolset,
+MCP server, skill or SOUL.md change saved from the dashboard reached only chats started after it (or
+a ``/reload-mcp``, ``hermes sessions refresh-prompts`` or a restart). With the key on, the routes that
+save those changes apply them before they answer:
+
+- ``tools``: tool availability is probed again and every live gateway chat re-resolves its toolsets
+  from config, as ``/reload-mcp`` does, without reconnecting MCP servers. A local session (one a
+  client created over the gateway socket) froze its toolsets at creation; with the key on, one that
+  made no toolset pick of its own runs the profile's current toolsets on each turn instead
+  (``session_toolsets``), so its cached agent is rebuilt with them on its next message.
+- ``mcp``: MCP servers are reconnected from config, then every live gateway chat is refreshed
+  (the gateway's own ``reload.mcp`` with consent given).
+- ``prompt``: a profile-wide prompt refresh is recorded (``hermes sessions refresh-prompts``), so each
+  chat rebuilds its system prompt from the current SOUL.md and skills once, on its next turn.
+
+A running turn finishes with what it had. Tool and MCP changes reach only chats served by this process
+(the dashboard mounted in a gateway); a standalone dashboard answers ``applied_live: false`` for them.
+"""
+from __future__ import annotations
+
+import logging
+import sys
+from typing import Iterable
+
+logger = logging.getLogger(__name__)
+
+KINDS = ("tools", "mcp", "prompt")
+
+
+def enabled(cfg: dict | None = None) -> bool:
+    if cfg is None:
+        try:
+            from hermes_cli.config import load_config_readonly
+
+            cfg = load_config_readonly()
+        except Exception:
+            return False
+    section = cfg.get("dashboard") if isinstance(cfg, dict) else None
+    return isinstance(section, dict) and section.get("apply_to_live_chats") is True
+
+
+def _gateway():
+    """The in-process gateway server module, or None when no gateway runs in this process."""
+    server = sys.modules.get("tui_gateway.server")
+    if server is None or not hasattr(server, "_refresh_live_sessions"):
+        return None
+    return server
+
+
+def _refresh_tools() -> bool:
+    server = _gateway()
+    if server is None:
+        return False
+    from tools.mcp_tool_agent import reprobe_tool_availability
+
+    with server._mcp_reload_lock:
+        reprobe_tool_availability()
+        server._refresh_live_sessions()
+    return True
+
+
+def _reload_mcp() -> bool:
+    server = _gateway()
+    if server is None:
+        return False
+    resp = server.handle_request({"jsonrpc": "2.0", "id": "dashboard-live", "method": "reload.mcp",
+                                  "params": {"confirm": True}})
+    return isinstance(resp, dict) and isinstance(resp.get("result"), dict)
+
+
+def _refresh_prompts() -> bool:
+    from agent.prompt_builder import clear_skills_system_prompt_cache
+    from hermes_state import SessionDB
+
+    clear_skills_system_prompt_cache(clear_snapshot=True)
+    db = SessionDB()
+    try:
+        db.request_prompt_refresh()
+    finally:
+        close = getattr(db, "close", None)
+        if callable(close):
+            close()
+    return True
+
+
+def session_toolsets(authority, policy):
+    """The toolsets a local session's next turn runs with the key on: the profile's current ones for a
+    session that froze them at creation without a pick of its own, else None (its own set stays).
+
+    Sessions that follow their profile already re-read them; an explicit toolset pick, an editor's MCP
+    set, safe mode and a launch that ignores the user's config keep their frozen set."""
+    try:
+        import json
+
+        from gateway.session_policy import SURFACES, _resolve_toolsets, profile_config
+
+        if authority is None or getattr(authority, "db", None) is None or policy.follows_profile:
+            return None
+        if policy.safe_mode or policy.ignore_user_config or policy.editor_mcp_json is not None:
+            return None
+        if policy.source not in SURFACES or "toolsets" in json.loads(policy.request_json):
+            return None
+        live = profile_config(authority)
+        if not enabled(live):
+            return None
+        return tuple(sorted(_resolve_toolsets({}, live, policy.source, policy.safe_mode, policy.coding_posture)))
+    except Exception:
+        logger.debug("Could not read the profile's toolsets for a local session", exc_info=True)
+        return None
+
+
+_APPLY = {"tools": _refresh_tools, "mcp": _reload_mcp, "prompt": _refresh_prompts}
+
+
+def launch_profile(profile: str | None) -> bool:
+    """Whether a request's ``profile`` is the one this process serves chats for."""
+    return (profile or "").strip().lower() in {"", "default", "current"}
+
+
+async def answer(payload: dict, kind: str, profile: str | None) -> dict:
+    """A route's answer after it saved a ``kind`` change for ``profile``: with the key on, the change is
+    applied to open chats first and the answer says whether with ``applied_live``; off, it is unchanged."""
+    import asyncio
+
+    if not enabled():
+        return payload
+    applied = launch_profile(profile) and await asyncio.to_thread(apply, kind)
+    return {**payload, "applied_live": applied}
+
+
+def apply(kinds: Iterable[str] | str, *, force: bool = False) -> bool:
+    """Apply saved changes of ``kinds`` to open chats; True when every kind was applied.
+
+    Off (the key unset) does nothing and answers False, unless ``force``. Never raises: a failure is
+    logged and answers False, and the change itself stays saved for new chats."""
+    if isinstance(kinds, str):
+        kinds = (kinds,)
+    wanted = [k for k in dict.fromkeys(kinds) if k in _APPLY]
+    if not wanted or not (force or enabled()):
+        return False
+    ok = True
+    for kind in wanted:
+        try:
+            ok = _APPLY[kind]() and ok
+        except Exception:
+            logger.warning("Could not apply the dashboard's %s change to open chats", kind, exc_info=True)
+            ok = False
+    return ok
