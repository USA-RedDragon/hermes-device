+def _hand_back_leftover_steer(agent, result: Any) -> None:
+    """A steer accepted during a turn that ended without ``finalize_turn`` (retry exhaustion, a
+    non-retryable provider error, a plan limit) used to stay in the agent's buffer, where no host
+    looks: it was not in the transcript and the host never saw it, so the user's message was lost
+    unless another turn happened to drain it (and a restart lost it for good). Hand it back the way
+    the finalizer does (``result["pending_steer"]``) so the host runs it as the next turn. After a
+    user Stop nothing new is started on its own: the steer stays buffered as before and lands in
+    the user's next turn. Ticketed gateway transfers stay buffered for their claim's settlement,
+    as in the finalizer."""
+    if not isinstance(result, dict) or result.get("completed") is True or result.get("pending_steer"):
+        return
+    if getattr(agent, "_turn_user_cancelled", False) is True:
+        return
+    drain = getattr(agent, "_drain_leftover_steer", None)
+    if not callable(drain):
+        return
+    try:
+        leftover = drain()
+    except Exception:
+        logger.debug("leftover steer hand-back failed", exc_info=True)
+        return
+    if isinstance(leftover, str) and leftover.strip():
+        result["pending_steer"] = leftover
+
+
