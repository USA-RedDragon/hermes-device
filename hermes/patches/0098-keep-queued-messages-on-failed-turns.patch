+"""The TUI busy-input ``interrupt`` mode queues the new message and then stops the live turn. That stop
+is "the user sent a new message", not a cancel: the interrupted turn's message is kept for the queued
+turn to read, so its failed-turn boundary must not ask for a resend (``agent/turn_failure_copy.py``)."""
+
+from __future__ import annotations
+
+import threading
+from unittest.mock import MagicMock
+
+from agent.interrupt_control import NEW_MESSAGE_INTERRUPT_REASON, InterruptControlMixin
+from tui_gateway import server
+
+
+class _Agent(InterruptControlMixin):
+    def __init__(self):
+        self._execution_thread_id = None
+        self._active_children_lock = threading.Lock()
+        self._active_children = []
+        self.quiet_mode = True
+
+
+def test_busy_interrupt_is_labelled_a_new_message_not_a_cancel():
+    agent = _Agent()
+    server._interrupt_for_new_message(agent)
+    assert agent._tool_interrupt_reason == NEW_MESSAGE_INTERRUPT_REASON
+    assert agent._turn_user_cancelled is False
+
+
+def test_busy_interrupt_falls_back_to_the_bare_call_for_older_agents():
+    legacy = MagicMock(spec=["interrupt"])
+    legacy.interrupt = lambda message=None: calls.append(message)
+    calls: list = []
+    server._interrupt_for_new_message(legacy)
+    assert calls == [None]
+
+
+def test_busy_session_interrupt_worker_uses_the_new_message_label(monkeypatch):
+    agent = _Agent()
+    done = threading.Event()
+    real = server._interrupt_for_new_message
+
+    def spy(a):
+        real(a)
+        done.set()
+
+    monkeypatch.setattr(server, "_interrupt_for_new_message", spy)
+    session = {"history_lock": threading.Lock()}
+    server._interrupt_busy_session("sid", session, agent)
+    assert done.wait(5)
+    assert agent._turn_user_cancelled is False
