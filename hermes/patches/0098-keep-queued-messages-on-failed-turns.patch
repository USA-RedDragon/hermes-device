+    (lambda a: a.interrupt(), True),                           # bare user interrupt
+    (lambda a: a.interrupt("deploy it instead"), False),       # a new message interrupts
+    (lambda a: a.interrupt(tool_reason=NEW_MESSAGE_INTERRUPT_REASON), False),  # TUI busy queue
