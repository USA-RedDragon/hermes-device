diff --git a/tests/acp_adapter/test_failed_turn_keeps_message.py b/tests/acp_adapter/test_failed_turn_keeps_message.py
new file mode 100644
index 0000000000..f2b4c499b2
--- /dev/null
+++ b/tests/acp_adapter/test_failed_turn_keeps_message.py
@@ -0,0 +1,77 @@
+"""A failed turn keeps the user's message: the boundary row never asks for a resend, the message stays
+in the model's context, and a steer accepted during the failed turn is handed back to the host.
+
+Driven through the real ``HermesACPAgent`` / ``AIAgent`` / ``SessionDB`` against the loopback provider
+of ``test_failed_turn_closure``. The failure is a non-retryable HTTP 400: one request, no retries, the
+same shape as a provider plan limit that ends the turn (the case that dropped queued Talaria messages:
+the queued prompt drained into a new turn, that turn failed on the same limit, and its boundary told
+the user the request "was not processed" and to send it again).
+"""
+
+from __future__ import annotations
+
+from tests.acp_adapter.test_failed_turn_closure import acp  # noqa: F401  (fixture)
+
+_QUEUED = "queued message A: rename the build job"
+_NEXT = "message B: and tag the release"
+
+
+class _HookedScript(list):
+    """The loopback handler pops one spec per request; ``hook`` runs inside the request, i.e. while
+    the turn's API call is in flight (where a hub steer lands)."""
+
+    def __init__(self, items, hook=None):
+        super().__init__(items)
+        self.hook = hook
+
+    def pop(self, *args):
+        if self.hook is not None:
+            self.hook()
+        return super().pop(*args)
+
+
+def _fail():
+    return {"status": 400, "error": "request rejected for this account"}
+
+
+def test_failed_turn_boundary_keeps_the_message_and_the_next_request_reads_it(acp):
+    from agent.turn_failure_copy import CANCELLED_TURN_NOTICE, FAILED_TURN_NOTICE
+
+    provider, prompt, rows, _db, _sid, _conn, _server = acp
+    provider.script = [{"finish_reason": "stop", "content": "Hello there."}]
+    prompt("hello")
+
+    provider.script = [_fail()]
+    prompt(_QUEUED)
+    # The failed turn is closed by a Hermes boundary that keeps the message, never "send it again".
+    assert rows()[-2:] == [("user", _QUEUED), ("assistant", FAILED_TURN_NOTICE)]
+    assert all(CANCELLED_TURN_NOTICE != content and "again" not in str(content) for _, content in rows())
+
+    provider.script = [{"finish_reason": "stop", "content": "Renamed and tagged."}]
+    prompt(_NEXT)
+    sent = [(m["role"], m.get("content")) for m in provider.requests[-1]["messages"] if m["role"] != "system"]
+    # The failed message reaches the model as its OWN user turn (not stripped, not merged into B),
+    # followed by the boundary and then the new message.
+    assert sent == [
+        ("user", "hello"), ("assistant", "Hello there."),
+        ("user", _QUEUED), ("assistant", FAILED_TURN_NOTICE),
+        ("user", _NEXT),
+    ]
+
+
+def test_steer_accepted_during_a_failed_turn_is_handed_back(acp):
+    """A steer that lands while the failing API call is in flight used to stay in the agent's buffer:
