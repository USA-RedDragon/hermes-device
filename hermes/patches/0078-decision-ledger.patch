+        from agent.decision_ledger import attach
+
+        try:
+            return attach(summary, canonical, start, end, self.decision_ledger_chars,
+                          getattr(self, "_session_id", "") or "")
+        except Exception as exc:  # the ledger must never cost a compaction
+            logger.warning("Decision ledger update failed; the previous one is carried as is: %s", exc)
+            from agent.decision_ledger import from_messages, render
+
+            block = render(from_messages(canonical[:end]))
+            return f"{summary.rstrip()}\n\n{block}" if block else summary
