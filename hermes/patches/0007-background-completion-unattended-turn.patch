+import asyncio
+import contextlib
 import json
+import logging
 from functools import partial
+from pathlib import Path
+
+logger = logging.getLogger(__name__)
 
 # ``_completion_delivery_identity`` kinds: an async delegation's result, a background process's exit
 # and its watch-pattern notices.
@@ -21,6 +29,11 @@ _NOTED_PRODUCERS = frozenset({'async_delegation', 'completion', 'watch_match', '
 # A cron result for a local chat (``session_cron.deliver_to_local_chat``) is finished text: a note
 # with or without a viewer, since a turn over it would only spend a model call (#143547 CRON-11).
 _ALWAYS_NOTED = frozenset({'cron'})
+# What ``sessions.unviewed_completion_turns`` runs as a turn with no viewer: a ``notify_on_complete``
+# process's exit and a background subagent's result (a batch's early failure notice too, as a viewer gets
+# it). They share one count: it bounds the turns nobody watches, whatever woke them. A watch notice can
+# fire many times per process.
+_UNVIEWED_TURN_PRODUCERS = frozenset({'async_delegation', 'completion'})
 
 
 def _producer(identity):
@@ -36,6 +49,93 @@ def noted_completion(row):
     return descriptor is not None and _producer(descriptor['identity']) in _NOTED_PRODUCERS | _ALWAYS_NOTED
 
 
+def unviewed_completion_turns(authority):
+    """Blocking: ``sessions.unviewed_completion_turns`` of the profile that owns *authority*'s store, the
+    completion turns one session may run in a row with no viewer (0 = each one is a note)."""
+    from hermes_cli.config_defaults import DEFAULT_CONFIG
+    from hermes_cli.config_effective import load_user_config_effective
+    from gateway.session_local import profile_env_scope
+    default = DEFAULT_CONFIG['sessions']['unviewed_completion_turns']
+    home = Path(authority.db.db_path).resolve().parent
+    with profile_env_scope(home):
+        sessions = load_user_config_effective(home / 'config.yaml').get('sessions')
+    raw = sessions.get('unviewed_completion_turns', default) if isinstance(sessions, dict) else default
+    if isinstance(raw, bool):
+        return default
+    with contextlib.suppress(ValueError, TypeError):
+        return max(0, int(raw))
+    return default
+
+
+def _unviewed_turn_policy(authority, session_id):
+    """Blocking: the configured limit, and *session_id*'s row end reason when it is ended (else None).
+    An end reason recovery does not resume (exit, /new) outlives the in-memory refusal across a restart."""
+    limit = unviewed_completion_turns(authority)
+    if not limit:
+        return 0, None
+    from gateway.session_viewer_close import _physical_target
+    row = authority.db.get_session(_physical_target(authority, session_id)) or {}
+    return limit, (row.get('end_reason') or '') if row.get('ended_at') else None
+
+
+def _runs_unviewed(authority, session_id, live, descriptor, limit, end_reason):
+    """A background process's exit or subagent result with no viewer attached runs as a turn under the
+    opt-in. Not in a chat the user closed: exit or /new refused its dispatches, left a close pending
+    (still pending after a restart, which does not restore the refusal) or ended its row. Not for a
+    subagent whose dispatching session is refused, by its own record's route or parent row. Not past
+    *limit* in a row."""
+    from hermes_state_common import _RECOVERABLE_END_REASONS
+    ended = end_reason is not None and end_reason not in _RECOVERABLE_END_REASONS
+    if not limit or ended or not _wants_unviewed_turn(descriptor):
+        return False
+    from gateway.session_viewer_close import ORPHAN_REASONS
+    from tools.async_delegation import refused_dispatch, refused_for_session
+    close = authority.pending_closes.get(session_id)
+    if refused_for_session((authority.profile_id, session_id)) or (close is not None and close.reason not in ORPHAN_REASONS):
+        return False
+    if refused_dispatch(_delegation_ids(descriptor)):
+        return False
+    if authority.unviewed_turns.get(session_id, 0) >= limit:
+        return False
+    authority.unviewed_turns[session_id] = authority.unviewed_turns.get(session_id, 0) + 1
+    return True
+
+
+def _identities(descriptor):
+    return set(descriptor.get('identities') or ()) | {descriptor['identity']}
+
+
+def _wants_unviewed_turn(descriptor):
+    return bool(_UNVIEWED_TURN_PRODUCERS & {_producer(identity) for identity in _identities(descriptor)})
+
+
+def _delegation_ids(descriptor):
+    ids = set()
+    for identity in _identities(descriptor):
+        with contextlib.suppress(ValueError, TypeError, IndexError):
+            kind, delegation_id = json.loads(identity)[:2]
+            if kind == 'async_delegation':
+                ids.add(str(delegation_id))
+    return ids
+
+
+async def read_unviewed_policy(authority, ref, live, row):
+    """Before *row* is claimed (still queued, so a cancelled read loses nothing): the opt-in's limit and
+    the row's end reason for a process exit or subagent result no viewer watches, for ``note_if_unviewed`` to decide on in
+    one loop step. Any other row reads nothing. An unreadable config or row keeps the note."""
+    descriptor = row['payload'].get('local_automation_v1')
+    live.unviewed_policy = None
+    if live.subscribers or descriptor is None or not _wants_unviewed_turn(descriptor):
+        return
+    try:
+        policy = await asyncio.to_thread(_unviewed_turn_policy, authority, ref.session_id)
+    except Exception:
+        logger.warning('sessions.unviewed_completion_turns unreadable for %s; keeping notes', ref.session_id,
+                       exc_info=True)
+        return
+    live.unviewed_policy = (row['admission_id'], *policy)
+
+
 async def reopen_for_turn(authority, ref):
     """A turn (never a note) makes *ref*'s finalized row live again: a local session's receipt tip, or
     the row of a conversation its chat moved past (gateway/session_detached.py), which the chat's /new
@@ -53,14 +153,26 @@ async def note_if_unviewed(authority, ref, row):
     """The claimed *row*'s response when it was written as a note instead of running, else None.
     It is the FIFO head, so the note lands after every input committed before it and before every
     input committed after; the viewer check and the decision share one loop step."""
+    live = authority.sessions.get(ref.session_id)
+    if live is not None and (live.subscribers or 'local_automation_v1' not in row['payload']):
+        authority.unviewed_turns.pop(ref.session_id, None)  # someone is watching, or the user sent this
     if not noted_completion(row):
         return None
     from gateway.session_runtime_workers import tracked_write
-    live = authority.sessions.get(ref.session_id)
+    policy = getattr(live, 'unviewed_policy', None)
+    limit, end_reason = policy[1:] if policy is not None and policy[0] == row['admission_id'] else (0, None)
     descriptor = row['payload']['local_automation_v1']
-    if live is None or (live.subscribers and _producer(descriptor['identity']) not in _ALWAYS_NOTED):
+    unviewed = live is not None and not live.subscribers and _runs_unviewed(
+        authority, ref.session_id, live, descriptor, limit, end_reason)
+    if live is None or (live.subscribers and _producer(descriptor['identity']) not in _ALWAYS_NOTED) or unviewed:
         # The claim left a closed row closed for a note; the turn reopens it as any first turn does.
         await reopen_for_turn(authority, ref)
+        if unviewed:
+            from gateway.session_viewer_close import ORPHAN_REASONS, arm_detached_orphan_close
+            if end_reason in ORPHAN_REASONS:
+                # The turn reopened a row the orphan reaper ended: it ends again once the turn settles. A
+                # row a live client handed back with a plain detach stays open, as it was.
+                await arm_detached_orphan_close(authority, ref.session_id)
         return None
     from gateway.session_viewer_close import _physical_target
     metadata = {'completion_note': sorted(set(descriptor.get('identities') or ()) | {descriptor['identity']})}
