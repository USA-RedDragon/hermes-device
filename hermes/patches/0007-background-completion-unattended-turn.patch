+def _subagent(authority, ref, target, summary, release=None):
+    """A background ``delegate_task`` the session dispatched, as the tool does on the local surface."""
+    def child():
+        if release is not None:
+            release.wait(5)
+        return {'status': 'completed', 'summary': summary}
+    handle = delegation.dispatch_async_delegation(
+        goal='compute 2+2', context=None, toolsets=None, role='leaf', model=None,
+        session_key=authority.sessions[ref.session_id].route, parent_session_id=target, runner=child)
+    assert handle['status'] == 'dispatched'
+    return handle['delegation_id']
+
