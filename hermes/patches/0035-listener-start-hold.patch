diff --git a/gateway/run_api.py b/gateway/run_api.py
index 35da60bc7d..cffee4431e 100644
--- a/gateway/run_api.py
+++ b/gateway/run_api.py
@@ -432,6 +432,23 @@ def _handover_read(runner, scope) -> bool:
     return scope['type'] == 'http' and handover_read(runner, scope.get('method'), scope.get('path'))
 
 
+_START_HOLD_POLL_S = 0.02
+
+
+async def _hold_while_starting(runner, descriptor) -> None:
+    """``gateway.listener_start_hold_seconds``: a request that reaches a starting gateway waits for
+    READY, up to that bound, instead of the not-ready answer. A stop that begins meanwhile ends the
+    wait at once."""
+    hold = float(getattr(getattr(runner, 'config', None), 'listener_start_hold_seconds', 0) or 0)
+    if hold <= 0:
+        return
+    loop = asyncio.get_running_loop()
+    deadline = loop.time() + hold
+    while (descriptor['state'] == 'starting' and not getattr(runner, '_draining', False)
+           and loop.time() < deadline):
+        await asyncio.sleep(min(_START_HOLD_POLL_S, max(0.0, deadline - loop.time())))
+
+
 def _restart_wait_sign_in(runner, scope) -> bool:
     from gateway.drain_control import restart_wait_sign_in
     return scope['type'] == 'http' and restart_wait_sign_in(runner, scope.get('method'), scope.get('path'))
@@ -522,6 +539,8 @@ class GatewayRuntimeAPI:
         descriptor = getattr(self.runner, 'session_runtime_descriptor', None)
         if scope['type'] not in {'http', 'websocket'} or descriptor is None:
             return await self.app(scope, receive, send)
+        if descriptor['state'] == 'starting':
+            await _hold_while_starting(self.runner, descriptor)
         draining_socket = (descriptor['state'] in {'ready', 'draining'}
             and (self.runner._draining or descriptor['state'] == 'draining')
             and scope['type'] == 'websocket' and scope['path'] == '/api/ws')
diff --git a/tests/gateway/test_listener_start_hold.py b/tests/gateway/test_listener_start_hold.py
