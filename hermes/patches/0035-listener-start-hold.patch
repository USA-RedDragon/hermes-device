index 0000000000..e7051f0504
--- /dev/null
+++ b/tests/gateway/test_listener_start_hold.py
@@ -0,0 +1,135 @@
+"""gateway.listener_start_hold_seconds: a request that reaches a starting gateway waits for READY
+instead of the 503 ``gateway_not_ready`` answer."""
+import asyncio
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.config import GatewayConfig, load_gateway_config
+from gateway.run_api import GatewayRuntimeAPI
+
+
+def test_off_by_default():
+    assert GatewayConfig().listener_start_hold_seconds == 0.0
+    assert GatewayConfig.from_dict({}).listener_start_hold_seconds == 0.0
+    assert GatewayConfig.from_dict({"gateway": {"listener_start_hold_seconds": 30}}).listener_start_hold_seconds == 30.0
+    assert GatewayConfig.from_dict({"gateway": {"listener_start_hold_seconds": -1}}).listener_start_hold_seconds == 0.0
+    assert GatewayConfig.from_dict({"gateway": {"listener_start_hold_seconds": "x"}}).listener_start_hold_seconds == 0.0
+
+
+def test_config_yaml_key_reaches_the_runner_config(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    (tmp_path / "config.yaml").write_text("gateway:\n  listener_start_hold_seconds: 20\n", encoding="utf-8")
+    assert load_gateway_config().listener_start_hold_seconds == 20.0
+
+
+def _starting_runner(hold):
+    return SimpleNamespace(_draining=False, _running=False,
+                           config=GatewayConfig(listener_start_hold_seconds=hold),
+                           session_runtime_descriptor={"state": "starting", "capabilities": []})
+
+
+def _api(runner):
+    reached = []
+
+    async def dashboard(scope, receive, send):
+        reached.append(scope["path"])
+        if scope["type"] == "websocket":
+            await send({"type": "websocket.accept"})
+            return
+        await send({"type": "http.response.start", "status": 200, "headers": []})
+        await send({"type": "http.response.body", "body": b"{}"})
+
+    web_app = SimpleNamespace(state=SimpleNamespace(auth_required=False))
+    return GatewayRuntimeAPI(dashboard, runner, web_app), reached
+
+
+async def _get(api, path="/api/health"):
+    sent = []
+
+    async def receive():
+        return {"type": "http.request", "body": b"", "more_body": False}
+
+    async def send(message):
+        sent.append(message)
+
+    scope = {"type": "http", "method": "GET", "path": path, "query_string": b"", "headers": [],
+             "client": ("127.0.0.1", 1), "server": ("127.0.0.1", 9120), "scheme": "http",
+             "http_version": "1.1", "root_path": ""}
+    await api(scope, receive, send)
+    return next(m for m in sent if m["type"] == "http.response.start")["status"]
+
+
+async def _upgrade(api, path="/api/plugins/device/ws"):
+    sent = []
+
+    async def receive():
+        return {"type": "websocket.connect"}
+
+    async def send(message):
+        sent.append(message)
+
+    scope = {"type": "websocket", "path": path, "query_string": b"", "headers": [],
+             "client": ("127.0.0.1", 1), "server": ("127.0.0.1", 9120), "scheme": "ws", "subprotocols": []}
+    await api(scope, receive, send)
+    return sent
+
+
+@pytest.fixture(autouse=True)
+def _no_activity_note(monkeypatch):
+    monkeypatch.setattr("gateway.run_idle_exit.note_client_activity", lambda runner: None)
+
+
+@pytest.mark.asyncio
+async def test_without_the_hold_a_starting_gateway_answers_503_at_once():
+    api, reached = _api(_starting_runner(0))
+    started = time.monotonic()
+    assert await _get(api) == 503
+    assert await _upgrade(api) == [{"type": "websocket.close", "code": 1013}]
+    assert time.monotonic() - started < 0.5
+    assert reached == []
+
+
+@pytest.mark.asyncio
+async def test_a_held_request_is_served_once_the_gateway_is_ready():
+    runner = _starting_runner(10)
+    api, reached = _api(runner)
+    request = asyncio.ensure_future(_get(api))
+    socket = asyncio.ensure_future(_upgrade(api))
+    await asyncio.sleep(0.1)
+    assert not request.done() and not socket.done()
+    runner.session_runtime_descriptor["state"] = "ready"
+    assert await asyncio.wait_for(request, 2) == 200
+    assert await asyncio.wait_for(socket, 2) == [{"type": "websocket.accept"}]
+    assert reached == ["/api/health", "/api/plugins/device/ws"]
+
+
+@pytest.mark.asyncio
+async def test_the_hold_ends_with_the_not_ready_answer_after_its_bound():
+    api, reached = _api(_starting_runner(0.2))
+    started = time.monotonic()
+    assert await _get(api) == 503
+    assert 0.15 <= time.monotonic() - started < 2
+    assert reached == []
+
+
+@pytest.mark.asyncio
+async def test_a_stop_during_the_hold_answers_at_once():
+    runner = _starting_runner(30)
+    api, reached = _api(runner)
+    request = asyncio.ensure_future(_get(api))
+    await asyncio.sleep(0.05)
+    runner._draining = True
+    runner.session_runtime_descriptor["state"] = "draining"
+    assert await asyncio.wait_for(request, 2) == 503
+    assert reached == []
+
+
+@pytest.mark.asyncio
+async def test_a_ready_gateway_never_holds():
+    runner = _starting_runner(30)
+    runner.session_runtime_descriptor["state"] = "ready"
+    api, reached = _api(runner)
+    assert await asyncio.wait_for(_get(api), 1) == 200
+    assert reached == ["/api/health"]
diff --git a/website/docs/user-guide/messaging/index.md b/website/docs/user-guide/messaging/index.md
index fd94d93ff4..6050582645 100644
--- a/website/docs/user-guide/messaging/index.md
+++ b/website/docs/user-guide/messaging/index.md
@@ -761,7 +761,9 @@ fails for the whole shutdown and the successor's boot. Set
 restart until the gateway releases the profile: `GET /api/health` answers 200
 throughout, and the reads a client needs to find its chats keep working until
 the stores close. Sockets and writes are refused from the start of the stop as
-before.
+before. A gateway that is still starting answers `503` (`gateway_not_ready`)
+until it is ready; set `gateway.listener_start_hold_seconds` (for example `30`)
+to have such requests wait for it instead, up to that many seconds.
 
