             model_cfg.get("context_length"), True, model_cfg, True, "direct-config",
         ))
 
-    return {
-        "endpoints": endpoints,
-        "current": {
-            "provider": current_provider, "model": current_model, "base_url": current_base_url,
-        },
-    }
+    current = {"provider": current_provider, "model": current_model, "base_url": current_base_url}
+    from hermes_cli import dashboard_managed
+    if dashboard_managed.enabled(cfg):
