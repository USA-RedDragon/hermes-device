+def _refuse_deployment_env(key: str, profile: Optional[str]) -> None:
+    """``dashboard.managed_read_only``: 409 for a write of a key the deployment sets. The process
+    environment belongs to the launch profile only."""
+    from hermes_cli import dashboard_managed
+    if _is_other_profile(profile) or not dashboard_managed.enabled():
+        return
+    refusal = dashboard_managed.env_refusal(key, load_env())
+    if refusal:
+        raise HTTPException(status_code=dashboard_managed.CONFLICT, detail=refusal)
+
+
