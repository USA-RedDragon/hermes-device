diff --git a/hermes_cli/dashboard_managed.py b/hermes_cli/dashboard_managed.py
new file mode 100644
index 0000000000..4b7b5ff2a1
--- /dev/null
+++ b/hermes_cli/dashboard_managed.py
@@ -0,0 +1,114 @@
+"""``dashboard.managed_read_only``: the dashboard's model setup leaves what the deployment sets alone.
+
+A deployment can set the main model and custom endpoints in the managed scope (``HERMES_MANAGED_DIR`` or
+``/etc/hermes``, see :mod:`hermes_cli.managed_scope`) and supply provider keys in the process environment.
+The dashboard's setup routes read and write only ``config.yaml`` and ``.env``, so without this key a save
+"succeeded" while the managed value kept winning (and wrote route keys such as ``model.base_url`` next to
+the pinned default), a removed managed endpoint came back on the next start, and a key saved to ``.env``
+shadowed the deployment's own key for good (``.env`` loads with override). With the key on, the setup
+routes mark these items (``managed``, ``in_environment``) and refuse to change them with 409.
+"""
+from __future__ import annotations
+
+import os
+from typing import Any, Optional
+
+from hermes_cli import managed_scope
+
+# The 409 every refusal here answers with: the item exists, the request conflicts with where it is set.
+CONFLICT = 409
+
+
+def enabled(cfg: Optional[dict] = None) -> bool:
+    """``dashboard.managed_read_only`` (false = off), read from the merged config when *cfg* is None."""
+    if cfg is None:
+        from hermes_cli.config import load_config
+        try:
+            cfg = load_config()
+        except Exception:
+            return False  # an unreadable home: the route's own handling answers, as upstream's does
+    dashboard = cfg.get("dashboard") if isinstance(cfg, dict) else None
+    return isinstance(dashboard, dict) and bool(dashboard.get("managed_read_only"))
+
+
+def source() -> str:
+    """The managed config file, for messages."""
+    managed_dir = managed_scope.get_managed_dir()
+    return str(managed_dir / "config.yaml") if managed_dir else "the deployment config"
+
+
+def _managed_config() -> dict:
+    cfg = managed_scope.load_managed_config()
+    return cfg if isinstance(cfg, dict) else {}
+
+
+def default_managed() -> bool:
+    """True when the managed scope pins the main model (``model.default`` or ``model.provider``)."""
+    model = _managed_config().get("model")
+    if isinstance(model, str):
+        return bool(model.strip())
+    return isinstance(model, dict) and any(model.get(k) not in (None, "") for k in ("default", "name", "provider"))
+
+
+def managed_provider_ids() -> set[str]:
+    """Keys of the ``providers:`` entries the managed scope defines."""
+    providers = _managed_config().get("providers")
+    return {str(k) for k in providers} if isinstance(providers, dict) else set()
+
+
+def managed_custom_provider_slugs() -> set[str]:
+    """Endpoint ids (name slugs) of the ``custom_providers:`` entries the managed scope defines."""
+    from hermes_cli.web_routers.config_env import _custom_endpoint_id
+
+    legacy = _managed_config().get("custom_providers")
+    if not isinstance(legacy, list):
+        return set()
+    return {_custom_endpoint_id(str(e.get("name") or "")) for e in legacy if isinstance(e, dict) and e.get("name")}
+
+
+def endpoint_managed(endpoint_id: str, row_source: str = "", name: Any = None) -> bool:
+    """True when the custom endpoint *endpoint_id* (display *name*) comes from the managed scope. A
+    ``direct-config`` row is the main model's own address, managed with the main model. A managed
+    ``custom_providers`` row counts under either source: the config migration moves one that a start-up merge
+    copied into config.yaml to ``providers.<slug>``, and the next start brings it back if it is removed there."""
+    if row_source == "direct-config":
+        return default_managed()
+    if row_source != "custom_providers" and endpoint_id in managed_provider_ids():
+        return True
+    from hermes_cli.web_routers.config_env import _custom_endpoint_id
+    slugs = managed_custom_provider_slugs()
+    return _custom_endpoint_id(endpoint_id) in slugs or (bool(name) and _custom_endpoint_id(str(name)) in slugs)
+
+
+def env_origin(name: str, env_on_disk: dict) -> Optional[str]:
+    """Where a variable Hermes's ``.env`` does not hold comes from: ``managed`` (the managed ``.env``),
+    ``environment`` (the process environment the deployment started Hermes with), or None (``.env``, or
+    unset). Never reads out the value."""
+    if managed_scope.is_env_managed(name):
+        return "managed"
+    if env_on_disk.get(name):
+        return None
+    return "environment" if os.environ.get(name) else None
+
+
+def env_refusal(name: str, env_on_disk: dict) -> Optional[str]:
+    """The 409 detail for a write of *name* the deployment sets, or None when it may be written."""
+    origin = env_origin(name, env_on_disk)
+    if origin == "managed":
+        return (f"{name} is set in the deployment ({managed_scope.get_managed_dir()}/.env), so it cannot be "
+                "changed or removed here. Change it where the deployment sets it.")
+    if origin == "environment":
+        return (f"{name} is set in the deployment (the environment Hermes was started with), so it cannot be "
+                "changed or removed here. A key saved here would hide the deployment's key, also after the "
+                "deployment changes it. Change it where the deployment sets it.")
+    return None
+
+
+def default_refusal() -> str:
+    return (f"The default model is set in the deployment config ({source()}), so it cannot be changed here. "
+            "Change it there.")
+
+
+def endpoint_refusal(name: Any) -> str:
+    return (f"{name} is set in the deployment config ({source()}), so it cannot be changed or removed here. "
+            "Change it there.")
