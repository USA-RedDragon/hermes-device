+
+
+def _refuse_managed_endpoint(cfg: dict[str, Any], endpoint_id: str, *, default: bool = False,
+                             endpoint: bool = True) -> None:
+    """``dashboard.managed_read_only``: 409 for a write of an endpoint the deployment config defines
+    (*endpoint*), or of the main model it pins (*default*). Runs in the caller's profile scope."""
+    from hermes_cli import dashboard_managed
+    if not dashboard_managed.enabled(cfg):
+        return
+    if default and dashboard_managed.default_managed():
+        raise HTTPException(status_code=dashboard_managed.CONFLICT, detail=dashboard_managed.default_refusal())
+    if not endpoint:
+        return
+    stored_key, entry = _resolve_custom_endpoint_entry(cfg.get("providers"), endpoint_id)
+    if entry is not None:
+        managed, name = dashboard_managed.endpoint_managed(str(stored_key), "providers", entry.get("name")), entry.get("name") or stored_key
+    else:
+        managed, name = dashboard_managed.endpoint_managed(endpoint_id, "custom_providers"), endpoint_id
+        for legacy in get_compatible_custom_providers(cfg):
+            if not legacy.get("provider_key") and _custom_endpoint_id(legacy.get("name") or "") == _custom_endpoint_id(endpoint_id):
+                name = legacy.get("name") or name
+    if managed:
+        raise HTTPException(status_code=dashboard_managed.CONFLICT, detail=dashboard_managed.endpoint_refusal(name))
 
 
