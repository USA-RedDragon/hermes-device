diff --git a/tests/hermes_cli/test_dashboard_managed_read_only.py b/tests/hermes_cli/test_dashboard_managed_read_only.py
new file mode 100644
index 0000000000..f78017dc21
--- /dev/null
+++ b/tests/hermes_cli/test_dashboard_managed_read_only.py
@@ -0,0 +1,238 @@
+"""``dashboard.managed_read_only``: the model setup routes leave what the deployment sets alone.
+
+A deployment pins the main model and custom endpoints in the managed scope and supplies keys in the process
+environment. Without the key, a dashboard save of those answered ok while the managed value kept winning (and
+wrote route keys next to the pinned default), a removed managed endpoint came back, and a key saved to .env
+shadowed the deployment's key. With the key, they are marked and their writes refused with 409, and nothing is
+written. Off (the default) keeps upstream's behavior.
+"""
+import pytest
+
+MANAGED = """\
+model:
+  provider: lab
+  default: lab-model
+providers:
+  lab:
+    name: Lab
+    base_url: http://lab.example:8000/v1
+    key_env: LAB_API_KEY
+    models: [lab-model]
+custom_providers:
+  - name: local-ollama
+    base_url: http://ollama.example:11434/v1
+dashboard:
+  managed_read_only: true
+"""
+
+
+def _reset_caches():
+    import hermes_cli.config as cfg
+    from hermes_cli import managed_scope
+
+    cfg._LOAD_CONFIG_CACHE.clear()
+    cfg._RAW_CONFIG_CACHE.clear()
+    managed_scope.invalidate_managed_cache()
+
+
+@pytest.fixture
+def client(monkeypatch, tmp_path, _isolate_hermes_home):
+    try:
+        from starlette.testclient import TestClient
+    except ImportError:
+        pytest.skip("fastapi/starlette not installed")
+    import hermes_state
+    from hermes_constants import get_hermes_home
+    from hermes_cli.web_server import app, _SESSION_HEADER_NAME, _SESSION_TOKEN
+
+    monkeypatch.setattr(hermes_state, "DEFAULT_DB_PATH", get_hermes_home() / "state.db")
+    for name in ("DEEPSEEK_API_KEY", "LAB_API_KEY", "OPENROUTER_API_KEY"):
+        monkeypatch.delenv(name, raising=False)
+    monkeypatch.setenv("HERMES_MANAGED_DIR", str(tmp_path / "no-managed-dir"))
+    _reset_caches()
+    c = TestClient(app)
+    c.headers[_SESSION_HEADER_NAME] = _SESSION_TOKEN
+    yield c
+    _reset_caches()
+
+
+def _managed(monkeypatch, tmp_path, text=MANAGED):
+    managed = tmp_path / "managed"
+    managed.mkdir(exist_ok=True)
+    (managed / "config.yaml").write_text(text, encoding="utf-8")
+    monkeypatch.setenv("HERMES_MANAGED_DIR", str(managed))
+    _reset_caches()
+    return managed
+
+
+def _gate(on):
+    from hermes_cli.config import load_config, save_config
+    cfg = load_config()
+    cfg.setdefault("dashboard", {})["managed_read_only"] = on
+    save_config(cfg)
+    _reset_caches()
+
+
+def _files():
+    from hermes_constants import get_hermes_home
+    home = get_hermes_home()
+    return tuple((home / n).read_bytes() if (home / n).exists() else b"" for n in ("config.yaml", ".env"))
+
+
+def test_managed_items_are_marked(client, monkeypatch, tmp_path):
+    managed = _managed(monkeypatch, tmp_path)
+    r = client.get("/api/providers/custom-endpoints").json()
+    rows = {e["id"]: e for e in r["endpoints"]}
+    assert rows["lab"]["managed"] is True
+    assert rows["local-ollama"]["managed"] is True
+    assert r["current"]["managed"] is True
+    assert r["current"]["managed_source"] == str(managed / "config.yaml")
+    info = client.get("/api/model/info").json()
+    assert info["managed"] is True and info["model"] == "lab-model"
+
+
+def test_a_managed_server_copied_into_config_stays_managed(client, monkeypatch, tmp_path):
+    """A start-up merge copies the managed custom_providers into config.yaml, and the config migration moves
+    them to providers.<slug>: removing that copy only lasted until the next merge."""
+    _managed(monkeypatch, tmp_path)
+    from hermes_constants import get_hermes_home
+    (get_hermes_home() / "config.yaml").write_text(
+        "providers:\n  local-ollama:\n    name: local-ollama\n    base_url: http://ollama.example:11434/v1\n", encoding="utf-8")
+    _reset_caches()
