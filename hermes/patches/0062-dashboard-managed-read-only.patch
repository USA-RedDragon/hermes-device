 hermes_cli/dashboard_managed.py               | 114 +++++++++
 hermes_cli/web_routers/config_env.py          |  69 ++++-
 hermes_cli/web_routers/models.py              |  21 +-
 hermes_cli/web_server_config.py               |  18 ++
 .../test_dashboard_managed_read_only.py       | 238 ++++++++++++++++++
 6 files changed, 458 insertions(+), 7 deletions(-)
