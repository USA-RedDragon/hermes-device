From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: USA-RedDragon <USA-RedDragon@users.noreply.github.com>
Date: Fri, 13 Nov 2026 10:20:00 +0000
Subject: [PATCH] fix(execute_code): remote probes run in the environment cwd

execute_code remote probes ran outside the environment working directory; they now run in the cwd of the environment.
---
diff --git a/tests/tools/test_code_execution_device_cwd.py b/tests/tools/test_code_execution_device_cwd.py
new file mode 100644
index 00000000..855985b8
--- /dev/null
+++ b/tests/tools/test_code_execution_device_cwd.py
@@ -0,0 +1,67 @@
+"""execute_code on a device-backed env: probes run in the chat's folder, never at ``/``.
+
+A talaria device runs only in the allowed folders and refuses any other cwd with a message
+instead of running the command, so a probe sent with ``cwd="/"`` never printed ``OK`` and
+every execute_code call failed with "Python 3 is not available".
+"""
+import json
+import pathlib
+import re
+from unittest.mock import MagicMock, patch
+
+from tools.code_execution_tool import _execute_remote
+
+CHAT_DIR = "/home/user/Projects"
+
+
+class RootsEnv:
+    """Runs commands only in CHAT_DIR; an empty cwd means the chat's folder."""
+
+    def __init__(self):
+        self.calls = []
+
+    def get_temp_dir(self):
+        return "/tmp"
+
+    def execute(self, command, cwd="", **kwargs):
+        self.calls.append((command, cwd))
+        effective = cwd or CHAT_DIR
+        if effective != CHAT_DIR:
+            return {"output": f"[talaria: the folder {effective} is outside this computer's allowed "
+                              "folders, so the command did not run.]", "returncode": 1}
+        if "command -v python3" in command:
+            return {"output": "OK\n", "returncode": 0}
+        return {"output": "", "returncode": 0}
+
+
+def _run(env):
+    with patch("tools.code_execution_tool._load_config", return_value={"timeout": 30, "max_tool_calls": 5}), \
+         patch("tools.code_execution_tool._get_or_create_env", return_value=(env, "device")), \
+         patch("tools.code_execution_tool._ship_file_to_remote"), \
+         patch("tools.code_execution_tool.threading.Thread", return_value=MagicMock()):
+        return json.loads(_execute_remote("print('hi')", "task-1", ["terminal"]))
+
+
+def test_python_probe_runs_in_the_chat_folder():
+    env = RootsEnv()
+    result = _run(env)
+    assert "not available" not in result.get("error", ""), result
+    assert all(cwd != "/" for _, cwd in env.calls), env.calls
+
+
+def test_probe_failure_says_what_was_checked():
+    class NoPython(RootsEnv):
+        def execute(self, command, cwd="", **kwargs):
+            if "command -v python3" in command:
+                return {"output": "", "returncode": 1}
+            return super().execute(command, cwd, **kwargs)
+
+    result = _run(NoPython())
+    assert result["status"] == "error"
+    assert "command -v python3" in result["error"] and "exit 1" in result["error"]
+
+
+def test_no_remote_helper_pins_cwd_to_root():
+    for name in ("code_execution_tool", "code_execution_rpc", "code_kernel_remote"):
+        text = (pathlib.Path(__file__).parents[2] / "tools" / f"{name}.py").read_text()
+        assert not re.search(r'cwd\s*=\s*["\']/["\']', text), name
