diff --git a/tests/gateway/test_resume_inflight_turn.py b/tests/gateway/test_resume_inflight_turn.py
new file mode 100644
index 00000000..04a3aef5
--- /dev/null
+++ b/tests/gateway/test_resume_inflight_turn.py
@@ -0,0 +1,152 @@
+"""session.resume hands the running turn's frames so far (deltas joined) with the sequence they are current
+as of, so a viewer that joins mid-turn shows every tool call and the reply so far, then the frames after."""
+import asyncio
+import queue
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.session_events import SessionEvents
+
+
+def _publish(events, generation, kind, payload):
+    with events.lock:
+        events.publish('chat', payload, event_type=kind)
+        events.note_turn(generation, kind, payload)
+
+
+def test_turn_frames_join_deltas_and_keep_the_newest_status():
+    events = SessionEvents()
+    _publish(events, 1, 'message.start', {})
+    _publish(events, 1, 'reasoning.delta', {'text': 'th'})
+    _publish(events, 1, 'reasoning.delta', {'text': 'ink'})
+    _publish(events, 1, 'thinking.delta', {'text': 'one'})
+    _publish(events, 1, 'tool.start', {'tool_id': 't1', 'name': 'terminal'})
+    _publish(events, 1, 'tool.progress', {'tool_id': 't1', 'message': 'a'})
+    _publish(events, 1, 'thinking.delta', {'text': 'two'})
+    _publish(events, 1, 'tool.progress', {'tool_id': 't1', 'message': 'b'})
+    _publish(events, 1, 'tool.complete', {'tool_id': 't1', 'result': 'ok'})
+    _publish(events, 1, 'message.delta', {'text': 'Hel'})
+    _publish(events, 1, 'message.delta', {'text': 'lo'})
+    with events.lock:
+        frames = events.turn_for(1)
+        assert events.turn_for(2) == []
+        latest = events.sequence
+    kinds = [f['type'] for f in frames]
+    assert kinds == ['message.start', 'reasoning.delta', 'tool.start', 'thinking.delta', 'tool.progress',
+                     'tool.complete', 'message.delta']
+    assert frames[1]['payload']['text'] == 'think'
+    assert frames[3]['payload']['text'] == 'two'
+    assert frames[4]['payload']['message'] == 'b'
+    assert frames[-1]['payload']['text'] == 'Hello' and frames[-1]['seq'] == latest
+    assert [f['seq'] for f in frames] == sorted(f['seq'] for f in frames)
+    assert all(f['session_id'] == 'chat' and 'size' not in f for f in frames)
+    # A new execution starts afresh.
+    _publish(events, 2, 'message.start', {})
+    with events.lock:
+        assert events.turn_for(1) == [] and [f['type'] for f in events.turn_for(2)] == ['message.start']
+
+
+def test_turn_frames_shorten_the_oldest_tool_results_past_the_cap(monkeypatch):
+    events = SessionEvents()
+    monkeypatch.setattr(SessionEvents, 'TURN_BYTES', 120_000)
+    for i in range(20):
+        _publish(events, 1, 'tool.start', {'tool_id': f't{i}'})
+        _publish(events, 1, 'tool.complete', {'tool_id': f't{i}', 'result': str(i) * 10_000})
+    with events.lock:
+        frames = events.turn_for(1)
+    results = [f['payload']['result'] for f in frames if f['type'] == 'tool.complete']
+    assert len(results) == 20
+    assert results[0].endswith('[... shortened]') and results[-1] == '19' * 10_000
+    assert sum(len(repr(f['payload'])) for f in frames) <= 130_000
+
+
+@pytest.mark.asyncio
+async def test_resume_mid_turn_shows_every_tool_call_and_the_whole_reply(tmp_path, monkeypatch):
+    from gateway.config import GatewayConfig, Platform
+    from gateway.session import SessionSource, SessionStore
+    from gateway.session_authority import LiveSession, initialize_session_authority
+    from gateway.session_contract import SessionRef, Submission
+    from gateway.session_controls import AuthorityConnection
+    from tui_gateway import event_replay
+
+    # The replay ring holds almost nothing, as for a long turn: only the inflight turn can rebuild it.
+    monkeypatch.setattr(event_replay, '_REPLAY_BUFFER_MAX', 4)
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    store = SessionStore(tmp_path / 'sessions', GatewayConfig())
+    db = store._db
+    steps = []
+    for i in range(40):
+        steps.append(('tool.start', {'tool_id': f't{i}', 'name': 'terminal'}))
+        steps.append(('tool.complete', {'tool_id': f't{i}', 'name': 'terminal', 'result': f'out {i}'}))
+        steps.extend(('message.delta', {'text': f'part {i}.{k} '}) for k in range(30))
+        steps.append(('message.interim', {'text': ''.join(f'part {i}.{k} ' for k in range(30)), 'already_streamed': True}))
+    halfway, release = threading.Event(), threading.Event()
+    holder = {}
+
+    def run():
+        authority, sid = holder['authority'], 'chat'
+        generation = authority.executing[sid]
+        for i, (kind, payload) in enumerate(steps):
+            authority.publish_execution(sid, generation, kind, payload)
+            if i == len(steps) // 2:
+                halfway.set()
+        release.wait(10)
+
+    async def answer(event):
+        await asyncio.to_thread(run)
+        return 'done'
+
+    runner = SimpleNamespace(_session_db=db, session_store=store, _draining=False,
+                             _handle_message=answer, _adapter_for_source=lambda source: None)
+    authority = holder['authority'] = await initialize_session_authority(runner, profile_id='p', instance_id='owner')
+    ref = SessionRef('p', 'chat')
+    source = SessionSource(platform=Platform.TELEGRAM, chat_id='chat')
+    db.create_session('chat', source='telegram')
+    authority.sessions['chat'] = LiveSession(source, 'chat')
+
+    class Peer:
+        def __init__(self):
+            self.frames = queue.Queue()
+
+        def write(self, frame):
+            self.frames.put(frame)
+            return True
+
+    starter = AuthorityConnection(authority, Peer(), {'user_id': 'viewer'})
+    await starter.resume(ref, {})
+    await authority.submit(starter.actor, Submission('1', ref, {'text': 'go'}, 'queue'))
+    await asyncio.to_thread(halfway.wait, 10)
+    joined = []
+    for _ in range(5):
+        peer = Peer()
+        conn = AuthorityConnection(authority, peer, {'user_id': 'viewer'})
+        snap = await conn.resume(ref, {})
+        joined.append((peer, conn, snap))
+        await asyncio.sleep(0)
+    release.set()
+    await authority.sessions['chat'].task
+    want_tools = [f't{i}' for i in range(40)]
+    want_text = ''.join(p['text'] for k, p in steps if k == 'message.delta')
+    try:
+        for peer, _, snap in joined:
+            turn = snap.get('inflight_turn')
+            assert turn is not None and turn['sequence'] == snap['last_sequence']
+            assert all(f['seq'] <= turn['sequence'] for f in turn['events'])
+            frames = list(turn['events'])
+            while True:
+                frame = (await asyncio.to_thread(peer.frames.get, True, 5))['params']
+                if frame['type'] == 'message.complete':
+                    break
+                if frame['seq'] > snap['last_sequence']:
+                    frames.append(frame)
+            tools = [f['payload']['tool_id'] for f in frames if f['type'] == 'tool.complete']
+            text = ''.join(f['payload']['text'] for f in frames if f['type'] == 'message.delta')
+            assert tools == want_tools, f'joined at {snap["last_sequence"]}: tools {tools[:3]}...'
+            assert text == want_text, f'joined at {snap["last_sequence"]}: {len(text)} of {len(want_text)} chars'
+    finally:
+        for _, conn, _ in joined:
+            await conn.close()
+        await starter.close()
+        store.close_all_db_handles()
