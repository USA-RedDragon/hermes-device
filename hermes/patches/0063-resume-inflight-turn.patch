index 0ab5c973..679f3280 100644
--- a/gateway/session_events.py
+++ b/gateway/session_events.py
@@ -36,6 +36,69 @@ class SessionEvents:
         # The running execution's reply text so far, in its current segment (``note_reply``); a resume
         # hands it with the snapshot so a viewer that joins mid-reply needs no replay of its deltas.
         self._reply = None
+        # The running execution's frames so far (``note_turn``), deltas joined: a resume hands them so a
+        # viewer that joins mid-turn shows the whole turn (its tool calls and the reply so far) however
+        # far the turn ran past what the bounded replay ring holds.
+        self._turn = None
+
+    # The most a running turn's frames keep; past it the oldest tool results are shortened.
+    TURN_BYTES = 4 << 20
+    TURN_RESULT_KEEP = 4096
+
+    def note_turn(self, generation, event_type, payload):
+        """Record one execution frame for ``turn_for`` (the caller holds ``lock`` right after the frame's
+        ``publish``, so ``sequence`` is the frame's and the record matches the stream at every point)."""
+        turn = self._turn
+        if turn is None or turn['generation'] != generation:
+            turn = self._turn = {'generation': generation, 'frames': [], 'bytes': 0}
+        frames = turn['frames']
+        payload = deepcopy(payload) if isinstance(payload, dict) else {}
+        last = frames[-1] if frames else None
+        text = payload.get('text')
+        if (event_type in ('message.delta', 'reasoning.delta') and last is not None and last['type'] == event_type
+                and isinstance(text, str) and isinstance(last['payload'].get('text'), str)):
+            # Consecutive deltas are one delta with their texts joined.
+            last['payload'] = {**last['payload'], **payload, 'text': last['payload']['text'] + text}
+            last['seq'] = self.sequence
+            turn['bytes'] += len(text)
+        else:
+            if event_type in ('thinking.delta', 'tool.progress'):
+                # Each replaces the one before (a status line, a tool's progress): keep the newest.
+                key = payload.get('tool_id') if event_type == 'tool.progress' else None
+                for i in range(len(frames) - 1, -1, -1):
+                    f = frames[i]
+                    if f['type'] == event_type and (event_type == 'thinking.delta' or f['payload'].get('tool_id') == key):
+                        turn['bytes'] -= f['size']
+                        del frames[i]
+                        break
+            size = len(repr(payload))
+            frames.append({**self.execution, 'type': event_type, 'session_id': self._public_id, 'payload': payload,
+                           'replay_epoch': self.epoch, 'seq': self.sequence, 'size': size})
+            turn['bytes'] += size
+        if turn['bytes'] > self.TURN_BYTES:
+            self._shorten(turn)
+
+    def _shorten(self, turn):
+        """Cut the oldest tool results to ``TURN_RESULT_KEEP`` characters until the turn fits; the newest
+        frame stays whole."""
+        for f in turn['frames'][:-1]:
+            if turn['bytes'] <= self.TURN_BYTES:
+                return
+            if f['type'] != 'tool.complete':
+                continue
+            for k, v in list(f['payload'].items()):
+                if isinstance(v, str) and len(v) > self.TURN_RESULT_KEEP:
+                    f['payload'][k] = v[:self.TURN_RESULT_KEEP] + '\n[... shortened]'
+            size = len(repr(f['payload']))
+            turn['bytes'] += size - f['size']
+            f['size'] = size
+
+    def turn_for(self, generation):
+        """*generation*'s frames so far, as ``since`` returns frames, or [] (caller holds ``lock``)."""
+        turn = self._turn
+        if turn is None or turn['generation'] != generation:
+            return []
+        return [{k: v for k, v in f.items() if k != 'size'} for f in turn['frames']]
 
