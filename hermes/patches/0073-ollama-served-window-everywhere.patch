diff --git a/tests/agent/test_ollama_served_window_any_host.py b/tests/agent/test_ollama_served_window_any_host.py
new file mode 100644
index 00000000..73b03388
--- /dev/null
+++ b/tests/agent/test_ollama_served_window_any_host.py
@@ -0,0 +1,86 @@
+"""A self-hosted Ollama's window is the one it serves on every path, on any host.
+
+Locality is not the test: an Ollama behind a DNS name or a reverse proxy got the GGUF maximum from
+``/api/show``. And the agent's runtime ``num_ctx`` came from the same maximum: Ollama's ``/v1``
+ignores ``options.num_ctx``, so that value was a window the server never allocated, and it lifted
+the agent's window past where Ollama truncates. A user-set ``model.context_length`` still wins.
+"""
+from types import SimpleNamespace
+
+import pytest
+
+from agent import agent_init_ollama
+from agent import model_metadata as mm
+from tests.agent.test_ollama_served_context import MODEL, TRAINED, ollama
+
+
+@pytest.fixture
+def remote(monkeypatch, tmp_path):
+    """The fake server's URL counts as a public DNS name, not a local address."""
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(mm, "is_local_endpoint", lambda url: False)
+    monkeypatch.setattr(agent_init_ollama, "is_local_endpoint", lambda url: False)
+
+
+def test_remote_custom_endpoint_gets_the_served_window(ollama, remote):
+    state = ollama(loaded=65536)
+    assert mm.get_model_context_length(MODEL, base_url=state.url + "/v1") == 65536
+
+
+def test_remote_server_default_is_read_by_a_load(ollama, remote):
+    state = ollama(server_default=8192)
+    assert mm.get_model_context_length(MODEL, base_url=state.url + "/v1") == 8192
+    assert ("POST", "/api/generate") in state.calls
+
+
+def test_remote_stale_cached_maximum_is_reconciled(ollama, remote):
+    state = ollama(loaded=65536)
+    mm.save_context_length(MODEL, state.url + "/v1", TRAINED)  # what an older build persisted
+    assert mm.get_model_context_length(MODEL, base_url=state.url + "/v1") == 65536
+
+
+def test_user_context_length_wins(ollama, remote):
+    state = ollama(loaded=8192)
+    assert mm.get_model_context_length(MODEL, base_url=state.url + "/v1", config_context_length=131072) == 131072
+    assert state.calls == []
+
+
+def test_hosted_ollama_keeps_the_model_maximum(monkeypatch):
+    """ollama.com serves the model's window and has no /api/ps: no served-window probe there."""
+    monkeypatch.setattr(mm, "_is_ollama_server", lambda *a: pytest.fail("hosted Ollama probed as self-hosted"))
+    monkeypatch.setattr(mm, "_ollama_show", lambda *a, **k: {"parameters": "", "model_info": {"llama.context_length": TRAINED}})
+    assert mm._query_ollama_api_show_uncached(MODEL, "https://ollama.com/v1") == TRAINED
+
+
+def _agent(url):
+    return SimpleNamespace(model=MODEL, base_url=url + "/v1", api_key="ollama", provider="custom", quiet_mode=True)
+
+
+def test_runtime_num_ctx_is_the_served_window(ollama, remote):
+    state = ollama(loaded=65536)
+    agent = _agent(state.url)
+    agent_init_ollama._configure_ollama_num_ctx(agent, {}, None)
+    assert agent._ollama_num_ctx == 65536
+
+
+def test_runtime_num_ctx_never_the_maximum_on_a_local_server(ollama):
+    state = ollama(server_default=8192)
+    agent = _agent(state.url)
+    agent_init_ollama._configure_ollama_num_ctx(agent, {}, None)
+    assert agent._ollama_num_ctx == 8192
