From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: USA-RedDragon <USA-RedDragon@users.noreply.github.com>
Date: Fri, 13 Nov 2026 21:16:03 +0000
Subject: [PATCH] fix(delegation): a handed-off subagent keeps its start and
 tool count

A background subagent resumed by the next gateway after a restart was registered as new: started_at was the restart time, tool_count 0, and its elapsed time counted from the restart, so subagent.list and delegation.status showed the wrong start, tool count and duration.

The handoff now records the child's start and tool count from its registry record, and the resumed child is registered with them (the unit's dispatch time and the tool results in its stored transcript when the record has none). The relay counts on from the stored count, and the child's duration counts from its original start.
---
 .../tools/test_delegation_restart_handoff.py  | 68 +++++++++++++++++++
 tools/delegate_tool_child_run.py              | 17 ++++-
 tools/delegate_tool_handoff.py                | 34 +++++++++-
 tools/delegate_tool_progress.py               |  5 ++
 4 files changed, 121 insertions(+), 3 deletions(-)

diff --git a/tests/tools/test_delegation_restart_handoff.py b/tests/tools/test_delegation_restart_handoff.py
index 8ccd59fd..5598c292 100644
--- a/tests/tools/test_delegation_restart_handoff.py
+++ b/tests/tools/test_delegation_restart_handoff.py
@@ -585,3 +585,71 @@ def test_queued_unit_is_handed_off_whole_and_queued_again_on_the_next_gateway():
     event = wait_until(lambda: _completions("deleg_call"), what="the queued unit's completion")[0]
     assert [(r["task_index"], r["summary"]) for r in event["results"]] == [
         (0, "resumed 0"), (1, "resumed 1"), (2, "resumed 2")]
+
+
+# ── Start time and tool count survive the handoff ───────────────────────────
+def _registered_child(subagent_id, **attrs):
+    from tools.delegate_tool_child_run import _register_child
+    child = SimpleNamespace(_subagent_id=subagent_id, model="m", _delegate_depth=1, _parent_session_id=PARENT, **attrs)
+    assert _register_child(child, SimpleNamespace(session_id=PARENT), "goal", owner_session_id=None,
+                           owner_transport=None, owner_session_record=None) == subagent_id
+    return child
+
+
+def _record(subagent_id) -> dict:
+    from tools.delegate_tool_registry import list_active_subagents
+    return next(r for r in list_active_subagents() if r["subagent_id"] == subagent_id)
+
+
+def test_handed_off_child_reports_its_original_start_and_tool_count(resume_seams):
+    from tools.delegate_tool_registry import _active_subagents, _active_subagents_lock, _unregister_subagent
+    from tools.delegate_tool_progress import _ChildProgressRelay
+    from tools.delegate_tool_child_run import _ChildRun
+
+    # Old gateway: a running child that has made 7 tool calls since its start 20 minutes ago.
+    started = time.time() - 1200
+    old = _registered_child("sa-1-abcd", tool=None, stops=[], session_id="child-1")
+    old.hard_interrupt = lambda message=None, *, tool_reason=None: None
+    old.get_activity_summary = lambda: {"current_tool": None}
+    with _active_subagents_lock:
+        _active_subagents["sa-1-abcd"].update(started_at=started, tool_count=7)
+    state = {}
+    handoff._handoff_fn({1: old})(time.monotonic() + 5, state)
+    assert state["1"]["started_at"] == started and state["1"]["tool_count"] == 7
+    _unregister_subagent("sa-1-abcd", agent=old)
+
+    # The spec the old gateway stored; the next gateway builds the child from it.
+    unit = _resume_unit()
+    unit["handoff"]["children"]["1"].update(state["1"])
+    db = _session_db()
+    _stored_child(db, cut=True)
+    ru = handoff._ResumedUnit(unit)
+    parent = handoff._ResumeParent(ru.spec["parent"], db)
+    child = ru._build(1, ru.spec["children"]["1"], parent, db)
+    child._subagent_id, child.model, child._delegate_depth, child._parent_session_id = "sa-1-abcd", "m", 1, PARENT
+
+    # New gateway: registered with the original start and count, and the next call counts on from 7.
+    from tools.delegate_tool_child_run import _register_child
+    _register_child(child, parent, "task 1", owner_session_id=None, owner_transport=None, owner_session_record=None)
+    rec = _record("sa-1-abcd")
+    assert rec["started_at"] == started and rec["tool_count"] == 7
+    relay = _ChildProgressRelay(1, "task 1", None, lambda *a, **k: None, 2, "sa-1-abcd", None, 0, "m", None, {})
+    relay._on_tool_started("terminal", "ls", {}, {})
+    assert _record("sa-1-abcd")["tool_count"] == 8 and relay.tool_count == 8
+    assert _record("sa-1-abcd")["started_at"] == started
+
+    # Elapsed time counts from the original start, not from the new gateway.
+    run = _ChildRun(child, parent, 1, "task 1", "sa-1-abcd", None)
+    assert run.elapsed() >= 1199
+    _unregister_subagent("sa-1-abcd", agent=child)
+
+
+def test_resumed_child_without_a_recorded_start_uses_the_dispatch_time_and_stored_tool_results(resume_seams):
+    db = _session_db()
+    _stored_child(db, cut=True)  # two tool calls, one result stored
+    unit = _resume_unit()
+    unit["dispatched_at"] = time.time() - 600
+    ru = handoff._ResumedUnit(unit)
+    child = ru._build(1, ru.spec["children"]["1"], handoff._ResumeParent(ru.spec["parent"], db), db)
+    assert child._delegate_started_at == unit["dispatched_at"]
+    assert child._delegate_tool_count == 2  # call_a and the closed call_b
diff --git a/tools/delegate_tool_child_run.py b/tools/delegate_tool_child_run.py
