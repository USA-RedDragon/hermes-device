--- a/tools/delegate_tool_child_run.py
+++ b/tools/delegate_tool_child_run.py
@@ -450,6 +450,15 @@ def _register_child(
     _register_subagent(record)
     return record["subagent_id"]
 
+def _resumed_number(child: Any, name: str, kind: type) -> Any:
+    """What a child resumed after a gateway restart carries from before it (its original start, its tool count);
+    None for any other child, test doubles included."""
+    value = getattr(child, name, None)
+    if isinstance(value, bool) or not isinstance(value, (int, float)) or value <= 0:
+        return None
+    return kind(value)
+
+
 def _subagent_record(
     child: Any, parent_agent: Any, goal: str, *, owner_session_id: Optional[str], owner_transport: Any,
     owner_session_record: Any, status: str = "running",
@@ -473,7 +482,8 @@ def _subagent_record(
         "goal": goal,
         "delegation_id": _str_or_none(getattr(child, "_delegation_id", None)),
         "model": _str_or_none(getattr(child, "model", None)),
-        "started_at": time.time(), "status": status, "tool_count": 0, "agent": child,
+        "started_at": _resumed_number(child, "_delegate_started_at", float) or time.time(), "status": status,
+        "tool_count": _resumed_number(child, "_delegate_tool_count", int) or 0, "agent": child,
         # Owning conversation's durable session id (same lineage completion delivery routes by), sourced from the
         # child's stamp so it survives a parent_agent rebuild between dispatch and run; used for list/steer/stop
         # ownership when the weakref chain breaks.
@@ -837,7 +847,10 @@ class _ChildRun:
     parent_reads_snapshot: list = field(default_factory=list)
 
     def elapsed(self) -> float:
-        return round(time.monotonic() - self.child_start, 2)
+        """Seconds since the child started; a child resumed after a gateway restart counts from its original start."""
+        ran = time.monotonic() - self.child_start
+        started = _resumed_number(self.child, "_delegate_started_at", float)
+        return round(max(ran, time.time() - started) if started else ran, 2)
 
     def relay_text(self, delta: str) -> None:
         """Stream callback forwarding the child's reply text up the progress relay so gateway watch windows mirror it
diff --git a/tools/delegate_tool_handoff.py b/tools/delegate_tool_handoff.py
index b270c4d3..a94baa89 100644
--- a/tools/delegate_tool_handoff.py
+++ b/tools/delegate_tool_handoff.py
@@ -197,9 +197,27 @@ def _in_tool(child: Any) -> bool:
         return False
 
 
+def _registry_progress(child: Any) -> dict[str, Any]:
+    """The start time and tool count the child's registry record shows now. The next gateway carries both on, so a
+    handed-off child's start, elapsed time and tool count do not restart."""
+    from tools.delegate_tool_registry import _active_subagents, _active_subagents_lock
+    subagent_id = getattr(child, "_subagent_id", None)
+    if not isinstance(subagent_id, str) or not subagent_id:
+        return {}
+    with _active_subagents_lock:
+        rec = _active_subagents.get(subagent_id) or {}
+        started, count = rec.get("started_at"), rec.get("tool_count")
+    out: dict[str, Any] = {}
+    if isinstance(started, (int, float)) and not isinstance(started, bool) and started > 0:
+        out["started_at"] = float(started)
+    if isinstance(count, int) and not isinstance(count, bool) and count >= 0:
+        out["tool_count"] = count
+    return out
+
+
 def _child_state(child: Any) -> dict[str, Any]:
     """What the child reached that only this process knows: its working directory and current session id."""
-    state: dict[str, Any] = {"session_id": getattr(child, "session_id", None)}
+    state: dict[str, Any] = {"session_id": getattr(child, "session_id", None), **_registry_progress(child)}
     try:
         from tools.delegate_tool_routes import child_profile_scope
         from tools.terminal_tool import get_session_cwd
@@ -459,11 +477,25 @@ class _ResumedUnit:
             child._delegation_id = live
             if isinstance(ident := getattr(child, "_progress_identity_ref", None), dict):
                 ident["delegation_id"] = live
+        self._carry_progress(child, spec, history)
         # No stored turn means the child never started its conversation: it starts on its goal.
         child._delegate_resume = {"cwd": spec.get("cwd"), **({"history": history, "message": RESUME_MESSAGE}
                                                               if history else {})}
         return child
 
+    def _carry_progress(self, child: Any, spec: dict, history: list) -> None:
+        """The resumed child keeps its original start (recorded when the last gateway stopped it, else the unit's
+        dispatch time) and counts tools on from the stored count (else the tool results of its stored transcript),
+        so its row, elapsed time and tool count carry on across the restart instead of starting over."""
+        started, count = spec.get("started_at"), spec.get("tool_count")
+        if not isinstance(started, (int, float)) or isinstance(started, bool) or started <= 0:
+            started = self.unit.get("dispatched_at")
+        if not isinstance(count, int) or isinstance(count, bool) or count < 0:
+            count = sum(1 for m in history if isinstance(m, dict) and m.get("role") == "tool")
+        if isinstance(started, (int, float)) and not isinstance(started, bool) and started > 0:
+            child._delegate_started_at = float(started)
+        child._delegate_tool_count = count
+
     def _attach_transcript(self, index: int, spec: dict, child: Any) -> None:
         path = spec.get("transcript")
         if not path:
diff --git a/tools/delegate_tool_progress.py b/tools/delegate_tool_progress.py
