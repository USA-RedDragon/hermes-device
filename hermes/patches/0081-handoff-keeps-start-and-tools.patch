@@ -408,6 +411,8 @@ class _ChildProgressRelay:
         if self.subagent_id is not None:
             with _active_subagents_lock:
                 rec = _active_subagents.get(self.subagent_id)
+                # A child resumed after a restart is registered with the count it had before.
+                self.tool_count = max(self.tool_count, ((rec or {}).get("tool_count") or 0) + 1)
                 if rec is not None:
                     rec["tool_count"] = self.tool_count
                     rec["last_tool"] = tool_name or ""
