+++ b/agent/web_search_provider.py
@@ -74,6 +74,13 @@ class WebSearchProvider(ProviderBase):
         """True if this provider implements :meth:`search`."""
         return True
 
+    def runs_client_side(self) -> bool:
+        """False for a provider that never runs a search in Hermes itself (it only declares a
+        server-side tool to a transport, e.g. ``openai-native``). Such a provider is never picked
+        by autodetect or the availability walk, and a failed call on it is not rescued by the
+        keyless ring; only an explicit ``web.search_backend`` / ``web.backend`` selects it."""
+        return True
+
     def is_keyless_available(self) -> bool:
         """True when this provider can serve calls WITHOUT credentials (public anonymous
         free tiers such as Exa / Parallel MCP); used only when NO provider is configured or
diff --git a/agent/web_search_registry.py b/agent/web_search_registry.py
index d6918152..491d90fb 100644
--- a/agent/web_search_registry.py
+++ b/agent/web_search_registry.py
@@ -116,7 +116,15 @@ def _resolve(configured: Optional[str], *, capability: str) -> Optional[WebSearc
 
     # Fallbacks are availability-filtered so a registered-but-keyless provider
     # never becomes "active" on a fresh install.
-    eligible = [p for p in snapshot.values() if _capable(p) and _available(p)]
+    # A provider that only declares a server-side tool (``runs_client_side()`` False) is never a
+    # fallback for client-side search; only an explicit selection (above) reaches it.
+    def _client_ok(p: WebSearchProvider) -> bool:
+        try:
+            return capability != "search" or bool(p.runs_client_side())
+        except Exception:
+            return True
+
+    eligible = [p for p in snapshot.values() if _capable(p) and _client_ok(p) and _available(p)]
     if len(eligible) == 1:
         return eligible[0]
 
