index 0000000000..2f351cd99a
--- /dev/null
+++ b/tests/tui_gateway/test_image_render_paths.py
@@ -0,0 +1,156 @@
+"""``security.image_render_paths``: which files ``image.render`` may read on the gateway host."""
+
+import json
+import os
+import threading
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_constants import get_hermes_home
+from tui_gateway import server
+from tui_gateway.image_render_paths import allowed_path, configured_mode
+from tui_gateway.transport import StdioTransport
+
+PIL = pytest.importorskip("PIL.Image")
+
+
+def _png(path: Path) -> Path:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    PIL.new("RGBA", (32, 16), (0, 200, 90, 255)).save(path, format="PNG")
+    return path
+
+
+def _render(monkeypatch, path, mode):
+    cfg = {"display": {"inline_images": "unicode"}}
+    if mode is not None:
+        cfg["security"] = {"image_render_paths": mode}
+    monkeypatch.setattr(server, "_load_cfg", lambda: cfg)
+    return server.handle_request(
+        {"id": "img", "method": "image.render", "params": {"path": str(path), "cols": 8, "rows": 4}})
+
+
+def _drawn(response) -> bool:
+    assert "error" not in response, response
+    return response["result"]["mode"] == "unicode"
+
+
+def _refused(response) -> bool:
+    return response.get("error", {}).get("code") == 4073
+
+
+@pytest.fixture
+def home():
+    return get_hermes_home()
+
+
+@pytest.fixture
+def attached(monkeypatch, tmp_path):
+    """A sidecar session with *tmp_path/ws* as its cwd, attached to the bound transport."""
+    workspace = tmp_path / "ws"
+    workspace.mkdir()
+    transport = StdioTransport(lambda: None, threading.Lock())
+    monkeypatch.setitem(server._sessions, "img-sid", {"transport": transport, "cwd": str(workspace)})
+    token = server.bind_transport(transport)
+    yield workspace
+    server.reset_transport(token)
+
+
+def test_default_reads_any_local_image(monkeypatch, tmp_path):
+    outside = _png(tmp_path / "elsewhere" / "pic.png")
+    assert _drawn(_render(monkeypatch, outside, None))
+    assert _drawn(_render(monkeypatch, outside, "any"))
+
+
+def test_media_reads_stored_attachments_and_tool_images(monkeypatch, home):
+    from tui_gateway.prompt_attachments import stage_image_bytes
+
+    upload = stage_image_bytes(home / "images", _png(home / "src.png").read_bytes(), ".png", prefix="upload")
+    canonical_upload = _png(home / "cache" / "images" / "upload_a.png")
+    screenshot = _png(home / "cache" / "screenshots" / "browser_1.png")
+    generated = _png(home / "cache" / "generated" / "images" / "gen_1.png")
+    for path in (upload, canonical_upload, screenshot, generated):
+        assert _drawn(_render(monkeypatch, path, "media")), path
+
+
+def test_media_refuses_everything_else(monkeypatch, tmp_path, home, attached):
+    (home / ".env").write_text("OPENAI_API_KEY=sk-test\n")
+    (home / "auth.json").write_text("{}")
+    _png(home / "skins" / "logo.png")
+    workspace_image = _png(attached / "shot.png")
+    for path in ("/etc/passwd", home / ".env", home / "auth.json", home / "skins" / "logo.png", workspace_image,
+                 tmp_path / "missing.png"):
+        assert _refused(_render(monkeypatch, path, "media")), path
+
+
+def test_workspace_reads_under_the_attached_sessions_cwd(monkeypatch, attached):
+    assert _drawn(_render(monkeypatch, _png(attached / "out" / "plot.png"), "workspace"))
+    assert _drawn(_render(monkeypatch, _png(attached / ".hermes" / "attachments" / "a.png"), "workspace"))
+
+
+def test_workspace_refuses_traversal_symlinks_and_other_paths(monkeypatch, tmp_path, attached):
+    outside = _png(tmp_path / "outside" / "secret.png")
+    link = attached / "link.png"
+    link.symlink_to(outside)
+    (attached / "dirlink").symlink_to(outside.parent, target_is_directory=True)
+    for path in (f"{attached}/../outside/secret.png", link, attached / "dirlink" / "secret.png", "/etc/passwd"):
+        assert _refused(_render(monkeypatch, path, "workspace")), path
+
+
+def test_workspace_never_exposes_the_hermes_home(monkeypatch, home):
+    # A session whose cwd contains the home (cwd ~ with home ~/.hermes) still gets no home files.
+    transport = StdioTransport(lambda: None, threading.Lock())
+    monkeypatch.setitem(server._sessions, "home-sid", {"transport": transport, "cwd": str(home.parent)})
+    token = server.bind_transport(transport)
+    try:
+        (home / ".env").write_text("OPENAI_API_KEY=sk-test\n")
+        for path in (home / ".env", _png(home / "skins" / "logo.png")):
+            assert _refused(_render(monkeypatch, path, "workspace")), path
+        assert _drawn(_render(monkeypatch, _png(home.parent / "beside-home.png"), "workspace"))
+        assert _drawn(_render(monkeypatch, _png(home / "cache" / "screenshots" / "s.png"), "workspace"))
+    finally:
+        server.reset_transport(token)
+
+
+def test_workspace_ignores_sessions_of_other_connections(monkeypatch, tmp_path):
+    other = tmp_path / "other"
+    monkeypatch.setitem(server._sessions, "other-sid",
+                        {"transport": StdioTransport(lambda: None, threading.Lock()), "cwd": str(other)})
+    assert _refused(_render(monkeypatch, _png(other / "pic.png"), "workspace"))
+
+
+def test_canonical_connection_workspace_is_the_frozen_policy_cwd(monkeypatch, tmp_path):
+    # A legacy-fallback request (the shared gateway's socket): the roots are the authority sessions this
+    # connection subscribes to. A device session's cwd is a placeholder: its parents stay refused.
+    from gateway import session_policy
+    from tui_gateway import ws_legacy_fallback
+
+    placeholder = tmp_path / "srv" / "device-placeholder"
+    placeholder.mkdir(parents=True)
+    policies = {"mine": SimpleNamespace(cwd=str(placeholder), terminal_json=json.dumps({"TERMINAL_ENV": "local"})),
+                "other": SimpleNamespace(cwd=str(tmp_path / "other"), terminal_json="{}")}
+    authority = SimpleNamespace(profile_id=str(get_hermes_home()), runner=None,
+                                sessions={sid: SimpleNamespace(source=sid) for sid in policies})
+    monkeypatch.setattr(session_policy, "policy_for_source", lambda runner, source: policies[source])
+    token = ws_legacy_fallback._fallback_connection.set(
+        SimpleNamespace(authority=authority, subscriptions={"mine": object()}))
+    try:
+        assert _drawn(_render(monkeypatch, _png(placeholder / "a.png"), "workspace"))
+        assert _refused(_render(monkeypatch, _png(tmp_path / "srv" / "b.png"), "workspace"))
+        assert _refused(_render(monkeypatch, _png(tmp_path / "other" / "c.png"), "workspace"))
+    finally:
+        ws_legacy_fallback._fallback_connection.reset(token)
+
+
+def test_unknown_mode_confines_like_media():
+    assert configured_mode({}) == "any"
+    assert configured_mode({"security": {"image_render_paths": "Workspace"}}) == "workspace"
+    assert configured_mode({"security": {"image_render_paths": "nonsense"}}) == "media"
+
+
+def test_a_filesystem_root_workspace_is_ignored(tmp_path):
+    image = _png(tmp_path / "pic.png")
+    root = Path(os.path.abspath(os.sep))
+    assert allowed_path(str(image), mode="workspace", homes=[], workspaces=[str(root)]) is None
+    assert allowed_path(str(image), mode="workspace", homes=[], workspaces=[str(tmp_path)]) == image.resolve()
diff --git a/tui_gateway/image_render_paths.py b/tui_gateway/image_render_paths.py
new file mode 100644
index 0000000000..627f1ba81d
--- /dev/null
+++ b/tui_gateway/image_render_paths.py
@@ -0,0 +1,83 @@
+"""Which files ``image.render`` may read (``security.image_render_paths``).
+
+``any`` (the default) reads any local image file. ``media`` reads only images Hermes stored
+itself: attachment staging and the media caches that tools write screenshots, vision inputs and
+generated images to. ``workspace`` also reads under the working directory of a session the
+requesting connection is attached to, when that directory is on this host. The path is resolved
+(``~``, ``..`` and symlinks) before the check. In both confined modes nothing else under a Hermes
+home is readable, so a workspace that contains the home never exposes ``.env``, ``auth.json`` or
+``state.db``.
+"""
+
+from __future__ import annotations
+
+import os
+from collections.abc import Iterable
+from pathlib import Path
+from typing import Any
+
+MODES = ("any", "workspace", "media")
+#: Listed in ``runtime.describe`` capabilities while a confined mode is on.
+CAPABILITY = "image-render-confined-v1"
+
+# Hermes-home subdirectories (current and legacy names) that hold only files Hermes wrote:
+# image uploads (tui_gateway/prompt_attachments.py, gateway/session_images.py), inbound and
+# computer_use images, browser screenshots, vision downloads and generated images.
+_MEDIA_SUBDIRS = (
+    "images", "cache/images", "image_cache", "cache/screenshots", "browser_screenshots",
+    "cache/vision", "temp_vision_images", "cache/generated")
+
+
+def configured_mode(cfg: Any) -> str:
+    """The configured mode; an unknown value confines to ``media`` rather than reading anything."""
+    security = cfg.get("security") if isinstance(cfg, dict) else None
+    raw = security.get("image_render_paths") if isinstance(security, dict) else None
+    if raw is None:
+        return "any"
+    mode = str(raw).strip().lower()
+    return mode if mode in MODES else "media"
+
+
+def _resolve(path: str | os.PathLike) -> Path | None:
+    try:
+        return Path(os.path.expanduser(os.fspath(path))).resolve()
+    except (OSError, RuntimeError, ValueError):
+        return None
+
+
+def _within(path: Path, root: Path) -> bool:
+    return path == root or root in path.parents
+
+
+def media_roots(homes: Iterable[str | os.PathLike]) -> list[Path]:
+    """The resolved media directories of each Hermes home in *homes*."""
+    roots = (_resolve(Path(home) / sub) for home in homes if home for sub in _MEDIA_SUBDIRS)
+    return [root for root in roots if root is not None]
+
+
+def allowed_path(candidate: str, *, mode: str, homes: Iterable[str | os.PathLike],
+                 workspaces: Iterable[str | os.PathLike] = (),
+                 protected: Iterable[str | os.PathLike] = ()) -> Path | None:
+    """The resolved path of *candidate* when *mode* lets ``image.render`` read it, else ``None``.
+
+    *homes* are the Hermes homes serving the request: their media directories are readable and
+    the rest of each home is not. *protected* are further trees that stay closed (the Hermes root
+    and the launch home). *workspaces* are the host working directories of the connection's
+    sessions, read only in ``workspace`` mode; one that resolves to a filesystem root is ignored.
+    """
+    resolved = _resolve(candidate)
+    if resolved is None:
+        return None
+    homes = [home for home in homes if home]
+    if any(_within(resolved, root) for root in media_roots(homes)):
+        return resolved
+    if mode != "workspace":
+        return None
+    closed = (_resolve(tree) for tree in (*homes, *protected) if tree)
+    if any(_within(resolved, tree) for tree in closed if tree is not None):
+        return None
+    for workspace in workspaces:
+        root = _resolve(workspace) if workspace else None
+        if root is not None and root != Path(root.anchor) and root.is_dir() and _within(resolved, root):
+            return resolved
+    return None
