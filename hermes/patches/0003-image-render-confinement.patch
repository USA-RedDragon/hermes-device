+def _image_render_scope() -> tuple[list[str], list[str]]:
+    """Hermes homes and host workspaces of the sessions the requesting connection is attached to:
+    the authority's subscriptions for a legacy-fallback request (``ws_legacy_fallback``), else the
+    sidecar's own sessions on this transport."""
+    from tui_gateway.ws_legacy_fallback import fallback_connection
+    homes, workspaces = [str(get_hermes_home())], []
+    if (connection := fallback_connection()) is not None:
+        from gateway.session_policy import policy_for_source, terminal_uses_host_cwd
+        authority = connection.authority
+        homes.append(str(authority.profile_id))
+        for sid in list(connection.subscriptions):
+            live = authority.sessions.get(sid)
+            try:
+                policy = policy_for_source(authority.runner, live.source) if live is not None else None
+                if policy is not None and terminal_uses_host_cwd(json.loads(policy.terminal_json)):
+                    workspaces.append(str(policy.cwd))
+            except Exception:
+                continue
+        return homes, workspaces
+    transport = current_transport()
+    with _sessions_lock:
+        attached = [s for s in _sessions.values() if _session_transport_contains(s, transport)]
+    for session in attached:
+        if session.get("profile_home"):
+            homes.append(str(session["profile_home"]))
+        if session.get("cwd") and not _cwd_is_remote(session.get("profile_home")):
+            workspaces.append(str(session["cwd"]))
+    return homes, workspaces
+
+
 def register(server) -> None:
     bind_module(globals(), server, skip=("_",))
