 HELD_SCOPE_KEY = 'hermes.listener_held'
+#: ``gateway.restart_socket_close_delay_seconds``: the scope of a Webapp socket kept through the restart
+#: wait carries the event that ends its session where the stop would close its connection.
+PARKED_SCOPE_KEY = 'hermes.socket_parked'
+#: Close codes of a socket that ends because its gateway goes away; a parked socket sends 1012 for them.
+_RESTART_CLOSE_CODES = frozenset({1000, 1001, 1012, 1013})
+_READY_POLL_S = 0.05
+
+
+def socket_close_delay(runner) -> float:
+    """``gateway.restart_socket_close_delay_seconds`` with the hold it builds on, else 0 (off)."""
+    from gateway.drain_control import restart_hold_configured
+    if not restart_hold_configured(runner):
+        return 0.0
+    return float(getattr(getattr(runner, 'config', None), 'restart_socket_close_delay_seconds', 0) or 0)
+
+
+async def await_successor_ready(target, deadline: float) -> bool:
+    """Until *deadline* (loop time): ask the successor at *target* for ``/api/health`` until it answers
+    200. A starting gateway holds the request until it is ready (``listener_start_hold_seconds``)."""
+    loop = asyncio.get_running_loop()
+    host, port = target
+    while loop.time() < deadline:
+        writer = None
+        try:
+            reader, writer = await asyncio.wait_for(asyncio.open_connection(host, port),
+                                                    max(0.01, min(1.0, deadline - loop.time())))
+            writer.write(b'GET /api/health HTTP/1.1\r\nHost: successor\r\nConnection: close\r\n\r\n')
+            await writer.drain()
+            status = await asyncio.wait_for(reader.readline(), max(0.01, deadline - loop.time()))
+            if status.split(b' ')[1:2] == [b'200']:
+                return True
+        except (OSError, asyncio.TimeoutError):
+            pass
+        finally:
+            if writer is not None:
+                writer.close()
+        await asyncio.sleep(min(_READY_POLL_S, max(0.0, deadline - loop.time())))
+    return False
 
 
 async def _hold_while_starting(runner, descriptor) -> None:
@@ -540,6 +584,9 @@ class GatewayRuntimeAPI:
         self.successor = None
         self.forward_deadline = 0.0
         self._released: asyncio.Event | None = None
+        #: ``gateway.restart_socket_close_delay_seconds``: set once parked sockets may close.
+        self._sockets_may_close: asyncio.Event | None = None
+        self._settle_task: asyncio.Task | None = None
 
     async def __call__(self, scope, receive, send):
         task = asyncio.current_task()
@@ -556,6 +603,79 @@ class GatewayRuntimeAPI:
         self.successor = tuple(target) if target is not None else False
         if self._released is not None:
             self._released.set()
+        delay = socket_close_delay(self.runner)
+        if delay > 0 and self._settle_task is None:
+            self._settle_task = asyncio.create_task(self._settle_successor(self.successor or None, delay))
+
+    def _close_gate(self) -> asyncio.Event:
+        if self._sockets_may_close is None:
+            self._sockets_may_close = asyncio.Event()
+        return self._sockets_may_close
+
+    async def _settle_successor(self, target, delay: float) -> None:
+        """Parked sockets close *delay* seconds after the successor answered ready, so the new dials
+        of their clients reach the successor's own listener, not this one's relay."""
+        try:
+            if target is not None and await await_successor_ready(target, self.forward_deadline):
+                await asyncio.sleep(delay)
+        except Exception:
+            logger.debug('Waiting for the next gateway to be ready failed', exc_info=True)
+        finally:
+            self._close_gate().set()
+
+    def _parked(self, scope, receive, send):
+        """``gateway.restart_socket_close_delay_seconds``: a Webapp socket kept through the restart wait.
+        Where the stop would close it, its session ends (the app gets a disconnect and runs its usual
+        teardown, before the stores close), but the close frame waits until the successor is ready, then
+        goes out as 1012. Frames the client sends meanwhile are never read."""
+        ending = asyncio.Event()
+        scope[PARKED_SCOPE_KEY] = ending
+        client_left = False
+        runner = self.runner
+
+        def stopping() -> bool:
+            return bool(getattr(runner, '_restart_requested', False)) and not getattr(runner, '_running', True)
+
+        async def receive_parked():
+            nonlocal client_left
+            if not ending.is_set():
+                step = asyncio.ensure_future(receive())
+                end = asyncio.ensure_future(ending.wait())
+                try:
+                    await asyncio.wait({step, end}, return_when=asyncio.FIRST_COMPLETED)
+                finally:
+                    end.cancel()
+                if step.done():
+                    message = step.result()
+                    if message.get('type') == 'websocket.disconnect' and not stopping():
+                        client_left = True
+                    return message
+                step.cancel()
+                await asyncio.wait({step})
+            return {'type': 'websocket.disconnect', 'code': 1012}
+
+        async def send_parked(message):
+            if message.get('type') == 'websocket.close' and stopping() and not client_left:
+                code = message.get('code') or 1000
+                await self._await_close_gate(scope)
+                message = {**message, 'code': 1012 if code in _RESTART_CLOSE_CODES else code}
+            await send(message)
+
+        return receive_parked, send_parked
+
+    async def _await_close_gate(self, scope) -> None:
+        """Hold a parked socket's close like a held request (the stop's read cut and the seal skip it),
+        until the successor is ready or the hold's bound passes."""
+        scope[HELD_SCOPE_KEY] = True
+        task = asyncio.current_task()
+        self.held.add(task)
+        try:
+            bound = float(getattr(self.runner.config, 'restart_listener_hold_seconds', 0) or 0)
+            await asyncio.wait_for(self._close_gate().wait(), max(0.0, bound))
+        except TimeoutError:
+            pass
+        finally:
+            self.held.discard(task)
 
     async def _forward_held(self, scope, receive, send) -> bool:
         """``gateway.restart_listener_hold_seconds``: a restart stop holds a request it would refuse
@@ -717,6 +837,8 @@ class GatewayRuntimeAPI:
                 admitted_in_wait = webapp_socket and restart_wait_open(self.runner)
                 if draining_socket and not admitted_in_wait:
