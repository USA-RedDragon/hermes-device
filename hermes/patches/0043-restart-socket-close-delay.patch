diff --git a/tests/gateway/test_restart_socket_close_delay.py b/tests/gateway/test_restart_socket_close_delay.py
new file mode 100644
index 0000000000..89cb642c3a
--- /dev/null
+++ b/tests/gateway/test_restart_socket_close_delay.py
@@ -0,0 +1,213 @@
+"""gateway.restart_socket_close_delay_seconds: a Webapp socket kept through the restart wait gets one close
+frame, once the gateway that took over is ready, instead of one at the stop and one at the relay's end."""
+import asyncio
+import socket
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+from aiohttp import web
+
+from gateway.config import GatewayConfig, load_gateway_config
+from gateway.drain_control import HANDOVER_READS, RESTART_WAIT_REASON
+from gateway.run_api import (
+    PARKED_SCOPE_KEY, GatewayRuntimeAPI, await_successor_ready, end_gateway_api_reads, seal_gateway_api,
+    socket_close_delay,
+)
+
+
+def test_off_by_default():
+    assert GatewayConfig().restart_socket_close_delay_seconds == 0.0
+    assert GatewayConfig.from_dict({}).restart_socket_close_delay_seconds == 0.0
+    assert GatewayConfig.from_dict(
+        {"gateway": {"restart_socket_close_delay_seconds": 1.5}}).restart_socket_close_delay_seconds == 1.5
+    assert GatewayConfig.from_dict(
+        {"gateway": {"restart_socket_close_delay_seconds": 999}}).restart_socket_close_delay_seconds == 0.0
+
+
+def test_config_yaml_key_reaches_the_runner_config(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    (tmp_path / "config.yaml").write_text("gateway:\n  restart_socket_close_delay_seconds: 1\n", encoding="utf-8")
+    assert load_gateway_config().restart_socket_close_delay_seconds == 1.0
+
+
+def _config(delay=0.2, hold=60):
+    return GatewayConfig(restart_listener_handover=True, restart_listener_relay_seconds=30,
+                         restart_listener_hold_seconds=hold, restart_socket_close_delay_seconds=delay)
+
+
+@pytest.mark.parametrize("delay, hold, expected", [(0.2, 60, 0.2), (0, 60, 0.0), (0.2, 0, 0.0)])
+def test_the_delay_needs_the_hold(delay, hold, expected):
+    assert socket_close_delay(SimpleNamespace(config=_config(delay, hold))) == expected
+
+
+def _runner(config):
+    return SimpleNamespace(config=config, _draining=False, _running=True, _listener_handover=None,
+                           _restart_requested=False, session_runtime_descriptor={"state": "ready"})
+
+
+def _wait(runner):
+    runner._draining, runner._restart_requested = True, True
+    runner.session_runtime_descriptor["drain_reason"] = RESTART_WAIT_REASON
+
+
+async def _open(monkeypatch, runner):
+    """A Webapp socket open on the listener; the app ends its session on a disconnect and then closes
+    the socket with 1000, as the session socket handler does."""
+    monkeypatch.setattr("hermes_cli.web_server_boundary._gateway_ws_ticket_from_subprotocol",
+                        lambda ws: ("abc", "ok"))
+    monkeypatch.setattr("hermes_cli.web_server_surface.policy", lambda state: SimpleNamespace(gateway_ticket=True))
+    got, opened, ended = [], asyncio.Event(), asyncio.Event()
+
+    async def dashboard(scope, receive, send):
+        await send({"type": "websocket.accept"})
+        opened.set()
+        while True:
+            message = await receive()
+            got.append(message)
+            if message["type"] == "websocket.disconnect":
+                ended.set()
+                await send({"type": "websocket.close", "code": 1000})
+                return
+
+    api = GatewayRuntimeAPI(dashboard, runner, SimpleNamespace(state=SimpleNamespace()))
+    to_app: asyncio.Queue = asyncio.Queue()
+    from_app: asyncio.Queue = asyncio.Queue()
+    scope = {"type": "websocket", "path": "/api/ws", "raw_path": b"/api/ws", "query_string": b"native_dial=browser",
+             "headers": [(b"host", b"hermes:9120"), (b"origin", b"http://hermes:9120"),
+                         (b"sec-websocket-protocol", b"hermes.v1, ticket.abc"), (b"sec-websocket-key", b"x")],
+             "subprotocols": ["hermes.v1", "ticket.abc"], "client": ("10.0.0.9", 1),
+             "server": ("10.0.0.1", 9120), "scheme": "ws"}
+    await to_app.put({"type": "websocket.connect"})
+    task = asyncio.ensure_future(api(scope, to_app.get, from_app.put))
+    await asyncio.wait_for(opened.wait(), 2)
+    assert from_app.get_nowait() == {"type": "websocket.accept"}
+    return SimpleNamespace(api=api, task=task, scope=scope, to_app=to_app, from_app=from_app, got=got, ended=ended)
+
+
+def _seal(api, scope):
+    """The stop's seal: what would shut the socket's connection down."""
+    calls = []
+    conn = SimpleNamespace(scope=scope, shutdown=lambda: calls.append("shutdown"))
+    seal_gateway_api(SimpleNamespace(api=api, server=SimpleNamespace(server_state=SimpleNamespace(connections=[conn]))))
+    return calls
+
+
+async def _successor(ready_after=0.0):
+    """The gateway that took over: 503 on health until *ready_after* seconds passed, then 200."""
+    loop = asyncio.get_running_loop()
+    ready_at = loop.time() + ready_after
+    asked = []
+
+    async def health(request):
+        asked.append(loop.time())
+        return web.Response(status=200 if loop.time() >= ready_at else 503, text="{}")
+
+    app = web.Application()
+    app.router.add_route("GET", "/api/health", health)
+    runner = web.AppRunner(app)
+    await runner.setup()
+    sock = socket.socket()
+    sock.bind(("127.0.0.1", 0))
+    await web.SockSite(runner, sock).start()
+    return runner, ("127.0.0.1", sock.getsockname()[1]), asked
+
+
+@pytest.mark.asyncio
+async def test_the_stop_ends_the_session_and_the_close_waits_for_the_successor(monkeypatch):
+    runner = _runner(_config(delay=0.2))
+    s = await _open(monkeypatch, runner)
+    _wait(runner)
+    await s.to_app.put({"type": "websocket.receive", "text": "steer"})
+    await asyncio.sleep(0.05)
+    assert s.got[-1] == {"type": "websocket.receive", "text": "steer"}  # served through the restart wait
+    runner._running = False  # the stop begins
+    assert _seal(s.api, s.scope) == []  # its connection is not shut down
+    await asyncio.wait_for(s.ended.wait(), 2)
+    assert s.got[-1] == {"type": "websocket.disconnect", "code": 1012}  # the session ends at the stop
+    # The stop's read cut neither waits for nor cancels the parked socket.
+    handle = SimpleNamespace(api=s.api, app=SimpleNamespace(close=AsyncMock()))
+    runner._listener_handover = HANDOVER_READS
+    await asyncio.wait_for(end_gateway_api_reads(runner, handle, 5.0), 1)
+    await asyncio.sleep(0.2)
+    assert s.from_app.empty() and not s.task.done()
+    successor, target, asked = await _successor(ready_after=0.3)
+    try:
+        loop = asyncio.get_running_loop()
+        released = loop.time()
+        s.api.forward_to(target, 10)
+        assert await asyncio.wait_for(s.from_app.get(), 5) == {"type": "websocket.close", "code": 1012}
+        closed = loop.time()
+        await asyncio.wait_for(s.task, 2)
+        assert len(asked) >= 2  # asked again until the successor was ready
+        assert closed - released >= 0.3 + 0.2 - 0.05  # ready, then the delay
+    finally:
+        await successor.cleanup()
+
+
+@pytest.mark.asyncio
+async def test_a_frame_after_the_stop_began_ends_the_session_and_with_no_successor_it_closes_at_once(monkeypatch):
+    runner = _runner(_config(delay=5))
+    s = await _open(monkeypatch, runner)
+    _wait(runner)
+    runner._running = False
+    await s.to_app.put({"type": "websocket.receive", "text": "late"})
+    await asyncio.wait_for(s.ended.wait(), 2)
+    assert s.got[-1] == {"type": "websocket.disconnect", "code": 1013}  # never read
+    await asyncio.sleep(0.1)
+    assert s.from_app.empty()
+    s.api.forward_to(None, 10)  # released, nobody took over
+    assert await asyncio.wait_for(s.from_app.get(), 2) == {"type": "websocket.close", "code": 1012}
+    await asyncio.wait_for(s.task, 2)
+
+
+@pytest.mark.asyncio
+async def test_a_client_that_leaves_is_not_held(monkeypatch):
+    runner = _runner(_config(delay=5))
+    s = await _open(monkeypatch, runner)
+    _wait(runner)
+    await s.to_app.put({"type": "websocket.disconnect", "code": 1001})
+    await asyncio.wait_for(s.task, 2)
+    assert s.from_app.get_nowait() == {"type": "websocket.close", "code": 1000}
+
+
+@pytest.mark.asyncio
+async def test_the_close_is_held_no_longer_than_the_hold(monkeypatch):
+    runner = _runner(_config(delay=5, hold=0.3))
+    s = await _open(monkeypatch, runner)
+    _wait(runner)
+    runner._running = False
+    _seal(s.api, s.scope)
+    assert await asyncio.wait_for(s.from_app.get(), 2) == {"type": "websocket.close", "code": 1012}
+
+
+@pytest.mark.asyncio
+async def test_without_the_key_the_stop_closes_the_socket_as_before(monkeypatch):
+    runner = _runner(_config(delay=0))
+    s = await _open(monkeypatch, runner)
+    assert PARKED_SCOPE_KEY not in s.scope
+    _wait(runner)
+    runner._running = False
+    assert _seal(s.api, s.scope) == ["shutdown"]
+    await s.to_app.put({"type": "websocket.receive", "text": "late"})
+    await asyncio.wait_for(s.task, 2)
+    assert s.got[-1] == {"type": "websocket.disconnect", "code": 1013}
+    assert s.from_app.get_nowait() == {"type": "websocket.close", "code": 1000}
+
+
+@pytest.mark.asyncio
+async def test_successor_ready_waits_for_200_and_gives_up_at_the_deadline():
+    successor, target, asked = await _successor(ready_after=0.2)
+    loop = asyncio.get_running_loop()
+    try:
+        assert await await_successor_ready(target, loop.time() + 5)
+        assert len(asked) >= 2
+    finally:
+        await successor.cleanup()
+    closed = socket.socket()
+    closed.bind(("127.0.0.1", 0))
+    port = closed.getsockname()[1]
+    closed.close()
+    started = loop.time()
+    assert not await await_successor_ready(("127.0.0.1", port), loop.time() + 0.3)
+    assert loop.time() - started < 1.0
