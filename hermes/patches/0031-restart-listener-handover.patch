@@ -0,0 +1,266 @@
+"""gateway.restart_listener_handover: a restart stop keeps the gateway listener bound until the
+profile is released, so a successor's readiness takes over from this one's without a gap."""
+import asyncio
+import json
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from gateway.config import GatewayConfig, load_gateway_config
+from gateway.drain_control import HANDOVER_HEALTH, HANDOVER_READS, handover_read
+from gateway.run_api import GatewayRuntimeAPI, end_gateway_api_reads, seal_gateway_api
+
+
+def test_off_by_default():
+    assert GatewayConfig().restart_listener_handover is False
+    assert GatewayConfig.from_dict({}).restart_listener_handover is False
+    assert GatewayConfig.from_dict({"gateway": {"restart_listener_handover": True}}).restart_listener_handover
+
+
+def test_config_yaml_key_reaches_the_runner_config(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    (tmp_path / "config.yaml").write_text("gateway:\n  restart_listener_handover: true\n", encoding="utf-8")
+    assert load_gateway_config().restart_listener_handover is True
+
+
+def test_handover_stages_serve_reads_then_health_only():
+    runner = SimpleNamespace(_listener_handover=HANDOVER_READS)
+    assert handover_read(runner, "GET", "/api/health")
+    assert handover_read(runner, "GET", "/api/sessions/s1/messages")
+    assert not handover_read(runner, "POST", "/api/sessions/s1/messages")
+    assert not handover_read(runner, "GET", "/api/config")
+    runner._listener_handover = HANDOVER_HEALTH
+    assert handover_read(runner, "GET", "/api/health")
+    assert not handover_read(runner, "GET", "/api/status")
+    runner._listener_handover = None
+    assert not handover_read(runner, "GET", "/api/health")
+
+
+def _stopping_runner(stage=None):
+    return SimpleNamespace(_draining=True, _running=False, _listener_handover=stage,
+                           session_runtime_descriptor={"state": "draining", "capabilities": []})
+
+
+async def _get(api, path, method="GET"):
+    sent = []
+
+    async def receive():
+        return {"type": "http.request", "body": b"", "more_body": False}
+
+    async def send(message):
+        sent.append(message)
+
+    scope = {"type": "http", "method": method, "path": path, "query_string": b"", "headers": [],
+             "client": ("127.0.0.1", 1), "server": ("127.0.0.1", 9120), "scheme": "http",
+             "http_version": "1.1", "root_path": ""}
+    await api(scope, receive, send)
+    start = next(m for m in sent if m["type"] == "http.response.start")
+    body = b"".join(m.get("body", b"") for m in sent if m["type"] == "http.response.body")
+    return start["status"], body
+
+
+async def _upgrade(api, path="/api/ws"):
+    sent = []
+
+    async def receive():
+        return {"type": "websocket.connect"}
+
+    async def send(message):
+        sent.append(message)
+
+    scope = {"type": "websocket", "path": path, "query_string": b"", "headers": [],
+             "client": ("127.0.0.1", 1), "server": ("127.0.0.1", 9120), "scheme": "ws", "subprotocols": []}
+    await api(scope, receive, send)
+    return sent
+
+
+def _sealed(api):
+    seal_gateway_api(SimpleNamespace(api=api, server=SimpleNamespace(server_state=SimpleNamespace(connections=set()))))
+    return api
+
+
+def _api(runner):
+    reached = []
+
