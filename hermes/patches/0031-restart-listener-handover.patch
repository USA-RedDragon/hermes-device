+async def test_bootstrap_gives_up_the_host_role_before_closing_the_listener(monkeypatch):
+    from gateway import host_rendezvous as hr
+    from gateway.run_bootstrap import _release_profile_then_close_listener
+    order = []
+    monkeypatch.setattr(hr, "_cleanup_roles", [hr.ROLE_GATEWAY])
+    monkeypatch.setattr(hr, "clear_record", lambda role: order.append(("record", role)))
+    monkeypatch.setattr(hr, "release_host_lock", lambda role: order.append(("lock", role)))
+    runner = SimpleNamespace(stop_handover_listener=AsyncMock(side_effect=lambda: order.append("listener")))
+    await _release_profile_then_close_listener(runner)
+    assert order == [("record", hr.ROLE_GATEWAY), ("lock", hr.ROLE_GATEWAY), "listener"]
+    # The exit cleanup is disarmed: a successor's record (often under the same PID number, in its
+    # own PID namespace) is never removed when this process exits.
+    hr._cleanup_role_on_exit(hr.ROLE_GATEWAY)
+    assert order == [("record", hr.ROLE_GATEWAY), ("lock", hr.ROLE_GATEWAY), "listener"]
