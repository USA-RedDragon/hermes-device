@@ -416,8 +458,42 @@ class GatewayRuntimeAPI:
     """
     def __init__(self, app, runner, web_app):
         self.app, self.runner, self.web_app = app, runner, web_app
+        #: Tasks of the requests in progress (``end_gateway_api_reads`` waits for them).
+        self.inflight: set = set()
+        #: Set by :func:`seal_gateway_api`: only a restart stop's handover reads are served.
+        self.sealed = False
 
     async def __call__(self, scope, receive, send):
+        task = asyncio.current_task()
+        self.inflight.add(task)
+        try:
+            return await self._call(scope, receive, send)
+        finally:
+            self.inflight.discard(task)
+
+    async def _serve_sealed(self, scope, receive, send):
+        """A sealed listener serves the handover's reads (the dashboard's while the stores are open,
+        health itself once they close) and refuses everything else."""
+        from gateway.drain_control import HANDOVER_HEALTH
+        from starlette.responses import JSONResponse
+        if _handover_read(self.runner, scope):
+            if getattr(self.runner, '_listener_handover', None) != HANDOVER_HEALTH:
+                return await self.app(scope, receive, send)
+            from hermes_cli.version_info import get_version_info
+            info = get_version_info()
+            return await JSONResponse({
+                'ok': True, 'version': info.base_version, 'displayVersion': info.display_version,
+                'commit': info.commit, 'auth_required': bool(getattr(self.web_app.state, 'auth_required', False)),
+            })(scope, receive, send)
+        if scope['type'] == 'websocket':
+            await send({'type': 'websocket.close', 'code': 1013})
+        elif scope['type'] == 'http':
+            await JSONResponse({'error': 'gateway_not_ready', 'state': 'draining'}, status_code=503)(
+                scope, receive, send)
+
+    async def _call(self, scope, receive, send):
+        if self.sealed:
+            return await self._serve_sealed(scope, receive, send)
         if scope['type'] != 'websocket' or scope.get('path') != '/api/ws':
             return await self._serve(scope, receive, send)
         started = accepted = False
@@ -451,6 +527,7 @@ class GatewayRuntimeAPI:
             and scope['type'] == 'websocket' and scope['path'] == '/api/ws')
