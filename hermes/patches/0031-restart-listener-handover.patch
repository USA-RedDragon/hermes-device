+# ``gateway.restart_listener_handover``: what a restart stop's listener still serves. READS while the
+# stores are open (health and the reads above), HEALTH once they close, until the profile is released.
+HANDOVER_READS = "reads"
+HANDOVER_HEALTH = "health"
+
+
+def handover_read(runner, method, path) -> bool:
+    """True for a GET the listener of *runner*'s restart stop still serves (``_listener_handover``)."""
+    stage = getattr(runner, "_listener_handover", None)
+    if method != "GET" or stage not in (HANDOVER_READS, HANDOVER_HEALTH):
+        return False
+    return path == "/api/health" if stage == HANDOVER_HEALTH else bool(_RESTART_WAIT_READS.fullmatch(path or ""))
+
+
