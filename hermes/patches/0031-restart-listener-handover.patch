+    def _begin_listener_handover(self) -> None:
+        """``gateway.restart_listener_handover``: a restart stop keeps the listener bound until the profile
+        is released, serving health and the restart wait's reads while the stores are open."""
+        handle = getattr(self, "session_api", None)
+        if (not getattr(self, "_restart_requested", False) or handle is None or handle.task.done()
+                or not getattr(getattr(self, "config", None), "restart_listener_handover", False)):
+            return
+        from gateway.drain_control import HANDOVER_READS
+        self._listener_handover = HANDOVER_READS
+
+    async def _stop_end_listener_reads(self, ctx: GatewayShutdownMixin._StopContext) -> None:
+        """Before the stores close, a handover listener stops serving reads; health still answers."""
+        handle = getattr(self, "session_api", None)
+        if not getattr(self, "_listener_handover", None) or handle is None:
+            return
+        from gateway.run_api import end_gateway_api_reads
+        elapsed = ctx.elapsed if ctx.started_at is not None else (lambda: 0.0)  # a stop that failed at once
+        # Bounded like the listener's own graceful shutdown, within what the watchdog leash has left.
+        budget = max(0.0, min(5.0, _effective_watchdog_leash(self) - elapsed() - 5.0))
+        try:
+            await end_gateway_api_reads(self, handle, budget)
+        except Exception:
+            logger.warning("Gateway API reads did not end cleanly before the stores close", exc_info=True)
+        logger.info("Shutdown phase: listener reads ended at +%.2fs", elapsed())
+
+    async def stop_handover_listener(self) -> None:
+        """Close a handover listener; the process bootstrap calls this once the profile is released.
+        Health keeps answering until the listener stops accepting."""
+        handle = getattr(self, "session_api", None)
+        if (not getattr(self, "_listener_handover", None) or handle is None
+                or getattr(self, "_handover_listener_closing", False)):
+            return
+        self._handover_listener_closing = True
+        from gateway.run_api import stop_gateway_api
+        await stop_gateway_api(handle)
+        self._listener_handover = None
+
