+def _provenance_on() -> bool:
+    try:
+        return _automode.provenance_enabled()
+    except Exception:
+        return False
+
+
+_REVIEW_ADVICE = (" If other work does not depend on this action, continue with it. Do NOT retry this action, "
+                  "rephrase it, or reach the same outcome another way; ask the user instead.")
+
+
+def _provenance_decision(spec: _GateSpec, tool_name: str, args: dict, *, command: str, approval_callback,
+                         is_cli: bool, is_gateway: bool, is_ask: bool, pending_body=None) -> dict:
+    """Provenance review (``approvals.smart_provenance``) of one action: allow runs it; a HARD rule
+    block is final; a SOFT rule block, or a review that could not decide, goes to the human as a
+    one-operation card naming the rule (blocked when no human can answer). Never allows on a failed review."""
+    session_key = get_current_session_key()
+    verdict = _automode.review(tool_name, args)
+    if verdict.decision == "allow":
+        _reset_denials(session_key)
+        return {"approved": True, "message": None, "smart_approved": True,
+                "description": "smart approval (provenance review)"}
+    rule_fields = {"smart_denied": True, "smart_rule": verdict.rule, "smart_reason": verdict.reason,
+                   "smart_tier": verdict.tier or None}
+    if verdict.decision == "block":
+        _record_denial(session_key)
+    if verdict.decision == "block" and verdict.tier == "hard":
+        return {"approved": False, "outcome": "denied", "description": verdict.card_text, **rule_fields,
+                "message": (f"BLOCKED by {verdict.card_text}. This is a hard rule: nothing the user says in chat "
+                            f"clears it.{_REVIEW_ADVICE}{_denial_breaker_addendum(session_key)}")}
+    if not (is_cli or is_gateway or is_ask):
+        return {"approved": False, "outcome": "denied", "description": verdict.card_text, **rule_fields,
+                "message": f"BLOCKED by {verdict.card_text}.{_REVIEW_ADVICE}{_denial_breaker_addendum(session_key)}"}
+    result = _human_decision(spec, command=command, description=verdict.card_text, pattern_key="smart_provenance",
+                             pattern_keys=["smart_provenance"], session_key=session_key,
+                             approval_callback=approval_callback, is_cli=is_cli, is_gateway=is_gateway,
+                             is_ask=is_ask, pending_body=pending_body, review_blocked=True)
+    if not result.get("approved"):
+        result.update(rule_fields)
+        message = result.get("message") or "BLOCKED."
+        if verdict.card_text not in message:
+            result["message"] = f"{message} (Flagged by {verdict.card_text}.)"
+    return result
+
+
+def check_tool_provenance(tool_name: str, args: dict, task_id: str = "default") -> str | None:
+    """Provenance review for tool calls other than terminal and execute_code (their guards review them).
+    Returns a block message, or None when the call may run. Reads, and writes inside the session's project
+    that are not instruction, config or credential files, skip the review."""
