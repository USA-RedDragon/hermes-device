+                                  is_ask=is_ask)
+    return None if result.get("approved") else (result.get("message") or "BLOCKED by smart approval.")
+
+
+def _project_write(tool_name: str, args: dict, task_id: str) -> bool:
+    """A write_file or patch whose every target lies inside the session's working directory and is not an
+    instruction, config, credential or shell-startup file."""
+    if tool_name == "patch" and args.get("mode", "replace") == "patch":
