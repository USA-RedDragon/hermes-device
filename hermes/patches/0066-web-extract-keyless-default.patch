@@ -0,0 +1,201 @@
+"""web_extract works out of the box: a search-only backend never ends an unpinned extract."""
+
+import asyncio
+import json
+import threading
+from http.server import BaseHTTPRequestHandler, HTTPServer
+
+import pytest
+
+from agent import web_search_registry as registry
+from tools import url_safety, web_tools
+from tools import tool_backend_helpers as helpers
+from tools.web_http_fetch import html_to_markdown
+
+PAGE = b"""<!doctype html><html><head><title>Hello Page</title><style>p{}</style>
+<script>var x = 1;</script></head><body><nav>menu</nav>
+<main><h1>Heading</h1><p>First <b>bold</b> paragraph with a <a href="/next">link</a>.</p>
+<ul><li>one</li><li>two</li></ul><pre>code  line</pre>
+<p>""" + b"filler text " * 30 + b"""</p></main><footer>foot</footer></body></html>"""
+
+
+class _Handler(BaseHTTPRequestHandler):
+    def do_GET(self):
+        if self.path == "/redirect-private":
+            self.send_response(302)
+            self.send_header("Location", "http://10.255.255.1/secret")
+            self.end_headers()
+            return
+        if self.path == "/missing":
+            self.send_response(404)
+            self.send_header("Content-Type", "text/html")
+            self.end_headers()
+            self.wfile.write(b"<html><body>nope</body></html>")
+            return
+        if self.path == "/big":
+            body, ctype = b"abcdefghij " * 5000, "text/plain"
+        elif self.path == "/plain":
+            body, ctype = "caf\u00e9 text".encode(), "text/plain; charset=utf-8"
+        else:
+            body, ctype = PAGE, "text/html; charset=utf-8"
+        self.send_response(200)
+        self.send_header("Content-Type", ctype)
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+    def log_message(self, *args):
+        pass
+
+
+@pytest.fixture()
+def server():
+    httpd = HTTPServer(("127.0.0.1", 0), _Handler)
+    thread = threading.Thread(target=httpd.serve_forever, daemon=True)
+    thread.start()
+    yield f"http://127.0.0.1:{httpd.server_port}"
+    httpd.shutdown()
+    thread.join(timeout=5)
+
+
+@pytest.fixture(autouse=True)
+def _only_searxng(monkeypatch):
+    """Only web.search_backend: searxng and SEARXNG_URL; no keys, no keyless vendors, no network but loopback."""
+    for var in (
+        "EXA_API_KEY", "PARALLEL_API_KEY", "KEENABLE_API_KEY", "TAVILY_API_KEY", "PERPLEXITY_API_KEY",
+        "FIRECRAWL_API_KEY", "FIRECRAWL_API_URL", "BRAVE_SEARCH_API_KEY",
+    ):
+        monkeypatch.delenv(var, raising=False)
+    monkeypatch.setenv("SEARXNG_URL", "http://127.0.0.1:1")
+    monkeypatch.setattr("agent.web_search_provider.get_provider_env", lambda name: __import__("os").environ.get(name, ""))
+    monkeypatch.setattr(web_tools, "_env_value", lambda name: __import__("os").environ.get(name, ""))
+    monkeypatch.setattr(web_tools, "_is_tool_gateway_ready", lambda: False)
+    monkeypatch.setattr(web_tools, "_ddgs_package_importable", lambda: False)
+    monkeypatch.setattr(registry, "_keyless_tier_enabled", lambda: False)
+    monkeypatch.setattr(helpers, "_raw_section", lambda section: {"search_backend": "searxng"} if section == "web" else None)
+    _set_web({"search_backend": "searxng"}, monkeypatch)
+
+
+def _set_web(cfg, monkeypatch):
+    monkeypatch.setattr(web_tools, "_load_web_config", lambda: dict(cfg))
+    monkeypatch.setattr(helpers, "_raw_section", lambda section: dict(cfg) if section == "web" else None)
+    monkeypatch.setattr(registry, "_read_config_key", lambda *path: (cfg.get(path[-1]) or None) if path[0] == "web" else None)
+
+
+@pytest.fixture()
+def allow_loopback(monkeypatch):
+    monkeypatch.setenv("HERMES_ALLOW_PRIVATE_URLS", "true")
+    url_safety._reset_allow_private_cache()
+    yield
+    url_safety._reset_allow_private_cache()
+
+
+def _extract(url, **kwargs):
+    return json.loads(asyncio.run(web_tools.web_extract_tool([url], **kwargs)))
+
+
+def test_unpinned_extract_skips_searxng(monkeypatch):
+    assert web_tools._get_search_backend() == "searxng"
+    assert web_tools._get_extract_backend() == "http-fetch"
+    assert web_tools._autodetect_backend("extract") is None
+    assert web_tools._autodetect_backend() == "searxng"
+
+
+def test_shared_search_only_backend_does_not_pin_extract(monkeypatch):
+    _set_web({"backend": "searxng"}, monkeypatch)
+    assert web_tools._get_search_backend() == "searxng"
+    assert web_tools._get_extract_backend() == "http-fetch"
+
+
+def test_extract_capable_autodetect_still_wins(monkeypatch):
+    monkeypatch.setenv("EXA_API_KEY", "k")
+    assert web_tools._get_extract_backend() == "exa"
+
+
+def test_extract_returns_page_content_with_only_searxng(server, allow_loopback):
+    result = _extract(server + "/page")
+    assert "error" not in result, result
+    page = result["results"][0]
+    assert page["title"] == "Hello Page"
+    content = page["content"]
+    assert "# Heading" in content
+    assert "**bold**" in content and f"[link]({server}/next)" in content
+    assert "- one" in content and "- two" in content
+    assert "code  line" in content
+    assert "menu" not in content and "foot" not in content and "var x" not in content
+    assert not page.get("error")
+
+
+def test_extract_plain_text_and_char_limit(server, allow_loopback):
+    page = _extract(server + "/plain")["results"][0]
+    assert page["content"] == "caf\u00e9 text"
+    big = _extract(server + "/big", char_limit=2000)["results"][0]
+    assert 0 < len(big["content"]) < 10000
+
+
+def test_origin_http_error_is_reported(server, allow_loopback):
+    page = _extract(server + "/missing")["results"][0]
+    assert page["error"].startswith("HTTP 404 from origin")
+
+
+def test_private_address_blocked_without_opt_in(server):
+    url_safety._reset_allow_private_cache()
+    page = _extract(server + "/page")["results"][0]
+    assert "private or internal network" in page["error"]
+
+
+def test_redirect_to_private_address_is_blocked(server, allow_loopback, monkeypatch):
+    real = url_safety.is_safe_url
+    monkeypatch.setattr(url_safety, "is_safe_url", lambda u: False if "10.255.255.1" in u else real(u))
+    page = _extract(server + "/redirect-private")["results"][0]
+    assert "private or internal network" in page["error"]
+
+
+def test_secret_in_url_is_refused(server, allow_loopback):
+    result = _extract(server + "/page?key=sk-ant-api03-abcdefghijklmnopqrstuvwxyz0123456789")
+    assert result["success"] is False and "API key" in result["error"]
+
+
+def test_pinned_search_only_extract_backend_is_one_config_error(server, allow_loopback, monkeypatch):
+    _set_web({"search_backend": "searxng", "extract_backend": "searxng"}, monkeypatch)
+    result = _extract(server + "/page")
+    assert result["success"] is False
+    error = result["error"]
+    assert "web.extract_backend is set to 'searxng'" in error and "search-only" in error
+    assert "http-fetch" in error and "\n" not in error
+
+
+def test_config_check_flags_search_only_extract_pin():
+    from hermes_cli.config_value_checks import _validate_web_backends
+
+    issues: list = []
+    _validate_web_backends({"web": {"extract_backend": "searxng"}}, issues)
+    assert len(issues) == 1 and issues[0].severity == "error" and "extract_backend" in issues[0].message
+    issues = []
+    _validate_web_backends({"web": {"search_backend": "searxng", "extract_backend": "exa"}}, issues)
+    assert issues == []
+
+
+def test_http_fetch_pin_resolves(server, allow_loopback, monkeypatch):
+    _set_web({"search_backend": "searxng", "extract_backend": "http-fetch"}, monkeypatch)
+    assert _extract(server + "/page")["results"][0]["title"] == "Hello Page"
+
+
+def test_http_fetch_never_joins_search_or_availability_walks(monkeypatch):
+    from tools.web_http_fetch import HttpFetchProvider
+
+    provider = HttpFetchProvider()
+    assert provider.supports_extract() and not provider.supports_search()
+    assert not provider.is_available()
+    web_tools._ensure_web_plugins_loaded()
+    assert registry.get_provider("http-fetch") is not None
+    assert registry.get_active_search_provider().name == "searxng"
+
+
+def test_html_to_markdown_basics():
+    title, md = html_to_markdown(
+        "<title> T </title><h2>Sub</h2><p>a<br>b</p><ol><li>x</li><li>y</li></ol>"
+        "<a href='javascript:void(0)'>skip</a><img src='/i.png' alt='pic'>", "http://h/dir/")
+    assert title == "T"
+    assert "## Sub" in md and "1. x" in md and "2. y" in md and "![pic](http://h/i.png)" in md
+    assert "[skip]" not in md and "skip" in md
