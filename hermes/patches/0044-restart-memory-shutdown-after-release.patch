index 493d361a0f..c8b6c75224 100644
--- a/gateway/run_bootstrap.py
+++ b/gateway/run_bootstrap.py
@@ -1240,5 +1240,13 @@ async def _start_gateway_runtime(config: Optional[GatewayConfig] = None, replace
             _export_tickets_for_successor(runner)
             release_gateway_runtime_lock()
             stop_trace.finish("bootstrap: lock released")
