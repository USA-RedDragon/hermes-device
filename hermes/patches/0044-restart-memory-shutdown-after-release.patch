From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jacob McSwain <jacob@mcswain.dev>
Date: Thu, 12 Nov 2026 21:57:27 +0000
Subject: [PATCH] feat(gateway): a restart stop leaves memory-provider
 shutdowns until after the release

gateway.restart_memory_shutdown_after_release_seconds (0 = off; with restart_agent_cleanup_seconds): on a restart stop, each idle cached agent whose queued memory writes and session end were flushed (as before, inside the stop) shuts its memory providers down on a thread of its own instead of inside the capped cleanup, and the process waits up to this long for those threads after it released the profile, alongside the listener relay. A Honcho read-ahead for a next turn that never comes held the cleanup to its 5 s cap, and the abandoned worker then held the executor quiesce 2 s more and made the stop skip the SessionDB close.
---
 agent/memory_manager.py                       |  12 ++
 gateway/config.py                             |  10 +-
 gateway/config_loader.py                      |   2 +
 gateway/run_bootstrap.py                      |   8 +
 gateway/run_shutdown.py                       |  56 ++++++
 ...t_restart_memory_shutdown_after_release.py | 166 ++++++++++++++++++
 6 files changed, 253 insertions(+), 1 deletion(-)
 create mode 100644 tests/gateway/test_restart_memory_shutdown_after_release.py

diff --git a/agent/memory_manager.py b/agent/memory_manager.py
index c32ceca9bd..2c797e682f 100644
--- a/agent/memory_manager.py
+++ b/agent/memory_manager.py
@@ -885,8 +885,20 @@ class MemoryManager:
             self.flush_pending(timeout=10)
             self.shutdown_all()
 
+    def detach_shutdown(self) -> Callable[[], None]:
+        """Take ``shutdown_all()`` out of this manager's teardown and return it: later ``shutdown_all()`` calls
+        (``shutdown_memory_provider``, ``close()``) do nothing, and the caller runs the returned one once, on its
+        own thread (a restart stop with ``gateway.restart_memory_shutdown_after_release_seconds``)."""
+        self._shutdown_detached = True
+        return self._shutdown_all_now
+
     def shutdown_all(self) -> None:
         """Drain the background executor (bounded), then shut providers down in reverse order."""
+        if getattr(self, "_shutdown_detached", False):
+            return
+        self._shutdown_all_now()
+
+    def _shutdown_all_now(self) -> None:
         self._drain_sync_executor()
         self._each_provider("shutdown failed", lambda p: p.shutdown(), level=logging.WARNING,
                             providers=self._providers[::-1])
diff --git a/gateway/config.py b/gateway/config.py
index da23fc76b6..dfa1fa3f40 100644
--- a/gateway/config.py
+++ b/gateway/config.py
@@ -676,6 +676,12 @@ class GatewayConfig:
     # took over answered ready, so its client's one reconnect reaches that gateway directly instead of a socket the
     # old listener relays and closes again when the relay window ends. 0 = close when the stop ends the session.
     restart_socket_close_delay_seconds: float = 0.0
+    # With restart_agent_cleanup_seconds: on a restart stop the memory providers of idle cached agents shut down
+    # (joining their writer and read-ahead threads) in their own threads, outside the stop, after their queued
+    # writes and session-end flush ran as before; the process waits up to this long for them after it released
+    # the profile, before it exits. A read-ahead for a next turn that never comes no longer holds the stop, nor
+    # the executor quiesce (which then skipped the SessionDB close). 0 = they shut down inside the stop.
+    restart_memory_shutdown_after_release_seconds: float = 0.0
     # In-process loop liveness watchdog: after consecutive missed probes it dumps all-thread stacks
     # and hard-exits with the service-restart code. The knobs tolerate transient self-recovering
     # stalls (adapter reconnect doing sync socket I/O) so a short block does not cause restart churn.
@@ -715,7 +721,7 @@ class GatewayConfig:
         "restart_wait_delegations", "restart_listener_handover", "listener_start_hold_seconds",
         "restart_listener_relay_seconds", "restart_listener_hold_seconds", "stop_trace",
         "restart_ticket_handover", "restart_listener_relay_close_sockets", "restart_reads_grace_seconds",
-        "restart_socket_close_delay_seconds", "loop_watchdog",
+        "restart_socket_close_delay_seconds", "restart_memory_shutdown_after_release_seconds", "loop_watchdog",
         "loop_watchdog_probe_interval_s", "loop_watchdog_probe_timeout_s",
         "loop_watchdog_max_strikes", "unauthorized_dm_behavior", "unauthorized_dm_decline_message",
     )
@@ -861,6 +867,8 @@ class GatewayConfig:
             restart_listener_relay_close_sockets=_coerce_bool(pick("restart_listener_relay_close_sockets"), False),
             restart_reads_grace_seconds=bounded_float("restart_reads_grace_seconds", 0.0, 0.0, 60.0),
             restart_socket_close_delay_seconds=bounded_float("restart_socket_close_delay_seconds", 0.0, 0.0, 60.0),
+            restart_memory_shutdown_after_release_seconds=bounded_float(
+                "restart_memory_shutdown_after_release_seconds", 0.0, 0.0, 600.0),
             restart_wait_plugin_sockets=[
                 str(name).strip("/ ") for name in (pick("restart_wait_plugin_sockets") or [])
                 if isinstance(pick("restart_wait_plugin_sockets"), list) and str(name).strip("/ ")],
