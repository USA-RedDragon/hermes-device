@@ -0,0 +1,152 @@
+"""agent_turn_start / agent_turn_end bracket every admitted AIAgent.run_conversation turn."""
+
+from __future__ import annotations
+
+import pytest
+
+from hermes_cli.plugins import VALID_HOOKS
+from hermes_cli.plugins_dispatch import _HOOK_TIMEOUT_BOUNDED_HOOKS
+from run_agent import AIAgent
+
+
+class _DB:
+    def __init__(self, acquire_result=True):
+        self.acquire_result = acquire_result
+
+    def get_session(self, session_id):
+        return {"id": session_id}
+
+    def acquire_session_turn_lease(self, session_id, holder, **kwargs):
+        return self.acquire_result
+
+    def resolve_resume_session_id(self, session_id):
+        return session_id
+
+    def get_messages_as_conversation(self, session_id, **kwargs):
+        return []
+
+    def refresh_session_turn_lease(self, session_id, holder, **kwargs):
+        return True
+
+    def release_session_turn_lease(self, session_id, holder):
+        pass
+
+
+def _agent(*, db=None, persist_disabled=False):
+    agent = AIAgent.__new__(AIAgent)
+    agent.session_id = "s1"
+    agent.platform = "tui"
+    agent.model = "test-model"
+    agent._session_db = db or _DB()
+    agent._session_db_created = True
+    agent._persist_disabled = persist_disabled
+    agent._parent_session_id = None
+    agent._relay_pending_turn_id = None
+    agent._reset_activity_labels_after_turn = lambda: None
+    agent._conversation_root_id = lambda: "s1"
+    agent.log_prefix = ""
+    agent._vprint = lambda *a, **k: None
+    agent.status_callback = None
+    agent._interrupt_requested = False
+    agent._interrupt_message = None
+    agent._pending_redirect = None
+    agent._execution_thread_id = None
+    agent._interrupt_thread_signal_pending = False
+    return agent
+
+
+@pytest.fixture
+def hooks(monkeypatch):
+    calls = []
+    monkeypatch.setattr("hermes_cli.lifecycle.invoke_hook", lambda name, **kw: calls.append((name, kw)) or [])
+    monkeypatch.setattr("agent.relay_cwd.resolve_relay_scope_cwds", lambda *_a: ("", ""))
+    return calls
+
+
+def _turn_events(calls):
+    return [(name, kw) for name, kw in calls if name in {"agent_turn_start", "agent_turn_end"}]
+
+
+def test_hooks_are_registered_observers():
+    assert {"agent_turn_start", "agent_turn_end"} <= VALID_HOOKS
+    assert {"agent_turn_start", "agent_turn_end"} <= _HOOK_TIMEOUT_BOUNDED_HOOKS
+
+
+@pytest.mark.parametrize("result, outcome", [
+    ({"final_response": "ok", "messages": []}, "success"),
+    ({"final_response": "", "messages": [], "failed": True}, "failed"),
+    ({"final_response": "", "messages": [], "interrupted": True}, "cancelled"),
+])
+def test_start_and_end_bracket_every_returned_turn(monkeypatch, hooks, result, outcome):
+    seen = {}
+
+    def fake_run(agent, *_args, **_kwargs):
+        seen["during"] = [name for name, _kw in _turn_events(hooks)]
+        return dict(result)
+
+    monkeypatch.setattr("agent.conversation_loop.run_conversation", fake_run)
+    AIAgent.run_conversation(_agent(), "hello", task_id="t1")
+
+    events = _turn_events(hooks)
+    assert seen["during"] == ["agent_turn_start"]
+    assert [name for name, _kw in events] == ["agent_turn_start", "agent_turn_end"]
+    start, end = events[0][1], events[1][1]
+    assert start["session_id"] == "s1" and start["task_id"] == "t1"
+    assert start["platform"] == "tui" and start["model"] == "test-model"
+    assert start["turn_id"] and start["turn_id"] == end["turn_id"]
+    assert end == {**start, "outcome": outcome}
+
+
+def test_end_fires_when_the_turn_raises(monkeypatch, hooks):
+    def boom(*_args, **_kwargs):
+        raise RuntimeError("provider exploded")
+
+    monkeypatch.setattr("agent.conversation_loop.run_conversation", boom)
+    with pytest.raises(RuntimeError):
+        AIAgent.run_conversation(_agent(), "hello", task_id="t1")
+
+    events = _turn_events(hooks)
+    assert [name for name, _kw in events] == ["agent_turn_start", "agent_turn_end"]
+    assert events[1][1]["outcome"] == "failed"
+
+
+def test_end_keeps_the_start_session_id_after_a_mid_turn_rotation(monkeypatch, hooks):
+    def rotate(agent, *_args, **_kwargs):
+        agent.session_id = "s1-compacted"
+        return {"final_response": "ok", "messages": []}
+
+    monkeypatch.setattr("agent.conversation_loop.run_conversation", rotate)
+    AIAgent.run_conversation(_agent(), "hello", task_id="t1")
+
+    assert [kw["session_id"] for _name, kw in _turn_events(hooks)] == ["s1", "s1"]
+
+
+def test_persistence_disabled_fork_fires_nothing(monkeypatch, hooks):
+    monkeypatch.setattr("agent.conversation_loop.run_conversation",
+                        lambda *_a, **_k: {"final_response": "ok", "messages": []})
+    AIAgent.run_conversation(_agent(persist_disabled=True), "hello", task_id="t1")
+
+    assert _turn_events(hooks) == []
+
+
+def test_unadmitted_turn_fires_nothing(monkeypatch, hooks):
+    def never(*_args, **_kwargs):
+        raise AssertionError("turn must not start without a lease")
+
+    monkeypatch.setattr("agent.conversation_loop.run_conversation", never)
+    result = AIAgent.run_conversation(_agent(db=_DB(acquire_result=False)), "hello", task_id="t1")
+
+    assert result["failed"] is True
+    assert _turn_events(hooks) == []
+
+
+def test_a_failing_hook_never_breaks_the_turn(monkeypatch):
+    def broken(name, **_kw):
+        raise RuntimeError("plugin bug")
+
+    monkeypatch.setattr("hermes_cli.lifecycle.invoke_hook", broken)
+    monkeypatch.setattr("agent.relay_cwd.resolve_relay_scope_cwds", lambda *_a: ("", ""))
+    monkeypatch.setattr("agent.conversation_loop.run_conversation",
+                        lambda *_a, **_k: {"final_response": "ok", "messages": []})
+
+    assert AIAgent.run_conversation(_agent(), "hello", task_id="t1")["final_response"] == "ok"
diff --git a/tests/e2e/core/providers/test_turn_lifecycle_hooks.py b/tests/e2e/core/providers/test_turn_lifecycle_hooks.py
new file mode 100644
index 0000000000..173f6a97b5
--- /dev/null
+++ b/tests/e2e/core/providers/test_turn_lifecycle_hooks.py
@@ -0,0 +1,75 @@
+"""``agent_turn_start`` / ``agent_turn_end`` through a REAL ``hermes -z`` process.
+
+A loopback fake provider answers with a non-retryable 400, so the turn leaves the loop on an
+early return that never reaches ``finalize_turn``: ``post_llm_call`` and ``on_session_end`` do
+not fire for it. The turn bracket still closes, and a normal turn closes it with ``success``.
+"""
+
+from __future__ import annotations
+
+import json
+import sys
+
+import pytest
+
+from tests.e2e.core.providers._openai_helpers import Home, bounded_turn, custom_chat_config
+from tests.fakes.providers.chat_variants import CError, CText, FakeChatVariantServer
+
+pytestmark = pytest.mark.skipif(not sys.platform.startswith("linux"), reason="subprocess harness is Linux-gated")
+
+PLUGIN = "turn-bracket-probe"
+HOOKS = ("agent_turn_start", "agent_turn_end", "pre_llm_call", "post_llm_call", "on_session_end")
+
+
+def _home(tmp_path, base_url) -> tuple[Home, object]:
+    log = tmp_path / "hooks.log"
+    cfg = custom_chat_config(base_url)
+    cfg["plugins"] = {"enabled": [PLUGIN]}
+    h = Home(tmp_path).write(cfg, {"OPENAI_API_KEY": "sk-fake"})
+    plugin = h.hermes_home / "plugins" / PLUGIN
+    plugin.mkdir(parents=True)
+    (plugin / "plugin.yaml").write_text(f"name: {PLUGIN}\nversion: 1.0.0\ndescription: turn bracket probe\n")
+    (plugin / "__init__.py").write_text(
+        "import json\n"
+        "def register(ctx):\n"
+        f"    for name in {HOOKS!r}:\n"
+        "        def cb(_name=name, **kw):\n"
+        f"            with open({str(log)!r}, 'a') as fh:\n"
+        "                fh.write(json.dumps({'hook': _name, 'session_id': kw.get('session_id'),\n"
+        "                                     'turn_id': kw.get('turn_id'), 'outcome': kw.get('outcome')}) + '\\n')\n"
+        "        ctx.register_hook(name, cb)\n"
+    )
+    return h, log
+
+
+def _events(log) -> list[dict]:
+    return [json.loads(line) for line in log.read_text().splitlines()] if log.exists() else []
+
+
+def test_turn_bracket_closes_on_an_early_return(tmp_path) -> None:
+    with FakeChatVariantServer(lambda _r: CError(400, "bad request", code="invalid_request_error")) as provider:
+        h, log = _home(tmp_path, provider.base_url)
+        run = bounded_turn(h, "say hello", 60.0)
+    events = _events(log)
+    names = [e["hook"] for e in events]
+
+    assert names.count("agent_turn_start") == 1 and names.count("agent_turn_end") == 1, run.describe()
+    assert "post_llm_call" not in names and "on_session_end" not in names, names
+    start = next(e for e in events if e["hook"] == "agent_turn_start")
+    end = next(e for e in events if e["hook"] == "agent_turn_end")
+    assert names.index("agent_turn_start") < names.index("pre_llm_call") < names.index("agent_turn_end")
+    assert (end["session_id"], end["turn_id"]) == (start["session_id"], start["turn_id"])
+    assert start["session_id"] == run.session_id
+    assert end["outcome"] == "failed"
+
+
+def test_turn_bracket_wraps_a_normal_turn(tmp_path) -> None:
+    with FakeChatVariantServer(lambda _r: CText("hello there")) as provider:
+        h, log = _home(tmp_path, provider.base_url)
