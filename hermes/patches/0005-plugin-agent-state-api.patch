diff --git a/tests/agent/test_subagent_lifecycle_active.py b/tests/agent/test_subagent_lifecycle_active.py
new file mode 100644
index 0000000000..61b5371371
--- /dev/null
+++ b/tests/agent/test_subagent_lifecycle_active.py
@@ -0,0 +1,78 @@
+"""SubagentLifecycleService.list_active / steer_active: the running delegated children of this process."""
+
+from __future__ import annotations
+
+import dataclasses
+
+import pytest
+
+from agent.subagent_lifecycle import ActiveSubagent, SubagentLifecycleService
+from tools.delegate_tool_registry import _close_subagent_steering, _register_subagent, _unregister_subagent
+
+
+class _Child:
+    def __init__(self, session_id):
+        self.session_id = session_id
+        self.steered = []
+
+    def steer(self, text):
+        self.steered.append(text)
+        return True
+
+
+@pytest.fixture
+def child():
+    agent = _Child("child-session")
+    _register_subagent({
+        "subagent_id": "sa-active-1", "parent_id": "sa-root", "depth": 1, "goal": "check the logs",
+        "model": "test-model", "started_at": 12.5, "status": "running", "agent": agent,
+        "owner_agent_session_id": "parent-session", "owner_session_id": "private-owner",
+    })
+    yield agent
+    _unregister_subagent("sa-active-1", agent=agent)
+
+
+def _listed(subagent_id):
+    return next((a for a in SubagentLifecycleService.list_active() if a.subagent_id == subagent_id), None)
+
+
+def test_list_active_snapshots_a_running_child(child):
+    snap = _listed("sa-active-1")
+
+    assert snap == ActiveSubagent(
+        subagent_id="sa-active-1", session_id="child-session", parent_subagent_id="sa-root",
+        parent_session_id="parent-session", depth=1, goal="check the logs", model="test-model",
+        status="running", started_at=12.5, steerable=True,
+    )
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        snap.status = "done"
+
+
+def test_list_active_follows_the_child_session_id(child):
+    child.session_id = "child-session-compacted"
+
+    assert _listed("sa-active-1").session_id == "child-session-compacted"
+
+
+def test_finished_child_leaves_the_list(child):
+    _unregister_subagent("sa-active-1", agent=child)
+
+    assert _listed("sa-active-1") is None
+
+
+def test_steer_active_reaches_a_running_child(child):
+    assert SubagentLifecycleService.steer_active("sa-active-1", "  look at disk too  ") is True
+    assert child.steered == ["look at disk too"]
+
+
+def test_steer_active_refuses_closed_unknown_and_empty(child):
+    assert SubagentLifecycleService.steer_active("sa-active-1", "   ") is False
+    assert SubagentLifecycleService.steer_active("sa-missing", "hi") is False
+    assert SubagentLifecycleService.steer_active("", "hi") is False
+
+    _close_subagent_steering("sa-active-1", child)
+
+    assert _listed("sa-active-1").steerable is False
+    assert SubagentLifecycleService.steer_active("sa-active-1", "hi") is False
+    assert child.steered == []
+
