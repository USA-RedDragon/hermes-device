diff --git a/agent/turn_lifecycle_events.py b/agent/turn_lifecycle_events.py
new file mode 100644
index 0000000000..3521a846db
--- /dev/null
+++ b/agent/turn_lifecycle_events.py
@@ -0,0 +1,44 @@
+"""``agent_turn_start`` / ``agent_turn_end``: plugin observers that bracket every admitted turn of
+``AIAgent.run_conversation``, including early returns and exceptions that never reach
+``finalize_turn`` (so ``post_llm_call`` and ``on_session_end`` do not fire for them)."""
+
+from __future__ import annotations
+
+import logging
+from typing import Any, Optional
+
+logger = logging.getLogger(__name__)
+
+TURN_START_HOOK = "agent_turn_start"
+TURN_END_HOOK = "agent_turn_end"
+
+
+def _invoke(name: str, payload: dict[str, Any]) -> None:
+    try:
+        from hermes_cli.lifecycle import invoke_hook
+        invoke_hook(name, **payload)
+    except Exception:
+        logger.warning("%s hook failed", name, exc_info=True)
+
+
+def fire_turn_start(agent: Any, *, turn_id: str, task_id: str) -> Optional[dict[str, Any]]:
+    """Fire ``agent_turn_start`` and return the payload ``fire_turn_end`` repeats. Persistence-disabled
+    forks (background review) share their parent's session id and never publish turns: ``None``."""
+    if getattr(agent, "_persist_disabled", False):
+        return None
+    payload = {
+        "session_id": str(getattr(agent, "session_id", None) or ""),
+        "turn_id": turn_id,
+        "task_id": task_id,
+        "platform": str(getattr(agent, "platform", None) or ""),
+        "model": str(getattr(agent, "model", None) or ""),
+    }
+    _invoke(TURN_START_HOOK, payload)
+    return payload
+
+
+def fire_turn_end(started: Optional[dict[str, Any]], *, outcome: str) -> None:
+    """Fire ``agent_turn_end`` with the start payload (same ``session_id`` even if compaction rotated
+    it mid-turn) plus ``outcome``: ``success``, ``failed``, ``cancelled`` or ``timed_out``."""
+    if started is not None:
+        _invoke(TURN_END_HOOK, {**started, "outcome": outcome})
