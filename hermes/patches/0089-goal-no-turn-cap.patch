+def _turn_used_tools(session_id: str) -> Optional[bool]:
+    """Whether the newest turn of ``session_id`` called any tool (None when it cannot be told).
+    Every file change goes through a tool call, so a turn without one changed nothing."""
+    try:
+        db = _get_session_db()
+        if db is None:
+            return None
+        rows = db.get_messages(str(session_id), limit=400, latest=True)
+    except Exception:
+        return None
+    if not rows:
+        return None
+    for msg in reversed(rows):
+        if not isinstance(msg, dict):
+            continue
+        role = msg.get("role")
+        if role == "user":
+            return False
+        if role == "tool" or (role == "assistant" and msg.get("tool_calls")):
+            return True
+    return None
