+    mgr.set("ship it")
+    assert mgr.state.max_turns == 3
+    assert "0/3 turns" in mgr.status_line()
+    out = [_turn(mgr, f"step {i}", reason=_fresh(i)) for i in range(1, 4)]
+    assert out[0]["should_continue"] and out[1]["should_continue"]
+    assert out[2]["status"] == "paused" and not out[2]["should_continue"]
+    assert "3/3 turns used" in out[2]["message"]
+    assert "turn budget exhausted" in mgr.state.paused_reason
+
+
+def test_same_judge_reason_three_times_pauses_as_stuck(hermes_home):
+    mgr = goals.GoalManager(SID)
+    mgr.set("ship it")
+    assert _turn(mgr, "a", reason="The tests are still failing in test_x.")["should_continue"]
+    assert _turn(mgr, "b", reason="the tests are still failing in test_x")["should_continue"]
+    third = _turn(mgr, "c", reason="The tests are still failing in test_x!")
+    assert third["status"] == "paused" and not third["should_continue"]
+    assert "no progress" in third["message"] and "/goal resume" in third["message"]
+    assert mgr.state.status == "paused" and mgr.state.paused_reason.startswith("stuck")
+    assert mgr.state.turns_used == 3
+
+
+def test_changing_reason_resets_the_stuck_streak(hermes_home):
+    mgr = goals.GoalManager(SID)
+    mgr.set("ship it")
+    for reason in ["tests failing in module alpha", "tests failing in module alpha",
+                   "lint reports forty unused imports across the package", "tests failing in module alpha",
+                   "tests failing in module alpha"]:
+        assert _turn(mgr, reason, reason=reason)["should_continue"]
+    assert mgr.state.status == "active"
+
+
+def test_stuck_turns_is_configurable_and_zero_disables(hermes_home):
+    mgr = goals.GoalManager(SID, stuck_turns=2)
+    mgr.set("ship it")
+    assert _turn(mgr, "a")["should_continue"]
+    assert _turn(mgr, "b")["status"] == "paused"
+    mgr = goals.GoalManager("sid-never", stuck_turns=0)
+    mgr.set("ship it")
+    for _ in range(8):
+        assert _turn(mgr, "same", tools=False)["should_continue"]
+    assert goals.stuck_turns_from_config({"stuck_turns": 5}) == 5
+    assert goals.stuck_turns_from_config({}) == goals.DEFAULT_STUCK_TURNS
+
+
+def test_same_reply_without_tool_calls_pauses_as_stuck(hermes_home):
+    mgr = goals.GoalManager(SID)
+    mgr.set("ship it")
+    decisions = [_turn(mgr, "I am waiting for you.", tools=False, reason=_fresh(i))
+                 for i in range(3)]
+    assert decisions[1]["should_continue"]
+    assert decisions[2]["status"] == "paused" and "no tool calls" in decisions[2]["message"]
+
+
+def test_same_reply_with_tool_calls_is_not_stuck(hermes_home):
+    mgr = goals.GoalManager(SID)
+    mgr.set("ship it")
+    for i in range(6):
+        assert _turn(mgr, "Done with this batch.", tools=True, reason=_fresh(i))["should_continue"]
+
+
+def test_resume_clears_the_stuck_state(hermes_home):
+    mgr = goals.GoalManager(SID)
+    mgr.set("ship it")
+    for _ in range(3):
+        _turn(mgr)
+    assert mgr.state.status == "paused"
+    mgr.resume()
+    assert mgr.state.status == "active" and mgr.state.same_reason_streak == 0
+    assert _turn(mgr)["should_continue"]
+
+
+def test_judge_parse_failures_still_pause_unchanged(hermes_home):
+    mgr = goals.GoalManager(SID)
+    mgr.set("ship it")
+    last = None
+    for _ in range(goals.DEFAULT_MAX_CONSECUTIVE_PARSE_FAILURES):
+        with patch.object(goals, "judge_goal", return_value=("continue", "no json", True, None, False)):
+            last = mgr.evaluate_after_turn(f"reply {_}", user_initiated=True)
+    assert last["status"] == "paused"
+    assert "isn't returning the required JSON verdict" in last["message"]
+    assert mgr.state.paused_reason.startswith("judge model returned unparseable output")
+
+
+def test_set_confirmation_has_no_budget_unless_capped(hermes_home):
+    out = dispatch_goal_command(goals.GoalManager(SID), "ship it", authorize_gate=lambda: None)
+    assert "no turn limit" in out.output and "20" not in out.output and "budget" not in out.output
+    capped = dispatch_goal_command(goals.GoalManager("sid-capped", default_max_turns=5), "ship it",
+                                   authorize_gate=lambda: None)
+    assert "5-turn budget" in capped.output
+
+
+def test_config_default_is_uncapped_with_stuck_turns():
+    from hermes_cli.config_defaults import DEFAULT_CONFIG
+
+    assert DEFAULT_CONFIG["goals"]["max_turns"] == 0
+    assert DEFAULT_CONFIG["goals"]["stuck_turns"] == 3
+
+
+def test_goal_command_help_says_no_turn_limit():
+    from hermes_cli.commands import COMMAND_REGISTRY
+
+    goal = next(c for c in COMMAND_REGISTRY if c.name == "goal")
+    assert "no turn limit" in goal.description and "stuck" in goal.description
+
+
+def test_old_state_without_stuck_fields_loads(hermes_home):
+    state = goals.GoalState.from_json('{"goal": "g", "status": "active", "turns_used": 4, "max_turns": 20}')
+    assert state.max_turns == 20 and state.same_reason_streak == 0 and state.last_reason_norm == ""
+    assert time.time() > 0
