+def max_turns_from_config(goals_cfg: Any) -> int:
+    """``goals.max_turns`` as a cap: a positive int caps, anything else (0, None, junk) is no cap."""
+    try:
+        value = int((goals_cfg or {}).get("max_turns") or 0)
+    except (TypeError, ValueError, AttributeError):
+        return NO_TURN_CAP
+    return value if value > 0 else NO_TURN_CAP
+
+
+def stuck_turns_from_config(goals_cfg: Any) -> int:
+    """``goals.stuck_turns``: consecutive same-reason turns before a stuck pause (0 = never)."""
+    try:
+        raw = (goals_cfg or {}).get("stuck_turns")
+        return max(0, int(DEFAULT_STUCK_TURNS if raw is None else raw))
+    except (TypeError, ValueError, AttributeError):
+        return DEFAULT_STUCK_TURNS
+
+
+def _normalize_text(text: str) -> str:
+    return " ".join(re.sub(r"[^0-9a-z]+", " ", (text or "").lower()).split())
+
+
+def _same_reason(a: str, b: str) -> bool:
+    """Whether two normalized judge reasons say the same thing. Case, punctuation and spacing are
+    already gone; a near-identical rewording still counts, a reason that names new work does not."""
+    if not a or not b:
+        return False
+    return a == b or difflib.SequenceMatcher(None, a, b).ratio() >= _STUCK_SIMILARITY
+
+
+def _reply_hash(text: str) -> str:
+    norm = _normalize_text(text)
+    return hashlib.sha256(norm.encode("utf-8")).hexdigest()[:16] if norm else ""
+
