+"""A /goal has no turn budget by default: it ends on done, the user, or when it is stuck."""
+
+from __future__ import annotations
+
+import time
+from unittest.mock import patch
+
+import pytest
+
+from hermes_cli import goals
+from hermes_cli.goal_command import dispatch_goal_command
+
+SID = "sid-uncapped"
+
+
+@pytest.fixture
+def hermes_home(tmp_path, monkeypatch):
+    from pathlib import Path
+
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    goals._DB_CACHE.clear()
+    yield home
+    goals._DB_CACHE.clear()
+
+
+_TOPICS = ["parser", "database schema", "login form", "cache layer", "CLI flags", "release notes", "docker image",
+           "retry logic", "metrics exporter", "config loader", "unit fixtures", "http client", "search index",
+           "log rotation", "auth tokens", "email templates", "job queue", "file watcher", "rate limiter",
+           "i18n catalog", "build script", "plugin loader", "audit trail", "webhook signer", "pager"]
+
+
+def _fresh(i):
+    """A judge reason that names different work each turn."""
+    return f"The {_TOPICS[i % len(_TOPICS)]} is fixed, now the {_TOPICS[(i * 7 + 3) % len(_TOPICS)]} still needs work"
+
+
+def _judge(reason):
+    """judge_goal reply: not done, usable output (verdict, reason, parse_failed, wait, transport)."""
+    return ("continue", reason() if callable(reason) else reason, False, None, False)
+
+
+def _turn(mgr, reply="working on it", *, tools=True, reason="tests still fail"):
+    with patch.object(goals, "judge_goal", return_value=_judge(reason)), \
+            patch.object(goals, "_turn_used_tools", return_value=tools):
+        return mgr.evaluate_after_turn(reply, user_initiated=True)
+
+
+def test_default_goal_is_uncapped(hermes_home):
+    mgr = goals.GoalManager(SID)
+    state = mgr.set("ship it")
+    assert state.max_turns == 0 and not state.capped
+    assert goals.load_goal(SID).max_turns == 0   # 0 survives a reload, it does not become 20
+    assert "turn 0" in mgr.status_line() and "/" not in mgr.status_line().split("turn 0")[0].split()[-1]
+    assert "20" not in mgr.status_line()
+
+
+def test_default_goal_continues_past_twenty_turns_with_progress(hermes_home):
+    mgr = goals.GoalManager(SID)
+    mgr.set("ship it")
+    for i in range(1, 46):
+        decision = _turn(mgr, f"step {i}", reason=_fresh(i))
+        assert decision["should_continue"] is True, (i, decision)
+        assert decision["status"] == "active"
+    assert mgr.state.turns_used == 45
+    assert "/" not in decision["message"].split("(")[1].split(")")[0]
+    assert mgr.state.status == "active"
+
+
+def test_zero_and_none_config_mean_no_cap():
+    assert goals.max_turns_from_config({"max_turns": 0}) == 0
+    assert goals.max_turns_from_config({"max_turns": None}) == 0
+    assert goals.max_turns_from_config({}) == 0
+    assert goals.max_turns_from_config(None) == 0
+    assert goals.max_turns_from_config({"max_turns": 7}) == 7
+    assert goals.GoalManager("x", default_max_turns=0).default_max_turns == 0
+    assert goals.GoalManager("x", default_max_turns=None).default_max_turns == 0
+    assert goals.GoalState.from_json(goals.GoalState(goal="g", max_turns=0).to_json()).max_turns == 0
+
+
+def test_explicit_cap_still_pauses_at_n(hermes_home):
