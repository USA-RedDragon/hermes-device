     assert "_goal_resume_watcher" in GatewayRunner._POST_RECONNECT_WATCHERS
+
+
+def test_uncapped_goal_past_twenty_turns_is_resumed(goal_env):
+    """A goal with no turn cap never counts as budget-spent, however many turns it used."""
+    runner, state = _runner(), _set_goal(max_turns=0, turns_used=57)
+    assert state.max_turns == 0
+    assert _fire(runner, state) is True
+    assert len(runner.adapter.fifo) == 1
