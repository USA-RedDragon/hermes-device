diff --git a/tests/agent/test_provider_user_message.py b/tests/agent/test_provider_user_message.py
new file mode 100644
index 0000000000..8b263216a7
--- /dev/null
+++ b/tests/agent/test_provider_user_message.py
@@ -0,0 +1,114 @@
+"""A provider error that carries its own line for the user (``hermes_user_message``) ends the turn at
+once with that line alone: no retries, no fallback, no raw upstream text or request id.
+
+The case behind it: an account pool with every Claude account at its weekly limit raised one plain
+line ("All Claude accounts are at their limit. The first frees up at 10:09 PM CST."), and the turn
+still retried three times and ended with "Rate limited after 3 retries ... Provider said: ..." around
+it, or around the raw upstream error with its request id.
+"""
+from __future__ import annotations
+
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from agent.provider_user_message import provider_resets_at, provider_user_message
+
+LINE = "All Claude accounts are at their limit. The first frees up at 10:09 PM CST."
+RAW = ("HTTP 429: Incomplete upstream response (first upstream attempt: status 429, capture incomplete): "
+       "You've hit your weekly limit \u00b7 resets Nov 16, 6am (UTC) (request_id=req_0123456789abcdef)")
+
+
+class PoolExhausted(RuntimeError):
+    status_code = 429
+
+    def __init__(self, raw, line=None, resets_at=None):
+        super().__init__(raw)
+        if line is not None:
+            self.hermes_user_message = line
+        if resets_at is not None:
+            self.hermes_resets_at = resets_at
+
+
+@pytest.fixture()
+def loop_agent():
+    from run_agent import AIAgent
+
+    with (
+        patch("model_tools.get_tool_definitions", return_value=[]),
+        patch("model_tools.check_toolset_requirements", return_value={}),
+        patch("agent.process_bootstrap.OpenAI"),
+    ):
+        agent = AIAgent(
+            api_key="test-key-1234567890",
+            base_url="https://openrouter.ai/api/v1",
+            quiet_mode=True,
+            skip_context_files=True,
+            skip_memory=True,
+        )
+        agent.client = MagicMock()
+        agent._cached_system_prompt = "You are helpful."
+        agent._use_prompt_caching = False
+        agent.tool_delay = 0
+        agent.compression_enabled = False
+        agent.save_trajectories = False
+        agent._fallback_chain = []
+        agent.statuses = []
+        agent._emit_diagnostic_status = lambda message, *a, **k: agent.statuses.append(str(message))
+        yield agent
+
+
+def _run(agent, error):
+    agent.client.chat.completions.create.side_effect = error
+    with patch("agent.turn_recovery.interruptible_backoff_sleep", return_value=False), \
+            patch("time.sleep", return_value=None):
+        return agent.run_conversation("hello")
+
+
+def test_the_user_line_ends_the_turn_at_once_with_only_that_line(loop_agent):
+    result = _run(loop_agent, PoolExhausted(RAW, LINE, resets_at=1763400000.0))
+    assert loop_agent.client.chat.completions.create.call_count == 1
+    assert result["failed"] is True and result["completed"] is False
+    assert result["final_response"] == LINE
+    assert result["error"] == LINE
+    assert result["failure_retryable"] is False
+    # The classifier's own reason for the error (a plan limit reads as rate_limit or billing).
+    assert result["failure_reason"] in ("rate_limit", "billing")
+    assert result["failure_resets_at"] == 1763400000.0
+    shown = "\n".join([result["final_response"], *loop_agent.statuses])
+    for raw in ("request_id", "Incomplete upstream", "HTTP 429", "Provider said", "retries", "hit your weekly"):
+        assert raw not in shown
+
+
+def test_without_the_line_the_error_keeps_the_normal_path(loop_agent):
+    """Control: the same 429 with no user line keeps today's copy, raw provider text included."""
+    result = _run(loop_agent, PoolExhausted(RAW))
+    assert result["failed"] is True
+    assert result["final_response"] != LINE
+    assert "hit your weekly limit" in "\n".join([result["final_response"], *loop_agent.statuses])
+
+
+def test_the_line_is_found_on_a_wrapped_cause():
+    inner = PoolExhausted(RAW, LINE)
+    try:
+        try:
+            raise inner
+        except PoolExhausted as exc:
+            raise RuntimeError("stream failed") from exc
+    except RuntimeError as outer:
+        assert provider_user_message(outer) == LINE
+        assert provider_resets_at(outer) is None
+
+
+@pytest.mark.parametrize("value", [None, "", "   ", 42, b"bytes"])
+def test_no_line_without_a_real_string(value):
+    error = RuntimeError("x")
+    error.hermes_user_message = value
+    assert provider_user_message(error) is None
+
+
+def test_the_line_is_one_short_line():
+    error = RuntimeError("x")
+    error.hermes_user_message = "All accounts\nare full.  " + "x" * 400
+    line = provider_user_message(error)
+    assert "\n" not in line and len(line) <= 300 and line.startswith("All accounts are full.")
