 create mode 100644 tests/agent/test_provider_user_message.py

diff --git a/agent/provider_user_message.py b/agent/provider_user_message.py
new file mode 100644
index 0000000000..60b031ccbd
--- /dev/null
+++ b/agent/provider_user_message.py
@@ -0,0 +1,81 @@
+"""A provider error that carries its own line for the user.
+
+A provider (or a provider plugin) that has already done every retry it can, such as an account pool
+whose accounts are all at their plan limit, sets ``hermes_user_message`` on the exception it raises:
+one plain sentence that says what happened and when it clears. The turn then ends at once with that
+line as its whole reply: no further retries or fallback, and no raw upstream text, status code or
+request id around it. ``hermes_resets_at`` (epoch seconds, optional) is when the provider expects to
+serve again, for clients that show a reset time.
+"""
+
+from __future__ import annotations
+
+import logging
+from typing import Any, Optional
+
+logger = logging.getLogger("agent.conversation_loop")
+
+USER_MESSAGE_ATTR = "hermes_user_message"
+RESETS_AT_ATTR = "hermes_resets_at"
+_MAX_CHARS = 300
+
+
+def _chain(error: Any):
+    """The error, then its causes and contexts, each once (bounded)."""
+    seen: set[int] = set()
+    current = error
+    while current is not None and id(current) not in seen and len(seen) < 8:
+        seen.add(id(current))
+        yield current
+        current = getattr(current, "__cause__", None) or getattr(current, "__context__", None)
+
+
+def _carrier(error: Any) -> Any:
+    for item in _chain(error):
+        value = getattr(item, USER_MESSAGE_ATTR, None)
+        if isinstance(value, str) and value.strip():
+            return item
+    return None
+
+
+def provider_user_message(error: Any) -> Optional[str]:
+    """The provider's own line for the user, or None when the error carries none."""
+    item = _carrier(error)
+    if item is None:
+        return None
+    line = " ".join(getattr(item, USER_MESSAGE_ATTR).split())
+    return line if len(line) <= _MAX_CHARS else line[: _MAX_CHARS - 1].rstrip() + "\u2026"
+
+
+def provider_resets_at(error: Any) -> Optional[float]:
+    item = _carrier(error)
+    value = getattr(item, RESETS_AT_ATTR, None) if item is not None else None
+    if isinstance(value, bool) or not isinstance(value, (int, float)) or value != value or value <= 0:
+        return None
+    return float(value)
+
+
+def plain_provider_failure_result(
+    agent: Any, api_error: Any, classified: Any, line: str, *, messages: Any, conversation_history: Any,
+    api_call_count: int,
+) -> dict[str, Any]:
+    """The failed-turn result for a provider's own user line: that line and nothing else."""
+    # The retry chatter buffered so far ("Rate limited, retrying...") would print ahead of the line.
+    clear = getattr(agent, "_clear_status_buffer", None)
+    if callable(clear):
+        clear()
+    logger.warning(
+        "%sProvider ended the turn: %s | provider=%s model=%s error=%s",
+        getattr(agent, "log_prefix", ""), line, getattr(agent, "provider", ""), getattr(agent, "model", ""),
+        type(api_error).__name__,
+    )
+    agent._persist_session(messages, conversation_history)
+    reason = getattr(getattr(classified, "reason", None), "value", None) or "rate_limit"
+    result: dict[str, Any] = {
+        "final_response": line, "messages": messages, "api_calls": api_call_count,
+        "completed": False, "failed": True, "error": line,
+        "failure_reason": reason, "failure_retryable": False,
+    }
+    if (resets_at := provider_resets_at(api_error)) is not None:
+        result["failure_resets_at"] = resets_at
+    return result
