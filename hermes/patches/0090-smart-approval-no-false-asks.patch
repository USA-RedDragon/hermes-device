+"""Smart approval (provenance) does not ask about read-only work or the operator's own clones.
+
+Invariants:
+  1. A process:// provider (claude-pool) is a hosted judge, not a self-hosted server.
+  2. A read-only command never gets the session-fetch hold, even inside a clone, with /dev/null redirects or
+     git -C; a command that writes still does.
+  3. approvals.trusted_sources: a clone from a listed URL prefix is trusted; any other clone, an option that
+     runs code, a look-alike URL, and an empty list are not. No default.
+  4. A stage-1 reply with no verdict is retried once with a stricter instruction, then stage 2 runs; a stage-2
+     reply with no verdict is retried once, then the user is asked. A stage-1 failure runs stage 2.
+  5. The review prompt itself is unchanged by any of it.
+"""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from tools import approval_automode as A
+
+REPO = "git@github.com:USA-RedDragon/talaria-claude-pool.git"
+CLONE = "git clone " + REPO + " ~/.cache/x/repo"
+
+
+@pytest.fixture()
+def stages():
+    calls = []
+    replies = {1: ["<block>no</block>"], 2: ["<block>no</block>"]}
+
+    def complete(stage, system, user, max_tokens):
+        calls.append({"stage": stage, "user": user, "system": system})
+        queue = replies[stage]
+        return queue.pop(0) if len(queue) > 1 else queue[0]
+
+    A.set_complete_override(complete)
+    yield replies, calls
+    A.set_complete_override(None)
+
+
+def _ran(*commands):
+    msgs = [{"role": "user", "content": "Look at my repo."}]
+    for i, command in enumerate(commands):
+        call = {"id": f"t{i}", "function": {"name": "terminal", "arguments": json.dumps({"command": command})}}
+        msgs.append({"role": "assistant", "content": "", "tool_calls": [call]})
+        msgs.append({"role": "tool", "tool_call_id": f"t{i}", "content": "ok"})
+    return msgs
+
+
+@pytest.fixture()
+def trusted(monkeypatch):
+    def set_(value):
+        monkeypatch.setattr(A, "_config", lambda: {"trusted_sources": value})
+    return set_
+
+
+def _input(command, *ran, cwd="/home/u"):
+    return A.build_input("terminal", {"command": command}, messages=_ran(*ran), cwd=cwd)
+
+
+# 1 ----------------------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("base_url,hosted", [("process://claude-pool", True), ("moa://x", True),
+                                             ("http://ollama:11434/v1", False)])
+def test_process_provider_is_hosted(monkeypatch, base_url, hosted):
+    from agent import auxiliary_client as aux
+    from agent import model_metadata as mm
+    monkeypatch.setattr(aux, "_resolve_task_provider_model",
+                        lambda *a, **k: ("custom", "claude-sonnet-5-5", base_url, "", None))
+    monkeypatch.setattr(mm, "get_model_context_length", lambda *a, **k: 65536)
+    monkeypatch.setattr(mm, "detect_local_server_type", lambda *a, **k: "ollama")
+    served = A._served_window({})
+    assert (served is None) == hosted
+
+
+# 2 ----------------------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("command", [
+    "cd ~/.cache/x/repo && ls -la && cat README.md",
+    "grep -rn foo ~/.cache/x/repo 2>/dev/null | head",
+    "git -C ~/.cache/x/repo log --oneline | head -5",
+    "git --no-pager -C ~/.cache/x/repo diff > /dev/null",
+    "cat ~/.cache/x/repo/README.md 2>&1",
+])
+def test_read_only_command_in_a_clone_has_no_hold(command):
+    data = _input(command, "git clone https://github.com/x/tool ~/.cache/x/repo")
+    assert A.is_read_only_command(command)
+    assert data.skip_stage1 == "" and data.session_fetch == ""
+
+
+@pytest.mark.parametrize("command", [
+    "cat ~/a > ~/.cache/x/repo/out", "git -C ~/r commit -m x", "git -C ~/r push", "ls > /dev/nullx",
+    "ls >/dev/null/../../etc/x", "git -C ~/r log --output=x", "find . -exec rm {} ;",
+    "cd ~/.cache/x/repo && python -m pytest",
