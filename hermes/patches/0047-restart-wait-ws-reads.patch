 gateway/config_loader.py                    |  1 +
 gateway/drain_control.py                    | 15 +++++-
 tests/gateway/test_restart_wait_ws_reads.py | 52 +++++++++++++++++++++
 4 files changed, 74 insertions(+), 2 deletions(-)
 create mode 100644 tests/gateway/test_restart_wait_ws_reads.py

