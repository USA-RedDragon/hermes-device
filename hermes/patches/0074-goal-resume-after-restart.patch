diff --git a/gateway/run_goals.py b/gateway/run_goals.py
index 42d38850..1f5f1f47 100644
--- a/gateway/run_goals.py
+++ b/gateway/run_goals.py
@@ -24,6 +24,10 @@ if TYPE_CHECKING:  # string annotations only; never imported at runtime (cycle)
 # Log-record parity with the origin module.
 logger = logging.getLogger("gateway.run")
 
+# An active goal whose session has been idle this long with no turn, queued input or admission lost its
+# continuation (the in-memory FIFO / the judge did not survive a restart): the resume watcher re-queues it.
+GOAL_RESUME_GRACE_S = 30.0
+
 
 class GatewayGoalsMixin:
     """Goal/heartbeat continuation, post-turn hooks and loop-wakeup watcher methods for GatewayRunner."""
@@ -337,23 +341,30 @@ class GatewayGoalsMixin:
         prompt = decision.get("continuation_prompt") or ""
         if not decision.get("should_continue") or not prompt or source is None:
             return
+        await self._enqueue_goal_continuation(source, prompt)
+
+    async def _enqueue_goal_continuation(self, source: Any, prompt: str) -> bool:
+        """Queue one goal continuation turn for *source*'s session; True when it was queued."""
         if getattr(source, "platform", None) == Platform.LOCAL:
             # A local session's adapter FIFO has no reader: its turns are authority admissions.
             # Commit the continuation there, as main's TUI chained it after the turn.
             from gateway.session_automation import admit_route_wake
             try:
-                await admit_route_wake(self, self._delivery_adapter_for(source), source, prompt, "goal-continuation")
+                return bool(await admit_route_wake(
+                    self, self._delivery_adapter_for(source), source, prompt, "goal-continuation"))
             except Exception:  # health: allow BLE001 -- best-effort like the FIFO enqueue below; traceback logged
                 logger.debug("goal continuation: local admission failed", exc_info=True)
-            return
+                return False
         # Enqueue via the adapter's FIFO so a user message already in flight preempts naturally.
         try:
             adapter = self._delivery_adapter_for(source)
             _quick_key = self._session_key_for_source(source)
             if adapter and _quick_key:
                 self._enqueue_fifo(_quick_key, self._synthetic_prompt_event(source, prompt), adapter)
+                return True
         except Exception as exc:
             logger.debug("goal continuation: enqueue failed: %s", exc)
+        return False
 
     async def _run_post_turn_hooks(
         self, *, agent_result: Any, source: Any, is_internal: bool, event: Any = None,
@@ -578,3 +589,90 @@ class GatewayGoalsMixin:
             except Exception as exc:
                 logger.debug("loop wakeup watcher error: %s", exc)
             await asyncio.sleep(interval)
+
+    async def _goal_resume_fire_one(self, sid: str, state: Any, now: float, tried: dict, profile: Optional[str] = None) -> bool:
+        """Queue the continuation an active /goal lost to a restart between its turn's end and the next
+        turn (the post-turn judge's FIFO entry is in memory only). Skips a goal that is not active, in
+        budget and idle past ``GOAL_RESUME_GRACE_S``, parked on a wait barrier, paused by ``hermes pause``,
+        or whose session runs, has queued input or holds a pending admission. Once per stalled state
+        (goal turn count and last turn time) per process; returns True when a turn was queued."""
+        from hermes_cli.goals import GoalManager
+
+        if state.status != "active" or state.turns_used >= state.max_turns:
+            return False
+        if now - max(state.last_turn_at or 0.0, state.created_at or 0.0) < GOAL_RESUME_GRACE_S:
+            return False
+        stalled = (state.turns_used, state.last_turn_at)
+        if tried.get(sid) == stalled:
+            return False
+        store = getattr(self, "session_store", None)
+        entry = store.lookup_by_session_id(sid) if store is not None else None
+        source, key = getattr(entry, "origin", None), getattr(entry, "session_key", None)
+        if source is None or not key:
+            return False
+        if profile and not getattr(source, "profile", None):
+            source.profile = profile
+        if self._is_session_running(key) or key in self._running_agents:
+            return False
+        adapter = self._delivery_adapter_for(source)
+        if adapter is None or self._queue_depth(key, adapter=adapter) > 0:
+            return False
+        from gateway.session_authorities import active_authority
+        authority = active_authority(self)
+        if authority is not None:
+            from hermes_state_runtime import list_session_admissions
+            pending = await asyncio.to_thread(list_session_admissions, authority.db, session_id=sid)
+            if pending:
+                return False
+        from agent.estop import check_paused
+
+        if check_paused("goal", logger):
+            return False
+
+        def _next_prompt():
+            mgr = GoalManager(session_id=sid, default_max_turns=self._goal_max_turns_from_config())
+            return None if not mgr.is_active() or mgr.is_waiting() else mgr.next_continuation_prompt()
+
+        prompt = await self._run_in_executor_with_context(_next_prompt)
+        if not prompt:
+            return False
+        tried[sid] = stalled
+        queued = await self._enqueue_goal_continuation(source, prompt)
+        logger.info("goal resume: %s continuation for session %s (turn %s)",
+                    "queued" if queued else "could not queue", sid, state.turns_used)
+        return queued
+
+    async def _goal_resume_watcher(self, interval: float = 15.0) -> None:
+        """Re-queue the continuation of every idle active /goal at startup and every ``interval``
+        seconds. Same multiplex shape as ``_loop_wakeup_watcher``: each served profile's store is read
+        under its own runtime scope."""
+        from gateway.run import _async_profile_runtime_scope, _resolve_handoff_watch_scopes
+        await asyncio.sleep(5)  # let platforms and the session authority finish starting
+        tried: dict = {}
+
+        def _scope(profile_home):
+            if profile_home is not None:
+                return _async_profile_runtime_scope(profile_home)
+            from tui_gateway.launch_profile_policy import async_launch_profile_scope_if_multiplexed
+            return async_launch_profile_scope_if_multiplexed()
+
+        async def _scan_one_store(profile_name: Optional[str]) -> None:
+            from hermes_cli.goals import list_active_goals
+
+            await self._warm_goals_session_db("goal resume")
+            active = await self._run_in_executor_with_context(list_active_goals)
+            now = time.time()
+            for sid, state in active:
+                try:
+                    await self._goal_resume_fire_one(sid, state, now, tried, profile_name)
+                except Exception as exc:
+                    logger.debug("goal resume for %s failed: %s", sid, exc)
+
+        while self._running:
+            try:
+                for profile_name, profile_home in await _resolve_handoff_watch_scopes(self):
+                    async with _scope(profile_home):
+                        await _scan_one_store(profile_name)
+            except Exception as exc:
+                logger.debug("goal resume watcher error: %s", exc)
+            await asyncio.sleep(interval)
