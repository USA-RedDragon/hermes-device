diff --git a/hermes_cli/goals.py b/hermes_cli/goals.py
index 96ee695e..188c55aa 100644
--- a/hermes_cli/goals.py
+++ b/hermes_cli/goals.py
@@ -677,6 +677,30 @@ def clear_goal(session_id: str) -> None:
     save_goal(session_id, state)
 
 
+def list_active_goals() -> list[tuple[str, GoalState]]:
+    """``[(session_id, GoalState), ...]`` for every ``active`` goal in the cached store; ``[]`` on any
+    DB error. The gateway's goal-resume watcher scans it, like ``loops.list_active_loops``."""
+    db = _get_session_db()
+    if db is None:
+        return []
+    prefix = _meta_key("")
+    try:
+        rows = db.list_meta_prefix(prefix)
+    except Exception as exc:
+        logger.debug("GoalManager: list_meta_prefix failed: %s", exc)
+        return []
+    out: list[tuple[str, GoalState]] = []
+    for key, raw in rows:
+        session_id = key[len(prefix):]
+        try:
+            state = GoalState.from_json(raw) if session_id and raw else None
+        except Exception:
+            state = None
+        if state is not None and state.status == "active":
+            out.append((session_id, state))
+    return out
+
+
 def migrate_goal_to_session(old_session_id: str, new_session_id: str, *, reason: str = "") -> bool:
     """Carry a persistent /goal from a parent session to its continuation. Best-effort, never raises
     (a failure here must not block compression). Returns True when a goal was migrated.
diff --git a/tests/gateway/test_goal_resume_after_restart.py b/tests/gateway/test_goal_resume_after_restart.py
new file mode 100644
index 00000000..67b0ce54
--- /dev/null
+++ b/tests/gateway/test_goal_resume_after_restart.py
@@ -0,0 +1,180 @@
+"""An active /goal whose continuation was lost to a gateway restart is re-queued.
+
+The post-turn judge queues the next goal turn in an in-memory FIFO. A restart between the turn's end
+and that turn dropped it, and nothing re-queued it until the user wrote again. The goal-resume watcher
+(like the /loop wakeup watcher) finds active goals that sit idle and queues one continuation each.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.config import GatewayConfig, Platform, PlatformConfig
+from gateway.run import GatewayRunner
+from gateway.session import SessionSource
+from hermes_cli import goals
+
+SID = "sid-goal-resume"
+KEY = "agent:main:discord:channel:chat-goal"
+
+
+@pytest.fixture
+def goal_env(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+
+    token = set_hermes_home_override(str(home))
+    goals._DB_CACHE.clear()
+    goals._get_session_db()
+    yield home
+    try:
+        reset_hermes_home_override(token)
+    except Exception:
+        pass
+    goals._DB_CACHE.clear()
+
+
+class _Store:
+    def __init__(self, entry):
+        self.entry = entry
+
+    def lookup_by_session_id(self, session_id):
+        return self.entry if self.entry is not None and session_id == SID else None
+
+
+class _Adapter:
+    def __init__(self):
+        self.fifo = []
+
+
+def _runner(*, running=False, queued=0, with_entry=True):
+    runner = object.__new__(GatewayRunner)
+    runner.config = GatewayConfig(platforms={Platform.DISCORD: PlatformConfig(enabled=True, token="t")})
+    source = SessionSource(platform=Platform.DISCORD, chat_id="chat-goal", chat_type="channel",
+                           user_id="u", thread_id=None)
+    runner.session_store = _Store(SimpleNamespace(origin=source, session_key=KEY) if with_entry else None)
+    runner._running = True
+    runner._running_agents = {KEY: object()} if running else {}
+    runner.adapter = _Adapter()
+    runner.adapters = {Platform.DISCORD: runner.adapter}
+    runner._delivery_adapter_for = lambda src: runner.adapter
+    runner._is_session_running = lambda key: running
+    runner._queue_depth = lambda key, adapter=None: queued
+    runner._session_key_for_source = lambda src: KEY
+    runner._enqueue_fifo = lambda key, event, adapter: adapter.fifo.append((key, event.text))
+
+    async def _offload(fn, *a, **k):
+        return fn(*a, **k)
+
+    runner._run_in_executor_with_context = _offload
+    runner.session_authority = None
+    return runner
+
+
+def _set_goal(*, age=120.0, turns_used=2, status="active", max_turns=20):
+    mgr = goals.GoalManager(SID)
+    mgr.set("count to five", max_turns=max_turns)
+    state = mgr.state
+    state.turns_used = turns_used
+    state.last_turn_at = time.time() - age
+    state.created_at = time.time() - age - 10
+    state.status = status
+    goals.save_goal(SID, state)
+    return goals.load_goal(SID)
+
+
+def _fire(runner, state, tried=None):
+    return asyncio.run(GatewayRunner._goal_resume_fire_one(
+        runner, SID, state, time.time(), {} if tried is None else tried))
+
+
+def test_idle_active_goal_gets_one_continuation(goal_env):
+    runner, state = _runner(), _set_goal()
+    tried = {}
+    assert _fire(runner, state, tried) is True
+    assert len(runner.adapter.fifo) == 1
+    key, text = runner.adapter.fifo[0]
+    assert key == KEY and "count to five" in text
+    # The same stalled state is never queued twice.
+    assert _fire(runner, state, tried) is False
+    assert len(runner.adapter.fifo) == 1
+
+
+def test_list_active_goals_returns_only_active(goal_env):
+    _set_goal()
+    assert [sid for sid, _ in goals.list_active_goals()] == [SID]
+    goals.GoalManager(SID).pause()
+    assert goals.list_active_goals() == []
+
+
+@pytest.mark.parametrize("kwargs", [
+    {"status": "paused"},
+    {"status": "done"},
+    {"age": 5.0},                      # a turn or its judge just ended
+    {"turns_used": 20},                # budget spent
+])
+def test_goal_that_needs_no_continuation_is_left_alone(goal_env, kwargs):
+    runner, state = _runner(), _set_goal(**kwargs)
+    assert _fire(runner, state) is False
+    assert runner.adapter.fifo == []
+
+
+@pytest.mark.parametrize("runner_kwargs", [{"running": True}, {"queued": 1}, {"with_entry": False}])
+def test_busy_or_unknown_session_is_left_alone(goal_env, runner_kwargs):
+    runner, state = _runner(**runner_kwargs), _set_goal()
+    assert _fire(runner, state) is False
+    assert runner.adapter.fifo == []
+
+
+def test_goal_parked_on_a_wait_barrier_is_left_alone(goal_env):
+    mgr = goals.GoalManager(SID)
+    mgr.set("count to five")
+    mgr.wait_for_seconds(600, "waiting for a build")
+    state = goals.load_goal(SID)
+    state.last_turn_at = time.time() - 120
+    goals.save_goal(SID, state)
+    runner = _runner()
+    assert _fire(runner, goals.load_goal(SID)) is False
+    assert runner.adapter.fifo == []
+
+
+def test_hermes_pause_leaves_the_goal_stalled(goal_env, monkeypatch):
+    monkeypatch.setattr("agent.estop.check_paused", lambda *a, **k: True)
+    runner, state = _runner(), _set_goal()
+    assert _fire(runner, state) is False
+    assert runner.adapter.fifo == []
+
+
+def test_watcher_scans_at_startup_and_queues_the_lost_continuation(goal_env, monkeypatch):
+    _set_goal()
+    runner = _runner()
+    orig_sleep = asyncio.sleep
+    calls = {"n": 0}
+
+    async def _sleep(delay):
+        calls["n"] += 1
+        if calls["n"] >= 2:  # the startup delay, then one interval
+            runner._running = False
+        await orig_sleep(0)
+
+    monkeypatch.setattr(asyncio, "sleep", _sleep)
+
+    async def _scopes(_runner):
+        return [(None, None)]
+
+    monkeypatch.setattr("gateway.run._resolve_handoff_watch_scopes", _scopes)
+    runner._warm_goals_session_db = lambda label: orig_sleep(0)
+    asyncio.run(GatewayRunner._goal_resume_watcher(runner, interval=0))
+    assert len(runner.adapter.fifo) == 1
+
+
+def test_watcher_is_registered_after_reconnect():
+    assert "_goal_resume_watcher" in GatewayRunner._POST_RECONNECT_WATCHERS
