diff --git a/tests/tui_gateway/test_requeued_prompt_starts_turn.py b/tests/tui_gateway/test_requeued_prompt_starts_turn.py
new file mode 100644
index 00000000..e17bb815
--- /dev/null
+++ b/tests/tui_gateway/test_requeued_prompt_starts_turn.py
@@ -0,0 +1,111 @@
+"""After a restart, a queued message the hub accepted is re-placed at the transcript end as an open user
+turn (#125577). Nothing started it: it waited for the next user message or auto-continue. The mount hook
+now starts that turn once, never reruns a message that already ran, and never starts one the user cancelled."""
+
+from hermes_state import SessionDB
+from tests.tui_gateway.test_queued_prompt_restart_retire import (
+    _accept_busy_prompt_a_concludes, _busy, _desktop_session)
+from tui_gateway import server
+
+_TEXT = "queued prompt B START-MARKER"
+
+
+def _stub_turn(monkeypatch):
+    runs = []
+    monkeypatch.setattr(server, "_start_agent_build", lambda sid, session: None)
+    monkeypatch.setattr(server, "_wait_agent", lambda session, rid, timeout=30.0: None)
+    monkeypatch.setattr(server, "_ensure_active_session_slot", lambda sid, session: None)
+    monkeypatch.setattr(server, "_emit", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_start_session_work", lambda target, **kw: (target(), True)[1])
+    monkeypatch.setattr(server, "_run_prompt_submit", lambda rid, sid, sess, text, **kw: runs.append(text))
+    return runs
+
+
+def _restart(tmp_path, key):
+    fresh = SessionDB(db_path=tmp_path / "state.db")
+    fresh.reopen_session(key)  # the cold mount's re-place
+    return fresh
+
+
+def _mount(sid, key):
+    session = server._sessions[sid]
+    session["queued_prompt"] = None  # the restart discarded the in-memory queue
+    session.pop("queued_prompts", None)
+    session["running"] = False
+    session.pop("_requeued_turn_scheduled", None)
+    return server._maybe_schedule_auto_continue(sid, session, key)
+
+
+def test_restart_with_a_queued_message_starts_exactly_one_turn(monkeypatch, tmp_path):
+    db = SessionDB(db_path=tmp_path / "state.db")
+    sid, key = _desktop_session(monkeypatch, db)
+    runs = _stub_turn(monkeypatch)
+    try:
+        _accept_busy_prompt_a_concludes(db, sid, key, _TEXT)
+        fresh = _restart(tmp_path, key)
+        fresh.close()
+        _mount(sid, key)
+        assert runs == [_TEXT]
+        # A second mount (reconnect, sibling backend, another restart) finds nothing to start.
+        _mount(sid, key)
+        server._sessions[sid]["_requeued_turn_scheduled"] = False
+        _mount(sid, key)
+        assert runs == [_TEXT]
+    finally:
+        server._sessions.pop(sid, None)
+        db.close()
+
+
+def test_a_message_that_already_ran_is_not_rerun(monkeypatch, tmp_path):
+    db = SessionDB(db_path=tmp_path / "state.db")
+    sid, key = _desktop_session(monkeypatch, db)
+    runs = _stub_turn(monkeypatch)
+    try:
+        _accept_busy_prompt_a_concludes(db, sid, key, _TEXT)
+        _restart(tmp_path, key).close()
+        db.append_message(key, "assistant", content="reply B")  # the re-placed message was read and answered
+        _mount(sid, key)
+        assert runs == []
+    finally:
+        server._sessions.pop(sid, None)
+        db.close()
+
+
+def test_a_message_the_user_cancelled_is_not_started(monkeypatch, tmp_path):
+    db = SessionDB(db_path=tmp_path / "state.db")
+    sid, key = _desktop_session(monkeypatch, db)
+    runs = _stub_turn(monkeypatch)
+    try:
+        server._ensure_session_db_row(server._sessions[sid])
+        db.append_message(key, "user", content="prompt A")
+        session = server._sessions[sid]
+        _busy(session)
+        assert server._handle_busy_submit("r1", sid, session, _TEXT, "ws-1", queued=True,
+                                          display_kind=None)["result"]["status"] == "queued"
+        db.append_message(key, "assistant", content="reply A")
+        server._interrupt_session_turn(sid, session)  # Stop clears the queue
+        _restart(tmp_path, key).close()
+        _mount(sid, key)
+        assert runs == []
+        assert _TEXT not in [r["content"] for r in db.get_messages(key) if r["active"]]
+    finally:
+        server._sessions.pop(sid, None)
+        db.close()
+
+
+def test_a_running_turn_is_left_alone(monkeypatch, tmp_path):
+    db = SessionDB(db_path=tmp_path / "state.db")
+    sid, key = _desktop_session(monkeypatch, db)
+    runs = _stub_turn(monkeypatch)
+    try:
+        _accept_busy_prompt_a_concludes(db, sid, key, _TEXT)
+        _restart(tmp_path, key).close()
+        session = server._sessions[sid]
+        session["queued_prompt"] = None
+        session["running"] = True
+        server._maybe_schedule_auto_continue(sid, session, key)
+        assert runs == []  # the live turn wins; the message stays the open tail it reads
+        assert db.has_requeued_prompt(key)
+    finally:
+        server._sessions.pop(sid, None)
+        db.close()
diff --git a/tui_gateway/session_auto_continue.py b/tui_gateway/session_auto_continue.py
index 3d9efffa..79517444 100644
--- a/tui_gateway/session_auto_continue.py
+++ b/tui_gateway/session_auto_continue.py
@@ -56,8 +56,97 @@ def _auto_continue_note(prompt: str) -> str:
             f"finish the task. The interrupted request was:]\n\n{prompt}")
 
 
+def _requeued_prompt_pending(session: dict, session_key: str) -> bool:
+    try:
+        with _session_db(session) as db:
+            check = getattr(db, "has_requeued_prompt", None)
+            return bool(callable(check) and check(session_key))
+    except Exception:
+        logger.debug("requeued-prompt probe failed for %s", session_key, exc_info=True)
+        return False
+
+
+def _maybe_start_requeued_turn(sid: str, session: dict, session_key: str) -> bool:
+    """A restart discards the busy-queue; the never-drained prompt is re-placed at the transcript end
+    (``retire_undrained_queue_rows``) as an open user turn. Left alone it waits for the user's next message,
+    though the user was told it would run. Start its turn once, when the chat is mounted idle.
+
+    Exactly once: the copy's marker is claimed in one DB transaction after the same admission checks the
+    auto-continue turn uses (no running turn, no Stop, the session lease), so a second mount, a sibling
+    backend or a later restart finds nothing to claim. A message that already ran has a reply after it and
+    never counts; a message the user cancelled (Stop) was dropped from the queue rows, so it is never
+    re-placed. Returns whether a turn was scheduled."""
+    if session.get("source") == "bot_room" or session.get("_requeued_turn_scheduled"):
+        return False
+    if not _requeued_prompt_pending(session, session_key):
+        return False
+    session["_requeued_turn_scheduled"] = True
+
+    def kickoff() -> None:
+        rid = f"__requeued_prompt__{int(time.time() * 1000)}"
+        try:
+            _start_agent_build(sid, session)
+            err = _wait_agent(session, rid, timeout=120.0)
+        except Exception:
+            logger.warning("requeued-prompt agent build failed for %s", sid, exc_info=True)
+            err = {"error": {"message": "agent build failed"}}
+        if err:  # nothing claimed: the next mount retries
+            session["_requeued_turn_scheduled"] = False
+            return
+        with session["history_lock"]:
+            if session.get("running") or session.get("_turn_cancel_requested") or session.get("_finalized"):
+                session["_requeued_turn_scheduled"] = False  # the user's own turn wins; it reads the message
+                return
+            session["running"] = True
+            session["last_active"] = time.time()
+        if _ensure_active_session_slot(sid, session) is not None:
+            logger.info("requeued prompt for %s not started: session has another live owner", session_key)
+            with session["history_lock"]:
+                session["running"] = False
+                session["_requeued_turn_scheduled"] = False
+            return
+        claimed: list = []
+        try:
+            with _session_db(session) as db:
+                claim = getattr(db, "claim_requeued_prompts", None)
+                claimed = claim(session_key) if callable(claim) else []
+            texts = [str(c["content"]) for c in claimed if isinstance(c.get("content"), str) and c["content"].strip()]
+            if not texts:
+                with session["history_lock"]:
+                    session["running"] = False
+                return
+            text = "\n\n".join(texts)
+            # The turn writes its own row at the end (staged, adopted by the turn); the claimed copies are kept
+            # as history, so the transcript holds the message once as an active row.
+            staged = _write_submit_user_row(session, text, None)
+            with _session_db(session) as db:
+                for c in claimed:
+                    db.deactivate_message(_submit_row_target_key(session), c["id"])
+            with session["history_lock"]:
+                # The hydrated history already ends in the re-placed copy; the turn appends the message itself.
+                hist = session.get("history")
+                while isinstance(hist, list) and hist and isinstance(hist[-1], dict) and hist[-1].get("role") == "user" \
+                        and str(hist[-1].get("content") or "") in texts:
+                    hist.pop()
+                session["_submit_user_row"] = staged
+                if staged is None:
+                    session.pop("_submit_user_row", None)
+            with _session_profile_runtime_scope(session):
+                _emit("message.start", sid)
+                _run_prompt_submit(rid, sid, session, text)
+        except Exception as exc:
+            _notif_log_failure("requeued prompt dispatch failed", exc)
+            _notif_release_turn(session)
+    if _start_session_work(kickoff, name=f"requeued-prompt-{sid}") is None:
+        session["_requeued_turn_scheduled"] = False
+        return False
+    logger.info("requeued prompt turn scheduled for session %s", session_key)
+    return True
+
+
 def _maybe_schedule_auto_continue(sid: str, session: dict, session_key: str) -> dict | None:
-    """Kick off a continuation turn for a crash-interrupted session (session.resume cold paths). Returns a descriptor
+    """Kick off a continuation turn for a crash-interrupted session (session.resume cold paths); with no crash
+    marker, start the turn of a queued message a restart re-placed (_maybe_start_requeued_turn). Returns a descriptor
     for the resume payload when scheduled, else None. The turn runs on a background thread after the deferred agent
     build via _run_prompt_submit, so the client that just resumed streams it."""
     # Hosted room turns are recovered by their durable task/lease state machine; generic auto-continue would bypass
@@ -66,6 +155,7 @@ def _maybe_schedule_auto_continue(sid: str, session: dict, session_key: str) ->
         return None
     home = _session_home(session)
     if (marker := read_turn_marker(home, session_key)) is None:
+        _maybe_start_requeued_turn(sid, session, session_key)
         return None
     if not marker.get("auto_continue", True):
         return None  # The mailbox owns recovery and receipt identity for imported turns.
