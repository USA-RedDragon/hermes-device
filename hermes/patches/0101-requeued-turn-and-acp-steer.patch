+    def _requeued_tail_rows(self, conn, session_id: str) -> list:
+        """The trailing run of active user rows that still carry the re-placed marker (oldest first).
+        Only the transcript tail counts: once any row follows (the turn's reply, a failed-turn
+        boundary, a later message) the message has been read and must never start a turn again."""
+        tail = conn.execute(
+            "SELECT id, role, content, display_metadata FROM messages "
+            "WHERE session_id = ? AND active = 1 ORDER BY id DESC LIMIT 50", (session_id,)).fetchall()
+        rows = []
+        for row in tail:
+            meta = self._decode_display_metadata(row[3]) or {}
+            if row[1] != "user" or not meta.get(REQUEUED_PROMPT_METADATA_KEY):
+                break
+            rows.append(row)
+        return list(reversed(rows))
+
+    def has_requeued_prompt(self, session_id: str) -> bool:
+        """Cheap read: does the transcript end in a re-placed queued prompt nobody has started yet?"""
+        def _read(conn):
+            return bool(self._requeued_tail_rows(conn, session_id))
+        return bool(self._execute_write(_read))
+
+    def claim_requeued_prompts(self, session_id: str) -> list[dict]:
+        """Claim, exactly once, the re-placed queued prompts at the transcript tail: clears the marker
+        in one transaction (a second caller, or a later restart, finds nothing) and returns
+        ``[{"id", "content"}]`` oldest first. The rows stay active: if the process dies before the
+        started turn writes its own row, the message is still the open tail the next message reads."""
+        def _claim(conn):
+            rows = self._requeued_tail_rows(conn, session_id)
+            claimed = []
+            for row_id, _role, content, raw_meta in rows:
+                meta = dict(self._decode_display_metadata(raw_meta) or {})
+                meta.pop(REQUEUED_PROMPT_METADATA_KEY, None)
+                conn.execute("UPDATE messages SET display_metadata = ? WHERE id = ?",
+                             (self._encode_display_metadata(meta) if meta else None, row_id))
+                claimed.append({"id": row_id, "content": self._decode_content(content)})
+            return claimed
+        return self._execute_write(_claim)
+
+    def drop_cancelled_queue_rows(self, session_id: str) -> int:
+        """The user pressed Stop: the in-memory queue is gone, so the accept rows of the prompts it held
+        (still marked as queued) must not be re-placed and run after a restart. Deactivated (kept as
+        history, never deleted), like the drain's early row. Returns how many were dropped."""
+        def _drop(conn):
+            rows = conn.execute(
+                "SELECT id FROM messages WHERE session_id = ? AND role = 'user' AND active = 1 "
+                f"AND COALESCE({_sql_json_extract('display_metadata', '$.' + QUEUED_PROMPT_METADATA_KEY)}, 0) = 1",
+                (session_id,)).fetchall()
+            conn.executemany("UPDATE messages SET active = 0 WHERE id = ?", [(r[0],) for r in rows])
+            return len(rows)
+        return self._execute_write(_drop)
