+"""gateway.restart_listener_hold_seconds: a restart stop holds what it would refuse and forwards it
+to the gateway that takes over, instead of 503 / close 1013."""
+import asyncio
+import json
+import socket
+from types import SimpleNamespace
+
+import pytest
+from aiohttp import WSMsgType, web
+
+from gateway.config import GatewayConfig, load_gateway_config
+from gateway.drain_control import (
+    HANDOVER_HEALTH, HANDOVER_READS, RESTART_WAIT_REASON, handover_read, restart_hold_configured, restart_wait_read,
+)
+from gateway.run_api import HELD_SCOPE_KEY, GatewayRuntimeAPI, end_gateway_api_reads, relay_gateway_api, seal_gateway_api
+
+
+def test_off_by_default():
+    assert GatewayConfig().restart_listener_hold_seconds == 0.0
+    assert GatewayConfig.from_dict({}).restart_listener_hold_seconds == 0.0
+    assert GatewayConfig.from_dict({"gateway": {"restart_listener_hold_seconds": 60}}).restart_listener_hold_seconds == 60.0
+    assert GatewayConfig.from_dict({"gateway": {"restart_listener_hold_seconds": 9999}}).restart_listener_hold_seconds == 0.0
+
+
+def test_config_yaml_key_reaches_the_runner_config(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    (tmp_path / "config.yaml").write_text("gateway:\n  restart_listener_hold_seconds: 60\n", encoding="utf-8")
+    assert load_gateway_config().restart_listener_hold_seconds == 60.0
+
+
+def _config(hold=60, relay=30, handover=True):
+    return GatewayConfig(restart_listener_handover=handover, restart_listener_relay_seconds=relay,
+                         restart_listener_hold_seconds=hold)
+
+
+@pytest.mark.parametrize("hold, relay, handover, expected", [
+    (60, 30, True, True), (0, 30, True, False), (60, 0, True, False), (60, 30, False, False)])
+def test_the_hold_needs_the_handover_and_the_relay(hold, relay, handover, expected):
+    assert restart_hold_configured(SimpleNamespace(config=_config(hold, relay, handover))) is expected
+
+
+def _waiting_runner(config):
+    return SimpleNamespace(config=config, _draining=True, _running=True, _listener_handover=None,
+                           _restart_requested=True,
+                           session_runtime_descriptor={"state": "ready", "drain_reason": RESTART_WAIT_REASON})
+
+
+@pytest.mark.parametrize("hold, expected", [(60, True), (0, False)])
+def test_with_the_hold_every_get_is_a_read_while_the_stores_are_open(hold, expected):
+    runner = _waiting_runner(_config(hold))
+    assert restart_wait_read(runner, "GET", "/api/cron/jobs") is expected
+    assert restart_wait_read(runner, "GET", "/api/sessions/s1/messages")
+    assert not restart_wait_read(runner, "PUT", "/api/config")
+    runner._running, runner._listener_handover = False, HANDOVER_READS
+    assert handover_read(runner, "GET", "/api/cron/jobs") is expected
+    assert not handover_read(runner, "POST", "/api/cron/jobs")
+    runner._listener_handover = HANDOVER_HEALTH
+    assert not handover_read(runner, "GET", "/api/cron/jobs")
+    assert handover_read(runner, "GET", "/api/health")
+
+
+def _stopping_runner(config, stage=HANDOVER_HEALTH):
+    return SimpleNamespace(config=config, _draining=True, _running=False, _listener_handover=stage,
+                           _restart_requested=True, session_runtime_descriptor={"state": "draining"})
+
+
+def _api(runner):
+    reached = []
+
+    async def dashboard(scope, receive, send):
+        reached.append(scope["path"])
+        await send({"type": "http.response.start", "status": 200, "headers": []})
+        await send({"type": "http.response.body", "body": b"old"})
+
+    api = GatewayRuntimeAPI(dashboard, runner, SimpleNamespace(state=SimpleNamespace(auth_required=True)))
+    seal_gateway_api(SimpleNamespace(api=api, server=SimpleNamespace(server_state=SimpleNamespace(connections=set()))))
+    return api, reached
+
+
+def _http_scope(path, method="GET", query=b"", headers=()):
+    return {"type": "http", "method": method, "path": path, "raw_path": path.encode(), "query_string": query,
+            "headers": [(b"host", b"hermes:9120"), *headers], "client": ("10.0.0.9", 1),
+            "server": ("10.0.0.1", 9120), "scheme": "http", "http_version": "1.1", "root_path": ""}
+
+
+async def _call(api, scope, body=b""):
+    sent = []
+
+    async def receive():
+        return {"type": "http.request", "body": body, "more_body": False}
+
+    async def send(message):
+        sent.append(message)
+
+    await api(scope, receive, send)
+    start = next(m for m in sent if m["type"] == "http.response.start")
+    return start["status"], dict(start["headers"]), b"".join(m.get("body", b"") for m in sent
+                                                             if m["type"] == "http.response.body")
+
+
+async def _successor():
+    """The gateway that takes over: echoes what it got, and a WebSocket that echoes frames."""
+    seen = []
+
+    async def echo(request):
+        seen.append((request.method, request.path_qs, request.headers.get("Host"), request.headers.get("Cookie"),
+                     await request.read()))
+        response = web.Response(status=201, body=b"new:" + (await request.read()))
+        response.headers.add("Set-Cookie", "a=1")
+        response.headers.add("Set-Cookie", "b=2")
+        return response
+
+    async def ws(request):
+        socket_ = web.WebSocketResponse(protocols=("hermes.v1",))
+        await socket_.prepare(request)
+        seen.append(("ws", request.headers.get("Origin"), socket_.ws_protocol))
+        async for frame in socket_:
+            if frame.type == WSMsgType.TEXT:
+                if frame.data == "bye":
+                    await socket_.close(code=4001)
+                    break
+                await socket_.send_str("new:" + frame.data)
+        return socket_
+
+    app = web.Application()
+    app.router.add_route("GET", "/api/ws", ws)
+    app.router.add_route("*", "/{tail:.*}", echo)
+    runner = web.AppRunner(app)
+    await runner.setup()
+    sock = socket.socket()
+    sock.bind(("127.0.0.1", 0))
+    site = web.SockSite(runner, sock)
+    await site.start()
+    return runner, ("127.0.0.1", sock.getsockname()[1]), seen
+
+
+@pytest.mark.asyncio
+async def test_without_the_hold_a_stopping_listener_refuses_at_once():
+    api, _ = _api(_stopping_runner(_config(hold=0)))
+    status, _, body = await asyncio.wait_for(_call(api, _http_scope("/api/config", "PUT")), 2)
+    assert status == 503 and json.loads(body)["error"] == "gateway_not_ready"
+
+
+@pytest.mark.asyncio
+async def test_a_held_request_is_forwarded_to_the_successor_once_released():
+    successor, target, seen = await _successor()
+    try:
+        api, reached = _api(_stopping_runner(_config()))
+        call = asyncio.ensure_future(_call(api, _http_scope(
+            "/api/config", "PUT", b"x=1", headers=[(b"cookie", b"s=abc"), (b"content-length", b"5")]), b"hello"))
+        await asyncio.sleep(0.2)
+        assert not call.done()  # held, not refused
+        assert len(api.held) == 1
+        api.forward_to(target, 5)
+        status, headers, body = await asyncio.wait_for(call, 5)
+        assert (status, body) == (201, b"new:hello")
+        assert seen == [("PUT", "/api/config?x=1", "hermes:9120", "s=abc", b"hello")]
+        assert reached == []
+    finally:
+        await successor.cleanup()
+
+
+@pytest.mark.asyncio
+async def test_every_set_cookie_comes_back():
+    successor, target, _seen = await _successor()
+    try:
+        api, _ = _api(_stopping_runner(_config()))
+        api.forward_to(target, 5)
+        sent = []
+
+        async def receive():
+            return {"type": "http.request", "body": b"", "more_body": False}
+
+        async def send(message):
+            sent.append(message)
+
+        await api(_http_scope("/auth/password-login", "POST"), receive, send)
+        start = next(m for m in sent if m["type"] == "http.response.start")
+        assert [v for k, v in start["headers"] if k == b"set-cookie"] == [b"a=1", b"b=2"]
+    finally:
+        await successor.cleanup()
+
+
+@pytest.mark.asyncio
+async def test_a_held_request_waits_for_a_successor_that_is_not_listening_yet():
+    with socket.socket() as probe:
+        probe.bind(("127.0.0.1", 0))
+        port = probe.getsockname()[1]
+    api, _ = _api(_stopping_runner(_config()))
+    call = asyncio.ensure_future(_call(api, _http_scope("/api/x", "POST")))
+    await asyncio.sleep(0.05)
+    api.forward_to(("127.0.0.1", port), 5)
+    await asyncio.sleep(0.3)  # refused by the successor's port all this time
+    assert not call.done()
+    async def late(request):
+        return web.Response(status=200, body=b"late")
+
+    app = web.Application()
+    app.router.add_route("*", "/{tail:.*}", late)
+    runner = web.AppRunner(app)
+    await runner.setup()
+    await web.TCPSite(runner, "127.0.0.1", port).start()
+    try:
+        assert (await asyncio.wait_for(call, 5))[2] == b"late"
+    finally:
+        await runner.cleanup()
+
+
+@pytest.mark.asyncio
+async def test_without_a_successor_the_held_request_gets_the_refusal():
+    api, _ = _api(_stopping_runner(_config()))
+    call = asyncio.ensure_future(_call(api, _http_scope("/api/config", "PUT")))
+    await asyncio.sleep(0.05)
+    api.forward_to(None)
+    status, _, _ = await asyncio.wait_for(call, 2)
+    assert status == 503
+
+
+@pytest.mark.asyncio
+async def test_the_hold_ends_with_the_refusal_after_its_bound():
+    api, _ = _api(_stopping_runner(_config(hold=0.2)))
+    status, _, _ = await asyncio.wait_for(_call(api, _http_scope("/api/config", "PUT")), 3)
+    assert status == 503
+    assert api.held == set()
+
+
+@pytest.mark.asyncio
+async def test_a_plain_stop_never_holds():
+    runner = _stopping_runner(_config())
+    runner._restart_requested = False
+    api, _ = _api(runner)
+    assert (await asyncio.wait_for(_call(api, _http_scope("/api/config", "PUT")), 2))[0] == 503
+
+
+@pytest.mark.asyncio
+async def test_health_is_still_answered_by_the_stopping_gateway():
+    api, _ = _api(_stopping_runner(_config()))
+    status, _, body = await asyncio.wait_for(_call(api, _http_scope("/api/health")), 2)
+    assert status == 200 and json.loads(body)["ok"] is True
+
+
+async def _websocket(api, scope_extra=None):
+    to_app: asyncio.Queue = asyncio.Queue()
+    from_app: asyncio.Queue = asyncio.Queue()
+    scope = {"type": "websocket", "path": "/api/ws", "raw_path": b"/api/ws", "query_string": b"native_dial=browser",
+             "headers": [(b"host", b"hermes:9120"), (b"origin", b"http://hermes:9120"),
+                         (b"sec-websocket-protocol", b"hermes.v1, ticket.abc"), (b"sec-websocket-key", b"x")],
+             "subprotocols": ["hermes.v1", "ticket.abc"], "client": ("10.0.0.9", 1),
+             "server": ("10.0.0.1", 9120), "scheme": "ws", **(scope_extra or {})}
+    await to_app.put({"type": "websocket.connect"})
+    task = asyncio.ensure_future(api(scope, to_app.get, from_app.put))
+    return task, to_app, from_app
+
+
+@pytest.mark.asyncio
+async def test_a_held_websocket_is_opened_on_the_successor_and_relayed():
+    successor, target, seen = await _successor()
+    try:
+        api, _ = _api(_stopping_runner(_config()))
+        task, to_app, from_app = await _websocket(api)
+        await asyncio.sleep(0.2)
+        assert from_app.empty()  # held: no close 1013
+        api.forward_to(target, 5)
+        assert await asyncio.wait_for(from_app.get(), 5) == {"type": "websocket.accept", "subprotocol": "hermes.v1"}
+        await to_app.put({"type": "websocket.receive", "text": "ping"})
+        assert await asyncio.wait_for(from_app.get(), 5) == {"type": "websocket.send", "text": "new:ping"}
+        await to_app.put({"type": "websocket.receive", "text": "bye"})
+        assert await asyncio.wait_for(from_app.get(), 5) == {"type": "websocket.close", "code": 4001}
+        await asyncio.wait_for(task, 5)
+        assert seen == [("ws", "http://hermes:9120", "hermes.v1")]
+    finally:
+        await successor.cleanup()
+
+
+@pytest.mark.asyncio
+async def test_a_client_that_leaves_closes_the_forwarded_socket():
+    successor, target, _seen = await _successor()
+    try:
+        api, _ = _api(_stopping_runner(_config()))
