diff --git a/gateway/listener_forward.py b/gateway/listener_forward.py
new file mode 100644
index 0000000000..a734a1ffa4
--- /dev/null
+++ b/gateway/listener_forward.py
@@ -0,0 +1,167 @@
+"""``gateway.restart_listener_hold_seconds``: forward a held request to the gateway that took over.
+
+A restart stop with ``gateway.restart_listener_handover`` and ``restart_listener_relay_seconds``
+holds what it would refuse (a write, a sign-in after the restart wait, a WebSocket upgrade) until it
+released the profile. Then this forwards each one, as HTTP or as a WebSocket, to the address the
+standby published, retrying the connect until the successor listens. Requests that reach the old
+listener on a connection it already had are forwarded the same way until the relay window ends.
+"""
+from __future__ import annotations
+
+import asyncio
+import logging
+
+logger = logging.getLogger(__name__)
+
+CONNECT_RETRY_S = 0.05
+CONNECT_ATTEMPT_TIMEOUT_S = 1.0
+
+# Hop-by-hop headers, and the ones the client library sets for the new hop.
+_HOP = frozenset({
+    "connection", "keep-alive", "proxy-connection", "proxy-authenticate", "proxy-authorization", "te",
+    "trailer", "transfer-encoding", "upgrade", "content-length",
+})
+_WS_OWN = frozenset({"sec-websocket-key", "sec-websocket-version", "sec-websocket-extensions",
+                     "sec-websocket-protocol", "sec-websocket-accept"})
+_RESPONSE_DROP = frozenset({"connection", "keep-alive", "transfer-encoding", "proxy-connection"})
+
+
+def _headers(scope, drop) -> list[tuple[str, str]]:
+    return [(k.decode("latin-1"), v.decode("latin-1")) for k, v in scope.get("headers") or ()
+            if k.decode("latin-1").lower() not in drop]
+
+
+def _url(scope, target, scheme):
+    from yarl import URL
+    host, port = target
+    path = scope.get("raw_path") or scope.get("path", "/").encode("utf-8")
+    if isinstance(path, bytes):
+        path = path.decode("latin-1")
+    query = (scope.get("query_string") or b"").decode("latin-1")
+    netloc = f"[{host}]" if ":" in host else host
+    return URL(f"{scheme}://{netloc}:{port}{path}" + (f"?{query}" if query else ""), encoded=True)
+
+
+async def _with_retry(connect, deadline):
+    """Call *connect* until the successor accepts the connection or *deadline* passes."""
+    import aiohttp
+    loop = asyncio.get_running_loop()
+    while True:
+        try:
+            return await connect()
+        except (aiohttp.ClientConnectorError, aiohttp.ServerDisconnectedError, asyncio.TimeoutError):
+            if loop.time() + CONNECT_RETRY_S >= deadline:
+                raise
+            await asyncio.sleep(CONNECT_RETRY_S)
+
+
+def _session():
+    import aiohttp
+    return aiohttp.ClientSession(
+        timeout=aiohttp.ClientTimeout(total=None, sock_connect=CONNECT_ATTEMPT_TIMEOUT_S),
+        auto_decompress=False, cookie_jar=aiohttp.DummyCookieJar(),
+        skip_auto_headers=("User-Agent", "Accept", "Accept-Encoding", "Content-Type"))
+
+
+async def _not_ready(scope, receive, send) -> None:
+    if scope["type"] == "websocket":
+        await send({"type": "websocket.close", "code": 1013})
+        return
+    from starlette.responses import JSONResponse
+    await JSONResponse({"error": "gateway_not_ready", "state": "draining"}, status_code=503)(scope, receive, send)
+
+
+async def forward_http(scope, receive, send, target, deadline) -> None:
+    """Send the request to *target* and stream its answer back as it is."""
+    body = bytearray()
+    while True:
+        message = await receive()
+        if message["type"] == "http.disconnect":
+            return
+        body += message.get("body", b"")
+        if not message.get("more_body"):
+            break
+    async with _session() as session:
+        try:
+            response = await _with_retry(lambda: session.request(
+                scope["method"], _url(scope, target, "http"), data=bytes(body) if body else None,
+                headers=_headers(scope, _HOP), allow_redirects=False), deadline)
+        except Exception as exc:
+            logger.warning("Held request %s %s not forwarded to %s:%d: %s", scope.get("method"),
+                           scope.get("path"), target[0], target[1], exc)
+            return await _not_ready(scope, receive, send)
+        async with response:
+            await send({"type": "http.response.start", "status": response.status,
+                        "headers": [(k.lower(), v) for k, v in response.raw_headers
+                                    if k.decode("latin-1").lower() not in _RESPONSE_DROP]})
+            async for chunk in response.content.iter_any():
+                await send({"type": "http.response.body", "body": chunk, "more_body": True})
+            await send({"type": "http.response.body", "body": b"", "more_body": False})
+
+
+def _close_code(code) -> int:
+    """A close code a server may send: the successor's own, else 1012 (service restart)."""
+    return code if isinstance(code, int) and (1000 <= code <= 1003 or 1007 <= code <= 1014
+                                              or 3000 <= code <= 4999) else 1012
+
+
+async def forward_websocket(scope, receive, send, target, deadline) -> None:
+    """Open the same WebSocket on *target* (same subprotocols, cookies and Origin), accept the client
+    with the subprotocol the successor chose, and pass frames both ways until either side closes."""
+    import aiohttp
+    message = await receive()
+    if message["type"] != "websocket.connect":
+        return
+    async with _session() as session:
+        try:
+            upstream = await _with_retry(lambda: session.ws_connect(
+                _url(scope, target, "http"), protocols=tuple(scope.get("subprotocols") or ()),
+                headers=_headers(scope, _HOP | _WS_OWN), autoping=True, max_msg_size=0, compress=0), deadline)
+        except aiohttp.WSServerHandshakeError as exc:
+            # The successor's own refusal: a ticket it does not know (403) or not ready (503).
+            await send({"type": "websocket.close", "code": 1013 if exc.status == 503 else 1008})
+            return
+        except Exception as exc:
+            logger.warning("Held WebSocket %s not forwarded to %s:%d: %s", scope.get("path"), target[0],
+                           target[1], exc)
+            return await _not_ready(scope, receive, send)
+        async with upstream:
+            await send({"type": "websocket.accept", "subprotocol": upstream.protocol})
+
+            async def client_to_upstream():
+                while True:
+                    message = await receive()
+                    if message["type"] == "websocket.disconnect":
+                        await upstream.close(code=_close_code(message.get("code", 1000)))
+                        return
+                    if message.get("text") is not None:
+                        await upstream.send_str(message["text"])
+                    elif message.get("bytes") is not None:
+                        await upstream.send_bytes(message["bytes"])
+
+            async def upstream_to_client():
+                async for frame in upstream:
+                    if frame.type == aiohttp.WSMsgType.TEXT:
+                        await send({"type": "websocket.send", "text": frame.data})
+                    elif frame.type == aiohttp.WSMsgType.BINARY:
+                        await send({"type": "websocket.send", "bytes": frame.data})
+                    else:
+                        break
+                await send({"type": "websocket.close", "code": _close_code(upstream.close_code)})
+
+            tasks = {asyncio.ensure_future(client_to_upstream()), asyncio.ensure_future(upstream_to_client())}
+            try:
+                done, pending = await asyncio.wait(tasks, return_when=asyncio.FIRST_COMPLETED)
+            finally:
+                for task in tasks:
+                    task.cancel()
+                await asyncio.gather(*tasks, return_exceptions=True)
+            for task in done:
+                if not task.cancelled() and task.exception() is not None:
+                    logger.debug("Forwarded WebSocket ended", exc_info=task.exception())
+
+
+async def forward(scope, receive, send, target, deadline) -> None:
+    if scope["type"] == "websocket":
+        return await forward_websocket(scope, receive, send, target, deadline)
+    return await forward_http(scope, receive, send, target, deadline)
