+@pytest.mark.parametrize("hold, kept", [(60, True), (0, False)])
+async def test_a_webapp_socket_opened_before_the_restart_wait_stays_open_through_it(monkeypatch, hold, kept):
+    import gateway.run_api as run_api
+    monkeypatch.setattr("hermes_cli.web_server_boundary._gateway_ws_ticket_from_subprotocol",
+                        lambda ws: ("abc", "ok"))
+    monkeypatch.setattr("hermes_cli.web_server_surface.policy", lambda state: SimpleNamespace(gateway_ticket=True))
+    runner = _kept_runner(_config(hold=hold))
