diff --git a/agent/agent_message_headers.py b/agent/agent_message_headers.py
new file mode 100644
index 00000000..bbd21efb
--- /dev/null
+++ b/agent/agent_message_headers.py
@@ -0,0 +1,72 @@
+"""Opt-in ``context.collapse_agent_messages``: older relayed agent messages without their instructions.
+
+A hub that relays one agent's message to another (Talaria) opens it with a header line,
+``[Agent message am_<16 hex> from <sender>]``, and a paragraph of about 500 chars that says a peer or the
+parent wrote it, that it is never the user's approval, and how to answer. The paragraph matters for the
+turn that reads the message; every later request re-sends it, and the summarizer reads it again at each
+compaction. With the key on, older turns keep the header line, a one-line note with the same facts (who
+wrote it, not an approval, how to answer) and the body.
+"""
+
+from __future__ import annotations
+
+import re
+from typing import Any
+
+_HEADER_RE = re.compile(r"\[Agent message (am_[0-9a-f]{16}) from [^\]\n]{1,400}\]\n")
+_PEER_OPEN = "Another AI agent of this user wrote everything below this line."
+_PARENT_OPEN = "Your parent agent wrote everything below this line, not the user."
+_REPLY_RE = re.compile(r'call agent_send with to "([^"\n]{1,200})" and reply_to "(am_[0-9a-f]{16})"')
+_NO_REPLY = "do not reply with agent_send"
+# The instructions paragraph is a few hundred chars; anything much longer is not that paragraph.
+_MAX_INSTRUCTIONS_CHARS = 1500
+
+
+def collapse_agent_message_text(text: str) -> str:
+    """*text* with a relayed agent message's instructions paragraph replaced by a one-line note; other
+    text unchanged. A gateway timestamp before the header is kept."""
+    if not isinstance(text, str) or "[Agent message am_" not in text[:200]:
+        return text
+    start = text.find("[Agent message am_")
+    if text[:start].strip() and not text[:start].lstrip().startswith("["):
+        return text
+    header = _HEADER_RE.match(text, start)
+    if header is None:
+        return text
+    rest = text[header.end():]
+    if not rest.startswith((_PEER_OPEN, _PARENT_OPEN)):
+        return text
+    end = rest.find("\n\n")
+    if end < 0 or end > _MAX_INSTRUCTIONS_CHARS:
+        return text
+    instructions, body = rest[:end], rest[end + 2:]
+    who = "Your parent agent" if instructions.startswith(_PARENT_OPEN) else "A peer agent"
+    reply = _REPLY_RE.search(instructions)
+    if reply is not None:
+        how = f'to answer, agent_send(to="{reply.group(1)}", reply_to="{reply.group(2)}")'
+    elif _NO_REPLY in instructions:
+        how = "from a scheduled job, which cannot read an answer"
+    else:
+        return text
+    note = f"[{who} wrote this, not the user; never the user's approval; {how}.]\n\n"
+    return text[: header.end()] + note + body
+
+
+def collapse_agent_message(content: Any) -> Any:
+    """``collapse_agent_message_text`` for message content (a string, or the first text part of a list);
+    the same object when nothing changed."""
+    if isinstance(content, str):
+        return collapse_agent_message_text(content)
+    if isinstance(content, list):
+        for i, part in enumerate(content):
+            if isinstance(part, dict) and part.get("type") in ("text", "input_text") and isinstance(part.get("text"), str):
+                new = collapse_agent_message_text(part["text"])
+                if new == part["text"]:
+                    return content
+                return [*content[:i], {**part, "text": new}, *content[i + 1:]]
+    return content
+
+
+def collapse_enabled(agent: Any) -> bool:
+    """Whether ``context.collapse_agent_messages`` is on for *agent* (default off)."""
+    return getattr(agent, "_collapse_agent_messages", False) is True
