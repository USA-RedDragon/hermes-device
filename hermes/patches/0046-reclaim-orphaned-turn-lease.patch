--- /dev/null
+++ b/hermes_state_turn_holders.py
@@ -0,0 +1,43 @@
+"""Turn lease holders this process admitted and has not released (``sessions.reclaim_orphaned_turn_leases``).
+
+A turn releases its lease row in its own ``finally``. When that one write fails (the state.db write lock
+held past the write patience, a closed store), the row stays until its TTL runs out, 300 s after its
+last renewal, and every model pick, reset or compress on the visibly idle session is refused or
+deferred meanwhile. With the setting on, a lease row whose holder names this very process, but no turn
+of this process still holds, is stale like a dead process's row: acquisition and the mutation guards
+reclaim it at once. A holder is registered before its row is written and dropped once its turn tried
+the release, so a running turn's row is never taken.
+"""
+import os
+import threading
+
+from hermes_state_pidns import holder_namespace_token
+
+_lock = threading.Lock()
+_live: set = set()
+_enabled = False
+
+
+def set_enabled(value) -> None:
+    global _enabled
+    _enabled = value is True
+
+
+def admitted(holder: str) -> None:
+    with _lock:
+        _live.add(holder)
+
+
+def released(holder: str) -> None:
+    with _lock:
+        _live.discard(holder)
+
+
+def orphaned(holder) -> bool:
+    """True when the setting is on and *holder* is a turn holder of this process no live turn holds."""
+    if not _enabled or not isinstance(holder, str):
+        return False
+    if not holder.startswith(f"pid={os.getpid()}{holder_namespace_token()}:turn="):
+        return False
+    with _lock:
+        return holder not in _live
diff --git a/tests/hermes_state/test_orphaned_turn_lease.py b/tests/hermes_state/test_orphaned_turn_lease.py
new file mode 100644
index 0000000000..f63ccbbc66
--- /dev/null
+++ b/tests/hermes_state/test_orphaned_turn_lease.py
@@ -0,0 +1,153 @@
+"""sessions.reclaim_orphaned_turn_leases: a lease row this process wrote after its turn ended."""
+import os
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+import hermes_state_turn_holders as turn_holders
+from agent.turn_facade_lease import admit_durable_turn_lease
+from hermes_state import SessionDB
+from hermes_state_errors import SessionTurnLeaseLostError
+from hermes_state_pidns import holder_namespace_token
+
+
+@pytest.fixture()
+def db(tmp_path):
+    store = SessionDB(db_path=tmp_path / "state.db")
+    store.create_session(session_id="s1", source="cli")
+    yield store
+    store.close()
+
+
+@pytest.fixture(autouse=True)
+def _reset_holders():
+    yield
+    turn_holders.set_enabled(False)
+    turn_holders._live.clear()
+
+
+def _own(turn="s1:t:abcd"):
+    return f"pid={os.getpid()}{holder_namespace_token()}:turn={turn}:platform=cli"
+
+
+def _guard(db):
+    with db._lock:
+        conn = db._conn
+        conn.execute("BEGIN IMMEDIATE")
+        try:
+            db._check_transcript_write_guards(conn, "s1", None, reject_active_turn_lease=True)
+        except BaseException:
+            conn.execute("ROLLBACK")
+            raise
+        conn.execute("COMMIT")
+
+
+def _lease_holder(db):
+    with db._read_ctx() as conn:
+        row = conn.execute("SELECT holder FROM session_turn_leases WHERE conversation_id='s1'").fetchone()
+    return row[0] if row else None
+
+
+def _orphan(db, holder):
+    assert db.try_acquire_session_turn_lease("s1", holder)
+    assert _lease_holder(db) == holder
+
+
+def test_default_keeps_an_orphaned_row_until_expiry(db):
+    _orphan(db, _own())
+    with pytest.raises(SessionTurnLeaseLostError):
+        _guard(db)
+    assert not db.try_acquire_session_turn_lease("s1", _own("s1:t:next"))
+
+
+def test_enabled_guard_reclaims_this_process_orphan(db):
+    turn_holders.set_enabled(True)
+    _orphan(db, _own())
+    _guard(db)
+    assert _lease_holder(db) is None
+
+
+def test_enabled_acquire_reclaims_this_process_orphan(db):
+    turn_holders.set_enabled(True)
+    _orphan(db, _own())
+    assert db.try_acquire_session_turn_lease("s1", _own("s1:t:next"))
+    assert _lease_holder(db) == _own("s1:t:next")
+
+
+def test_enabled_keeps_a_live_turn_of_this_process(db):
+    turn_holders.set_enabled(True)
+    turn_holders.admitted(_own())
+    _orphan(db, _own())
+    with pytest.raises(SessionTurnLeaseLostError):
+        _guard(db)
+    assert not db.try_acquire_session_turn_lease("s1", _own("s1:t:next"))
+
+
+def test_enabled_keeps_another_process_row(db):
+    turn_holders.set_enabled(True)
+    other = f"pid=1{holder_namespace_token()}:turn=s1:t:abcd:platform=cli"
+    _orphan(db, other)
+    turn_holders._live.clear()
+    with pytest.raises(SessionTurnLeaseLostError):
+        _guard(db)
+
+
+class _FailingReleaseDB(SessionDB):
+    """The release write fails, as when state.db stays locked past the write patience."""
+
+    def release_session_turn_lease(self, session_id, holder):
+        import sqlite3
+        raise sqlite3.OperationalError("database is locked")
+
+
+def _agent(db):
+    agent = SimpleNamespace(
+        _session_db=db, session_id="s1", _persist_disabled=False, _interrupt_requested=False,
+        _interrupt_message=None, _execution_thread_id=None, _session_turn_lease_refresh_interval=60.0,
+    )
+    agent._emit_status = agent._emit_warning = lambda *a, **k: None
+    agent._touch_activity = lambda *a, **k: None
+    agent._liveness_activity_lock = lambda: threading.Lock()
+    return agent
+
+
+def _admit(agent):
+    return admit_durable_turn_lease(
+        agent, session_id="s1", relay_turn_id="s1:t:abcd",
+        task_context={"session_id": "s1", "task_id": "t", "platform": "cli"}, conversation_history=None)
+
+
+@pytest.mark.parametrize("enabled", [False, True])
+def test_failed_release_leaves_a_row_only_the_setting_reclaims(tmp_path, monkeypatch, enabled):
+    import agent.turn_facade_lease as facade
+    monkeypatch.setattr(facade, "_reclaim_orphaned_leases", lambda: enabled)
+    db = _FailingReleaseDB(db_path=tmp_path / "state.db")
+    db.create_session(session_id="s1", source="cli")
+    admission = _admit(_agent(db))
+    lease = admission.lease
+    assert lease is not None
+    assert lease.holder in turn_holders._live
+    with pytest.raises(SessionTurnLeaseLostError):
+        _guard(db)
+    lease.release()
+    assert lease.holder not in turn_holders._live
+    assert _lease_holder(db) == lease.holder
+    if enabled:
+        _guard(db)
+        assert _lease_holder(db) is None
+    else:
+        with pytest.raises(SessionTurnLeaseLostError):
+            _guard(db)
+    db.close()
+
+
+def test_refused_acquisition_unregisters(db, monkeypatch):
+    import agent.turn_facade_lease as facade
+    monkeypatch.setattr(facade, "_reclaim_orphaned_leases", lambda: True)
+    db.try_acquire_session_turn_lease("s1", f"pid=1{holder_namespace_token()}:turn=x:platform=cli")
+    agent = _agent(db)
+    agent._interrupt_requested = True
+    admission = _admit(agent)
+    assert admission.lease is None
+    assert not turn_holders._live
