diff --git a/gateway/session_pick_supersede.py b/gateway/session_pick_supersede.py
new file mode 100644
index 0000000000..ba7be84338
--- /dev/null
+++ b/gateway/session_pick_supersede.py
@@ -0,0 +1,109 @@
+"""A newer model pick supersedes the one still stored for the session (``sessions.newest_pick_supersedes``).
+
+A pick made while a turn runs is kept in ``state_meta`` until the turn boundary, where a guarded one
+is asked and stays stored with its confirm token. Without this, a later pick that is itself asked or
+refused leaves the stored one in place, so the next viewer to attach is asked about the older pick, and
+the older pick's token still commits it. With it, each newer pick settles the stored one: an asked pick
+replaces it (the attach re-ask then names the newest), a refused or reset pick clears it, a deferred or
+applied pick already replaced or cleared it. The token of a pick that was replaced or cleared is
+refused with ``pick_superseded``.
+"""
+import json
+from pathlib import Path
+
+from hermes_state_mutation_prepared import DEFERRED_PICK_PREFIX
+from hermes_state_runtime import RuntimeStoreError
+
+SUPERSEDED_PREFIX = 'gateway.superseded_pick.v1.'
+_KEPT_TOKENS = 8
+# Refusals that judge the picked target itself. Fences (revision, generation), authorization and
+# malformed requests say nothing about what the user now wants, so they leave the stored pick alone.
+_TARGET_REFUSALS = {'model_resolution_failed'}
+
+
+def supersede_enabled(authority):
+    """Blocking: ``sessions.newest_pick_supersedes`` of the profile that owns *authority*'s store."""
+    from hermes_cli.config_defaults import DEFAULT_CONFIG
+    from hermes_cli.config_effective import load_user_config_effective
+    from gateway.session_local import profile_env_scope
+    default = DEFAULT_CONFIG['sessions']['newest_pick_supersedes']
+    home = Path(authority.db.db_path).resolve().parent
+    with profile_env_scope(home):
+        sessions = load_user_config_effective(home / 'config.yaml').get('sessions')
+    raw = sessions.get('newest_pick_supersedes', default) if isinstance(sessions, dict) else default
+    return raw if isinstance(raw, bool) else default
+
+
+def _read(authority, key):
+    with authority.db._read_ctx() as conn:
+        row = conn.execute('SELECT value FROM state_meta WHERE key=?', (key,)).fetchone()
+    return row[0] if row else None
+
+
+def stored_pick(authority, session_id):
+    """The raw stored pick of *session_id*, or None."""
+    return _read(authority, DEFERRED_PICK_PREFIX + session_id)
+
+
+def refuse_superseded_confirm(authority, session_id, payload):
+    """Refuse a confirmed pick whose token belongs to a pick a newer one replaced."""
+    token = payload.get('confirm') if isinstance(payload, dict) else None
+    if not token:
+        return
+    raw = _read(authority, SUPERSEDED_PREFIX + session_id)
+    if raw is not None and token in json.loads(raw):
+        raise RuntimeStoreError('pick_superseded', field='confirm',
+                                detail='a newer model pick replaced the one this confirmation was for')
+
+
+def _token(raw):
+    return json.loads(raw).get('awaiting_confirm') if raw else None
+
+
+def settle_newer_pick(authority, actor, ref, params, before, outcome):
+    """Blocking, off the loop, under the session's mutation lock. *before* is the stored pick read
+    before the newer pick ran; *outcome* is its result dict, or the refusing ``RuntimeStoreError``.
+    Applied and deferred picks already cleared or replaced the stored one; this settles the rest and
+    records the token of the pick that is gone."""
+    from hermes_state_runtime import _epoch, _json
+    key = DEFERRED_PICK_PREFIX + ref.session_id
+    status = outcome.get('status') if isinstance(outcome, dict) else None
+    refused = isinstance(outcome, RuntimeStoreError)
+    asked = status == 'confirmation_required'
+
+    def write(conn):
+        _epoch(conn, authority.epoch)
+        row = conn.execute('SELECT value FROM state_meta WHERE key=?', (key,)).fetchone()
+        now = row[0] if row else None
+        payload = params['payload'] if isinstance(params.get('payload'), dict) else {}
+        if before is not None and now == before and (asked or status == 'noop'
+                                                     or (refused and outcome.reason in _TARGET_REFUSALS)):
+            old = json.loads(before)
+            level = old.get('reasoning') if 'reasoning' not in payload else None
+            if asked:
+                pick = {'principal_id': actor.subject, 'request_id': params['request_id'],
+                        'payload': {k: v for k, v in payload.items() if k != 'confirm'},
+                        'application_id': 'deferred-pick:' + params['request_id'],
+                        'awaiting_confirm': outcome['confirm'], **({'reasoning': level} if level else {})}
+                conn.execute('UPDATE state_meta SET value=? WHERE key=?', (_json(pick), key))
+            elif level:
+                conn.execute('UPDATE state_meta SET value=? WHERE key=?', (_json({'reasoning': level}), key))
+            else:
+                conn.execute('DELETE FROM state_meta WHERE key=?', (key,))
+            now = conn.execute('SELECT value FROM state_meta WHERE key=?', (key,)).fetchone()
+            now = now[0] if now else None
+        gone = _token(before)
+        tokens_key = SUPERSEDED_PREFIX + ref.session_id
+        row = conn.execute('SELECT value FROM state_meta WHERE key=?', (tokens_key,)).fetchone()
+        tokens = json.loads(row[0]) if row else []
+        if gone and gone != _token(now) and gone not in tokens:
+            tokens.append(gone)
+        if asked and outcome['confirm'] in tokens:
+            tokens.remove(outcome['confirm'])
+        tokens = tokens[-_KEPT_TOKENS:]
+        if tokens:
+            conn.execute('INSERT INTO state_meta(key,value) VALUES(?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value',
+                         (tokens_key, json.dumps(tokens)))
+        else:
+            conn.execute('DELETE FROM state_meta WHERE key=?', (tokens_key,))
+    authority.db._execute_write(write)
