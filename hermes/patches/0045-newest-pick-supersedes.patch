diff --git a/tests/gateway/test_session_pick_supersede.py b/tests/gateway/test_session_pick_supersede.py
new file mode 100644
index 0000000000..267e5cda73
--- /dev/null
+++ b/tests/gateway/test_session_pick_supersede.py
@@ -0,0 +1,182 @@
+"""A newer model pick supersedes the pick still stored for the session (``sessions.newest_pick_supersedes``)."""
+import asyncio
+import json
+from pathlib import Path
+import threading
+
+import pytest
+
+from tests.gateway.test_session_mutation_model_busy import _owner, _run_turn
+from tests.waiting import async_wait_until
+
+
+async def _guarded_setup(tmp_path, monkeypatch, enabled):
+    """A session whose context trips the large-context guard, with a guarded pick stored and asked."""
+    from agent.usage_anchor import USAGE_ANCHOR_MODEL_CONFIG_KEY, capture_usage_anchor
+    from gateway.session_contract import Submission
+    from hermes_cli import model_selection_guards, model_switch
+    monkeypatch.setattr(model_selection_guards, '_context_cache_threshold', lambda: 1000)
+    started, release = threading.Event(), asyncio.Event()
+    events = []
+
+    async def handle(event):
+        if event.text.startswith('RUNNING'):
+            started.set()
+            await release.wait()
+        return 'ok'
+    store, db, authority, owner, ref = _owner(tmp_path, monkeypatch, handle)
+    if enabled:
+        (Path(db.db_path).parent / 'config.yaml').write_text('sessions:\n  newest_pick_supersedes: true\n')
+    switch = model_switch.switch_model
+    monkeypatch.setattr(model_switch, 'switch_model', lambda **k: model_switch.ModelSwitchResult(
+        success=False, new_model='', target_provider='') if k['raw_input'] == 'gone' else switch(**k))
+    authority.runner._cached_agent_for = lambda route: None
+    stream = authority.sessions[ref.session_id].event_stream
+    publish = stream.publish
+    monkeypatch.setattr(stream, 'publish', lambda sid, payload, **k: (
+        events.append((k.get('event_type'), payload)), publish(sid, payload, **k))[1])
+    db.append_message(ref.session_id, role='user', content='hello')
+    db.append_message(ref.session_id, role='assistant', content='hi')
+    db.patch_session_model_config(ref.session_id, {USAGE_ANCHOR_MODEL_CONFIG_KEY: capture_usage_anchor(
+        250_000, 10, db.get_messages_as_conversation(ref.session_id))})
+    await authority.submit(owner.actor, Submission('running', ref, {'text': 'RUNNING'}, 'queue'))
+    await async_wait_until(started.is_set, timeout=10, what='the first turn is running')
+    assert (await _mutate(owner, db, ref, 'pick-a', 'model-a'))['result']['status'] == 'deferred'
+    release.set()
+    await async_wait_until(lambda: _asks(events), timeout=10, what='the stored pick asked')
+    return store, db, authority, owner, ref, events, (started, release)
+
+
+def _asks(events):
+    return [p for t, p in events if t == 'session.updated' and p.get('status') == 'confirmation_required']
+
+
+def _stored(db, ref):
+    with db._read_ctx() as conn:
+        row = conn.execute('SELECT value FROM state_meta WHERE key=?',
+                           ('gateway.deferred_pick.v1.' + ref.session_id,)).fetchone()
+    return json.loads(row[0]) if row else None
+
+
+async def _mutate(owner, db, ref, rid, model, confirm=None, call=1):
+    snap = db.get_session(ref.session_id)
+    payload = {'model': model, **({'confirm': confirm} if confirm else {})}
+    return await owner.dispatch({'id': call, 'method': 'session.mutate', 'params': {
+        'session_id': ref.session_id, 'request_id': rid, 'expected_revision': snap['runtime_revision'],
+        'expected_generation': snap['runtime_generation'], 'operation': 'model', 'payload': payload}})
+
+
+async def _attach_ask(authority, ref, events):
+    from gateway.session_deferred_pick import reask_on_attach
+    before = len(_asks(events))
+    await reask_on_attach(authority, ref, authority.sessions[ref.session_id])
+    await async_wait_until(lambda: len(_asks(events)) > before, timeout=10, what='the stored pick asked again')
+    return _asks(events)[-1]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('enabled', [True, False])
+async def test_a_newer_asked_pick_replaces_the_stored_one(tmp_path, monkeypatch, enabled):
+    store, db, authority, owner, ref, events, _ = await _guarded_setup(tmp_path, monkeypatch, enabled)
+    try:
+        old = _asks(events)[0]
+        assert old['target_model'] == 'model-a'
+        newer = await _mutate(owner, db, ref, 'pick-b', 'model-b', call=2)
+        assert newer.get('result', {}).get('status') == 'confirmation_required', newer
+        stored = _stored(db, ref)
+        assert stored['payload'] == {'model': 'model-a' if not enabled else 'model-b'}
+        ask = await _attach_ask(authority, ref, events)
+        assert ask['target_model'] == ('model-b' if enabled else 'model-a'), ask
+        confirmed = await _mutate(owner, db, ref, 'confirm-a', 'model-a', confirm=old['confirm'], call=3)
+        if enabled:
+            assert confirmed['error']['data']['reason'] == 'pick_superseded', confirmed
+            assert db.get_session(ref.session_id)['model'] == 'frozen'
+            assert _stored(db, ref)['awaiting_confirm'] == newer['result']['confirm']
+            done = await _mutate(owner, db, ref, 'confirm-b', 'model-b', confirm=newer['result']['confirm'], call=4)
+            assert done['result']['model'] == 'model-b', done
+            assert _stored(db, ref) is None
+        else:
+            assert confirmed['result']['model'] == 'model-a', confirmed
+    finally:
+        await owner.close()
+        store.close_all_db_handles()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('enabled', [True, False])
+async def test_a_newer_refused_pick_clears_the_stored_one(tmp_path, monkeypatch, enabled):
+    store, db, authority, owner, ref, events, _ = await _guarded_setup(tmp_path, monkeypatch, enabled)
+    try:
+        old = _asks(events)[0]
+        refused = await _mutate(owner, db, ref, 'pick-gone', 'gone', call=2)
+        assert refused['error']['data']['reason'] == 'model_resolution_failed', refused
+        assert (_stored(db, ref) is None) is enabled
+        confirmed = await _mutate(owner, db, ref, 'confirm-a', 'model-a', confirm=old['confirm'], call=3)
+        if enabled:
+            assert confirmed['error']['data']['reason'] == 'pick_superseded', confirmed
+            assert db.get_session(ref.session_id)['model'] == 'frozen'
+        else:
+            assert confirmed['result']['model'] == 'model-a', confirmed
+    finally:
+        await owner.close()
+        store.close_all_db_handles()
+
+
+@pytest.mark.asyncio
+async def test_a_fence_refusal_leaves_the_stored_pick(tmp_path, monkeypatch):
+    store, db, authority, owner, ref, events, _ = await _guarded_setup(tmp_path, monkeypatch, True)
+    try:
+        snap = db.get_session(ref.session_id)
+        stale = await owner.dispatch({'id': 2, 'method': 'session.mutate', 'params': {
+            'session_id': ref.session_id, 'request_id': 'stale', 'expected_revision': snap['runtime_revision'] + 7,
+            'expected_generation': snap['runtime_generation'], 'operation': 'model', 'payload': {'model': 'model-b'}}})
+        assert stale['error']['data']['reason'] == 'revision_conflict', stale
+        assert _stored(db, ref)['payload'] == {'model': 'model-a'}
+    finally:
+        await owner.close()
+        store.close_all_db_handles()
+
+
+@pytest.mark.asyncio
+async def test_a_newer_deferred_pick_supersedes_the_asked_one(tmp_path, monkeypatch):
+    from gateway.session_contract import Submission
+    store, db, authority, owner, ref, events, (started, release) = await _guarded_setup(tmp_path, monkeypatch, True)
+    try:
+        old = _asks(events)[0]
+        started.clear()
+        release.clear()
+        await authority.submit(owner.actor, Submission('running2', ref, {'text': 'RUNNING2'}, 'queue'))
+        await async_wait_until(started.is_set, timeout=10, what='a second turn is running')
+        deferred = await _mutate(owner, db, ref, 'pick-b', 'model-b', call=2)
+        assert deferred['result']['status'] == 'deferred', deferred
+        stored = _stored(db, ref)
+        assert stored['payload'] == {'model': 'model-b'} and 'awaiting_confirm' not in stored
+        confirmed = await _mutate(owner, db, ref, 'confirm-a', 'model-a', confirm=old['confirm'], call=3)
+        assert confirmed['error']['data']['reason'] == 'pick_superseded', confirmed
+        assert db.get_session(ref.session_id)['model'] == 'frozen'
+        release.set()
+    finally:
+        release.set()
+        await owner.close()
+        store.close_all_db_handles()
+
+
+@pytest.mark.asyncio
+async def test_a_reasoning_level_stored_beside_the_pick_survives_a_newer_ask(tmp_path, monkeypatch):
+    store, db, authority, owner, ref, events, _ = await _guarded_setup(tmp_path, monkeypatch, True)
+    try:
+        def add_level(conn):
+            key = 'gateway.deferred_pick.v1.' + ref.session_id
+            row = json.loads(conn.execute('SELECT value FROM state_meta WHERE key=?', (key,)).fetchone()[0])
+            row['reasoning'] = {'principal_id': 'human', 'request_id': 'lvl', 'payload': {'effort': 'high'},
+                                'application_id': 'deferred-pick:lvl'}
+            conn.execute('UPDATE state_meta SET value=? WHERE key=?', (json.dumps(row), key))
+        db._execute_write(add_level)
+        newer = await _mutate(owner, db, ref, 'pick-b', 'model-b', call=2)
+        assert newer.get('result', {}).get('status') == 'confirmation_required', newer
+        stored = _stored(db, ref)
+        assert stored['payload'] == {'model': 'model-b'} and stored['reasoning']['payload'] == {'effort': 'high'}
+    finally:
+        await owner.close()
+        store.close_all_db_handles()
+
diff --git a/website/docs/user-guide/sessions.md b/website/docs/user-guide/sessions.md
index 0636b6ccd8..ad521b247b 100644
--- a/website/docs/user-guide/sessions.md
+++ b/website/docs/user-guide/sessions.md
@@ -1298,6 +1298,25 @@ or is stopped first, the result goes back to its place in the queue and runs
 or is noted after the turn as before. Only a result dispatched from the same
 conversation is handed over; an idle session is unchanged.
 
+**Stale model picks.** A model pick made while a turn runs is kept until the
+turn ends. If its target is guarded (cost, data policy or a large context), it
+is then asked and stays stored, and a viewer that attaches later is asked
+again. By default a later pick that is itself asked or refused leaves that
+stored pick in place, so the next viewer is asked about the older model, whose
+confirmation still applies it. Set `sessions.newest_pick_supersedes: true` so
+each newer pick settles it:
+
+```yaml
+sessions:
+  newest_pick_supersedes: true
+```
+
+A later pick that is asked replaces the stored one, so a viewer is asked about
+the newest. A later pick that is refused (the model does not resolve) or resets
+to the default clears it. The confirmation of a replaced or cleared pick is
+refused with `pick_superseded`. A pick that applies or is deferred already
+replaced it. A level set with `/reasoning` is not part of this.
+
 ### Oversized-Transcript Guards
 
 Two limits stop a runaway transcript from being loaded into memory all at once
