@@ -582,6 +760,8 @@ def _known_rule(category: str) -> tuple[str, str] | None:
 def parse_stage1(text: str) -> str | None:
     """'block', 'allow', or None when unreadable."""
     t = _THINK_RE.sub("", text or "").strip().lower()
+    if len(set(re.findall(r"<block>\s*(yes|no)", t))) > 1:
+        return None  # both verdicts: unreadable, never a stage-1 allow
     m = re.match(r"^(?:<block>\s*)?(yes|no)\b", t)
     if not m:
