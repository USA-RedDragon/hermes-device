 from __future__ import annotations
@@ -233,6 +239,171 @@ def write_facts(tool_name: str, args: dict) -> dict:
         return {}
 
 
+# git clone options that take a value, so the URL and directory are found among the words.
+_CLONE_OPTS_WITH_VALUE = frozenset({
+    "-b", "--branch", "--depth", "-o", "--origin", "--reference", "--reference-if-able", "-c", "--config",
+    "--separate-git-dir", "-j", "--jobs", "--filter", "--template", "--shallow-since", "--shallow-exclude",
+    "-u", "--upload-pack", "--bundle-uri", "--revision", "--server-option",
+})
+_SEGMENT_SPLIT = re.compile(r"\s*(?:&&|\|\||;|\||\n)\s*")
+
+
+def _segments(command: str) -> list[list[str]]:
+    out = []
+    for part in _SEGMENT_SPLIT.split(command or ""):
+        try:
+            words = shlex.split(part, comments=True)
+        except ValueError:
+            words = part.split()
+        while words and re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", words[0]):
+            words = words[1:]  # leading VAR=value assignments
+        if words:
+            out.append(words)
+    return out
+
+
+def _abs_path(path: str, base: str | None) -> str:
+    path = os.path.expanduser(path.strip())
+    if not os.path.isabs(path):
+        path = os.path.join(base or os.getcwd(), path)
+    return os.path.normpath(path)
+
+
+def _fetched_paths(command: str, base: str | None) -> list[str]:
+    """Directories and files a shell command clones, unpacks or downloads from outside the machine."""
+    found: list[str] = []
+    cwd = base
+    for words in _segments(command):
+        prog = os.path.basename(words[0])
+        if prog == "cd" and len(words) > 1:
+            cwd = _abs_path(words[1], cwd)
+            continue
+        args = words[1:]
+        if prog == "git" and "clone" in args:
+            rest = args[args.index("clone") + 1:]
+        elif prog == "gh" and args[:2] == ["repo", "clone"]:
+            rest = args[2:]
+        else:
+            rest = None
+        if rest is not None:
+            positional, skip = [], False
+            for word in rest:
+                if skip:
+                    skip = False
+                elif word == "--":
+                    continue
+                elif word.startswith("-"):
+                    skip = word in _CLONE_OPTS_WITH_VALUE
+                else:
+                    positional.append(word)
+            if len(positional) >= 2:
+                found.append(_abs_path(positional[1], cwd))
+            elif positional:
+                name = positional[0].rstrip("/").rsplit("/", 1)[-1].rsplit(":", 1)[-1]
+                name = name.removesuffix(".git")
+                if name:
+                    found.append(_abs_path(name, cwd))
+            continue
+        target = None
+        if prog in ("tar", "bsdtar"):
+            for i, word in enumerate(args):
+                if word in ("-C", "--directory") and i + 1 < len(args):
+                    target = args[i + 1]
+                elif word.startswith("--directory="):
+                    target = word.split("=", 1)[1]
+        elif prog == "unzip":
+            for i, word in enumerate(args):
+                if word == "-d" and i + 1 < len(args):
+                    target = args[i + 1]
+        elif prog in ("curl", "wget"):
+            for i, word in enumerate(args):
+                if word in ("-o", "--output", "-O", "--output-document") and i + 1 < len(args) \
+                        and not (prog == "curl" and word == "-O"):
+                    target = args[i + 1]
+                elif word.startswith(("--output=", "--output-document=")):
+                    target = word.split("=", 1)[1]
+        if target and target != "-":
+            found.append(_abs_path(target, cwd))
+    return found
+
+
+def _dangerous_pattern(tool_name: str, args: dict) -> str:
+    """Why stage 1 may not clear a command upstream's dangerous-command patterns flag: a small stage-1 model
+    allows some of them (``curl | sh``), and only those reached upstream's guardian at all."""
+    if tool_name not in ("terminal", "execute_code") or not isinstance(args, dict):
+        return ""
+    command = args.get("command") if tool_name == "terminal" else args.get("code")
+    if not isinstance(command, str) or not command.strip():
+        return ""
+    try:
+        from tools.approval_detection import detect_dangerous_command
+        flagged, _key, desc = detect_dangerous_command(command)
+    except Exception:
+        return ""
+    return f"matches a dangerous command pattern ({desc})" if flagged else ""
+
+
+def session_fetched_paths(*message_lists: list | None, cwd: str | None = None) -> list[str]:
+    """Paths a finished terminal call in these transcripts cloned, unpacked or downloaded this session."""
+    paths: list[str] = []
+    for messages in message_lists:
+        msgs = [m for m in (messages or []) if isinstance(m, dict)]
+        ran = {m.get("tool_call_id") for m in msgs if m.get("role") == "tool"}
+        for message in msgs:
+            for call in message.get("tool_calls") or [] if message.get("role") == "assistant" else []:
+                cid, name, raw = _call_parts(call)
+                if name != "terminal" or cid not in ran:
+                    continue
+                args = _parse_args(raw)
+                command = args.get("command")
+                if isinstance(command, str):
+                    base = args.get("workdir") if isinstance(args.get("workdir"), str) else cwd
+                    paths.extend(p for p in _fetched_paths(command, base and _abs_path(base, cwd)) if p not in paths)
+    return paths
+
+
+def _inside(path: str, roots: list[str]) -> str | None:
+    for root in roots:
+        if path == root or path.startswith(root.rstrip("/") + "/"):
+            return root
+    return None
+
+
+def fetched_code_facts(tool_name: str, args: dict, fetched: list[str], cwd: str | None = None) -> dict:
+    """``runs_in_session_fetch``: the action's command names or runs in a path cloned, unpacked or downloaded
+    this session. Local judges miss Code from External on such commands, so the harness states it."""
+    if not fetched or not isinstance(args, dict):
+        return {}
+    if tool_name == "terminal":
+        command = args.get("command")
+        base = _abs_path(args["workdir"], cwd) if isinstance(args.get("workdir"), str) else cwd
+    elif tool_name == "execute_code":
+        command, base = args.get("code"), cwd
+    else:
+        return {}
+    if not isinstance(command, str):
+        return {}
+    if base:
+        hit = _inside(_abs_path(base, cwd), fetched)
+        if hit:
+            return {"runs_in_session_fetch": hit}
+    run_cwd = base
+    for words in _segments(command) if tool_name == "terminal" else [re.findall(r"[~/.\w-][^\s'\"]*", command)]:
+        if words and os.path.basename(words[0]) == "cd" and len(words) > 1:
+            run_cwd = _abs_path(words[1], run_cwd)
+            hit = _inside(run_cwd, fetched)
+            if hit:
+                return {"runs_in_session_fetch": hit}
+            continue
+        for word in words:
+            for piece in word.split("="):
+                if piece.startswith(("/", "~", ".")) or "/" in piece:
+                    hit = _inside(_abs_path(piece, run_cwd), fetched)
+                    if hit:
+                        return {"runs_in_session_fetch": hit}
+    return {}
+
+
 def _parse_args(raw: Any) -> dict:
     if isinstance(raw, dict):
         return raw
