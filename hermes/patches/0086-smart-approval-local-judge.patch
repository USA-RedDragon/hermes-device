@@ -633,40 +813,127 @@ def _stage_route(stage: int) -> dict:
     return {}
 
 
+class JudgeWindowError(RuntimeError):
+    """The review prompt does not fit the window the judge model is served with."""
+
+
+def _served_window(route: dict) -> tuple[str, int] | None:
+    """(model, window) for a self-hosted judge (Ollama, llama.cpp, vLLM): the window it is served with,
+    not the model's maximum. A judge that follows the main model is checked against the main server.
+    None for a hosted provider."""
+    try:
+        from agent import auxiliary_client as aux
+        from agent.model_metadata import _self_hosted_server, get_model_context_length
+        provider, model, base_url, api_key, _mode = aux._resolve_task_provider_model(
+            "approval", route.get("provider"), route.get("model"), route.get("base_url"), route.get("api_key"))
+        if not base_url and provider in (None, "", "auto"):  # the judge follows the main model's server
+            provider, main_model, base_url, api_key, _mode = aux._main_route_target(
+                aux._normalize_main_runtime(None), "approval")
+            base_url = base_url or aux._read_main_base_url()
+            model = model or main_model
+        if callable(api_key):
+            api_key = ""
+        if not base_url or not model or not _self_hosted_server(base_url, api_key or ""):
+            return None
+        return model, int(get_model_context_length(model, base_url, api_key or "", provider=provider or ""))
+    except Exception as exc:
+        logger.debug("Smart approval (provenance): judge window unknown (%s)", exc)
+        return None
