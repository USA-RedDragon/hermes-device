+def _import_handed_over_tickets(config) -> None:
+    """``gateway.restart_ticket_handover``: before the listener opens, load the socket tickets the
+    previous gateway handed over (``gateway.ticket_handover``)."""
+    from gateway import ticket_handover
+    if not ticket_handover.enabled(config):
+        return
+    from gateway.run import get_hermes_home
+    try:
+        loaded = ticket_handover.import_tickets(get_hermes_home())
+    except Exception:
+        logger.warning("Could not load the socket tickets the previous gateway handed over", exc_info=True)
+        return
+    if loaded:
+        logger.info("Loaded %d socket ticket(s) the previous gateway handed over", loaded)
+
+
+def _export_tickets_for_successor(runner) -> None:
+    """``gateway.restart_ticket_handover``: just before a restart releases the profile, hand the unused
+    socket tickets to the gateway that takes it over."""
+    from gateway import ticket_handover
+    if (runner is None or not getattr(runner, "_restart_requested", False)
+            or not ticket_handover.enabled(getattr(runner, "config", None))):
+        return
+    from gateway.run import get_hermes_home
+    try:
+        ticket_handover.export_tickets(get_hermes_home())
+    except Exception:
+        logger.warning("Could not hand the socket tickets to the next gateway", exc_info=True)
+
