 gateway/config_loader.py                      |  1 +
 gateway/run_bootstrap.py                      | 32 +++++++
 gateway/ticket_handover.py                    | 90 +++++++++++++++++++
 tests/gateway/test_restart_ticket_handover.py | 89 ++++++++++++++++++
 5 files changed, 217 insertions(+)
 create mode 100644 gateway/ticket_handover.py
 create mode 100644 tests/gateway/test_restart_ticket_handover.py

