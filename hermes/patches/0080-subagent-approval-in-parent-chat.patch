@@ -0,0 +1,179 @@
+"""A subagent's approval reaches its parent's chat as a normal card that names the subagent, waits as long as
+a chat's approval does, and is not withdrawn when the parent's turn ends.
+"""
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+from agent.delegation_context import delegated_child_context
+from gateway.run_turn_runner import TurnRunner
+from gateway.turn_context import TurnContext
+from tools import approval as mod
+from tools import approval_context
+
+KEY = "test-subagent-approval"
+
+
+@pytest.fixture
+def gateway_session(monkeypatch):
+    mod._gateway_queues.clear()
+    mod._gateway_notify_cbs.clear()
+    mod._session_approved.clear()
+    for name in ("HERMES_CRON_SESSION", "HERMES_YOLO_MODE", "HERMES_INTERACTIVE"):
+        monkeypatch.delenv(name, raising=False)
+    monkeypatch.setenv("HERMES_GATEWAY_SESSION", "1")
+    monkeypatch.setenv("HERMES_SESSION_KEY", KEY)
+    monkeypatch.setattr(mod, "_YOLO_MODE_FROZEN", False)
+    monkeypatch.setattr(approval_context, "_get_approval_config", lambda: {"mode": "manual", "timeout": 1800})
+    yield
+    mod._gateway_queues.clear()
+    mod._gateway_notify_cbs.clear()
+
+
+def _ask(goal=None):
+    """Run the command gate on a worker thread, as a subagent (``goal``) or as the chat itself, and return
+    ``(thread, result holder, the prompts its notifier received)`` once the prompt was handed over."""
+    seen, handed = [], threading.Event()
+    mod.register_gateway_notify(KEY, lambda data: (seen.append(data), handed.set()))
+    holder = {}
+
+    def gate():
+        if goal is None:
+            holder["result"] = mod.check_all_command_guards("rm -rf .git", "local")
+        else:
+            with delegated_child_context("child-session", goal):
+                holder["result"] = mod.check_all_command_guards("rm -rf .git", "local")
+
+    thread = threading.Thread(target=gate, daemon=True)
+    thread.start()
+    assert handed.wait(timeout=10), "the approval was never handed to the notifier"
+    return thread, holder, seen
+
+
+def test_a_subagent_prompt_names_the_subagent_and_waits_the_chats_timeout(gateway_session):
+    thread, holder, seen = _ask("Check the rollout and report")
+    try:
+        (data,) = seen
+        assert data["subagent"] == "Check the rollout and report"
