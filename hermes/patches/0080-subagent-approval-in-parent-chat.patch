+def release_gateway_turn(session_key: str, background_cb=None) -> None:
+    """A turn ended under its approval notifier. Prompts of the turn's own tool calls are withdrawn, as
+    ``unregister_gateway_notify`` does. With ``background_cb`` the approvals that subagents of the session wait on
+    (``data["subagent"]``) keep waiting, and later ones from them go to ``background_cb``: a background subagent
+    outlives the turn that started it, and its approval must not be withdrawn with the turn."""
+    with _lock:
+        queue = _gateway_queues.pop(session_key, [])
+        kept = [e for e in queue if background_cb is not None and e.data.get("subagent")]
+        for entry in queue:
+            if entry not in kept:
+                entry.event.set()
+        if kept:
+            _gateway_queues[session_key] = kept
+        if background_cb is not None:
+            _gateway_notify_cbs[session_key] = background_cb
+        else:
+            _gateway_notify_cbs.pop(session_key, None)
+
+
+def has_subagent_approval(session_key: str) -> bool:
+    """Whether a subagent of the session waits on an approval."""
+    with _lock:
+        return any(e.data.get("subagent") for e in _gateway_queues.get(session_key, []))
+
+
