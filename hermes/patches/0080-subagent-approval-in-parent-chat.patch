index 00000000..ad3e1952
--- /dev/null
+++ b/tests/gateway/test_subagent_approval_outlives_turn.py
@@ -0,0 +1,128 @@
+"""A background subagent's approval belongs to its parent's chat, not to the turn that started it.
+
+Real owner pieces (``SessionAuthority`` over a real ``SessionDB``, the real claim and settlement, the real
+approval queue); only the gateway runner is a stand-in.
+"""
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.session_authority import LiveSession, SessionAuthority
+from gateway.session_contract import SessionActor, SessionRef
+from hermes_state import SessionDB
+from hermes_state_runtime import (
+    RuntimeStoreError, admit_session_input, begin_runtime_epoch, claim_session_input, settle_session_input,
+)
+from tools import approval
+from tools.approval_gateway_wait import _ApprovalEntry
+
+ROUTE = 'subagent-route'
+
+
+@pytest.fixture()
+def owner(tmp_path):
+    approval._gateway_queues.clear()
+    with SessionDB(db_path=tmp_path / 'state.db') as db:
+        db.create_session('s', source='test')
+        epoch = begin_runtime_epoch(db, instance_id='current')
+        authority = SessionAuthority(SimpleNamespace(_draining=False), profile_id='owned',
+                                     instance_id='current', db=db, epoch=epoch)
+        authority.sessions['s'] = LiveSession(None, ROUTE)
+        yield SimpleNamespace(authority=authority, db=db, epoch=epoch)
+    approval._gateway_queues.clear()
+
+
+def _run_a_turn(owner, request_id):
+    admit_session_input(owner.db, epoch=owner.epoch, principal_id='human', session_id='s',
+                        request_id=request_id, payload={'text': 'start a subagent'})
+    row = claim_session_input(owner.db, epoch=owner.epoch, session_id='s')
+    return row['admission_id'], row['generation']
+
+
+def _end_the_turn(owner, admission_id, generation):
+    settle_session_input(owner.db, epoch=owner.epoch, admission_id=admission_id, generation=generation,
+                         outcome='completed')
+
+
+def _wait_for_a_subagent():
+    entry = _ApprovalEntry({'command': 'true # approval-test', 'request_id': 'sub-1',
+                            'description': 'Subagent "check it" asks: a test', 'subagent': 'check it'})
+    approval._gateway_queues.setdefault(ROUTE, []).append(entry)
+    return entry
+
+
+def _actor():
+    return SessionActor('human', 'owned', frozenset({'session:read', 'session:approve'}), 'viewer')
+
+
+@pytest.mark.asyncio
+async def test_a_subagent_prompt_stays_listed_and_answerable_after_the_turn_ended(owner):
+    authority = owner.authority
+    admission, generation = _run_a_turn(owner, 'first')
+    entry = _wait_for_a_subagent()
+    authority.register_background_approval('s', ROUTE, entry.data)
+    ref, actor = SessionRef('owned', 's'), _actor()
+    await authority.attach(actor, ref)
+    _end_the_turn(owner, admission, generation)
+
+    live = authority.sessions['s']
+    # An idle session lists the prompt a subagent waits on, which a turn-bound prompt would not survive.
+    assert [p['prompt_id'] for p in live.controls.snapshot('s', None)] == ['sub-1']
+    assert live.controls.has_background('s', generation)
+
+    # A later turn changes the generation; the answer still reaches the subagent's wait.
+    admission2, generation2 = _run_a_turn(owner, 'second')
+    assert generation2 != generation
+    result = await authority.respond(actor, ref, generation, 'sub-1', {'choice': 'once'})
+    assert result['status'] == 'resolved'
+    assert entry.result == 'once'
+    assert entry.event.is_set()
+    assert not live.controls.has_background('s', generation2)
+
+
+@pytest.mark.asyncio
+async def test_a_turn_prompt_is_still_fenced_to_its_turn(owner):
+    authority = owner.authority
+    admission, generation = _run_a_turn(owner, 'first')
+    entry = _ApprovalEntry({'command': 'rm -rf build', 'request_id': 'turn-1'})
+    approval._gateway_queues.setdefault(ROUTE, []).append(entry)
+    authority.register_approval('s', generation, ROUTE, entry.data)
+    ref, actor = SessionRef('owned', 's'), _actor()
+    await authority.attach(actor, ref)
+    _end_the_turn(owner, admission, generation)
+    with pytest.raises(RuntimeStoreError, match='stale_generation'):
+        await authority.respond(actor, ref, generation, 'turn-1', {'choice': 'once'})
+    assert entry.result is None
+
+
+def test_an_idle_session_with_a_subagent_prompt_is_not_idle(owner):
+    from gateway.session_active_list import _status
+    authority = owner.authority
+    admission, generation = _run_a_turn(owner, 'first')
+    _end_the_turn(owner, admission, generation)
+    live = authority.sessions['s']
+    handle = authority._handle(SessionRef('owned', 's'))
+    assert _status(live, handle, []) == 'idle'
+    entry = _wait_for_a_subagent()
+    authority.register_background_approval('s', ROUTE, entry.data)
+    assert _status(live, handle, []) == 'waiting'
+    approval.resolve_gateway_approval(ROUTE, 'deny', request_id='sub-1')
+    assert _status(live, handle, []) == 'idle'
+
+
+def test_the_prompt_is_a_normal_approval_card_naming_the_subagent(owner):
+    authority = owner.authority
+    events = []
+    live = authority.sessions['s']
+    live.event_stream.publish = lambda sid, payload, event_type=None: events.append((event_type, payload))
+    entry = _wait_for_a_subagent()
+    authority.register_background_approval('s', ROUTE, entry.data, timeout_s=1800)
+    (event_type, prompt), = events
+    assert event_type == 'approval.request'
+    assert prompt['kind'] == 'approval' and prompt['prompt_id'] == 'sub-1'
+    assert prompt['choices'] == ['once', 'deny', 'session', 'always']
+    assert prompt['description'] == 'Subagent "check it" asks: a test'
+    assert prompt['timeout_s'] == 1800
+    assert prompt['subagent'] == 'check it'
+    assert set(prompt) <= {'kind', 'prompt_id', 'execution_generation', 'command', 'description', 'choices',
+                           'timeout_s', 'subagent'}
