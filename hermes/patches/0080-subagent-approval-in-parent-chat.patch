+def _name_subagent(approval_data: dict) -> dict:
+    """The approval of a delegate_task child, marked with ``subagent`` (its goal, one line) and a description that
+    says which subagent asks: the card is shown in the parent's chat, where the user sees only the command.
+    Unchanged outside a child."""
+    from agent.delegation_context import delegated_child_goal, is_delegated_child_context
+    if not is_delegated_child_context():
+        return approval_data
+    goal = delegated_child_goal()
+    if len(goal) > _SUBAGENT_GOAL_CHARS:
+        goal = goal[:_SUBAGENT_GOAL_CHARS - 1].rstrip() + "\u2026"
+    label = f'Subagent "{goal}"' if goal else "A subagent"
+    description = str(approval_data.get("description") or "").strip()
+    return {**approval_data, "subagent": goal or "subagent",
+            "description": f"{label} asks: {description}" if description else f"{label} asks to run this."}
+
