+def _env_tree_kill(pid: int) -> str:
+    """Shell that stops a sandbox background process with its descendants, children first. The PID that
+    ``spawn_via_env`` records is the wrapper subshell, and the command runs in a child of it under ``nohup``,
+    so a kill of the PID alone left the command running. ``pgrep -P`` is in procps and busybox; without it
+    only the PID is signalled, as before."""
+    return ("_hermes_kill_tree() { for _c in $(pgrep -P \"$1\" 2>/dev/null); do _hermes_kill_tree \"$_c\"; done; "
+            f"kill \"$1\" 2>/dev/null; }}; _hermes_kill_tree {int(pid)}")
+
+
 def _last_line_int(output: str) -> Optional[int]:
     """The integer on the last non-empty line of *output*, or None (a backend's error text)."""
     lines = [line.strip() for line in (output or "").splitlines() if line.strip()]
