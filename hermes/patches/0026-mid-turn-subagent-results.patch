+def dispatching_sessions(delegation_ids) -> Optional[set]:
+    """The ``parent_session_id`` of each of *delegation_ids*' records, or None when any record is not in this
+    process (a completion replayed after a restart) or names no parent."""
+    with _records_lock:
+        records = [_records.get(i) for i in delegation_ids]
+    parents = {record.get("parent_session_id") for record in records if record is not None}
+    if not delegation_ids or None in records or not all(isinstance(p, str) and p for p in parents):
+        return None
+    return parents
+
