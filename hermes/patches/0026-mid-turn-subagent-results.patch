diff --git a/agent/background_notices.py b/agent/background_notices.py
new file mode 100644
index 0000000000..54e49e02e2
--- /dev/null
+++ b/agent/background_notices.py
@@ -0,0 +1,113 @@
+"""Background results handed to a running turn (``sessions.mid_turn_subagent_results``).
+
+The gateway hands a background subagent's completion notice, admitted while the session's turn runs,
+to that turn's agent instead of leaving it queued behind it (``gateway/session_completion_steer.py``).
+The notice rides the next tool result of the turn, after its content, like a plugin's go-live notice
+(``agent/plugin_live_notes.py``): a new row not yet flushed, so no cached byte moves, and no running
+tool is cut short for it. It is never wrapped as the user's mid-turn steer: the result carries the
+subagent's own output, which keeps the trust it has as its own turn.
+
+Each notice carries a ticket (its admission id). The claim's settlement withdraws a notice no tool
+result took, and its admission goes back to its queue place, so it still runs or is noted as before.
+"""
+
+from __future__ import annotations
+
+import threading
+from typing import Any, Optional
+
+from agent.message_content import flatten_message_text
+
+_QUEUED = "_background_notices"
+_FATES = "_background_notice_fates"
+_IN_BATCH = "_background_notices_in_tool_batch"
+_LOCK = threading.Lock()
+
+NOTICE_LEAD = ("[A background result arrived while this turn was running. It is not output of the tool call "
+               "above; act on it as you would on its own message.]")
+
+
+def _queued(agent: Any) -> list[tuple[Any, str]]:
+    notices = vars(agent).get(_QUEUED) if hasattr(agent, "__dict__") else None
+    return notices if isinstance(notices, list) else []
+
+
+def _fates(agent: Any) -> dict:
+    return vars(agent).setdefault(_FATES, {})
+
+
+def queue_notice(agent: Any, ticket: Any, text: str) -> bool:
+    """Queue ``text`` for ``agent``'s next tool result. False for empty text or an agent without state."""
+    if not isinstance(text, str) or not text.strip() or not hasattr(agent, "__dict__"):
+        return False
+    with _LOCK:
+        setattr(agent, _QUEUED, [*_queued(agent), (ticket, text.strip())])
+        _fates(agent).pop(ticket, None)
+    return True
+
+
+def holds(agent: Any, ticket: Any) -> bool:
+    """Whether ``ticket`` was handed to ``agent`` as a notice and not withdrawn yet."""
+    if not hasattr(agent, "__dict__"):
+        return False
+    with _LOCK:
+        return any(t == ticket for t, _ in _queued(agent)) or ticket in vars(agent).get(_FATES, {})
+
+
+def withdraw(agent: Any, ticket: Any) -> Optional[bool]:
+    """Settle one notice by its ticket: True when no tool result took it (taken out of the queue now),
+    False once one did, None for a ticket this agent never held as a notice."""
+    if not hasattr(agent, "__dict__"):
+        return None
+    with _LOCK:
+        queued = _queued(agent)
+        kept = [(t, text) for t, text in queued if t != ticket]
+        if len(kept) != len(queued):
+            setattr(agent, _QUEUED, kept)
+            return True
+        consumed = vars(agent).get(_FATES, {}).pop(ticket, None)
+    return None if consumed is None else not consumed
+
+
+def _pop(agent: Any) -> str:
+    with _LOCK:
+        queued = _queued(agent)
+        if not queued:
+            return ""
+        setattr(agent, _QUEUED, [])
+        fates = _fates(agent)
+        for ticket, _ in queued:
+            fates[ticket] = True
+    return "\n\n".join([NOTICE_LEAD, *(text for _, text in queued)])
+
+
+def attach_to_tool_message(agent: Any, message: dict) -> None:
+    """Append every queued notice to ``message``, the tool result about to be appended and flushed."""
+    notes = _pop(agent)
+    if not notes:
+        return
+    _append(message, notes)
+    in_batch = vars(agent).get(_IN_BATCH)
+    in_batch = in_batch if isinstance(in_batch, dict) else {}
+    setattr(agent, _IN_BATCH, {**in_batch, message.get("tool_call_id"): notes})
+
+
+def keep_after_turn_budget(agent: Any, batch: list[dict]) -> None:
+    """Put a notice back on a batch row whose content the turn budget spilled to a file (the flushed row
+    already holds it)."""
+    in_batch = vars(agent).get(_IN_BATCH) if hasattr(agent, "__dict__") else None
+    if not isinstance(in_batch, dict) or not in_batch:
+        return
+    setattr(agent, _IN_BATCH, {})
+    for message in batch:
+        notes = in_batch.get(message.get("tool_call_id"))
+        if notes and notes not in flatten_message_text(message.get("content")):
+            _append(message, notes)
+
+
+def _append(message: dict, notes: str) -> None:
+    content = message.get("content")
+    if isinstance(content, list):
+        message["content"] = [*content, {"type": "text", "text": notes}]
+    else:
+        message["content"] = f"{content or ''}\n\n{notes}"
