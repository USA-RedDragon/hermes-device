diff --git a/gateway/session_completion_steer.py b/gateway/session_completion_steer.py
new file mode 100644
index 0000000000..af1520fc30
--- /dev/null
+++ b/gateway/session_completion_steer.py
@@ -0,0 +1,191 @@
+"""A background subagent's result reaches a running turn (``sessions.mid_turn_subagent_results``).
+
+By default a background ``delegate_task`` result admitted while its session's turn runs waits in the
+session's FIFO behind that turn, so an agent learns of it only after it ends its turn. With the option on,
+the queued result is handed to the running turn instead, through the same transfer a viewer's
+``prompt.steer_queued`` uses (gateway/session_queued_controls.py): the admission goes queued ->
+``steering`` bound to the running claim, its notice rides the turn's next tool result
+(agent/background_notices.py), and the claim's settlement decides it: ``steered`` once a tool result
+carried it, back to its queue place when none did (the turn ended with no further tool call, or was
+stopped first), where it runs or is noted exactly as it would have been. No running tool is interrupted.
+
+Only a result whose dispatching session is the running turn's conversation (its compression chain) is
+handed over, and never one whose dispatching session is closed to new dispatches. A result admitted
+before the turn adopted its agent is offered again when it does. An idle session is unchanged.
+"""
+import asyncio
+import contextlib
+import json
+import logging
+from functools import partial
+from pathlib import Path
+
+from hermes_state_runtime import (
+    RuntimeStoreError, get_session_admission, revert_steer_input, steer_session_input,
+)
+
+logger = logging.getLogger(__name__)
+
+
+def mid_turn_subagent_results(authority):
+    """Blocking: ``sessions.mid_turn_subagent_results`` of the profile that owns *authority*'s store."""
+    from hermes_cli.config_defaults import DEFAULT_CONFIG
+    from hermes_cli.config_effective import load_user_config_effective
+    from gateway.session_local import profile_env_scope
+    default = DEFAULT_CONFIG['sessions']['mid_turn_subagent_results']
+    home = Path(authority.db.db_path).resolve().parent
+    with profile_env_scope(home):
+        sessions = load_user_config_effective(home / 'config.yaml').get('sessions')
+    raw = sessions.get('mid_turn_subagent_results', default) if isinstance(sessions, dict) else default
+    return raw if isinstance(raw, bool) else default
+
+
+def _identities(descriptor):
+    return set(descriptor.get('identities') or ()) | {descriptor.get('identity')}
+
+
+def _delegation_ids(descriptor):
+    """The delegation ids of a row whose every identity is a background subagent's result, else None."""
+    ids = set()
+    for identity in _identities(descriptor):
+        try:
+            kind, delegation_id = json.loads(identity)[:2]
+        except (ValueError, TypeError):
+            return None
+        if kind != 'async_delegation':
+            return None
+        ids.add(str(delegation_id))
+    return ids or None
+
+
+def _subagent_result_ids(row):
+    payload = row.get('payload') or {}
+    descriptor = payload.get('local_automation_v1')
+    if not isinstance(descriptor, dict) or set(payload) != {'text', 'local_automation_v1'}:
+        return None
+    return _delegation_ids(descriptor)
+
+
+def offer_admitted(authority, ref, receipt):
+    """Loop side, after an automation admission committed: offer it to the running turn when it is a
+    background subagent's result still queued."""
+    if getattr(receipt, 'status', None) != 'queued' or not str(getattr(receipt, 'admission_id', '')):
+        return
+    _start(authority, ref, receipt.admission_id)
+
+
+def offer_waiting(authority, session_id):
+    """Any thread (``adopt_agent`` runs on the turn's executor thread): offer the results that waited for
+    this session's turn to adopt its agent."""
+    loop = getattr(authority, '_completion_offer_loop', None)
+    if loop is None or loop.is_closed():
+        return
+    from gateway.session_contract import SessionRef
+    ref = SessionRef(authority.profile_id, session_id)
+
+    def run():
+        for admission_id in sorted(authority.completion_offers.pop(session_id, ())):
+            _start(authority, ref, admission_id)
+    with contextlib.suppress(RuntimeError):  # the loop closed meanwhile: the rows stay queued
+        loop.call_soon_threadsafe(run)
+
+
+def _start(authority, ref, admission_id):
+    from gateway.session_runtime_workers import track_mutation
+    authority._completion_offer_loop = asyncio.get_running_loop()
+    track_mutation(authority, _offer(authority, ref, admission_id))
+
+
+def _wait_for_agent(authority, session_id, admission_id):
+    authority.completion_offers.setdefault(session_id, set()).add(admission_id)
+
+
+def _drop_offer(authority, session_id, admission_id):
+    waiting = authority.completion_offers.get(session_id)
+    if waiting is not None:
+        waiting.discard(admission_id)
+        if not waiting:
+            authority.completion_offers.pop(session_id, None)
+
+
+async def _offer(authority, ref, admission_id):
+    try:
+        await _hand_to_running_turn(authority, ref, admission_id)
+    except Exception:
+        # The row stays queued and runs in its FIFO place: nothing is lost.
+        logger.warning('Could not hand background result %s to the running turn of %s', admission_id,
+                       ref.session_id, exc_info=True)
+
+
+async def _hand_to_running_turn(authority, ref, admission_id):
+    session_id = ref.session_id
+    row = get_session_admission(authority.db, admission_id=admission_id)
+    ids = _subagent_result_ids(row) if row is not None and row['status'] == 'queued' else None
+    if ids is None:
+        _drop_offer(authority, session_id, admission_id)
+        return
+    if not await asyncio.to_thread(mid_turn_subagent_results, authority):
+        return
+    from tools.async_delegation import dispatching_sessions, refused_dispatch
+    parents = dispatching_sessions(ids)
+    if parents is None or refused_dispatch(ids):
+        return
+    chain = set(await asyncio.to_thread(authority.db.get_compression_chain, session_id))
+    if not parents <= chain:
+        return
+    live = authority.sessions.get(session_id)
+    try:
+        handle = authority._handle(ref)
+    except RuntimeStoreError:
+        return
+    if live is None or handle.execution_state != 'running':
+        _wait_for_agent(authority, session_id, admission_id)  # the next turn's adoption offers it again
+        return
+    from gateway.session_queued_controls import _receiving_agent, _register, _unregister
+    generation = handle.execution_generation
+    with live.event_stream.lock:
+        agent = _receiving_agent(authority, session_id, generation)
+        if agent is None:
+            _wait_for_agent(authority, session_id, admission_id)
+            return
+        if getattr(agent, 'session_id', None) not in chain:
+            return
+        _drop_offer(authority, session_id, admission_id)
+        _register(authority, session_id, generation, admission_id)
+    from gateway.session_runtime_workers import tracked_write
+    try:
+        _committed, fresh = await tracked_write(authority, partial(
+            steer_session_input, authority.db, epoch=authority.epoch, admission_id=admission_id,
+            generation=generation))
+    except RuntimeStoreError:
+        # Claimed first, or the turn ended: the row runs in its FIFO place as before.
+        with live.event_stream.lock:
+            _unregister(authority, session_id, generation, admission_id)
+        return
+    if not fresh:
+        return
+    with live.event_stream.lock:
+        delivered = _deliver_notice(authority, session_id, generation, agent, admission_id, row['payload']['text'])
+    if not delivered:
+        await tracked_write(authority, partial(revert_steer_input, authority.db, epoch=authority.epoch,
+                                               admission_id=admission_id, generation=generation))
+        with live.event_stream.lock:
+            _unregister(authority, session_id, generation, admission_id)
+        authority._publish_pending(ref)
+        authority._schedule(ref)
+        return
+    authority._publish_pending(ref)
+
+
+def _deliver_notice(authority, session_id, generation, agent, admission_id, text):
+    """``session_queued_controls._deliver`` for a background result: the claim's agent queues it for its
+    next tool result, ticketed by the admission id. The caller holds the stream lock."""
+    from agent.background_notices import queue_notice
+    from gateway.session_queued_controls import _receiving_agent
+    entry = authority.steer_transfers.get(session_id)
+    if (entry is None or entry[0] != generation or admission_id not in entry[1]
+            or _receiving_agent(authority, session_id, generation) is not agent):
+        return False
+    if not entry[1][admission_id]:
+        entry[1][admission_id] = queue_notice(agent, admission_id, text)
+    return entry[1][admission_id]
diff --git a/gateway/session_queued_controls.py b/gateway/session_queued_controls.py
index e36e3e282d..25b54df493 100644
--- a/gateway/session_queued_controls.py
+++ b/gateway/session_queued_controls.py
@@ -90,13 +90,25 @@ def steer_transfers(authority, session_id, generation):
     if entry is None or entry[0] != generation:
         return None
     adopted_generation, agent = authority.adopted.get(session_id, (None, None))
-    withdraw = getattr(agent, 'withdraw_steer', None) if adopted_generation == generation else None
+    if adopted_generation != generation:
+        agent = None
     for admission_id, delivered in entry[1].items():
-        if delivered and callable(withdraw) and withdraw(admission_id):
+        if delivered and agent is not None and _withdraw(agent, admission_id):
             entry[1][admission_id] = False
     return dict(entry[1])
 
 
+def _withdraw(agent, admission_id):
+    """True when no drain of the turn consumed the transfer: a steer (``withdraw_steer``), or a background
+    result handed over as a notice (``agent.background_notices``)."""
+    from agent.background_notices import withdraw
+    notice = withdraw(agent, admission_id)
+    if notice is not None:
+        return notice
+    withdraw_steer = getattr(agent, 'withdraw_steer', None)
+    return callable(withdraw_steer) and bool(withdraw_steer(admission_id))
+
+
 def _register(authority, session_id, generation, admission_id):
     """``{admission_id: delivered}`` for the claim ``generation``."""
     entry = authority.steer_transfers.get(session_id)
