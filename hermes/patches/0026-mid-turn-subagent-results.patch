@@ -0,0 +1,211 @@
+"""``sessions.mid_turn_subagent_results``: a background subagent's result reaches a running turn.
+
+By default a background ``delegate_task`` result admitted while its session's turn runs waits in the FIFO
+behind that turn, so the agent reads it only after it ends the turn. With the option on, the queued result
+is transferred to the running claim (the ``prompt.steer_queued`` transfer) and rides the turn's next tool
+result. The claim's settlement decides it: ``steered`` once a tool result carried it, back to its queue
+place when none did, where it runs or is noted as before.
+"""
+import asyncio
+from pathlib import Path
+
+import pytest
+
+from agent import background_notices
+from tests.gateway.test_session_end_delegations import _DELEGATION, _admissions, _deliver, _local, _notes
+from tests.gateway.test_unviewed_completion_notes import _human, _target
+from tools import async_delegation as delegation
+
+
+@pytest.fixture(autouse=True)
+def _no_delegations():
+    delegation._reset_for_tests()
+    yield
+    delegation._reset_for_tests()
+
+
+class Agent:
+    def __init__(self, session_id):
+        self.session_id = session_id
+        self.steers = []
+
+    def steer(self, text, ticket=None):
+        self.steers.append(text)
+        return True
+
+    def clear_interrupt(self, *args, **kwargs):
+        pass
+
+
+def _configure(authority, on=True):
+    (Path(authority.db.db_path).parent / 'config.yaml').write_text(
+        f'sessions:\n  mid_turn_subagent_results: {str(on).lower()}\n')
+
+
+def _dispatched_from(session_id, delegation_id=_DELEGATION[1]):
+    delegation._records[delegation_id] = {'delegation_id': delegation_id, 'parent_session_id': session_id,
+                                          'status': 'completed'}
+
+
+class Turn:
+    """The drain's turns: the first adopts ``agent`` (``before_adopt`` runs first) and waits for ``release``."""
+
+    def __init__(self, runner, authority, ref, agent, before_adopt=None):
+        self.seen, self.claimed, self.release = [], asyncio.Event(), asyncio.Event()
+
+        async def handle(event):
+            self.seen.append(event.text)
+            if len(self.seen) == 1:
+                if before_adopt is not None:
+                    await before_adopt()
+                authority.adopt_agent(ref.session_id, authority._handle(ref).execution_generation, agent)
+                self.claimed.set()
+                await asyncio.wait_for(self.release.wait(), 30)
+            return 'ok'
+        runner._handle_message = handle
+
+
+async def _settled(authority):
+    for _ in range(200):
+        tasks = [t for t in getattr(authority, '_mutation_tasks', ()) if not t.done()]
+        if not tasks:
+            return
+        await asyncio.gather(*tasks, return_exceptions=True)
+    raise AssertionError('offer tasks never settled')
+
+
+def _queued(agent):
+    return [text for _ticket, text in background_notices._queued(agent)]
+
+
+def _statuses(authority, ref):
+    return [(r['status'], r['outcome']) for r in _admissions(authority, ref)]
+
+
+async def _running_turn(runner, authority, ref, agent, **kwargs):
+    turn = Turn(runner, authority, ref, agent, **kwargs)
+    _human(authority, ref, 'human', 'FIRST')
+    drain = asyncio.create_task(authority._drain(ref))
+    await asyncio.wait_for(turn.claimed.wait(), 30)
+    return turn, drain
+
+
+@pytest.mark.asyncio
+async def test_a_result_admitted_mid_turn_rides_the_next_tool_result_and_settles_steered(tmp_path, monkeypatch):
+    runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
+    try:
+        _configure(authority)
+        target = _target(runner, authority, ref)
+        _dispatched_from(target)
+        agent = Agent(target)
+        turn, drain = await _running_turn(runner, authority, ref, agent)
+        await _deliver(runner, authority, ref, _DELEGATION)
+        await _settled(authority)
+        assert _queued(agent) == [f'[finished] RESULT_{_DELEGATION[1]}']
+        assert agent.steers == [], 'a subagent result must never take the user steer channel'
+        assert _statuses(authority, ref) == [('terminal', 'steering')]  # handed to the running claim
+
+        message = {'role': 'tool', 'tool_call_id': 'c1', 'content': 'ls output'}
+        background_notices.attach_to_tool_message(agent, message)
+        assert message['content'].startswith('ls output\n\n' + background_notices.NOTICE_LEAD)
+        assert message['content'].endswith(f'RESULT_{_DELEGATION[1]}')
+
+        turn.release.set()
+        await asyncio.wait_for(drain, 30)
+        assert turn.seen == ['FIRST'], 'the transferred result also ran as its own turn'
+        assert _statuses(authority, ref) == [('terminal', 'steered')]
+        assert _notes(authority, target) == []
+    finally:
+        authority.db.close()
+
+
+@pytest.mark.asyncio
+async def test_a_result_no_tool_result_took_goes_back_to_its_queue_place(tmp_path, monkeypatch):
+    """The turn answered without another tool call: the result is withdrawn from the agent and handled after
+    the turn as it is without the option (here, with no viewer, a note)."""
+    runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
+    try:
+        _configure(authority)
+        target = _target(runner, authority, ref)
+        _dispatched_from(target)
+        agent = Agent(target)
+        turn, drain = await _running_turn(runner, authority, ref, agent)
+        await _deliver(runner, authority, ref, _DELEGATION)
+        await _settled(authority)
+        assert len(_queued(agent)) == 1
+
+        turn.release.set()
+        await asyncio.wait_for(drain, 30)
+        assert _queued(agent) == []
+        assert turn.seen == ['FIRST']
+        assert _statuses(authority, ref) == [('terminal', 'completed')]
+        assert len(_notes(authority, target)) == 1
+    finally:
+        authority.db.close()
+
+
+@pytest.mark.asyncio
+async def test_a_result_admitted_before_the_turn_adopts_its_agent_is_offered_at_adoption(tmp_path, monkeypatch):
+    runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
+    try:
+        _configure(authority)
+        target = _target(runner, authority, ref)
+        _dispatched_from(target)
+        agent = Agent(target)
+
+        async def arrive():
+            await _deliver(runner, authority, ref, _DELEGATION)
+            await _settled(authority)
+            assert _statuses(authority, ref) == [('queued', None)]
+        turn, drain = await _running_turn(runner, authority, ref, agent, before_adopt=arrive)
+        await asyncio.sleep(0)
+        await _settled(authority)
+        assert _queued(agent) == [f'[finished] RESULT_{_DELEGATION[1]}']
+        background_notices.attach_to_tool_message(agent, {'role': 'tool', 'tool_call_id': 'c1', 'content': 'x'})
+        turn.release.set()
+        await asyncio.wait_for(drain, 30)
+        assert _statuses(authority, ref) == [('terminal', 'steered')] and turn.seen == ['FIRST']
+    finally:
+        authority.db.close()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('case', ['off', 'other_session', 'unknown_dispatch'])
+async def test_the_result_waits_behind_the_turn_as_before(tmp_path, monkeypatch, case):
+    """Off by default; and never for a result dispatched from another conversation, or one whose dispatch
+    this process does not know (replayed after a restart)."""
+    runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
+    try:
+        if case != 'off':
+            _configure(authority)
+        target = _target(runner, authority, ref)
+        if case != 'unknown_dispatch':
+            _dispatched_from('some-other-session' if case == 'other_session' else target)
+        agent = Agent(target)
+        turn, drain = await _running_turn(runner, authority, ref, agent)
+        await _deliver(runner, authority, ref, _DELEGATION)
+        await _settled(authority)
+        assert _queued(agent) == [] and agent.steers == []
+        assert _statuses(authority, ref) == [('queued', None)]
+        turn.release.set()
+        await asyncio.wait_for(drain, 30)
+        assert _statuses(authority, ref) == [('terminal', 'completed')]
+        assert len(_notes(authority, target)) == 1
+    finally:
+        authority.db.close()
+
+
+def test_notices_settle_by_ticket():
+    class A:
+        pass
+    agent = A()
+    assert background_notices.queue_notice(agent, 'a1', 'one') and background_notices.queue_notice(agent, 'a2', 'two')
+    assert background_notices.withdraw(agent, 'a2') is True  # still queued: taken out
+    message = {'role': 'tool', 'tool_call_id': 't', 'content': [{'type': 'text', 'text': 'out'}]}
+    background_notices.attach_to_tool_message(agent, message)
+    assert message['content'][-1]['text'].endswith('one') and 'two' not in message['content'][-1]['text']
+    assert background_notices.withdraw(agent, 'a1') is False  # a tool result took it
+    assert background_notices.withdraw(agent, 'never') is None
+    spilled = {'role': 'tool', 'tool_call_id': 't', 'content': '[spilled to /x]'}
+    background_notices.keep_after_turn_budget(agent, [spilled])
+    assert spilled['content'].endswith('one')
