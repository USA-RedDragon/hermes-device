diff --git a/tests/agent/test_background_notices_delivery.py b/tests/agent/test_background_notices_delivery.py
new file mode 100644
index 0000000000..410cfb9347
--- /dev/null
+++ b/tests/agent/test_background_notices_delivery.py
@@ -0,0 +1,29 @@
+"""A background result handed to a running turn (``sessions.mid_turn_subagent_results``) rides that turn's
+next tool result, after its content and outside the untrusted-data wrapper, once; never as a user steer."""
+
+from __future__ import annotations
+
+import json
+
+from agent import background_notices
+from tests.agent.test_plugin_live_notes_delivery import TOOL_OUTPUT, _agent, _response, _run, _script
+
+RESULT = "[ASYNC DELEGATION BATCH COMPLETE — deleg_1]\nRESULT_review: no blocking issues"
+
+
+def test_a_result_handed_over_during_a_tool_rides_its_result_once():
+    agent = _agent()
+    requests = _script(agent, _response(tool_call_id="c1"), _response(tool_call_id="c2"), _response("done"))
+    handed = []
+
+    def tool():
+        if not handed:
+            handed.append(background_notices.queue_notice(agent, "adm-1", RESULT))
+        return TOOL_OUTPUT
+
+    _run(agent, "work on it", tool_result=tool)
+    first_row = next(m for m in requests[1] if m.get("role") == "tool")
+    assert first_row["content"].endswith(f"</untrusted_tool_result>\n\n{background_notices.NOTICE_LEAD}\n\n{RESULT}")
+    assert "OUT-OF-BAND USER MESSAGE" not in json.dumps(requests[1])
+    assert json.dumps(requests[2]).count("RESULT_review") == 1
+    assert background_notices.withdraw(agent, "adm-1") is False
