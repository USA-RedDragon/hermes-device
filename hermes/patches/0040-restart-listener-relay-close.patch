diff --git a/tests/gateway/test_restart_listener_relay_close.py b/tests/gateway/test_restart_listener_relay_close.py
new file mode 100644
index 0000000000..083a1b26ba
--- /dev/null
+++ b/tests/gateway/test_restart_listener_relay_close.py
@@ -0,0 +1,164 @@
+"""gateway.restart_listener_relay_close_sockets: a relayed WebSocket still open when the relay window
+ends gets a close frame (1012) between two of the successor's frames instead of a cut connection."""
+import asyncio
+import socket
+
+import pytest
+
+from gateway import listener_relay
+from gateway.config import GatewayConfig
+from gateway.listener_relay import SERVICE_RESTART_CLOSE, _frame_length, _ServerFrames, relay_listener
+
+UPGRADE = b"GET /api/ws HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n"
+SWITCHED = b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n"
+
+
+def _text(payload: bytes) -> bytes:
+    """An unmasked server text frame."""
+    if len(payload) < 126:
+        return bytes([0x81, len(payload)]) + payload
+    return bytes([0x81, 126]) + len(payload).to_bytes(2, "big") + payload
+
+
+def _listening_socket():
+    s = socket.socket()
+    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+    s.bind(("127.0.0.1", 0))
+    s.listen(16)
+    s.setblocking(False)
+    return s
+
+
+def test_off_by_default():
+    assert GatewayConfig().restart_listener_relay_close_sockets is False
+    on = GatewayConfig.from_dict({"restart_listener_relay_close_sockets": True})
+    assert on.restart_listener_relay_close_sockets is True
+
+
+def test_frame_lengths():
+    assert _frame_length(b"\x81") is None
+    assert _frame_length(b"\x81\x05") == 7
+    assert _frame_length(b"\x81\x85") == 11  # masked: 4 key bytes
+    assert _frame_length(b"\x82\x7e\x01") is None
+    assert _frame_length(b"\x82\x7e\x01\x00") == 4 + 256
+    assert _frame_length(b"\x82\x7f" + (70000).to_bytes(8, "big")) == 10 + 70000
+
+
+def test_the_successor_side_is_followed_frame_by_frame():
+    frames = _ServerFrames()
+    frames.feed(SWITCHED[:10])
+    assert frames.websocket is None and not frames.between_frames
+    frames.feed(SWITCHED[10:])
+    assert frames.websocket is True and frames.between_frames
+    big = _text(b"y" * 300)
+    frames.feed(_text(b"hi") + big[:3])  # a whole frame, then part of a header
+    assert not frames.between_frames
+    frames.feed(big[3:50])
+    assert not frames.between_frames
+    frames.feed(big[50:])
+    assert frames.between_frames
+    http = _ServerFrames()
+    http.feed(b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok")
+    assert http.websocket is False and not http.between_frames
+
+
+async def _successor(port, script):
+    async def serve(reader, writer):
+        await reader.readuntil(b"\r\n\r\n")
+        writer.write(SWITCHED)
+        await writer.drain()
+        await script(writer)
+        try:
+            await reader.read()  # until the relay goes away
+        finally:
+            writer.close()
+    return await asyncio.start_server(serve, "127.0.0.1", port)
+
+
+async def _free_port():
+    with socket.socket() as probe:
+        probe.bind(("127.0.0.1", 0))
+        return probe.getsockname()[1]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("close_sockets", [True, False])
+async def test_an_open_socket_gets_a_close_frame_when_the_window_ends(monkeypatch, close_sockets):
+    monkeypatch.setattr(listener_relay, "DRAIN_S", 0.2)
+    target_port = await _free_port()
+
+    async def script(writer):
+        writer.write(_text(b"ready"))
+        await writer.drain()
+
+    successor = await _successor(target_port, script)
+    old = _listening_socket()
+    try:
+        relay = asyncio.ensure_future(relay_listener(old, ("127.0.0.1", target_port), 0.4,
+                                                     close_sockets=close_sockets))
+        reader, writer = await asyncio.open_connection(*old.getsockname())
+        writer.write(UPGRADE)
+        await writer.drain()
+        received = await asyncio.wait_for(reader.read(), 5)
+        writer.close()
+        await asyncio.wait_for(relay, 5)
+    finally:
+        successor.close()
+    assert received.startswith(SWITCHED + _text(b"ready"))
+    tail = received[len(SWITCHED + _text(b"ready")):]
+    assert tail == (SERVICE_RESTART_CLOSE if close_sockets else b"")
+
+
+@pytest.mark.asyncio
+async def test_a_frame_in_flight_is_finished_before_the_close(monkeypatch):
+    monkeypatch.setattr(listener_relay, "DRAIN_S", 0.2)
+    target_port = await _free_port()
+    frame = _text(b"z" * 1000)
+
+    async def script(writer):
+        writer.write(frame[:100])  # half a frame when the window ends
+        await writer.drain()
+        await asyncio.sleep(0.6)
+        writer.write(frame[100:])
+        await writer.drain()
+
+    successor = await _successor(target_port, script)
+    old = _listening_socket()
+    try:
+        relay = asyncio.ensure_future(relay_listener(old, ("127.0.0.1", target_port), 0.3, close_sockets=True))
+        reader, writer = await asyncio.open_connection(*old.getsockname())
+        writer.write(UPGRADE)
+        await writer.drain()
+        received = await asyncio.wait_for(reader.read(), 5)
+        writer.close()
+        await asyncio.wait_for(relay, 5)
+    finally:
+        successor.close()
+    assert received == SWITCHED + frame + SERVICE_RESTART_CLOSE
+
+
+@pytest.mark.asyncio
+async def test_a_plain_http_connection_is_cut_as_before(monkeypatch):
+    monkeypatch.setattr(listener_relay, "DRAIN_S", 0.2)
+    target_port = await _free_port()
+
+    async def serve(reader, writer):
+        await reader.readuntil(b"\r\n\r\n")
+        writer.write(b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok")
+        await writer.drain()
+        await reader.read()
+        writer.close()
+
+    successor = await asyncio.start_server(serve, "127.0.0.1", target_port)
+    old = _listening_socket()
+    try:
+        relay = asyncio.ensure_future(relay_listener(old, ("127.0.0.1", target_port), 0.3, close_sockets=True))
+        reader, writer = await asyncio.open_connection(*old.getsockname())
+        writer.write(b"GET / HTTP/1.1\r\nHost: x\r\n\r\n")
+        await writer.drain()
+        received = await asyncio.wait_for(reader.read(), 5)
+        writer.close()
+        await asyncio.wait_for(relay, 5)
+    finally:
+        successor.close()
+    assert received == b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok"
