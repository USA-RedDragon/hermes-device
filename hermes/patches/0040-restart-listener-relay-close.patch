+# end of the frame the successor is sending when the window ends, before it is cut anyway.
+CLOSE_BOUNDARY_S = 2.0
+# A server's close frame with code 1012 (service restart): the client reconnects, now to the successor.
+SERVICE_RESTART_CLOSE = b"\x88\x02\x03\xf4"
+_HEAD_LIMIT = 65536
 _WILDCARD_HOSTS = {"", "0.0.0.0", "::"}
 
 
