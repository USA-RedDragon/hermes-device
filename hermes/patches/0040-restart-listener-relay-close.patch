-    """Relay one accepted connection to *target*; False when the successor never listened in time."""
+class _ServerFrames:
+    """Follows the successor's side of a relayed connection: its HTTP response head, then, after a
+    ``101`` upgrade, the WebSocket frames (unmasked, RFC 6455 5.2), so the relay knows when it sits
+    between two frames and may add a close frame of its own."""
+
+    def __init__(self):
+        self.head = bytearray()
+        self.websocket: bool | None = None  # None while the head is still arriving
+        self._partial = bytearray()  # the start of a frame whose header is incomplete
+        self._skip = 0  # bytes of the current frame still to come
+
+    @property
+    def between_frames(self) -> bool:
+        return self.websocket is True and self._skip == 0 and not self._partial
+
+    def feed(self, data: bytes) -> None:
+        if self.websocket is None:
+            self.head += data
+            end = self.head.find(b"\r\n\r\n")
+            if end < 0:
+                if len(self.head) > _HEAD_LIMIT:
+                    self.websocket = False
+                return
+            status = bytes(self.head[:self.head.find(b"\r\n")]).split()
+            self.websocket = len(status) > 1 and status[1] == b"101"
+            data = bytes(self.head[end + 4:])
+            self.head.clear()
+        if not self.websocket:
+            return
+        pos = 0
+        while pos < len(data):
+            if self._skip:
+                n = min(self._skip, len(data) - pos)
+                self._skip -= n
+                pos += n
+                continue
+            self._partial += data[pos:]
+            pos = len(data)
+            while self._partial:
+                total = _frame_length(self._partial)
+                if total is None:
+                    break
+                if len(self._partial) >= total:
+                    del self._partial[:total]
+                    continue
+                self._skip = total - len(self._partial)
+                self._partial.clear()
+
+
+def _frame_length(buf) -> int | None:
+    """Header plus payload length of the frame *buf* starts with; None while its header is incomplete."""
+    if len(buf) < 2:
+        return None
+    size = buf[1] & 0x7F
+    header = 2 + (4 if buf[1] & 0x80 else 0)
+    if size == 126:
+        header += 2
+        if len(buf) < 4:
+            return None
+        size = int.from_bytes(buf[2:4], "big")
+    elif size == 127:
+        header += 8
+        if len(buf) < 10:
+            return None
+        size = int.from_bytes(buf[2:10], "big")
+    return header + size
+
+
+async def _pipe_to_client(reader: asyncio.StreamReader, writer: asyncio.StreamWriter,
+                          closing: asyncio.Event) -> None:
+    """The successor-to-client half of a relay that ends a WebSocket cleanly: once *closing* is set it
+    sends the client a close frame (1012) between two frames and stops; other connections are cut."""
+    frames = _ServerFrames()
+    loop = asyncio.get_running_loop()
+    boundary_deadline = None
+    try:
+        while True:
+            if closing.is_set():
+                if frames.between_frames:
+                    writer.write(SERVICE_RESTART_CLOSE)
+                    await writer.drain()
+                    return
+                if frames.websocket is not True:
+                    return
+                boundary_deadline = boundary_deadline or loop.time() + CLOSE_BOUNDARY_S
+                if loop.time() >= boundary_deadline:
+                    return
+            read = asyncio.ensure_future(reader.read(65536))
+            waits = {read}
+            closed = None
+            if not closing.is_set():
+                closed = asyncio.ensure_future(closing.wait())
+                waits.add(closed)
+            done, _ = await asyncio.wait(waits, timeout=None if closed else CLOSE_BOUNDARY_S,
+                                         return_when=asyncio.FIRST_COMPLETED)
+            if closed is not None and not closed.done():
+                closed.cancel()
+            if read not in done:
+                read.cancel()
+                await asyncio.gather(read, return_exceptions=True)
+                continue
+            data = read.result()
+            if not data:
+                if writer.can_write_eof():
+                    writer.write_eof()
+                return
+            writer.write(data)
+            await writer.drain()
+            frames.feed(data)
+    except (OSError, RuntimeError):
+        pass
+
+
+async def _relay_connection(reader, writer, target, connect_deadline: float,
+                            closing: asyncio.Event | None = None) -> bool:
+    """Relay one accepted connection to *target*; False when the successor never listened in time.
+    With *closing*, a relayed WebSocket ends with a close frame once it is set (see :func:`relay_listener`)."""
     loop = asyncio.get_running_loop()
     try:
         while True:
@@ -96,7 +217,16 @@ async def _relay_connection(reader, writer, target, connect_deadline: float) ->
                     return False
                 await asyncio.sleep(CONNECT_RETRY_S)
         try:
-            await asyncio.gather(_pipe(reader, upstream_writer), _pipe(upstream_reader, writer))
+            if closing is None:
+                await asyncio.gather(_pipe(reader, upstream_writer), _pipe(upstream_reader, writer))
+            else:
+                to_upstream = asyncio.ensure_future(_pipe(reader, upstream_writer))
+                to_client = asyncio.ensure_future(_pipe_to_client(upstream_reader, writer, closing))
+                try:
+                    await to_client  # the client's half ends with it: the close was sent, or a side ended
+                finally:
+                    to_upstream.cancel()
+                    await asyncio.gather(to_upstream, return_exceptions=True)
         finally:
             upstream_writer.close()
         return True
