     deadline = loop.time() + seconds
     tasks: set[asyncio.Task] = set()
     counts = [0, 0]
+    closing = asyncio.Event() if close_sockets else None
 
     async def handle(reader, writer):
         task = asyncio.current_task()
         tasks.add(task)
         try:
-            counts[0 if await _relay_connection(reader, writer, target, deadline + DRAIN_S) else 1] += 1
+            counts[0 if await _relay_connection(reader, writer, target, deadline + DRAIN_S, closing) else 1] += 1
         except Exception:
             counts[1] += 1
             logger.debug("Listener relay connection failed", exc_info=True)
@@ -129,8 +266,12 @@ async def relay_listener(sock: socket.socket, target: tuple[str, int], seconds:
         await asyncio.sleep(max(0.0, deadline - loop.time()))
     finally:
         server.close()
+        if closing is not None:
+            closing.set()
         if tasks:
-            _done, pending = await asyncio.wait(set(tasks), timeout=DRAIN_S)
