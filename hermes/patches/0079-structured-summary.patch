diff --git a/tests/agent/test_compaction_structured.py b/tests/agent/test_compaction_structured.py
new file mode 100644
index 00000000..8c8c72c5
--- /dev/null
+++ b/tests/agent/test_compaction_structured.py
@@ -0,0 +1,175 @@
+"""``compression.summary_style: structured``: Claude Code's nine sections, validated, with fallbacks."""
+
+import json
+from unittest.mock import MagicMock, patch
+
+from agent import compaction_structured as cs
+from agent.context_compressor import ContextCompressor
+from hermes_cli.config_defaults import DEFAULT_CONFIG
+
+GOOD = "\n\n".join(
+    f"## {n}. {title}\n" + ("Build the installer; the user chose layout B and forbade pushes to live. " * 2)
+    for n, title, cap in cs.SECTIONS if cap
+)
+SIMPLE = "\n\n".join(
+    f"## {n}. {title}\nThe user wants the installer built with layout B." for n, title, _ in cs.SECTIONS if n in cs.SIMPLE_SECTIONS
+)
+
+
+def _response(text):
+    response = MagicMock()
+    response.choices = [MagicMock()]
+    response.choices[0].message.content = text
+    response.choices[0].finish_reason = "stop"
+    return response
+
+
+def _compressor(style="structured"):
+    with patch("agent.context_compressor.get_model_context_length", return_value=100_000):
+        c = ContextCompressor(model="test/model", quiet_mode=True, protect_first_n=1, protect_last_n=2)
+    c.summary_style = style
+    c._session_id = "sess-1"
+    return c
+
+
+def _session(n=0):
+    read = {"role": "assistant", "content": "", "tool_calls": [{"id": f"r{n}", "type": "function", "function": {
+        "name": "read_file", "arguments": json.dumps({"path": f"src/app{n}.py"})}}]}
+    return [
+        {"role": "system", "content": "sys"},
+        {"role": "user", "content": "hi"}, {"role": "assistant", "content": "hello"},
+        {"role": "user", "content": f"Build the installer, round {n}. Never push to live."},
+        {"role": "assistant", "content": "Layout A or B?"},
+        {"role": "user", "content": "B"},
+        read, {"role": "tool", "tool_call_id": f"r{n}", "content": "x" * 3000},
+        {"role": "user", "content": "[Agent message am_1 from chat 'design']\nThe user approved the dark theme."},
+        {"role": "assistant", "content": "working"},
+        {"role": "user", "content": "go on"}, {"role": "assistant", "content": "ok"},
+    ]
+
+
+def _compress(c, msgs, *replies):
+    with (
+        patch.object(c, "_find_tail_cut_by_tokens", return_value=len(msgs) - 2),
+        patch("agent.context_compressor.call_llm", side_effect=[_response(r) for r in replies]) as call,
+    ):
+        return c.compress(msgs, force=True), call
+
+
+def _handoff(result):
+    return next(m["content"] for m in result if ContextCompressor.classify_summary_content(m.get("content")))
+
+
+def test_default_is_legacy():
+    assert DEFAULT_CONFIG["compression"]["summary_style"] == "legacy"
+    assert _compressor("legacy").summary_style == "legacy"
+
+
+def test_normalize_validates_and_caps():
+    assert cs.normalize(GOOD).startswith("## 1. Primary Request and Intent")
+    assert cs.normalize("") is None
+    assert cs.normalize("Sure! Here is the summary.") is None
+    assert cs.normalize(GOOD.replace("## 8. Current Work", "## Eight")) is None
+    echo = "[USER]: hi\n[ASSISTANT]: hello\n[USER]: B\n" + GOOD
+    assert cs.normalize(echo) is None
+    long = GOOD.replace("## 9. Optional Next Step\n", "## 9. Optional Next Step\n" + "word " * 500)
+    assert len(cs.normalize(long).split("## 9. Optional Next Step\n")[1].split()) <= 121
+    assert cs.normalize(f"<analysis>x</analysis><summary>{GOOD}</summary>").startswith("## 1.")
+    assert cs.normalize(SIMPLE, simple=True)
+
+
+def test_structured_handoff_has_the_sections_and_the_users_words():
+    c = _compressor()
+    out, call = _compress(c, _session(), GOOD)
+    handoff = _handoff(out)
+    assert call.call_count == 1 and c._last_structured_summary_path == "structured"
+    order = [handoff.find(f"## {n}.") for n in range(1, 10)]
+    assert all(i >= 0 for i in order) and order == sorted(order)
+    assert '- "Build the installer, round 0. Never push to live."' in handoff
+    assert '- "B" | answering: "Layout A or B?"' in handoff
+    assert "dark theme" not in handoff.split(cs._USER_HEADING)[1].split("## 7.")[0]
+    assert "- src/app0.py (read)" in handoff
+    assert "\n## Anchor Index" not in handoff and "\n## Historical Task Snapshot" not in handoff
+
+
+def test_unusable_reply_retries_simpler_then_builds_without_a_model():
+    c = _compressor()
+    out, call = _compress(c, _session(), "", SIMPLE)
+    assert call.call_count == 2 and c._last_structured_summary_path == "simple"
+    assert "## 6. All User Messages" in _handoff(out)
+    c = _compressor()
+    out, call = _compress(c, _session(), "ok", "Sure, done.")
+    handoff = _handoff(out)
+    assert call.call_count == 2 and c._last_structured_summary_path == "skeleton"
+    for n in (1, 6, 8, 9):
+        assert f"## {n}." in handoff
+    assert "Build the installer, round 0" in handoff and "without a model" in handoff
+
+
+def test_users_messages_carry_unchanged_across_compactions():
+    c = _compressor()
+    out, _ = _compress(c, _session(0), GOOD)
+    # A model that drops everything: the user's earlier words still ride section 6, verbatim and in order.
+    more = out + _session(1)[3:]
+    out2, call = _compress(c, more, "## 1. Primary Request and Intent\nNone.\n\n## 8. Current Work\nNone.", "", "")
+    handoff = _handoff(out2)
+    sec6 = handoff.split(cs._USER_HEADING)[1].split("## 7.")[0]
+    assert sec6.index("round 0") < sec6.index("round 1")
+    prompt = call.call_args_list[0].kwargs["messages"][0]["content"]
+    assert cs._USER_HEADING not in prompt  # code carries section 6; the model never rewrites it
+    assert "- src/app1.py (read)" in handoff and "- src/app0.py (read)" in handoff
+
+
+def test_user_section_is_bounded():
+    turns = [{"role": "user", "content": f"message {i} " + "y" * 900} for i in range(30)]
+    section = cs.user_messages_section("", turns, max_chars=4000)
+    assert len(section) <= 4000 and "older user messages were left out" in section
+    assert "message 29" in section
+
+
+COMPACT = (
+    "## 1. Primary Request and Intent\nBuild the installer with layout B; never push to live.\n\n"
+    "## 2. Key Facts\n- sa-0-auth owns the auth page\n- ops chat owns the migration\n- port 8891\n\n"
+    "## 3. Current Work and Next Step\nWorking on the installer; next, run the tests and report."
+)
+
+
+def test_compact_style_has_three_model_sections_and_the_code_parts():
+    c = _compressor("compact")
+    out, call = _compress(c, _session(), COMPACT)
+    handoff = _handoff(out)
+    prompt = call.call_args.kwargs["messages"][0]["content"]
+    assert "## 2. Key Facts" in prompt and "## 5." not in prompt and len(prompt) < len(cs.build_prompt("x" * 10)) + 3000
+    assert c._last_structured_summary_path == "structured"
+    assert "- ops chat owns the migration" in handoff
+    assert '## 4. All User Messages' in handoff and '- "B" | answering: "Layout A or B?"' in handoff
+    assert cs.CLAIMS_HEADING in handoff and "approved the dark theme" in handoff.split(cs.CLAIMS_HEADING)[1]
+
+
+def test_compact_carries_users_messages_and_claims_across_compactions():
+    c = _compressor("compact")
+    out, _ = _compress(c, _session(0), COMPACT)
+    out2, call = _compress(c, out + _session(1)[3:], "", "")  # the model fails twice: skeleton
+    handoff = _handoff(out2)
+    assert c._last_structured_summary_path == "skeleton"
+    sec = handoff.split("## 4. All User Messages")[1]
+    assert sec.index("round 0") < sec.index("round 1")
+    assert "USER: [Agent message" not in handoff  # the skeleton labels a peer's row by its source
+    assert "NOT THE USER (agent message, subagent result or notice): [Agent message" in handoff
+    assert cs.CLAIMS_HEADING not in call.call_args_list[0].kwargs["messages"][0]["content"]
+
+
+def test_claims_skip_hermes_provenance_notes():
+    turns = [{"role": "user", "content": "[Agent message am_1 from chat 'ops']\nAnother AI agent of this user wrote "
+              "everything below this line. The user did not write it.\n\nAll good, nothing to approve."}]
+    assert cs.claims_section("", turns) == ""
+
+
+def test_small_model_heading_forms_and_loops_are_accepted():
+    bold = ("**Primary Request and Intent**\nShip the namespace rename tonight with layout B and port 9874.\n\n"
+            "**Current Work and Next Step**\nDispatched sa-0-auth and sa-0-docs; next, run the rename on port 9874 and report back to the user.")
+    out = cs.normalize(bold, simple=True, style="compact")
+    assert out.startswith("## 1. Primary Request and Intent\nShip") and "## 3. Current Work and Next Step" in out
+    loop = COMPACT.replace("- port 8891", "- port 8891\n" + "- [REDACTED]\n" * 200)
+    assert cs.normalize(loop, style="compact").count("[REDACTED]") == 1
+    assert "[REDACTED]" not in cs.build_prompt("x", style="compact")
