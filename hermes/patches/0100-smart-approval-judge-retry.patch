+"""Smart approval (provenance) retries a judge call the provider could not serve, and never allows on failure.
+
+Invariants:
+  1. A judge call that fails for a provider limit (429, plan limit, "hit your limit", every pool account at its
+     limit) or a transient error (timeout, overloaded, 5xx, connection) is tried again before the user is asked:
+     once more on the same route (the account pool moves to its next account), then, for stage 2, on the other
+     stage's route. The verdict is the retry's.
+  2. Every pool account at its limit skips the same-route retry (the pool already tried them all); a route that
+     already failed this way in the same review is not tried again; a self-hosted route never stands in for a
+     hosted stage-2 judge.
+  3. When every route fails, the verdict is unsure (the user is asked) and the card says plainly that the reviewer
+     was unavailable, with no exception class, upstream text or request id.
+  4. Any other failure is not retried and its card names no exception class.
+"""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+
+from tools import approval_automode as A
+
+BLOCK = "<block>yes</block><category>Git Destructive</category><reason>[Git Destructive] it rewrites main</reason>"
+
+
+class PoolExhausted(RuntimeError):
+    """Same class name as the claude-accounts pool's."""
+
+
+class ClaudeAPIError(RuntimeError):
+    pass
+
+
+LIMIT = ClaudeAPIError("You've hit your limit · resets 3pm (America/Chicago) request_id=req_011CabcDEF")
+
+
+@pytest.fixture()
+def judge(monkeypatch):
+    """Route stage -> list of results (an exception to raise or a reply), consumed in order."""
+    calls = []
+    script: dict[int, list] = {1: [], 2: []}
+
+    def complete(stage, system, user, max_tokens):
+        calls.append({"route": stage, "prompt": 2 if system.endswith(A.STAGE2_SUFFIX) else 1})
+        result = script[stage].pop(0) if script[stage] else "<block>no</block>"
+        if isinstance(result, BaseException):
+            raise result
+        return result
+
+    monkeypatch.setattr(A, "_self_hosted_judge", lambda stage: False)
+    A.set_complete_override(complete)
+    yield script, calls
+    A.set_complete_override(None)
+
+
+def _review(skip=""):
+    return A.review_input(A.ReviewInput(lines=["User: push my branch"], action="{}", skip_stage1=skip))
+
+
+def _routes(calls):
+    return [(c["route"], c["prompt"]) for c in calls]
+
+
+def _plain(card: str) -> None:
+    assert card.startswith("Smart approval could not review this: the review model was unavailable (")
+    assert card.endswith("Approve or deny it yourself.")
+    for raw in ("ClaudeAPIError", "PoolExhausted", "TimeoutError", "req_", "request_id", "hit your limit"):
+        assert raw not in card
+
+
+def test_stage2_limit_retries_same_route_and_uses_its_verdict(judge):
+    script, calls = judge
+    script[1] = ["<block>yes</block>"]
+    script[2] = [LIMIT, BLOCK]
+    v = _review()
+    assert _routes(calls) == [(1, 1), (2, 2), (2, 2)]
+    assert v.decision == "block" and v.rule == "Git Destructive"
+
+
+def test_stage2_limit_twice_falls_back_to_the_other_stage_route(judge):
+    script, calls = judge
+    script[1] = ["<block>yes</block>", BLOCK]
+    script[2] = [LIMIT, LIMIT]
+    v = _review()
+    # The fallback runs the stage-2 prompt on stage 1's route; its verdict is the stage-2 verdict.
+    assert _routes(calls) == [(1, 1), (2, 2), (2, 2), (1, 2)]
+    assert v.decision == "block" and v.rule == "Git Destructive" and v.stage == 2
+    assert v.detail.get("stage2_route") == 1
+
+
+def test_stage2_timeout_goes_to_the_other_route_and_its_allow_stands(judge):
+    script, calls = judge
+    # A timeout already cost a whole window (and call_llm retried it), so the same route is not tried again.
+    script[2] = [TimeoutError("read timed out")]
+    script[1] = ["<block>yes</block>", "<block>no</block>"]
+    v = _review()
+    assert _routes(calls) == [(1, 1), (2, 2), (1, 2)]
+    assert v.decision == "allow" and v.stage == 2
+
+
+def test_stage1_limit_retries_then_runs_stage2(judge):
+    script, calls = judge
+    script[1] = [LIMIT, LIMIT]
+    script[2] = [BLOCK]
+    v = _review()
+    assert _routes(calls) == [(1, 1), (1, 1), (2, 2)]
+    assert v.decision == "block"
+
+
+def test_stage1_retry_answer_counts(judge):
+    script, calls = judge
+    script[1] = [RuntimeError("API Error: 529 Overloaded"), "<block>no</block>"]
+    v = _review()
+    assert _routes(calls) == [(1, 1), (1, 1)]
+    assert v.decision == "allow" and v.stage == 1
+
+
+def test_all_routes_at_limit_asks_with_the_plain_card(judge):
+    script, calls = judge
+    script[1] = [LIMIT, LIMIT]
+    script[2] = [LIMIT, LIMIT]
+    v = _review()
+    # Stage 1's route already failed this review, so stage 2 does not fall back onto it.
+    assert _routes(calls) == [(1, 1), (1, 1), (2, 2), (2, 2)]
+    assert v.decision == "unsure" and v.stage == 2
+    _plain(v.card_text)
+    assert "usage limit" in v.card_text
+
+
+def test_skipped_stage1_failure_on_all_routes_asks(judge):
+    script, calls = judge
+    script[1] = [LIMIT]
+    script[2] = [LIMIT, LIMIT]
+    v = _review(skip="runs code fetched this session")
+    assert _routes(calls) == [(2, 2), (2, 2), (1, 2)]
+    assert v.decision == "unsure"
+    _plain(v.card_text)
+
+
+def test_pool_exhausted_skips_same_route_retry_and_names_the_pool(judge):
+    script, calls = judge
+    full = PoolExhausted("All Claude accounts are at their limit. The first frees up at 10:09 PM CST.")
+    script[1] = [full, full]
+    script[2] = [full, full]
+    v = _review(skip="runs code fetched this session")
+    assert _routes(calls) == [(2, 2), (1, 2)]
+    assert v.decision == "unsure"
+    _plain(v.card_text)
+    assert v.card_text == ("Smart approval could not review this: the review model was unavailable (all Claude "
+                           "accounts are at their limit; the first frees up at 10:09 PM CST). Approve or deny it "
+                           "yourself.")
+
+
+def test_wrapped_pool_exhausted_is_recognised(judge):
+    script, calls = judge
+    try:
+        raise PoolExhausted("All Claude accounts are at their limit.")
+    except PoolExhausted as inner:
+        wrapped = RuntimeError("auxiliary call failed")
+        wrapped.__cause__ = inner
+    script[1] = [wrapped]
+    script[2] = [wrapped]
+    v = _review()
+    assert _routes(calls) == [(1, 1), (2, 2)]
+    assert v.decision == "unsure" and "all Claude accounts are at their limit)" in v.card_text
+
+
+def test_transient_failure_on_all_routes_says_unavailable(judge):
+    script, calls = judge
+    script[1] = [TimeoutError("read timed out")]
+    script[2] = [ConnectionError("Connection reset by peer")] * 2
+    v = _review()
+    assert _routes(calls) == [(1, 1), (2, 2), (2, 2)]
+    assert v.decision == "unsure"
+    _plain(v.card_text)
+
+
+@pytest.mark.parametrize("exc", [ValueError("bad"), ClaudeAPIError("invalid x-api-key")])
+def test_other_failures_are_not_retried_and_name_no_class(judge, exc):
+    script, calls = judge
+    script[1] = ["<block>yes</block>"]
+    script[2] = [exc]
+    v = _review()
+    assert _routes(calls) == [(1, 1), (2, 2)]
+    assert v.decision == "unsure"
+    assert type(exc).__name__ not in v.card_text and "invalid" not in v.card_text
+    assert v.card_text == "Smart approval could not decide (the review model call failed)"
+
+
+def test_no_fallback_onto_a_self_hosted_route(judge, monkeypatch):
+    script, calls = judge
+    monkeypatch.setattr(A, "_self_hosted_judge", lambda stage: stage == 1)
+    script[1] = ["<block>yes</block>", "<block>no</block>"]
+    script[2] = [LIMIT, LIMIT]
+    v = _review()
+    assert _routes(calls) == [(1, 1), (2, 2), (2, 2)]
+    assert v.decision == "unsure"
+    _plain(v.card_text)
+
+
+def test_window_error_is_not_retried(judge):
+    script, calls = judge
+    script[1] = ["<block>yes</block>"]
+    script[2] = [A.JudgeWindowError("the stage-2 review prompt does not fit")]
+    v = _review()
+    assert _routes(calls) == [(1, 1), (2, 2)]
+    assert v.decision == "unsure" and v.detail.get("window")
+
+
+@pytest.mark.parametrize("exc,kind", [
+    (LIMIT, "limit"),
+    (ClaudeAPIError("Claude AI usage limit reached|1700000000"), "limit"),
+    (type("RateLimitError", (Exception,), {"status_code": 429})("slow down"), "limit"),
+    (PoolExhausted("No Claude account is signed in."), "pool"),
+    (RuntimeError("API Error: 529 Overloaded"), "transient"),
+    (TimeoutError("read timed out"), "timeout"),
+    (ClaudeAPIError("request timed out"), "timeout"),
+    (ConnectionError("Connection reset by peer"), "transient"),
+    (ValueError("bad answer"), ""),
+    (ClaudeAPIError("invalid x-api-key"), ""),
+])
+def test_unavailable_kind(exc, kind):
+    assert A._unavailable_kind(exc) == kind
+
+
+def test_real_route_fallback_calls_the_other_stage_model(monkeypatch):
+    """Without an override, the fallback calls call_llm with the other stage's configured route."""
+    import agent.auxiliary_client as aux
+
+    models = []
+
+    def call_llm(**kwargs):
+        models.append((kwargs.get("model"), kwargs["messages"][0]["content"].endswith(A.STAGE2_SUFFIX)))
+        if kwargs.get("model") == "claude-sonnet-4-6":
+            raise LIMIT
+        reply = "<block>yes</block>" if not models[-1][1] else BLOCK
+        return SimpleNamespace(choices=[SimpleNamespace(message=SimpleNamespace(content=reply))], usage=None)
+
+    monkeypatch.setattr(aux, "call_llm", call_llm)
+    monkeypatch.setattr(A, "_config", lambda: {"smart_fast_model": "claude-haiku-4-5", "smart_model": "claude-sonnet-4-6"})
+    monkeypatch.setattr(A, "_served_window", lambda route: None)
+    A.set_complete_override(None)
+    v = _review()
+    assert models == [("claude-haiku-4-5", False), ("claude-sonnet-4-6", True), ("claude-sonnet-4-6", True),
+                      ("claude-haiku-4-5", True)]
+    assert v.decision == "block" and v.detail.get("stage2_route") == 1
