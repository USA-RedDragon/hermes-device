+# --- a judge the provider could not serve -----------------------------------------------------------------
+
+_LIMIT_REASONS = frozenset({"rate_limit", "upstream_rate_limit", "billing"})
+_TRANSIENT_REASONS = frozenset({"timeout", "overloaded", "server_error"})
+_LIMIT_TEXT = re.compile(r"hit your (?:\w+ )*limit|usage limit|rate.?limit|limit reached|out of (?:extra )?usage|"
+                         r"quota|too many requests|\b429\b", re.I)
+_TIMEOUT_TEXT = re.compile(r"timed? ?out|timeout", re.I)
+_CONNECTION_TEXT = re.compile(r"connection (?:error|reset|refused|aborted|closed)|\boverloaded\b|"
+                              r"\b(?:500|502|503|504|529)\b", re.I)
+# What the card says per kind; a PoolExhausted's own message (the pool's plain words) is used when it has one.
+_UNAVAILABLE_WORDS = {"pool": "all Claude accounts are at their limit", "limit": "it is at its usage limit",
+                      "timeout": "it did not answer in time",
+                      "transient": "the provider was overloaded or could not be reached"}
+_UNAVAILABLE_RANK = ("pool", "limit", "transient", "timeout")
+
+
+class JudgeUnavailable(RuntimeError):
+    """Every route tried for a judge call failed for a provider limit or a transient error."""
+
+    def __init__(self, kind: str, words: str):
+        super().__init__(words)
+        self.kind, self.words = kind, words
+
+
+def _chain(exc: BaseException):
+    seen = set()
+    while exc is not None and id(exc) not in seen:
+        seen.add(id(exc))
+        yield exc
+        exc = exc.__cause__ or exc.__context__
+
+
+def _unavailable_kind(exc: BaseException) -> str:
+    """"pool" (every pool account at its limit), "limit" (429, plan or usage limit), "timeout", "transient"
+    (overloaded, 5xx, connection) or "" for any other failure, which is not retried."""
+    if isinstance(exc, (JudgeWindowError, JudgeUnavailable)):
+        return ""
+    for link in _chain(exc):
+        if type(link).__name__ == "PoolExhausted":
+            return "pool"
+    reason = ""
+    try:
+        from agent.error_classifier import classify_api_error
+        reason = classify_api_error(exc).reason.value
+    except Exception as err:  # the classifier must not turn a failed review into anything but an ask
+        logger.debug("Smart approval (provenance): judge error unclassified (%s)", err)
+    text = " ".join(str(link) for link in _chain(exc))[:2000]
+    if reason in _LIMIT_REASONS or _LIMIT_TEXT.search(text):
+        return "limit"
+    if any(isinstance(link, TimeoutError) or "Timeout" in type(link).__name__ for link in _chain(exc)):
+        return "timeout"
+    if any(isinstance(link, ConnectionError) or "Connection" in type(link).__name__ for link in _chain(exc)):
+        return "transient"
+    if reason in _TRANSIENT_REASONS:
+        return "timeout" if _TIMEOUT_TEXT.search(text) else "transient"
+    if _TIMEOUT_TEXT.search(text):
+        return "timeout"
+    return "transient" if _CONNECTION_TEXT.search(text) else ""
+
+
+def _unavailable_words(kind: str, exc: BaseException) -> str:
+    if kind == "pool":
+        link = next((e for e in _chain(exc) if type(e).__name__ == "PoolExhausted"), None)
+        own = str(link or "").strip().rstrip(".")
+        if own and len(own) < 160 and own.lower().startswith(("all claude accounts", "no claude account")):
+            # The pool's line is two sentences ("... at their limit. The first frees up at 10:09 PM CST."); in
+            # the card's brackets it reads as one.
+            own = own.replace(". The first", "; the first").replace(". Sign", "; sign")
+            return own[0].lower() + own[1:]
+    return _UNAVAILABLE_WORDS[kind]
+
+
+def _routes_differ() -> bool:
+    if _complete_override is not None:
+        return True
+    return _stage_route(1) != _stage_route(2)
+
+
+def _judge(stage: int, system: str, user: str, max_tokens: int, down: dict, *,
+           fixed: int | None = None) -> tuple[str, int]:
+    """(reply, route) of one judge call that the provider failing does not end at once: the same route once more
+    (the account pool moves to its next account; skipped after a timeout, which already cost a whole window and
+    call_llm's own retries, and when every pool account is at its limit), then for stage 2 the stage-1 route,
+    unless that route already failed this review, is the same model, or is self-hosted while stage 2 is hosted.
+    ``down`` records failed routes across the review. Raises JudgeUnavailable when every route failed; any other
+    error propagates untried (the review asks)."""
+    failures: list[tuple[str, BaseException]] = []
+
+    def attempt(route: int) -> str | None:
+        try:
+            return _complete(route, system, user, max_tokens)
+        except Exception as exc:
+            kind = _unavailable_kind(exc)
+            if not kind:
+                raise
+            logger.warning("Smart approval (provenance): stage-%d judge unavailable on the stage-%d route (%s; %s: "
+                           "%s)", stage, route, kind, type(exc).__name__, str(exc)[:300])
+            down[route] = kind
+            failures.append((kind, exc))
+            return None
+
+    own = stage if fixed is None else fixed
+    reply = attempt(own)
+    if reply is None and fixed is None and down[own] not in ("pool", "timeout"):
+        reply = attempt(own)  # the same model again; the pool picks its next account
+    if reply is None and fixed is None and stage == 2 and 1 not in down and _routes_differ() \
+            and not (_self_hosted_judge(1) and not _self_hosted_judge(2)):
+        own = 1
+        reply = attempt(1)
+    if reply is not None:
+        return reply, own
+    kind, exc = min(failures, key=lambda f: _UNAVAILABLE_RANK.index(f[0]))
+    raise JudgeUnavailable(kind, _unavailable_words(kind, exc))
+
+
 def _window_verdict(exc: JudgeWindowError, stage1_ms: int = 0, stage2_ms: int = 0) -> Verdict:
     logger.warning("Smart approval (provenance): asking the user: %s", exc)
     return Verdict("unsure", reason=str(exc), stage=2 if stage2_ms else 1, stage1_ms=stage1_ms, stage2_ms=stage2_ms,
