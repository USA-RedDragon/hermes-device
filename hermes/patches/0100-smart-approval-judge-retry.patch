-            first = parse_stage1(_complete(1, system_prompt(1), user, STAGE1_MAX_TOKENS))
+            first = parse_stage1(_judge(1, system_prompt(1), user, STAGE1_MAX_TOKENS, down)[0])
             if first is None:
                 logger.info("Smart approval (provenance): stage 1 answer had no verdict; retrying once")
-                first = parse_stage1(_complete(1, system_prompt(1), user + STAGE1_RETRY, STAGE1_MAX_TOKENS))
+                first = parse_stage1(_judge(1, system_prompt(1), user + STAGE1_RETRY, STAGE1_MAX_TOKENS, down,
+                                            fixed=1)[0])
         except JudgeWindowError as exc:
             logger.warning("Smart approval (provenance): stage 1 cannot run (%s); running stage 2", exc)
         except Exception as exc:
@@ -1044,19 +1166,27 @@ def review_input(review: ReviewInput) -> Verdict:
     if first == "allow":
         return Verdict("allow", stage=1, stage1_ms=stage1_ms)
     t1 = time.monotonic()
+    route = 2
     try:
-        verdict = parse_stage2(_complete(2, system_prompt(2), user, STAGE2_MAX_TOKENS))
+        reply, route = _judge(2, system_prompt(2), user, STAGE2_MAX_TOKENS, down)
+        verdict = parse_stage2(reply)
         if verdict.detail.get("no_verdict"):
             logger.info("Smart approval (provenance): stage 2 answer had no verdict; retrying once")
-            verdict = parse_stage2(_complete(2, system_prompt(2), user + STAGE2_RETRY, STAGE2_MAX_TOKENS))
+            verdict = parse_stage2(_judge(2, system_prompt(2), user + STAGE2_RETRY, STAGE2_MAX_TOKENS, down,
+                                          fixed=route)[0])
     except JudgeWindowError as exc:
         return _window_verdict(exc, stage1_ms, max(1, int((time.monotonic() - t1) * 1000)))
+    except JudgeUnavailable as exc:
+        logger.warning("Smart approval (provenance): no review model could answer (%s); asking the user", exc.kind)
+        verdict = Verdict("unsure", reason=exc.words, stage=2, detail={"unavailable": exc.kind})
     except Exception as exc:
         logger.warning("Smart approval (provenance) stage 2 failed (%s: %s)", type(exc).__name__, exc)
-        verdict = Verdict("unsure", reason=f"the review model call failed: {type(exc).__name__}", stage=2)
+        verdict = Verdict("unsure", reason="the review model call failed", stage=2)
+    if route != 2:
+        verdict.detail["stage2_route"] = route
     # A local judge's allow does not clear an action stage 1 was skipped for: one in a session fetch, or one an
     # upstream dangerous-command pattern flags (qwen3-coder:30b allowed an injected force push to main).
-    if verdict.decision == "allow" and review.skip_stage1 and _self_hosted_judge(2):
+    if verdict.decision == "allow" and review.skip_stage1 and _self_hosted_judge(route):
         logger.warning("Smart approval (provenance): a self-hosted stage-2 judge allowed an action that %s; asking",
                        review.skip_stage1)
         verdict = Verdict("unsure", stage=2, reason=f"a local review model cannot clear an action that {review.skip_stage1}")
