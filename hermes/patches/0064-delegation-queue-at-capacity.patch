+"""delegation.at_capacity: queue -- a background call the full pool cannot take is queued, not run in the turn."""
+
+from __future__ import annotations
+
+import json
+import queue
+import threading
+import time
+
+import pytest
+
+from agent.interrupt_control import InterruptControlMixin
+from tools import async_delegation
+from tools.delegate_tool_dispatch import _Batch, _dispatch_background
+from tools.delegate_tool_registry import list_active_subagents, interrupt_subagent, steer_subagent
+from tools.process_registry import process_registry
+
+
+CHAT_A = "capacity-queue-parent"
+
+
+class _Parent(InterruptControlMixin):
+    def __init__(self, session_id=CHAT_A):
+        self.session_id = session_id
+        self._active_children = []
+        self._active_children_lock = threading.Lock()
+        self._execution_thread_id = None
+        self._interrupt_requested = False
+        self._hard_interrupt_requested = threading.Event()
+        self.quiet_mode = True
+
+
+class _Child(_Parent):
+    def __init__(self, n):
+        super().__init__()
+        self.session_id = f"capacity-queue-child-{n}"
+        self._subagent_id = f"sa-queued-{n}"
+        self._delegate_role = "leaf"
+        self._delegate_depth = 1
+        self._delegate_saved_tool_names = []
+        self._credential_pool = None
+        self.tool_progress_callback = None
+        self.model = "test-model"
+        self.started = threading.Event()
+        self.user_message = None
+        self.close_count = 0
+
+    def run_conversation(self, user_message=None, **_kwargs):
+        self.user_message = user_message
+        self.started.set()
+        return {"final_response": "ran", "completed": True, "interrupted": False, "api_calls": 1, "messages": []}
+
+    def get_activity_summary(self):
+        return {"api_call_count": 0}
+
+    def close(self):
+        self.close_count += 1
+
+
+def _batch(parent, child):
+    tasks = [{"goal": "work that must not run in the parent's turn"}]
+    parent._active_children.append(child)
+    return _Batch(
+        task_list=tasks, children=[(0, tasks[0], child)], parent_agent=parent, creds={"model": child.model},
+        context=None, top_role="leaf", max_children=1, live_deleg_id=None, live_writers=[], live_paths=[],
+        origin_wake_sid="", origin_ui_session_id="", origin_owner_transport=None, origin_owner_session_record=None,
+        origin_session_history_delivery=False, overall_start=time.monotonic(),
+    )
+
+
+@pytest.fixture
+def full_pool(tmp_path, monkeypatch):
+    """Chat A's one slot, held by one of its delegations until ``release`` is set."""
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.delenv("HERMES_IGNORE_USER_CONFIG", raising=False)
+    async_delegation._reset_for_tests()
+    completions = queue.Queue()
+    monkeypatch.setattr(process_registry, "completion_queue", completions)
+    release, occupied = threading.Event(), threading.Event()
+
+    def occupy_slot():
+        occupied.set()
+        assert release.wait(30)
+        return {"status": "completed", "summary": "slot released"}
+
+    accepted = async_delegation.dispatch_async_delegation(
+        goal="occupy the only slot", context=None, toolsets=None, role="leaf", model="test-model",
+        session_key=CHAT_A, runner=occupy_slot, max_async_children=1,
+    )
+    assert accepted["status"] == "dispatched"
+    assert occupied.wait(5)
+    yield tmp_path, release, completions, accepted["delegation_id"]
+    release.set()
+    if async_delegation._executor is not None:
+        async_delegation._executor.shutdown(wait=True)
+    async_delegation._reset_for_tests()
+
+
+def _config(home, at_capacity, per_chat=1, total=None):
+    line = f"  at_capacity: {at_capacity}\n" if at_capacity else ""
+    line += f"  max_concurrent_children_total: {total}\n" if total is not None else ""
+    (home / "config.yaml").write_text(
+        f"delegation:\n  max_concurrent_children: {per_chat}\n  worktree_isolation: false\n" + line, encoding="utf-8")
+
+
+def _completion_for(completions, delegation_id):
+    while True:
+        event = completions.get(timeout=10)
+        if event["delegation_id"] == delegation_id:
+            return event
+
+
+def test_queued_dispatch_returns_at_once_and_runs_when_a_slot_frees(full_pool):
+    home, release, completions, occupier = full_pool
+    _config(home, "queue")
+    parent, child = _Parent(), _Child(1)
+    started = time.monotonic()
+    result = json.loads(_dispatch_background(_batch(parent, child)))
+    assert time.monotonic() - started < 5
+    assert result["status"] == "queued"
+    assert result["queued_units"] == [result["delegation_id"]]
+    assert "QUEUED" in result["note"] and "per chat" in result["note"]
+    assert result["subagent_ids"] == ["sa-queued-1"]
+    assert not child.started.is_set()
+    listed = {r["delegation_id"]: r for r in async_delegation.list_async_delegations()}
+    assert listed[result["delegation_id"]]["status"] == "queued"
+    assert listed[result["delegation_id"]]["queue_position"] == 1
+    assert [r["status"] for r in list_active_subagents() if r["subagent_id"] == "sa-queued-1"] == ["queued"]
+
+    release.set()
+    assert _completion_for(completions, occupier)["status"] == "completed"
+    assert child.started.wait(10)
+    event = _completion_for(completions, result["delegation_id"])
+    assert event["results"][0]["status"] == "completed"
+    assert child.user_message == "work that must not run in the parent's turn"
+
+
+def test_steer_while_queued_joins_the_goal(full_pool):
+    home, release, completions, _ = full_pool
+    _config(home, "queue")
+    parent, child = _Parent(), _Child(2)
+    result = json.loads(_dispatch_background(_batch(parent, child)))
+    assert result["status"] == "queued"
+    assert steer_subagent("sa-queued-2", "use the staging cluster")
+    release.set()
+    _completion_for(completions, result["delegation_id"])
+    assert "use the staging cluster" in child.user_message
+    assert child.user_message.startswith("work that must not run in the parent's turn")
+
+
+def test_stop_while_queued_settles_without_running(full_pool):
+    home, release, completions, _ = full_pool
+    _config(home, "queue")
+    parent, child = _Parent(), _Child(3)
+    result = json.loads(_dispatch_background(_batch(parent, child)))
+    assert result["status"] == "queued"
+    assert interrupt_subagent("sa-queued-3")
+    event = _completion_for(completions, result["delegation_id"])  # before the slot frees
+    assert event["results"][0]["status"] == "interrupted"
+    assert not child.started.is_set()
+    assert child.close_count == 1
+    assert not [r for r in list_active_subagents() if r["subagent_id"] == "sa-queued-3"]
+
+
+def test_session_interrupt_reaches_queued_units(full_pool):
+    home, release, completions, _ = full_pool
+    _config(home, "queue")
+    parent, child = _Parent(), _Child(4)
+    result = json.loads(_dispatch_background(_batch(parent, child)))
+    assert async_delegation.interrupt_for_session(parent_session_id=parent.session_id) == 1
+    event = _completion_for(completions, result["delegation_id"])
+    assert event["results"][0]["status"] == "interrupted"
+    assert not child.started.is_set()
+
+
+def test_queue_is_first_in_first_out(full_pool):
+    home, release, completions, _ = full_pool
+    _config(home, "queue")
+    parent = _Parent()
+    first, second = _Child(5), _Child(6)
+    order = []
+    for child in (first, second):
+        original = child.run_conversation
+
+        def run(original=original, child=child, **kwargs):
+            order.append(child._subagent_id)
+            return original(**kwargs)
+
+        child.run_conversation = run
+    a = json.loads(_dispatch_background(_batch(parent, first)))
+    b = json.loads(_dispatch_background(_batch(parent, second)))
+    assert (a["status"], b["status"]) == ("queued", "queued")
+    positions = {r["delegation_id"]: r.get("queue_position") for r in async_delegation.list_async_delegations()}
+    assert (positions[a["delegation_id"]], positions[b["delegation_id"]]) == (1, 2)
+    release.set()
+    _completion_for(completions, b["delegation_id"])
+    assert order == ["sa-queued-5", "sa-queued-6"]
+
+
+@pytest.mark.parametrize("at_capacity", [None, "sync"])
+def test_default_still_runs_the_call_in_the_turn(full_pool, at_capacity):
+    home, *_ = full_pool
+    _config(home, at_capacity)
+    parent, child = _Parent(), _Child(7)
+    result = json.loads(_dispatch_background(_batch(parent, child)))
+    assert child.started.is_set()
+    assert "SYNCHRONOUSLY" in result["note"]
+    assert result["results"][0]["status"] == "completed"
+
+
+def test_a_full_chat_does_not_block_another_chat(full_pool):
+    home, *_ = full_pool
+    _config(home, "queue")
+    parent, child = _Parent("capacity-queue-chat-b"), _Child(8)
+    result = json.loads(_dispatch_background(_batch(parent, child)))
+    assert result["status"] == "dispatched"
+    assert child.started.wait(10)
+
+
+def test_ten_running_in_one_chat_block_only_its_eleventh(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.delenv("HERMES_IGNORE_USER_CONFIG", raising=False)
+    async_delegation._reset_for_tests()
+    completions = queue.Queue()
+    monkeypatch.setattr(process_registry, "completion_queue", completions)
+    _config(tmp_path, "queue", per_chat=10)
+    releases = [threading.Event() for _ in range(10)]
+    ids = []
+    try:
+        for release in releases:
+            handle = async_delegation.dispatch_async_delegation(
+                goal="chat A work", context=None, toolsets=None, role="leaf", model="test-model",
+                session_key=CHAT_A, runner=lambda r=release: r.wait(30) and {"status": "completed", "summary": "ok"},
+                max_async_children=10)
+            assert handle["status"] == "dispatched"
+            ids.append(handle["delegation_id"])
+
+        other, other_child = _Parent("capacity-queue-chat-b"), _Child(9)
+        assert json.loads(_dispatch_background(_batch(other, other_child)))["status"] == "dispatched"
+        assert other_child.started.wait(10)
+
+        parent, eleventh = _Parent(), _Child(10)
+        started = time.monotonic()
+        result = json.loads(_dispatch_background(_batch(parent, eleventh)))
+        assert time.monotonic() - started < 5
+        assert result["status"] == "queued"
+        assert "this chat already runs 10" in result["note"]
+        assert not eleventh.started.is_set()
+
+        releases[3].set()
+        assert _completion_for(completions, ids[3])["status"] == "completed"
+        assert eleventh.started.wait(10)
+        assert _completion_for(completions, result["delegation_id"])["results"][0]["status"] == "completed"
+    finally:
+        for release in releases:
+            release.set()
+        if async_delegation._executor is not None:
+            async_delegation._executor.shutdown(wait=True)
+        async_delegation._reset_for_tests()
+
+
+def test_process_cap_queues_across_chats(full_pool):
+    home, release, completions, _ = full_pool
+    _config(home, "queue", per_chat=5, total=1)
+    parent, child = _Parent("capacity-queue-chat-b"), _Child(11)
+    result = json.loads(_dispatch_background(_batch(parent, child)))
+    assert result["status"] == "queued"
+    assert "delegation.max_concurrent_children_total" in result["note"]
+    assert not child.started.is_set()
+    release.set()
+    assert _completion_for(completions, result["delegation_id"])["results"][0]["status"] == "completed"
