+def _chat_of(record: dict[str, Any]) -> str:
+    """The chat a unit counts against under ``delegation.at_capacity: queue``: its routing key (stable across the
+    chat's compression rotations), else the dispatching session. Only top-level delegations reach this pool (a
+    subagent's own children run inside it), so a chat's whole spawn tree counts here through its root."""
+    return str(record.get("session_key") or record.get("parent_session_id") or "")
+
+
+def _capacity_blocked(record: dict[str, Any], records, cap: int, total_cap: int) -> Optional[str]:
+    """Why ``record`` cannot take a slot now: "chat" (its chat runs ``cap`` units), "total" (the process runs
+    ``total_cap``), or None. A unit whose call already holds a slot (``slot_key``) always fits."""
+    slots = {r.get("slot_key") or r["delegation_id"]: _chat_of(r) for r in records if r.get("status") in _ACTIVE_STATES}
+    if record["slot_key"] in slots:
+        return None
+    chat = _chat_of(record)
+    if sum(1 for owner in slots.values() if owner == chat) >= max(1, cap):
+        return "chat"
+    if total_cap > 0 and len(slots) >= total_cap:
+        return "total"
+    return None
