+def _occupy_only_slot():
+    release, occupied = threading.Event(), threading.Event()
+
+    def occupy():
+        occupied.set()
+        release.wait(10)
+        return {"status": "completed", "summary": "slot released"}
+
+    handle = ad.dispatch_async_delegation(
+        goal="occupy", context=None, toolsets=None, role="leaf", model="m", session_key=ROUTE_KEY,
+        runner=occupy, max_async_children=1)
+    assert handle["status"] == "dispatched" and occupied.wait(5)
+    return release
+
+
+def test_queued_unit_is_handed_off_whole_and_queued_again_on_the_next_gateway():
+    """delegation.at_capacity: queue -- a unit still waiting for a slot survives the restart and keeps waiting."""
+    first_release = _occupy_only_slot()
+    released, ran = [], threading.Event()
+    handle = ad.dispatch_async_delegation_batch(
+        goals=[f"task {i}" for i in range(3)], context=None, toolsets=None, role="leaf", model="m",
+        session_key=ROUTE_KEY, parent_session_id=PARENT, runner=lambda: ran.set() or {"results": []},
+        delegation_id="deleg_call", handoff=_spec(3), handoff_fn=lambda deadline, state: None, max_async_children=1,
+        queue_at_capacity=True, release_fn=lambda: released.append(True))
+    assert handle["status"] == "queued"
+    assert ad.hand_off_for_restart(0.1, 0.5) == 1
+    assert released == [True] and not ran.is_set()
+    assert _completions("deleg_call") == []
+    row = _row("deleg_call")
+    spec = json.loads(row["task_json"])["handoff"]
+    assert row["state"] == "handed_off" and spec["queued"] is True and spec["resume"] == [0, 1, 2]
+    assert spec["max_async_children"] == 1
+    first_release.set()
+
+    ad._reset_for_tests()
+    _drain(process_registry.completion_queue)
+    second_release = _occupy_only_slot()
+    make_runner, seen = _resume_with(lambda i: _entry(i, "completed", f"resumed {i}"))
+    assert ad.adopt_handed_off_delegations(make_runner) == 1
+    assert [r["status"] for r in ad.list_async_delegations() if r["delegation_id"] == "deleg_call"] == ["queued"]
+    assert _completions("deleg_call") == []
+    second_release.set()
+    event = wait_until(lambda: _completions("deleg_call"), what="the queued unit's completion")[0]
+    assert [(r["task_index"], r["summary"]) for r in event["results"]] == [
+        (0, "resumed 0"), (1, "resumed 1"), (2, "resumed 2")]
