@@ -0,0 +1,64 @@
+"""delegation.parent_reply_guidance: a subagent that holds agent_send is told how to answer its parent mid-run."""
+
+import json
+from types import SimpleNamespace
+
+import pytest
+
+import tools.delegate_tool_config as delegate_config
+from hermes_cli.config_defaults import DEFAULT_CONFIG
+from tools.delegate_tool import _handle_control_action, _register_subagent, _unregister_subagent
+from tools.delegate_tool_progress import PARENT_REPLY_NOTE, has_parent_messaging
+from tests.tools.test_delegate_control_actions import _StubChild, _StubParent, _register
+
+
+@pytest.fixture
+def guidance(monkeypatch):
+    def set_to(on):
+        monkeypatch.setattr(delegate_config, "_get_parent_reply_guidance", lambda: on)
+    return set_to
+
+
+def _steer(sid, child, parent, message="which file are you on?"):
+    _register(sid, child)
+    try:
+        json.loads(_handle_control_action("steer", sid, message, parent))
+    finally:
+        _unregister_subagent(sid)
+    return child.steered
+
+
+def test_has_parent_messaging_reads_the_childs_tools():
+    assert has_parent_messaging(SimpleNamespace(valid_tool_names={"terminal", "agent_send"}))
+    assert not has_parent_messaging(SimpleNamespace(valid_tool_names={"terminal"}))
+    assert not has_parent_messaging(SimpleNamespace())
+
+
+def test_steer_carries_the_reply_hint_when_on_and_the_child_can_send(guidance):
+    guidance(True)
+    parent = _StubParent()
+    child = _StubChild(parent)
+    child.valid_tool_names = {"agent_send"}
+    (text,) = _steer("sid-reply-1", child, parent)
+    assert text.startswith("which file are you on?")
+    assert 'agent_send(to="parent"' in text
+
+
+def test_steer_is_unchanged_when_off_or_the_child_cannot_send(guidance):
+    parent = _StubParent()
+    guidance(False)
+    child = _StubChild(parent)
+    child.valid_tool_names = {"agent_send"}
+    assert _steer("sid-reply-2", child, parent) == ["which file are you on?"]
+    guidance(True)
+    bare = _StubChild(parent)
+    bare.valid_tool_names = {"terminal"}
+    assert _steer("sid-reply-3", bare, parent) == ["which file are you on?"]
+
+
+def test_default_config_is_off():
+    assert DEFAULT_CONFIG["delegation"]["parent_reply_guidance"] is False
+
+
+def test_note_names_the_call():
+    assert 'agent_send(to="parent"' in PARENT_REPLY_NOTE
