+"""delegation.parent_reply_guidance in the child's system prompt (built by _build_child_agent)."""
+
+from types import SimpleNamespace
+
+import pytest
+
+import tools.delegate_tool as dt
+from tools.delegate_tool_progress import PARENT_REPLY_NOTE
+
+
+class _FakeAgent:
+    tools = {"agent_send"}
+
+    def __init__(self, **kwargs):
+        self.ephemeral_system_prompt = kwargs["ephemeral_system_prompt"]
+        self.valid_tool_names = set(self.tools)
+        self.session_id = "child-sid"
+        self._session_init_model_config = None
+
+    def __getattr__(self, name):
+        if name.startswith("__"):
+            raise AttributeError(name)
+        return lambda *a, **k: None
+
+
+def _build(monkeypatch, on, tools):
+    import run_agent
+    _FakeAgent.tools = tools
+    monkeypatch.setattr(run_agent, "AIAgent", _FakeAgent)
+    monkeypatch.setattr(dt, "_load_config", lambda: {"parent_reply_guidance": on})
+    monkeypatch.setattr(dt, "_resolve_child_runtime", lambda *a, **k: {"model": "m", "provider": "p", "base_url": "http://x"})
+    monkeypatch.setattr(dt, "_open_child_session_db", lambda *a, **k: None)
+    monkeypatch.setattr(dt, "_resolve_child_credential_pool", lambda *a, **k: None)
+    for name in ("_reserve_child_transcript", "_apply_child_cache_ttl", "_apply_child_compression_cap",
+                 "_apply_child_provider_patience", "_attach_child", "_safe_progress"):
+        monkeypatch.setattr(dt, name, lambda *a, **k: None, raising=False)
+    parent = SimpleNamespace(enabled_toolsets=["terminal"], disabled_toolsets=[], model="m", session_id="p-sid",
+                             api_key="k", base_url="http://x", provider="p")
+    return dt._build_child_agent(0, "do it", None, None, None, 10, 1, parent)
+
+
+@pytest.mark.parametrize("on,tools,expect", [
+    (True, {"agent_send"}, True), (False, {"agent_send"}, False), (True, {"terminal"}, False)])
+def test_prompt_note(monkeypatch, on, tools, expect):
+    child = _build(monkeypatch, on, tools)
+    assert (PARENT_REPLY_NOTE in child.ephemeral_system_prompt) is expect
