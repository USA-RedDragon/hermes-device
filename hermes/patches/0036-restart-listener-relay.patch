diff --git a/tests/gateway/test_restart_listener_relay.py b/tests/gateway/test_restart_listener_relay.py
new file mode 100644
index 0000000000..ef7a71fcdc
--- /dev/null
+++ b/tests/gateway/test_restart_listener_relay.py
@@ -0,0 +1,221 @@
+"""gateway.restart_listener_relay_seconds: after a restart stop released the profile, the listener
+relays each connection to the standby that takes over instead of closing."""
+import asyncio
+import json
+import socket
+from types import SimpleNamespace
+
+import pytest
+
+from gateway import listener_relay
+from gateway.config import GatewayConfig, load_gateway_config
+from gateway.drain_control import HANDOVER_HEALTH
+from gateway.listener_relay import relay_listener, standby_listener_record, successor_target
+from gateway.run_api import relay_gateway_api
+
+
+def test_off_by_default():
+    assert GatewayConfig().restart_listener_relay_seconds == 0.0
+    assert GatewayConfig.from_dict({}).restart_listener_relay_seconds == 0.0
+    cfg = GatewayConfig.from_dict({"gateway": {"restart_listener_relay_seconds": 15}})
+    assert cfg.restart_listener_relay_seconds == 15.0
+    assert GatewayConfig.from_dict({"gateway": {"restart_listener_relay_seconds": 9999}}).restart_listener_relay_seconds == 0.0
+
+
+def test_config_yaml_key_reaches_the_runner_config(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    (tmp_path / "config.yaml").write_text("gateway:\n  restart_listener_relay_seconds: 15\n", encoding="utf-8")
+    assert load_gateway_config().restart_listener_relay_seconds == 15.0
+
+
+def _plan(monkeypatch, host, port, netns="net:[1]"):
+    monkeypatch.setattr("gateway.webapp_listener.listener_plan", lambda home: (host, port, None, None))
+    monkeypatch.setattr(listener_relay, "net_namespace_id", lambda: netns)
+
+
+def test_a_standby_publishes_its_host_address_for_a_wildcard_bind(monkeypatch, tmp_path):
+    _plan(monkeypatch, "0.0.0.0", 9120)
+    monkeypatch.setattr(socket, "gethostname", lambda: "pod-b")
+    monkeypatch.setattr(socket, "gethostbyname", lambda name: {"pod-b": "10.1.2.3"}[name])
+    assert standby_listener_record(tmp_path) == {"host": "10.1.2.3", "port": 9120, "netns": "net:[1]"}
+
+
+def test_a_standby_publishes_a_specific_bind_as_it_is(monkeypatch, tmp_path):
+    _plan(monkeypatch, "10.9.8.7", 9120)
+    assert standby_listener_record(tmp_path) == {"host": "10.9.8.7", "port": 9120, "netns": "net:[1]"}
+
+
+@pytest.mark.parametrize("port, netns", [(0, "net:[1]"), (9120, None)])
+def test_a_standby_publishes_nothing_for_an_ephemeral_port_or_an_unknown_namespace(monkeypatch, tmp_path, port, netns):
+    _plan(monkeypatch, "127.0.0.1", port, netns)
+    assert standby_listener_record(tmp_path) is None
+
+
+def _marker(tmp_path, listener):
+    path = tmp_path / "gateway.standby"
+    path.write_text(json.dumps({"pid": 7, **({"listener": listener} if listener is not None else {})}), encoding="utf-8")
+    return path
+
+
+def test_successor_target_is_a_standby_in_another_network_namespace(monkeypatch, tmp_path):
+    monkeypatch.setattr(listener_relay, "net_namespace_id", lambda: "net:[1]")
+    assert successor_target(_marker(tmp_path, {"host": "10.1.2.3", "port": 9120, "netns": "net:[2]"})) == ("10.1.2.3", 9120)
+    # One in this namespace could not bind the port this listener holds; loopback is this namespace's own.
+    assert successor_target(_marker(tmp_path, {"host": "10.1.2.3", "port": 9120, "netns": "net:[1]"})) is None
+    assert successor_target(_marker(tmp_path, {"host": "127.0.0.1", "port": 9120, "netns": "net:[2]"})) is None
+    assert successor_target(_marker(tmp_path, {"host": "pod-b", "port": 9120, "netns": "net:[2]"})) is None
+    assert successor_target(_marker(tmp_path, None)) is None
+    assert successor_target(tmp_path / "missing") is None
+
+
+def _listening_socket():
+    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+    sock.bind(("127.0.0.1", 0))
+    sock.listen(16)
+    sock.setblocking(False)
+    return sock
+
+
+def _free_port():
+    with socket.socket() as probe:
+        probe.bind(("127.0.0.1", 0))
+        return probe.getsockname()[1]
+
+
+async def _exchange(port, payload=b"GET /api/health HTTP/1.0\r\n\r\n"):
+    reader, writer = await asyncio.open_connection("127.0.0.1", port)
+    writer.write(payload)
+    await writer.drain()
+    try:
+        return await reader.read()
+    finally:
+        writer.close()
+
+
+async def _successor(port, reply=b"HTTP/1.0 200 OK\r\n\r\nok"):
+    async def answer(reader, writer):
+        await reader.readuntil(b"\r\n\r\n")
+        writer.write(reply)
+        await writer.drain()
+        writer.close()
+    return await asyncio.start_server(answer, "127.0.0.1", port)
+
+
+@pytest.mark.asyncio
+async def test_the_relay_holds_a_client_until_the_successor_listens():
+    old = _listening_socket()
+    port = old.getsockname()[1]
+    target_port = _free_port()
+    relay = asyncio.ensure_future(relay_listener(old, ("127.0.0.1", target_port), 1.0))
+    client = asyncio.ensure_future(_exchange(port))
+    await asyncio.sleep(0.3)  # refused by the successor's port all this time
+    assert not client.done()
+    successor = await _successor(target_port)
+    try:
+        assert await asyncio.wait_for(client, 3) == b"HTTP/1.0 200 OK\r\n\r\nok"
+        assert await asyncio.wait_for(relay, 8) == (1, 0)
+    finally:
+        successor.close()
+    with pytest.raises(OSError):
+        await _exchange(port)  # the window is over: the listener is closed
+
+
+@pytest.mark.asyncio
+async def test_a_connection_waiting_in_the_backlog_is_relayed(monkeypatch):
+    old = _listening_socket()
+    port = old.getsockname()[1]
+    target_port = _free_port()
+    successor = await _successor(target_port)
+    try:
+        client = asyncio.ensure_future(_exchange(port))
+        await asyncio.sleep(0.1)  # connected into the backlog before anything accepts
+        relay = asyncio.ensure_future(relay_listener(old, ("127.0.0.1", target_port), 0.3))
