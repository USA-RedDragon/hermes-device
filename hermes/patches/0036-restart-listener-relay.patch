+    successor = await _successor(target_port)
+
+    async def serve():  # what the listener task does on should_exit: it closes its own socket
+        while not handle.server.should_exit:
+            await asyncio.sleep(0.01)
+        sock.close()
+
+    handle = SimpleNamespace(server=SimpleNamespace(should_exit=False), socket=sock)
+    handle.task = asyncio.ensure_future(serve())
+    try:
+        relay = asyncio.ensure_future(relay_gateway_api(handle, ("127.0.0.1", target_port), 0.5))
+        assert await asyncio.wait_for(_exchange(port), 3) == b"HTTP/1.0 200 OK\r\n\r\nok"
+        assert handle.server.should_exit and sock.fileno() == -1
+        assert await asyncio.wait_for(relay, 8) == (1, 0)
+    finally:
+        successor.close()
