diff --git a/gateway/listener_relay.py b/gateway/listener_relay.py
new file mode 100644
index 0000000000..c99515d100
--- /dev/null
+++ b/gateway/listener_relay.py
@@ -0,0 +1,138 @@
+"""``gateway.restart_listener_relay_seconds``: a restart's listener relays to its successor.
+
+With ``gateway.restart_listener_handover`` a stopping gateway keeps its listener bound until it
+releases the profile, then closes it. A standby in another network namespace (the next pod of a
+rolling update that shares the home's volume) opens its own listener only after it took the profile
+over and built its runtime, and a load balancer sends it traffic only once its readiness probe passed
+after that. Clients in between were refused.
+
+With this key the stopping gateway keeps the listening socket open for that many seconds after the
+release and relays every connection, byte for byte, to the address the standby published in its
+``gateway.standby`` marker, retrying the connect until the successor listens. A client waits for the
+successor instead of being refused. Only a successor in another network namespace qualifies: one in
+this namespace could not bind the port while this gateway holds it.
+"""
+from __future__ import annotations
+
+import asyncio
+import ipaddress
+import json
+import logging
+import os
+import socket
+from pathlib import Path
+
+logger = logging.getLogger(__name__)
+
+CONNECT_RETRY_S = 0.05
+CONNECT_ATTEMPT_TIMEOUT_S = 1.0
+# Relayed connections still open when the window ends get this long to finish.
+DRAIN_S = 5.0
+_WILDCARD_HOSTS = {"", "0.0.0.0", "::"}
+
+
+def net_namespace_id() -> str | None:
+    """This process's network namespace (``net:[<inode>]``), None where there is none to read."""
+    try:
+        return os.readlink("/proc/self/ns/net")
+    except OSError:
+        return None
+
+
+def standby_listener_record(home) -> dict | None:
+    """What a standby publishes about the listener it opens once it takes over: an address another
+    network namespace can dial (its own host name's address for a wildcard bind) and its network
+    namespace. None for an ephemeral port or when either is unknown."""
+    from gateway.webapp_listener import listener_plan
+    host, port, _webapp, _reason = listener_plan(home)
+    netns = net_namespace_id()
+    if not port or netns is None:
+        return None
+    if host in _WILDCARD_HOSTS:
+        try:
+            host = socket.gethostbyname(socket.gethostname())
+        except OSError:
+            return None
+    return {"host": host, "port": int(port), "netns": netns}
+
+
+def successor_target(marker: Path) -> tuple[str, int] | None:
+    """The address to relay to, from the standby marker at *marker*: None without a standby, for one
+    in this network namespace, or for a loopback address (this namespace's own)."""
+    try:
+        record = json.loads(Path(marker).read_text(encoding="utf-8")).get("listener")
+        host, port, netns = str(record["host"]), int(record["port"]), record["netns"]
+        loopback = ipaddress.ip_address(host).is_loopback
+    except (OSError, ValueError, TypeError, KeyError, AttributeError):
+        return None
+    own = net_namespace_id()
+    if own is None or netns == own or loopback or not 0 < port < 65536:
+        return None
+    return host, port
+
+
+async def _pipe(reader: asyncio.StreamReader, writer: asyncio.StreamWriter) -> None:
+    try:
+        while data := await reader.read(65536):
+            writer.write(data)
+            await writer.drain()
+        if writer.can_write_eof():
+            writer.write_eof()
+    except (OSError, RuntimeError):
+        pass
+
+
+async def _relay_connection(reader, writer, target, connect_deadline: float) -> bool:
+    """Relay one accepted connection to *target*; False when the successor never listened in time."""
+    loop = asyncio.get_running_loop()
+    try:
+        while True:
+            try:
+                upstream_reader, upstream_writer = await asyncio.wait_for(
+                    asyncio.open_connection(*target), CONNECT_ATTEMPT_TIMEOUT_S)
+                break
+            except (OSError, TimeoutError):
+                if loop.time() + CONNECT_RETRY_S >= connect_deadline:
+                    return False
+                await asyncio.sleep(CONNECT_RETRY_S)
+        try:
+            await asyncio.gather(_pipe(reader, upstream_writer), _pipe(upstream_reader, writer))
+        finally:
+            upstream_writer.close()
+        return True
+    finally:
+        writer.close()
+
+
+async def relay_listener(sock: socket.socket, target: tuple[str, int], seconds: float) -> tuple[int, int]:
+    """Accept on the listening *sock* for *seconds* and relay each connection to *target*; then close
+    it, give the open relays :data:`DRAIN_S` and cut the rest. Returns ``(relayed, unrelayed)``:
+    connections that reached the successor and those that did not."""
+    loop = asyncio.get_running_loop()
+    deadline = loop.time() + seconds
+    tasks: set[asyncio.Task] = set()
+    counts = [0, 0]
+
+    async def handle(reader, writer):
+        task = asyncio.current_task()
+        tasks.add(task)
+        try:
+            counts[0 if await _relay_connection(reader, writer, target, deadline + DRAIN_S) else 1] += 1
+        except Exception:
+            counts[1] += 1
+            logger.debug("Listener relay connection failed", exc_info=True)
+        finally:
+            tasks.discard(task)
+
+    server = await asyncio.start_server(handle, sock=sock)
+    try:
+        await asyncio.sleep(max(0.0, deadline - loop.time()))
+    finally:
+        server.close()
+        if tasks:
+            _done, pending = await asyncio.wait(set(tasks), timeout=DRAIN_S)
+            for task in pending:
+                task.cancel()
+            if pending:
+                await asyncio.gather(*pending, return_exceptions=True)
+    return counts[0], counts[1]
