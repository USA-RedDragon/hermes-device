     """``gateway.restart_listener_handover``: the profile lock is released; give up the host gateway
-    role too (a standby waits for both), then close the listener that answered health until now."""
+    role too (a standby waits for both), then close the listener that answered health until now,
+    after relaying to the successor at *relay_to* when there is one."""
     from gateway import host_rendezvous as hr
     try:
         hr.release_role(hr.ROLE_GATEWAY)
