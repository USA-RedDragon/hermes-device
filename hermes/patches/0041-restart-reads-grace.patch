@@ -667,6 +667,10 @@ class GatewayConfig:
     # window ends gets a close frame with code 1012 (service restart) instead of a cut connection, so its
     # client reconnects at once. False = cut.
     restart_listener_relay_close_sockets: bool = False
+    # With restart_listener_handover: dashboard requests still running when a restart stop seals the listener
