diff --git a/tests/test_load_yaml_file_readonly.py b/tests/test_load_yaml_file_readonly.py
index 70151255bb..4df0ba6a4a 100644
--- a/tests/test_load_yaml_file_readonly.py
+++ b/tests/test_load_yaml_file_readonly.py
@@ -45,3 +45,41 @@ def test_callers_do_not_mutate_the_shared_cached_object(tmp_path, monkeypatch):
     assert secrets == {"onepassword": {"enabled": False}}
     assert cached == snapshot
     assert load_yaml_file_readonly(path) is cached
+
+
+def test_load_yaml_file_parses_once_and_hands_out_private_copies(tmp_path, monkeypatch):
+    """``read_config_doc`` (config_backend.read_path) runs dozens of times on a gateway start; an
+    unchanged file is parsed once and every caller still gets a copy it may change."""
+    import utils
+    from hermes_cli.config_backend import read_config_doc
+    path = tmp_path / "config.yaml"
+    path.write_text("﻿model: {default: a}\n", encoding="utf-8")
+    os.utime(path, ns=(os.stat(path).st_mtime_ns - 10_000_000_000,) * 2)  # settled: no racy digest
+    parses = []
+    real = utils.fast_safe_load
+    monkeypatch.setattr(utils, "fast_safe_load", lambda stream: parses.append(1) or real(stream))
+    first = read_config_doc(path)
+    first["model"]["default"] = "changed by a caller"
+    second = read_config_doc(path)
+    assert second == {"model": {"default": "a"}}
+    assert len(parses) == 1
+
+    path.write_text("model: {default: b}\n", encoding="utf-8")
+    os.utime(path, ns=(os.stat(path).st_mtime_ns + 1_000_000,) * 2)
+    assert read_config_doc(path) == {"model": {"default": "b"}}
+    assert len(parses) == 2
+
+
+def test_load_yaml_file_always_reads_a_frozen_workers_config(tmp_path, monkeypatch):
+    """A frozen-config worker keys config.yaml on the stat alone, which misses a same-size rewrite in
+    one tick: it reads the bytes every time instead of trusting that key."""
+    import utils
+    path = tmp_path / "config.yaml"
+    path.write_text("a: 1\n", encoding="utf-8")
+    monkeypatch.setattr(utils, "_frozen_config_worker", lambda p: True)
+    parses = []
+    real = utils.fast_safe_load
+    monkeypatch.setattr(utils, "fast_safe_load", lambda stream: parses.append(1) or real(stream))
+    assert utils.load_yaml_file(path) == {"a": 1}
+    assert utils.load_yaml_file(path) == {"a": 1}
+    assert len(parses) == 2
diff --git a/utils.py b/utils.py
index 344d24eb16..d0f09ba092 100644
--- a/utils.py
+++ b/utils.py
@@ -693,25 +693,40 @@ _YAML_FILE_CACHE: dict = {}
 _YAML_FILE_CACHE_LOCK = threading.Lock()
 
 
-def load_yaml_file_readonly(path: str | Path) -> Any:
-    """``fast_safe_load`` of a file, re-parsed only when its :func:`file_cache_version` changes.
-
-    Returns the cached object itself — callers must never mutate it. Parse errors propagate and
-    are not cached; a missing file raises ``FileNotFoundError`` like ``open`` does."""
+def _load_yaml_file_cached(path: str | Path, encoding: str) -> Any:
     path = Path(path)
     sig = file_cache_version(path)
-    key = str(path)
+    key = (os.path.abspath(path), encoding)
     with _YAML_FILE_CACHE_LOCK:
         cached = _YAML_FILE_CACHE.get(key)
         if cached is not None and cached[0] == sig:
             return cached[1]
-    with open(path, encoding="utf-8") as f:
+    with open(path, encoding=encoding) as f:
         data = fast_safe_load(f)
     with _YAML_FILE_CACHE_LOCK:
         _YAML_FILE_CACHE[key] = (sig, data)
     return data
 
 
+def load_yaml_file_readonly(path: str | Path) -> Any:
+    """``fast_safe_load`` of a file, re-parsed only when its :func:`file_cache_version` changes.
+
+    Returns the cached object itself — callers must never mutate it. Parse errors propagate and
+    are not cached; a missing file raises ``FileNotFoundError`` like ``open`` does."""
+    return _load_yaml_file_cached(path, "utf-8")
+
+
+def load_yaml_file(path: str | Path) -> Any:
+    """``fast_safe_load`` of a file (a byte-order mark is skipped) as a private copy the caller may
+    change, parsed again only when its :func:`file_cache_version` changes. Errors as
+    :func:`load_yaml_file_readonly`."""
+    if _frozen_config_worker(path):  # its cache key is stat-only there: always read the bytes
+        with open(path, encoding="utf-8-sig") as f:
+            return fast_safe_load(f)
+    import copy
+    return copy.deepcopy(_load_yaml_file_cached(path, "utf-8-sig"))
+
+
