         return acquire(_parent_db_path) if _parent_db_path is not None else acquire()
     return None
 
+def _bind_approval_review_root(child, parent_agent, goal) -> None:
+    """Smart approval (provenance) judges a child's actions against the root chat's user messages; the goal is
+    the parent's text, never the user's. The root chat is named by session id and read live from the session
+    store at each review (a nested child inherits its parent's root), so messages the user writes after the
+    spawn count; the root agent object is kept only for rows of its running turn not yet flushed."""
+    import weakref as _weakref
+    _root = getattr(parent_agent, "_approval_review_root", None)
+    _root = _root() if callable(_root) else _root
+    try:
+        child._approval_review_root = _weakref.ref(_root if _root is not None else parent_agent)
+    except TypeError:
+        child._approval_review_root = None
+    _session = getattr(parent_agent, "_approval_review_root_session", None)
+    if not (isinstance(_session, str) and _session):
+        _session = getattr(parent_agent, "session_id", None)
+    child._approval_review_root_session = _session if isinstance(_session, str) and _session else None
+    child._approval_review_goal = goal
+
