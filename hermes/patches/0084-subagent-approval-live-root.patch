+def _stored_root_messages(agent, root, session_id: str | None) -> list | None:
+    """The root chat's transcript read now from the session store, at the tip of its compression chain, or
+    ``None`` when no store can be read."""
+    sid = getattr(root, "session_id", None) or session_id if root is not None else session_id
+    if not sid:
+        return None
+    for owner in (agent, root):
+        db = getattr(owner, "_session_db", None) if owner is not None else None
+        if db is None or not hasattr(db, "get_messages_as_conversation"):
+            continue
+        try:
+            tip = db.get_compression_tip(sid) if hasattr(db, "get_compression_tip") else sid
+            rows = db.get_messages_as_conversation(tip or sid, include_ancestors=True)
+        except Exception as exc:
+            logger.debug("Smart approval (provenance): root transcript %s unreadable: %s", sid, exc)
+            continue
+        if isinstance(rows, list):
+            return rows
+    return None
+
+
+_ROOT_UNREADABLE = object()
+
+
+def root_messages_of(agent):
+    """For a subagent, the root chat's messages at decision time (``None`` for a root agent).
+
+    The stored transcript is read live, so what the user wrote after the spawn counts; rows of the root's
+    running turn that the store does not hold yet come from the root agent's live list. When neither the store
+    nor a live root agent can be read the result is ``_ROOT_UNREADABLE``: the review then asks the user, and
+    the subagent's own transcript (the parent's goal and steers) is never read as the user's words."""
+    if agent is None:
+        return None
+    root = getattr(agent, "_approval_review_root", None)
+    session_id = getattr(agent, "_approval_review_root_session", None)
+    session_id = session_id if isinstance(session_id, str) and session_id else None
+    depth = getattr(agent, "_delegate_depth", 0)
+    if root is None and session_id is None and not (isinstance(depth, int) and depth > 0):
+        return None
+    root = root() if callable(root) else root
+    live = _messages_of(root)
+    stored = _stored_root_messages(agent, root, session_id)
+    if stored is None:
+        return live if live is not None else _ROOT_UNREADABLE
+    from agent.conversation_compression_scaffolding import user_authored_text
+    seen = {text for text in map(user_authored_text, stored) if text}
+    extra = [m for m in (live or []) if (text := user_authored_text(m)) and text not in seen]
+    return stored + extra
+
+
 def review(tool_name: str, args: dict, *, agent=None, messages: list | None = None, cwd: str | None = None) -> Verdict:
     """Review one tool call against the session's own context."""
     agent = agent if agent is not None else _current_agent()
     if messages is None:
         messages = _messages_of(agent) or []
-    root = getattr(agent, "_approval_review_root", None) if agent is not None else None
-    root = root() if callable(root) else root
-    root_messages = (_messages_of(root) or []) if root is not None else None
+    root_messages = root_messages_of(agent)
+    if root_messages is _ROOT_UNREADABLE:
+        logger.info("Smart approval (provenance): %s by a subagent whose root chat cannot be read -> unsure", tool_name)
+        return Verdict("unsure", reason="the root chat's messages could not be read, so the user's words are unknown",
+                       stage=0)
     goal = None
     if root_messages is not None:
         goal = getattr(agent, "_approval_review_goal", None)
