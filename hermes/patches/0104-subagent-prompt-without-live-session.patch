--- /dev/null
+++ b/tests/tools/test_delegate_error_text.py
@@ -0,0 +1,45 @@
+"""A child that raises ends with an error that names the exception, never a bare ``str(exc)``.
+
+``str(KeyError("20261107_034217_644791"))`` is just the quoted key, so a subagent that died on a missing dict
+entry reported the parent's session id as its whole error.
+"""
+from unittest.mock import MagicMock
+
+import pytest
+
+from tools.delegate_tool_child_run import describe_exception
+
+
+def _raise_missing():
+    sessions = {}
+    return sessions["20261107_034217_644791"]
+
+
+def test_a_key_error_names_the_exception_and_says_the_key_is_missing():
+    with pytest.raises(KeyError) as caught:
+        _raise_missing()
+    text = describe_exception(caught.value)
+    assert text.startswith("KeyError: missing key '20261107_034217_644791'")
+    assert "_raise_missing" in text and "test_delegate_error_text.py" in text  # where it came from
+
+
+def test_other_exceptions_keep_their_message_after_the_name():
+    assert describe_exception(RuntimeError("boom")) == "RuntimeError: boom"
+
+
+def test_an_exception_without_a_message_is_its_name():
+    assert describe_exception(ValueError()) == "ValueError"
+
+
+def test_a_raised_key_error_reaches_the_entry_and_the_result_line():
+    from tools.delegate_tool import _run_single_child
+
+    child = MagicMock()
+    child._credential_pool = None
+    child.run_conversation.side_effect = KeyError("20261107_034217_644791")
+    parent = MagicMock()
+    parent._active_children = []
+    parent._delegate_depth = 0
+    result = _run_single_child(task_index=0, goal="g", child=child, parent_agent=parent)
+    assert result["status"] == "error"
+    assert result["error"].startswith("KeyError: missing key '20261107_034217_644791'")
diff --git a/tools/delegate_tool_child_run.py b/tools/delegate_tool_child_run.py
index 776a67ec..2eaed640 100644
--- a/tools/delegate_tool_child_run.py
+++ b/tools/delegate_tool_child_run.py
@@ -185,6 +185,25 @@ def _detach_child(parent_agent: Any, child: Any) -> None:
     except (ValueError, UnboundLocalError) as e:
         logger.debug("Could not remove child from active_children: %s", e)
 
+def describe_exception(exc: BaseException) -> str:
+    """An exception as a child's error text: ``Type: message (at file:line in function)``. ``str(KeyError(k))`` is
+    only the quoted key, so a missing session id reached the parent as the whole error; a KeyError says its key is
+    missing, and the innermost frame says where."""
+    name = type(exc).__name__
+    message = f"missing key {exc.args[0]!r}" if isinstance(exc, KeyError) and len(exc.args) == 1 else str(exc)
+    text = f"{name}: {message}" if message else name
+    try:
+        import traceback
+        frames = traceback.extract_tb(exc.__traceback__)
+        if frames:
+            last = frames[-1]
+            tail = "/".join(last.filename.replace("\\", "/").split("/")[-2:])
+            text += f" (at {tail}:{last.lineno} in {last.name})"
+    except Exception:
+        pass
+    return text
+
+
 def _signal_child_stop(child: Any, *reason: str, tool_reason: str = "parent delegation ended") -> None:
     """Cooperative interrupt so the child's worker thread can exit cleanly. ``tool_reason`` is the
     fixed cause the child's tools see (a pending approval wait reports it instead of a user deny)."""
@@ -1111,7 +1130,7 @@ class _ChildRun:
             if diagnostic_path:
                 logger.warning("Subagent %d 0-API-call timeout — diagnostic written to %s", task_index, diagnostic_path)
         if not is_timeout:
-            _err = str(exc)
+            _err = describe_exception(exc)
         elif stale_after is not None:
             _err = (
                 f"Subagent stopped making progress after {child_api_calls} API call(s) — no activity for "
@@ -1143,7 +1162,7 @@ class _ChildRun:
             "_child_role": getattr(child, "_delegate_role", None),
             "diagnostic_path": diagnostic_path,
         }
-        _error_entry = self.finish_failed(_error_entry, _late_pending_steer, preview=f"Timed out after {duration}s" if is_timeout else str(exc))
+        _error_entry = self.finish_failed(_error_entry, _late_pending_steer, preview=f"Timed out after {duration}s" if is_timeout else _err)
         close_deferred = is_timeout and not future.done()
         if close_deferred:
             _defer_close_after_timeout(child, future)
