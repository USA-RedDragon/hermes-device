diff --git a/tests/gateway/test_subagent_prompt_without_live_session.py b/tests/gateway/test_subagent_prompt_without_live_session.py
new file mode 100644
index 00000000..d752658a
--- /dev/null
+++ b/tests/gateway/test_subagent_prompt_without_live_session.py
@@ -0,0 +1,139 @@
+"""A background subagent's question or approval needs no live session of its parent chat.
+
+An idle local or API conversation leaves ``authority.sessions`` (``session_retirement``), and a restarted gateway
+starts without it. A background subagent keeps running through both and asks later; ``authority.sessions[id]``
+then raised ``KeyError(<parent session id>)`` inside the child's tool call, and the child ended with
+``status=error`` and the bare id as its error. The registration is only the viewers' copy of a card that the chat
+adapter already shows, so it restores the conversation when it can and otherwise leaves the card standing.
+
+Real owner pieces (``SessionAuthority`` over a real ``SessionDB``, the real ``TurnRunner`` clarify path); only the
+chat adapter is a stand-in.
+"""
+import asyncio
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from gateway.platforms.base import SendResult
+from gateway.run_turn_runner import TurnRunner
+from gateway.session_authority import LiveSession, SessionAuthority
+from hermes_state import SessionDB
+from hermes_state_runtime import admit_session_input, begin_runtime_epoch, claim_session_input
+from tools import approval
+from tools.approval_gateway_wait import _ApprovalEntry
+from tools import clarify_gateway as cg
+
+KEY = "retired-parent-route"
+PARENT = "20261107_034217_644791"
+ONE = [{"qid": "q0", "question": "Which one?", "choices": ["a", "b"], "multi_select": False}]
+
+
+class _Adapter:
+    def __init__(self):
+        self.cards = []
+
+    async def send_clarify(self, **kwargs):
+        self.cards.append(kwargs)
+        return SendResult(success=True, message_id="1")
+
+    async def retire_clarify_card(self, clarify_id, notice):
+        pass
+
+
+@pytest.fixture()
+def owner(tmp_path):
+    cg._entries.clear()
+    cg._session_index.clear()
+    approval._gateway_queues.clear()
+    with SessionDB(db_path=tmp_path / "state.db") as db:
+        db.create_session(PARENT, source="test")
+        epoch = begin_runtime_epoch(db, instance_id="current")
+        authority = SessionAuthority(SimpleNamespace(_draining=False), profile_id="owned",
+                                     instance_id="current", db=db, epoch=epoch)
+        authority.sessions[PARENT] = LiveSession(None, KEY)
+        yield SimpleNamespace(authority=authority, db=db, epoch=epoch)
+    cg._entries.clear()
+    cg._session_index.clear()
+    approval._gateway_queues.clear()
+
+
+def _turn_generation(owner):
+    admit_session_input(owner.db, epoch=owner.epoch, principal_id="human", session_id=PARENT,
+                        request_id="first", payload={"text": "start a subagent"})
+    return claim_session_input(owner.db, epoch=owner.epoch, session_id=PARENT)["generation"]
+
+
+def _runner(owner, generation, adapter):
+    runner = object.__new__(TurnRunner)
+    runner._approval_owner = (owner.authority, PARENT, generation)
+    runner._ctx = SimpleNamespace(
+        _status_adapter=adapter, _status_chat_id="C1", _status_thread_metadata={}, session_key=KEY,
+        stream_consumer_holder=[None], source=SimpleNamespace(platform="telegram"))
+
+    class _Fut:
+        def __init__(self, r): self._r = r
+        def result(self, timeout=None): return self._r
+
+    runner._schedule = lambda coro, label: _Fut(asyncio.run(coro))
+    return runner
+
+
+def test_a_subagent_approval_registers_nothing_for_a_conversation_that_left_memory(owner, caplog):
+    del owner.authority.sessions[PARENT]  # idle retirement, or a gateway that restarted
+    data = {"command": "true # approval-test", "request_id": "sub-1", "subagent": "check it"}
+    with caplog.at_level("WARNING"):
+        owner.authority.register_background_approval(PARENT, KEY, data)  # was KeyError(PARENT)
+    assert PARENT not in owner.authority.sessions
+    assert PARENT in caplog.text and "not in memory" in caplog.text  # never silent
+
+
+def test_a_subagent_question_registers_nothing_for_a_conversation_that_left_memory(owner, caplog):
+    del owner.authority.sessions[PARENT]
+    entry = cg.register(clarify_id="c1", session_key=KEY, question="Which one?", choices=["a"],
+                        multi_select=False, subagent="check it")
+    with caplog.at_level("WARNING"):
+        owner.authority.register_background_clarify(PARENT, entry)  # was KeyError(PARENT)
+    assert PARENT in caplog.text and "not in memory" in caplog.text
+
+
+def test_a_conversation_retirement_let_go_is_restored_for_the_prompt(owner):
+    seen = []
+
+    def restore(authority, session_id):
+        seen.append(session_id)
+        authority.sessions[session_id] = LiveSession(None, KEY)
+
+    del owner.authority.sessions[PARENT]
+    entry = _ApprovalEntry({"command": "true # approval-test", "request_id": "sub-1", "subagent": "check it"})
+    approval._gateway_queues.setdefault(KEY, []).append(entry)
+    data = entry.data
+    with patch("gateway.session_retirement.restore_retired", restore):
+        owner.authority.register_background_approval(PARENT, KEY, data)
+    assert seen == [PARENT]
+    live = owner.authority.sessions[PARENT]
+    assert [p["prompt_id"] for p in live.controls.snapshot(PARENT, None)] == ["sub-1"]
+
+
+def test_a_subagent_asks_its_question_with_no_live_session_and_gets_the_answer(owner):
+    generation = _turn_generation(owner)
+    adapter = _Adapter()
+    del owner.authority.sessions[PARENT]
+    real_wait = cg.wait_for_response
+    with patch("tools.clarify_gateway.get_clarify_timeout", return_value=1800), \
+            patch("tools.clarify_gateway.wait_for_response",
+                  lambda clarify_id, timeout: real_wait(clarify_id, timeout=0.05)):
+        reply = _runner(owner, generation, adapter)._background_clarify_ask(ONE, "check it")
+    assert adapter.cards and adapter.cards[0]["question"].startswith('Subagent "check it" asks: Which one?')
+    assert reply["outcome"] == "timed_out"  # a silent user, not a KeyError
+
+
+def test_a_subagent_approval_notify_with_no_live_session_renders_the_card(owner):
+    generation = _turn_generation(owner)
+    runner = _runner(owner, generation, _Adapter())
+    rendered = []
+    runner._render_approval_sync = rendered.append
+    del owner.authority.sessions[PARENT]
+    data = {"command": "true # approval-test", "request_id": "sub-1", "subagent": "check it"}
+    runner._background_approval_notify(data)
+    assert rendered == [data]
