+    def _background_live(self, session_id, what):
+        """The live session a subagent's *what* registers on, or None. A background subagent outlives the
+        memory of its parent chat: an idle conversation retires (``session_retirement``) and a restarted
+        gateway starts without it, yet the subagent asks later. A retired one is restored here; one that
+        cannot be (a restart of a local conversation, a deleted one) leaves only the viewers' copy of the
