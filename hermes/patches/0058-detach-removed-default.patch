+def _detach_removed_default(providers: list) -> None:
+    """``dashboard.detach_removed_default``: a disconnect that removed the default model's provider also drops
+    the default, so new chats are refused as having no model instead of failing on authentication."""
+    from hermes_cli.web_routers.config_env import detach_removed_default
+    detach_removed_default(providers)
+
+
 # In-browser device-code sessions: /start spawns a poller thread and returns the
 # display fields; the UI polls .../poll/{session_id} until status != "pending" (on
 # "approved" the poller has already saved creds). Anthropic has NO dashboard PKCE
diff --git a/tests/hermes_cli/test_detach_removed_default.py b/tests/hermes_cli/test_detach_removed_default.py
new file mode 100644
index 0000000000..1ddb5f5f1e
--- /dev/null
+++ b/tests/hermes_cli/test_detach_removed_default.py
@@ -0,0 +1,98 @@
+"""``dashboard.detach_removed_default``: removing the main model's provider drops the main model.
+
+Removing an API key or a sign-in left ``model.provider`` and ``model.default`` naming a provider with no
+credential, so every new chat failed on authentication; removing a custom endpoint dropped its provider but
+kept ``model.default``. With the key on, the main model goes with its provider, and ``session.create`` then
+refuses plainly as ``no_model_configured``. Off (the default) keeps upstream's behavior.
+"""
+import pytest
+
+
+@pytest.fixture
+def client(monkeypatch, _isolate_hermes_home):
+    try:
+        from starlette.testclient import TestClient
+    except ImportError:
+        pytest.skip("fastapi/starlette not installed")
+    import hermes_state
+    from hermes_constants import get_hermes_home
+    from hermes_cli.web_server import app, _SESSION_HEADER_NAME, _SESSION_TOKEN
+
+    monkeypatch.setattr(hermes_state, "DEFAULT_DB_PATH", get_hermes_home() / "state.db")
+    for name in ("OPENROUTER_API_KEY", "DEEPSEEK_API_KEY"):
+        monkeypatch.delenv(name, raising=False)
+    c = TestClient(app)
+    c.headers[_SESSION_HEADER_NAME] = _SESSION_TOKEN
+    return c
+
+
+def _setup(detach, provider="openrouter", model="openai/gpt-5"):
+    from hermes_cli.config import load_config, save_config
+    cfg = load_config()
+    cfg.setdefault("dashboard", {})["detach_removed_default"] = detach
+    cfg["model"] = {"provider": provider, "default": model}
+    save_config(cfg)
+
+
+def _model():
+    from hermes_cli.config import load_config
+    return load_config().get("model") or {}
+
+
+@pytest.mark.parametrize("detach", [True, False])
+def test_removing_the_default_providers_key(client, detach):
+    from hermes_cli.config import save_env_value
+    save_env_value("OPENROUTER_API_KEY", "sk-or-v1-test")
+    _setup(detach)
+    assert client.request("DELETE", "/api/env", json={"key": "OPENROUTER_API_KEY"}).status_code == 200
+    m = _model()
+    if detach:
+        assert not m.get("default") and not m.get("provider")
+    else:
+        assert m.get("default") == "openai/gpt-5" and m.get("provider") == "openrouter"
+
+
+def test_removing_another_providers_key_keeps_the_default(client):
+    from hermes_cli.config import save_env_value
+    save_env_value("DEEPSEEK_API_KEY", "sk-test")
+    _setup(True)
+    assert client.request("DELETE", "/api/env", json={"key": "DEEPSEEK_API_KEY"}).status_code == 200
+    assert _model().get("default") == "openai/gpt-5"
+
+
+def test_a_key_left_in_the_environment_keeps_the_default(client, monkeypatch):
+    from hermes_cli.config import save_env_value
+    save_env_value("OPENROUTER_API_KEY", "sk-or-v1-test")
+    _setup(True)
+    monkeypatch.setenv("OPENROUTER_API_KEY", "sk-or-v1-from-the-deployment")
+    from hermes_cli.web_routers import config_env
+    monkeypatch.setattr(config_env, "load_env", lambda: {})
+    assert config_env._providers_left_without_key("OPENROUTER_API_KEY", []) == []
+    monkeypatch.delenv("OPENROUTER_API_KEY")
+    assert config_env._providers_left_without_key("OPENROUTER_API_KEY", []) == ["openrouter"]
+
+
+@pytest.mark.parametrize("detach", [True, False])
+def test_removing_the_default_custom_endpoint(client, detach):
+    assert client.post("/api/providers/custom-endpoints", json={
+        "id": "ollama", "name": "Ollama", "base_url": "http://ollama:11434/v1", "model": "qwen2.5:0.5b", "make_default": True,
+    }).status_code == 200
+    from hermes_cli.config import load_config, save_config
+    cfg = load_config()
+    cfg.setdefault("dashboard", {})["detach_removed_default"] = detach
+    save_config(cfg)
+    assert _model().get("default") == "qwen2.5:0.5b"
+    assert client.request("DELETE", "/api/providers/custom-endpoints/ollama").status_code == 200
+    m = _model()
+    assert not m.get("provider")
+    assert bool(m.get("default")) is not detach
+
+
+def test_signing_out_of_the_default_provider(client, monkeypatch):
+    _setup(True, provider="nous", model="Hermes-4-405B")
+    import hermes_cli.auth as auth
+    monkeypatch.setattr(auth, "clear_provider_auth", lambda provider_id: True)
+    from hermes_cli.web_routers import oauth
+    monkeypatch.setattr(oauth, "_resolve_provider_status", lambda *a, **k: {"logged_in": True})
+    assert client.request("DELETE", "/api/providers/oauth/nous").status_code == 200
+    assert not _model().get("default")
