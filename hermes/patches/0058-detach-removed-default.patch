--- a/hermes_cli/config_defaults.py
+++ b/hermes_cli/config_defaults.py
@@ -1004,6 +1004,10 @@ DEFAULT_CONFIG = {
         # auxiliary calls, retries, fallbacks and cache writes are missed, so the total can be
