+        "detach_removed_default": False,
         # IPs / bounded CIDRs of reverse proxies trusted to supply X-Forwarded-Proto/-For. Loopback
         # always trusted; wildcards and /0 rejected (spoofing guard).
         "trusted_proxies": [],
diff --git a/hermes_cli/web_routers/config_env.py b/hermes_cli/web_routers/config_env.py
index 2ac4699052..8f68e14043 100644
--- a/hermes_cli/web_routers/config_env.py
+++ b/hermes_cli/web_routers/config_env.py
@@ -575,6 +575,56 @@ def _detach_main_model_from_provider(cfg: dict[str, Any], provider_key: str, ent
     cfg["model"] = model_cfg
 
 
+def _detach_removed_default_enabled(cfg: dict[str, Any]) -> bool:
+    """``dashboard.detach_removed_default`` (false = off)."""
+    dashboard = cfg.get("dashboard")
+    return isinstance(dashboard, dict) and bool(dashboard.get("detach_removed_default"))
+
+
+def _drop_default_model(model_cfg: dict[str, Any]) -> None:
+    for field in ("default", "name", "provider", "base_url", "api_key", "key_env", "api_mode"):
+        model_cfg.pop(field, None)
+
+
+def detach_removed_default(providers: List[str]) -> bool:
+    """With ``dashboard.detach_removed_default``, drop the main model when its provider was removed.
+
+    A removed API key or sign-in left ``model.provider`` and ``model.default`` naming a provider with no
+    credential, so every new chat failed on authentication instead of being refused as having no model.
+    Runs in the caller's profile scope; returns whether config.yaml changed.
+    """
+    wanted = {str(p).strip().lower() for p in providers if str(p).strip()}
+    if not wanted:
+        return False
+    with _CONFIG_MUTATION_LOCK:
+        cfg = load_config()
+        model_cfg = cfg.get("model")
+        if not _detach_removed_default_enabled(cfg) or not isinstance(model_cfg, dict):
+            return False
+        current = str(model_cfg.get("provider") or "").strip().lower().removeprefix("custom:")
+        if current not in wanted:
+            return False
+        _drop_default_model(model_cfg)
+        cfg["model"] = model_cfg
+        save_config(cfg)
+        return True
+
+
+def _providers_left_without_key(env_var: str, providers: List[str]) -> List[str]:
+    """The providers ``env_var`` served (``providers`` plus the catalog's) that no longer hold any of their API
+    keys in ``.env`` or the environment."""
+    import os
+
+    try:
+        from hermes_cli.provider_catalog import provider_catalog
+        keys = {d.slug: tuple(d.api_key_env_vars or ()) for d in provider_catalog()}
+    except Exception:
+        keys = {}
+    served = set(providers) | {slug for slug, names in keys.items() if env_var in names}
+    env = load_env()
+    return sorted(p for p in served if not any(env.get(n) or os.environ.get(n) for n in keys.get(p, (env_var,))))
+
+
 def _write_custom_endpoint(cfg: dict[str, Any], body: CustomEndpointUpdate) -> tuple[str, dict[str, Any]]:
     name = (body.name or "").strip()
     base_url = (body.base_url or "").strip().rstrip("/")
@@ -854,6 +904,10 @@ def delete_custom_endpoint(endpoint_id: str, profile: Optional[str] = None):
                 provider_key = _custom_endpoint_id(endpoint_id)
                 if _pop_legacy_custom_provider(cfg, provider_key) is None:
                     raise HTTPException(status_code=404, detail="custom endpoint not found")
+            model_cfg = cfg.get("model")
+            if (_detach_removed_default_enabled(cfg) and isinstance(model_cfg, dict)
+                    and _model_names_provider(model_cfg, provider_key, entry)):
+                _drop_default_model(model_cfg)
             _detach_main_model_from_provider(cfg, provider_key, entry)
             remove_env_value(custom_endpoint_key_env(provider_key))
             save_config(cfg)
@@ -1087,9 +1141,13 @@ async def remove_env_var(body: EnvVarDelete, profile: Optional[str] = None):
     with _env_write_errors("DELETE /api/env failed"):
         from hermes_cli.credential_lifecycle import remove_provider_env_credential
 
-        result = await scoped_to_thread(
-            body.profile or profile, lambda: remove_provider_env_credential(body.key)
-        )
+        def _remove() -> dict:
+            removed = remove_provider_env_credential(body.key)
+            if removed.get("found"):
+                detach_removed_default(_providers_left_without_key(body.key, list(removed.get("providers") or [])))
+            return removed
+
+        result = await scoped_to_thread(body.profile or profile, _remove)
         if not result.get("found"):
             raise HTTPException(status_code=404, detail=f"{body.key} not found in .env")
         return result
