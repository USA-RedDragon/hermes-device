--- a/hermes_cli/config_defaults.py
+++ b/hermes_cli/config_defaults.py
@@ -1249,6 +1249,12 @@ DEFAULT_CONFIG = {
         # Byte budget for one embedded image (clamped 64 KiB..4 MiB). Raise it for dense phone
         # screenshots of tables the model calls "unreadable" at 256 KB.
         "embed_target_bytes": 256 * 1024,
+        # Long edge of one embedded image in px (clamped 256..8000). Current Claude models read 2000 px.
+        "embed_max_dimension": 1568,
+        # "halve": scale an oversized image down by halves and re-encode it as JPEG. "fit": scale once to
+        # embed_max_dimension and keep the original format (PNG stays PNG) while it fits embed_target_bytes,
+        # then fall back to JPEG quality steps and halving, so small text stays readable.
+        "resize_mode": "halve",
         # How often vision_analyze may embed the SAME image (region crops included) per session.
         # null = 3 inside delegated subagents (they run unattended), unlimited for the main agent;
         # an explicit number applies everywhere; 0 = unlimited.
diff --git a/tests/tools/test_vision_resize_fit.py b/tests/tools/test_vision_resize_fit.py
new file mode 100644
index 00000000..dfb74571
--- /dev/null
+++ b/tests/tools/test_vision_resize_fit.py
@@ -0,0 +1,181 @@
+"""``vision.resize_mode: fit`` with ``vision.embed_max_dimension`` and ``vision.embed_target_bytes``.
+
+Fit scales an oversized image once to the long-edge cap and keeps PNG while it fits the byte budget; the
+default (halve) keeps the older behavior. Every native image path reads the same settings.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import base64
+import io
+import random
+
+import pytest
+
+try:
+    from PIL import Image, ImageDraw
+except ImportError:  # pragma: no cover
+    Image = None
+
+pytestmark = pytest.mark.skipif(Image is None, reason="Pillow not installed")
+
+from tools import vision_tools, vision_tools_history_budget as budget  # noqa: E402
+
+
+def _screenshot(path, size=(1920, 1080)):
+    """Flat background with small text, like a screenshot (compresses well as PNG)."""
+    img = Image.new("RGB", size, (250, 250, 250))
+    draw = ImageDraw.Draw(img)
+    for y in range(20, size[1] - 20, 30):
+        draw.text((20, y), "M49J-XC7T  small text line %d" % y, fill=(10, 10, 10))
+    img.save(path, format="PNG")
+    return path
+
+
+def _noise(path, size=(1920, 1080)):
+    rng = random.Random(1)
+    img = Image.frombytes("RGB", size, bytes(rng.getrandbits(8) for _ in range(size[0] * size[1] * 3)))
+    img.save(path, format="PNG")
+    return path
+
+
+def _decode(url):
+    head, b64 = url.split(",", 1)
+    with Image.open(io.BytesIO(base64.b64decode(b64))) as img:
+        return head, img.size
+
+
+def _config(monkeypatch, **vision):
+    monkeypatch.setattr(budget, "_cfg_vision", lambda key, default=None: vision.get(key, default))
+
+
+class TestResolvers:
+    def test_defaults_are_upstream(self, monkeypatch):
+        _config(monkeypatch)
+        assert budget.resolve_embed_max_dimension() == 1568
+        assert budget.resolve_resize_mode() == "halve"
+
+    def test_values_are_read_and_clamped(self, monkeypatch):
+        _config(monkeypatch, embed_max_dimension=2000, resize_mode="Fit")
+        assert budget.resolve_embed_max_dimension() == 2000
+        assert budget.resolve_resize_mode() == "fit"
+        _config(monkeypatch, embed_max_dimension=99999)
+        assert budget.resolve_embed_max_dimension() == 8000
+        _config(monkeypatch, embed_max_dimension=10)
+        assert budget.resolve_embed_max_dimension() == 256
+
+    @pytest.mark.parametrize("bad", ["wide", None, True, [1]])
+    def test_bad_values_fall_back(self, monkeypatch, bad):
+        _config(monkeypatch, embed_max_dimension=bad, resize_mode=bad)
+        assert budget.resolve_embed_max_dimension() == 1568
+        assert budget.resolve_resize_mode() == "halve"
+
+
+class TestResizeFit:
+    def test_halve_is_the_default(self, tmp_path, monkeypatch):
+        _config(monkeypatch)
+        src = _screenshot(tmp_path / "a.png")
+        url = vision_tools._resize_image_for_vision(src, mime_type="image/png", max_base64_bytes=1 << 20,
+                                                    max_dimension=1568, force_jpeg=True)
+        assert _decode(url) == ("data:image/jpeg;base64", (960, 540))
+
+    def test_fit_scales_once_and_keeps_png(self, tmp_path):
+        src = _screenshot(tmp_path / "a.png")
+        scale = {}
+        url = vision_tools._resize_image_for_vision(src, mime_type="image/png", max_base64_bytes=1 << 20,
+                                                    max_dimension=1568, force_jpeg=True, scale_out=scale,
+                                                    mode="fit")
+        assert _decode(url) == ("data:image/png;base64", (1568, 882))
+        assert scale == {"orig_width": 1920, "orig_height": 1080, "new_width": 1568, "new_height": 882}
+
+    def test_fit_reads_the_config_when_mode_is_unset(self, tmp_path, monkeypatch):
+        _config(monkeypatch, resize_mode="fit")
+        src = _screenshot(tmp_path / "a.png")
+        url = vision_tools._resize_image_for_vision(src, mime_type="image/png", max_base64_bytes=1 << 20,
+                                                    max_dimension=2000, force_jpeg=True)
+        # Under the cap and under the budget: returned unchanged
+        assert _decode(url) == ("data:image/png;base64", (1920, 1080))
+
+    def test_fit_falls_back_to_jpeg_at_the_fitted_size(self, tmp_path):
+        src = _noise(tmp_path / "n.png")
+        url = vision_tools._resize_image_for_vision(src, mime_type="image/png", max_base64_bytes=600_000,
+                                                    max_dimension=1568, force_jpeg=True, mode="fit")
+        head, size = _decode(url)
+        assert head == "data:image/jpeg;base64" and size == (1568, 882) and len(url) <= 600_000
+
+    def test_fit_halves_only_when_jpeg_at_the_fitted_size_is_too_big(self, tmp_path):
+        src = _noise(tmp_path / "n.png")
+        url = vision_tools._resize_image_for_vision(src, mime_type="image/png", max_base64_bytes=100_000,
+                                                    max_dimension=1568, force_jpeg=True, mode="fit")
+        head, size = _decode(url)
+        assert head == "data:image/jpeg;base64" and size == (784, 441) and len(url) <= 100_000
+
+    def test_fit_keeps_the_aspect_of_a_tall_image(self, tmp_path):
+        src = _screenshot(tmp_path / "t.png", size=(1080, 2370))
+        url = vision_tools._resize_image_for_vision(src, mime_type="image/png", max_base64_bytes=1 << 20,
+                                                    max_dimension=2000, force_jpeg=True, mode="fit")
+        assert _decode(url) == ("data:image/png;base64", (911, 2000))
+
+    def test_fit_converts_palette_images_before_scaling(self, tmp_path):
+        src = tmp_path / "p.png"
+        Image.new("P", (3000, 1000), 3).save(src, format="PNG")
+        url = vision_tools._resize_image_for_vision(src, mime_type="image/png", max_base64_bytes=1 << 20,
+                                                    max_dimension=2000, force_jpeg=True, mode="fit")
+        assert _decode(url)[1] == (2000, 667)
+
+    def test_fit_keeps_alpha_in_png(self, tmp_path):
+        src = tmp_path / "a.png"
+        Image.new("RGBA", (2400, 1200), (0, 0, 0, 0)).save(src, format="PNG")
+        url = vision_tools._resize_image_for_vision(src, mime_type="image/png", max_base64_bytes=1 << 20,
+                                                    max_dimension=2000, force_jpeg=True, mode="fit")
+        b64 = url.split(",", 1)[1]
+        with Image.open(io.BytesIO(base64.b64decode(b64))) as img:
+            assert img.mode == "RGBA" and img.size == (2000, 1000)
+
+    def test_fit_jpeg_source_stays_jpeg(self, tmp_path):
+        src = tmp_path / "j.jpg"
+        Image.new("RGB", (3000, 2000), (90, 120, 160)).save(src, format="JPEG")
+        url = vision_tools._resize_image_for_vision(src, mime_type="image/jpeg", max_base64_bytes=1 << 20,
+                                                    max_dimension=2000, force_jpeg=True, mode="fit")
+        assert _decode(url) == ("data:image/jpeg;base64", (2000, 1333))
+
+
+class TestEveryImagePath:
+    """Each native image path applies the configured cap and mode."""
+
+    def test_vision_analyze(self, tmp_path, monkeypatch):
+        _config(monkeypatch, resize_mode="fit", embed_max_dimension=2000, embed_target_bytes=524288)
+        src = _screenshot(tmp_path / "va.png", size=(2560, 1440))
+        out = asyncio.run(vision_tools._vision_analyze_native(str(src), "read it"))
+        url = next(p["image_url"]["url"] for p in out["content"] if p.get("type") == "image_url")
+        assert _decode(url) == ("data:image/png;base64", (2000, 1125))
+
+    def test_vision_analyze_default_still_halves(self, tmp_path, monkeypatch):
+        _config(monkeypatch)
+        src = _screenshot(tmp_path / "vb.png")
+        out = asyncio.run(vision_tools._vision_analyze_native(str(src), "read it"))
+        url = next(p["image_url"]["url"] for p in out["content"] if p.get("type") == "image_url")
+        assert _decode(url) == ("data:image/jpeg;base64", (960, 540))
+
+    def test_browser_use_cli_screenshot(self, tmp_path, monkeypatch):
+        from tools import browser_use_cli
+        _config(monkeypatch, resize_mode="fit", embed_max_dimension=2000, embed_target_bytes=524288)
+        monkeypatch.setattr(vision_tools, "_should_use_native_vision_fast_path", lambda: True)
+        src = _screenshot(tmp_path / "bu.png", size=(2560, 1440))
+        out = browser_use_cli._native_screenshot_result({"ok": True}, str(src))
+        assert _decode(out["content"][1]["image_url"]["url"]) == ("data:image/png;base64", (2000, 1125))
+
+    def test_mcp_image(self, tmp_path, monkeypatch):
+        from tools import mcp_tool_content
+        _config(monkeypatch, resize_mode="fit", embed_max_dimension=2000, embed_target_bytes=524288)
+        src = _screenshot(tmp_path / "mcp.png", size=(2560, 1440))
+        part, _note = mcp_tool_content._mcp_native_image_part(str(src))
+        assert _decode(part["image_url"]["url"]) == ("data:image/png;base64", (2000, 1125))
+
+    def test_mcp_image_default_halves(self, tmp_path, monkeypatch):
+        from tools import mcp_tool_content
+        _config(monkeypatch)
+        src = _screenshot(tmp_path / "mcp2.png", size=(2560, 1440))
+        part, _note = mcp_tool_content._mcp_native_image_part(str(src))
+        assert _decode(part["image_url"]["url"])[1] == (1280, 720)
