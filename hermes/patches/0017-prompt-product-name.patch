index 0000000000..7a70cd9674
--- /dev/null
+++ b/tests/agent/test_runtime_environment_markers.py
@@ -0,0 +1,53 @@
+"""Runtime-environment markers without the product name, and agent.product_help_guidance."""
+from agent import prompt_builder as pb
+from agent import system_prompt
+from agent.surface_switch import runtime_host_value, split_runtime_boundary
+from agent.system_prompt import build_system_prompt_parts
+from tests.agent.test_system_prompt import _make_agent
+
+
+def _prompt(heading, end, cwd):
+    return (f"IDENTITY\n\nProject prose quoting {heading} in passing.\n\n{heading}\n\n"
+            f"Host: Example\nUser home directory: /home/alice\nCurrent working directory: {cwd}\n\n{end}")
+
+
+def test_markers_do_not_name_the_product():
+    assert pb.RUNTIME_ENVIRONMENT_HEADING == "# Runtime environment"
+    assert pb.RUNTIME_ENVIRONMENT_END == "<!-- End runtime environment -->"
+    assert ("# Hermes runtime environment", "<!-- End Hermes runtime environment -->") in \
+        pb.LEGACY_RUNTIME_ENVIRONMENT_MARKERS
+
+
+def test_new_and_stored_legacy_prompts_both_split():
+    new = _prompt(pb.RUNTIME_ENVIRONMENT_HEADING, pb.RUNTIME_ENVIRONMENT_END, "/work/new")
+    old = _prompt(*pb.LEGACY_RUNTIME_ENVIRONMENT_MARKERS[0], "/work/old")
+    for prompt, cwd in ((new, "/work/new"), (old, "/work/old")):
+        identity, marker, runtime = split_runtime_boundary(prompt)
+        assert identity.startswith("IDENTITY") and marker and runtime.startswith("Host: Example")
+        assert runtime_host_value(prompt, "Current working directory") == cwd
+    assert split_runtime_boundary("IDENTITY only") == ("IDENTITY only", "", "")
+
+
+def test_rendered_prompt_uses_the_new_markers(monkeypatch):
+    monkeypatch.setattr(pb, "build_environment_hints", lambda: "Host: Example")
+    prompt = "\n\n".join(build_system_prompt_parts(_make_agent()).values())
+    assert pb.RUNTIME_ENVIRONMENT_HEADING in prompt and prompt.rstrip().endswith(pb.RUNTIME_ENVIRONMENT_END)
+    assert "Hermes runtime environment" not in prompt
+
+
+def test_product_help_guidance_on_by_default_and_off_when_disabled(monkeypatch):
+    monkeypatch.setattr(system_prompt, "HERMES_AGENT_HELP_GUIDANCE", "HELP-SKILL")
+    monkeypatch.setattr(system_prompt, "HERMES_AGENT_HELP_GUIDANCE_NO_SKILLS", "HELP-DOCS")
+    on = "\n\n".join(build_system_prompt_parts(_make_agent()).values())
+    off = "\n\n".join(build_system_prompt_parts(_make_agent(_product_help_guidance=False)).values())
+    assert "HELP-DOCS" in on
+    assert "HELP-DOCS" not in off and "HELP-SKILL" not in off
+
+
+def test_hermes_agent_skill_is_disableable_only_without_product_help(monkeypatch):
+    from agent import skill_utils
+    cfg = {"skills": {"disabled": ["hermes-agent", "other"]}}
+    monkeypatch.setattr(skill_utils, "_load_raw_config", lambda: cfg)
+    assert skill_utils.get_disabled_skill_names(platform="cli") == {"other"}
+    cfg["agent"] = {"product_help_guidance": False}
+    assert skill_utils.get_disabled_skill_names(platform="cli") == {"hermes-agent", "other"}
