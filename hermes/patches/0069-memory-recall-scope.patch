@@ -0,0 +1,140 @@
+"""memory.recall_history / memory.recall_max_chars: how far a turn's recalled memory reaches."""
+
+from __future__ import annotations
+
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from agent.context_compressor import ContextCompressor
+from agent.memory_context import build_memory_context_block, cap_recalled_memory, strip_recalled_memory
+from agent.turn_context import compose_user_api_content
+from tests.agent.test_api_content_sidecar import (  # noqa: F401  (wire_env is a fixture)
+    _chat_requests,
+    _user_messages,
+    wire_env,
+)
+
+RECALL = "## User Representation\n" + "".join(f"- fact number {i} about the user\n" for i in range(40))
+
+
+def _with_recall(agent, *, keep: bool, max_chars: int = 0):
+    manager = MagicMock()
+    manager.prefetch_all.return_value = RECALL
+    manager.describe_recall.return_value = ""
+    manager.providers = []
+    agent._memory_manager = manager
+    agent._memory_recall_history = keep
+    agent._memory_recall_max_chars = max_chars
+    agent.context_compressor.strip_recalled_memory = not keep
+    return agent
+
+
+def test_strip_keeps_text_around_the_block():
+    block = build_memory_context_block(RECALL)
+    assert strip_recalled_memory(compose_user_api_content("ship it", RECALL, "")) == "ship it"
+    assert strip_recalled_memory(compose_user_api_content("ship it", RECALL, "HOOK")) == "ship it\n\nHOOK"
+    assert strip_recalled_memory(block + "\n\nHOOK") == "HOOK"
+    parts = [{"type": "text", "text": "look"}, {"type": "image_url", "image_url": {"url": "data:,"}},
+             {"type": "text", "text": block}]
+    assert strip_recalled_memory(parts) == parts[:2]
+    plain = [{"type": "text", "text": "look"}]
+    assert strip_recalled_memory(plain) is plain
+    assert strip_recalled_memory("no recall here") == "no recall here"
+
+
+def test_cap_keeps_head_and_tail_at_lines_and_says_so():
+    capped = cap_recalled_memory(RECALL, 400)
+    assert len(capped) < 520 and "chars of recalled memory cut by memory.recall_max_chars" in capped
+    assert capped.startswith("## User Representation\n") and capped.endswith("fact number 39 about the user\n")
+    assert "fact number 20 " not in capped
+    assert all(line.startswith(("## ", "- fact", "[... ")) for line in capped.splitlines())
+    assert cap_recalled_memory(RECALL, 0) is RECALL
+
+
+def test_default_keeps_recall_in_history(wire_env):
+    make_agent, handler, db, sid = wire_env
+    _with_recall(make_agent(), keep=True).run_conversation("first ask", conversation_history=[], task_id="t1")
+    history = db.get_messages_as_conversation(sid)
+    handler.captured_requests = []
+    _with_recall(make_agent(), keep=True).run_conversation("second ask", conversation_history=history, task_id="t2")
+    users = _user_messages(_chat_requests(handler)[0])
+    assert "<memory-context>" in users[0]["content"] and "<memory-context>" in users[-1]["content"]
+
+
+def test_recall_rides_only_its_own_turn(wire_env):
+    make_agent, handler, db, sid = wire_env
+    _with_recall(make_agent(), keep=False).run_conversation("first ask", conversation_history=[], task_id="t1")
+    first = _user_messages(_chat_requests(handler)[0])[0]["content"]
+    assert "<memory-context>" in first and "fact number 39" in first
+
+    stored = [r for r in db.get_messages(sid) if r["role"] == "user"]
+    assert all("memory-context" not in (r["content"] or "") + (r["api_content"] or "") for r in stored)
+    assert stored[0]["api_content"] == "first ask\n\nPLUGIN-CTX"  # the hook's context is still replayed
+
+    history = db.get_messages_as_conversation(sid)
+    handler.captured_requests = []
+    _with_recall(make_agent(), keep=False).run_conversation("second ask", conversation_history=history, task_id="t2")
+    users = _user_messages(_chat_requests(handler)[0])
+    assert users[0]["content"] == "first ask\n\nPLUGIN-CTX"
+    assert "<memory-context>" in users[-1]["content"]
+
+
+def test_live_history_older_turn_is_stripped_on_the_wire(wire_env):
+    make_agent, handler, db, sid = wire_env
+    agent = _with_recall(make_agent(), keep=False)
+    block = build_memory_context_block(RECALL)
+    history = [{"role": "user", "content": "old ask", "api_content": "old ask\n\n" + block},
+               {"role": "assistant", "content": "old answer"}]
+    agent.run_conversation("new ask", conversation_history=history, task_id="t1")
+    users = _user_messages(_chat_requests(handler)[0])
+    assert users[0]["content"] == "old ask"
+
+
+def test_recall_cap_applies_to_the_sent_block(wire_env):
+    make_agent, handler, db, sid = wire_env
+    _with_recall(make_agent(), keep=False, max_chars=200).run_conversation("ask", conversation_history=[], task_id="t")
+    sent = _user_messages(_chat_requests(handler)[0])[0]["content"]
+    assert "chars of recalled memory cut" in sent and "fact number 20 " not in sent
+
+
+@pytest.mark.parametrize("strip", [False, True])
+def test_summarizer_input_drops_recall_when_off(strip):
+    compressor = ContextCompressor(model="test/model", quiet_mode=True, config_context_length=64_000)
+    compressor.strip_recalled_memory = strip
+    block = build_memory_context_block(RECALL)
+    text = compressor._serialize_for_summary([{"role": "user", "content": "ship it\n\n" + block},
+                                              {"role": "assistant", "content": "shipped"}])
+    assert "ship it" in text and "shipped" in text
+    assert ("fact number 3" in text) is not strip
+
+
+def test_config_keys_reach_the_agent():
+    from agent.agent_init import _init_memory
+
+    agent = MagicMock()
+    with patch("agent.safe_worker_policy.safe_worker_enabled", return_value=True):
+        _init_memory(agent, {"memory": {"recall_history": False, "recall_max_chars": "2000"}}, True, "cli")
+    assert agent._memory_recall_history is False and agent._memory_recall_max_chars == 2000
+    with patch("agent.safe_worker_policy.safe_worker_enabled", return_value=True):
+        _init_memory(agent, {}, True, "cli")
+    assert agent._memory_recall_history is True and agent._memory_recall_max_chars == 0
+
+
+def test_multimodal_turn_stores_and_replays_without_recall(wire_env):
+    from run_agent import AIAgent
+
+    make_agent, handler, db, sid = wire_env
+    image = {"type": "image_url", "image_url": {"url": "data:image/png;base64,AAAA"}}
+    with patch.object(AIAgent, "_model_supports_vision", return_value=True):
+        _with_recall(make_agent(), keep=False).run_conversation(
+            [{"type": "text", "text": "what is this"}, image], conversation_history=[], task_id="t1")
+    sent = _user_messages(_chat_requests(handler)[0])[0]["content"]
+    assert any("<memory-context>" in (p.get("text") or "") for p in sent)
+    history = db.get_messages_as_conversation(sid)
+    assert "memory-context" not in str(history[0]["content"]) and "PLUGIN-CTX" in str(history[0]["content"])
+    handler.captured_requests = []
+    with patch.object(AIAgent, "_model_supports_vision", return_value=True):
+        _with_recall(make_agent(), keep=False).run_conversation("and what about the second picture", conversation_history=history, task_id="t2")
+    users = _user_messages(_chat_requests(handler)[0])
+    assert "memory-context" not in str(users[0]["content"]) and "<memory-context>" in str(users[-1]["content"])
