diff --git a/agent/memory_context.py b/agent/memory_context.py
index 2075328f..6991cd27 100644
--- a/agent/memory_context.py
+++ b/agent/memory_context.py
@@ -9,6 +9,7 @@ from __future__ import annotations
 
 import logging
 import re
+from typing import Any
 
 logger = logging.getLogger(__name__)
 
@@ -183,3 +184,55 @@ def build_memory_context_block(raw_context: str) -> str:
         f"{clean}\n"
         "</memory-context>"
     )
+
+
+# memory.recall_history (default true): with false, recalled memory rides only the turn it was recalled for.
+# Every block otherwise stays in its user row and is re-sent with every later request and fed to the
+# summarizer, so a long chat carries one recall block per user turn (often 4K+ tokens each).
+_RECALL_BLOCK_RE = re.compile(r'\s*<\s*memory-context\s*>[\s\S]*?</\s*memory-context\s*>', re.IGNORECASE)
+
+
+def strip_recalled_memory(content: Any) -> Any:
+    """*content* (a string or a list of parts) without its fenced recall blocks; the same object when it
+    has none. Text before and after a block is kept (a hook's context appended after the recall stays);
+    a text part that held only a recall block is dropped."""
+    if isinstance(content, str):
+        if "memory-context" not in content.lower():
+            return content
+        stripped = _RECALL_BLOCK_RE.sub("", content)
+        # A block that opened the text leaves the separator of what followed it.
+        return stripped.lstrip("\n") if _RECALL_BLOCK_RE.match(content) else stripped
+    if isinstance(content, list):
+        out: list[Any] = []
+        changed = False
+        for part in content:
+            text = part.get("text") if isinstance(part, dict) and part.get("type") in ("text", "input_text") else None
+            if isinstance(text, str) and "memory-context" in text.lower():
+                stripped = strip_recalled_memory(text)
+                changed = True
+                if stripped.strip():
+                    out.append({**part, "text": stripped.lstrip("\n")})
+                continue
+            out.append(part)
+        return out if changed else content
+    return content
+
+
+def cap_recalled_memory(text: str, max_chars: int) -> str:
+    """Recall text cut to about *max_chars* (0 = no cap) at line boundaries, with a note where the cut is.
+    Keeps the first quarter and the last three quarters: providers open with headings and often end with
+    their newest entries and a profile card (Honcho lists observations oldest first, then the peer card)."""
+    if not max_chars or max_chars <= 0 or not isinstance(text, str) or len(text) <= max_chars:
+        return text
+    head, tail = text[: max_chars // 4], text[len(text) - (max_chars - max_chars // 4):]
+    if "\n" in head:
+        head = head[: head.rfind("\n")]
+    if "\n" in tail:
+        tail = tail[tail.find("\n") + 1:]
+    cut = len(text) - len(head) - len(tail)
+    return f"{head.rstrip()}\n[... {cut:,} of {len(text):,} chars of recalled memory cut by memory.recall_max_chars ...]\n{tail}"
+
+
+def recall_history_kept(agent: Any) -> bool:
+    """Whether recalled memory stays in history (``memory.recall_history``, default true)."""
+    return getattr(agent, "_memory_recall_history", True) is not False
