From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: USA-RedDragon <USA-RedDragon@users.noreply.github.com>
Date: Wed, 11 Nov 2026 02:51:56 -0600
Subject: [PATCH] fix(agent): scope model.ollama_num_ctx to self-hosted routes

model.ollama_num_ctx was applied to whatever route an agent ran on, so a
config that pins num_ctx for a local Ollama capped the context window of
hosted and process:// providers in the same config to that value, and a
live /model switch or fallback kept the previous route's num_ctx.

Apply the pin only when the active route is a self-hosted server Hermes
recognizes, and re-resolve it on /model switches, fallback activation
and primary restore.
---
 agent/agent_init_ollama.py             |  47 +++++++++-
 agent/agent_runtime_helpers.py         |   3 +
 agent/primary_runtime_snapshot.py      |   2 +
 agent/route_binding.py                 |   2 +
 cli-config.yaml.example                |   4 +-
 tests/agent/test_ollama_num_ctx.py     | 125 ++++++++++++++++++++++++-
 website/docs/integrations/providers.md |   2 +-
 7 files changed, 179 insertions(+), 6 deletions(-)

diff --git a/agent/agent_init_ollama.py b/agent/agent_init_ollama.py
index a5148d441a..1f6f2cad02 100644
--- a/agent/agent_init_ollama.py
+++ b/agent/agent_init_ollama.py
@@ -3,7 +3,23 @@
 from __future__ import annotations
 
 from agent.agent_runtime_helpers import _ra
-from agent.model_metadata import is_local_endpoint, query_ollama_num_ctx
+from agent.model_metadata import (
+    _infer_provider_from_url, detect_local_server_type, is_local_endpoint, query_ollama_num_ctx,
+)
+
+
+def _route_serves_num_ctx(agent) -> bool:
+    """True when the active route is a self-hosted server Hermes recognizes (Ollama, llama.cpp,
+    vLLM, LM Studio). ``model.ollama_num_ctx`` describes that server's window; a hosted API
+    (Ollama Cloud included) or a ``process://`` provider in the same config must never be clamped
+    to it."""
+    if not agent.base_url or _infer_provider_from_url(agent.base_url) is not None:
+        return False
+    _key = agent.api_key if isinstance(agent.api_key, str) else ""
+    try:
+        return detect_local_server_type(agent.base_url, api_key=_key or "") is not None
+    except Exception:
+        return False
 
 
 def _configure_ollama_num_ctx(agent, _model_cfg, _config_context_length):
@@ -13,9 +29,18 @@ def _configure_ollama_num_ctx(agent, _model_cfg, _config_context_length):
     _override = _model_cfg.get("ollama_num_ctx") if isinstance(_model_cfg, dict) else None
     if _override is not None:
         try:
-            agent._ollama_num_ctx = int(_override)
+            _pinned = int(_override)
         except (TypeError, ValueError):
+            _pinned = None
             _ra().logger.debug("Invalid ollama_num_ctx config value: %r", _override)
+        if _pinned is not None and _route_serves_num_ctx(agent):
+            agent._ollama_num_ctx = _pinned
+        elif _pinned is not None:
+            _ra().logger.debug(
+                "model.ollama_num_ctx=%d ignored for %s at %s: not a self-hosted inference server",
+                _pinned, agent.model, agent.base_url or agent.provider,
+            )
+            return
     if agent._ollama_num_ctx is None and agent.base_url and is_local_endpoint(agent.base_url):
         try:
             # api_key may be a callable (Entra token provider); detection needs a string.
@@ -38,7 +63,7 @@ def _configure_ollama_num_ctx(agent, _model_cfg, _config_context_length):
             agent._ollama_num_ctx, _config_context_length,
         )
         agent._ollama_num_ctx = _config_context_length
-    if agent._ollama_num_ctx and not agent.quiet_mode:
+    if agent._ollama_num_ctx and not getattr(agent, "quiet_mode", True):
         # Name the real source: a config override is honoured on any local server, /api/show is Ollama-only.
         _ra().logger.info(
             "Local server num_ctx: will request %d tokens (%s)",
@@ -65,3 +90,19 @@ def _clamp_compressor_to_ollama_num_ctx(agent):
             model=agent.model, context_length=agent._ollama_num_ctx, base_url=agent.base_url,
             api_key=getattr(agent, "api_key", ""), provider=agent.provider, api_mode=agent.api_mode,
         )
+
+
+def refresh_ollama_num_ctx(agent) -> None:
+    """Re-resolve num_ctx for the route a live agent was just moved to (``/model``, fallback).
+
+    Construction resolves it once; without this the previous route's value kept being sent and
+    kept clamping the compressor of a hosted model, and a session moved onto Ollama sent none.
+    """
+    try:
+        from hermes_cli.config import load_config_readonly
+        _model_cfg = (load_config_readonly() or {}).get("model", {})
+    except Exception:
+        _model_cfg = {}
+    _configure_ollama_num_ctx(agent, _model_cfg, getattr(agent, "_config_context_length", None))
+    if getattr(agent, "context_compressor", None) is not None:
+        _clamp_compressor_to_ollama_num_ctx(agent)
