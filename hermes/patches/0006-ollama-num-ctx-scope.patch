@@ -210,3 +211,125 @@ class TestFloorRefusalNamesTheLocalServerHonestly:
         with pytest.raises(ValueError, match="model.context_length") as exc:
             _build_agent({"agent": {}, "model": {}}, probed_ctx=32768, base_url="https://openrouter.ai/api/v1")
         assert "ollama_num_ctx" not in str(exc.value)
+
+
+# ═══════════════════════════════════════════════════════════════════════
+# Level 4: model.ollama_num_ctx belongs to the self-hosted route only.
+# A config that pins num_ctx for its local Ollama must not clamp a hosted
+# or process-backed model the same session (or another chat) runs on.
+# ═══════════════════════════════════════════════════════════════════════
+
+_OLLAMA_URL = "http://ollama.example.internal:11434/v1"
+_HOSTED_URL = "https://llm.example.com/v1"
+_WINDOWS = {_OLLAMA_URL: 262144, _HOSTED_URL: 1_000_000}
+_PIN_CFG = {"agent": {}, "model": {"ollama_num_ctx": 131072}}
+
+
+def _window_for(model, base_url="", *args, **kwargs):
+    return _WINDOWS.get((base_url or "").rstrip("/"), 262144)
+
+
+def _server_type_for(base_url, api_key=""):
+    return "ollama" if (base_url or "").rstrip("/") == _OLLAMA_URL else None
+
+
+@pytest.fixture
+def route_env():
+    import agent.context_compressor as cc_mod
+    from contextlib import ExitStack
+    with ExitStack() as stack:
+        for target, kwargs in (
+            ("model_tools.get_tool_definitions", {"return_value": []}),
+            ("model_tools.check_toolset_requirements", {"return_value": {}}),
+            ("hermes_cli.config.load_config", {"return_value": _PIN_CFG}),
+            ("hermes_cli.config.load_config_readonly", {"return_value": _PIN_CFG}),
+            ("agent.model_metadata.get_model_context_length", {"side_effect": _window_for}),
+            ("agent.agent_init_ollama.detect_local_server_type", {"side_effect": _server_type_for}),
+            ("agent.agent_init_ollama.query_ollama_num_ctx", {"return_value": None}),
+        ):
+            stack.enter_context(patch(target, **kwargs))
+        stack.enter_context(patch("agent.process_bootstrap.OpenAI"))
+        stack.enter_context(patch.object(cc_mod, "get_model_context_length", side_effect=_window_for))
+        yield
+
+
+def _make_agent(base_url, model, **kwargs):
+    from run_agent import AIAgent
+    return AIAgent(
+        model=model, provider="custom", api_key="sk-test", base_url=base_url,
+        quiet_mode=True, skip_context_files=True, skip_memory=True, **kwargs,
+    )
+
+
+def _wire_options(agent):
+    from agent.chat_completion_helpers import _build_api_kwargs_for_mode
+    kwargs = _build_api_kwargs_for_mode(agent, [{"role": "user", "content": "hi"}], [])
+    return (kwargs.get("extra_body") or {}).get("options")
+
+
+def _assert_on_ollama(agent):
+    assert agent._ollama_num_ctx == 131072
+    assert agent.context_compressor.context_length == 131072
+    assert _wire_options(agent) == {"num_ctx": 131072}
+
+
+def _assert_on_hosted(agent):
+    assert agent._ollama_num_ctx is None
+    assert agent.context_compressor.context_length == 1_000_000
+    assert _wire_options(agent) is None
+
+
+class TestNumCtxPinIsScopedToTheSelfHostedRoute:
+    def test_pin_applies_on_the_ollama_route(self, route_env):
+        _assert_on_ollama(_make_agent(_OLLAMA_URL, "qwen3:32b"))
+
+    def test_pin_neither_sent_nor_capping_on_a_hosted_route(self, route_env):
+        ollama = _make_agent(_OLLAMA_URL, "qwen3:32b")
+        hosted = _make_agent(_HOSTED_URL, "big-model")
+        _assert_on_ollama(ollama)
+        _assert_on_hosted(hosted)
+
+    def test_process_provider_is_not_a_num_ctx_route(self):
+        """``process://`` routes count as local endpoints (unqualified host) but never serve num_ctx."""
+        from types import SimpleNamespace
+        from agent.agent_init_ollama import _route_serves_num_ctx
+        from agent.model_metadata import is_local_endpoint
+        url = "process://claude-subscription"
+        assert is_local_endpoint(url)
+        assert not _route_serves_num_ctx(SimpleNamespace(base_url=url, api_key=""))
+
+    def test_hosted_ollama_cloud_is_not_a_num_ctx_route(self):
+        from types import SimpleNamespace
+        from agent.agent_init_ollama import _route_serves_num_ctx
+        with patch("agent.agent_init_ollama.detect_local_server_type", return_value="ollama") as probe:
+            assert not _route_serves_num_ctx(SimpleNamespace(base_url="https://ollama.com/v1", api_key=""))
+        probe.assert_not_called()
+
+    def test_switch_from_ollama_to_hosted_and_back(self, route_env):
+        agent = _make_agent(_OLLAMA_URL, "qwen3:32b")
+        _assert_on_ollama(agent)
+        agent.switch_model("big-model", "custom", api_key="sk-test", base_url=_HOSTED_URL,
+                           api_mode="chat_completions")
+        _assert_on_hosted(agent)
+        agent.switch_model("qwen3:32b", "custom", api_key="sk-test", base_url=_OLLAMA_URL,
+                           api_mode="chat_completions")
+        _assert_on_ollama(agent)
+
+    def test_switch_from_hosted_onto_ollama_picks_up_the_pin(self, route_env):
+        agent = _make_agent(_HOSTED_URL, "big-model")
+        _assert_on_hosted(agent)
+        agent.switch_model("qwen3:32b", "custom", api_key="sk-test", base_url=_OLLAMA_URL,
+                           api_mode="chat_completions")
+        _assert_on_ollama(agent)
+
+    def test_fallback_to_hosted_and_primary_restore(self, route_env):
+        from agent.error_classifier import FailoverReason
+        agent = _make_agent(_OLLAMA_URL, "qwen3:32b", fallback_model={
+            "provider": "custom", "model": "big-model", "base_url": _HOSTED_URL, "api_key": "sk-test",
+        })
+        assert agent._try_activate_fallback(FailoverReason.rate_limit)
+        _assert_on_hosted(agent)
+        agent._rate_limited_until = 0
+        assert agent._restore_primary_runtime()
+        _assert_on_ollama(agent)
+
