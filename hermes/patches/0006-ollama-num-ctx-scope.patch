--- a/tests/agent/test_ollama_num_ctx.py
+++ b/tests/agent/test_ollama_num_ctx.py
@@ -126,9 +126,10 @@ class TestQueryOllamaSupportsVision:
 # ═══════════════════════════════════════════════════════════════════════
 
 
-def _build_agent(cfg, probed_ctx, base_url="http://localhost:11434/v1"):
+def _build_agent(cfg, probed_ctx, base_url="http://localhost:11434/v1", server_type="ollama"):
