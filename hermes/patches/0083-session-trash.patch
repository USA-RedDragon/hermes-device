diff --git a/tests/gateway/test_session_trash_delete.py b/tests/gateway/test_session_trash_delete.py
new file mode 100644
index 00000000..ac79cf00
--- /dev/null
+++ b/tests/gateway/test_session_trash_delete.py
@@ -0,0 +1,53 @@
+"""The gateway's DELETE (what the hub calls) moves a chat to the trash instead of removing it."""
+import asyncio
+import json
+import sqlite3
+
+import httpx
+import pytest
+from websockets.asyncio.client import connect
+
+from hermes_state import SessionDB
+from tests.gateway.test_native_http_auth import daemon, headers, ticket
+from tests.gateway.test_session_mutation_reset import reset_round
+
+
+async def _listed(home, descriptor):
+    async with connect(descriptor['api_origin'].replace('http:', 'ws:') + '/api/ws', subprotocols=[
+            'hermes-gateway-v1', 'hermes-gateway-ticket.' + ticket(home, descriptor, 'interactive')]) as ws:
+        await ws.send(json.dumps({'id': 1, 'method': 'session.list', 'params': {'limit': 200}}))
+        while True:
+            result = json.loads(await ws.recv())
+            if result.get('id') == 1:
+                return {row['session_id'] for row in result['result']['sessions']}
+
+
+@pytest.mark.platforms("linux")
+def test_delete_trashes_hides_from_the_list_and_restores(tmp_path):
+    with daemon(tmp_path, trash_days=7) as (home, descriptor), \
+            httpx.Client(base_url=descriptor['api_origin'], trust_env=False) as client:
+        params, reset = asyncio.run(reset_round(home, descriptor))
+        sid, target = params['session_id'], reset['target_session_id']
+        assert sid in asyncio.run(_listed(home, descriptor))
+
+        response = client.delete('/api/sessions/' + sid, params={'request_id': 'trash-it',
+            'expected_revision': reset['revision'], 'expected_generation': reset['execution_generation']},
+            headers=headers(ticket(home, descriptor)))
+        assert response.status_code == 200, response.text
+        assert set(response.json()['deleted_ids']) == {sid, target}
+
+        # Rows stay, trash markers are written, the route is gone, and the list no longer shows it.
+        with sqlite3.connect(home / 'state.db') as db:
+            assert db.execute('SELECT COUNT(*) FROM sessions WHERE id IN (?,?)', (sid, target)).fetchone()[0] == 2
+            marked = {row[0] for row in db.execute("SELECT key FROM state_meta WHERE key LIKE 'gateway.trash.v1.%'")}
+            assert marked == {'gateway.trash.v1.' + sid, 'gateway.trash.v1.' + target}
+            assert not any(json.loads(row[0])['session_id'] in {sid, target}
+                           for row in db.execute('SELECT entry_json FROM gateway_routing'))
+        assert sid not in asyncio.run(_listed(home, descriptor))
+
+        # Restore (what `hermes sessions restore` does) lifts the markers and the chat reads again.
+        with SessionDB(home / 'state.db') as db:
+            assert [r['id'] for r in db.list_trash()] == [sid]
+            assert db.get_session(sid) is None
+            assert sorted(db.restore_session(sid)) == sorted([sid, target])
+            assert db.get_session(sid) is not None
