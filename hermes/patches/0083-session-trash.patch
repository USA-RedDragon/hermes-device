+"""Deleting a chat moves it to a trash: hidden everywhere, restorable until sessions.trash_days pass."""
+import json
+import sys
+import time
+
+import pytest
+
+from hermes_state import SessionDB
+from hermes_state_trash import TRASH_PREFIX
+
+NEEDLE = "zebracrossing"
+
+
+@pytest.fixture
+def db(tmp_path, trash_on):
+    database = SessionDB(tmp_path / "state.db")
+    try:
+        yield database
+    finally:
+        database.close()
+
+
+def _chat(db, sid, *, text=None, ended=False, **kw):
+    db.create_session(sid, source="cli", **kw)
+    db.append_message(session_id=sid, role="user", content=text or f"hello {sid}")
+    if ended:
+        db.end_session(sid, "done")
+
+
+def _family(db):
+    """P with a delegate child C; the child also says the needle."""
+    _chat(db, "P", text=f"parent says {NEEDLE}")
+    db.create_session("C", source="cli", parent_session_id="P", model_config={"_delegate_from": "P"})
+    db.append_message(session_id="C", role="user", content=f"child says {NEEDLE} too")
+
+
+def _listed(db):
+    return {s["id"] for s in db.list_sessions_rich(limit=100, include_children=True)}
+
+
+def _hits(db):
+    return {m["session_id"] for m in db.search_messages(NEEDLE)}
+
+
+def _rows(db, sid):
+    return db._conn.execute("SELECT COUNT(*) FROM messages WHERE session_id = ?", (sid,)).fetchone()[0]
+
+
+def test_delete_then_restore_brings_back_children_and_search(db):
+    _family(db)
+    assert _hits(db) == {"P", "C"}
+
+    assert db.delete_session("P") is True
+
+    # Hidden everywhere, rows kept.
+    assert "P" not in _listed(db) and "C" not in _listed(db)
+    assert _hits(db) == set()
+    assert db.get_session("P") is None and db.resolve_session_id("P") is None
+    assert _rows(db, "P") == 1 and _rows(db, "C") == 1
+    rows = db.list_trash()
+    assert [(r["id"], r["children"], r["message_count"]) for r in rows] == [("P", 1, 2)]
+
+    assert sorted(db.restore_session("P")) == ["C", "P"]
+
+    assert "P" in _listed(db)
+    assert _hits(db) == {"P", "C"}
+    assert db.get_session("P")["id"] == "P"
+    assert db.list_trash() == []
+
+
+def test_restore_by_child_id_or_prefix_restores_the_chat(db):
+    _family(db)
+    db.delete_session("P")
+    assert db.resolve_trashed_id("P") == "P"
+    assert db.resolve_trashed_id("nope") is None
+    assert sorted(db.restore_session("P")) == ["C", "P"]
+    assert db.restore_session("P") == []
+
+
+def test_trashed_chat_keeps_pin_and_system_prompt(db):
+    db.create_session("pinned", source="cli", system_prompt="sys prompt body")
+    db.append_message(session_id="pinned", role="user", content="x")
+    db.set_session_pinned("pinned", True)
+    db.delete_session("pinned")
+    prompts = db._conn.execute("SELECT COUNT(*) FROM system_prompts").fetchone()[0]
+    assert prompts >= 1
+    assert db.list_trash()[0]["pinned"] is True
+    db.restore_session("pinned")
+    assert db.get_session("pinned")["pinned"] == 1
+    assert "pinned" in {s["id"] for s in db.list_sessions_rich(limit=10, include_pinned=True)}
+
+
+def test_trashing_does_not_notify_plugins_but_purge_does(db, monkeypatch):
+    events = []
+    monkeypatch.setattr("hermes_state_common.emit_session_deleted",
+                        lambda _db, ids, **kw: events.append((sorted(ids), kw.get("reason"))))
+    monkeypatch.setattr("hermes_state_sessions.emit_session_deleted",
+                        lambda _db, ids, **kw: events.append((sorted(ids), kw.get("reason"))))
+    _family(db)
+    db.delete_session("P")
+    assert events == []
+    assert db.delete_session("P", purge=True) is True
+    assert events and events[0][0] == ["C", "P"]
+
+
+def test_bulk_delete_goes_to_the_trash(db):
+    for n in range(5):
+        _chat(db, f"s{n}", ended=True)
+    assert db.delete_sessions(["s0", "s1", "s2", "s3"]) == 4
+    assert {r["id"] for r in db.list_trash()} == {"s0", "s1", "s2", "s3"}
+    assert _listed(db) == {"s4"}
+    assert all(_rows(db, f"s{n}") == 1 for n in range(4))
+
+
+def test_prune_and_clean_go_to_the_trash(db):
+    _chat(db, "old", ended=True)
+    db.create_session("blank", source="cli")
+    db.end_session("blank", "done")
+    assert db.delete_empty_sessions() == 1
+    assert [r["id"] for r in db.list_trash()] == ["blank"]
+    assert db.get_session("blank") is None
+    assert db.prune_sessions(older_than_days=0) == 1
+    assert {r["id"] for r in db.list_trash()} == {"old", "blank"}
+    assert _rows(db, "old") == 1
+    # A second prune or clean never touches what is in the trash.
+    assert db.prune_sessions(older_than_days=0) == 0
+    assert db.delete_empty_sessions() == 0
+
+
+def test_purge_after_trash_days(db):
+    _family(db)
+    _chat(db, "keep")
+    _chat(db, "later")
+    db.delete_session("P")
+    db.delete_session("later")
+    # P was trashed 8 days ago; "later" a minute ago.
+    old = time.time() - 8 * 86400
+    db._execute_write(lambda c: c.execute(
+        "UPDATE state_meta SET value = json_set(value, '$.deleted_at', ?) WHERE key IN (?, ?)",
+        (old, TRASH_PREFIX + "P", TRASH_PREFIX + "C")))
+    assert db.purge_expired_trash() == 1
+    assert db._conn.execute("SELECT COUNT(*) FROM sessions WHERE id IN ('P','C')").fetchone()[0] == 0
+    assert _rows(db, "P") == 0 and _rows(db, "C") == 0
+    assert db._conn.execute("SELECT COUNT(*) FROM state_meta WHERE key LIKE ?", (TRASH_PREFIX + "%",)).fetchone()[0] == 1
+    assert [r["id"] for r in db.list_trash()] == ["later"]
+    assert db.get_session("keep") is not None
+    assert _hits(db) == set()
+
+
+def test_a_delete_purges_what_expired(db):
+    _chat(db, "a")
+    _chat(db, "b")
+    db.delete_session("a")
+    old = time.time() - 9 * 86400
+    db._execute_write(lambda c: c.execute(
+        "UPDATE state_meta SET value = json_set(value, '$.deleted_at', ?) WHERE key = ?", (old, TRASH_PREFIX + "a")))
+    db.delete_session("b")
+    assert [r["id"] for r in db.list_trash()] == ["b"]
+    assert db._conn.execute("SELECT COUNT(*) FROM sessions WHERE id = 'a'").fetchone()[0] == 0
+
+
+def test_purge_flag_deletes_now_even_when_trashed(db):
+    _chat(db, "x")
+    assert db.delete_session("x", purge=True) is True
+    assert db.list_trash() == []
+    assert db._conn.execute("SELECT COUNT(*) FROM sessions WHERE id = 'x'").fetchone()[0] == 0
+    _chat(db, "y")
+    db.delete_session("y")
+    assert db.delete_session("y", purge=True) is True
+    assert db.list_trash() == []
+    assert db._conn.execute("SELECT COUNT(*) FROM state_meta WHERE key = ?", (TRASH_PREFIX + "y",)).fetchone()[0] == 0
+
+
+def test_trash_days_zero_deletes_at_once(tmp_path, monkeypatch, trash_on):
+    monkeypatch.setenv("HERMES_SESSIONS_TRASH_DAYS", "0")
+    with SessionDB(tmp_path / "state.db") as db:
+        _chat(db, "gone")
+        db.delete_session("gone")
+        assert db.list_trash() == []
+        assert db._conn.execute("SELECT COUNT(*) FROM sessions WHERE id = 'gone'").fetchone()[0] == 0
+
+
+def test_hub_delete_hides_the_chat_from_the_gateway_list_and_restore_returns_it(db):
+    """The gateway/hub delete (session.mutate delete) trashes; the picker list reads the same store."""
+    from hermes_state_runtime import begin_runtime_epoch, mutate_runtime_session
+    _family(db)
+    _chat(db, "other")
+    epoch = begin_runtime_epoch(db, instance_id="owner")
+    result = mutate_runtime_session(
+        db, epoch=epoch, principal_id="p", session_id="P", request_id="r1", expected_revision=0,
+        expected_generation=0, operation="delete", payload={})
+    assert sorted(result["deleted_ids"]) == ["C", "P"]
+    picker = {s["id"] for s in db.list_sessions_rich(limit=200, order_by_last_active=True, include_pinned=True)}
+    assert picker == {"other"}
+    assert [r["id"] for r in db.list_trash()] == ["P"]
+    assert db.restore_session("P")
+    picker = {s["id"] for s in db.list_sessions_rich(limit=200, order_by_last_active=True, include_pinned=True)}
+    assert picker == {"other", "P"}
+
+
+def test_trashed_chat_fences_new_admissions_until_restored(db):
+    from hermes_state_mutation_retirement import RETIRED_PREFIX
+    _chat(db, "f")
+    db.delete_session("f")
+    assert db._conn.execute("SELECT 1 FROM state_meta WHERE key = ?", (RETIRED_PREFIX + "f",)).fetchone()
+    db.restore_session("f")
+    assert db._conn.execute("SELECT 1 FROM state_meta WHERE key = ?", (RETIRED_PREFIX + "f",)).fetchone() is None
+
+
+def _run_cli(monkeypatch, db, *argv):
+    import hermes_cli.main as main_mod
+    import hermes_state
+    monkeypatch.setattr(hermes_state, "SessionDB", lambda *a, **k: db)
+    monkeypatch.setattr(db, "close", lambda: None)
+    monkeypatch.setattr(sys, "argv", ["hermes", "sessions", *argv])
+    main_mod.main()
+
+
+def test_cli_delete_trash_restore_and_purge(db, monkeypatch, capsys):
+    _family(db)
+    _run_cli(monkeypatch, db, "delete", "P", "--yes")
+    out = capsys.readouterr().out
+    assert "Moved session 'P' to the trash" in out and "hermes sessions restore P" in out
+
+    _run_cli(monkeypatch, db, "trash")
+    out = capsys.readouterr().out
+    assert "P" in out and "+1 child" in out and "hermes sessions restore <id>" in out
+
+    _run_cli(monkeypatch, db, "restore", "P")
+    assert "Restored session 'P' and 1 child session" in capsys.readouterr().out
+    assert db.get_session("P") is not None
+
+    _run_cli(monkeypatch, db, "delete", "P", "--yes", "--purge")
+    assert "Deleted session 'P'." in capsys.readouterr().out
+    _run_cli(monkeypatch, db, "trash")
+    assert "The trash is empty." in capsys.readouterr().out
+    assert db._conn.execute("SELECT COUNT(*) FROM sessions WHERE id = 'P'").fetchone()[0] == 0
+
+
+def test_cli_prune_says_how_many_and_how_to_restore(db, monkeypatch, capsys):
+    _chat(db, "old1", ended=True)
+    _chat(db, "old2", ended=True)
+    _run_cli(monkeypatch, db, "prune", "--older-than", "0", "--yes", "--force")
+    out = capsys.readouterr().out
+    assert "Pruned 2 session(s)." in out
+    assert "hermes sessions trash" in out and "hermes sessions restore <id>" in out
+    assert len(db.list_trash()) == 2
+
+
+def test_cli_restore_unknown_id_fails(db, monkeypatch, capsys):
+    with pytest.raises(SystemExit):
+        _run_cli(monkeypatch, db, "restore", "missing")
+    assert "No trashed session matches 'missing'" in capsys.readouterr().out
