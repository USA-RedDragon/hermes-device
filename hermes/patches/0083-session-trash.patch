+def _bulk_delete_notice(db, count, verb) -> str:
+    """The line a bulk delete prints: how many, and (with the trash on) how to bring them back."""
+    line = f"{verb} {count} session(s)."
+    from hermes_state_trash import configured_trash_days
+    if count and configured_trash_days():
+        line += (f" They are in the trash for {configured_trash_days():g} days: list with `hermes sessions trash`, "
+                 "restore one with `hermes sessions restore <id>`.")
+    return line
+
+
+def _cmd_trash(db, args):
+    from hermes_cli.session_filters import format_epoch
+    from hermes_state_trash import configured_trash_days
+    rows = db.list_trash()
+    if not rows:
+        print("The trash is empty.")
+        return
+    days = configured_trash_days()
+    print(f"{'ID':<28} {'Deleted':<17} {'Msgs':>5}  {'Purged':<17} Title\n" + "─" * 100)
+    for r in rows:
+        purged = format_epoch(r["expires_at"]) if r.get("expires_at") else "next delete"
+        extra = f" (+{r['children']} child)" if r["children"] else ""
+        print(f"{r['id']:<28} {format_epoch(r['deleted_at']):<17} {r['message_count']:>5}  {purged:<17} "
+              f"{(r.get('title') or '')[:36]}{extra}{' [pinned]' if r['pinned'] else ''}")
+    print(f"\nRestore one with: hermes sessions restore <id>. Chats leave the trash after {days:g} days.")
+
+
+def _cmd_restore(db, args):
+    root = db.resolve_trashed_id(args.session_id)
+    if root is None:
+        print(f"No trashed session matches '{args.session_id}'. List them with: hermes sessions trash")
+        return 1
+    restored = db.restore_session(root)
+    if not restored:
+        print(f"Session '{root}' was not in the trash.")
+        return 1
+    kids = len(restored) - 1
+    print(f"Restored session '{root}'" + (f" and {kids} child session{'' if kids == 1 else 's'}" if kids else "") + ".")
+
+
