new file mode 100644
index 00000000..afcd8831
--- /dev/null
+++ b/hermes_state_trash.py
@@ -0,0 +1,152 @@
+"""Session trash: a delete hides a chat and keeps its rows until ``sessions.trash_days`` pass.
+
+A trashed session keeps every row (messages, FTS entries, usage, system prompts, pins). One
+``state_meta`` marker per session (``TRASH_PREFIX + id``) says it is trashed; every list, search,
+resolve and resume read skips a marked id (``not_trashed_sql``). ``restore`` removes the markers of
+the deleted chat and its children. ``purge`` is the upstream hard delete, and the only path that
+tells plugins (``on_session_delete``) and removes transcript files.
+"""
+import json
+import logging
+import os
+import time
+from pathlib import Path
+from typing import Any, Optional
+
+from hermes_state_keys import prefix_range
+
+logger = logging.getLogger(__name__)
+
+TRASH_PREFIX = "gateway.trash.v1."
+TRASH_DAYS_DEFAULT = 7.0
+# More ids than this in one call is a bulk delete: it always goes to the trash, never straight out.
+EXPLICIT_PURGE_MAX_IDS = 3
+
+
+def not_trashed_sql(alias: str = "s", column: str = "id") -> str:
+    """Predicate for ``alias`` rows that are not in the trash (a primary-key probe on state_meta)."""
+    return (f"NOT EXISTS (SELECT 1 FROM state_meta _trash WHERE _trash.key = '{TRASH_PREFIX}' || {alias}.{column})")
+
+
+def configured_trash_days() -> float:
+    """``sessions.trash_days``: days a deleted chat stays restorable; 0 = delete at once (upstream)."""
+    try:
+        raw = os.environ.get("HERMES_SESSIONS_TRASH_DAYS")  # overrides config.yaml
+        if raw is None or not raw.strip():
+            from hermes_cli.config import load_config_readonly
+            raw = (load_config_readonly().get("sessions") or {}).get("trash_days", TRASH_DAYS_DEFAULT)
+        days = float(raw)
+    except Exception:
+        return TRASH_DAYS_DEFAULT
+    return days if days > 0 else 0.0
+
+
+class SessionTrashMixin:
+    """Soft delete, listing, restore and purge for ``SessionDB``."""
+
+    def _soft_delete_enabled(self) -> bool:
+        return configured_trash_days() > 0
+
+    def _trash_in_transaction(self, conn, roots: dict, *, reason: str = "delete") -> list:
+        """Mark each id of *roots* (id -> the chat the user deleted) as trashed, inside the caller's
+        write transaction, and fence its routes so no turn is admitted against it while it is hidden.
+        Rows, messages, FTS entries, prompts and pins stay. Returns the ids marked."""
+        from hermes_state_mutation_retirement import retire_routes
+        now = time.time()
+        ids = list(roots)
+        for sid in ids:
+            conn.execute(
+                "INSERT OR REPLACE INTO state_meta(key,value) VALUES(?,?)",
+                (TRASH_PREFIX + sid, json.dumps({"deleted_at": now, "reason": reason, "root": roots[sid]})))
+        retire_routes(conn, ids)
+        return ids
+
+    def _trash_entries(self, conn) -> list:
+        lo, hi = prefix_range(TRASH_PREFIX)
+        out = []
+        for key, raw in conn.execute("SELECT key,value FROM state_meta WHERE key>=? AND key<?", (lo, hi)).fetchall():
+            try:
+                data = json.loads(raw)
+            except (TypeError, ValueError):
+                continue
+            if isinstance(data, dict):
+                out.append({"id": key[len(TRASH_PREFIX):], "deleted_at": float(data.get("deleted_at") or 0),
+                            "reason": data.get("reason") or "delete", "root": data.get("root") or key[len(TRASH_PREFIX):]})
+        return out
+
+    def list_trash(self) -> list:
+        """One row per trashed chat (the one the user deleted): id, title, deleted_at, expires_at,
+        message_count (its own and its children's), children, reason. Newest deletion first."""
+        days = configured_trash_days()
+        with self._read_ctx() as conn:
+            entries = self._trash_entries(conn)
+            groups: dict = {}
+            for e in entries:
+                groups.setdefault(e["root"], []).append(e)
+            rows = []
+            for root, members in groups.items():
+                ids = [m["id"] for m in members]
+                head = conn.execute("SELECT id, title, source, pinned FROM sessions WHERE id = ?", (root,)).fetchone()
+                if head is None:
+                    continue
+                marks = ",".join("?" for _ in ids)
+                count = conn.execute(
+                    f"SELECT COALESCE(SUM(message_count), 0) FROM sessions WHERE id IN ({marks})", ids).fetchone()[0]
+                at = max(m["deleted_at"] for m in members)
+                rows.append({"id": root, "title": head["title"], "source": head["source"], "pinned": bool(head["pinned"]),
+                             "deleted_at": at, "expires_at": at + days * 86400 if days else None,
+                             "message_count": int(count or 0), "children": len(ids) - 1,
+                             "reason": members[0]["reason"]})
+        rows.sort(key=lambda r: r["deleted_at"], reverse=True)
+        return rows
+
+    def resolve_trashed_id(self, id_or_prefix: str) -> Optional[str]:
+        """Exact id, else the single unambiguous prefix, among trashed chats (the ones a user deleted)."""
+        roots = [r["id"] for r in self.list_trash()]
+        if id_or_prefix in roots:
+            return id_or_prefix
+        matches = [r for r in roots if r.startswith(id_or_prefix)]
+        return matches[0] if len(matches) == 1 else None
+
+    def is_trashed(self, session_id: str) -> bool:
+        return self._read_one("SELECT 1 FROM state_meta WHERE key = ?", (TRASH_PREFIX + session_id,)) is not None
+
+    def restore_session(self, id_or_prefix: str) -> list:
+        """Bring a trashed chat back with its children (delegates, compression segments). Returns the
+        ids restored; empty when nothing matches. Its deletion fence is lifted, its pin and rows were kept."""
+        from hermes_state_mutation_retirement import RETIRED_PREFIX
+        root = self.resolve_trashed_id(id_or_prefix)
+        if root is None:
+            return []
+
+        def _do(conn):
+            ids = [e["id"] for e in self._trash_entries(conn) if e["root"] == root]
+            for sid in ids:
+                conn.execute("DELETE FROM state_meta WHERE key IN (?,?)", (TRASH_PREFIX + sid, RETIRED_PREFIX + sid))
+            return ids
+        return self._execute_write(_do) or []
+
+    def purge_expired_trash(self, days: Optional[float] = None, sessions_dir: Optional[Path] = None) -> int:
+        """Hard-delete chats trashed more than *days* (default ``sessions.trash_days``) ago. With
+        ``trash_days`` 0 nothing is ever held, so a leftover trash is purged whole. Returns chats purged."""
+        days = configured_trash_days() if days is None else float(days)
+        cutoff = time.time() - days * 86400
+        with self._read_ctx() as conn:
+            entries = self._trash_entries(conn)
+        roots = sorted({e["root"] for e in entries if e["deleted_at"] <= cutoff})
+        if not roots:
+            return 0
+        return self.delete_sessions(roots, sessions_dir=sessions_dir, purge=True)
+
+    def _forget_trash_marks(self, conn, ids) -> None:
+        for sid in ids:
+            conn.execute("DELETE FROM state_meta WHERE key = ?", (TRASH_PREFIX + sid,))
+
+
+def trash_notice(count: int, first_id: str = "") -> str:
+    """One line for a CLI that moved *count* chats to the trash."""
+    days = configured_trash_days()
+    keep = f"for {days:g} days" if days else ""
+    which = first_id if count == 1 and first_id else "<id>"
+    return (f"Moved {count} session{'' if count == 1 else 's'} to the trash {keep}. "
+            f"List: hermes sessions trash. Restore: hermes sessions restore {which}.").replace("  ", " ")
