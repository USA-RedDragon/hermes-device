+async def background_tool(connection, ref, params):
+    """``session.background_tool``: ask the running generation's tool workers to yield, so a
+    foreground terminal command moves to the background process registry and the turn goes on.
+    ``tool_call_id`` narrows the request to the worker running that call. A request only: tools
+    that cannot yield ignore it. ``status: 'none'`` when no worker was asked."""
+    tool_call_id = params.get('tool_call_id')
+    if (set(params) - {'session_id', 'profile', 'execution_generation', 'tool_call_id'}
+            or type(params.get('execution_generation')) is not int
+            or (tool_call_id is not None and (not isinstance(tool_call_id, str) or not tool_call_id))):
+        raise RuntimeStoreError('invalid_params')
+    authorize(connection, ref, params, 'session:control')
+    authority = connection.authority
+    generation = params['execution_generation']
+    live = authority.sessions[ref.session_id]
+    with live.event_stream.lock:
+        authority.check_approval_generation(ref.session_id, generation)
+        if ref.session_id in getattr(authority, '_managed_workers', {}):
+            raise RuntimeStoreError('unsupported_control')
+        agent, _ = authority.steer_agent(ref, generation, None)
+        request = getattr(agent, 'request_tool_yield', None)
+        count = request(tool_call_id) if callable(request) else 0
+    return {'status': 'requested' if count else 'none', 'count': count,
+            'execution_generation': generation, 'authority_epoch': authority.epoch}
