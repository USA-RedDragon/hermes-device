index 0000000000..038994dde3
--- /dev/null
+++ b/tests/gateway/test_session_background_tool.py
@@ -0,0 +1,266 @@
+"""``session.background_tool`` moves a running foreground terminal command to the background.
+
+A client sees a long foreground command (a build, a ``sleep`` poller) blocking the turn and asks
+the owner to background it. The verb is fenced like ``session.steer`` (``session:control`` and the
+running execution generation) and asks the turn agent's tool workers to yield
+(``AIAgent.request_tool_yield``): the terminal tool hands the live process to the process registry
+and returns; other tools ignore the request. ``tool_call_id`` narrows it to the one worker running
+that call, and an id no worker runs yields nothing.
+"""
+import asyncio
+import json
+import os
+import threading
+import time
+from contextlib import asynccontextmanager, contextmanager
+from types import SimpleNamespace
+
+import pytest
+
+from agent.interrupt_control import InterruptControlMixin
+from agent.tool_executor import _registered_tool_worker
+from gateway.session_busy_controls import background_tool
+from gateway.session_contract import SessionActor
+from hermes_state_runtime import RuntimeStoreError
+from tests.gateway.test_session_authority_cancel_settlement import (
+    ACTOR, REF, _authority, _submit, _wire_turn_agent)
+from tools import interrupt as interrupt_mod
+from tui_gateway.contracts.registry import CANONICAL_METHODS
+
+
+class Agent(InterruptControlMixin):
+    _interrupt_requested = False
+    _pending_steer = None
+    _pending_redirect = None
+    api_mode = "chat_completions"
+
+    def __init__(self, executing=True):
+        self._executing_tools = executing
+        self._pending_steer_lock = threading.Lock()
+        self._pending_redirect_lock = threading.Lock()
+        self._tool_worker_threads = set()
+        self._tool_worker_threads_lock = threading.Lock()
+        self._tool_worker_call_ids = {}
+        self._execution_thread_id = None
+
+
+@contextmanager
+def _workers(agent, *call_ids):
+    """Park one registered tool worker per call id until the block exits; yields their tids."""
+    release, ready, tids = threading.Event(), [], {}
+
+    def run(call_id):
+        with _registered_tool_worker(agent, call_id) as tid:
+            tids[call_id] = tid
+            ready.append(call_id)
+            release.wait(10)
+
+    threads = [threading.Thread(target=run, args=(call_id,), daemon=True) for call_id in call_ids]
+    for thread in threads:
+        thread.start()
+    deadline = time.monotonic() + 5
+    while len(ready) < len(call_ids) and time.monotonic() < deadline:
+        time.sleep(0.01)
+    try:
+        yield tids
+    finally:
+        for tid in tids.values():
+            interrupt_mod.consume_yield(tid)
+        release.set()
+        for thread in threads:
+            thread.join(5)
+
+
+@asynccontextmanager
+async def _running_turn(tmp_path, monkeypatch, agent):
+    """A claimed running turn whose adopted agent is *agent*; yields (authority, generation)."""
+    from gateway import session_finite
+
+    db, authority = _authority(tmp_path, monkeypatch)
+    claimed, release = asyncio.Event(), asyncio.Event()
+
+    async def execute(authority, ref, row):
+        if agent is not None:
+            await asyncio.to_thread(_wire_turn_agent, authority, row['generation'], agent)
+        claimed.set()
+        await asyncio.wait_for(release.wait(), 30)
+        return 'done'
+
+    monkeypatch.setattr(session_finite, 'execute_finite_admission', execute)
+    with db:
+        await _submit(authority, 'running')
+        await asyncio.wait_for(claimed.wait(), 5)
+        try:
+            yield authority, authority._handle(REF).execution_generation
+        finally:
+            release.set()
+            await asyncio.wait_for(authority.sessions['s'].task, 5)
+
+
+async def _call(authority, params, actor=ACTOR):
+    return await background_tool(SimpleNamespace(authority=authority, actor=actor), REF, params)
+
+
+def _result(reply):
+    CANONICAL_METHODS['session.background_tool'].result.model_validate(reply)
+    return reply
+
+
+@pytest.mark.asyncio
+async def test_background_tool_asks_every_tool_worker_to_yield(tmp_path, monkeypatch):
+    agent = Agent()
+    async with _running_turn(tmp_path, monkeypatch, agent) as (authority, generation):
+        with _workers(agent, 'call-a', 'call-b') as tids:
+            reply = _result(await _call(authority, {'session_id': 's', 'execution_generation': generation}))
+
+            assert reply == {'status': 'requested', 'count': 2, 'execution_generation': generation,
+                             'authority_epoch': authority.epoch}
+            assert all(interrupt_mod.is_thread_yield_requested(tid) for tid in tids.values())
+
+
+@pytest.mark.asyncio
+async def test_tool_call_id_yields_only_the_worker_running_that_call(tmp_path, monkeypatch):
+    agent = Agent()
+    async with _running_turn(tmp_path, monkeypatch, agent) as (authority, generation):
+        with _workers(agent, 'call-a', 'call-b') as tids:
+            reply = _result(await _call(authority, {'session_id': 's', 'execution_generation': generation,
+                                                    'tool_call_id': 'call-b', 'profile': None}))
+
+            assert (reply['status'], reply['count']) == ('requested', 1)
+            assert interrupt_mod.is_thread_yield_requested(tids['call-b'])
+            assert not interrupt_mod.is_thread_yield_requested(tids['call-a'])
+
+            unknown = _result(await _call(authority, {'session_id': 's', 'execution_generation': generation,
+                                                      'tool_call_id': 'call-gone'}))
