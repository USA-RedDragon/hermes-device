+@pytest.mark.platforms("linux")
+@pytest.mark.live_system_guard_bypass
+@pytest.mark.asyncio
+async def test_background_tool_moves_a_running_terminal_command_to_the_background(tmp_path, monkeypatch):
+    """The real terminal tool on a registered worker: the verb hands its live process to the
+    registry and the tool call returns at once. The kill below needs real signal delivery
+    (see tests/tools/test_terminal_yield_to_background.py)."""
+    import psutil
+
+    from tools.process_registry import process_registry
+    from tools.terminal_tool import terminal_tool
+
+    agent = Agent()
+    res = {}
+
+    def worker():
+        with _registered_tool_worker(agent, 'call-term'):
+            res['result'] = json.loads(terminal_tool('echo started; sleep 60; echo done',
+                                                     task_id='background-tool-test', timeout=90))
+
+    async with _running_turn(tmp_path, monkeypatch, agent) as (authority, generation):
+        thread = threading.Thread(target=worker, daemon=True)
+        thread.start()
+        await asyncio.sleep(1.5)
+        reply = await _call(authority, {'session_id': 's', 'execution_generation': generation,
+                                        'tool_call_id': 'call-term'})
+        assert (reply['status'], reply['count']) == ('requested', 1)
+
+        await asyncio.to_thread(thread.join, 15)
+        assert not thread.is_alive(), 'terminal tool still blocked after session.background_tool'
+    r = res['result']
+    try:
+        assert r['status'] == 'yielded_to_background'
+        assert r['exit_code'] is None and 'started' in r['output']
+        assert os.path.exists(f"/proc/{r['pid']}")
+        assert process_registry.poll(r['session_id'])['status'] == 'running'
+        descendants = psutil.Process(r['pid']).children(recursive=True)
+    finally:
+        killed = process_registry.kill_process(r['session_id'])
+    assert killed['status'] == 'killed', killed
+    assert not any(process_registry._proc_alive(p) for p in descendants), 'orphaned descendant survived kill'
+    evt = process_registry.completion_queue.get(timeout=5)
+    assert evt['session_id'] == r['session_id']
