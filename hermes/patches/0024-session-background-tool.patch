+        with agent._tool_worker_threads_lock:
+            seen[call_id] = agent._tool_worker_call_ids.get(threading.current_thread().ident)
+        return json.dumps({"ok": name})
+
+    agent._invoke_tool = MagicMock(side_effect=_invoke)
