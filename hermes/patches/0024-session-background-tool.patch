+def test_concurrent_workers_record_their_tool_call_id(monkeypatch):
+    """Each worker maps its tid to the call it runs while it runs it, so a yield request
+    (``session.background_tool`` with ``tool_call_id``) reaches exactly that worker."""
+    agent = _make_agent(monkeypatch)
