--- /dev/null
+++ b/tests/tools/test_delegate_child_wait.py
@@ -0,0 +1,172 @@
+"""A subagent ends its turn waiting on a background process and is woken with its result.
+
+Built on the resume test's seams: real stored sessions, real async-delegation registry and process registry, fake
+child agents.
+"""
+
+import threading
+import time
+
+import pytest
+
+from tests.tools.test_delegate_resume_action import (  # noqa: F401  (fixtures)
+    CHILD, PARENT, SID, _Parent, _call, _clean_state, _completions, _db, _fake_child, _finished_child, seams,
+)
+from tests.waiting import wait_until
+from tools import async_delegation as ad
+from tools import delegate_tool_handoff as handoff
+from tools import delegate_tool_wait as wait
+from tools.delegate_tool_registry import _active_subagents, _active_subagents_lock, _list_payload
+from tools.process_registry import _handle_process, process_registry
+import json
+
+
+def _handoff(session_id, data="build", task_id=SID):
+    return json.loads(_handle_process(
+        {"action": "handoff", "session_id": session_id, "data": data, "resume_on_exit": True}, task_id=task_id))
+
+
+def _waiting_child(command, handoffs=1, second=None):
+    """A child whose first round starts ``command`` and hands it off (``handoffs`` times), then ends its turn."""
+    child = _fake_child()
+    seen = {"handoffs": [], "listed": None}
+
+    def converse(**kwargs):
+        child.conversations.append(kwargs)
+        if len(child.conversations) == 1:
+            session = process_registry.spawn_local(command, task_id=SID, owner_task_id=SID)
+            seen["session"] = session
+            for _ in range(handoffs):
+                seen["handoffs"].append(_handoff(session.id))
+            return {"final_response": "waiting for the build", "completed": True, "interrupted": False,
+                    "api_calls": 1, "messages": [{"role": "user", "content": "go"},
+                                                 {"role": "assistant", "content": "waiting for the build"}]}
+        return {"final_response": second or "Build finished: done", "completed": True, "interrupted": False,
+                "api_calls": 2, "messages": []}
+
+    child.run_conversation.side_effect = converse
+    child.seen = seen
+    return child
+
+
+def test_child_ends_its_turn_waiting_is_resumed_with_the_result_and_reports_once(seams):
+    db = _db()
+    _finished_child(db)
+    child = _waiting_child("sleep 5; echo done")
+    seams(child)
+    handle = _call(_Parent(db), subagent_id=SID, message="build it and wait")
+    run_id = handle["run_id"]
+
+    wait_until(lambda: len(child.conversations) == 1 and child.seen["handoffs"], what="the first round")
+    # While the job runs the child is waiting, not done, and nothing reaches the parent.
+    wait_until(lambda: any(r.get("status") == "waiting" for r in _active_subagents.values()), what="waiting status")
+    listed = _list_payload(_Parent(db))
+    assert listed["subagents"][0]["status"] == "waiting" and "sleep 5" in listed["subagents"][0]["waiting_on"][0]
+    assert _completions(run_id) == []
+    assert child.seen["handoffs"][0]["status"] == "watching"
+
+    event = wait_until(lambda: _completions(run_id), timeout=30, what="the child's final result")[0]
+    second = child.conversations[1]
+    assert "done" in second["user_message"] and "exited with code 0" in second["user_message"]
+    assert second["conversation_history"][-1]["content"] == "waiting for the build"
+    assert [r["summary"] for r in event["results"]] == ["Build finished: done"]
+    time.sleep(0.5)
+    assert _completions(run_id) == []  # delivered once
+
+
+def test_handing_off_the_same_command_again_returns_the_first_watch(seams):
+    db = _db()
+    _finished_child(db)
+    child = _waiting_child("sleep 2; echo done", handoffs=2)
+    seams(child)
+    handle = _call(_Parent(db), subagent_id=SID, message="go")
+    wait_until(lambda: len(child.seen["handoffs"]) == 2, what="both handoffs")
+    first, again = child.seen["handoffs"]
+    assert first["status"] == "watching" and again["status"] == "already_watched"
+    assert first["session_id"] == again["session_id"]
+    assert len(wait.waits_of(child)) <= 1
+    wait_until(lambda: _completions(handle["run_id"]), timeout=30, what="completion")
+
+
+def test_a_second_session_with_the_same_command_is_deduped():
+    child = _fake_child()
+    one = process_registry.spawn_local("sleep 3", task_id=SID, owner_task_id=SID)
+    two = process_registry.spawn_local("sleep 3", task_id=SID, owner_task_id=SID)
+    try:
+        a = wait.watch(child, one, "x", 24)
+        b = wait.watch(child, two, "x", 24)
+        assert a["created"] and not b["created"] and b["session_id"] == one.id
+        assert len(wait.waits_of(child)) == 1
+    finally:
+        process_registry.kill_process(one.id)
+        process_registry.kill_process(two.id)
+
+
+def test_wait_limit_resumes_with_a_timeout_notice():
+    child = _fake_child()
+    session = process_registry.spawn_local("sleep 30", task_id=SID, owner_task_id=SID)
+    try:
+        wait.watch(child, session, "x", 0.0)  # the limit has passed at once
+        message = wait.await_exit(child, None, lambda: False)
+        assert "Wait limit reached" in message and "still running" in message
+        assert wait.waits_of(child) == []
+    finally:
+        process_registry.kill_process(session.id)
+
+
+def test_stopping_a_waiting_child_ends_the_wait():
+    child = _fake_child()
+    session = process_registry.spawn_local("sleep 30", task_id=SID, owner_task_id=SID)
+    try:
+        wait.watch(child, session, "x", 24)
+        stop = threading.Timer(0.3, lambda: None)
+        flag = {"stop": False}
+        threading.Timer(0.3, lambda: flag.update(stop=True)).start()
+        assert wait.await_exit(child, None, lambda: flag["stop"]) is None
+    finally:
+        process_registry.kill_process(session.id)
+
+
+def test_restart_rearms_a_waiting_child(seams):
+    db = _db()
+    _finished_child(db)
+    child = _waiting_child("sleep 8; echo rearmed")
+    seams(child)
+    handle = _call(_Parent(db), subagent_id=SID, message="go")
+    run_id = handle["run_id"]
+    wait_until(lambda: any(r.get("status") == "waiting" for r in _active_subagents.values()), what="waiting")
+
+    # The old gateway stops the waiting child at a clean point; the unit and the process outlive it.
+    assert ad.hand_off_for_restart(2.0, 8.0) == 1
+    assert _completions(run_id) == []
+    row = json.loads(_row(run_id))
+    waits = row["handoff"]["children"]["0"]["waits"]
+    assert len(waits) == 1 and "sleep 8" in waits[0]["command"]
+    session = child.seen["session"]
+    assert not session.exited  # the job kept running
+
+    # The next gateway rebuilds the child; it goes on waiting instead of starting a conversation.
+    ad._reset_for_tests()
+    with _active_subagents_lock:
+        _active_subagents.clear()
+    second = _fake_child()
+    seams(second)
+    assert ad.adopt_handed_off_delegations(handoff._resume_unit) == 1
+    event = wait_until(lambda: _completions(run_id), timeout=30, what="the re-armed child's result")[0]
+    assert len(second.conversations) == 1  # one round only: the wake-up with the result
+    assert "rearmed" in second.conversations[0]["user_message"]
+    assert event["status"] == "completed"
+
+
+def _row(delegation_id):
+    from tests.tools.test_delegate_resume_action import _row_json
+    return _row_json(delegation_id)
+
+
+def test_the_child_prompt_and_tool_notes_name_the_wait():
+    from tools.delegate_tool_progress import _build_child_system_prompt
+    from tools.process_registry import PROCESS_SCHEMA
+    from tools.terminal_tool_background import _SUBAGENT_NOTIFY_NOTE
+    assert "resume_on_exit=true" in _build_child_system_prompt("g")
+    assert "resume_on_exit" in _SUBAGENT_NOTIFY_NOTE
+    assert "resume_on_exit" in PROCESS_SCHEMA["parameters"]["properties"]
