diff --git a/tools/delegate_tool_wait.py b/tools/delegate_tool_wait.py
new file mode 100644
index 00000000..94a6fa2c
--- /dev/null
+++ b/tools/delegate_tool_wait.py
@@ -0,0 +1,137 @@
+"""A subagent waits on a long background process and is woken with its result.
+
+``process_manage(action='handoff', session_id=..., data=..., resume_on_exit=true)`` registers a process the subagent
+started as a watch instead of giving it to the parent. When the subagent ends its turn with a watch open, its unit
+does not finish: the processes keep running, the subagent shows as ``waiting`` (``delegate_task(action='list')``,
+``subagent.list``), and when a watched process exits (or ``delegation.max_wait_hours`` pass) the subagent continues its
+conversation with the exit code and output tail as the next user message. Only its real final result reaches the parent.
+
+A watch is recorded on the subagent's resume state, so a gateway restart hands the waiting subagent to the next gateway,
+which reattaches the processes (checkpoint recovery) and goes on waiting.
+"""
+
+from __future__ import annotations
+
+import threading
+import time
+from typing import Any, Callable, Optional
+
+WAITS_ATTR = "_child_waits"
+MAX_WAITS = 8
+_POLL_SECONDS = 0.5
+_TOUCH_SECONDS = 30.0
+_TAIL_CHARS = 2000
+
+WAIT_NOTE = (
+    "To wait for a long background job (hours), start it with terminal(background=true), then call "
+    "process_manage(action='handoff', session_id=..., data='<what it is for>', resume_on_exit=true) and END YOUR TURN "
+    "with a one-line status. Hermes keeps the process running and wakes you with its exit code and output tail when it "
+    "exits (or after the wait limit); your parent sees you as waiting, not done, and gets your result only when you "
+    "finish. Do not poll in a loop, do not quit while the job runs, and do not hand it to your parent. Handing off the "
+    "same command twice returns the first watch."
+)
+
+
+def waits_of(child: Any) -> list[dict[str, Any]]:
+    return vars(child).setdefault(WAITS_ATTR, [])
+
+
+def watch(child: Any, session: Any, note: str, max_hours: float) -> dict[str, Any]:
+    """Register ``session`` as a watch of ``child``; ``(entry, created)`` as a dict with ``created``."""
+    waits = waits_of(child)
+    for existing in waits:
+        if existing["command"] == session.command or existing["session_id"] == session.id:
+            return {**existing, "created": False}
+    if len(waits) >= MAX_WAITS:
+        return {"error": f"wait cap reached ({MAX_WAITS} watched processes per subagent); kill or wait on the rest."}
+    now = time.time()
+    entry = {"session_id": session.id, "command": session.command, "note": note, "since": now,
+             "deadline": now + max(float(max_hours), 0.0) * 3600.0}
+    waits.append(entry)
+    return {**entry, "created": True}
+
+
+def state_waits(child: Any) -> list[dict[str, Any]]:
+    """The watches a restart handoff carries to the next gateway."""
+    return [dict(w) for w in vars(child).get(WAITS_ATTR) or []]
+
+
+def restore(child: Any, waits: Any) -> None:
+    if isinstance(waits, list):
+        vars(child)[WAITS_ATTR] = [dict(w) for w in waits if isinstance(w, dict) and w.get("session_id")]
+
+
+def _set_status(subagent_id: Optional[str], status: str, commands: list[str]) -> None:
+    if not subagent_id:
+        return
+    from tools.delegate_tool_registry import _active_subagents, _active_subagents_lock
+    with _active_subagents_lock:
+        record = _active_subagents.get(subagent_id)
+        if record is not None:
+            record["status"] = status
+            record["waiting_on"] = commands or None
+
+
+def _session(sid: str) -> Any:
+    from tools.process_registry import process_registry
+    return process_registry.get(sid)
+
+
+def _exited(session: Any) -> bool:
+    return session is None or bool(getattr(session, "exited", False))
+
+
+def _describe(entry: dict[str, Any], session: Any, timed_out: bool) -> str:
+    from tools.process_registry import _output_tail, process_registry
+    command = str(entry.get("command", ""))[:200]
+    if timed_out:
+        return (f"Wait limit reached for `{command}` ({entry['session_id']}): still running. It stays running and "
+                "is no longer watched. Check it with process_manage (poll/log), kill it, or report it as still running.")
+    if session is None:
+        return (f"`{command}` ({entry['session_id']}) is gone: Hermes has no record of it (lost in a restart?). Its "
+                "result is unknown; re-run it or report that.")
+    process_registry.poll(session.id)  # marks the result read, so it is not reported again as unread
+    tail = _output_tail(session, _TAIL_CHARS).strip()
+    return (f"`{command}` ({entry['session_id']}) exited with code {session.exit_code} "
+            f"({getattr(session, 'completion_reason', 'exited')}).\nOutput tail:\n{tail or '(no output)'}")
+
+
+def await_exit(child: Any, subagent_id: Optional[str], stopped: Callable[[], bool]) -> Optional[str]:
+    """Block until a watched process exits or its wait limit passes; the message that resumes the subagent, or None
+    when the subagent was stopped first. The subagent shows as ``waiting`` meanwhile and its activity clock keeps
+    ticking so the stale monitor does not take it for wedged."""
+    waits = waits_of(child)
+    _set_status(subagent_id, "waiting", [w["command"][:120] for w in waits])
+    last_touch = 0.0
+    pause = threading.Event()
+    try:
+        while True:
+            if stopped():
+                return None
+            now = time.time()
+            ready = []
+            for entry in list(waits):
+                session = _session(entry["session_id"])
+                if _exited(session):
+                    ready.append((entry, session, False))
+                elif now >= entry.get("deadline", now + 1):
+                    ready.append((entry, session, True))
+            if ready:
+                for entry, _s, _t in ready:
+                    waits.remove(entry)
+                lines = [_describe(*item) for item in ready]
+                return ("A process you were waiting on finished. Continue your task with its result.\n\n"
+                        + "\n\n".join(lines)
+                        + (f"\n\nStill watching {len(waits)} other process(es); end your turn again to keep waiting."
+                           if waits else ""))
+            if now - last_touch >= _TOUCH_SECONDS:
+                last_touch = now
+                touch = getattr(child, "_touch_activity", None)
+                if callable(touch):
+                    try:
+                        touch("waiting on a background process")
+                    except Exception:
+                        pass
+            pause.wait(_POLL_SECONDS)
+    finally:
+        _set_status(subagent_id, "running", [])
