diff --git a/gateway/session_events.py b/gateway/session_events.py
index 5aa86360..0ab5c973 100644
--- a/gateway/session_events.py
+++ b/gateway/session_events.py
@@ -33,6 +33,28 @@ class SessionEvents:
         # The running execution's open tool calls and its last frame time; a hosted room's info
         # poll reports them so the room shows which tool a member is in (``progress_for``).
         self._progress = None
+        # The running execution's reply text so far, in its current segment (``note_reply``); a resume
+        # hands it with the snapshot so a viewer that joins mid-reply needs no replay of its deltas.
+        self._reply = None
+
+    def note_reply(self, generation, event_type, payload):
+        """Record one execution frame's effect on the reply text (the caller holds ``lock`` across the
+        frame's ``publish`` and this, so the text matches the stream's sequence at every point)."""
+        reply = self._reply
+        if reply is None or reply['generation'] != generation:
+            reply = self._reply = {'generation': generation, 'text': ''}
+        text = payload.get('text') if isinstance(payload, dict) else None
+        if event_type == 'message.delta' and isinstance(text, str):
+            reply['text'] += text
+        elif event_type in ('message.delta', 'message.interim', 'message.start', 'message.complete',
+                            'tool.start', 'tool.generating'):
+            # A segment boundary: the next text is a new reply box.
+            reply['text'] = ''
+
+    def reply_for(self, generation):
+        """The reply text *generation* has streamed in its current segment, '' when none (caller holds ``lock``)."""
+        reply = self._reply
+        return reply['text'] if reply is not None and reply['generation'] == generation else ''
 
     def note_progress(self, generation, event_type, payload):
         """Record one execution frame (the caller holds ``lock`` and passed the generation fence)."""
diff --git a/tests/gateway/test_resume_inflight_reply.py b/tests/gateway/test_resume_inflight_reply.py
new file mode 100644
index 00000000..c0481215
--- /dev/null
+++ b/tests/gateway/test_resume_inflight_reply.py
@@ -0,0 +1,114 @@
+"""session.resume hands a running reply's text so far with the sequence it is current as of, so a viewer
+that joins mid-reply shows the reply from its start and applies only the frames after that sequence."""
+import asyncio
+import queue
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.session_events import SessionEvents
+
+
+def test_reply_text_follows_segments():
+    events = SessionEvents()
+    with events.lock:
+        for kind, text in (('message.delta', 'a'), ('message.delta', 'b')):
+            events.note_reply(1, kind, {'text': text})
+        assert events.reply_for(1) == 'ab'
+        assert events.reply_for(2) == ''
+        events.note_reply(1, 'tool.start', {'tool_id': 't'})
+        assert events.reply_for(1) == ''
+        events.note_reply(1, 'tool.complete', {'tool_id': 't'})
+        events.note_reply(1, 'message.delta', {'text': 'c'})
+        events.note_reply(1, 'reasoning.delta', {'text': 'x'})
+        assert events.reply_for(1) == 'c'
+        events.note_reply(1, 'message.delta', {'text': None})
+        assert events.reply_for(1) == ''
+        events.note_reply(2, 'message.delta', {'text': 'new turn'})
+        assert events.reply_for(1) == '' and events.reply_for(2) == 'new turn'
+
+
+@pytest.mark.asyncio
+async def test_resume_mid_reply_never_doubles_or_drops_text(tmp_path, monkeypatch):
+    from gateway.config import GatewayConfig, Platform
+    from gateway.session import SessionSource, SessionStore
+    from gateway.session_authority import LiveSession, initialize_session_authority
+    from gateway.session_contract import SessionRef, Submission
+    from gateway.session_controls import AuthorityConnection
+    from tui_gateway import event_replay
+
+    # The replay ring holds almost nothing, as for a long reply: only the inflight text can rebuild it.
+    monkeypatch.setattr(event_replay, '_REPLAY_BUFFER_MAX', 4)
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    store = SessionStore(tmp_path / 'sessions', GatewayConfig())
+    db = store._db
+    deltas = [f'chunk {i:04d} ' for i in range(3000)]
+    halfway, release = threading.Event(), threading.Event()
+    holder = {}
+
+    def stream():
+        authority, sid = holder['authority'], 'chat'
+        generation = authority.executing[sid]
+        for i, text in enumerate(deltas):
+            authority.publish_execution(sid, generation, 'message.delta', {'text': text})
+            if i == 100:
+                halfway.set()
+        release.wait(10)
+
+    async def answer(event):
+        await asyncio.to_thread(stream)
+        return ''.join(deltas)
+
+    runner = SimpleNamespace(_session_db=db, session_store=store, _draining=False,
+                             _handle_message=answer, _adapter_for_source=lambda source: None)
+    authority = holder['authority'] = await initialize_session_authority(runner, profile_id='p', instance_id='owner')
+    ref = SessionRef('p', 'chat')
+    source = SessionSource(platform=Platform.TELEGRAM, chat_id='chat')
+    db.create_session('chat', source='telegram')
+    authority.sessions['chat'] = LiveSession(source, 'chat')
+
+    class Peer:
+        def __init__(self):
+            self.frames = queue.Queue()
+
+        def write(self, frame):
+            self.frames.put(frame)
+            return True
+
+    starter = AuthorityConnection(authority, Peer(), {'user_id': 'viewer'})
+    await starter.resume(ref, {})
+    await authority.submit(starter.actor, Submission('1', ref, {'text': 'go'}, 'queue'))
+    await asyncio.to_thread(halfway.wait, 10)
+    # Viewers join while deltas keep coming from the agent thread.
+    joined = []
+    for _ in range(5):
+        peer = Peer()
+        conn = AuthorityConnection(authority, peer, {'user_id': 'viewer'})
+        snap = await conn.resume(ref, {})
+        joined.append((peer, conn, snap))
+        await asyncio.sleep(0)
+    release.set()
+    await authority.sessions['chat'].task
+    whole = ''.join(deltas)
+    try:
+        seeded = 0
+        for peer, _, snap in joined:
+            inflight = snap.get('inflight_reply')
+            text = inflight['text'] if inflight else ''
+            if inflight:
+                seeded += 1
+                assert inflight['sequence'] == snap['last_sequence']
+            while True:
+                frame = (await asyncio.to_thread(peer.frames.get, True, 5))['params']
+                if frame['type'] == 'message.complete':
+                    break
+                if frame['type'] == 'message.delta' and frame['seq'] > snap['last_sequence']:
+                    text += frame['payload']['text'] or ''
+            assert text == whole, f'joined at {snap["last_sequence"]}: {len(text)} of {len(whole)} chars'
+        assert seeded, 'no viewer joined while the reply streamed'
+    finally:
+        for _, conn, _ in joined:
+            await conn.close()
+        await starter.close()
+        store.close_all_db_handles()
