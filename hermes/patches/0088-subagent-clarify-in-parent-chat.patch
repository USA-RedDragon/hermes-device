+"""A background subagent's questions to the user: ``clarify`` for delegate_task children.
+
+The question goes to the chat that spawned the child, as the chat's own question card that names the subagent
+(``gateway/run_turn_runner.py`` ``_background_clarify_ask``), waits the configured clarify timeout, and the answer
+returns to the child. Only children of the chat's own agent get the tool, and only in a chat that can show the
+card; a child that an orchestrator joins inline has no chat of its own to ask in, and a session that joins its
+children (``delegation.gateway_mode`` inline) keeps its turn blocked on them, so both stay without it.
+"""
+
+from __future__ import annotations
+
+import logging
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger("tools.delegate_tool")
+
+_GOAL_CHARS = 160
+
+
+def subagent_label(goal: Any) -> str:
+    """The goal of a child, one line and short, as a card names the subagent that asks."""
+    text = " ".join(str(goal or "").split())
+    if len(text) > _GOAL_CHARS:
+        text = text[:_GOAL_CHARS - 1].rstrip() + "\u2026"
+    return text or "subagent"
+
+
+def asking_session_key(parent_agent: Any, child_depth: int) -> str:
+    """The session key a child of ``parent_agent`` may ask its questions under, or ``""`` when it may not ask.
+
+    The parent must hold ``clarify`` itself (a child never gains a tool its parent lacks), the child must be a
+    direct child of the chat's agent that the session does not join inline, and the chat must have an asker."""
+    if child_depth != 1 or "clarify" not in (getattr(parent_agent, "valid_tool_names", None) or ()):
+        return ""
+    from tools.delegate_tool import session_joins_delegation
+    if session_joins_delegation(parent_agent):
+        return ""
+    from tools.approval_context import get_current_session_key
+    from tools.clarify_gateway import get_subagent_asker
+    session_key = get_current_session_key(default="")
+    return session_key if session_key and get_subagent_asker(session_key) is not None else ""
+
+
+def child_clarify_callback(session_key: str, goal: Any) -> Optional[Callable[[list], dict]]:
+    """The ``clarify_callback`` of a child that asks under ``session_key``: it hands the questions to the chat's
+    asker as of the moment of the call (the chat's turn may have ended, or another begun, since the spawn)."""
+    if not session_key:
+        return None
+    label = subagent_label(goal)
+
+    def ask(questions: list) -> dict:
+        from gateway.run_turn_runner_clarify_delivery import UNDELIVERED_NO_SURFACE
+        from tools.clarify_gateway import get_subagent_asker
+        asker = get_subagent_asker(session_key)
+        if asker is None:
+            # The chat can no longer show a question (it closed, or the gateway restarted): say so, so the child
+            # reads it as undelivered, not as a user who never answered.
+            return {"answers": {}, "outcome": "undelivered", "notice": UNDELIVERED_NO_SURFACE}
+        return asker(questions, label)
+
+    return ask
