+"""A background subagent's clarify reaches its parent's chat, and what the child may ask is bounded.
+
+The child asks through the chat's asker (``tools.clarify_gateway``), the answer returns to it, and the questions
+of subagents stay on the chat when the turn that spawned them ends.
+"""
+import json
+import threading
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from tools import approval_context
+from tools import clarify_gateway as cg
+from tools.delegate_tool import _build_child_agent
+from tools.delegate_tool_toolsets import _resolve_child_toolsets
+
+KEY = "test-subagent-clarify"
+ONE = [{"qid": "q0", "question": "Which one?", "choices": ["a", "b"], "choices_offered": ["a", "b"],
+        "multi_select": False}]
+
+
+@pytest.fixture(autouse=True)
+def _clean():
+    cg._entries.clear()
+    cg._session_index.clear()
