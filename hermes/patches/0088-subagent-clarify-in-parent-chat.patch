+"""A background subagent's question is a card of its parent's chat that names the subagent, is answered from any
+later turn, and waits the configured clarify timeout.
+
+Real owner pieces (``SessionAuthority`` over a real ``SessionDB``, the real ``TurnRunner`` clarify path); only the
+chat adapter is a stand-in.
+"""
+import asyncio
+import threading
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from gateway.platforms.base import SendResult
+from gateway.run_turn_runner import TurnRunner
+from gateway.session_authority import LiveSession, SessionAuthority
+from gateway.session_contract import SessionActor, SessionRef
+from hermes_state import SessionDB
+from hermes_state_runtime import (
+    admit_session_input, begin_runtime_epoch, claim_session_input, settle_session_input,
+)
+from tools import clarify_gateway as cg
+
+KEY = "subagent-clarify-route"
+ONE = [{"qid": "q0", "question": "Which one?", "choices": ["a", "b"], "multi_select": False}]
+
+
+class _Adapter:
+    def __init__(self):
+        self.cards = []
+        self.retired = []
+
+    def pause_typing_for_chat(self, chat_id):
+        raise AssertionError("a subagent's card leaves the turn's typing alone")
+
+    resume_typing_for_chat = pause_typing_for_chat
+
+    async def send_clarify(self, **kwargs):
+        self.cards.append(kwargs)
+        return SendResult(success=True, message_id="1")
+
+    async def retire_clarify_card(self, clarify_id, notice):
+        self.retired.append(clarify_id)
+
+
+@pytest.fixture()
+def owner(tmp_path):
+    cg._entries.clear()
+    cg._session_index.clear()
+    with SessionDB(db_path=tmp_path / "state.db") as db:
+        db.create_session("s", source="test")
+        epoch = begin_runtime_epoch(db, instance_id="current")
+        authority = SessionAuthority(SimpleNamespace(_draining=False), profile_id="owned",
+                                     instance_id="current", db=db, epoch=epoch)
+        authority.sessions["s"] = LiveSession(None, KEY)
+        yield SimpleNamespace(authority=authority, db=db, epoch=epoch)
+    cg._entries.clear()
+    cg._session_index.clear()
+
+
+def _run_a_turn(owner, request_id):
+    admit_session_input(owner.db, epoch=owner.epoch, principal_id="human", session_id="s",
+                        request_id=request_id, payload={"text": "start a subagent"})
+    row = claim_session_input(owner.db, epoch=owner.epoch, session_id="s")
+    return row["admission_id"], row["generation"]
+
+
+def _runner(owner, generation, adapter):
+    runner = object.__new__(TurnRunner)
+    runner._approval_owner = (owner.authority, "s", generation)
+    runner._ctx = SimpleNamespace(
+        _status_adapter=adapter, _status_chat_id="C1", _status_thread_metadata={}, session_key=KEY,
+        stream_consumer_holder=[None], source=SimpleNamespace(platform="telegram"))
+
+    class _Fut:
+        def __init__(self, r): self._r = r
+        def result(self, timeout=None): return self._r
+
+    runner._schedule = lambda coro, label: _Fut(asyncio.run(coro))
+    runner._close_native_stream_boundary = lambda *a, **k: (_ for _ in ()).throw(
+        AssertionError("a subagent's card leaves the turn's stream alone"))
+    return runner
+
+
+def _ask_in_thread(runner, goal="check it", questions=ONE):
+    holder = {}
+    thread = threading.Thread(target=lambda: holder.update(reply=runner._background_clarify_ask(questions, goal)),
+                              daemon=True)
+    thread.start()
+    return thread, holder
+
+
+def _wait_for_card(owner):
+    live = owner.authority.sessions["s"]
+    for _ in range(500):
+        prompts = live.controls.snapshot("s", None)
+        if prompts:
+            return prompts
+        threading.Event().wait(0.01)
+    raise AssertionError("the question never reached the chat")
+
+
+def _actor():
+    return SessionActor("human", "owned", frozenset({"session:read", "session:respond"}), "viewer")
+
+
+@pytest.mark.asyncio
+async def test_a_subagents_question_is_a_card_of_the_chat_that_outlives_the_turn(owner):
+    admission, generation = _run_a_turn(owner, "first")
+    adapter = _Adapter()
+    ref, actor = SessionRef("owned", "s"), _actor()
+    await owner.authority.attach(actor, ref)
+    with patch("tools.clarify_gateway.get_clarify_timeout", return_value=1800):
+        thread, holder = _ask_in_thread(_runner(owner, generation, adapter))
+        (prompt,) = _wait_for_card(owner)
+        # A normal question card that names the subagent, on the chat's own session.
+        assert prompt["kind"] == "clarify" and prompt["choices"] == ["a", "b"]
+        assert prompt["question"].startswith('Subagent "check it" asks: Which one?')
+        assert prompt["subagent"] == "check it"
+        assert adapter.cards[0]["question"].startswith('Subagent "check it" asks: Which one?')
+        assert adapter.cards[0]["session_key"] == KEY
+
+        # The turn that spawned the subagent ends; a later turn starts. The card is still listed and answerable.
+        settle_session_input(owner.db, epoch=owner.epoch, admission_id=admission, generation=generation,
+                             outcome="completed")
+        cg.clear_session(KEY, keep_subagent=True)
+        live = owner.authority.sessions["s"]
+        assert [p["prompt_id"] for p in live.controls.snapshot("s", None)] == [prompt["prompt_id"]]
+        assert live.controls.has_background("s", generation)
+        _admission2, generation2 = _run_a_turn(owner, "second")
+        assert generation2 != generation
+        result = await owner.authority.respond(
+            actor, ref, generation, prompt["prompt_id"], {"answer": "b"}, kind="clarify")
+        assert result["status"] == "resolved"
+        thread.join(timeout=10)
+    assert holder["reply"] == {"answers": {"q0": "b"}, "outcome": "submitted"}
+    assert live.controls.snapshot("s", generation2) == ()
+
+
+def test_the_wait_is_the_configured_clarify_timeout_and_a_silent_user_is_a_timeout(owner):
+    _admission, generation = _run_a_turn(owner, "first")
+    adapter = _Adapter()
+    waits = []
+    real_wait = cg.wait_for_response
+
+    def spy(clarify_id, timeout):
+        waits.append(timeout)
+        return real_wait(clarify_id, timeout=0.05)
+    config = {"agent": {"clarify_timeout": 1800}}
+    with patch("hermes_cli.config.load_config", return_value=config), \
+            patch("tools.clarify_gateway.wait_for_response", spy):
+        reply = _runner(owner, generation, adapter)._background_clarify_ask(ONE, "check it")
+    assert waits == [1800.0]
+    assert reply["outcome"] == "timed_out"
+    assert reply["notice"].startswith("[user did not respond within ")
+    assert reply["answers"] == {}
+    assert len(adapter.retired) == 1  # the card stops looking answerable
+    assert owner.authority.sessions["s"].controls.snapshot("s", generation) == ()
+
+
+@pytest.mark.asyncio
+async def test_a_skipped_question_and_a_second_question_come_back_in_order(owner):
+    _admission, generation = _run_a_turn(owner, "first")
+    ref, actor = SessionRef("owned", "s"), _actor()
+    await owner.authority.attach(actor, ref)
+    two = ONE + [{"qid": "q1", "question": "And then?", "choices": None, "multi_select": False}]
+    with patch("tools.clarify_gateway.get_clarify_timeout", return_value=1800):
+        thread, holder = _ask_in_thread(_runner(owner, generation, _Adapter()), questions=two)
+        (first,) = _wait_for_card(owner)
+        await owner.authority.respond(actor, ref, generation, first["prompt_id"], {"answer": "a"}, kind="clarify")
+        for _ in range(500):
+            second = [p for p in owner.authority.sessions["s"].controls.snapshot("s", None)
+                      if p["prompt_id"] != first["prompt_id"]]
+            if second:
+                break
+            threading.Event().wait(0.01)
+        assert second[0]["question"].startswith('Subagent "check it" asks: And then?')
+        await owner.authority.respond(actor, ref, generation, second[0]["prompt_id"], {"answer": "later"},
+                                      kind="clarify")
+        thread.join(timeout=10)
+    assert holder["reply"]["answers"] == {"q0": "a", "q1": "later"}
