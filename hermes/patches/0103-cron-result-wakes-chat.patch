     raise ValueError("catch_up must be true, false, or null (use the default).")
 
 
+def _normalize_wake(value: Any) -> Optional[bool]:
+    """``wake``: True starts a turn in the chat a result is delivered to, False leaves the result as a
+    note there, None = the default (``job_wakes``)."""
+    if value is None or isinstance(value, bool):
+        return value
+    raise ValueError("wake must be true, false, or null (use the default).")
+
+
+def job_wakes(job: dict[str, Any], resolved_from: Optional[str] = None) -> bool:
+    """Whether a result delivered into a chat of this app starts a turn there. The job's own ``wake``
+    wins; else it does when the result goes back to the chat the job was created in (deliver ``origin``,
+    ``resolved_from`` as ``_resolve_single_delivery_target`` tags it), and is a note anywhere else."""
+    if isinstance(job.get("wake"), bool):
+        return job["wake"]
+    if resolved_from is None:
+        origin = job.get("origin") or {}
+        tokens = [t.strip().lower() for t in str(job.get("deliver") or "").split(",")]
+        resolved_from = "origin" if origin.get("platform") == "local" and "origin" in tokens else ""
+    return resolved_from == "origin"
+
