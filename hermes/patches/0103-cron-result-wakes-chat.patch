diff --git a/tests/gateway/test_cron_wake.py b/tests/gateway/test_cron_wake.py
new file mode 100644
index 00000000..81fefbc1
--- /dev/null
+++ b/tests/gateway/test_cron_wake.py
@@ -0,0 +1,126 @@
+"""A cron result delivered into a chat starts that chat's turn when the job wakes it.
+
+A job created by an agent in a chat and delivering back to it (deliver ``origin``) wakes the chat; a
+job with ``wake: false``, one delivering elsewhere, and a failure notice leave the result a note. The
+result rides the chat's FIFO, so a running turn finishes first and nothing is dropped.
+"""
+import json
+
+import pytest
+
+from tests.gateway.test_session_end_delegations import _admissions, _local, _record_turns
+
+_ORIGIN = {'platform': 'local', 'chat_id': 'chat-1', 'chat_name': None, 'thread_id': None}
+
+
+async def _deliver_cron(authority, ref, text, **kw):
+    from gateway.session_cron import _admit_local_delivery
+    metadata = {'cron_wake': True} if kw.get('wake') else {}
+    assert await _admit_local_delivery(authority, ref.session_id, text, metadata) is True
+
+
+def _human(authority, ref, request_id, text):
+    from hermes_state_runtime import admit_session_input
+    return admit_session_input(authority.db, epoch=authority.epoch, principal_id='test-owner',
+                               session_id=ref.session_id, request_id=request_id, payload={'text': text})
+
+
+def _notes_of(authority, runner, ref, marker):
+    target = runner.session_store.lookup_by_session_key(authority.sessions[ref.session_id].route).session_id
+    return [m for m in authority.db.get_messages(target) if marker in str(m.get('content'))]
+
+
+@pytest.mark.asyncio
+async def test_a_waking_cron_result_starts_exactly_one_turn(tmp_path, monkeypatch):
+    runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
+    try:
+        seen = _record_turns(runner)
+        await _deliver_cron(authority, ref, 'Cronjob Response: RESULT_wake', wake=True)
+        await authority._drain(ref)
+        await authority._drain(ref)
+        assert seen == ['Cronjob Response: RESULT_wake']
+        assert _notes_of(authority, runner, ref, 'RESULT_wake') == []
+        assert [r['outcome'] for r in _admissions(authority, ref)] == ['completed']
+    finally:
+        authority.db.close()
+
+
+@pytest.mark.asyncio
+async def test_a_cron_result_without_wake_is_a_note_and_starts_no_turn(tmp_path, monkeypatch):
+    runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
+    try:
+        async def no_turn(event):
+            raise AssertionError('wake is off: the result must not start a turn')
+        runner._handle_message = no_turn
+        await _deliver_cron(authority, ref, 'Cronjob Response: RESULT_quiet', wake=False)
+        await authority._drain(ref)
+        assert len(_notes_of(authority, runner, ref, 'RESULT_quiet')) == 1
+    finally:
+        authority.db.close()
+
+
+@pytest.mark.asyncio
+async def test_a_waking_result_behind_a_running_turn_is_queued_then_runs(tmp_path, monkeypatch):
+    runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
+    try:
+        _human(authority, ref, 'human', 'FIRST')
+        await _deliver_cron(authority, ref, 'Cronjob Response: RESULT_late', wake=True)
+        assert [r['status'] for r in _admissions(authority, ref)] == ['queued']  # queued behind the user's input
+        seen = _record_turns(runner)
+        await authority._drain(ref)
+        await authority._drain(ref)
+        assert seen == ['FIRST', 'Cronjob Response: RESULT_late']
+        assert _notes_of(authority, runner, ref, 'RESULT_late') == []
+    finally:
+        authority.db.close()
+
+
+def test_the_wake_rule():
+    from cron.jobs import job_wakes
+    assert job_wakes({'origin': _ORIGIN, 'deliver': 'origin'}) is True
+    assert job_wakes({'origin': _ORIGIN, 'deliver': 'origin,telegram'}) is True
+    assert job_wakes({'origin': _ORIGIN, 'deliver': 'origin', 'wake': False}) is False
+    assert job_wakes({'origin': _ORIGIN, 'deliver': 'local:other'}) is False
+    assert job_wakes({'origin': _ORIGIN, 'deliver': 'telegram'}) is False
+    assert job_wakes({'deliver': 'local:other', 'wake': True}) is True
+    assert job_wakes({'deliver': 'origin'}) is False  # created by a script: no chat to wake
+    assert job_wakes({'origin': dict(_ORIGIN, platform='telegram'), 'deliver': 'origin'}) is False
+    assert job_wakes({'deliver': 'origin'}, 'origin') is True
+
+
+def test_wake_is_stored_listed_and_updated(tmp_path, monkeypatch):
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    from cron import jobs
+    from tools import cronjob_tools
+
+    job = jobs.create_job(prompt='check', schedule='every 1h', origin=_ORIGIN, wake=False)
+    assert job['wake'] is False
+    assert 'wake' not in jobs.create_job(prompt='x', schedule='every 1h')
+    with pytest.raises(ValueError):
+        jobs.create_job(prompt='x', schedule='every 1h', wake='yes')
+    listed = json.loads(cronjob_tools.cronjob(action='list'))['jobs']
+    assert [j['wake'] for j in listed if j['job_id'] == job['id']] == [False]
+    json.loads(cronjob_tools.cronjob(action='update', job_id=job['id'], wake=True))
+    assert jobs.get_job(job['id'])['wake'] is True
+    plain = jobs.create_job(prompt='from chat', schedule='every 1h', origin=_ORIGIN)
+    assert 'wake' not in plain
+    listed = json.loads(cronjob_tools.cronjob(action='list'))['jobs']
+    assert [j['wake'] for j in listed if j['job_id'] == plain['id']] == [True]
+    assert 'wake' in cronjob_tools.CRONJOB_SCHEMA['parameters']['properties']
+
+
+@pytest.mark.parametrize('job, failure, expected', [
+    ({'origin': _ORIGIN, 'deliver': 'origin'}, False, True),
+    ({'origin': _ORIGIN, 'deliver': 'origin', 'wake': False}, False, False),
+    ({'origin': _ORIGIN, 'deliver': 'origin'}, True, False),
+    ({'deliver': 'local:chat-1'}, False, False),
+])
+def test_the_delivery_passes_wake_to_the_local_chat(tmp_path, monkeypatch, job, failure, expected):
+    from cron import scheduler_delivery
+    calls = []
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    monkeypatch.setattr('gateway.session_cron.deliver_to_local_chat',
+                        lambda home, chat_id, text, **kw: calls.append((chat_id, kw)))
+    job = dict({'id': 'j', 'name': 'j'}, **job)
+    scheduler_delivery._deliver_result(job, 'ping', for_failure=failure)
+    assert calls and calls[0][1]['wake'] is expected
