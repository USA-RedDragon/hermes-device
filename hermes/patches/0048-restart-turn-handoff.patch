+@pytest.mark.asyncio
+async def test_takeover_queues_one_continuation_per_interrupted_turn(tmp_path, monkeypatch):
+    rows = {
+        "a1": {"admission_id": "a1", "status": "terminal", "outcome": "interrupted", "generation": 7},
+        "a2": {"admission_id": "a2", "status": "unknown", "outcome": None, "generation": 2},
+        "a3": {"admission_id": "a3", "status": "terminal", "outcome": "completed", "generation": 4},
+    }
+    source = SimpleNamespace(platform="local")
+    live = {sid: SimpleNamespace(source=source, route=f"agent:main:local:dm:{sid}") for sid in ("s1", "s2", "s3")}
+    authority = _FakeAuthority(rows, live)
+    runner = SimpleNamespace(config=GatewayConfig(restart_turn_handoff=True), session_authorities=None,
+                             session_authority=authority, _delivery_adapter_for=lambda src: "adapter")
+    monkeypatch.setattr("hermes_state_runtime.get_session_admission",
+                        lambda db, *, admission_id: rows.get(admission_id))
+    monkeypatch.setattr("gateway.session_local_recovery.restore_completion_route", lambda runner, key: None)
+    wakes = []
+
+    async def wake(runner, adapter, src, text, producer, metadata=None):
+        wakes.append((src, text, producer, metadata))
+        return True
+
+    monkeypatch.setattr("gateway.session_automation.admit_route_wake", wake)
+    _write(tmp_path, [{"profile_id": "default", "session_id": sid, "route": f"agent:main:local:dm:{sid}",
+                       "admission_id": aid, "generation": rows[aid]["generation"]}
+                      for sid, aid in (("s1", "a1"), ("s2", "a2"), ("s3", "a3"))])
+
+    assert await turn_handoff.continue_handed_off_turns(runner, tmp_path) == 2
+    assert authority.resolved == [("s2", "a2", 2)]  # the one its owner could not settle
+    assert len(wakes) == 2 and all(w[2] == turn_handoff.PRODUCER for w in wakes)
+    assert wakes[0][1] == turn_handoff.CONTINUATION_TEXT
+    assert not (tmp_path / turn_handoff.FILE_NAME).exists()
+
