diff --git a/gateway/turn_handoff.py b/gateway/turn_handoff.py
new file mode 100644
index 0000000000..a5c31c51f2
--- /dev/null
+++ b/gateway/turn_handoff.py
@@ -0,0 +1,177 @@
+"""``gateway.restart_turn_handoff`` (false = off): a restart hands running turns to the next gateway.
+
+Without the key a graceful restart (SIGUSR1, ``/restart``, a supervisor's SIGTERM with
+``gateway.sigterm_restart_wait``) waits for running turns up to ``agent.restart_after_turn_timeout``, and
+the stop then drains them up to ``agent.restart_drain_timeout``. New turns are refused the whole time, so
+one long turn (a coordinator waiting on subagents, a subagent parked on an approval) keeps every chat of
+the profile from running anything for minutes.
+
+With the key the restart waits at most ``gateway.restart_turn_handoff_wait_seconds`` (0 by default), then
+stops each running turn the way a user's Stop does (a terminal command moves to the background where its
+backend hands processes over, background subagents are handed over by ``delegation.restart_handoff``).
+Just before that, it writes the canonical sessions whose turns it stops to
+``$HERMES_HOME/.turn-handoff.json`` (mode 0600). The gateway that takes the profile over reads the file
+once, after its startup recovery, settles a handed-off turn that its owner could not settle (``unknown``)
+as interrupted, and queues one continuation turn per session in that session's FIFO, so the work goes on
+within seconds of the takeover with no input from the user. A turn that completed after all gets none.
+Classic (non-canonical) sessions keep upstream's ``resume_pending`` auto-resume.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import os
+import time
+from pathlib import Path
+from typing import Any
+
+logger = logging.getLogger(__name__)
+
+FILE_NAME = ".turn-handoff.json"
+# A file older than this is from an earlier restart, not the one this gateway takes over from.
+MAX_AGE_S = 900.0
+PRODUCER = "restart-continuation"
+CONTINUATION_TEXT = (
+    "[Hermes restarted while your previous turn was running. The turn was stopped so the restart could "
+    "go ahead and was handed to the restarted Hermes: a tool call cut by the restart reads as interrupted, "
+    "a terminal command that was still running moved to the background (check it with the process tool), "
+    "and background subagents carry on. Continue the task from where it stopped; do not redo finished "
+    "steps. If a later message from the user changed the task, follow that instead.]"
+)
+
+
+def _config(runner) -> Any:
+    return getattr(runner, "config", None)
+
+
+def enabled(runner) -> bool:
+    """The key is on and this stop is a restart (a plain shutdown still waits and drains)."""
+    return bool(getattr(_config(runner), "restart_turn_handoff", False)
+                and getattr(runner, "_restart_requested", False))
+
+
+def wait_seconds(runner) -> float:
+    try:
+        return max(0.0, float(getattr(_config(runner), "restart_turn_handoff_wait_seconds", 0.0) or 0.0))
+    except (TypeError, ValueError):
+        return 0.0
+
+
+def _path(home) -> Path:
+    return Path(home) / FILE_NAME
+
+
+def running_turns(runner) -> list[dict]:
+    """The canonical sessions with a claimed, running turn, across every authority the runner serves."""
+    from gateway.session_authorities import all_authorities
+    turns = []
+    for authority in all_authorities(runner):
+        for session_id, live in list((getattr(authority, "sessions", None) or {}).items()):
+            stream = getattr(live, "event_stream", None)
+            execution = dict(getattr(stream, "execution", None) or {})
+            if execution.get("execution_generation") is None or not execution.get("admission_id"):
+                continue
+            turns.append({
+                "profile_id": getattr(authority, "profile_id", None), "session_id": session_id,
+                "route": getattr(live, "route", None), "admission_id": execution["admission_id"],
+                "generation": execution["execution_generation"],
+            })
+    return turns
+
+
+def export_turns(runner, home) -> int:
+    """Write the running canonical turns for the next gateway; returns how many."""
+    turns = running_turns(runner)
+    if not turns:
+        return 0
+    path = _path(home)
+    tmp = path.with_name(path.name + f".{os.getpid()}.tmp")
+    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as fh:
+            json.dump({"written_at": time.time(), "pid": os.getpid(), "turns": turns}, fh)
+        os.replace(tmp, path)
+    except BaseException:
+        tmp.unlink(missing_ok=True)
+        raise
+    return len(turns)
+
+
+def take_turns(home) -> list[dict]:
+    """Read and remove the handed-over turns, once; [] when there is no fresh file."""
+    path = _path(home)
+    try:
+        raw = path.read_text(encoding="utf-8")
+    except FileNotFoundError:
+        return []
+    finally:
+        path.unlink(missing_ok=True)
+    try:
+        data = json.loads(raw)
+    except ValueError:
+        logger.warning("Ignoring an unreadable %s", FILE_NAME)
+        return []
+    if not isinstance(data, dict) or time.time() - float(data.get("written_at") or 0) > MAX_AGE_S:
+        return []
+    return [t for t in data.get("turns") or [] if isinstance(t, dict) and t.get("session_id") and t.get("route")]
+
+
+async def _continue_one(runner, authority, turn) -> str:
+    """Settle one handed-off turn if needed and queue its continuation; returns what happened."""
+    import asyncio
+    from gateway.session_contract import SessionRef
+    from gateway.session_local_recovery import restore_completion_route
+    from gateway.session_automation import admit_route_wake
+    from hermes_state_runtime import get_session_admission
+    session_id = turn["session_id"]
+    row = await asyncio.to_thread(get_session_admission, authority.db, admission_id=turn.get("admission_id") or "")
+    status, outcome = (row or {}).get("status"), (row or {}).get("outcome")
+    if status == "terminal" and outcome not in ("interrupted",):
+        return "finished"
+    ref = SessionRef(authority.profile_id, session_id)
+    if status == "unknown":
+        # Its owner stopped it for this handoff but could not commit the settlement before it exited: the
+        # input is not lost (the continuation redoes the work), so nobody has to decide whether to resend it.
+        await authority.resolve_unknown_as_owner(ref, row["admission_id"], row["generation"])
+    elif status not in ("terminal", None):
+        return f"left {status}"
+    restore_completion_route(runner, turn["route"])
+    live = authority.sessions.get(session_id)
+    if live is None or getattr(live, "source", None) is None:
+        return "no live session"
+    adapter = runner._delivery_adapter_for(live.source)
+    queued = await admit_route_wake(runner, adapter, live.source, CONTINUATION_TEXT, PRODUCER,
+                                    {"restart_turn_handoff": True})
+    return "continued" if queued else "not queued"
+
+
+async def continue_handed_off_turns(runner, home) -> int:
+    """On the gateway that took the profile over: queue a continuation for each turn the previous gateway
+    handed over (``export_turns``). Returns how many were queued; never raises."""
+    if not getattr(_config(runner), "restart_turn_handoff", False):
+        return 0
+    try:
+        turns = take_turns(home)
+    except Exception:
+        logger.warning("Could not read the turns the previous gateway handed over", exc_info=True)
+        return 0
+    if not turns:
+        return 0
+    from gateway.session_authorities import active_authority
+    authority = active_authority(runner)
+    queued = 0
+    for turn in turns:
+        if authority is None or turn.get("profile_id") not in (None, getattr(authority, "profile_id", None)):
+            logger.warning("Handed-off turn of %s left alone: profile %s is not served here",
+                           turn["session_id"], turn.get("profile_id"))
+            continue
+        try:
+            result = await _continue_one(runner, authority, turn)
+        except Exception:
+            logger.warning("Could not continue the handed-off turn of %s", turn["session_id"], exc_info=True)
+            continue
+        queued += result == "continued"
+        logger.info("Handed-off turn of %s: %s", turn["session_id"], result)
+    if queued:
+        logger.info("Queued %d continuation turn(s) the previous gateway handed over", queued)
+    return queued
diff --git a/tests/gateway/test_restart_turn_handoff.py b/tests/gateway/test_restart_turn_handoff.py
new file mode 100644
index 0000000000..c28a82888d
--- /dev/null
+++ b/tests/gateway/test_restart_turn_handoff.py
@@ -0,0 +1,248 @@
+"""gateway.restart_turn_handoff: a restart hands running turns to the next gateway instead of waiting."""
+import asyncio
+import json
+import os
+import time
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from gateway import turn_handoff
+from gateway.config import GatewayConfig, load_gateway_config
+from gateway.run import GatewayRunner
+from tests.gateway.restart_test_helpers import make_restart_runner
+
+
+def test_off_by_default():
+    assert GatewayConfig().restart_turn_handoff is False
+    assert GatewayConfig().restart_turn_handoff_wait_seconds == 0.0
+    cfg = GatewayConfig.from_dict({"gateway": {"restart_turn_handoff": True,
+                                               "restart_turn_handoff_wait_seconds": 7}})
+    assert cfg.restart_turn_handoff is True
+    assert cfg.restart_turn_handoff_wait_seconds == 7.0
+    assert GatewayConfig.from_dict({"gateway": {"restart_turn_handoff_wait_seconds": -1}}
+                                   ).restart_turn_handoff_wait_seconds == 0.0
+
+
+def test_config_yaml_keys_reach_the_runner_config(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    (tmp_path / "config.yaml").write_text(
+        "gateway:\n  restart_turn_handoff: true\n  restart_turn_handoff_wait_seconds: 3\n", encoding="utf-8")
+    cfg = load_gateway_config()
+    assert cfg.restart_turn_handoff is True
+    assert cfg.restart_turn_handoff_wait_seconds == 3.0
+
+
+def test_enabled_only_for_a_restart():
+    runner = SimpleNamespace(config=GatewayConfig(restart_turn_handoff=True), _restart_requested=False)
+    assert turn_handoff.enabled(runner) is False
+    runner._restart_requested = True
+    assert turn_handoff.enabled(runner) is True
+    runner.config = GatewayConfig()
+    assert turn_handoff.enabled(runner) is False
+
+
+@pytest.mark.asyncio
+async def test_restart_does_not_wait_for_a_running_turn_with_the_key():
+    runner, _adapter = make_restart_runner()
+    runner.config.restart_turn_handoff = True
+    runner.stop = AsyncMock()
+    runner._restart_after_turn_timeout = 540.0
+    runner._running_agents["agent:main:local:dm:s1"] = MagicMock()
+
+    started = time.monotonic()
+    assert runner.request_restart(detached=False, via_service=True) is True
+    await asyncio.wait_for(runner._restart_task, timeout=2.0)
+
+    assert time.monotonic() - started < 1.0
+    runner.stop.assert_awaited_once_with(restart=True, detached_restart=False, service_restart=True)
+    assert runner._running_agents  # still running: the stop hands it over
+
+
+@pytest.mark.asyncio
+async def test_restart_waits_only_the_handoff_wait():
+    runner, _adapter = make_restart_runner()
+    runner.config.restart_turn_handoff = True
+    runner.config.restart_turn_handoff_wait_seconds = 0.3
+    runner.stop = AsyncMock()
+    runner._restart_after_turn_timeout = 540.0
+    runner._running_agents["agent:main:local:dm:s1"] = MagicMock()
+
+    started = time.monotonic()
+    assert runner.request_restart(detached=False, via_service=True) is True
+    await asyncio.sleep(0.1)
+    runner.stop.assert_not_awaited()
+    await asyncio.wait_for(runner._restart_task, timeout=2.0)
+    assert 0.25 <= time.monotonic() - started < 1.5
+    runner.stop.assert_awaited_once()
+
+
+@pytest.mark.asyncio
+async def test_without_the_key_the_restart_still_waits_for_the_turn():
+    runner, _adapter = make_restart_runner()
+    runner.stop = AsyncMock()
+    runner._restart_after_turn_timeout = 540.0
+    runner._running_agents["agent:main:local:dm:s1"] = MagicMock()
+
+    assert runner.request_restart(detached=False, via_service=True) is True
+    await asyncio.sleep(0.3)
+    runner.stop.assert_not_awaited()
+    runner._restart_task.cancel()
+    await asyncio.gather(runner._restart_task, return_exceptions=True)
+
+
+@pytest.mark.asyncio
+async def test_stop_drains_chat_turns_with_no_budget_under_the_handoff(monkeypatch):
+    runner, _adapter = make_restart_runner()
+    runner._restart_requested = True
+    runner.config.restart_turn_handoff = True
+    runner._restart_drain_timeout = 30.0
+    seen = []
+
+    async def drain(timeout, cron_timeout=None):
+        seen.append((timeout, cron_timeout))
+        return {}, True
+
+    runner._drain_active_agents = drain
+    ctx = GatewayRunner._StopContext(deferred_count=lambda: 0)
+    ctx.started_at = time.monotonic()
+    await GatewayRunner._stop_drain_active_work(runner, 30.0, ctx, agent_timeout=0.0)
+    assert seen[0][0] == 0.0
+    assert seen[0][1] >= 30.0  # cron and API runs keep their floor
+    seen.clear()
+    await GatewayRunner._stop_drain_active_work(runner, 30.0, ctx)
+    assert seen[0][0] == 30.0
