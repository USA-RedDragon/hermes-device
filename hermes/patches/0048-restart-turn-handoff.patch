+class _FakeAuthority:
+    def __init__(self, rows, live):
+        self.profile_id = "default"
+        self.db = object()
+        self.rows = rows
+        self.sessions = live
+        self.resolved = []
+
+    async def resolve_unknown_as_owner(self, ref, admission_id, generation, *, notice=None):
+        self.resolved.append((ref.session_id, admission_id, generation))
+        self.rows[admission_id] = {**self.rows[admission_id], "status": "terminal", "outcome": "interrupted"}
+
