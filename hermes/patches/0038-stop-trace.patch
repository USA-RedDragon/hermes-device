new file mode 100644
index 0000000000..47d48fe0a4
--- /dev/null
+++ b/tests/gateway/test_stop_trace.py
@@ -0,0 +1,84 @@
+"""gateway.stop_trace: a stop's timing trace in $HERMES_HOME/stop-trace/<pid>.log."""
+
+import asyncio
+import os
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from gateway import stop_trace
+from gateway.config import GatewayConfig
+
+
+@pytest.fixture(autouse=True)
+def _fresh(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(stop_trace, "_trace", None)
+    monkeypatch.setattr(stop_trace, "_TAIL_S", 0.05)
+    yield
+    t = stop_trace._trace
+    if t is not None and t.thread.is_alive():
+        t.stop_at = time.monotonic()
+        t.thread.join(2)
+
+
+def _runner(on: bool):
+    return SimpleNamespace(config=SimpleNamespace(stop_trace=on))
+
+
+def test_config_key_defaults_off():
+    assert GatewayConfig().stop_trace is False
+    assert GatewayConfig.from_dict({"stop_trace": True}).stop_trace is True
+    assert GatewayConfig.from_dict({}).stop_trace is False
+
+
+def test_off_writes_nothing(tmp_path):
+    stop_trace.arm(_runner(False), "signal")
+    stop_trace.mark("x")
+    stop_trace.finish()
+    assert stop_trace._trace is None
+    assert not (tmp_path / "stop-trace").exists()
+
+
+def test_records_marks_and_what_tasks_await(tmp_path):
+    async def waits_on_a_timer():
+        await asyncio.sleep(5)
+
+    async def main():
+        task = asyncio.create_task(waits_on_a_timer(), name="slow-step")
+        stop_trace.arm(_runner(True), "restart requested")
+        stop_trace.arm(_runner(True), "stop()")  # the first call wins
+        stop_trace.mark("stop: begin_teardown")
+        await asyncio.sleep(0.35)
+        stop_trace.finish("bootstrap: lock released")
+        await asyncio.sleep(0.3)
+        task.cancel()
+
+    asyncio.run(main())
+    stop_trace._trace.thread.join(2)
+    text = (tmp_path / "stop-trace" / f"{os.getpid()}.log").read_text()
+    assert "ARMED restart requested" in text
+    assert "MARK stop() (already armed)" in text
+    assert "MARK stop: begin_teardown" in text
+    assert "MARK bootstrap: lock released" in text
+    assert "TASK slow-step:" in text and "waits_on_a_timer" in text
+    assert "THREAD " in text
+    assert text.rstrip().endswith("END")
+
+
+def test_identical_samples_are_written_once(tmp_path, monkeypatch):
+    # Other test-process threads may change between rounds; hold the thread view still.
+    monkeypatch.setattr(stop_trace._Trace, "_threads", lambda self: ["main: idle"])
+
+    async def main():
+        stop_trace.arm(_runner(True), "signal")
+        await asyncio.sleep(0.6)
+        stop_trace.finish()
+        await asyncio.sleep(0.2)
+
+    asyncio.run(main())
+    stop_trace._trace.thread.join(2)
+    text = (tmp_path / "stop-trace" / f"{os.getpid()}.log").read_text()
+    # About six sampling rounds while nothing changes: one sample is written.
+    assert text.split("MARK released")[0].count(" SAMPLE\n") == 1, text
