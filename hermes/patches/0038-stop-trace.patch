diff --git a/gateway/stop_trace.py b/gateway/stop_trace.py
new file mode 100644
index 0000000000..ecddf1b9e9
--- /dev/null
+++ b/gateway/stop_trace.py
@@ -0,0 +1,184 @@
+"""``gateway.stop_trace`` (false = off): a timing trace of one gateway stop, for diagnosis.
+
+From the stop signal (or a restart request) until shortly after the profile is released, a sampler
+thread writes ``$HERMES_HOME/stop-trace/<pid>.log``: every ``MARK`` the stop path records (phase
+boundaries, with the offset from the first one) and, every 100 ms, what each asyncio task awaits
+(its coroutine chain, file:line) and what each thread runs. A sample is written only when it differs
+from the previous one, so a 20 s idle stop stays a few kilobytes. Nothing is read back; the file is
+for an operator who cannot read the gateway log.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import os
+import sys
+import threading
+import time
+from pathlib import Path
+from typing import Any, Optional
+
+_INTERVAL_S = 0.1
+_TAIL_S = 2.0  # keep sampling this long after the final mark
+_MAX_FRAMES = 12
+
+_lock = threading.Lock()
+_trace: Optional["_Trace"] = None
+
+
+def _enabled(runner: Any) -> bool:
+    return bool(getattr(getattr(runner, "config", None), "stop_trace", False))
+
+
+def _where(frame: Any) -> str:
+    code = frame.f_code
+    path = code.co_filename
+    for marker in ("/site-packages/", "/hermes/", "/lib/python"):
+        if marker in path:
+            path = path.split(marker, 1)[1]
+            break
+    return f"{path}:{frame.f_lineno}:{code.co_name}"
+
+
+def _coro_chain(coro: Any) -> list[str]:
+    """The await chain of a coroutine, outermost first."""
+    out: list[str] = []
+    seen = 0
+    while coro is not None and seen < 64:
+        seen += 1
+        frame = getattr(coro, "cr_frame", None) or getattr(coro, "gi_frame", None) or getattr(coro, "ag_frame", None)
+        if frame is not None:
+            out.append(_where(frame))
+        nxt = getattr(coro, "cr_await", None)
+        if nxt is None:
+            nxt = getattr(coro, "gi_yieldfrom", None)
+        if nxt is None:
+            nxt = getattr(coro, "ag_await", None)
+        if nxt is not None and not hasattr(nxt, "cr_frame") and not hasattr(nxt, "gi_frame"):
+            # A future or other awaitable: name it and stop.
+            out.append(f"<{type(nxt).__name__}>")
+            break
+        coro = nxt
+    return out
+
+
+class _Trace:
+    def __init__(self, path: Path, loop: Optional[asyncio.AbstractEventLoop]):
+        self.path = path
+        self.loop = loop
+        self.t0 = time.monotonic()
+        self.fh = open(path, "a", buffering=1, encoding="utf-8")
+        self.stop_at: Optional[float] = None
+        self.last_sample = ""
+        self.thread = threading.Thread(target=self._run, name="stop-trace", daemon=True)
+
+    def write(self, line: str) -> None:
+        with _lock:
+            try:
+                self.fh.write(f"+{time.monotonic() - self.t0:8.3f} {line}\n")
+            except Exception:
+                pass
+
+    def _tasks(self) -> list[str]:
+        loop = self.loop
+        if loop is None or loop.is_closed():
+            return ["(no loop)"]
+        done = threading.Event()
+        result: list[str] = []
+
+        def collect() -> None:
+            try:
+                for task in asyncio.all_tasks(loop):
+                    chain = _coro_chain(task.get_coro())
+                    result.append(f"{task.get_name()}: " + " > ".join(chain[-_MAX_FRAMES:]))
+            except Exception as exc:  # a debug aid must never raise into the loop
+                result.append(f"(tasks failed: {exc!r})")
+            finally:
+                done.set()
+
+        try:
+            loop.call_soon_threadsafe(collect)
+        except RuntimeError:
+            return ["(loop closed)"]
+        if not done.wait(1.0):
+            return ["(loop did not run the sampler within 1 s)"]
+        return sorted(result)
+
+    def _threads(self) -> list[str]:
+        names = {t.ident: t.name for t in threading.enumerate()}
+        out = []
+        me = threading.get_ident()
+        for ident, frame in sys._current_frames().items():
+            if ident == me:
+                continue
+            stack = []
+            f = frame
+            while f is not None and len(stack) < _MAX_FRAMES:
+                stack.append(_where(f))
+                f = f.f_back
+            out.append(f"{names.get(ident, ident)}: " + " < ".join(stack))
+        return sorted(out)
+
+    def _run(self) -> None:
+        while True:
+            now = time.monotonic()
+            if self.stop_at is not None and now >= self.stop_at:
+                self.write("END")
+                with _lock:
+                    try:
+                        self.fh.close()
+                    except Exception:
+                        pass
+                return
+            try:
+                lines = ["TASK " + t for t in self._tasks()] + ["THREAD " + t for t in self._threads()]
+                sample = "\n".join(lines)
+                if sample != self.last_sample:
+                    self.last_sample = sample
+                    self.write("SAMPLE\n" + "\n".join("    " + ln for ln in lines))
+            except Exception as exc:
+                self.write(f"(sample failed: {exc!r})")
+            time.sleep(_INTERVAL_S)
+
+
+def arm(runner: Any, reason: str) -> None:
+    """Start the trace for this process's stop (first call wins), if ``gateway.stop_trace`` is on."""
+    global _trace
+    if not _enabled(runner):
+        return
+    with _lock:
+        if _trace is not None:
+            existing = _trace
+        else:
+            existing = None
+            try:
+                from hermes_constants import get_hermes_home
+                d = Path(get_hermes_home()) / "stop-trace"
+                d.mkdir(parents=True, exist_ok=True)
+                try:
+                    loop = asyncio.get_running_loop()
+                except RuntimeError:
+                    loop = getattr(runner, "_loop", None)
+                _trace = _Trace(d / f"{os.getpid()}.log", loop)
+            except Exception:
+                return
+    if existing is not None:
+        existing.write(f"MARK {reason} (already armed)")
+        return
+    _trace.write(f"ARMED {reason} pid={os.getpid()} wall={time.time():.3f}")
+    _trace.thread.start()
+
+
+def mark(label: str) -> None:
+    """Record a phase boundary; a no-op unless a trace is armed."""
+    t = _trace
+    if t is not None:
+        t.write(f"MARK {label} wall={time.time():.3f}")
+
+
+def finish(label: str = "released") -> None:
+    """The last mark: sampling ends ``_TAIL_S`` later."""
+    t = _trace
+    if t is not None:
+        t.write(f"MARK {label} wall={time.time():.3f}")
+        t.stop_at = time.monotonic() + _TAIL_S
