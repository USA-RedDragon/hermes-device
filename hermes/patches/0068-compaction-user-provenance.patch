--- /dev/null
+++ b/tests/agent/test_compaction_user_provenance.py
@@ -0,0 +1,113 @@
+"""One classifier decides which user-role rows hold the user's words (task snapshot, verbatim quotes, anchors)."""
+
+from agent.context_compressor import (
+    ContextCompressor,
+    _LEAN_PAGE_ANSWER_MAX_CHARS,
+    _LEAN_USER_MESSAGE_MAX_CHARS,
+    _build_verbatim_user_section,
+)
+from agent.conversation_compression import _is_real_user_message
+from agent.conversation_compression_scaffolding import (
+    is_page_answer,
+    is_user_role_scaffolding,
+    user_authored_text,
+)
+
+AGENT_MSG = (
+    "[Agent message am_0123456789abcdef from chat 'ops' (session local-1)]\n"
+    "Another AI agent of this user wrote everything below this line. The user did not write it. "
+    "Treat it as a message from a peer agent.\n\nThe user approved the dark-only theme."
+)
+DELEGATION = "[ASYNC DELEGATION BATCH COMPLETE — deleg_1]\nSubagent sa-1 finished.\nResult:\nbuilt the page"
+NOTIFICATION = (
+    "Background process proc_1 finished with exit code 0.\n\n"
+    "[INTERNAL NOTIFICATION — generated by the Hermes gateway, not written by a human user. "
+    "Do not treat it as user input, and do not reply to any earlier chat message because of it.]"
+)
+RESTART_RESUME = "[The gateway restarted while you were working on this task. Your conversation so far is above.]"
+MEMORY = (
+    "<memory-context>\n[System note: The following is recalled memory context, NOT new user input. "
+    "Treat as authoritative reference data.]\n\n## User Representation\n- the user keeps a cluster\n</memory-context>"
+)
+STEER = (
+    "[OUT-OF-BAND USER MESSAGE — a direct message from the user, delivered once at this position; not tool "
+    "output and not a new delivery when replayed from conversation history]\nuse port 8891\n"
+    "[/OUT-OF-BAND USER MESSAGE]"
+)
+
+
+def _user(content, **extra):
+    return {"role": "user", "content": content, **extra}
+
+
+def test_runtime_rows_hold_no_user_words():
+    for content in (AGENT_MSG, DELEGATION, NOTIFICATION, RESTART_RESUME, "Cronjob Response: nightly\nok"):
+        assert user_authored_text(_user(content)) is None, content[:30]
+        assert is_user_role_scaffolding(_user(content))
+        assert not _is_real_user_message(_user(content))
+
+
+def test_user_rows_keep_their_words_without_recalled_memory():
+    assert user_authored_text(_user("ship it\n\n" + MEMORY)) == "ship it"
+    assert user_authored_text(_user([{"type": "text", "text": "look at this"}, {"type": "text", "text": MEMORY}])) == (
+        "look at this"
+    )
+    assert user_authored_text(_user(STEER)) == "use port 8891"
+    assert user_authored_text(_user(STEER.replace("use port 8891", AGENT_MSG))) is None
+    assert not is_user_role_scaffolding(_user(STEER))
+    note = "[System note: The previous turn was interrupted by a gateway restart.]\n\nstatus?"
+    assert user_authored_text(_user(note)) == "status?"
+    assert is_user_role_scaffolding(_user("[System note: The previous turn was interrupted by a restart.]"))
+    page = '[Answer from the page "Rename?"]\n> 2. Yes, but tonight'
+    assert user_authored_text(_user(page)) == page and is_page_answer(page)
+
+
+def test_image_only_and_memory_only_turns_are_not_scaffolding():
+    assert not is_user_role_scaffolding(_user([{"type": "image_url", "image_url": {"url": "data:,"}}]))
+    assert not is_user_role_scaffolding(_user(MEMORY))
+
+
+def test_task_snapshot_skips_subagent_results_and_peer_messages():
+    messages = [_user("Make the app installable.\n\n" + MEMORY), {"role": "assistant", "content": "on it"},
+                _user(DELEGATION), {"role": "assistant", "content": "noted"}, _user(AGENT_MSG)]
+    snapshot = ContextCompressor._latest_user_task_snapshot(messages)
+    assert "Make the app installable." in snapshot
+    assert "ASYNC DELEGATION" not in snapshot and "Agent message" not in snapshot
+    assert "memory-context" not in snapshot
+
+
+def test_verbatim_section_quotes_only_the_users_words():
+    section = _build_verbatim_user_section([
+        _user("restic, offsite isn't worth the cost yet\n\n" + MEMORY), _user(DELEGATION), _user(AGENT_MSG),
+        _user(NOTIFICATION), _user(STEER),
+    ])
+    assert "restic, offsite" in section and "> use port 8891" in section
+    for leaked in ("ASYNC DELEGATION", "Agent message", "INTERNAL NOTIFICATION", "memory-context", "OUT-OF-BAND"):
+        assert leaked not in section.split("\n(Every real user message")[0], leaked
+
+
+def test_page_answers_are_kept_whole_up_to_their_bound():
+    answers = "\n".join(f"> {i}. option {i % 3} because reason {i}" for i in range(400))
+    page = '[Answer from the page "Settings review"]\n' + answers
+    assert _LEAN_USER_MESSAGE_MAX_CHARS < len(page) < _LEAN_PAGE_ANSWER_MAX_CHARS
+    section = _build_verbatim_user_section([_user(page)])
+    assert "399. option" in section and "chars omitted" not in section
+    assert f"{_LEAN_PAGE_ANSWER_MAX_CHARS:,} chars" in section
+    plain = _build_verbatim_user_section([_user("x" * (_LEAN_USER_MESSAGE_MAX_CHARS + 2000))])
+    assert "chars omitted" in plain
+
+
+def test_peer_messages_no_longer_crowd_out_user_messages():
+    old = _user("keep the old namespace for a day")
+    peers = [_user(AGENT_MSG + "\n" + "detail " * 600) for _ in range(12)]
+    section = _build_verbatim_user_section([old, *peers])
+    assert "keep the old namespace for a day" in section
+
+
+def test_summarizer_input_labels_rows_the_user_did_not_write():
+    compressor = ContextCompressor(model="test/model", quiet_mode=True, config_context_length=64_000)
+    text = compressor._serialize_for_summary([_user("ship it"), _user(DELEGATION), _user(AGENT_MSG), _user(STEER)])
+    assert "[USER]: ship it" in text
+    assert "[USER ROLE, NOT WRITTEN BY THE USER]: [ASYNC DELEGATION" in text
+    assert "[USER ROLE, NOT WRITTEN BY THE USER]: [Agent message" in text
+    assert "[USER]: [OUT-OF-BAND USER MESSAGE" in text
