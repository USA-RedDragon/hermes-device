diff --git a/agent/conversation_compression_scaffolding.py b/agent/conversation_compression_scaffolding.py
index 3378cc89..e5e0be53 100644
--- a/agent/conversation_compression_scaffolding.py
+++ b/agent/conversation_compression_scaffolding.py
@@ -1,14 +1,39 @@
-"""Which user-role rows are runtime scaffolding rather than something the person typed."""
+"""Which user-role rows are runtime scaffolding rather than something the person typed.
+
+One classifier for every reader that asks "did the user write this": the compaction task snapshot, the
+verbatim user-message section, anchor restoration and the memory recall query. Separate prefix lists drifted
+apart before (one lacked ``[ASYNC DELEGATION``, both lacked ``[Agent message``), so subagent results and
+peer-agent messages were quoted as the user's own words.
+"""
 
 from __future__ import annotations
 
-from typing import Any
+import re
+from typing import Any, Optional
 
+# Openers of user-role rows no person wrote. Matched after a leading gateway timestamp is removed.
 _SYNTHETIC_USER_PREFIXES = (
     "[System: Your previous response was truncated", "[System: The previous response was cut off",
     "[System: Your previous tool call", "[Your active task list was preserved across context compression]",
     "[IMPORTANT: Background process ",
+    "[System:", "[Planning state preserved", "Cronjob Response:",
+    # A background subagent's result (tools/process_registry_notifications.py).
+    "[ASYNC DELEGATION",
+    # Another agent's message relayed into this chat by a hub: "[Agent message am_<id> from <sender>]".
+    "[Agent message ",
+    # Gateway notices: a process notification and a subagent resumed after a restart.
+    "[INTERNAL NOTIFICATION", "[The gateway restarted while you were working",
 )
+# Appended (not prepended) to gateway process notifications (gateway/run_notifications.py).
+_INTERNAL_NOTIFICATION_FOOTER_OPEN = "[INTERNAL NOTIFICATION — generated by the Hermes gateway"
+# A mid-turn steer: the user's own words inside the marker.
+_STEER_OPEN = "[OUT-OF-BAND USER MESSAGE"
+_STEER_CLOSE = "[/OUT-OF-BAND USER MESSAGE]"
+# A hub page's answer, sent as the user: '[Answer from the page "<title>"]' then the page's text.
+PAGE_ANSWER_PREFIX = "[Answer from the page "
+# Gateway notes put in front of a user's message ("[System note: ...]\n\n<message>").
+_LEADING_NOTE_RE = re.compile(r"\A\[System note:[^\n]*\](?:[ \t]*\n\n|\s*\Z)")
+_MEMORY_CONTEXT_RE = re.compile(r"\s*<\s*memory-context\s*>[\s\S]*?</\s*memory-context\s*>", re.IGNORECASE)
 
 
 def _message_text(message: Any) -> str:
@@ -33,6 +58,62 @@ def has_scaffolding_flag(message: dict) -> bool:
     return any(message.get(f) for f in _SYNTHETIC_USER_FLAGS)
 
 
+def strip_memory_context(text: str) -> str:
+    """*text* without fenced ``<memory-context>`` blocks (recalled memory is not the user's words)."""
+    return _MEMORY_CONTEXT_RE.sub("", text) if "memory-context" in text.lower() else text
+
+
+def _strip_timestamp(text: str) -> str:
+    try:
+        from gateway.message_timestamps import strip_leading_message_timestamps
+    except Exception:  # pragma: no cover - the gateway package ships with the agent
+        return text
+    return strip_leading_message_timestamps(text)[0]
+
+
+def user_authored_text_of(text: str) -> Optional[str]:
+    """The words a person wrote in user-role *text*, or ``None`` when no person wrote any of it.
+
+    Recalled memory is removed, a steer marker is unwrapped, leading ``[System note: ...]`` blocks a gateway
+    put in front of a message are dropped, and a page answer keeps its ``[Answer from the page ...]`` line
+    (it says where the answer came from). Subagent results, peer-agent messages, gateway notices and
+    runtime nudges give ``None``. A ``/skill`` turn is the user's (its typed form is read elsewhere)."""
+    text = strip_memory_context(_strip_timestamp(text or "").strip()).strip()
+    while (note := _LEADING_NOTE_RE.match(text)) is not None:
+        text = text[note.end():].lstrip()
+    if not text:
+        return None
+    if text.startswith(_STEER_OPEN):
+        body = text.split("\n", 1)[1] if "\n" in text else ""
+        # A steer can carry a relayed agent message (a parent steering its subagent through a hub).
+        return user_authored_text_of(body.split(_STEER_CLOSE, 1)[0])
+    if text.startswith(PAGE_ANSWER_PREFIX):
+        return text
+    from agent.skill_commands import skills_loaded_by_scaffold
+    if skills_loaded_by_scaffold(text):
+        return text
+    if text.startswith(_SYNTHETIC_USER_PREFIXES) or _INTERNAL_NOTIFICATION_FOOTER_OPEN in text[-400:]:
+        return None
+    return text
+
+
+def user_authored_text(message: Any) -> Optional[str]:
+    """``user_authored_text_of`` for a message: ``None`` for non-user roles and flagged scaffolding rows."""
+    if not isinstance(message, dict) or message.get("role") != "user" or has_scaffolding_flag(message):
+        return None
+    return user_authored_text_of(_message_text(message))
+
+
+def is_page_answer(text: str) -> bool:
+    """Whether *text* (as ``user_authored_text`` returns it) is an answer sent from a hub page."""
+    return isinstance(text, str) and text.startswith(PAGE_ANSWER_PREFIX)
+
+
 def is_user_role_scaffolding(message: dict) -> bool:
-    """A runtime row in the user role, by flag or opening text (nudges, task-list snapshots, single background-process completion and watch-match notices)."""
-    return has_scaffolding_flag(message) or _message_text(message).strip().startswith(_SYNTHETIC_USER_PREFIXES)
+    """A runtime row in the user role: flagged by its producer, or text in which no person wrote anything
+    (nudges, task-list snapshots, process notices, subagent results, peer-agent messages). A row with no
+    text at all (an image-only turn) is not scaffolding."""
+    if has_scaffolding_flag(message):
+        return True
+    text = strip_memory_context(_message_text(message))
+    return bool(text.strip()) and user_authored_text_of(text) is None
