             "service_tier": service_tier_word(_tier_in_effect(child)),
             **({"fallback_activated": True} if getattr(child, "_fallback_activated", False) is True else {})}
 
+def route_text(child: Any) -> Optional[str]:
+    """What a backend-routed child runs on, in words the parent model reads: ``route <label>: <model> via
+    <provider>``, or ``the default subagent route: ...`` when its backend gave it no label. A fallback provider
+    that took over is named. None where ``_route_report`` is None (the default backend keeps its result shape) and
+    for a child without a model."""
+    route = getattr(child, "_delegate_route", None)
+    model = _str_or_none(getattr(child, "model", None))
+    if not isinstance(route, dict) or not model:
+        return None
+    label = route.get("label")
+    provider = _str_or_none(getattr(child, "provider", None))
+    text = (f"route {label}" if isinstance(label, str) and label else "the default subagent route") + f": {model}"
+    if provider:
+        text += f" via {provider}"
+    if getattr(child, "_fallback_activated", False) is True:
+        text += " (a fallback provider took over)"
+    return text
+
 def _fabricated_entry(idx: int, status: str, error: str, child: Any, duration: float = 0) -> dict[str, Any]:
     """Result entry for a child that raised, never finished, or was abandoned."""
     entry = {
@@ -102,6 +120,8 @@ def _fabricated_entry(idx: int, status: str, error: str, child: Any, duration: f
     route = _route_report(child)
     if route is not None:
         entry["route"] = route
+    if (ran_on := route_text(child)) is not None:
+        entry["ran_on"] = ran_on
     return entry
 
