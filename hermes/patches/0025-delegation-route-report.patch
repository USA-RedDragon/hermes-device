+"""A background delegation names the route, model and provider each subagent runs on: in the dispatch handle and
+in each task's block of the completion notice, so a parent never has to guess which model did the work."""
+from types import SimpleNamespace
+
+from tools.process_registry_notifications import format_process_notification
+
+
+def _batch_event(results, model="qwen3.5:2b"):
+    return {"type": "async_delegation", "delegation_id": "deleg_r", "is_batch": True, "goals": ["read", "review"],
+            "results": results, "role": "leaf", "model": model, "dispatched_at": 1.0, "completed_at": 5.0,
+            "total_duration_seconds": 4.0}
+
+
+def _ok(index, ran_on=None):
+    return {"task_index": index, "status": "completed", "summary": f"done {index}", "duration_seconds": 2.0,
+            **({"ran_on": ran_on} if ran_on else {})}
+
+
+def test_each_task_block_names_its_route_and_the_unit_model_is_not_claimed_for_all():
+    text = format_process_notification(_batch_event([
+        _ok(0, "route quick: qwen3.5:2b via custom"), _ok(1, "route sonnet: claude-sonnet-5-5 via claude-pool")]))
+    first, second = text.split("--- ✓ TASK 1/2")[1].split("--- ✓ TASK 2/2")
+    assert "Ran on route quick: qwen3.5:2b via custom." in first
+    assert "Ran on route sonnet: claude-sonnet-5-5 via claude-pool." in second
+    assert "Model: qwen3.5:2b" not in text
+
+
+def test_results_without_a_route_keep_the_unit_model_line():
+    text = format_process_notification(_batch_event([_ok(0), _ok(1)]))
+    assert "Model: qwen3.5:2b" in text and "Ran on" not in text
+
+
+def test_an_early_failure_notice_names_the_failed_tasks_route():
+    evt = {**_batch_event([{"task_index": 1, "status": "error", "error": "429", "duration_seconds": 3,
+                            "ran_on": "route opus: claude-opus-5-5 via claude-pool"}]), "task_failure_notice": True,
+           "n_tasks": 2}
+    assert "Ran on route opus: claude-opus-5-5 via claude-pool." in format_process_notification(evt)
+
+
+def test_a_single_completion_names_its_route_in_place_of_the_model():
+    evt = {"type": "async_delegation", "delegation_id": "deleg_s", "goal": "review", "status": "completed",
+           "summary": "lgtm", "model": "claude-sonnet-5-5", "duration_seconds": 3.0,
+           "ran_on": "route sonnet: claude-sonnet-5-5 via claude-pool"}
+    text = format_process_notification(evt)
+    assert "Ran on route sonnet: claude-sonnet-5-5 via claude-pool." in text and "Model:" not in text
+
+
+def test_the_dispatch_handle_lists_what_each_routed_child_runs_on():
+    from tools.delegate_tool_dispatch import _dispatched_payload
+
+    def child(label, model, provider):
+        return SimpleNamespace(_delegate_route={"backend": "model_map", "label": label}, model=model,
+                               provider=provider, _subagent_id=None)
+
+    batch = SimpleNamespace(
+        task_list=[{"goal": "a"}, {"goal": "b"}, {"goal": "c"}], live_deleg_id="deleg_h", refused=[], live_paths=[],
+        children=[(0, {}, child("haiku", "claude-haiku-5-5", "claude-pool")),
+                  (2, {}, SimpleNamespace(_delegate_route=None, model="m", provider="p", _subagent_id=None))])
+    payload = _dispatched_payload(batch, [(batch, "deleg_h")])
+    assert payload["runs_on"] == [{"task_index": 0, "runs_on": "route haiku: claude-haiku-5-5 via claude-pool"}]
