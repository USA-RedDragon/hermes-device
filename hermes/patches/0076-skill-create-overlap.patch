index 00000000..6ad64eb9
--- /dev/null
+++ b/tools/skill_overlap.py
@@ -0,0 +1,106 @@
+"""Overlap check for ``skill_manage`` create: find installed skills a new skill would duplicate.
+
+Deterministic token overlap on the skill name and description, no model call. With
+``skills.create_overlap_threshold`` above 0, a create whose best match scores at or above it is
+refused with the top matches, unless the create carries a short ``why_new`` reason.
+"""
+from __future__ import annotations
+
+import re
+from typing import Any, Optional
+
+# Words that say nothing about a skill's topic: grammar, and the frame every description shares
+# ("Use when <trigger>. <behavior>.").
+_STOP = frozenset((
+    "a an and are as at be by for from how in into is it its of on or our that the their then this "
+    "to use used uses using when whenever with without you your skill skills agent agents "
+    "any all each per via not no do does done can may must should will also more most other").split())
+_MIN_LEN = 2
+_SPLIT = re.compile(r"[^a-z0-9]+")
+MAX_MATCHES = 3
+MAX_WHY_NEW = 500
+
+
+def _stem(word: str) -> str:
+    for suffix in ("ing", "es", "s"):
+        if word.endswith(suffix) and len(word) - len(suffix) >= 3:
+            return word[:-len(suffix)]
+    return word
+
+
+def tokens(text: str) -> frozenset[str]:
+    """Lowercase topic words of ``text``: split on non-alphanumerics, drop stop words and short words."""
+    words = (_stem(w) for w in _SPLIT.split((text or "").lower()))
+    return frozenset(w for w in words if len(w) >= _MIN_LEN and w not in _STOP)
+
+
+def _jaccard(a: frozenset[str], b: frozenset[str]) -> float:
+    return len(a & b) / len(a | b) if a and b else 0.0
+
+
+def _cover(a: frozenset[str], b: frozenset[str]) -> float:
+    return len(a & b) / min(len(a), len(b)) if a and b else 0.0
+
+
+def score(name: str, description: str, other_name: str, other_description: str) -> float:
+    """0..1. The name overlap (share of the shorter name's words) and the description overlap (Jaccard)
+    each count half; one identical name word alone cannot reach 0.5 unless the names are one word."""
+    n_new, n_old = tokens(name), tokens(other_name)
+    d_new, d_old = tokens(description), tokens(other_description)
+    return round(0.5 * _cover(n_new, n_old) + 0.5 * _jaccard(d_new, d_old), 3)
+
+
+def find_overlaps(name: str, description: str, skills: list[dict[str, Any]], *,
+                  threshold: float, limit: int = MAX_MATCHES) -> list[dict[str, Any]]:
+    """The installed skills scoring at or above ``threshold``, best first (name order breaks ties)."""
+    if threshold <= 0:
+        return []
+    found = []
+    for skill in skills:
+        other = str(skill.get("name") or "")
+        if not other or other == name:
+            continue
+        s = score(name, description, other, str(skill.get("description") or ""))
+        if s >= threshold:
+            found.append({"name": other, "category": skill.get("category") or "",
+                          "description": skill.get("description") or "", "score": s})
+    found.sort(key=lambda m: (-m["score"], m["name"]))
+    return found[:limit]
+
+
+def configured_threshold() -> float:
+    """``skills.create_overlap_threshold`` (0 = off, upstream's behavior); a bad value reads as off."""
+    try:
+        from hermes_cli.config import cfg_get, load_config
+        value = float(cfg_get(load_config(), "skills", "create_overlap_threshold") or 0)
+    except Exception:
+        return 0.0
+    return min(value, 1.0) if value > 0 else 0.0
+
+
+def check_create(name: str, content: str, why_new: Optional[str]) -> Optional[dict[str, Any]]:
+    """None to let the create proceed, else the error result that lists the matches.
+
+    Proceeds when the check is off, when ``why_new`` holds a reason, or when no skill overlaps. Fails
+    open: a lookup error must never stop an agent from saving a lesson."""
+    threshold = configured_threshold()
+    if threshold <= 0 or (isinstance(why_new, str) and why_new.strip()):
+        return None
+    try:
+        from agent.skill_utils import parse_frontmatter
+        from tools.skills_tool import find_all_skills
+        frontmatter, _ = parse_frontmatter(content)
+        matches = find_overlaps(name, str(frontmatter.get("description") or ""),
+                                find_all_skills(skip_disabled=True), threshold=threshold)
+    except Exception:
+        return None
+    if not matches:
+        return None
+    names = ", ".join(f"'{m['name']}'" for m in matches)
+    return {
+        "success": False,
+        "error": (f"Not created: '{name}' overlaps installed skills ({names}). Extend one of them: "
+                  f"skill_view it, then skill_manage patch (or write_file for a reference file). If none of them "
+                  f"fits, create again with why_new: one short sentence on why this is a new topic."),
+        "overlapping_skills": matches,
+        "why_new_hint": "Retry the create with why_new set only when no listed skill covers the topic."}
