+"""skill_manage create: refuse a skill that overlaps an installed one unless the create says why_new."""
+
+import json
+from contextlib import contextmanager
+from unittest.mock import patch
+
+import pytest
+
+from tools import skill_overlap
+from tools.skill_manager_tool import SKILL_MANAGE_SCHEMA, skill_manage
+
+
+def _content(name, description):
+    return f"---\nname: {name}\ndescription: {description}\n---\n\n# {name}\n\nStep 1: Do the thing.\n"
+
+
+@contextmanager
+def _skills(tmp_path, threshold):
+    with patch("tools.skill_manager_tool.SKILLS_DIR", tmp_path), patch("tools.skills_tool.SKILLS_DIR", tmp_path), \
+         patch("agent.skill_utils.get_all_skills_dirs", return_value=[tmp_path]), \
+         patch("tools.skill_overlap.configured_threshold", return_value=threshold):
+        yield
+
+
+def _create(name, description, **extra):
+    op = {"action": "create", "name": name, "content": _content(name, description), **extra}
+    return json.loads(skill_manage(action="", name="", operations=[op]))
+
+
+def _flat_create(name, description, **extra):
+    return json.loads(skill_manage(action="create", name=name, content=_content(name, description), **extra))
+
+
+FLUX = ("flux-app", "Use when adding or changing an app in the Flux repo.")
+
+
+def _seed(tmp_path):
+    assert _create(*FLUX)["success"] is True
+
+
+class TestScoring:
+    def test_same_topic_scores_high_and_other_topic_low(self):
+        near = skill_overlap.score("flux-app-values", "Use when editing a Flux app values file.", *FLUX)
+        far = skill_overlap.score("gardening-tips", "Use when planning a vegetable garden.", *FLUX)
+        assert near >= 0.35 > far
+        assert far == 0.0
+
+    def test_scoring_is_deterministic_and_ignores_case_and_plurals(self):
+        a = skill_overlap.score("Flux-Apps", "Changing Flux apps", *FLUX)
+        assert a == skill_overlap.score("Flux-Apps", "Changing Flux apps", *FLUX)
+        assert skill_overlap.tokens("Apps, Flux!") == skill_overlap.tokens("app flux")
+
+    def test_top_three_best_first_with_name_tie_break(self):
+        skills = [{"name": n, "description": "Deploy the cluster app"} for n in ("d", "c", "b", "a")]
+        found = skill_overlap.find_overlaps("deploy-cluster-app", "Deploy the cluster app", skills, threshold=0.1)
+        assert [m["name"] for m in found] == ["a", "b", "c"]
+
+    def test_threshold_zero_finds_nothing(self):
+        assert skill_overlap.find_overlaps("flux-app", FLUX[1], [dict(name="flux-app-x", description=FLUX[1])],
+                                           threshold=0) == []
+
+
+class TestCreateGate:
+    def test_overlap_is_refused_with_matches(self, tmp_path):
+        with _skills(tmp_path, 0.35):
+            _seed(tmp_path)
+            result = _create("flux-app-values", "Use when editing a Flux app values file.")
+        assert result["success"] is False
+        assert "flux-app" in result["error"] and "why_new" in result["error"]
+        assert result["failed_index"] == 0
+        assert [m["name"] for m in result["overlapping_skills"]] == ["flux-app"]
+        assert not (tmp_path / "flux-app-values").exists()
+
+    def test_why_new_lets_the_create_through(self, tmp_path):
+        with _skills(tmp_path, 0.35):
+            _seed(tmp_path)
+            result = _create("flux-app-values", "Use when editing a Flux app values file.",
+                             why_new="Values-file layout is a separate topic from app wiring.")
+        assert result["success"] is True
+        assert (tmp_path / "flux-app-values" / "SKILL.md").exists()
+
+    def test_blank_why_new_does_not_count(self, tmp_path):
+        with _skills(tmp_path, 0.35):
+            _seed(tmp_path)
+            result = _create("flux-app-values", "Use when editing a Flux app values file.", why_new="  ")
+        assert result["success"] is False
+
+    def test_flat_shape_is_gated_and_passes_with_why_new(self, tmp_path):
+        with _skills(tmp_path, 0.35):
+            _seed(tmp_path)
+            refused = _flat_create("flux-app-values", "Use when editing a Flux app values file.")
+            allowed = _flat_create("flux-app-values", "Use when editing a Flux app values file.",
+                                   why_new="Separate topic.")
+        assert refused["success"] is False and refused["overlapping_skills"]
+        assert allowed["success"] is True
+
+    def test_unrelated_create_needs_no_reason(self, tmp_path):
+        with _skills(tmp_path, 0.35):
+            _seed(tmp_path)
+            result = _create("gardening-tips", "Use when planning a vegetable garden.")
+        assert result["success"] is True
+
+    def test_off_by_default_changes_nothing(self, tmp_path):
+        with _skills(tmp_path, 0.0):
+            _seed(tmp_path)
+            result = _create("flux-app-values", "Use when editing a Flux app values file.")
+        assert result["success"] is True
+
+    def test_refusal_inside_a_batch_rolls_the_batch_back(self, tmp_path):
+        ops = [{"action": "create", "name": "gardening-tips",
+                "content": _content("gardening-tips", "Use when planning a vegetable garden.")},
+               {"action": "create", "name": "flux-app-values",
+                "content": _content("flux-app-values", "Use when editing a Flux app values file.")}]
+        with _skills(tmp_path, 0.35):
+            _seed(tmp_path)
+            result = json.loads(skill_manage(action="", name="", operations=ops))
+        assert result["success"] is False and result["failed_index"] == 1
+        assert not (tmp_path / "gardening-tips").exists()
+
+    def test_patch_write_and_edit_are_never_gated(self, tmp_path):
+        with _skills(tmp_path, 0.35):
+            _seed(tmp_path)
+            ops = [{"action": "patch", "name": "flux-app", "old_string": "Step 1", "new_string": "Step one"},
+                   {"action": "write_file", "name": "flux-app", "file_path": "references/a.md",
+                    "file_content": "x"}]
+            result = json.loads(skill_manage(action="", name="", operations=ops))
+        assert result["success"] is True
+
+    def test_a_lookup_failure_lets_the_create_through(self, tmp_path):
+        with _skills(tmp_path, 0.35), patch("tools.skills_tool.find_all_skills", side_effect=RuntimeError("boom")):
+            result = _create("flux-app-values", "Use when editing a Flux app values file.")
+        assert result["success"] is True
+
+
+class TestConfigAndSchema:
+    @pytest.mark.parametrize("value,expected", [(0.4, 0.4), (0, 0.0), ("0.5", 0.5), (7, 1.0), ("x", 0.0), (-1, 0.0), (None, 0.0)])
+    def test_configured_threshold(self, value, expected):
+        with patch("hermes_cli.config.load_config", return_value={"skills": {"create_overlap_threshold": value}}):
+            assert skill_overlap.configured_threshold() == expected
+
+    def test_default_is_off(self):
+        from hermes_cli.config_defaults import DEFAULT_CONFIG
+        assert DEFAULT_CONFIG["skills"]["create_overlap_threshold"] == 0.0
+
+    def test_description_and_schema_say_extend_first(self):
+        assert "Extend an existing skill when one covers the topic; create only for a new topic" \
+            in SKILL_MANAGE_SCHEMA["description"]
+        create = next(b for b in SKILL_MANAGE_SCHEMA["parameters"]["properties"]["operations"]["items"]["anyOf"]
+                      if b["properties"]["action"]["enum"] == ["create"])
+        assert create["properties"]["why_new"]["type"] == "string"
+        assert "why_new" not in create["required"]
