+class PipeProvider:
+    def __init__(self, command):
+        self.command = command
+        self.calls = []
+
+    def prepare(self):
+        self.calls.append("prepare")
+
+    def detach(self, session):
+        self.calls.append("detach")
+        return {"token": "abc"} if session.backend == "fake" else None
+
+    def commit(self):
+        self.calls.append("commit")
+
+    def reattach(self, state):
+        self.calls.append(("reattach", state["token"]))
+        return subprocess.Popen(["bash", "-c", self.command], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+                                stdin=subprocess.DEVNULL, text=True)
+
+
+@pytest.mark.platforms("linux")
+def test_provider_process_is_reattached_by_the_next_gateway(checkpoint):
+    old = ProcessRegistry()
+    provider = PipeProvider("printf 'later\\n'; exit 4")
+    old.register_reattach_provider("fake", provider)
+    proc = subprocess.Popen(["bash", "-c", "printf 'early\\n'; sleep 0.5"], stdout=subprocess.PIPE,
+                            stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, text=True)
+    session = old.adopt_local(proc, command="build", cwd=None, task_id="t1", notify_on_complete=True)
+    session.backend = "fake"
+    assert _wait(lambda: "early" in session.output_buffer)
+
+    assert old.hand_off_for_restart(["fake"]) == 1
+    assert provider.calls == ["prepare", "detach", "commit"]
+    proc.wait(5)
+    time.sleep(0.3)
+    assert _completions(old) == [] and not session.exited
+
+    new = ProcessRegistry()
+    new.register_reattach_provider("fake", provider)
+    assert new.recover_from_checkpoint() == 1
+    resumed = new.get(session.id)
+    assert resumed._completion_event.wait(10)
+    (event,) = _completions(new)
+    assert event["exit_code"] == 4
+    assert event["output"].index("early") < event["output"].index("later")
+
+
+@pytest.mark.platforms("linux")
+def test_handed_off_process_without_a_provider_is_reported_lost(checkpoint):
+    started = time.time() - 60
+    checkpoint.write_text(json.dumps([{
+        "session_id": "proc_handed000001", "command": "build", "pid": None, "pid_scope": "sandbox",
+        "started_at": started, "task_id": "t1", "notify_on_complete": True, "watcher_interval": 5,
+        "watcher_platform": "webapp", "watcher_chat_id": "chat-1",
+        "reattach": {"kind": "gone", "output_tail": "partial\n", "total_output_chars": 8},
+    }]))
+    registry = ProcessRegistry()
+    assert registry.recover_from_checkpoint() == 0
+    (event,) = _completions(registry)
+    assert event["session_id"] == "proc_handed000001"
+    assert event["completion_reason"] == "lost"
+    assert event["started_at"] == started
+    assert "partial" in event["output"]
+    assert [w["session_id"] for w in registry.pending_watchers] == ["proc_handed000001"]
+    assert json.loads(checkpoint.read_text()) == []
+
+
+@pytest.mark.asyncio
+async def test_gateway_hands_off_only_on_a_restart(monkeypatch):
+    from gateway.run_shutdown import GatewayShutdownMixin
+    calls = []
+    monkeypatch.setattr(handoff, "configured_handoff_backends", lambda: ["device"])
+    monkeypatch.setattr(pr.process_registry, "hand_off_for_restart", lambda backends: calls.append(backends))
+
+    await GatewayShutdownMixin._stop_hand_off_processes(SimpleNamespace(_restart_requested=False))
+    assert calls == []
+    await GatewayShutdownMixin._stop_hand_off_processes(SimpleNamespace(_restart_requested=True))
+    assert calls == [["device"]]
+    monkeypatch.setattr(handoff, "configured_handoff_backends", lambda: [])
+    await GatewayShutdownMixin._stop_hand_off_processes(SimpleNamespace(_restart_requested=True))
+    assert calls == [["device"]]
+
