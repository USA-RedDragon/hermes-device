+@pytest.mark.platforms("linux")
+def test_other_backends_still_read_error_text_as_an_exit(tmp_path, checkpoint, monkeypatch):
+    monkeypatch.setattr(handoff, "configured_handoff_backends", lambda: [])
+    env = ShellEnv(tmp_path)
+    registry = ProcessRegistry()
+    session = _spawn(registry, env, "sleep 30")
+    env.reachable = False
+    assert _wait(lambda: session.exited)
+    assert session.exit_code == -1
+    registry.kill_all(source="gateway_shutdown")
+
+
+@pytest.mark.platforms("linux")
+def test_reattached_session_does_not_exit_while_its_device_is_away(tmp_path, checkpoint, monkeypatch):
+    env = ShellEnv(tmp_path)
+    old = ProcessRegistry()
+    session = _spawn(old, env, "printf 'first\\n'; sleep 1.5; exit 5")
+    assert _wait(lambda: "first" in session.output_buffer)
+    old.hand_off_for_restart(["device"])
+    files = list(session.env_files)
+
+    class Elsewhere(ShellEnv):
+        """Commands land where the handed-over files are missing (the device has not reconnected)."""
+        def execute(self, command, **kwargs):
+            if self.reachable:
+                for path in files:
+                    command = command.replace(path, path + ".absent")
+            return super().execute(command, **kwargs)
+
+    away = Elsewhere(tmp_path)
+    monkeypatch.setattr(handoff, "_environment_for", lambda backend, s: away)
+    new = ProcessRegistry()
+    assert new.recover_from_checkpoint() == 1
+    resumed = new.get(session.id)
+    time.sleep(0.5)
+    assert not resumed.exited and resumed.output_buffer == "first\n"
+    assert resumed._heartbeat_total_at_last == resumed.total_output_chars
+    files.clear()
+    assert resumed._completion_event.wait(10)
+    assert resumed.exit_code == 5
+
+
+def test_another_writer_keeps_handed_off_entries(checkpoint):
+    checkpoint.write_text(json.dumps([{"session_id": "proc_handed000002", "command": "x", "pid": None,
+                                       "started_at": 1.0, "reattach": {"kind": "env"}}]))
+    ProcessRegistry()._write_checkpoint()
+    assert [e["session_id"] for e in json.loads(checkpoint.read_text())] == ["proc_handed000002"]
+
+
+@pytest.mark.platforms("linux")
+def test_handoff_stops_env_pollers_before_providers_prepare(tmp_path, checkpoint, monkeypatch):
+    monkeypatch.setattr(pr, "ENV_POLL_INTERVAL_SECONDS", 2)
+    env = ShellEnv(tmp_path)
+    registry = ProcessRegistry()
+    session = _spawn(registry, env, "sleep 30")
+    order = []
+
+    class Recorder:
+        def prepare(self):
+            order.append(("prepare", session._reader_thread.is_alive()))
+
+        def detach(self, _session):
+            return None
+
+    registry.register_reattach_provider("device", Recorder())
+    time.sleep(0.2)
+    started = time.monotonic()
+    assert registry.hand_off_for_restart(["device"]) == 1
+    assert time.monotonic() - started < 1.5
+    assert order == [("prepare", False)]
