new file mode 100644
index 0000000000..a245636347
--- /dev/null
+++ b/tools/process_registry_handoff.py
@@ -0,0 +1,224 @@
+"""Hand running background processes to the next gateway across a graceful restart.
+
+``terminal.process_handoff_backends`` names the backends whose processes run outside this
+process (a remote shell, a paired device) and so can outlive it. On a restart stop the gateway
+hands those processes off instead of killing them: their state goes into the checkpoint
+(``processes.json``), and the next gateway reattaches them at startup, keeping the process
+session id, its output so far, and its notify_on_complete routing.
+
+Env-backed processes (``terminal(background=true)`` on a non-local backend) are handled here:
+the wrapper writes a log, pid and exit file, so the next gateway only needs the env and the log
+offset. Other processes are handled by providers that plugins register under a backend name
+(:meth:`ProcessHandoffMixin.register_reattach_provider`).
+"""
+
+import contextvars
+import logging
+import time
+from typing import Any, Iterable, Optional
+
+logger = logging.getLogger("tools.process_registry")
+
+# Output already read that the next gateway shows in the completion notice.
+HANDOFF_OUTPUT_TAIL_CHARS = 20_000
+# How long a handoff waits for an env poller that is inside a probe to notice it must stop.
+HANDOFF_POLLER_JOIN_SECONDS = 20.0
+ENV_KIND = "env"
+
+
+def configured_handoff_backends() -> list[str]:
+    """``terminal.process_handoff_backends``: backends whose processes survive a restart."""
+    from hermes_cli.config import cfg_get
+    from tools.process_registry_wait_policy import _effective_config
+    try:
+        value = cfg_get(_effective_config(), "terminal", "process_handoff_backends", default=[]) or []
+    except Exception:
+        logger.debug("terminal.process_handoff_backends unreadable; no process handoff", exc_info=True)
+        return []
+    if isinstance(value, str):
+        value = [value]
+    return [str(name).strip() for name in value if str(name).strip() and str(name).strip() != "local"]
+
+
+class ProcessHandoffMixin:
+    _reattach_providers: Optional[dict] = None
+
+    def register_reattach_provider(self, name: str, provider: Any) -> None:
+        """Register *provider* for processes of backend *name*. It is consulted only when *name*
+        is in ``terminal.process_handoff_backends``. From a worker thread, a graceful restart calls
+        ``prepare()`` (optional) once, ``detach(session)`` per running session (a JSON-safe state
+        dict when the provider owns the process and it keeps running, else None) and ``commit()``
+        (optional). The next gateway's startup calls ``reattach(state)``, which returns a Popen-like
+        handle the registry reads like an adopted process, or None when the process is gone."""
+        if self._reattach_providers is None:
+            self._reattach_providers = {}
+        self._reattach_providers[name] = provider
+
+    def hand_off_for_restart(self, backends: Iterable[str]) -> int:
+        """Hand every running process of *backends* to the next gateway; returns how many.
+        A handed-off session stays in the running table (so the checkpoint keeps it) but this
+        process never finishes, kills or reports it again."""
+        backends = {name for name in backends if name}
+        if not backends:
+            return 0
+        providers = {name: p for name, p in (self._reattach_providers or {}).items() if name in backends}
+        with self._lock:
+            candidates = [s for s in self._running.values() if not s.exited and not s.handed_off]
+        # Before any provider prepares: a poller inside a probe finishes it while the backend's
+        # connection is still up, instead of waiting out the probe's timeout.
+        self._stop_env_pollers([s for s in candidates if self._env_handoff(s, backends)])
+        for name, provider in providers.items():
+            self._call_provider(name, provider, "prepare")
+        handed = 0
+        for session in candidates:
+            state = self._detach_session(session, backends, providers)
+            if state is None:
+                continue
+            with session._lock:
+                if session.exited:
+                    continue
+                state["output_tail"] = session.output_buffer[-HANDOFF_OUTPUT_TAIL_CHARS:]
+                state["total_output_chars"] = session.total_output_chars
+                session.reattach = state
+                session.handed_off = True
+            handed += 1
+        for name, provider in providers.items():
+            self._call_provider(name, provider, "commit")
+        self._write_checkpoint()
+        if handed:
+            logger.info("Handed %d background process(es) to the next gateway", handed)
+        return handed
+
+    @staticmethod
+    def _call_provider(name: str, provider: Any, method: str, *args) -> Any:
+        fn = getattr(provider, method, None)
+        if not callable(fn):
+            return None
+        try:
+            return fn(*args)
+        except Exception:
+            logger.warning("Process handoff provider %s.%s failed", name, method, exc_info=True)
+            return None
+
+    @staticmethod
+    def _retries_unreachable(session) -> bool:
+        """An env probe that is not an exit status means "not reachable now" only for a backend
+        that hands processes off (a device reconnects); elsewhere it reads as an exit, as before."""
+        return bool(session.backend) and session.backend in configured_handoff_backends()
+
+    @staticmethod
+    def _env_handoff(session, backends) -> bool:
+        return session.env_ref is not None and session.backend in backends and len(session.env_files) == 3
+
+    @staticmethod
+    def _stop_env_pollers(sessions) -> None:
+        """Stop every env poller at once, then wait for them together under one deadline. An exit a
+        poller sees from now on stays in the exit file for the next gateway to read."""
+        stopping = []
+        for session in sessions:
+            with session._lock:
+                if session.exited:
+                    continue
+                session.handed_off = True
+            session._poll_wake.set()
+            stopping.append(session)
+        deadline = time.monotonic() + HANDOFF_POLLER_JOIN_SECONDS
+        for session in stopping:
+            reader = session._reader_thread
+            if reader is not None and reader.is_alive():
+                reader.join(max(0.0, deadline - time.monotonic()))
+
+    def _detach_session(self, session, backends, providers) -> Optional[dict]:
+        if self._env_handoff(session, backends):
+            with session._lock:
+                if session.exited or not session.handed_off:
+                    return None
+                return {"kind": ENV_KIND, "backend": session.backend, "files": list(session.env_files),
+                        "offset": session.env_offset}
+        for name, provider in providers.items():
+            state = self._call_provider(name, provider, "detach", session)
+            if isinstance(state, dict):
+                return {**state, "kind": name}
+        return None
+
+    def reattach_from_checkpoint(self, entry: dict) -> bool:
+        """Rebuild a session the last gateway handed off. True when it runs on here; a process
+        that cannot be reattached is reported once as lost, so its owner still hears about it."""
+        from tools.process_registry import ProcessSession, _CHECKPOINT_DEFAULTS, _CHECKPOINT_FIELDS
+        state = dict(entry.get("reattach") or {})
+        fields = {f: entry.get(f, _CHECKPOINT_DEFAULTS[f]) for f in _CHECKPOINT_FIELDS}
+        fields.update(
+            command=entry.get("command", "unknown"),
+            owner_task_id=entry.get("owner_task_id", "") or entry.get("task_id", ""),
+            started_at=entry.get("started_at", time.time()), reattach={})
+        session = ProcessSession(id=entry["session_id"], **fields)
+        session.output_buffer = str(state.get("output_tail") or "")[-session.max_output_chars:]
+        session.total_output_chars = int(state.get("total_output_chars") or len(session.output_buffer))
+        session._heartbeat_total_at_last = session.total_output_chars
+        session._reattached = True
+        kind = state.get("kind")
+        try:
+            if kind == ENV_KIND:
+                started = self._reattach_env_session(session, state)
+            else:
+                started = self._reattach_provider_session(session, kind, state)
+        except Exception:
+            logger.warning("Could not reattach process %s (%s)", session.id, kind, exc_info=True)
+            started = False
+        if not started:
+            with self._lock:
+                self._running[session.id] = session
+            self._finish_exited(session, -1, reason="lost", source="handoff_lost")
+            logger.info("Handed-off process %s could not be reattached; reported lost", session.id)
+        else:
+            logger.info("Reattached handed-off process %s (%s)", session.id, kind)
+        if session.heartbeat_seconds > 0 and started:
+            self.arm_heartbeat(session, session.heartbeat_seconds)
+        return started
+
+    def _reattach_env_session(self, session, state: dict) -> bool:
+        files = state.get("files") or []
+        backend = state.get("backend") or ""
+        if len(files) != 3 or not backend:
+            return False
+        env = _environment_for(backend, session)
+        session.env_ref = env
+        session.pid_scope = "sandbox"
+        session.backend = backend
+        session.env_files = list(files)
+        session.env_offset = int(state.get("offset") or 0)
+        context = contextvars.Context()
+        context.run(_bind_session_context, session.parent_session_id)
+        context.run(self._track_started, session, self._env_poller_loop, f"proc-poller-{session.id}", (env, *files))
+        return True
+
+    def _reattach_provider_session(self, session, kind, state: dict) -> bool:
+        provider = (self._reattach_providers or {}).get(kind)
+        if provider is None:
+            return False
+        handle = provider.reattach(state)
+        if handle is None:
+            return False
+        session.process = handle
+        session.pid = getattr(handle, "pid", None)
+        session.backend = kind
+        self._track_started(session, self._reader_loop, f"proc-reader-{session.id}")
+        return True
+
+
+def _bind_session_context(session_id: str) -> None:
+    """Env backends that route by the spawning conversation (a device binding) read it here."""
+    if not session_id:
+        return
+    from gateway.session_context import _SESSION_ID
+    _SESSION_ID.set(session_id)
+
+
+def _environment_for(backend: str, session) -> Any:
+    """A fresh environment of *backend* for polling a handed-off process's files."""
+    from tools.terminal_tool import _get_env_config, _select_image
+    from tools.terminal_tool_lifecycle import _create_configured_env
+    config = _get_env_config()
+    return _create_configured_env(
+        config, backend, image=_select_image(backend, {}, config), cwd=session.cwd or config["cwd"],
+        timeout=config["timeout"], task_id=session.task_id or "default", host_cwd=None)
