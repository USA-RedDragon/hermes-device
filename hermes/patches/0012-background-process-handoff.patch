+"""terminal.process_handoff_backends: background processes survive a graceful gateway restart."""
+import json
+import os
+import subprocess
+import tempfile
+import time
+from types import SimpleNamespace
+
+import pytest
+
+import tools.process_registry as pr
+import tools.process_registry_handoff as handoff
+from gateway.session_context import _SESSION_ID, _UNSET
+from tools.process_registry import ProcessRegistry
+
+
+class ShellEnv:
+    """A non-local backend whose shell runs on this host; ``reachable=False`` answers like a
+    device that is reconnecting."""
+
+    def __init__(self, temp_dir):
+        self.temp_dir = str(temp_dir)
+        self.reachable = True
+        self.session_ids = set()
+
+    def get_temp_dir(self):
+        return self.temp_dir
+
+    def execute(self, command, cwd="", timeout=10, **_kwargs):
+        value = _SESSION_ID.get()
+        if value is not _UNSET:
+            self.session_ids.add(value)
+        if not self.reachable:
+            return {"output": "[device alice-pc is not connected, so the command did not run]", "returncode": 255}
+        with tempfile.TemporaryFile(dir=self.temp_dir) as out:
+            result = subprocess.run(["bash", "-c", command], stdout=out, stderr=subprocess.STDOUT,
+                                    timeout=timeout, cwd=cwd or None, stdin=subprocess.DEVNULL)
+            out.seek(0)
+            return {"output": out.read().decode(errors="replace"), "returncode": result.returncode}
+
+
+@pytest.fixture
+def checkpoint(tmp_path, monkeypatch):
+    path = tmp_path / "processes.json"
+    monkeypatch.setattr(pr, "CHECKPOINT_PATH", path)
+    monkeypatch.setattr(pr, "ENV_POLL_INTERVAL_SECONDS", 0.05)
+    monkeypatch.setattr(handoff, "configured_handoff_backends", lambda: ["device"])
+    return path
+
+
+def _wait(predicate, timeout=10.0):
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        if predicate():
+            return True
+        time.sleep(0.02)
+    return False
+
+
+def _completions(registry):
+    events = []
+    while not registry.completion_queue.empty():
+        event = registry.completion_queue.get_nowait()
+        if event.get("type") == "completion":
+            events.append(event)
+    return events
+
+
+def _spawn(registry, env, command):
+    session = registry.spawn_via_env(env, command, task_id="t1", session_key="agent:main:webapp:dm:1",
+                                     backend="device")
+    session.notify_on_complete = True
+    session.parent_session_id = "sess-1"
+    session.watcher_platform = "webapp"
+    session.watcher_chat_id = "chat-1"
+    session.watcher_interval = 5
+    registry._write_checkpoint()
+    return session
+
+
+def _pid_alive(pid):
+    try:
+        os.kill(pid, 0)
+    except OSError:
+        return False
+    return True
+
+
+def test_backends_default_to_none(monkeypatch):
+    monkeypatch.setattr("tools.process_registry_wait_policy._effective_config", lambda: {})
+    assert handoff.configured_handoff_backends() == []
+    monkeypatch.setattr("tools.process_registry_wait_policy._effective_config",
+                        lambda: {"terminal": {"process_handoff_backends": ["device", "local", " "]}})
+    assert handoff.configured_handoff_backends() == ["device"]
+
+
+@pytest.mark.platforms("linux")
+def test_env_process_runs_on_and_reports_through_the_next_gateway(tmp_path, checkpoint, monkeypatch):
+    env = ShellEnv(tmp_path)
+    old = ProcessRegistry()
+    session = _spawn(old, env, "printf 'first\\n'; sleep 1.5; printf 'second\\n'; exit 3")
+    assert _wait(lambda: "first" in session.output_buffer)
+
+    assert old.hand_off_for_restart(["device"]) == 1
+    assert session.handed_off and not session.exited
+    assert old.kill_all(source="gateway_shutdown") == 0
+    assert old.kill_process(session.id)["status"] == "handed_off"
+    host_pid = int(open(session.env_files[1]).read())
+    assert _pid_alive(host_pid)
+    entry = json.loads(checkpoint.read_text())[0]
+    assert entry["session_id"] == session.id
+    assert entry["reattach"]["kind"] == "env"
+    assert entry["reattach"]["offset"] == len("first\n")
+    assert entry["reattach"]["output_tail"] == "first\n"
+
+    new = ProcessRegistry()
+    monkeypatch.setattr(handoff, "_environment_for", lambda backend, s: env)
+    assert new.recover_from_checkpoint() == 1
+    resumed = new.get(session.id)
+    assert resumed is not None and resumed.started_at == session.started_at
+    assert [w["session_id"] for w in new.pending_watchers] == [session.id]
+    assert resumed._completion_event.wait(10)
+    (event,) = _completions(new)
+    assert event["session_id"] == session.id
+    assert event["started_at"] == session.started_at
+    assert event["exit_code"] == 3
+    assert event["output"].count("first") == 1 and event["output"].count("second") == 1
+    assert env.session_ids == {"sess-1"}
+    time.sleep(0.3)
+    assert _completions(old) == []
+    assert not session.exited
+
+
+@pytest.mark.platforms("linux")
+def test_without_backends_nothing_is_handed_off(tmp_path, checkpoint):
+    env = ShellEnv(tmp_path)
+    registry = ProcessRegistry()
+    session = _spawn(registry, env, "sleep 30")
+    assert registry.hand_off_for_restart([]) == 0
+    assert registry.hand_off_for_restart(["docker"]) == 0
+    assert not session.handed_off
+    assert registry.kill_all(source="gateway_shutdown") == 1
+    assert session.exited
+
+
+@pytest.mark.platforms("linux")
+def test_unreachable_backend_is_not_an_exit(tmp_path, checkpoint, monkeypatch):
+    env = ShellEnv(tmp_path)
+    registry = ProcessRegistry()
+    session = _spawn(registry, env, "sleep 0.5; exit 7")
+    env.reachable = False
+    time.sleep(1.0)
+    assert not session.exited
+    env.reachable = True
+    assert _wait(lambda: session.exited)
+    assert session.exit_code == 7
+
+
+@pytest.mark.platforms("linux")
+def test_backend_unreachable_past_the_cap_is_lost(tmp_path, checkpoint, monkeypatch):
+    monkeypatch.setattr(pr, "ENV_UNREACHABLE_LOST_SECONDS", 0.3)
+    env = ShellEnv(tmp_path)
+    registry = ProcessRegistry()
+    session = _spawn(registry, env, "sleep 30")
+    env.reachable = False
+    assert _wait(lambda: session.exited)
+    assert session.completion_reason == "lost"
+
