+    async def _stop_hand_off_processes(self) -> None:
+        """Restart only: hand the background processes of ``terminal.process_handoff_backends`` to
+        the next gateway before any kill sweep, so they keep running and it reattaches them."""
+        if not getattr(self, "_restart_requested", False):
+            return
+        from tools.process_registry_handoff import configured_handoff_backends
