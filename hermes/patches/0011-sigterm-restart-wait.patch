+    # The write half of a restart's agent release: queued memory work, then the providers' session-end
+    # flush (Honcho joins its sync thread for up to 10 s, then flushes): the upstream per-step bounds.
+    _MEMORY_FLUSH_TIMEOUT_S = 25.0
+
+    async def _flush_agent_memory_off_loop(self, agent: Any, session_key: Optional[str]) -> None:
+        if agent is None:
+            return
+        try:
+            await asyncio.wait_for(
+                self._run_housekeeping_in_executor(
+                    self._run_release_in_profile_scope, GatewayShutdownMixin._flush_agent_memory, (agent,),
+                    session_key),
+                timeout=GatewayShutdownMixin._MEMORY_FLUSH_TIMEOUT_S)
+        except TimeoutError:
+            logger.warning("Memory flush before release exceeded %ss; releasing anyway",
+                           GatewayShutdownMixin._MEMORY_FLUSH_TIMEOUT_S)
+        except Exception as exc:
+            logger.warning("Memory flush before release failed: %s", exc)
+
+    @staticmethod
+    def _flush_agent_memory(agent: Any) -> None:
+        """Drain *agent*'s queued memory writes and run the providers' session end, without the provider
+        shutdown that joins read-ahead threads; ``shutdown_memory_provider`` then skips the session end."""
+        mm = getattr(agent, "_memory_manager", None)
+        if mm is None or getattr(agent, "_memory_provider_shutdown", False):
+            return
+        if not mm.claim_teardown(session_end=True):
+            return
+        mm.flush_pending(timeout=10)
+        messages = getattr(agent, "_session_messages", None)
+        mm.on_session_end(messages if isinstance(messages, list) else [])
+        agent._memory_session_ended = True
+
+    @staticmethod
