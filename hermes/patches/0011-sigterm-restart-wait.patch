index 0ceec63234..7272358907 100644
--- a/cli-config.yaml.example
+++ b/cli-config.yaml.example
@@ -1466,6 +1466,23 @@ gateway:
   # 0 keeps the immediate exit.
   # runtime_lock_wait_seconds: 0
 
+  # Treat a supervisor's SIGTERM (Kubernetes, docker stop) like SIGUSR1: a
+  # graceful restart that lets active turns finish (agent.restart_after_turn_timeout)
+  # while clients can still answer approvals and clarify questions, and new
+  # input is kept for the next gateway. A second SIGTERM stops at once.
+  # sigterm_restart_wait: false
+
+  # Plugins whose WebSocket routes still accept connections during that restart
+  # wait, so a plugin connection the finishing turns use (a paired device) can
+  # reconnect. Other new connections are refused while the gateway drains.
+  # restart_wait_plugin_sockets: []
+
+  # On such a restart, release the idle cached agents together within this
+  # many seconds instead of up to 30 s each (a memory provider's read-ahead
+  # for a next turn is abandoned), so the next gateway takes over sooner.
+  # 0 keeps the upstream bound.
+  # restart_agent_cleanup_seconds: 0
+
 # =============================================================================
 # Toolsets
 # =============================================================================
