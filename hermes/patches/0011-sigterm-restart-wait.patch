+def restart_wait_plugin_socket(runner, scope_type, path) -> bool:
+    """True for a WebSocket upgrade to a plugin listed in ``gateway.restart_wait_plugin_sockets``
+    while *runner* is in a restart's after-turn wait: a plugin's own connection (a device that
+    runs the turns' commands) that dropped can reconnect while those turns finish."""
+    if scope_type != "websocket" or not restart_wait_open(runner):
+        return False
+    names = getattr(getattr(runner, "config", None), "restart_wait_plugin_sockets", None) or ()
+    return any((path or "").startswith(f"/api/plugins/{name}/") for name in names)
+
