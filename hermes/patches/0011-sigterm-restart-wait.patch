@@ -0,0 +1,232 @@
+"""gateway.sigterm_restart_wait: a supervisor's SIGTERM restarts gracefully like SIGUSR1."""
+import asyncio
+import signal
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+import gateway.run as run_mod
+import gateway.shutdown_forensics as forensics
+from gateway import status
+from gateway.config import GatewayConfig, load_gateway_config
+from gateway.drain_control import RESTART_WAIT_REASON, restart_wait_open, ws_method_refused_while_draining
+from tests.gateway.restart_test_helpers import make_restart_runner
+
+
+@pytest.fixture(autouse=True)
+def _no_markers(monkeypatch):
+    monkeypatch.setattr(status, "consume_takeover_marker_for_self", lambda: False)
+    monkeypatch.setattr(status, "consume_planned_stop_marker_for_self", lambda: False)
+    monkeypatch.setattr(forensics, "snapshot_shutdown_context", lambda *a, **k: None)
+
+
+def _double(enabled, restart_result=True):
+    runner = SimpleNamespace(config=GatewayConfig(sigterm_restart_wait=enabled), _stop_task=None, _running=True)
+    runner.request_restart = MagicMock(return_value=restart_result)
+    runner.stop = MagicMock(side_effect=lambda: asyncio.sleep(0))
+    return runner
+
+
+def _handle(runner, sig, monkeypatch):
+    stops = []
+    monkeypatch.setattr(run_mod.asyncio, "create_task", lambda coro: (stops.append(coro), coro.close()))
+    flag = [False]
+    run_mod._start_gateway_make_shutdown_signal_handler(runner, flag)(sig)
+    return stops, flag[0]
+
+
+def test_off_by_default():
+    assert GatewayConfig().sigterm_restart_wait is False
+    assert GatewayConfig.from_dict({}).sigterm_restart_wait is False
+    assert GatewayConfig.from_dict({"gateway": {"sigterm_restart_wait": True}}).sigterm_restart_wait is True
+
+
+def test_config_yaml_key_reaches_the_runner_config(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    (tmp_path / "config.yaml").write_text("gateway:\n  sigterm_restart_wait: true\n", encoding="utf-8")
+    assert load_gateway_config().sigterm_restart_wait is True
+
+
+def test_sigterm_takes_the_restart_path_when_enabled(monkeypatch):
+    runner = _double(True)
+    stops, unexpected = _handle(runner, signal.SIGTERM, monkeypatch)
+    runner.request_restart.assert_called_once_with(detached=False, via_service=True)
+    assert stops == []
+    assert unexpected is False
+    assert not getattr(runner, "_stop_requested_by_signal", False)
+
+
+def test_sigterm_stops_as_upstream_when_disabled(monkeypatch):
+    runner = _double(False)
+    stops, unexpected = _handle(runner, signal.SIGTERM, monkeypatch)
+    runner.request_restart.assert_not_called()
+    assert len(stops) == 1
+    assert unexpected is True
+    assert runner._stop_requested_by_signal is True
+
+
+def test_second_sigterm_during_the_restart_stops_now(monkeypatch):
+    runner = _double(True, restart_result=False)
+    stops, _ = _handle(runner, signal.SIGTERM, monkeypatch)
+    runner.request_restart.assert_called_once()
+    assert len(stops) == 1
+
+
+def test_sigint_still_stops(monkeypatch):
+    runner = _double(True)
+    stops, _ = _handle(runner, signal.SIGINT, monkeypatch)
+    runner.request_restart.assert_not_called()
+    assert len(stops) == 1
+
+
+def test_planned_stop_still_stops(monkeypatch):
+    monkeypatch.setattr(status, "consume_planned_stop_marker_for_self", lambda: True)
+    runner = _double(True)
+    stops, unexpected = _handle(runner, signal.SIGTERM, monkeypatch)
+    runner.request_restart.assert_not_called()
+    assert len(stops) == 1
+    assert unexpected is False
+
+
+@pytest.mark.asyncio
+async def test_sigterm_opens_the_restart_wait_while_a_turn_runs(monkeypatch):
+    runner, _adapter = make_restart_runner()
+    runner.config.sigterm_restart_wait = True
+    runner.session_runtime_descriptor = {}
+    runner._restart_task_started = False
+    runner._mark_api_runs_shutdown_requested = MagicMock()
+    runner._running_agents["agent:main:telegram:dm:1"] = MagicMock()
+    async def _turn_still_running():
+        await asyncio.sleep(3600)
+
+    runner._await_active_work_before_restart = _turn_still_running
+    runner.stop = AsyncMock()
+
+    run_mod._start_gateway_make_shutdown_signal_handler(runner, [False])(signal.SIGTERM)
+    await asyncio.sleep(0.05)
+    try:
+        assert runner._draining and runner._running
+        assert runner.session_runtime_descriptor["drain_reason"] == RESTART_WAIT_REASON
+        assert restart_wait_open(runner)
+        for method in ("approval.respond", "clarify.respond", "prompt.submit"):
+            assert not ws_method_refused_while_draining(runner, method)
+        runner.stop.assert_not_called()
+    finally:
+        runner._restart_task.cancel()
+        await asyncio.gather(runner._restart_task, return_exceptions=True)
+
+
+def test_sigterm_during_a_stop_under_way_is_not_turned_into_a_restart(monkeypatch):
+    runner = _double(True)
+    runner._stop_task = object()
+    stops, _ = _handle(runner, signal.SIGTERM, monkeypatch)
+    runner.request_restart.assert_not_called()
+    assert len(stops) == 1
+
+
+def test_listed_plugin_sockets_may_reconnect_during_the_restart_wait():
+    from gateway.drain_control import restart_wait_plugin_socket
+    runner = SimpleNamespace(config=GatewayConfig.from_dict({"gateway": {"restart_wait_plugin_sockets": ["device"]}}),
+                             _draining=True, _running=True,
+                             session_runtime_descriptor={"drain_reason": RESTART_WAIT_REASON})
+    assert runner.config.restart_wait_plugin_sockets == ["device"]
+    assert restart_wait_plugin_socket(runner, "websocket", "/api/plugins/device/ws")
+    assert not restart_wait_plugin_socket(runner, "websocket", "/api/plugins/other/ws")
+    assert not restart_wait_plugin_socket(runner, "http", "/api/plugins/device/ws")
+    assert not restart_wait_plugin_socket(runner, "websocket", "/api/ws")
+    runner._running = False
+    assert not restart_wait_plugin_socket(runner, "websocket", "/api/plugins/device/ws")
+    assert GatewayConfig().restart_wait_plugin_sockets == []
+
+
+def _finalizing_runner(restart, cap):
+    import threading
+    calls = []
+
+    async def cleanup(agent, *, context="", session_key=None, timeout=None):
+        calls.append((session_key, timeout))
+        await asyncio.sleep(min(timeout or 1.0, 1.0))
+
+    runner = SimpleNamespace(
+        _restart_requested=restart, _restart_detached=False,
+        config=GatewayConfig(restart_agent_cleanup_seconds=cap),
+        _agent_cache_lock=threading.Lock(), _agent_cache={"s1": (object(), 1), "s2": (object(), 2)},
+        _finalize_shutdown_agents=AsyncMock(), _cleanup_agent_resources_off_loop=cleanup,
+        adapters={}, _profile_adapters={})
+
+    async def housekeeping(fn, *args):
+        return await asyncio.to_thread(fn, *args)
+
+    runner._run_housekeeping_in_executor = housekeeping
+    runner._run_release_in_profile_scope = lambda target, args, session_key: target(*args)
+    return runner, calls
+
+
+@pytest.mark.asyncio
+async def test_restart_releases_idle_agents_together_within_the_cap():
+    import time
+    from gateway.run_shutdown import GatewayShutdownMixin
+    runner, calls = _finalizing_runner(True, 0.2)
+    ctx = SimpleNamespace(active_agents={}, elapsed=lambda: 0.0)
+    started = time.monotonic()
+    await GatewayShutdownMixin._stop_finalize_agents_and_adapters(runner, ctx)
+    assert time.monotonic() - started < 0.5
