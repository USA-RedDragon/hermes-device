+        """``gateway.restart_agent_cleanup_seconds`` on a restart stop, else None (upstream bounds)."""
+        if not getattr(runner, "_restart_requested", False):
+            return None
+        cap = getattr(getattr(runner, "config", None), "restart_agent_cleanup_seconds", 0) or 0
+        return float(cap) if cap > 0 else None
+
