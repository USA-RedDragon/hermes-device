new file mode 100644
index 00000000..25079861
--- /dev/null
+++ b/gateway/stall_watchdog.py
@@ -0,0 +1,309 @@
+"""``logging.stall_watchdog`` (default on): record what the gateway was doing when its asyncio loop stalled.
+
+A daemon thread asks the loop every second to set an event (``call_soon_threadsafe``). When the loop has
+not run the callback within ``logging.stall_watchdog_threshold_seconds`` (default 5), the thread writes one
+report to ``$HERMES_HOME/logs/stalls/stall-<UTC time>.txt``: a timestamp, the loop thread's stack and
+every other thread's stack (innermost frame first, file:line and function only), the coroutine chain of the
+task the loop is running, the number of live child processes (by command name) and the number of requests
+in flight per method. No local variables, arguments, message text or environment are read. When the loop
+recovers, the report gets one last line with the stall's length.
+
+At most one report per 60 s is written and the newest 50 are kept. SIGUSR2 also dumps all thread stacks
+(faulthandler) to ``stalls/sigusr2.txt``; that file is appended to and never pruned.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import faulthandler
+import logging
+import os
+import re
+import signal
+import sys
+import threading
+import time
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Iterator, Optional
+
+logger = logging.getLogger(__name__)
+
+DEFAULT_THRESHOLD_S = 5.0
+PING_INTERVAL_S = 1.0
+MIN_REPORT_GAP_S = 60.0
+KEEP_REPORTS = 50
+MAX_FRAMES = 60
+_POLL_S = 0.05
+_REPORT_RE = re.compile(r"^stall-\d{8}T\d{6}Z\.txt$")
+_NAME_RE = re.compile(r"[^A-Za-z0-9_.:-]")
+
+_inflight_lock = threading.Lock()
+_inflight: dict[str, int] = {}
+_sigusr2_file: Any = None
+
+
+@contextlib.contextmanager
+def track_request(method: str) -> Iterator[None]:
+    """Count a request while its handler runs, so a report says how many of each method were in flight."""
+    with _inflight_lock:
+        _inflight[method] = _inflight.get(method, 0) + 1
+    try:
+        yield
+    finally:
+        with _inflight_lock:
+            left = _inflight.get(method, 1) - 1
+            if left > 0:
+                _inflight[method] = left
+            else:
+                _inflight.pop(method, None)
+
+
+def inflight_counts() -> dict[str, int]:
+    with _inflight_lock:
+        return dict(_inflight)
+
+
+def stalls_dir(home: Optional[Path] = None) -> Path:
+    if home is None:
+        from hermes_constants import get_hermes_home
+        home = Path(get_hermes_home())
+    return Path(home) / "logs" / "stalls"
+
+
+def _where(frame: Any) -> str:
+    code = frame.f_code
+    return f"{code.co_filename}:{frame.f_lineno} {code.co_name}"
+
+
+def _stack_lines(frame: Any) -> list[str]:
+    lines: list[str] = []
+    while frame is not None and len(lines) < MAX_FRAMES:
+        lines.append("    " + _where(frame))
+        frame = frame.f_back
+    if frame is not None:
+        lines.append("    ...")
+    return lines
+
+
+def _coro_chain(coro: Any) -> list[str]:
+    out: list[str] = []
+    seen = 0
+    while coro is not None and seen < 32:
+        seen += 1
+        frame = getattr(coro, "cr_frame", None) or getattr(coro, "ag_frame", None) or getattr(coro, "gi_frame", None)
+        if frame is not None:
+            out.append("    " + _where(frame))
+        coro = getattr(coro, "cr_await", None) or getattr(coro, "ag_await", None) or getattr(coro, "gi_yieldfrom", None)
+    return out
+
+
+def _child_counts() -> Optional[dict[str, int]]:
+    """Live child processes of this process by command name (``/proc``; None where it is not there)."""
+    if not os.path.isdir("/proc/self"):
+        return None
+    me = os.getpid()
+    counts: dict[str, int] = {}
+    try:
+        names = os.listdir("/proc")
+    except OSError:
+        return None
+    for name in names:
+        if not name.isdigit():
+            continue
+        try:
+            with open(f"/proc/{name}/stat", "rb") as fh:
+                raw = fh.read().decode("utf-8", "replace")
+        except OSError:
+            continue
+        end = raw.rfind(")")
+        start = raw.find("(")
+        if end < 0 or start < 0:
+            continue
+        rest = raw[end + 2:].split()
+        if len(rest) < 2 or rest[1] != str(me):
+            continue
+        comm = _NAME_RE.sub("?", raw[start + 1:end])[:30]
+        counts[comm] = counts.get(comm, 0) + 1
+    return counts
+
+
+def build_report(loop: asyncio.AbstractEventLoop, loop_thread: Optional[int], stalled_s: float) -> str:
+    now = datetime.now(timezone.utc)
+    out = [
+        f"time_utc: {now.strftime('%Y-%m-%dT%H:%M:%S.%f')[:-3]}Z",
+        f"pid: {os.getpid()}",
+        f"stalled_at_least_s: {stalled_s:.1f}",
+    ]
+    children = _child_counts()
+    if children is None:
+        out.append("child_processes: unknown")
+    else:
+        detail = ", ".join(f"{k}={v}" for k, v in sorted(children.items()))
+        out.append(f"child_processes: {sum(children.values())}" + (f" ({detail})" if detail else ""))
+    counts = inflight_counts()
+    out.append(f"session_list_in_flight: {counts.get('session.list', 0)}")
+    out.append("requests_in_flight: " + (", ".join(f"{k}={v}" for k, v in sorted(counts.items())) or "none"))
+    task = None
+    with contextlib.suppress(Exception):
+        task = asyncio.current_task(loop)
+    if task is None:
+        out.append("loop_running_task: none (a plain callback, or the loop is in a call outside any task)")
+    else:
+        out.append("loop_running_task coroutine chain (outermost first):")
+        out.extend(_coro_chain(task.get_coro()) or ["    (not available)"])
+    names = {t.ident: t.name for t in threading.enumerate()}
+    frames = dict(sys._current_frames())
+    order = sorted(frames, key=lambda i: (i != loop_thread, i != threading.main_thread().ident, str(names.get(i))))
+    for ident in order:
+        if ident == threading.get_ident():
+            continue
+        label = _NAME_RE.sub("?", str(names.get(ident, "unnamed")))[:60]
+        role = "LOOP THREAD" if ident == loop_thread else "thread"
+        out.append("")
+        out.append(f"{role} {label} (innermost frame first):")
+        out.extend(_stack_lines(frames[ident]))
+    return "\n".join(out) + "\n"
+
+
+def _prune(directory: Path) -> None:
+    with contextlib.suppress(OSError):
+        files = sorted(p for p in directory.iterdir() if _REPORT_RE.match(p.name))
+        for old in files[:-KEEP_REPORTS]:
+            with contextlib.suppress(OSError):
+                old.unlink()
+
+
+class StallWatchdog:
+    def __init__(
+        self,
+        loop: asyncio.AbstractEventLoop,
+        directory: Path,
+        threshold_s: float = DEFAULT_THRESHOLD_S,
+        ping_interval_s: float = PING_INTERVAL_S,
+        min_gap_s: float = MIN_REPORT_GAP_S,
+    ) -> None:
+        self.loop = loop
+        self.directory = Path(directory)
+        self.threshold_s = threshold_s
+        self.ping_interval_s = ping_interval_s
+        self.min_gap_s = min_gap_s
+        self.loop_thread = threading.get_ident()
+        self.reports = 0
+        self._stop = threading.Event()
+        self._last_report: Optional[float] = None
+        self._thread = threading.Thread(target=self._run, name="stall-watchdog", daemon=True)
+
+    def start(self) -> "StallWatchdog":
+        self._thread.start()
+        return self
+
+    def stop(self) -> None:
+        self._stop.set()
+
+    def join(self, timeout: Optional[float] = None) -> None:
+        self._thread.join(timeout)
+
+    def is_alive(self) -> bool:
+        return self._thread.is_alive()
+
+    def _ping(self) -> Optional[threading.Event]:
+        serviced = threading.Event()
+        try:
+            self.loop.call_soon_threadsafe(serviced.set)
+        except RuntimeError:
+            return None
+        return serviced
+
+    def _wait(self, serviced: threading.Event, seconds: Optional[float]) -> bool:
+        deadline = None if seconds is None else time.monotonic() + seconds
+        while not self._stop.is_set():
+            if serviced.wait(_POLL_S):
+                return True
+            if deadline is not None and time.monotonic() >= deadline:
+                return False
+        return True
+
+    def _write(self, stalled_s: float) -> Optional[Path]:
+        now = time.monotonic()
+        if self._last_report is not None and now - self._last_report < self.min_gap_s:
+            return None
+        self._last_report = now
+        try:
+            self.directory.mkdir(parents=True, exist_ok=True)
+            stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
+            path = self.directory / f"stall-{stamp}.txt"
+            path.write_text(build_report(self.loop, self.loop_thread, stalled_s), encoding="utf-8")
+            self.reports += 1
+            _prune(self.directory)
+            return path
+        except Exception:
+            logger.debug("stall watchdog could not write a report", exc_info=True)
+            return None
+
+    def _run(self) -> None:
+        while not self._stop.wait(self.ping_interval_s):
+            serviced = self._ping()
+            if serviced is None:
+                return
+            sent = time.monotonic()
+            if self._wait(serviced, self.threshold_s):
+                continue
+            path = self._write(time.monotonic() - sent)
+            self._wait(serviced, None)
+            if path is not None and serviced.is_set():
+                with contextlib.suppress(Exception):
+                    with open(path, "a", encoding="utf-8") as fh:
+                        fh.write(f"\nloop_recovered_after_s: {time.monotonic() - sent:.1f}\n")
+
+
+def _register_sigusr2(directory: Path) -> None:
+    global _sigusr2_file
+    sig = getattr(signal, "SIGUSR2", None)
+    if sig is None or not hasattr(faulthandler, "register"):
+        return
+    try:
+        directory.mkdir(parents=True, exist_ok=True)
+        new = open(directory / "sigusr2.txt", "a", encoding="utf-8")  # windows-footgun: ok (append dump target)
+        faulthandler.register(sig, file=new, all_threads=True, chain=False)
+    except Exception:
+        logger.debug("stall watchdog could not register SIGUSR2", exc_info=True)
+        return
+    old, _sigusr2_file = _sigusr2_file, new
+    if old is not None:
+        with contextlib.suppress(Exception):
+            old.close()
+
+
+def _setting(name: str, default: Any) -> Any:
+    try:
+        from hermes_cli.config_effective import load_user_config_effective
+        from hermes_constants import get_config_path
+        cfg = load_user_config_effective(get_config_path()) or {}
+    except Exception:
+        return default
+    section = cfg.get("logging")
+    if isinstance(section, dict) and name in section:
+        return section[name]
+    return default
+
+
+def start(loop: asyncio.AbstractEventLoop, home: Optional[Path] = None) -> Optional[StallWatchdog]:
+    """Start the watchdog on the loop's thread unless ``logging.stall_watchdog`` is false."""
+    enabled = _setting("stall_watchdog", True)
+    if enabled in (False, 0, "false", "False", "off", "no"):
+        return None
+    try:
+        threshold = float(_setting("stall_watchdog_threshold_seconds", DEFAULT_THRESHOLD_S))
+    except (TypeError, ValueError):
+        threshold = DEFAULT_THRESHOLD_S
+    if threshold <= 0:
+        threshold = DEFAULT_THRESHOLD_S
+    try:
+        directory = stalls_dir(home)
+        _register_sigusr2(directory)
+        return StallWatchdog(loop, directory, threshold_s=threshold).start()
+    except Exception:
+        logger.debug("stall watchdog did not start", exc_info=True)
+        return None
