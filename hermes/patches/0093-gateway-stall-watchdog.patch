diff --git a/tests/gateway/test_stall_watchdog.py b/tests/gateway/test_stall_watchdog.py
new file mode 100644
index 00000000..f337a02d
--- /dev/null
+++ b/tests/gateway/test_stall_watchdog.py
@@ -0,0 +1,262 @@
+"""logging.stall_watchdog: a report of every thread's stack when the gateway loop stops answering."""
+
+import asyncio
+import os
+import signal
+import threading
+import time
+from pathlib import Path
+
+import pytest
+
+from gateway import stall_watchdog
+from gateway.stall_watchdog import StallWatchdog
+
+
+@pytest.fixture(autouse=True)
+def _home(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    yield
+
+
+def _reports(directory: Path) -> list[Path]:
+    return sorted(directory.glob("stall-*.txt")) if directory.exists() else []
+
+
+def _blocking_frame_for_test(seconds: float) -> None:
+    time.sleep(seconds)
+
+
+def _run(coro_fn):
+    return asyncio.run(coro_fn())
+
+
+def _loop_section(text: str) -> list[str]:
+    lines = text.splitlines()
+    start = next(i for i, ln in enumerate(lines) if ln.startswith("LOOP THREAD"))
+    body = []
+    for ln in lines[start + 1:]:
+        if not ln.startswith("    "):
+            break
+        body.append(ln.strip())
+    return body
+
+
+def test_defaults_are_on_with_five_seconds():
+    from hermes_cli.config_defaults import DEFAULT_CONFIG
+
+    assert DEFAULT_CONFIG["logging"]["stall_watchdog"] is True
+    assert DEFAULT_CONFIG["logging"]["stall_watchdog_threshold_seconds"] == 5
+    assert stall_watchdog.DEFAULT_THRESHOLD_S == 5.0
+
+
+def test_six_second_block_writes_one_report_with_the_blocking_frame_on_top(tmp_path):
+    directory = tmp_path / "logs" / "stalls"
+
+    async def main():
+        dog = stall_watchdog.start(asyncio.get_running_loop())
+        assert dog is not None
+        await asyncio.sleep(1.5)
+        _blocking_frame_for_test(6.0)
+        await asyncio.sleep(1.5)
+        dog.stop()
+        dog.join(2)
+
+    _run(main)
+    reports = _reports(directory)
+    assert len(reports) == 1
+    text = reports[0].read_text(encoding="utf-8")
+    top = _loop_section(text)[0]
+    assert "_blocking_frame_for_test" in top
+    assert "test_stall_watchdog.py" in top
+    assert "stalled_at_least_s:" in text
+    assert "child_processes:" in text
+    assert "session_list_in_flight: 0" in text
+    assert "loop_running_task coroutine chain" in text
+    assert "main" in text
+    assert "loop_recovered_after_s:" in text
+    assert directory == stall_watchdog.stalls_dir()
+
+
+def test_healthy_loop_writes_nothing(tmp_path):
+    directory = tmp_path / "stalls"
+
+    async def main():
+        dog = StallWatchdog(asyncio.get_running_loop(), directory, threshold_s=0.5, ping_interval_s=0.05).start()
+        for _ in range(20):
+            await asyncio.sleep(0.05)
+        dog.stop()
+        dog.join(2)
+
+    _run(main)
+    assert _reports(directory) == []
+
+
+def test_rate_limit_one_report_per_gap(tmp_path):
+    directory = tmp_path / "stalls"
+
+    async def main():
+        dog = StallWatchdog(
+            asyncio.get_running_loop(), directory, threshold_s=0.2, ping_interval_s=0.05, min_gap_s=60.0
+        ).start()
+        await asyncio.sleep(0.2)
+        for _ in range(3):
+            _blocking_frame_for_test(0.6)
+            await asyncio.sleep(0.3)
+        dog.stop()
+        dog.join(2)
+        return dog
+
+    dog = _run(main)
+    assert dog.reports == 1
+    assert len(_reports(directory)) == 1
+
+
+def test_a_second_report_is_written_once_the_gap_has_passed(tmp_path):
+    directory = tmp_path / "stalls"
+
+    async def main():
+        dog = StallWatchdog(
+            asyncio.get_running_loop(), directory, threshold_s=0.2, ping_interval_s=0.05, min_gap_s=0.0
+        ).start()
+        await asyncio.sleep(0.2)
+        _blocking_frame_for_test(0.6)
+        await asyncio.sleep(0.3)
+        time.sleep(1.1)
+        _blocking_frame_for_test(0.6)
+        await asyncio.sleep(0.3)
+        dog.stop()
+        dog.join(2)
+        return dog
+
+    dog = _run(main)
+    assert dog.reports == 2
+    assert len(_reports(directory)) == 2
+
+
+def test_only_the_newest_fifty_reports_are_kept(tmp_path):
+    directory = tmp_path / "stalls"
+    directory.mkdir()
+    for i in range(60):
+        (directory / f"stall-20260101T0000{i:02d}Z.txt").write_text("old")
+    (directory / "sigusr2.txt").write_text("keep")
+    stall_watchdog._prune(directory)
+    names = sorted(p.name for p in _reports(directory))
+    assert len(names) == stall_watchdog.KEEP_REPORTS == 50
+    assert names[0] == "stall-20260101T000010Z.txt"
+    assert (directory / "sigusr2.txt").exists()
+
+
+def test_report_has_stack_frames_only_no_locals_or_arguments(tmp_path):
+    secret = "sk-test-SECRET-VALUE-123"
+    ready = threading.Event()
+    release = threading.Event()
+
+    def worker(argument):
+        local_value = argument + "-local"
+        ready.set()
+        release.wait(5)
+        return local_value
+
+    t = threading.Thread(target=worker, args=(secret,), name="worker-under-test")
+    t.start()
+    ready.wait(2)
+    try:
+        async def main():
+            return stall_watchdog.build_report(asyncio.get_running_loop(), threading.get_ident(), 7.0)
+
+        text = _run(main)
+    finally:
+        release.set()
+        t.join(2)
+    assert "worker-under-test" in text
+    assert "worker" in text
+    assert secret not in text
+    assert "-local" not in text
+
+
+def test_in_flight_requests_are_counted_while_the_handler_runs():
+    seen = []
+    with stall_watchdog.track_request("session.list"):
+        with stall_watchdog.track_request("session.list"):
+            seen.append(stall_watchdog.inflight_counts().get("session.list"))
+        seen.append(stall_watchdog.inflight_counts().get("session.list"))
+    assert seen == [2, 1]
+    assert "session.list" not in stall_watchdog.inflight_counts()
+    with pytest.raises(RuntimeError):
+        with stall_watchdog.track_request("x.y"):
+            raise RuntimeError
+    assert "x.y" not in stall_watchdog.inflight_counts()
+
+
+def test_report_counts_session_list_in_flight():
+    async def main():
+        with stall_watchdog.track_request("session.list"):
+            return stall_watchdog.build_report(asyncio.get_running_loop(), threading.get_ident(), 6.0)
+
+    assert "session_list_in_flight: 1" in _run(main)
+
+
+def test_rpc_dispatch_tracks_the_method(monkeypatch):
+    from tui_gateway import server
+
+    seen = []
+
+    def handler(rid, params):
+        seen.append(stall_watchdog.inflight_counts().get("test.stallwd"))
+        return {"jsonrpc": "2.0", "id": rid, "result": {}}
+
+    monkeypatch.setitem(server._methods, "test.stallwd", handler)
+    server._handle_admitted_request({"id": "1", "method": "test.stallwd", "params": {}})
+    assert seen == [1]
