From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: USA-RedDragon <USA-RedDragon@users.noreply.github.com>
Date: Fri, 13 Nov 2026 17:05:00 -0600
Subject: [PATCH] fix(auxiliary): the auto chains try Nous Portal only when
 signed in

The text discovery chain and the vision auto order listed Nous Portal
unconditionally, so an install that never chose Nous logged five WARNINGs at
boot (the vision gate walks both) and tried the lane on every pass. A
missing-login error carrying its code nous_auth_missing also counted as a
credential that failed, so it logged at WARNING. Nous is now a lane only with a
Nous login, and a missing login is DEBUG unless login state is stored.
---
 agent/auxiliary_client.py                          | 19 ++++-
 agent/auxiliary_unavailable.py                     |  5 +-
 .../test_auxiliary_auto_never_guesses_provider.py  |  1 +
 tests/agent/test_auxiliary_client.py               |  2 +
 tests/agent/test_nous_not_signed_in_is_quiet.py    | 96 ++++++++++++++++++++++
 5 files changed, 121 insertions(+), 2 deletions(-)

diff --git a/agent/auxiliary_client.py b/agent/auxiliary_client.py
index 98bf6257..43e62e13 100644
--- a/agent/auxiliary_client.py
+++ b/agent/auxiliary_client.py
@@ -3131,15 +3131,28 @@ def _normalize_main_runtime(main_runtime: Optional[dict[str, Any]]) -> dict[str,
     return normalized
 
 
+def _nous_signed_in() -> bool:
+    """True when Hermes holds any Nous Portal login (pool entry or stored auth state). The auto chains
+    only try Nous then: an install that never chose Nous would fail the lane on every pass, and log it."""
+    if _read_nous_auth():
+        return True
+    with contextlib.suppress(Exception):
+        from hermes_cli.auth import get_provider_auth_state
+        return bool(get_provider_auth_state("nous"))
+    return False
+
+
 def _get_provider_chain() -> list[tuple]:
     """Ordered provider detection chain, built at call time so ``_try_*`` patches are picked up.
 
     ``openai-codex`` is deliberately absent (shifting allow-list breaks guessed-model fallback).
+    Nous is in it only for an install that signed in to Nous Portal.
     """
-    return [
+    chain = [
         ("openrouter", _try_openrouter), ("nous", _try_nous),
         ("local/custom", _try_custom_endpoint), ("api-key", _resolve_api_key_provider),
     ]
+    return chain if _nous_signed_in() else [step for step in chain if step[0] != "nous"]
 
 
 # "Recently 402'd" unhealthy-provider cache: a depleted provider stays so for hours, so hiding it
@@ -5420,6 +5433,8 @@ def get_available_vision_backends() -> list[str]:
         if main_ok:
             available.append(main_provider)
     for p in _VISION_AUTO_PROVIDER_ORDER:  # skip if already covered by main provider
+        if p == "nous" and not _nous_signed_in():
+            continue
         if p not in available and _resolve_strict_vision_backend(p)[0] is not None:
             available.append(p)
     return available
@@ -5509,6 +5524,8 @@ def _vision_auto_route(
     for candidate in _VISION_AUTO_PROVIDER_ORDER:
         if candidate == main_provider:
             continue  # already tried above
+        if candidate == "nous" and not _nous_signed_in():
+            continue
         sync_client, default_model = _resolve_strict_vision_backend(candidate)
         if sync_client is not None:
             return _finalize_vision_client(candidate, sync_client, default_model, resolved_model, async_mode)
