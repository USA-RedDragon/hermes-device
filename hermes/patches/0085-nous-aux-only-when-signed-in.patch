diff --git a/tests/agent/test_nous_not_signed_in_is_quiet.py b/tests/agent/test_nous_not_signed_in_is_quiet.py
new file mode 100644
index 00000000..44a815ce
--- /dev/null
+++ b/tests/agent/test_nous_not_signed_in_is_quiet.py
@@ -0,0 +1,96 @@
+"""An install that never signed in to Nous Portal does not try, or warn about, Nous in the auto chains.
+
+The text discovery chain and the vision auto order listed Nous unconditionally, so a fresh install with no main
+model logged five WARNINGs at boot (the vision gate walks both). The resolver's own error carries the code
+``nous_auth_missing``, which ``_nous_credential_present`` read as "a credential exists that failed".
+"""
+import logging
+
+import pytest
+
+import agent.auxiliary_client as aux
+import agent.auxiliary_unavailable as unavailable
+from hermes_cli.auth_constants import AuthError
+
+
+@pytest.fixture(autouse=True)
+def _no_nous(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(unavailable, "_last_nous_detail", None)
+    monkeypatch.setattr(unavailable, "_warned_nous_details", set())
+    monkeypatch.setattr(aux, "_read_nous_auth", lambda: None)
+    monkeypatch.setattr("hermes_cli.auth.get_provider_auth_state", lambda provider: None)
+
+
+def _labels():
+    return [label for label, _ in aux._get_provider_chain()]
+
+
+def test_chain_skips_nous_without_a_login():
+    assert _labels() == ["openrouter", "local/custom", "api-key"]
+
+
+def test_chain_keeps_nous_with_a_login(monkeypatch):
+    monkeypatch.setattr(aux, "_read_nous_auth", lambda: {"access_token": "t"})
+    assert _labels() == ["openrouter", "nous", "local/custom", "api-key"]
+
+
+def test_chain_keeps_nous_with_stored_state_only(monkeypatch):
+    monkeypatch.setattr("hermes_cli.auth.get_provider_auth_state", lambda provider: {"refresh_token": "r"})
+    assert "nous" in _labels()
+
+
+def test_discovery_never_calls_nous_without_a_login(monkeypatch, caplog):
+    def boom(*a, **k):
+        raise AssertionError("Nous was tried")
+
+    monkeypatch.setattr(aux, "_try_nous", boom)
+    monkeypatch.setattr(aux, "_try_openrouter", lambda *a, **k: (None, None))
+    monkeypatch.setattr(aux, "_try_custom_endpoint", lambda *a, **k: (None, None))
+    monkeypatch.setattr(aux, "_resolve_api_key_provider", lambda *a, **k: (None, None))
+    with caplog.at_level(logging.DEBUG):
+        assert aux._try_discovery_chain() == (None, None, "")
+    assert not [r for r in caplog.records if "nous" in r.getMessage().lower()]
+
+
+def test_vision_order_skips_nous_without_a_login(monkeypatch):
+    tried = []
+    monkeypatch.setattr(aux, "_read_main_provider", lambda: "")
+    monkeypatch.setattr(aux, "_resolve_strict_vision_backend", lambda p, model=None: (tried.append(p), (None, None))[1])
+    assert aux.get_available_vision_backends() == []
+    assert tried == ["openrouter", "deepinfra"]
+    assert aux._vision_auto_route({"provider": "", "model": ""}, None, None, False) == (None, None, None)
+    assert tried == ["openrouter", "deepinfra"] * 2
+
+
+def test_vision_order_tries_nous_with_a_login(monkeypatch):
+    monkeypatch.setattr(aux, "_read_nous_auth", lambda: {"access_token": "t"})
+    tried = []
+    monkeypatch.setattr(aux, "_read_main_provider", lambda: "")
+    monkeypatch.setattr(aux, "_resolve_strict_vision_backend", lambda p, model=None: (tried.append(p), (None, None))[1])
+    aux.get_available_vision_backends()
+    assert tried == ["openrouter", "nous", "deepinfra"]
+
+
+def test_missing_login_error_with_its_code_is_debug(caplog):
+    gone = AuthError("Hermes is not logged into Nous Portal.", provider="nous", code="nous_auth_missing",
+                     relogin_required=True)
+    with caplog.at_level(logging.DEBUG, logger="agent.auxiliary_unavailable"):
+        unavailable.record_nous_credential_failure(gone)
+    assert {r.levelno for r in caplog.records} == {logging.DEBUG}
+
+
+def test_dead_credential_still_warns(caplog):
+    dead = AuthError("Invalid refresh token", provider="nous", code="invalid_grant", relogin_required=True)
+    with caplog.at_level(logging.DEBUG, logger="agent.auxiliary_unavailable"):
+        unavailable.record_nous_credential_failure(dead)
+    assert {r.levelno for r in caplog.records} == {logging.WARNING}
+
+
+def test_missing_login_code_warns_when_state_is_stored(caplog, monkeypatch):
+    monkeypatch.setattr("hermes_cli.auth.get_provider_auth_state", lambda provider: {"refresh_token": "r"})
+    gone = AuthError("No access token found for Nous Portal login.", provider="nous",
+                     code="nous_auth_missing_access_token", relogin_required=True)
+    with caplog.at_level(logging.DEBUG, logger="agent.auxiliary_unavailable"):
+        unavailable.record_nous_credential_failure(gone)
+    assert {r.levelno for r in caplog.records} == {logging.WARNING}
