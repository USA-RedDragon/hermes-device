+def _stamp(ts: Any) -> str:
+    """``[YYYY-MM-DD HH:MM] `` (local time) for a message time, or nothing when it has none."""
+    if not isinstance(ts, (int, float)) or ts <= 0:
+        return ""
+    try:
+        return time.strftime("[%Y-%m-%d %H:%M] ", time.localtime(float(ts)))
+    except Exception:
+        return ""
