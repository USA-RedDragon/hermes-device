+        return 0
+    for ev in new:
+        logger.info("Smart approval: chat %s %s %s (%s)", tip, ev["kind"], ev.get("source") or "all", ev.get("via"))
+    return len(new)
+
+
+def record_card_grant(db, session_id: str, clone_url: str) -> dict | None:
+    """The approval card choice "Always allow code from this source in this chat"."""
+    src = source_identity(clone_url)
+    if not src or db is None or not session_id:
+        return None
+    now = time.time()
+    ev = {"kind": "grant", "source": src, "at": now, "via": "card",
+          "words": f"Always allow code from {clone_url} in this chat (approval card choice)",
+          "key": _key("card", src, now)}
+    return ev if record_events(db, session_id, [ev]) else None
