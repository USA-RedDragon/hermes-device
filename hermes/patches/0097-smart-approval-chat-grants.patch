+"""Chat-scoped grants for smart approval (provenance review).
+
+A user who writes in a chat that agents may run code from a named source ("agents and subagents may run
+code in clones of github.com/owner/repo", "approved to run code from owner/repo") has consented, for that
+chat and every subagent under it, to later commands that run code from a clone of exactly that source. So
+has a user who picks "Always allow code from this source in this chat" on an approval card.
+
+Grants live in the session store with the chat (``state_meta`` key ``approval_grants:<session id>``), never
+in config.yaml. Only two things make one: a user-authored message of the chat or its root chat (read through
+``user_authored_text``, so subagent results, peer-agent messages, tool output and runtime notes never count),
+and the card choice. A later user message that withdraws it ("no longer approved to run code from X",
+"I revoke the approval to run code") ends it. A grant names one repository: its identity is the host and the
+``owner/repo`` path, so a different repo, a fork name or a look-alike host is not covered.
+
+Grant wording the parser below does not recognize ("you can run its tests") still reaches the review model
+as the user's own words; the parser only adds what must not depend on the model or on the transcript still
+holding the message (compaction): the clone is not held as external code, and the grant's words stay in the
+review.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+import re
+import time
+from typing import Any, Iterable
+
+logger = logging.getLogger(__name__)
+
+META_PREFIX = "approval_grants:"
+_MAX_EVENTS = 200
+
+# A repository reference: a URL (https://, ssh://, git://), scp-style git@host:owner/repo, host/owner/repo
+# with a dotted host, or a bare owner/repo (GitHub).
+_REF_RE = re.compile(
+    r"(?:(?:https?|ssh|git)://(?:[\w.-]+@)?(?P<h1>[\w.-]+\.[a-z]{2,})(?::\d+)?/(?P<p1>[\w.-]+/[\w.-]+))"
+    r"|(?:[\w.-]+@(?P<h2>[\w.-]+\.[a-z]{2,}):/?(?P<p2>[\w.-]+/[\w.-]+))"
+    r"|(?:(?<![\w./@:-])(?P<h3>[\w-]+(?:\.[\w-]+)*\.[a-z]{2,})/(?P<p3>[\w.-]+/[\w.-]+))"
+    r"|(?:(?<![\w./@:~-])(?P<p4>[A-Za-z0-9][\w.-]*/[A-Za-z0-9][\w.-]*)(?![\w/]))",
+    re.I)
+
+_RUN = re.compile(r"\b(run|runs|running|execute|executing|exec|test|tests|testing|build|building|install|"
+                  r"installing|import|importing)\b", re.I)
+_PERMIT = re.compile(r"\b(approved|approval|allowed|allow|permitted|permission|authori[sz]ed|ok|okay|fine|"
+                     r"free to|go ahead|consent|granted)\b"
+                     r"|\b(you|agents?|subagents?|they|it)\s+(can|may)\b", re.I)
+_NEGATION = re.compile(r"(\b(not|never|don't|dont|cannot|can't|cant|mustn't|shouldn't|won't|stop|"
+                       r"revoke[ds]?|revoking|withdraw[ns]?|withdrew|rescind(?:ed)?|disallow(?:ed)?|"
+                       r"forbid(?:den)?|anymore|longer)\b|\bno\s+(code|running|tests?|more)\b)", re.I)
+# Wording that limits or excludes: such a sentence neither grants nor withdraws (the review model reads it).
+_LIMIT = re.compile(r"\b(except|unless|other than|besides|without|but not|only if|if)\b", re.I)
+_WITHDRAW = re.compile(r"\b(revoke[ds]?|revoking|withdraw[ns]?|withdrew|rescind(?:ed)?|take back|no longer|"
+                       r"not allowed anymore|not approved anymore|disallow(?:ed)?|forbid(?:den)?)\b", re.I)
+_SENTENCE = re.compile(r"(?<=[.!?;])\s+|\n+")
+
+
+def source_identity(ref: str) -> str | None:
+    """``host/owner/repo`` (lowercase, no ``.git``) for a clone URL or a reference in text, or ``None``.
+
+    ``owner/repo`` alone is GitHub. ``..`` segments, whitespace and backslashes give ``None``."""
+    if not isinstance(ref, str):
+        return None
+    ref = ref.strip().rstrip("/").rstrip(".,;:)!?\"'")
+    if not ref or any(c.isspace() for c in ref) or "\\" in ref:
+        return None
+    m = _REF_RE.fullmatch(ref)
+    if m is None:
+        return None
+    host = m.group("h1") or m.group("h2") or m.group("h3") or "github.com"
+    path = m.group("p1") or m.group("p2") or m.group("p3") or m.group("p4")
+    owner, repo = path.split("/", 1)
+    repo = repo[:-4] if repo.lower().endswith(".git") else repo
+    if not owner or not repo or ".." in (owner, repo) or owner.startswith(".") or repo.startswith("."):
+        return None
+    host = host.lower().removeprefix("www.")
+    return f"{host}/{owner.lower()}/{repo.lower()}"
+
+
+def sources_in(text: str) -> list[str]:
+    """Repository identities a piece of user text names, in order."""
+    found: list[str] = []
+    for m in _REF_RE.finditer(text or ""):
+        ident = source_identity(m.group(0))
+        if ident and ident not in found:
+            found.append(ident)
+    return found
+
+
+def _sentences(text: str) -> list[str]:
+    return [s for s in _SENTENCE.split(text or "") if s.strip()]
+
+
+def events_of_text(text: str) -> list[tuple[str, str | None]]:
+    """``(kind, source)`` events one user message makes: ``("grant", src)`` or ``("withdraw", src|None)``
+    (``None`` withdraws every grant of the chat). A question grants nothing."""
+    out: list[tuple[str, str | None]] = []
+    for sentence in _sentences(text):
+        srcs = sources_in(sentence)
+        negated = bool(_NEGATION.search(sentence))
+        if srcs:
+            if negated:
+                if _RUN.search(sentence) or _PERMIT.search(sentence):
+                    out.extend(("withdraw", s) for s in srcs)
+                continue
+            if sentence.rstrip().endswith("?") or _LIMIT.search(sentence):
+                continue
+            if _RUN.search(sentence) and _PERMIT.search(sentence):
+                out.extend(("grant", s) for s in srcs)
+        elif _WITHDRAW.search(sentence) and re.search(r"\b(approv|grant|permission|allow|run|code)", sentence, re.I):
+            out.append(("withdraw", None))
+    return out
+
+
+def _key(*parts: Any) -> str:
+    return hashlib.sha256(json.dumps(parts, default=str).encode()).hexdigest()[:16]
+
+
+def message_events(rows: Iterable[tuple[float | None, str]]) -> list[dict]:
+    """Events from user-authored texts ``(timestamp, text)`` in chat order. A row without a time takes the
+    time of the row before it, so order holds."""
+    out: list[dict] = []
+    last = 0.0
+    for ts, text in rows:
+        ts = float(ts) if isinstance(ts, (int, float)) and ts > 0 else last
+        last = ts
+        for kind, src in events_of_text(text):
+            out.append({"kind": kind, "source": src, "at": ts, "via": "message",
+                        "words": text[:600], "key": _key(kind, src, ts, text)})
+    return out
+
+
+def active_grants(events: Iterable[dict]) -> dict[str, dict]:
+    """``source -> the grant event`` still in force after the events in time order."""
+    state: dict[str, dict] = {}
+    for ev in sorted(events, key=lambda e: (e.get("at") or 0.0, e.get("seq", 0))):
+        src = ev.get("source")
+        if ev.get("kind") == "grant" and src:
+            state[src] = ev
+        elif ev.get("kind") == "withdraw":
+            if src is None:
+                state.clear()
+            else:
+                state.pop(src, None)
+    return state
+
+
+# --- store ------------------------------------------------------------------------------------------------
+
+def _lineage(db, session_id: str) -> list[str]:
+    ids: list[str] = []
+    try:
+        tip = db.get_compression_tip(session_id) if hasattr(db, "get_compression_tip") else session_id
+    except Exception:
+        tip = session_id
+    tip = tip or session_id
+    try:
