     return content
 
 
+# Section kinds for the cap, by heading text. Checked in this order: the first match wins.
+_CAP_KINDS = (
+    ("ai", ("ai self", "ai identity", "ai representation", "ai card")),
+    ("card", ("peer card",)),
+    ("summary", ("summary",)),
+    ("answer", ("dialectic", "answer")),
+    ("observations", ("observation", "representation", "conclusion")),
+)
+_HEADING_RE = re.compile(r"^#{1,4} \S")
+_OBSERVATION_RE = re.compile(r"^\[\d{4}-\d\d-\d\d[ T]\d\d:\d\d(?::\d\d)?[^\]]*\] ")
+_SENTENCE_END_RE = re.compile(r"[.!?][\"')\]]*(?=\s)|\n")
+
+
+def _cap_sections(text: str) -> list[tuple[str, list[str], str]]:
+    """*text* as ``(kind, heading lines, body)`` sections. A heading with no body of its own joins the next
+    section, so "## User Representation" over "## Explicit Observations" is one section."""
+    sections: list[tuple[list[str], list[str]]] = [([], [])]
+    for line in text.split("\n"):
+        if _HEADING_RE.match(line):
+            headings, body = sections[-1]
+            if headings and not "\n".join(body).strip():
+                headings.append(line)
+                body.clear()
+            else:
+                sections.append(([line], []))
+        else:
+            sections[-1][1].append(line)
+    out = []
+    for headings, body in sections:
+        if not headings and not "\n".join(body).strip():
+            continue
+        title = " ".join(headings).lower()
+        kind = "preamble" if not headings else next(
+            (k for k, words in _CAP_KINDS if any(w in title for w in words)), "other")
+        out.append((kind, headings, "\n".join(body).strip("\n")))
+    return out
+
+
+def _trim_text(text: str, limit: int) -> str:
+    """*text* cut to at most *limit* chars at a paragraph boundary, else at the end of a sentence or line;
+    ``""`` when not even one sentence fits. Never cuts inside a sentence."""
+    if len(text) <= limit:
+        return text
+    kept: list[str] = []
+    size = 0
+    for para in text.split("\n\n"):
+        extra = len(para) + (2 if kept else 0)
+        if size + extra > limit:
+            if not kept:
+                room = text[:limit]
+                ends = [m.end() for m in _SENTENCE_END_RE.finditer(room)]
+                return room[: ends[-1]].rstrip() if ends else ""
+            break
+        kept.append(para)
+        size += extra
+    return "\n\n".join(kept)
+
+
+def _observation_entries(body: str) -> list[str]:
+    """A section body as entries: a timestamped line with the lines that continue it; other lines alone."""
+    entries: list[str] = []
+    for line in body.split("\n"):
+        if entries and line.strip() and not _OBSERVATION_RE.match(line) and (
+                line[0].isspace() or _OBSERVATION_RE.match(entries[-1])):
+            entries[-1] += "\n" + line
+        elif line.strip():
+            entries.append(line)
+    return entries
+
+
 def cap_recalled_memory(text: str, max_chars: int) -> str:
-    """Recall text cut to about *max_chars* (0 = no cap) at line boundaries, with a note where the cut is.
-    Keeps the first quarter and the last three quarters: providers open with headings and often end with
-    their newest entries and a profile card (Honcho lists observations oldest first, then the peer card)."""
+    """Recall text cut to about *max_chars* (0 = no cap) section by section, with a note on what was cut.
+
+    The peer card, the session summary, the provider's answer to this turn's question and any text before
+    the first heading are kept whole (cut at paragraph or sentence ends only when they alone exceed the
+    budget). Observations fill what is left, newest first, and keep their original order. Unknown sections
+    come next, and the AI's own self-description sections go first. Nothing is cut inside a sentence."""
     if not max_chars or max_chars <= 0 or not isinstance(text, str) or len(text) <= max_chars:
         return text
-    head, tail = text[: max_chars // 4], text[len(text) - (max_chars - max_chars // 4):]
-    if "\n" in head:
-        head = head[: head.rfind("\n")]
-    if "\n" in tail:
-        tail = tail[tail.find("\n") + 1:]
-    cut = len(text) - len(head) - len(tail)
-    return f"{head.rstrip()}\n[... {cut:,} of {len(text):,} chars of recalled memory cut by memory.recall_max_chars ...]\n{tail}"
+    sections = _cap_sections(text)
+    kept: dict[int, str] = {}
+    budget = max_chars
+
+    def _cost(index: int, body: str) -> int:
+        return len("\n".join(sections[index][1])) + len(body) + 3
+
+    for kinds in (("preamble", "card"), ("summary",), ("answer",)):
+        for index, (kind, _, body) in enumerate(sections):
+            if kind not in kinds:
+                continue
+            body = _trim_text(body, max(0, budget - _cost(index, "")))
+            if body:
+                kept[index] = body
+                budget -= _cost(index, body)
+    observed = [(index, n, entry) for index, (kind, _, body) in enumerate(sections) if kind == "observations"
+                for n, entry in enumerate(_observation_entries(body))]
+    # Newest first: timestamped entries by their stamp, the rest by position (Honcho lists oldest first).
+    observed.sort(key=lambda item: (bool(_OBSERVATION_RE.match(item[2])), item[2][:21] if
+                                    _OBSERVATION_RE.match(item[2]) else "", item[0], item[1]), reverse=True)
+    chosen: dict[int, list[tuple[int, str]]] = {}
+    for index, n, entry in observed:
+        extra = len(entry) + 1 + (0 if index in chosen else _cost(index, ""))
+        if extra <= budget:
+            chosen.setdefault(index, []).append((n, entry))
+            budget -= extra
+    for index, entries in chosen.items():
+        kept[index] = "\n".join(entry for _, entry in sorted(entries))
+    for kinds in (("other",), ("ai",)):
+        for index, (kind, _, body) in enumerate(sections):
+            if kind in kinds and _cost(index, body) <= budget:
+                kept[index] = body
+                budget -= _cost(index, body)
+    parts = []
+    for index, (kind, headings, body) in enumerate(sections):
+        if index in kept:
+            parts.append("\n".join([*headings, kept[index]]) if headings else kept[index])
+    out = "\n\n".join(parts)
+    dropped = [" / ".join(h.lstrip("# ") for h in headings) for index, (_, headings, _) in enumerate(sections)
+               if index not in kept and headings]
+    older = len(observed) - sum(len(entries) for entries in chosen.values())
+    if older:
+        dropped.append(f"{older} older observation(s)")
+    note = f"[recalled memory trimmed to {len(out):,} of {len(text):,} chars by memory.recall_max_chars"
+    note += f"; left out: {'; '.join(dropped)}]" if dropped else "]"
+    return f"{out}\n\n{note}" if out else note
+
+
+def recall_cut_index(messages: list[Any], now: Any, cold_after: float) -> int:
+    """Index of the first message whose recalled memory replays as sent; rows before it are replayed without
+    their ``<memory-context>`` blocks.
+
+    Stripping an old block rewrites the request prefix from that row on, so it is done only when the
+    prompt cache is already cold: at the last idle gap longer than *cold_after* seconds before a user row,
+    or before ``now`` (this turn starts cold, so every earlier block goes). A gap inside a turn (a long tool
+    call) is not a cut: the turn's later requests cached its rows with their recall. Every later warm turn
+    finds the same cut, so the bytes sent before it stay the same. Rows without a timestamp are skipped;
+    *cold_after* <= 0 strips every earlier block (each turn rewrites the previous one)."""
+    if cold_after <= 0:
+        return len(messages)
+    cut = 0
+    previous = None
+    stamps = [(i, m.get("timestamp")) for i, m in enumerate(messages) if isinstance(m, dict)]
+    for index, stamp in stamps + [(len(messages), now)]:
+        if not isinstance(stamp, (int, float)):
+            continue
+        is_turn_start = index == len(messages) or messages[index].get("role") == "user"
+        if previous is not None and is_turn_start and stamp - previous > cold_after:
+            cut = index
+        previous = stamp
+    return cut
 
 
 def recall_history_kept(agent: Any) -> bool:
     """Whether recalled memory stays in history (``memory.recall_history``, default true)."""
     return getattr(agent, "_memory_recall_history", True) is not False
+
+
+def recall_cold_after(agent: Any) -> float:
+    """Idle seconds after which the prompt cache counts as cold (``memory.recall_cold_after_seconds``)."""
+    value = getattr(agent, "_memory_recall_cold_after", 3600)
+    return float(value) if isinstance(value, (int, float)) else 3600.0
