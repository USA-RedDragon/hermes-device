new file mode 100644
index 00000000..7c09b5f2
--- /dev/null
+++ b/tests/agent/test_recall_turn_gate.py
@@ -0,0 +1,145 @@
+"""Recalled memory: no recall on turns no person wrote, a section-aware cap, the fence label, compaction."""
+
+from __future__ import annotations
+
+from unittest.mock import MagicMock
+
+from agent.context_compressor import ContextCompressor
+from agent.conversation_compression_scaffolding import user_authored_text_of
+from agent.memory_context import (
+    build_memory_context_block, cap_recalled_memory, recall_cut_index, sanitize_context,
+)
+from tests.agent.test_api_content_sidecar import (  # noqa: F401  (wire_env is a fixture)
+    _chat_requests,
+    _user_messages,
+    wire_env,
+)
+from tests.agent.test_memory_recall_scope import RECALL, _with_recall
+
+NOTICES = (
+    "[ASYNC DELEGATION BATCH COMPLETE (2 tasks)]\nA subagent you started has finished: it released v1.2.",
+    "[Agent message am_0123456789abcdef from build]\nAnother AI agent of this user wrote everything below this line.\n\n"
+    "I pushed the tag.",
+    "[Background process proc_1 heartbeat #2 — still running after 2m]\nCommand: make",
+    "[Hermes restarted while your previous turn was running. The turn was stopped.]",
+)
+
+
+def test_notices_are_not_user_authored_and_a_real_message_is():
+    for notice in NOTICES:
+        assert user_authored_text_of(notice) is None, notice[:30]
+    assert user_authored_text_of("please ship the release") == "please ship the release"
+
+
+def test_internal_notice_gets_no_recall_and_queues_no_refresh(wire_env):
+    make_agent, handler, db, sid = wire_env
+    for i, notice in enumerate(NOTICES):
+        handler.captured_requests = []
+        agent = _with_recall(make_agent(), keep=False)
+        agent.run_conversation(notice, conversation_history=[], task_id=f"n{i}")
+        sent = _user_messages(_chat_requests(handler)[0])[-1]["content"]
+        assert "<memory-context>" not in sent, notice[:30]
+        agent._memory_manager.prefetch_all.assert_not_called()
+        agent._memory_manager.queue_prefetch_all.assert_not_called()
+        # Providers still count the turn, but get no query from it.
+        assert agent._memory_manager.on_turn_start.call_args.args[1] == ""
+
+
+def test_user_message_recalls_on_its_own_words(wire_env):
+    make_agent, handler, db, sid = wire_env
+    agent = _with_recall(make_agent(), keep=False)
+    agent.run_conversation("please ship the release", conversation_history=[], task_id="u1")
+    assert "<memory-context>" in _user_messages(_chat_requests(handler)[0])[-1]["content"]
+    assert agent._memory_manager.prefetch_all.call_args.args[0] == "please ship the release"
+    assert agent._memory_manager.queue_prefetch_all.call_args.args[0] == "please ship the release"
+
+
+HONCHO = (
+    "## Session Summary\nThe user is moving the cluster to new nodes. The drain of node a finished.\n\n"
+    "Next they want the storage class checked.\n\n"
+    "## User Representation\n## Explicit Observations\n\n"
+    + "".join(f"[2026-11-{d:02d} 10:00:00] observation from day {d} about the user\n" for d in range(1, 29))
+    + "\n## User Peer Card\nName: Sam\nPrefers short answers\n\n"
+    "## AI Self-Representation\n## Explicit Observations\n\n"
+    + "".join(f"[2026-11-{d:02d} 11:00:00] the assistant described itself on day {d}\n" for d in range(1, 15))
+    + "\n## AI Identity Card\nI am the assistant.\n\n"
+    "## Dialectic Answer\nThe user cares about the storage class next. They asked about it twice.\n"
+)
+
+
+def test_cap_keeps_card_summary_and_answer_whole_and_newest_observations():
+    capped = cap_recalled_memory(HONCHO, 1300)
+    assert len(capped) <= 1300 + 200
+    for whole in ("## Session Summary\nThe user is moving the cluster to new nodes. The drain of node a finished.\n\n"
+                  "Next they want the storage class checked.",
+                  "## User Peer Card\nName: Sam\nPrefers short answers",
+                  "## Dialectic Answer\nThe user cares about the storage class next. They asked about it twice."):
+        assert whole in capped
+    body, note = capped.rsplit("\n\n", 1)
+    assert "AI Self-Representation" not in body and "described itself" not in body
+    assert note.startswith("[recalled memory trimmed to") and "AI Self-Representation" in note
+    assert "day 28 about the user" in capped and "day 1 about the user" not in capped
+    observations = [line for line in capped.splitlines() if "about the user" in line]
+    assert observations == sorted(observations)  # original (oldest first) order is kept
+    # Section order is the provider's.
+    assert capped.index("Session Summary") < capped.index("Explicit Observations") < capped.index("Peer Card")
+
+
+def test_cap_trims_an_oversized_summary_at_a_paragraph_never_mid_sentence():
+    summary = "## Session Summary\n" + "\n\n".join(f"Paragraph {i} has one full sentence in it." for i in range(60))
+    capped = cap_recalled_memory(summary + "\n\n## User Peer Card\nName: Sam\n", 600)
+    assert "## User Peer Card\nName: Sam" in capped
+    body = capped.split("## Session Summary\n", 1)[1].split("\n\n## User Peer Card", 1)[0]
+    assert body and all(p.endswith("in it.") for p in body.split("\n\n"))
+    one = "## Session Summary\n" + " ".join(f"Sentence {i} ends here." for i in range(80))
+    capped = cap_recalled_memory(one, 300)
+    assert capped.split("\n\n[recalled memory")[0].endswith("ends here.")
+
+
+def test_label_says_recall_may_be_stale_and_is_still_scrubbed():
+    block = build_memory_context_block("## User Peer Card\nName: Sam")
+    assert "authoritative" not in block
+    assert "may be stale" in block and "other chats" in block and "Prefer the current conversation" in block
+    assert sanitize_context("before " + block.split("\n", 1)[1].rsplit("\n", 1)[0] + " after").startswith("before ")
+    assert "System note" not in sanitize_context(block.split("\n", 1)[1])
+
+
+def test_cut_index_moves_only_at_cold_gaps_before_user_rows():
+    rows = [{"role": "user", "timestamp": 0}, {"role": "assistant", "timestamp": 10},
+            {"role": "tool", "timestamp": 5000}, {"role": "user", "timestamp": 5100},
+            {"role": "assistant", "timestamp": 5110}]
+    # The 4990 s gap before the tool row is inside a turn: no cut there.
+    assert recall_cut_index(rows, 5200, 3600) == 0
+    rows[3]["timestamp"], rows[4]["timestamp"] = 9000, 9010
+    assert recall_cut_index(rows, 9100, 3600) == 3
+    assert recall_cut_index(rows, 20000, 3600) == len(rows)
+    assert recall_cut_index(rows, 9100, 0) == len(rows)
+
+
+def test_compaction_drops_recall_from_kept_rows_but_the_newest_user_row():
+    compressor = ContextCompressor(model="test/model", quiet_mode=True, config_context_length=64_000)
+    compressor.strip_recalled_memory = True
+    block = build_memory_context_block(RECALL)
+    rows = [{"role": "user", "content": "old", "api_content": "old\n\n" + block},
+            {"role": "assistant", "content": "ok"},
+            {"role": "user", "content": "new", "api_content": "new\n\n" + block}]
+    out = compressor._finalize_compressed([dict(r) for r in rows], rows, len(rows), False)
+    users = [m for m in out if m.get("role") == "user"]
+    assert users[0]["api_content"] == "old" and users[-1]["api_content"] == "new\n\n" + block
+    compressor.strip_recalled_memory = False
+    out = compressor._finalize_compressed([dict(r) for r in rows], rows, len(rows), False)
+    assert [m for m in out if m.get("role") == "user"][0]["api_content"] == "old\n\n" + block
+
+
+def test_cold_gap_setting_reaches_the_agent():
+    from unittest.mock import patch
+
+    from agent.agent_init import _init_memory
+
+    agent = MagicMock()
+    with patch("agent.safe_worker_policy.safe_worker_enabled", return_value=True):
+        _init_memory(agent, {"memory": {"recall_cold_after_seconds": "300"}}, True, "cli")
+    assert agent._memory_recall_cold_after == 300
+    with patch("agent.safe_worker_policy.safe_worker_enabled", return_value=True):
+        _init_memory(agent, {}, True, "cli")
+    assert agent._memory_recall_cold_after == 3600
