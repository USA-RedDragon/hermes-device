+_CLARIFY_PRUNED = "[clarify] user responded: "  # agent.context_compressor._sum_clarify
+
+
+def _clarify_call_ids(msgs: list) -> set[str]:
+    """Ids of the ``clarify`` calls the assistant made in ``msgs``. Only a tool row that answers one of these
+    can carry a clarify answer: a terminal output, file, page or subagent result that is shaped like one is the
+    result of another call and never counts."""
+    ids: set[str] = set()
+    for message in msgs:
+        if message.get("role") != "assistant":
+            continue
+        for call in message.get("tool_calls") or []:
+            cid, name, _raw = _call_parts(call)
+            if cid and name == "clarify":
+                ids.add(cid)
+    return ids
+
+
+def clarify_statements(content: Any) -> list[str]:
+    """What the user said in the result of a ``clarify`` call, as the review reads it: one line per answered
+    question with the question and the option chosen (or the words typed under "Other"). Only the gateway's own
+    record counts: ``outcome`` ``submitted`` and a response with status ``answered`` (a timed-out, cancelled,
+    undelivered or skipped question says nothing)."""
+    text = content if isinstance(content, str) else ""
+    if text.startswith(_CLARIFY_PRUNED):  # the compressor's one-line form of an answered clarify result
+        answer = text[len(_CLARIFY_PRUNED):].rstrip("\u2026").strip()
+        return [f"(answering a question the assistant asked) {_cut(answer, _USER_MESSAGE_CHARS)}"] if answer else []
+    try:
+        payload = json.loads(text)
+    except Exception:
+        return []
+    if not isinstance(payload, dict) or payload.get("outcome") != "submitted":
+        return []
+    out: list[str] = []
+    for r in payload.get("responses") or []:
+        if not isinstance(r, dict) or r.get("status") != "answered":
+            continue
+        value = r.get("user_response")
+        values = [str(v) for v in value] if isinstance(value, list) else [str(value)] if value else []
+        values = [v.strip() for v in values if v and v.strip()]
+        if not values:
+            continue
+        offered = r.get("choices_offered")
+        offered = [str(o).strip() for o in offered] if isinstance(offered, list) else []
+        picked = bool(offered) and all(v in offered for v in values)
+        how = "chose" if picked else "typed"
+        question = _cut(str(r.get("question") or "").strip(), _CLARIFY_QUESTION_CHARS)
+        answer = _cut("; ".join(values), _USER_MESSAGE_CHARS)
+        out.append(f'(answering the assistant\'s question "{question}") {how}: {answer}')
+    return out
+
+
