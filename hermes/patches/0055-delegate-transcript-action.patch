+def record_manifest_children(delegation_id: Optional[str], owner_session_id: str,
+                             subagent_ids: dict[int, Optional[str]], home: Optional[Path] = None) -> None:
+    """Best-effort: name the owning conversation and each task's ``subagent_id`` in the manifest, so
+    ``delegate_task(action='transcript', delegation_id=..., task_index=...)`` can find the child's stored session."""
+    if not delegation_id:
+        return
+    with _best_effort("manifest children"):
+        mp = _manifest_path(delegation_id, home)
+        manifest = json.loads(mp.read_text(encoding="utf-8-sig"))
+        manifest["owner_session_id"] = owner_session_id
+        for task in manifest.get("tasks", []):
+            if subagent_ids.get(task.get("index")):
+                task["subagent_id"] = subagent_ids[task["index"]]
+        _dump_json(mp, manifest)
