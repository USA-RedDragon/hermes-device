index 00000000..dbca26e1
--- /dev/null
+++ b/tools/delegate_tool_transcript.py
@@ -0,0 +1,274 @@
+"""``delegate_task(action='transcript')``: a parent reads the steps of its own subagents, running or finished.
+
+The reader is the child's stored session (``tools/delegate_tool_sessions.py`` finds it by ``subagent_id``), so
+it works while the child runs and after it ended, past the 7-day live-log cleanup, and from a parent whose
+terminal is on another machine than the one holding ``cache/delegation``. Only when no stored session is found
+(a child that never wrote a row) does it read the ``task-<n>.log`` of the delegation's manifest.
+
+Scope is the caller's own spawn tree: a running child is found in the live registry by the same ownership rule
+as list/steer/stop; a finished one by the ``subagent_id`` stamped on its row, and only when its ancestry reaches
+the caller's conversation. A delegation id is mapped to its children through ``manifest.json``, never trusted
+alone.
+"""
+
+from __future__ import annotations
+
+import json
+import time
+from pathlib import Path
+from typing import Any, Optional
+
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 200
+DEFAULT_MAX_CHARS = 20000
+MAX_MAX_CHARS = 200000
+_TEXT_CUT = 4000
+_THINKING_CUT = 600
+_ARG_CUT = 400
+_RESULT_CUT = 1500
+_LOG_LINE_CUT = 1000
+
+
+def _cut(value: Any, limit: int) -> tuple[str, int]:
+    """``(text cut to *limit* chars, full size)``; the cut text ends with a note of what was left out."""
+    text = value if isinstance(value, str) else ("" if value is None else str(value))
+    size = len(text)
+    if size > limit:
+        text = text[:limit] + f" ...(+{size - limit} chars)"
+    return text, size
+
+
+def _redact(text: str) -> str:
+    """Same boundary as the live log: mask credentials, withhold rather than leak."""
+    if not text:
+        return text
+    try:
+        from agent.redact import redact_sensitive_text
+        return redact_sensitive_text(text, force=True) or ""
+    except Exception:  # pragma: no cover - core module
+        return "[withheld: redaction unavailable]"
+
+
+def _iso(ts: Any) -> Optional[str]:
+    if isinstance(ts, (int, float)) and ts > 0:
+        return time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime(ts))
+    return None
+
+
+def _parsed(value: Any) -> Any:
+    if isinstance(value, str):
+        try:
+            return json.loads(value)
+        except ValueError:
+            return value
+    return value
+
+
+def _call_entry(call: Any) -> dict[str, Any]:
+    fn = call.get("function") if isinstance(call, dict) and isinstance(call.get("function"), dict) else {}
+    args = fn.get("arguments", "")
+    if not isinstance(args, str):
+        args = json.dumps(args, ensure_ascii=False, default=str)
+    shown, size = _cut(_redact(args), _ARG_CUT)
+    entry = {"id": call.get("id") if isinstance(call, dict) else None, "name": fn.get("name"), "arguments": shown}
+    if size > _ARG_CUT:
+        entry["arguments_size"] = size
+    return entry
+
+
+def _entry(index: int, msg: dict[str, Any], names: dict[str, str]) -> dict[str, Any]:
+    role = msg.get("role")
+    out: dict[str, Any] = {"index": index, "role": role, "time": _iso(msg.get("timestamp"))}
+    content = msg.get("content")
+    if role == "tool":
+        call_id = msg.get("tool_call_id")
+        out["tool_call_id"] = call_id
+        out["name"] = msg.get("tool_name") or names.get(call_id or "")
+        out["result"], out["result_size"] = _cut(_redact(content if isinstance(content, str) else json.dumps(
+            content, ensure_ascii=False, default=str)), _RESULT_CUT)
+        return out
+    if isinstance(content, str) and content:
+        out["text"], size = _cut(_redact(content), _TEXT_CUT)
+        if size > _TEXT_CUT:
+            out["text_size"] = size
+    elif content:
+        out["text"], _ = _cut(_redact(json.dumps(content, ensure_ascii=False, default=str)), _TEXT_CUT)
+    if role == "assistant":
+        reasoning = msg.get("reasoning") or msg.get("reasoning_content")
+        if isinstance(reasoning, str) and reasoning.strip():
+            out["thinking"], _ = _cut(_redact(reasoning), _THINKING_CUT)
+        calls = _parsed(msg.get("tool_calls"))
+        if isinstance(calls, list) and calls:
+            out["tool_calls"] = [_call_entry(c) for c in calls]
+    return out
+
+
+def _call_names(messages: list[dict[str, Any]]) -> dict[str, str]:
+    names: dict[str, str] = {}
+    for msg in messages:
+        calls = _parsed(msg.get("tool_calls")) if msg.get("role") == "assistant" else None
+        for call in calls if isinstance(calls, list) else ():
+            fn = call.get("function") if isinstance(call, dict) else None
+            if isinstance(fn, dict) and call.get("id") and fn.get("name"):
+                names[call["id"]] = fn["name"]
+    return names
+
+
+def _compression_lineage(db: Any, session_id: str) -> frozenset[str]:
+    """*session_id* plus the sessions it continues by compression, walked backward."""
+    if not session_id:
+        return frozenset()
+    ids, current = {session_id}, session_id
+    row = db.get_session(current)
+    while row and db._is_compression_child_row(row) and row["parent_session_id"] not in ids and len(ids) < 200:
+        current = row["parent_session_id"]
+        ids.add(current)
+        row = db.get_session(current)
+    return frozenset(ids)
+
+
+def _manifest(delegation_id: str, home: Optional[Path]) -> Optional[dict[str, Any]]:
+    from tools.delegation_live_log import _manifest_path
+    try:
+        data = json.loads(_manifest_path(delegation_id, home).read_text(encoding="utf-8-sig"))
+    except (OSError, ValueError):
+        return None
+    return data if isinstance(data, dict) else None
+
+
+def _owned_records(parent_agent: Any) -> list[dict[str, Any]]:
+    from tools.delegate_tool_registry import _active_subagents, _active_subagents_lock, _owns_subagent_record
+    with _active_subagents_lock:
+        records = list(_active_subagents.values())
+    return [r for r in records if _owns_subagent_record(r, parent_agent)]
+
+
+def _int(value: Any, default: int, low: int, high: int) -> Optional[int]:
+    if value is None or value == "":
+        return default
+    if isinstance(value, bool):
+        return None
+    try:
+        number = int(value)
+    except (TypeError, ValueError):
+        return None
+    return max(low, min(high, number))
+
+
+def read_subagent_transcript(parent_agent: Any, *, subagent_id: Optional[str], delegation_id: Optional[str],
+                             task_index: Any, limit: Any, after: Any, max_chars: Any) -> dict[str, Any]:
+    """The payload of one transcript page, or ``{"error": ...}``. Never reads outside the caller's spawn tree."""
+    from tools.delegate_tool import _parent_live_home
+    sid, deleg = (subagent_id or "").strip(), (delegation_id or "").strip()
+    if not sid and not deleg:
+        return {"error": "action='transcript' requires subagent_id (from the spawn response or action='list'), or "
+                         "delegation_id with task_index."}
+    count, start, budget = (_int(limit, DEFAULT_LIMIT, 1, MAX_LIMIT), _int(after, -1, -1, 1 << 40),
+                            _int(max_chars, DEFAULT_MAX_CHARS, 1000, MAX_MAX_CHARS))
+    if count is None or start is None or budget is None:
+        return {"error": "limit, after and max_chars must be integers."}
+    index = _int(task_index, 0, 0, 1 << 20)
+    if index is None:
+        return {"error": "task_index must be an integer."}
+    db = getattr(parent_agent, "_session_db", None)
+    home = _parent_live_home(parent_agent)
+    parent_sid = str(getattr(parent_agent, "session_id", "") or "")
+    manifest = _manifest(deleg, home) if deleg else None
+    manifest_task = None
+    if not sid:
+        owned = [r for r in _owned_records(parent_agent)
+                 if getattr(r.get("agent"), "_delegation_id", None) == deleg
+                 and getattr(r.get("agent"), "_delegation_task_index", None) == index]
+        manifest_task = next((t for t in (manifest or {}).get("tasks", []) if t.get("index") == index), None)
+        sid = (owned[0].get("subagent_id") if len(owned) == 1 else None) or (manifest_task or {}).get("subagent_id") or ""
+        if not sid:
+            return {"error": f"No transcript for delegation '{deleg}' task {index} in this conversation's spawn tree."}
+    unknown = {"error": f"No subagent '{sid}' in this conversation's spawn tree (or its stored session is gone). "
+                        "Use action='list' for running children; ids of earlier ones are in their spawn response."}
+
+    running_record = next((r for r in _owned_records(parent_agent) if r.get("subagent_id") == sid), None)
+    child = getattr(running_record.get("agent"), "session_id", None) if running_record else None
+    if not (isinstance(child, str) and child) and db is not None and parent_sid:
+        from tools.delegate_tool_sessions import stored_child_session
+        try:
+            child = stored_child_session(db, sid, _compression_lineage(db, parent_sid))
+        except Exception:
+            child = None
+    if not (isinstance(child, str) and child):
+        # Last resort: the log of a delegation this conversation owns (manifest stamped at dispatch).
+        log = _log_page(manifest, parent_sid, db, sid, index, count, start, budget) if manifest else None
+        return log or unknown
+    if db is None:
+        return unknown
+    try:
+        lineage = db.transcript_lineage_ids(child)
+        messages = db.get_messages(child, include_ancestors=len(lineage) > 1, include_compacted=True)
+        row = db.get_session(child) or {}
+    except Exception as exc:
+        return {"error": f"Could not read the stored session of '{sid}': {exc}"}
+    total = len(messages)
+    reset = start > total  # the child compacted its history since that cursor was issued
+    first = max(0, total - count) if start < 0 or reset else start
+    names = _call_names(messages)
+    entries, used = [], 0
+    for i in range(first, min(total, first + count)):
+        entry = _entry(i, messages[i], names)
+        size = len(json.dumps(entry, ensure_ascii=False, default=str))
+        if entries and used + size > budget:
+            break
+        entries.append(entry)
+        used += size
+    end = first + len(entries)
+    if running_record is not None:
+        status = running_record.get("status") or "running"
+    else:
+        status = "finished" if row.get("ended_at") else "idle"
+    payload: dict[str, Any] = {
+        "action": "transcript", "subagent_id": sid, "source": "session", "status": status,
+        "running": running_record is not None, "goal": (running_record or {}).get("goal"),
+        "total_entries": total, "first_index": first, "returned": len(entries), "entries": entries,
+        "next_after": end, "has_more": end < total,
+    }
+    if deleg:
+        payload["delegation_id"], payload["task_index"] = deleg, index
+    if reset:
+        payload["note"] = "after was past the end (the child compacted its history); showing the newest entries."
+    elif start < 0 and first > 0:
+        payload["note"] = (f"Showing the newest {len(entries)} of {total} entries. Pass after=<index> to read "
+                           "forward; next_after continues where this page ended.")
+    return payload
+
+
+def _log_page(manifest: dict[str, Any], parent_sid: str, db: Any, sid: str, index: int, count: int, start: int,
+              budget: int) -> Optional[dict[str, Any]]:
+    """The tail of a task's .log, only for a delegation whose manifest names this conversation as its owner
+    (and this subagent for the task)."""
+    owner = str(manifest.get("owner_session_id") or "")
+    if not owner or not parent_sid or db is None:
+        return None
+    try:
+        if owner not in _compression_lineage(db, parent_sid):
+            return None
+    except Exception:
+        return None
+    task = next((t for t in manifest.get("tasks", []) if t.get("index") == index), None)
+    if not task or task.get("subagent_id") != sid or not task.get("log"):
+        return None
+    try:
+        lines = Path(task["log"]).read_text(encoding="utf-8", errors="replace").splitlines()
+    except OSError:
+        return None
+    total = len(lines)
+    first = max(0, total - count) if start < 0 or start > total else start
+    shown, used = [], 0
+    for i in range(first, min(total, first + count)):
+        text, _ = _cut(_redact(lines[i]), _LOG_LINE_CUT)
+        if shown and used + len(text) > budget:
+            break
+        shown.append({"index": i, "text": text})
+        used += len(text)
+    end = first + len(shown)
+    return {"action": "transcript", "subagent_id": sid, "source": "log", "status": task.get("status"),
+            "total_entries": total, "first_index": first, "returned": len(shown), "entries": shown,
+            "next_after": end, "has_more": end < total,
+            "note": "The stored session was not found; these are lines of the child's live log."}
