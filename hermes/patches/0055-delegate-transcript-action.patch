+"""delegate_task(action='transcript'): a parent reads its own subagents' stored transcripts, running or finished."""
+
+import json
+import weakref
+
+import pytest
+
+from tools.delegate_tool import _register_subagent, _unregister_subagent, delegate_task
+
+
+class _Parent:
+    def __init__(self, db, session_id):
+        self._session_db, self.session_id = db, session_id
+
+
+class _LiveChild:
+    def __init__(self, parent, session_id, delegation_id=None, index=None):
+        self._delegate_parent_ref = weakref.ref(parent)
+        self.session_id = session_id
+        self._delegation_id, self._delegation_task_index = delegation_id, index
+
+
+@pytest.fixture
+def db(tmp_path):
+    from hermes_state import SessionDB
+    store = SessionDB(db_path=tmp_path / "state.db")
+    yield store
+    store.close()
+
+
+def _child_session(db, sid, subagent_id, parent, steps=3, ended=True):
+    marker = {"_delegate_from": parent, "_subagent_id": subagent_id}
+    db.create_session(sid, source="subagent", parent_session_id=parent, model_config=marker)
+    db.append_message(sid, "user", "do the thing")
+    for n in range(steps):
+        call = {"id": f"c{n}", "type": "function", "function": {"name": "terminal", "arguments": json.dumps({"command": f"echo {n}"})}}
+        db.append_message(sid, "assistant", f"step {n}", tool_calls=[call], reasoning=f"thinking {n}")
+        db.append_message(sid, "tool", "x" * 5000 if n == 0 else f"out {n}", tool_call_id=f"c{n}", tool_name="terminal")
+    if ended:
+        db.end_session(sid, "completed")
+
+
+def _call(parent, **kw):
+    return json.loads(delegate_task(action="transcript", parent_agent=parent, **kw))
+
+
+def test_finished_child_tail_and_paging(db):
+    db.create_session("parent", source="cli")
+    _child_session(db, "kid", "sa-0-aaaa", "parent")
+    parent = _Parent(db, "parent")
+    page = _call(parent, subagent_id="sa-0-aaaa", limit=3)
+    assert page["status"] == "finished" and page["running"] is False and page["source"] == "session"
+    assert page["total_entries"] == 7 and page["returned"] == 3 and page["first_index"] == 4
+    assert page["has_more"] is False and page["next_after"] == 7
+    first = _call(parent, subagent_id="sa-0-aaaa", limit=3, after=0)
+    assert [e["index"] for e in first["entries"]] == [0, 1, 2] and first["has_more"] is True
+    assert first["entries"][0]["role"] == "user" and first["entries"][0]["text"] == "do the thing"
+    asst = first["entries"][1]
+    assert asst["text"] == "step 0" and asst["thinking"] == "thinking 0"
+    assert asst["tool_calls"][0]["name"] == "terminal" and "echo 0" in asst["tool_calls"][0]["arguments"]
+    tool = first["entries"][2]
+    assert tool["name"] == "terminal" and tool["result_size"] == 5000 and tool["result"].endswith("(+3500 chars)")
+    rest = _call(parent, subagent_id="sa-0-aaaa", limit=10, after=first["next_after"])
+    assert [e["index"] for e in rest["entries"]] == [3, 4, 5, 6] and rest["has_more"] is False
+    assert all(e["time"] for e in rest["entries"])
+
+
+def test_max_chars_bounds_a_page_and_next_after_continues(db):
+    db.create_session("parent", source="cli")
+    _child_session(db, "kid", "sa-0-bbbb", "parent")
+    parent = _Parent(db, "parent")
+    page = _call(parent, subagent_id="sa-0-bbbb", after=0, max_chars=1000)
+    assert 1 <= page["returned"] < 7 and page["has_more"] is True
+    nxt = _call(parent, subagent_id="sa-0-bbbb", after=page["next_after"], limit=200)
+    assert nxt["first_index"] == page["next_after"]
+
+
+def test_running_child_found_in_registry(db):
+    db.create_session("parent", source="cli")
+    _child_session(db, "kid", "sa-0-cccc", "parent", ended=False)
+    parent = _Parent(db, "parent")
+    child = _LiveChild(parent, "kid")
+    _register_subagent({"subagent_id": "sa-0-cccc", "parent_id": None, "depth": 0, "goal": "g", "model": "m",
+                        "started_at": 1.0, "status": "running", "tool_count": 0, "agent": child})
+    try:
+        page = _call(parent, subagent_id="sa-0-cccc")
+        assert page["running"] is True and page["status"] == "running" and page["goal"] == "g"
+        assert page["total_entries"] == 7
+    finally:
+        _unregister_subagent("sa-0-cccc")
+
+
+def test_another_conversations_child_is_refused(db):
+    db.create_session("parent", source="cli")
+    db.create_session("other", source="cli")
+    _child_session(db, "kid", "sa-0-dddd", "other")
+    result = json.loads(delegate_task(action="transcript", subagent_id="sa-0-dddd", parent_agent=_Parent(db, "parent")))
+    assert "error" in result and "spawn tree" in result["error"]
+    # a live child of another parent is refused too, even though the id is registered
+    other = _Parent(db, "other")
+    _register_subagent({"subagent_id": "sa-0-dddd", "parent_id": None, "depth": 0, "goal": "g", "model": "m",
+                        "started_at": 1.0, "status": "running", "tool_count": 0,
+                        "agent": _LiveChild(other, "kid")})
+    try:
+        result = json.loads(delegate_task(action="transcript", subagent_id="sa-0-dddd",
+                                          parent_agent=_Parent(db, "parent")))
+        assert "error" in result
+        assert _call(other, subagent_id="sa-0-dddd")["running"] is True
+    finally:
+        _unregister_subagent("sa-0-dddd")
+
+
+def test_unknown_and_missing_ids(db):
+    db.create_session("parent", source="cli")
+    parent = _Parent(db, "parent")
+    assert "error" in json.loads(delegate_task(action="transcript", subagent_id="sa-0-nope", parent_agent=parent))
+    assert "requires subagent_id" in json.loads(delegate_task(action="transcript", parent_agent=parent))["error"]
+    assert "integers" in json.loads(delegate_task(action="transcript", subagent_id="x", limit="many",
+                                                  parent_agent=parent))["error"]
+
+
+def test_compression_rotated_parent_still_owns_its_child(db):
+    db.create_session("p1", source="cli")
+    _child_session(db, "kid", "sa-0-eeee", "p1")
+    db.end_session("p1", "compression")
+    db.create_session("p2", source="cli", parent_session_id="p1")
+    assert _call(_Parent(db, "p2"), subagent_id="sa-0-eeee")["total_entries"] == 7
+
+
+def _manifest(tmp_path, deleg, owner, tasks):
+    root = tmp_path / "cache" / "delegation" / "live" / deleg
+    root.mkdir(parents=True)
+    (root / "manifest.json").write_text(json.dumps({"delegation_id": deleg, "owner_session_id": owner, "tasks": tasks}))
+    return root
+
+
+def test_delegation_id_and_task_index_map_through_the_manifest(db, tmp_path):
+    db.create_session("parent", source="cli")
+    _child_session(db, "kid0", "sa-0-ffff", "parent")
+    _child_session(db, "kid1", "sa-1-gggg", "parent", steps=1)
+    _manifest(tmp_path, "deleg_1", "parent", [
+        {"index": 0, "subagent_id": "sa-0-ffff", "status": "completed"},
+        {"index": 1, "subagent_id": "sa-1-gggg", "status": "completed"}])
+    parent = _Parent(db, "parent")
+    assert _call(parent, delegation_id="deleg_1", task_index=1)["total_entries"] == 3
+    assert _call(parent, delegation_id="deleg_1")["subagent_id"] == "sa-0-ffff"
+    assert "error" in json.loads(delegate_task(action="transcript", delegation_id="deleg_1", task_index=5,
+                                               parent_agent=parent))
+    # another conversation's delegation id proves nothing: the child's ancestry must reach the caller
+    db.create_session("stranger", source="cli")
+    assert "error" in json.loads(delegate_task(action="transcript", delegation_id="deleg_1",
+                                               parent_agent=_Parent(db, "stranger")))
+
+
+def test_log_fallback_only_for_the_owner(db, tmp_path):
+    db.create_session("parent", source="cli")
+    db.create_session("stranger", source="cli")
+    root = _manifest(tmp_path, "deleg_2", "parent", [])
+    log = root / "task-0.log"
+    log.write_text("\n".join(f"line {i}" for i in range(10)))
+    (root / "manifest.json").write_text(json.dumps({
+        "owner_session_id": "parent",
+        "tasks": [{"index": 0, "subagent_id": "sa-0-hhhh", "log": str(log), "status": "running"}]}))
+    page = _call(_Parent(db, "parent"), delegation_id="deleg_2", limit=3)
+    assert page["source"] == "log" and [e["text"] for e in page["entries"]] == ["line 7", "line 8", "line 9"]
+    assert "error" in json.loads(delegate_task(action="transcript", delegation_id="deleg_2",
+                                               parent_agent=_Parent(db, "stranger")))
+
+
+def test_secrets_are_redacted(db):
+    db.create_session("parent", source="cli")
+    db.create_session("kid", source="subagent", parent_session_id="parent",
+                      model_config={"_delegate_from": "parent", "_subagent_id": "sa-0-iiii"})
+    db.append_message("kid", "tool", "OPENAI_API_KEY=sk-abcdefghijklmnopqrstuvwxyz0123456789", tool_call_id="c", tool_name="terminal")
+    page = _call(_Parent(db, "parent"), subagent_id="sa-0-iiii")
+    assert "sk-abcdefghijklmnopqrstuvwxyz0123456789" not in page["entries"][0]["result"]
+
+
+def test_schema_and_hint_advertise_transcript():
+    from tools.delegate_tool import DELEGATE_TASK_SCHEMA, oneshot_delegate_function
+    from tools.delegate_tool_dispatch import _BACKGROUND_NOTES
+    props = DELEGATE_TASK_SCHEMA["parameters"]["properties"]
+    assert "transcript" in props["action"]["enum"] and {"delegation_id", "task_index", "after", "limit"} <= props.keys()
+    assert "action='transcript'" in _BACKGROUND_NOTES["live_transcripts_hint"] and "tail -f" not in _BACKGROUND_NOTES["live_transcripts_hint"]
+    slim = oneshot_delegate_function(DELEGATE_TASK_SCHEMA)["parameters"]["properties"]
+    assert not {"action", "delegation_id", "after"} & slim.keys()
+
+
+def test_record_manifest_children(tmp_path):
+    from tools.delegation_live_log import create_live_transcripts, record_manifest_children
+    deleg, _, _ = create_live_transcripts([{"goal": "a"}, {"goal": "b"}], home=tmp_path)
+    record_manifest_children(deleg, "parent", {0: "sa-0-x", 1: None}, home=tmp_path)
+    data = json.loads((tmp_path / "cache" / "delegation" / "live" / deleg / "manifest.json").read_text())
+    assert data["owner_session_id"] == "parent"
+    assert data["tasks"][0]["subagent_id"] == "sa-0-x" and "subagent_id" not in data["tasks"][1]
