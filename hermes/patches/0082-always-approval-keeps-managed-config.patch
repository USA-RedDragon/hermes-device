+@contextmanager
+def config_write_lock(config_path: Optional[Path] = None):
+    """Serialize a read-modify-write of config.yaml across threads and processes.
+
+    ``_CONFIG_LOCK`` is per process; the gateway, the ACP host, cron and session workers share one
+    config.yaml, and two unlocked read-then-replace cycles keep only the last writer's change.
+    Reentrant per thread (``hermes_cli.auth._file_lock``), taken after ``_CONFIG_LOCK``."""
