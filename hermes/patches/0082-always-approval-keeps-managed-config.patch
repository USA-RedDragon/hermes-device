new file mode 100644
index 0000000000..fba17f1244
--- /dev/null
+++ b/tests/tools/test_always_approval_keeps_managed_config.py
@@ -0,0 +1,169 @@
+"""Saving an ``always`` approval must not rewrite config.yaml without the managed settings.
+
+A deployment that renders config.yaml as the user layer merged with the managed overlay (the
+managed values are in the file too) lost all of them on the first ``always`` answer:
+``save_permanent_allowlist`` loaded the merged config and wrote it back through ``save_config``,
+which strips every leaf the managed layer pins, so a 13 KB file became a 2 KB skeleton. The save
+was also an unlocked read-modify-write, so two processes answering ``always`` at the same time
+kept only one of the two entries.
+"""
+
+import json
+import os
+import subprocess
+import sys
+import textwrap
+from pathlib import Path
+
+import pytest
+
+import hermes_yaml as yaml
+from hermes_cli import managed_scope
+from tools import approval
+
+MANAGED = textwrap.dedent("""\
+    model:
+      default: acme/pinned
+      provider: claude-pool
+    agent:
+      max_iterations: 400
+      clarify_timeout: 1800
+    dashboard:
+      managed_read_only: true
+    vision:
+      resize_mode: fit
+    """)
+
+# config.yaml as the managed merge renders it: user settings plus every managed value.
+RENDERED = textwrap.dedent("""\
+    # operator note
+    model:
+      default: acme/pinned
+      provider: claude-pool
+    agent:
+      max_iterations: 400
+      clarify_timeout: 1800
+    dashboard:
+      managed_read_only: true
+    vision:
+      resize_mode: fit
+    memory:
+      memory_char_limit: 9000
+    command_allowlist:
+    - git status
+    """)
+
+
+def _leaves(d, prefix=""):
+    out = {}
+    for k, v in d.items():
+        key = f"{prefix}.{k}" if prefix else str(k)
+        if isinstance(v, dict) and v:
+            out.update(_leaves(v, key))
+        else:
+            out[key] = v
+    return out
+
+
+@pytest.fixture
+def managed_home(tmp_path, monkeypatch):
+    home, managed = tmp_path / "home", tmp_path / "managed"
+    home.mkdir()
+    managed.mkdir()
+    (managed / "config.yaml").write_text(MANAGED)
+    (home / "config.yaml").write_text(RENDERED)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_MANAGED_DIR", str(managed))
+    managed_scope.invalidate_managed_cache()
+    saved_approved = set(approval._permanent_approved)
+    saved_baseline = dict(approval._permanent_baseline_by_home)
+    approval._permanent_approved.clear()
+    approval._permanent_baseline_by_home.clear()
+    approval.load_permanent_allowlist()
+    try:
+        yield home
+    finally:
+        approval._permanent_approved.clear()
+        approval._permanent_approved.update(saved_approved)
+        approval._permanent_baseline_by_home.clear()
+        approval._permanent_baseline_by_home.update(saved_baseline)
+        managed_scope.invalidate_managed_cache()
+
+
+def _on_disk(home):
+    return yaml.safe_load((home / "config.yaml").read_text())
+
+
+def test_an_always_approval_keeps_every_managed_setting_in_the_file(managed_home):
+    approval.approve_permanent("plugin_rule:browser:visit:example.com")
+    approval.save_permanent_allowlist(approval._permanent_approved)
+
+    saved = _on_disk(managed_home)
+    leaves = _leaves(saved)
+    for key, value in _leaves(yaml.safe_load(MANAGED)).items():
+        assert leaves.get(key) == value, f"managed setting {key} was dropped by an always save"
+    assert saved["memory"] == {"memory_char_limit": 9000}
+    assert saved["command_allowlist"] == ["git status", "plugin_rule:browser:visit:example.com"]
+    assert "# operator note" in (managed_home / "config.yaml").read_text()
+
+
+def test_save_config_leaves_the_managed_values_on_disk(managed_home):
+    """Every other bulk save (model pick, plugin toggle) must not strip the rendered file either."""
+    from hermes_cli.config import load_config, save_config
+    config = load_config()
+    config["memory"]["memory_char_limit"] = 7000
+    config["agent"]["max_iterations"] = 5      # a managed leaf: not saved, and not deleted
+    save_config(config)
+
+    leaves = _leaves(_on_disk(managed_home))
+    for key, value in _leaves(yaml.safe_load(MANAGED)).items():
+        assert leaves.get(key) == value, f"managed setting {key} was dropped by save_config"
+    assert leaves["memory.memory_char_limit"] == 7000
+
+
+_WORKER = textwrap.dedent("""\
+    import json, os, sys, time
+    from pathlib import Path
+    rendezvous, me, other, entry = Path(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4]
+    import hermes_cli.config as cfg
+    from tools import approval
+
+    def _meet(real):
+        def wrapper(*a, **k):
+            result = real(*a, **k)
+            if not (rendezvous / me).exists():   # only at the save's first config read
+                (rendezvous / me).touch()
+                deadline = time.monotonic() + 3
+                while not (rendezvous / other).exists() and time.monotonic() < deadline:
+                    time.sleep(0.02)
+            return result
+        return wrapper
+
+    approval.load_permanent_allowlist()
+    cfg.load_config = _meet(cfg.load_config)
+    cfg.require_readable_config_before_write = _meet(cfg.require_readable_config_before_write)
+    approval.approve_permanent(entry)
+    approval.save_permanent_allowlist(approval._permanent_approved)
+    print(json.dumps("ok"))
+    """)
+
+
+def test_two_processes_answering_always_at_once_both_land(managed_home, tmp_path):
+    """Both savers read before either writes (they wait for each other at their first config
+    read, up to 3 s); an unlocked read-modify-write then keeps only the last writer's entry."""
+    rendezvous = tmp_path / "rendezvous"
+    rendezvous.mkdir()
+    script = tmp_path / "worker.py"
+    script.write_text(_WORKER)
+    env = {**os.environ, "PYTHONPATH": str(Path(approval.__file__).resolve().parents[1])}
+    procs = [subprocess.Popen([sys.executable, str(script), str(rendezvous), me, other, entry],
+                              env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+             for me, other, entry in (("a", "b", "docker *"), ("b", "a", "cargo *"))]
+    for p in procs:
+        out, err = p.communicate(timeout=60)
+        assert p.returncode == 0, err
+        assert json.loads(out.strip().splitlines()[-1]) == "ok"
+
+    saved = _on_disk(managed_home)
+    assert sorted(saved["command_allowlist"]) == ["cargo *", "docker *", "git status"]
+    assert saved["agent"]["max_iterations"] == 400
