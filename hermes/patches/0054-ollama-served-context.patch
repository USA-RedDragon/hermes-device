From: USA-RedDragon <USA-RedDragon@users.noreply.github.com>
Date: Fri, 13 Nov 2026 00:05:40 -0600
Subject: [PATCH] fix(model): detect the context window Ollama serves

A local Ollama model's context length was its trained maximum (/api/show model_info) unless the Modelfile set num_ctx, so a server started with OLLAMA_CONTEXT_LENGTH=65536 showed 131K and compression started too late while Ollama truncated past 64K. The probe now prefers /api/ps context_length of the loaded model, then the model's num_ctx parameter, then the window a load gives (an empty-prompt generate, then /api/ps), then Ollama's 4096 default; model_info only bounds the answer.
---
 agent/model_metadata.py                      |  55 +++++++-
 tests/agent/test_model_metadata_local_ctx.py |   4 +-
 tests/agent/test_ollama_served_context.py    | 128 +++++++++++++++++++
 3 files changed, 182 insertions(+), 5 deletions(-)
 create mode 100644 tests/agent/test_ollama_served_context.py

diff --git a/agent/model_metadata.py b/agent/model_metadata.py
index 65e64eca52..e0f02fd01b 100644
--- a/agent/model_metadata.py
+++ b/agent/model_metadata.py
@@ -593,6 +593,55 @@ def _ollama_show_context(data: dict[str, Any], *, gguf_first: bool, minimum: Opt
     return None
 
 
+#: What Ollama serves when neither the server (``OLLAMA_CONTEXT_LENGTH``) nor the model (Modelfile
+#: ``num_ctx``) says: 4096 on a GPU with under 24 GiB (32K from 24 GiB, 256K from 48 GiB; the VRAM
+#: tier is not visible over HTTP, so the floor is used). Never the model's trained maximum.
+OLLAMA_DEFAULT_NUM_CTX = 4096
+
+
+def _ollama_model_key(name: Any) -> str:
+    name = str(name or "").strip()
+    return name if ":" in name else f"{name}:latest"
+
+
+def _ollama_loaded_context(client, server_url: str, bare_model: str) -> Optional[int]:
+    """``context_length`` that ``/api/ps`` reports for *bare_model* while it is loaded: the window
+    Ollama allocated (``ollama ps`` CONTEXT column), whatever set it. None when it is not loaded."""
+    resp = client.get(f"{server_url}/api/ps")
+    if resp.status_code != 200:
+        return None
+    want = _ollama_model_key(bare_model)
+    for entry in resp.json().get("models") or []:
+        if isinstance(entry, dict) and want in (_ollama_model_key(entry.get("name")), _ollama_model_key(entry.get("model"))):
+            ctx = entry.get("context_length")
+            if isinstance(ctx, (int, float)) and not isinstance(ctx, bool) and ctx > 0:
+                return int(ctx)
+    return None
+
+
+def _ollama_served_context(client, server_url: str, bare_model: str, show: dict[str, Any]) -> int:
+    """The window Ollama will serve *bare_model* with, not its trained maximum.
+
+    In order: ``/api/ps`` ``context_length`` of the loaded model; the model's ``num_ctx`` parameter
+    (``/api/show`` ``parameters``); else a load with an empty prompt, so ``/api/ps`` can say what the
+    server's own default (``OLLAMA_CONTEXT_LENGTH``) gave it; else Ollama's default. The model's
+    ``model_info`` maximum only bounds the answer: Ollama never serves more than the model has.
+    """
+    maximum = _ollama_show_context({"model_info": show.get("model_info") or {}}, gguf_first=True)
+    served = _ollama_loaded_context(client, server_url, bare_model)
+    if served is None:
+        served = _ollama_show_context({"parameters": show.get("parameters") or ""}, gguf_first=False)
+    if served is None:
+        try:  # a load with no prompt runs nothing; the server picks the window and /api/ps reports it
+            client.post(f"{server_url}/api/generate", json={"model": bare_model, "prompt": "", "stream": False}, timeout=30.0)
+            served = _ollama_loaded_context(client, server_url, bare_model)
+        except Exception:
+            served = None
+    if served is None:
+        served = OLLAMA_DEFAULT_NUM_CTX
+    return min(served, maximum) if maximum else served
+
+
 # (host, canonical paths, model ids, context) — see _endpoint_scoped_context_length.
 _ENDPOINT_SCOPED_CONTEXT = (
     ("api.kimi.com", {"/coding", "/coding/v1"}, {"k3", "kimi-k3", "kimi-k3-cot"}, 1_048_576),
@@ -1598,10 +1647,10 @@ def _query_local_context_length_uncached(model: str, base_url: str, api_key: str
     except Exception:
         server_type = None
     def _ollama_ctx(client) -> Optional[int]:
-        # Ollama: num_ctx (runtime window) before the GGUF training max, or conversations
-        # grow past what Ollama allocated and silently truncate. Matches query_ollama_num_ctx().
+        # Ollama: the window it serves (loaded context, Modelfile num_ctx, server default), never the
+        # GGUF training max, or conversations grow past what Ollama allocated and silently truncate.
         resp = client.post(f"{server_url}/api/show", json={"name": model})
-        return _ollama_show_context(resp.json(), gguf_first=False) if resp.status_code == 200 else None
+        return _ollama_served_context(client, server_url, model, resp.json()) if resp.status_code == 200 else None
     def _model_detail_ctx(client) -> Optional[int]:
         # LM Studio / vLLM / llama.cpp / Anthropic-compat proxies: /v1/models/{model}.
         # Skipped for unrecognised servers (server_type None, e.g. LiteLLM proxies): they commonly
