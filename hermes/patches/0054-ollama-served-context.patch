diff --git a/tests/agent/test_ollama_served_context.py b/tests/agent/test_ollama_served_context.py
new file mode 100644
index 0000000000..8c018a66d9
--- /dev/null
+++ b/tests/agent/test_ollama_served_context.py
@@ -0,0 +1,128 @@
+"""Context length of an Ollama model is the window Ollama serves, not the model's trained maximum.
+
+A fake Ollama HTTP server answers ``/api/tags``, ``/api/show``, ``/api/ps`` and ``/api/generate``.
+Order: ``/api/ps`` ``context_length`` of the loaded model, the Modelfile ``num_ctx``, the window a load
+gives (``OLLAMA_CONTEXT_LENGTH``), Ollama's default; ``model_info`` only bounds it.
+"""
+import json
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+import pytest
+
+from agent import model_metadata as mm
+
+MODEL = "llama3.2:3b"
+TRAINED = 131072
+
+
+class _Ollama:
+    def __init__(self, *, loaded=None, parameters="", server_default=65536, trained=TRAINED, load_works=True):
+        self.loaded, self.parameters, self.server_default = loaded, parameters, server_default
+        self.trained, self.load_works = trained, load_works
+        self.calls = []
+
+
+def _handler(state):
+    class Handler(BaseHTTPRequestHandler):
+        def log_message(self, *args):
+            pass
+
+        def _send(self, code, body):
+            data = json.dumps(body).encode()
+            self.send_response(code)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(data)))
+            self.end_headers()
+            self.wfile.write(data)
+
+        def do_GET(self):
+            state.calls.append(("GET", self.path))
+            if self.path == "/api/tags":
+                self._send(200, {"models": [{"name": MODEL}]})
+            elif self.path == "/api/ps":
+                models = [] if state.loaded is None else [
+                    {"name": MODEL, "model": MODEL, "context_length": state.loaded}]
+                self._send(200, {"models": models})
+            else:
+                self._send(404, {"error": "not found"})
+
+        def do_POST(self):
+            length = int(self.headers.get("Content-Length") or 0)
+            body = json.loads(self.rfile.read(length) or b"{}")
+            state.calls.append(("POST", self.path))
+            if self.path == "/api/show":
+                self._send(200, {"parameters": state.parameters,
+                                 "model_info": {"llama.context_length": state.trained}})
+            elif self.path == "/api/generate":
+                assert body["model"] == MODEL and body["prompt"] == ""
+                if state.load_works:
+                    state.loaded = min(state.server_default, state.trained)
+                self._send(200, {"done": True})
+            else:
+                self._send(404, {"error": "not found"})
+    return Handler
+
+
+@pytest.fixture
+def ollama(monkeypatch):
+    servers = []
+
+    def start(**kwargs):
+        state = _Ollama(**kwargs)
+        server = ThreadingHTTPServer(("127.0.0.1", 0), _handler(state))
+        threading.Thread(target=server.serve_forever, daemon=True).start()
+        servers.append(server)
+        state.url = f"http://127.0.0.1:{server.server_address[1]}"
+        return state
+
+    monkeypatch.setattr(mm, "_endpoint_probe_path_cache", {})
+    monkeypatch.setattr(mm, "_LOCAL_CTX_PROBE_CACHE", {})
+    yield start
+    for server in servers:
+        server.shutdown()
+        server.server_close()
+
+
+def _detect(state):
+    return mm._query_local_context_length_uncached(MODEL, state.url + "/v1")
+
+
+def test_loaded_model_reports_the_served_window(ollama):
+    state = ollama(loaded=65536)  # OLLAMA_CONTEXT_LENGTH=65536; the model's maximum is 131072
+    assert _detect(state) == 65536
+    assert ("POST", "/api/generate") not in state.calls
+
+
+def test_loaded_window_beats_a_modelfile_num_ctx(ollama):
+    state = ollama(loaded=32768, parameters="num_ctx                        16384\nstop \"<|eot_id|>\"")
+    assert _detect(state) == 32768
+
+
+def test_modelfile_num_ctx_when_not_loaded(ollama):
+    state = ollama(parameters="num_ctx                        16384\n")
+    assert _detect(state) == 16384
+    assert ("POST", "/api/generate") not in state.calls
+
+
+def test_unloaded_model_is_loaded_to_read_the_server_default(ollama):
+    state = ollama(server_default=65536)
+    assert _detect(state) == 65536
+    assert ("POST", "/api/generate") in state.calls
+
+
+def test_ollama_default_when_nothing_says(ollama):
+    state = ollama(load_works=False)
+    assert _detect(state) == mm.OLLAMA_DEFAULT_NUM_CTX == 4096
+
+
+def test_trained_maximum_is_only_an_upper_bound(ollama):
+    assert _detect(ollama(loaded=262144, trained=TRAINED)) == TRAINED
+    assert _detect(ollama(parameters="num_ctx 999999\n", trained=8192)) == 8192
+    assert _detect(ollama(load_works=False, trained=2048)) == 2048
+
+
+def test_model_name_without_a_tag_matches_latest(ollama, monkeypatch):
+    state = ollama(loaded=65536)
+    monkeypatch.setattr(f"{__name__}.MODEL", "llama3.2:latest")
+    assert mm._query_local_context_length_uncached("llama3.2", state.url + "/v1") == 65536
