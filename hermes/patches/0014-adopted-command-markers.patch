Date: Wed, 11 Nov 2026 12:21:16 -0600
Subject: [PATCH 1/2] fix(terminal): strip wrapper markers from a command moved
 to the background

A foreground command handed to the process registry prints the wrapper's
pipe-status and CWD marker lines after it exits. The foreground path strips
them in _extract_cwd_from_output, but adopt_local kept them in the buffer,
so the completion output showed them. The environment now names the markers
on the handed process and the registry strips them when the command finishes.
---
 tests/tools/test_terminal_auto_background.py | 30 ++++++++++++++++++++
 tools/environments/base.py                   |  6 +++-
 tools/process_registry.py                    | 19 ++++++++++++-
 3 files changed, 53 insertions(+), 2 deletions(-)

diff --git a/tests/tools/test_terminal_auto_background.py b/tests/tools/test_terminal_auto_background.py
index c3d79d5e11..52f913890c 100644
--- a/tests/tools/test_terminal_auto_background.py
+++ b/tests/tools/test_terminal_auto_background.py
@@ -165,3 +165,33 @@ def test_user_yield_keeps_its_own_reason():
         for proc in procs:
             env._kill_process(proc)
         env.cleanup()
+
+
+@pytest.mark.live_system_guard_bypass
+@pytest.mark.parametrize("command", ["echo alpha; sleep 0.8; echo omega", "echo alpha; sleep 0.8; echo omega | cat"])
+def test_adopted_command_output_carries_no_wrapper_markers(command):
+    """The wrapper prints its pipe-status and CWD marker lines after the command exits, so an adopted
+    command emits them into the registry's buffer: the completion output must not show them."""
+    from tools.environments.local import LocalEnvironment
+
+    env = LocalEnvironment()
+    sids = []
+
+    def handler(proc, output_so_far):
+        session = process_registry.adopt_local(proc, command=command, cwd="/", output_so_far=output_so_far,
+                                               notify_on_complete=False)
+        sids.append(session.id)
+        return {"output": output_so_far, "returncode": None, "yielded_session_id": session.id}
+
+    try:
+        result = env.execute(command, timeout=20, yield_handler=handler, yield_after=0.2)
+        assert result["yield_reason"] == "auto_background"
+        done = process_registry.wait(sids[0], timeout=15)
+    finally:
+        for sid in sids:
+            process_registry.kill_process(sid)
+        env.cleanup()
+    assert done["exit_code"] == 0, done
+    assert "alpha" in done["output"] and "omega" in done["output"]
+    assert "__HERMES_" not in done["output"], done["output"]
+    assert "__HERMES_" not in process_registry.get(sids[0]).output_buffer
