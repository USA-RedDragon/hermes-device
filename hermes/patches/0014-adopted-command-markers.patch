+def _strip_output_markers(session: ProcessSession) -> None:
+    """Remove the foreground wrapper's pipe-status and CWD marker lines from an adopted
+    command's buffer, as ``BaseEnvironment._extract_cwd_from_output`` does for a foreground result."""
+    if not session.output_markers:
+        return
+    with session._lock:
+        for marker in session.output_markers:
+            split = _split_cwd_marker(session.output_buffer, marker)
+            if split is not None:
+                session.output_buffer = split[1]
+
+
 # Watcher routing fields, in event-dict key order (``watcher_<key>`` on the session).
 _WATCHER_ROUTE_KEYS = ("platform", "chat_id", "user_id", "user_name", "thread_id", "message_id")
 # Session fields persisted verbatim in the crash-recovery checkpoint (plus
@@ -1273,9 +1287,11 @@ class ProcessRegistry(ProcessTerminationMixin, ProcessCheckpointMixin, ProcessOu
         (yield-to-background: the user sent a message while the command was running).
         The caller has stopped its own drain thread; the registry's reader continues from
         the pipe's current position and ``output_so_far`` seeds the buffer so nothing
-        already captured is lost."""
+        already captured is lost. The foreground wrapper's marker lines that the process
+        prints on exit (``proc._hermes_output_markers``) are stripped when it finishes."""
         session = self._new_session(command, task_id, owner_task_id, session_key, cwd)
         session.process = proc
+        session.output_markers = tuple(getattr(proc, "_hermes_output_markers", None) or ())
         session.pid = proc.pid
         session.host_start_time = self._safe_host_start_time(session.pid)
         session.notify_on_complete = notify_on_complete
@@ -1597,6 +1613,7 @@ class ProcessRegistry(ProcessTerminationMixin, ProcessCheckpointMixin, ProcessOu
         Idempotent: kill_process() and the reader thread can both call this; only
         the FIRST move enqueues the completion notification, so no duplicates.
         Returns True when this call is the one that persisted the session."""
+        _strip_output_markers(session)
         with self._lock:
             if session.handed_off:
                 return False
