+    def keep_background_processes(self) -> list[dict[str, Any]]:
+        """``delegation.keep_child_processes``: move the background processes the child leaves running to the parent
+        (``ProcessRegistry.keep_for_parent``) so its teardown does not kill them. Not for a child stopped for a restart
+        handoff, whose processes go to the next gateway with it. Returns the moved ones as handoff records."""
+        from tools.delegate_tool_config import _get_keep_child_processes
+        child = self.child
+        if not _get_keep_child_processes() or getattr(child, "_delegate_restart_handoff", False) is True:
+            return []
+        parent = self.parent_agent
+        parent_owner = str(getattr(parent, "_current_task_id", "") or getattr(parent, "session_id", "") or "")
+        if not parent_owner:
+            return []
+        from tools.process_registry import process_registry
+        from tools.terminal_tool import _resolve_container_task_id
+        owners = {self.child_task_id, *(getattr(child, "_process_owner_task_ids", None) or ())} - {"", None}
+        note = (f"left running by subagent {self.subagent_id or self.child_task_id} when it ended; kept for you "
+                "(delegation.keep_child_processes)")
+        kept = []
+        for owner in sorted(owners):
+            for session in process_registry.running_owned_by(owner):
+                moved = process_registry.keep_for_parent(
+                    session.id, from_owner=owner, to_owner=parent_owner,
+                    to_task_id=_resolve_container_task_id(parent_owner),
+                    to_session_key=str(getattr(parent, "session_id", "") or ""), note=note)
+                if moved is not None:
+                    kept.append({"session_id": moved.id, "command": redact_child_text(moved.command, force=False)[:200],
+                                 "note": note})
+        return kept
+
