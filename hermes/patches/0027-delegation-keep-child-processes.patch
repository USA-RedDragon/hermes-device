@@ -0,0 +1,90 @@
+"""delegation.keep_child_processes: background processes a subagent leaves running when it ends move to its parent
+instead of dying with the child. They stay tracked, leave agent-lifecycle cleanup, and stop on an explicit kill or when
+the parent's session is deleted."""
+
+import time
+import types
+
+import pytest
+
+import tools.delegate_tool_config as delegate_config
+from gateway.session_mutations import _reap_kept_processes
+from tools.delegate_tool_child_run import _ChildRun
+from tools.process_registry import _CHECKPOINT_FIELDS, process_registry
+
+
+@pytest.fixture(autouse=True)
+def _plain_spawn(monkeypatch):
+    import tools.process_registry as _pr
+    monkeypatch.setattr(_pr, "_SYSTEMD_SCOPE_AVAILABLE", False)
+
+
+def _run(sid, *, handoff=False):
+    parent = types.SimpleNamespace(session_id="sess-keep", _current_task_id="parent-turn-1")
+    child = types.SimpleNamespace(_process_owner_task_ids={sid}, _delegate_restart_handoff=handoff)
+    return types.SimpleNamespace(child=child, parent_agent=parent, child_task_id=sid, subagent_id=sid)
+
+
+def _keep(monkeypatch, on):
+    monkeypatch.setattr(delegate_config, "_get_keep_child_processes", lambda: on)
+
+
+def test_kept_process_outlives_child_and_parent_cleanup_until_session_delete(monkeypatch):
+    _keep(monkeypatch, True)
+    sid = "sa-0-keep01"
+    proc = process_registry.spawn_local("sleep 30", task_id=sid, owner_task_id=sid)
+    try:
+        kept = _ChildRun.keep_background_processes(_run(sid))
+        assert [k["session_id"] for k in kept] == [proc.id]
+        assert proc.owner_task_id == "parent-turn-1" and proc.session_key == "sess-keep"
+        assert proc.persist_on_release and proc.kept_from_child
+
+        process_registry.kill_all(sid, source="agent_close")
+        process_registry.kill_all("parent-turn-1", source="agent_close")
+        assert process_registry.poll(proc.id)["status"] == "running"
+
+        _reap_kept_processes("sess-other", {"deleted_ids": ["sess-other-2"]})
+        assert process_registry.poll(proc.id)["status"] == "running"
+        _reap_kept_processes("local-chat", {"deleted_ids": ["sess-keep"]})
+        deadline = time.time() + 10
+        while not proc.exited and time.time() < deadline:
+            time.sleep(0.05)
+        assert proc.exited
+    finally:
+        process_registry.kill_process(proc.id, source="test")
+
+
+def test_off_by_default_leaves_the_child_owner(monkeypatch):
+    _keep(monkeypatch, False)
+    sid = "sa-0-keep02"
+    proc = process_registry.spawn_local("sleep 30", task_id=sid, owner_task_id=sid)
+    try:
+        assert _ChildRun.keep_background_processes(_run(sid)) == []
+        assert proc.owner_task_id == sid and not proc.persist_on_release
+        process_registry.kill_all(sid, source="agent_close")
+        deadline = time.time() + 10
+        while not proc.exited and time.time() < deadline:
+            time.sleep(0.05)
+        assert proc.exited
+    finally:
+        process_registry.kill_process(proc.id, source="test")
+
+
+def test_restart_handoff_child_keeps_its_processes(monkeypatch):
+    _keep(monkeypatch, True)
+    sid = "sa-0-keep03"
+    proc = process_registry.spawn_local("sleep 30", task_id=sid, owner_task_id=sid)
+    try:
+        assert _ChildRun.keep_background_processes(_run(sid, handoff=True)) == []
+        assert proc.owner_task_id == sid
+    finally:
+        process_registry.kill_process(proc.id, source="test")
+
+
+def test_kept_state_is_checkpointed():
+    assert {"kept_from_child", "handoff_note", "persist_on_release"} <= set(_CHECKPOINT_FIELDS)
+
+
+def test_default_config_is_off():
+    from hermes_cli.config_defaults import DEFAULT_CONFIG
+    assert DEFAULT_CONFIG["delegation"]["keep_child_processes"] is False
