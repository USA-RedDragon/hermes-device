+    def keep_for_parent(self, session_id: str, *, from_owner: str, to_owner: str, to_task_id: str,
+                        to_session_key: str, note: str) -> Optional[ProcessSession]:
+        """``transfer_ownership`` for a process its subagent left running at the end (``delegation.keep_child_processes``):
+        it also leaves agent-lifecycle cleanup, as ``persist_on_release`` does, so the parent's own teardown keeps it
+        too. An explicit kill or ``reap_kept`` (deleting the parent's session) stops it."""
+        session = self.transfer_ownership(session_id, from_owner=from_owner, to_owner=to_owner, to_task_id=to_task_id,
+                                          to_session_key=to_session_key, note=note)
+        if session is None:
+            return None
+        with self._lock:
+            session.persist_on_release = True
+            session.kept_from_child = True
+        self._write_checkpoint()
+        return session
+
+    def reap_kept(self, session_keys) -> int:
+        """Kill the running processes kept from subagents for any of ``session_keys`` (a deleted session's ids).
+        Returns how many it stopped."""
+        keys = {str(k) for k in session_keys if k}
+        with self._lock:
+            targets = [s.id for s in self._running.values()
+                       if s.kept_from_child and not s.exited and not s.handed_off and s.session_key in keys]
+        results = [self.kill_process(sid, source="session.delete", consume_output=True) for sid in targets]
+        return sum(r.get("status") in {"killed", "already_exited"} for r in results)
+
