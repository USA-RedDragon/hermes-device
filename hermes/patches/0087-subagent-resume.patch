+def test_running_child_cannot_be_resumed(seams):
+    db = _db()
+    _finished_child(db)
+    with _active_subagents_lock:
+        _active_subagents[SID] = {"subagent_id": SID, "status": "running", "agent": _fake_child()}
+    seams()  # building anything would raise
+    result = _call(_Parent(db), subagent_id=SID, message="more")
+    assert "still running" in result["error"] and "steer" in result["error"]
+    assert _completions() == []
+
+
+def test_unfinished_child_without_an_end_record_cannot_be_resumed(seams):
+    db = _db()
+    record = _record()
+    del record[handoff.RESUME_STATE_KEY]
+    _finished_child(db, record=record, ended=False)
+    seams()
+    assert "no finished-run record" in _call(_Parent(db), subagent_id=SID, message="more")["error"]
+
+
+def test_child_of_another_chat_cannot_be_resumed(seams):
+    db = _db()
+    _finished_child(db)
+    db.create_session(session_id=OTHER_CHAT, source="telegram")
+    seams()
+    result = _call(_Parent(db, OTHER_CHAT), subagent_id=SID, message="steal it")
+    assert "spawn tree" in result["error"] and "cannot be resumed" in result["error"]
+    assert _completions() == []
+    assert db.get_session(CHILD)["ended_at"] is not None  # untouched
+
+
+def test_resume_needs_a_message_and_a_top_level_caller(seams):
+    db = _db()
+    _finished_child(db)
+    seams()
+    assert "non-empty 'message'" in _call(_Parent(db), subagent_id=SID, message="  ")["error"]
+    nested = _Parent(db)
+    nested._delegate_depth = 1
+    assert "nested" in _call(nested, subagent_id=SID, message="go")["error"]
+
+
+def test_resume_at_the_chat_cap_queues_and_runs_when_a_slot_frees(seams, monkeypatch):
+    monkeypatch.setattr("tools.delegate_tool._get_max_async_children", lambda: 1)
+    db = _db()
+    _finished_child(db)
+    release, occupied = threading.Event(), threading.Event()
+
+    def occupy():
+        occupied.set()
+        release.wait(10)
+        return {"status": "completed", "summary": "slot released"}
+
+    assert ad.dispatch_async_delegation(
+        goal="occupy", context=None, toolsets=None, role="leaf", model="m", session_key=PARENT,
+        parent_session_id=PARENT, runner=occupy, max_async_children=1)["status"] == "dispatched"
+    assert occupied.wait(5)
+
+    child = _fake_child()
+    seams(child)
+    handle = _call(_Parent(db), subagent_id=SID, message="queue me")
+    assert handle["status"] == "queued" and handle["queue_position"] == 1 and handle["queued_by"] == "chat"
+    time.sleep(0.3)
+    assert child.conversations == []  # nothing runs while the chat is at its cap
+    assert [r["status"] for r in ad.list_async_delegations() if r["delegation_id"] == handle["run_id"]] == ["queued"]
+
+    release.set()
+    events = wait_until(lambda: _completions(handle["run_id"]), what="the queued resume's completion")
+    assert events[0]["status"] == "completed" and child.conversations[0]["user_message"] == "queue me"
+
