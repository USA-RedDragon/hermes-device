+def test_dispatch_stamps_each_child_with_a_resume_record(monkeypatch):
+    route = SimpleNamespace(backend="default", label=None, profile_home=None, routing_cfg={"model": "qwen"})
+    child = SimpleNamespace(_delegate_task_route=route, _subagent_id=SID, session_id=CHILD, _session_init_model_config={},
+                            max_iterations=30)
+    unit = SimpleNamespace(parent_agent=SimpleNamespace(), children=[(0, {"goal": "g", "images": ["x"]}, child)],
+                           top_role="leaf", max_children=3, task_list=[{"goal": "g"}], live_deleg_id="deleg_call",
+                           group=None)
+    monkeypatch.setattr(handoff, "_parent_snapshot", lambda parent: {"session_id": PARENT})
+    monkeypatch.setattr(handoff, "_session_snapshot", lambda parent: {})
+    monkeypatch.setattr("tools.delegate_tool_config._get_worktree_isolation", lambda: False)
+    handoff.stamp_resume_specs(unit, "deleg_call")
+    stamped = child._session_init_model_config[handoff.RESUME_KEY]
+    assert set(stamped["children"]) == {"0"} and stamped["children"]["0"]["subagent_id"] == SID
+    assert stamped["children"]["0"]["images"] is None and stamped["live_deleg_id"] == "deleg_call"
+    json.dumps(stamped)  # it goes into the session row
+
+    monkeypatch.setattr("tools.delegate_tool_config._get_worktree_isolation", lambda: True)
+    isolated = SimpleNamespace(_delegate_task_route=route, _session_init_model_config={})
+    handoff.stamp_resume_specs(SimpleNamespace(**{**vars(unit), "children": [(0, {"goal": "g"}, isolated)]}), None)
+    assert isolated._session_init_model_config == {}  # an isolated worktree is gone when the child stops
+
