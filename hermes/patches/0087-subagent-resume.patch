diff --git a/tools/delegate_tool_resume.py b/tools/delegate_tool_resume.py
new file mode 100644
index 00000000..632d4ee1
--- /dev/null
+++ b/tools/delegate_tool_resume.py
@@ -0,0 +1,170 @@
+"""``delegate_task(action='resume')``: a second round of work for a finished background subagent.
+
+The child is rebuilt from its stored transcript the way a restart handoff rebuilds one (``tools/delegate_tool_handoff.py``):
+the same goal, route and model, toolsets, working directory and device binding, its original start time and its tool
+count carried on. The parent's message is appended as the next user turn, and the child runs as a new background unit
+with the usual live transcript and result re-entry (the completion reads "Subagent resumed and finished"). The unit
+counts toward the chat's cap and queues behind it like any other (``delegation.at_capacity``).
+
+Scope is the caller's own spawn tree, as for ``action='transcript'``: the child's stored session must descend from this
+conversation. A child that is still running (or queued) is steered, not resumed. The record that lets a child be rebuilt
+is stamped on its session at dispatch and finished at its end (``delegate_tool_handoff.RESUME_KEY``); a child without it
+(spawned before this existed, or under worktree isolation) cannot be resumed.
+"""
+
+from __future__ import annotations
+
+import json
+import threading
+import time
+from typing import Any, Optional
+
+_resuming: set[str] = set()
+_resuming_lock = threading.Lock()
+
+
+def _model_config(row: dict[str, Any]) -> dict[str, Any]:
+    raw = row.get("model_config")
+    if isinstance(raw, str):
+        try:
+            raw = json.loads(raw)
+        except ValueError:
+            return {}
+    return raw if isinstance(raw, dict) else {}
+
+
+def _find_subagent(parent_agent: Any, subagent_id: Optional[str], delegation_id: Optional[str],
+                   task_index: Any) -> tuple[str, Optional[str]]:
+    """``(subagent_id, error)``: the id as given, or the one the delegation's task ran as."""
+    from tools.delegate_tool_transcript import _int, _manifest, _owned_records
+    sid, deleg = (subagent_id or "").strip(), (delegation_id or "").strip()
+    if sid:
+        return sid, None
+    if not deleg:
+        return "", ("action='resume' requires subagent_id (from the spawn response or action='list'), or "
+                    "delegation_id with task_index.")
+    index = _int(task_index, 0, 0, 1 << 20)
+    if index is None:
+        return "", "task_index must be an integer."
+    from tools.delegate_tool import _parent_live_home
+    owned = [r for r in _owned_records(parent_agent)
+             if getattr(r.get("agent"), "_delegation_id", None) == deleg
+             and getattr(r.get("agent"), "_delegation_task_index", None) == index]
+    task = next((t for t in (_manifest(deleg, _parent_live_home(parent_agent)) or {}).get("tasks", [])
+                 if t.get("index") == index), None)
+    sid = (owned[0].get("subagent_id") if len(owned) == 1 else None) or (task or {}).get("subagent_id") or ""
+    if not sid:
+        return "", f"No subagent for delegation '{deleg}' task {index} in this conversation's spawn tree."
+    return sid, None
+
+
+def _is_live(subagent_id: str) -> bool:
+    from tools.delegate_tool_registry import _active_subagents, _active_subagents_lock
+    with _active_subagents_lock:
+        return subagent_id in _active_subagents
+
+
+def resume_subagent(parent_agent: Any, *, subagent_id: Optional[str], delegation_id: Optional[str],
+                    task_index: Any, message: Optional[str]) -> dict[str, Any]:
+    """The dispatch handle of the resumed run, or ``{"error": ...}``. Nothing is changed when it refuses."""
+    from tools.delegate_tool_handoff import RESUME_KEY, RESUME_STATE_KEY
+    from tools.delegate_tool_sessions import stored_child_session
+    from tools.delegate_tool_transcript import _compression_lineage
+    if getattr(parent_agent, "_delegate_depth", 0) > 0:
+        return {"error": "action='resume' is for the conversation that spawned the subagent, not for a nested one."}
+    text = (message or "").strip()
+    if not text:
+        return {"error": "action='resume' requires a non-empty 'message': what the subagent should do next."}
+    sid, error = _find_subagent(parent_agent, subagent_id, delegation_id, task_index)
+    if error:
+        return {"error": error}
+    db = getattr(parent_agent, "_session_db", None)
+    parent_sid = str(getattr(parent_agent, "session_id", "") or "")
+    session_id = None
+    if db is not None and parent_sid:
+        try:
+            session_id = stored_child_session(db, sid, _compression_lineage(db, parent_sid))
+        except Exception:
+            session_id = None
+    if not session_id:
+        return {"error": f"No subagent '{sid}' in this conversation's spawn tree (or its stored session is gone), so "
+                         "it cannot be resumed. Spawn a new subagent and brief it from its branch and notes."}
+    if _is_live(sid):
+        return {"error": f"Subagent '{sid}' is still running (or queued). Use action='steer' to redirect it; "
+                         "its result arrives as a normal completion message. Only a finished subagent can be resumed."}
+    config = _model_config(db.get_session(session_id) or {})
+    spec, state = config.get(RESUME_KEY), config.get(RESUME_STATE_KEY)
+    if not isinstance(spec, dict) or not isinstance(state, dict):
+        return {"error": f"Subagent '{sid}' has no finished-run record to resume from (it was spawned before resume "
+                         "existed, ran under worktree isolation, or has not finished). Spawn a new subagent and brief "
+                         "it from its branch and notes."}
+    with _resuming_lock:
+        if sid in _resuming:
+            return {"error": f"Subagent '{sid}' is already being resumed."}
+        _resuming.add(sid)
+    try:
+        return _dispatch(parent_agent, sid, session_id, spec, state, text)
+    finally:
+        with _resuming_lock:
+            _resuming.discard(sid)
+
+
+def _dispatch(parent_agent: Any, sid: str, session_id: str, spec: dict[str, Any], state: dict[str, Any],
+              text: str) -> dict[str, Any]:
+    from tools.async_delegation import _new_delegation_id, dispatch_async_delegation_batch
+    from tools.delegate_tool import _get_max_async_children, is_spawn_paused
+    from tools.delegate_tool_config import _get_max_concurrent_children_total, _get_queue_at_capacity, _get_restart_handoff
+    from tools.delegate_tool_dispatch import _capture_origin, _resolve_async_session_key, _resolve_async_wake_sid
+    from tools.delegate_tool_handoff import _ResumedUnit
+    if is_spawn_paused():
+        return {"error": "Delegation spawning is paused. Clear the pause before resuming a subagent."}
+    entries = spec.get("children") or {}
+    index_key, child = next(iter(entries.items()), (None, None))
+    if child is None or child.get("subagent_id") != sid:
+        return {"error": f"The resume record of '{sid}' is unreadable."}
+    index = int(index_key)
+    origin_wake_sid, origin_ui, _transport, _record, history_delivery = _capture_origin()
+    wake_sid = _resolve_async_wake_sid(origin_wake_sid, history_delivery,
+                                       oneshot_session=getattr(parent_agent, "_oneshot_session", None) is True)
+    if wake_sid is None:
+        return {"error": "This session cannot receive a background result, so a subagent cannot be resumed here."}
+    session_key, origin_ui = _resolve_async_session_key(parent_agent, origin_ui)
+    count = max(int(spec.get("task_count") or 1), index + 1)
+    goals = [""] * count
+    goals[index] = child.get("goal") or ""
+    # The record a restart handoff would rebuild the child from, moved to where the child ended.
+    resume_child = {**child, **{k: v for k, v in state.items() if v is not None}, "session_id": session_id}
+    unit_id = _new_delegation_id()
+    record = {**spec, "children": {index_key: resume_child}, "task_count": count, "resumed": True,
+              "slot_key": unit_id}
+    resumed = _ResumedUnit({
+        "delegation_id": unit_id, "handoff": record, "kept": {}, "goals": goals, "task_indexes": [index],
+        "parent_session_id": str(getattr(parent_agent, "session_id", "") or ""), "origin_ui_session_id": origin_ui,
+        "dispatched_at": time.time()}, message=text)
+    handoff = record if _get_restart_handoff() else None
+    routing: dict[str, Any] = dict(
+        session_key=session_key, origin_ui_session_id=origin_ui, origin_session_id=wake_sid,
+        parent_session_id=getattr(parent_agent, "session_id", None), max_async_children=_get_max_async_children())
+    queue = _get_queue_at_capacity()
+    if queue:
+        routing["max_total"] = _get_max_concurrent_children_total()
+    handle = dispatch_async_delegation_batch(
+        goals=goals, context=child.get("context"), toolsets=None, role=spec.get("top_role") or "leaf", model=None,
+        runner=resumed.run, interrupt_fn=resumed.interrupt, progress_fn=resumed.progress, delegation_id=unit_id,
+        task_indexes=[index], handoff=handoff, handoff_fn=resumed.hand_off if handoff else None,
+        queue_at_capacity=queue, task_transcripts=({str(index): child["transcript"]} if child.get("transcript") else None),
+        **routing)
+    if handle.get("status") not in ("dispatched", "queued"):
+        return {"error": handle.get("error") or "The subagent could not be resumed."}
+    payload = {
+        "action": "resume", "status": handle["status"], "mode": "background", "subagent_id": sid,
+        "delegation_id": spec.get("live_deleg_id") or unit_id, "run_id": unit_id, "task_index": index,
+        "note": ("The subagent continues its conversation with your message as the next turn, in the background; its "
+                 "result re-enters the conversation as a new message ('Subagent resumed and finished'). Results are "
+                 "delivered only after you END YOUR TURN: do anything that does not depend on it, then stop with a "
+                 "one-line status. Do not poll its transcript to wait for it.")}
+    if handle["status"] == "queued":
+        payload.update(queue_position=handle.get("queue_position"), queued_by=handle.get("queued_by"))
+        payload["note"] = ("Nothing is blocked: the chat is at its background limit, so this resume is QUEUED and "
+                           "starts on its own when a run finishes (first in, first out). " + payload["note"])
+    return payload
