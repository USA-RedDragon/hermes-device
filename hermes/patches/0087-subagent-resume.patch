+"""delegate_task(action='resume'): a finished background subagent gets a second round of work with its full context.
+
+The child is rebuilt from its stored transcript the way a restart handoff rebuilds one, so the stored sessions are real
+(``state.db``) and the child agents and the runtime route are fakes. The registry lifetimes are the real ones.
+"""
+
+import json
+import queue
+import threading
+import time
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+
+from tests.waiting import wait_until
+from tools import async_delegation as ad
+from tools import delegate_tool_handoff as handoff
+from tools.delegate_tool import delegate_task
+from tools.delegate_tool_registry import _active_subagents, _active_subagents_lock
+from tools.process_registry import process_registry
+
+PARENT = "parent-sid"
+OTHER_CHAT = "other-chat-sid"
+SID = "sa-0-abcd"
+CHILD = "child-0"
+BASE_URL = "http://ollama.example.com/v1"
+
+
+@pytest.fixture(autouse=True)
+def _clean_state():
+    ad._reset_for_tests()
+    _drain()
+    yield
+    ad._reset_for_tests()
+    _drain()
+    with _active_subagents_lock:
+        _active_subagents.clear()
+
+
+def _drain() -> list:
+    items = []
+    while True:
+        try:
+            items.append(process_registry.completion_queue.get_nowait())
+        except queue.Empty:
+            return items
+
+
+def _completions(delegation_id=None) -> list:
+    return [e for e in _drain() if isinstance(e, dict) and e.get("type") == "async_delegation"
+            and (delegation_id is None or e.get("delegation_id") == delegation_id)]
+
+
+def _db():
+    from hermes_state_registry import acquire
+    return acquire()
+
+
+class _Parent:
+    def __init__(self, db, session_id=PARENT):
+        self._session_db, self.session_id, self._delegate_depth = db, session_id, 0
+
+
+def _record(*, started_at=None, tool_count=None) -> dict:
+    """The resume record dispatch stamps on a child's session, and the state its finish adds."""
+    child = {"goal": "fix the parser", "context": "repo at ~/src", "role": None, "subagent_id": SID,
+             "session_id": CHILD, "transcript": None,
+             "route": {"backend": "model_map", "label": "quick", "route": {"base_url": BASE_URL, "model": "qwen"}}}
+    spec = {"version": 1, "parent": {"session_id": PARENT, "model": "main", "provider": "custom", "base_url": BASE_URL},
+            "session": {}, "children": {"0": child}, "task_count": 1, "live_deleg_id": "deleg_call", "top_role": "leaf",
+            "max_children": 3}
+    state = {"session_id": CHILD, "cwd": "/work/parser", "started_at": started_at or time.time() - 900,
+             "tool_count": 5 if tool_count is None else tool_count}
+    return {handoff.RESUME_KEY: spec, handoff.RESUME_STATE_KEY: state}
+
+
+def _finished_child(db, *, parent=PARENT, record=True, ended=True):
+    db.create_session(session_id=parent, source="telegram")
+    config = {"_delegate_from": parent, "_subagent_id": SID, **(_record() if record is True else record or {})}
+    db.create_session(session_id=CHILD, source="subagent", parent_session_id=parent, model_config=config)
+    db.append_message(CHILD, "user", content="fix the parser")
+    calls = [{"id": "call_a", "type": "function", "function": {"name": "read_file", "arguments": "{}"}}]
+    db.append_message(CHILD, "assistant", content="", tool_calls=calls)
+    db.append_message(CHILD, "tool", content="def parse(): ...", tool_name="read_file", tool_call_id="call_a")
+    db.append_message(CHILD, "assistant", content="Fixed the parser; tests pass.")
+    if ended:
+        db.end_session(CHILD, "agent_close")
+
+
+def _call(parent, **kw) -> dict:
+    raw = delegate_task(action="resume", parent_agent=parent, **kw)
+    return json.loads(raw)
+
+
+def _fake_child(stop=None, started=None):
+    """A child agent whose conversation answers at once, or blocks until ``stop`` is set (a stop signal sets it)."""
+    child = MagicMock()
+    for name, value in (("_delegate_restart_handoff", False), ("_delegate_live_writer", None),
+                        ("_live_transcript_path", None), ("_delegate_output_schema", None), ("_delegate_images", []),
+                        ("_credential_pool", None), ("_subagent_id", SID), ("session_id", CHILD), ("model", "qwen"),
+                        ("_delegate_depth", 1), ("_parent_session_id", PARENT)):
+        setattr(child, name, value)
+    child.get_activity_summary.return_value = {"current_tool": None}
+    calls = []
+
+    def converse(**kwargs):
+        calls.append(kwargs)
+        if started is not None:
+            started.set()
+        if stop is not None:
+            stop.wait(10)
+            if child._delegate_restart_handoff:
+                return {"final_response": "", "completed": False, "interrupted": True, "api_calls": 1, "messages": []}
+        return {"final_response": "Second round done.", "completed": True, "interrupted": False, "api_calls": 2,
+                "messages": []}
+
+    child.run_conversation.side_effect = converse
+    if stop is not None:
+        child.interrupt.side_effect = lambda *a, **k: stop.set()
+    child.conversations = calls
+    return child
+
+
+@pytest.fixture
+def seams(monkeypatch):
+    """The runtime pieces a rebuild reaches outside the stored session; the recorded route is never asked again."""
+    built = []
+    monkeypatch.setattr("tools.delegate_tool._load_config", lambda: {"restart_handoff": True})
+    monkeypatch.setattr("tools.delegate_tool._resolve_delegation_credentials", lambda route, parent: {
+        "model": route.get("model"), "provider": None, "base_url": route.get("base_url"), "api_key": None,
+        "api_mode": None})
+    monkeypatch.setattr("hermes_cli.runtime_provider.resolve_runtime_provider",
+                        lambda **kw: {"base_url": BASE_URL, "api_key": "local"})
+    monkeypatch.setattr("tools.delegate_tool_dispatch._resolve_async_wake_sid", lambda *a, **k: "")
+    monkeypatch.setattr("tools.delegate_tool._get_max_async_children", lambda: 3)
+
+    def never(*args, **kwargs):
+        raise AssertionError("the recorded route must not be asked of the backend again")
+    monkeypatch.setattr("tools.delegate_tool_routes._route_one", never)
+
+    def use(*children):
+        pending = list(children)
+
+        def build(**kwargs):
+            built.append(kwargs)
+            child = pending.pop(0)
+            child._progress_identity_ref = {}
+            return child
+        monkeypatch.setattr("tools.delegate_tool._build_child_preserving_parent_tools", build)
+    use.built = built
+    return use
+
