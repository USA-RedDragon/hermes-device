+def test_restart_handoff_of_a_resumed_child_continues_it_on_the_next_gateway(seams):
+    db = _db()
+    _finished_child(db)
+    stop, started = threading.Event(), threading.Event()
+    first = _fake_child(stop=stop, started=started)
+    seams(first)
+    handle = _call(_Parent(db), subagent_id=SID, message="Round two, please.")
+    assert handle["status"] == "dispatched" and started.wait(5)
+    run_id = handle["run_id"]
+    original_start = first._delegate_started_at
+    assert first._delegate_tool_count == 5  # counted on from the first round, not from zero
+
+    # The old gateway stops the child at a clean point and leaves the unit for the next one.
+    first.get_activity_summary.return_value = {"current_tool": None}
+    assert ad.hand_off_for_restart(2.0, 8.0) == 1
+    assert _completions(run_id) == []  # nothing delivered by the old gateway
+    row = json.loads(_row_json(run_id))
+    spec = row["handoff"]
+    assert spec["resumed"] is True and spec["resume"] == [0]
+    assert spec["children"]["0"]["started_at"] == original_start and spec["children"]["0"]["tool_count"] == 5
+
+    # The next gateway rebuilds the child; it continues with the restart notice, not the parent's message again.
+    ad._reset_for_tests()
+    with _active_subagents_lock:
+        _active_subagents.clear()
+    second = _fake_child()
+    seams(second)
+    assert ad.adopt_handed_off_delegations(handoff._resume_unit) == 1
+    event = wait_until(lambda: _completions(run_id), what="the resumed unit's completion")[0]
+    assert event["status"] == "completed" and event["resumed"]["subagent_ids"] == [SID]
+    kwargs = second.conversations[0]
+    assert kwargs["user_message"] == handoff.RESUME_MESSAGE
+    assert kwargs["conversation_history"][0]["content"] == "fix the parser"
+    assert second._delegate_started_at == original_start and second._delegate_tool_count == 5
+    assert [r["summary"] for r in event["results"]] == ["Second round done."]
+
+
+def _row_json(delegation_id: str) -> str:
+    import sqlite3
+    from hermes_constants import get_hermes_home
+    conn = sqlite3.connect(get_hermes_home() / "state.db")
+    try:
+        return conn.execute("SELECT task_json FROM async_delegations WHERE delegation_id=?",
+                            (delegation_id,)).fetchone()[0]
+    finally:
+        conn.close()
+
