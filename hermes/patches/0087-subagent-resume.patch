+def test_finished_child_records_where_it_ended():
+    from tools.delegate_tool_child_run import _ChildRun
+    db = _db()
+    _finished_child(db, record={handoff.RESUME_KEY: _record()[handoff.RESUME_KEY]}, ended=False)
+    started = time.time() - 600
+    from tools.delegate_tool_child_run import _register_child
+    child = SimpleNamespace(
+        _subagent_id=SID, model="m", _delegate_depth=1, _parent_session_id=PARENT, session_id=CHILD, _session_db=db,
+        _session_init_model_config={handoff.RESUME_KEY: {}}, _delegate_started_at=started, _delegate_tool_count=3,
+        close=lambda: None, _delegate_restart_handoff=False)
+    _register_child(child, SimpleNamespace(session_id=PARENT), "goal", owner_session_id=None, owner_transport=None,
+                    owner_session_record=None)
+    with _active_subagents_lock:
+        _active_subagents[SID].update(tool_count=9)
+    from tools.terminal_tool import record_session_cwd
+    record_session_cwd(SID, "/work/end")
+    run = _ChildRun(child, SimpleNamespace(), 0, "goal", SID, None)
+    run.cleanup(heartbeat=SimpleNamespace(stop=lambda: None), child_pool=None, leased_cred_id=None, close_deferred=False)
+    config = json.loads(db.get_session(CHILD)["model_config"])
+    state = config[handoff.RESUME_STATE_KEY]
+    assert state["cwd"] == "/work/end" and state["tool_count"] == 9 and state["started_at"] == started
+    assert state["session_id"] == CHILD
+
