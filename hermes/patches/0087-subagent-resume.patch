+def test_resumed_child_continues_with_its_prior_messages_and_the_new_message(seams):
+    db = _db()
+    _finished_child(db)
+    child = _fake_child()
+    seams(child)
+    handle = _call(_Parent(db), subagent_id=SID, message="Now fix the lexer too.")
+    assert handle["status"] == "dispatched" and handle["subagent_id"] == SID and handle["mode"] == "background"
+    assert handle["delegation_id"] == "deleg_call" and handle["task_index"] == 0
+
+    event = wait_until(lambda: _completions(handle["run_id"]), what="the resumed child's completion")[0]
+    kwargs = child.conversations[0]
+    assert kwargs["user_message"] == "Now fix the lexer too."
+    history = kwargs["conversation_history"]
+    assert [m["role"] for m in history] == ["user", "assistant", "tool", "assistant"]
+    assert history[0]["content"] == "fix the parser" and history[2]["content"] == "def parse(): ..."
+    assert history[-1]["content"] == "Fixed the parser; tests pass."
+
+    # Rebuilt as the same child: its own session and id, on its recorded route, in the directory it ended in.
+    built = seams.built[0]
+    assert built["resume_session_id"] == CHILD and built["subagent_id"] == SID and built["goal"] == "fix the parser"
+    assert built["model"] == "qwen" and built["override_base_url"] == BASE_URL
+    assert child._delegate_resume["cwd"] == "/work/parser"
+    assert child._delegation_id == "deleg_call"
+    assert db.get_session(CHILD)["ended_at"] is None  # reopened for the new turn
+
+    assert event["status"] == "completed" and event["resumed"]["subagent_ids"] == [SID]
+    from tools.process_registry_notifications import _format_async_delegation, async_delegation_display_text
+    text = _format_async_delegation(event)
+    assert text.startswith("[ASYNC DELEGATION BATCH COMPLETE")
+    assert "Subagent resumed and finished: fix the parser" in text and "Second round done." in text
+    assert async_delegation_display_text(event).startswith("Subagent Task Completed (resumed)")
+
+
+def test_resume_by_delegation_id_and_task_index(seams, tmp_path, monkeypatch):
+    db = _db()
+    _finished_child(db)
+    manifest = {"owner_session_id": PARENT, "tasks": [{"index": 0, "subagent_id": SID}]}
+    monkeypatch.setattr("tools.delegate_tool_transcript._manifest", lambda deleg, home: manifest)
+    seams(_fake_child())
+    handle = _call(_Parent(db), delegation_id="deleg_call", task_index=0, message="again")
+    assert handle["status"] == "dispatched" and handle["subagent_id"] == SID
+    # The run is real background work: let it finish, or it still holds the subagent id when the next test starts.
+    wait_until(lambda: _completions(handle["run_id"]), what="the resumed child's completion")
+
