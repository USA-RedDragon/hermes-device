+def system_prompt_section_ceiling(floor: int = MAX_SYSTEM_PROMPT_SECTION_CHARS) -> int:
+    """Largest ``max_chars`` one plugin section may ask for: ``plugins.max_section_chars`` (it can only
+    raise the default ``floor``, 4,000; a non-integer or smaller value is ignored)."""
+    try:
+        from hermes_cli.config import load_config_readonly
+        plugins_cfg = (load_config_readonly() or {}).get("plugins")
+        value = plugins_cfg.get("max_section_chars") if isinstance(plugins_cfg, dict) else None
+    except Exception:
+        value = None
+    if isinstance(value, int) and not isinstance(value, bool) and value > floor:
+        return min(value, _SECTION_CEILING_HARD_MAX)
+    return floor
