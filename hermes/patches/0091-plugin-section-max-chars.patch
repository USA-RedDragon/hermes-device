diff --git a/tests/hermes_cli/test_plugin_section_cap.py b/tests/hermes_cli/test_plugin_section_cap.py
new file mode 100644
index 00000000..1db41ee9
--- /dev/null
+++ b/tests/hermes_cli/test_plugin_section_cap.py
@@ -0,0 +1,70 @@
+"""plugins.max_section_chars lifts the cap on one plugin system prompt section (default 4,000)."""
+from __future__ import annotations
+
+import pytest
+
+import hermes_cli.plugins_dispatch as dispatch
+from agent.system_prompt import _restore_plugin_prompt_sections
+from hermes_cli.plugins import PluginContext, PluginManager, PluginManifest, format_system_prompt_sections
+
+
+def _config(monkeypatch, plugins):
+    monkeypatch.setattr("hermes_cli.config.load_config_readonly", lambda *a, **k: {"plugins": plugins})
+
+
+def _ctx(manager, name="notes"):
+    return PluginContext(PluginManifest(name=name, key=name, source="user"), manager)
+
+
+def test_default_ceiling_is_unchanged(monkeypatch):
+    _config(monkeypatch, {})
+    assert dispatch.system_prompt_section_ceiling() == 4_000
+    with pytest.raises(ValueError, match="between 1 and 4000"):
+        _ctx(PluginManager()).register_system_prompt_section("notes.big", "x", max_chars=8_600)
+
+
+@pytest.mark.parametrize("bad", [0, -5, 100, True, "9000", None, 1.5])
+def test_bad_or_lower_values_keep_the_default(monkeypatch, bad):
+    _config(monkeypatch, {"max_section_chars": bad})
+    assert dispatch.system_prompt_section_ceiling() == 4_000
+
+
+def test_a_larger_ceiling_lets_a_section_carry_8000_chars_of_notes(monkeypatch):
+    _config(monkeypatch, {"max_section_chars": 12_000})
+    manager = PluginManager()
+    text = "n" * 8_600  # 8,000 chars of notes plus the header
+    _ctx(manager).register_system_prompt_section("notes.big", text, max_chars=9_000)
+    rendered = manager.render_system_prompt_sections({"session_id": "s"})
+    assert [item.content for item in rendered] == [text]
+
+
+def test_ceiling_is_also_an_upper_bound(monkeypatch):
+    _config(monkeypatch, {"max_section_chars": 12_000})
+    with pytest.raises(ValueError, match="between 1 and 12000"):
+        _ctx(PluginManager()).register_system_prompt_section("notes.big", "x", max_chars=12_001)
+
+
+def test_other_sections_keep_their_own_max_chars(monkeypatch):
+    _config(monkeypatch, {"max_section_chars": 12_000})
+    manager = PluginManager()
+    _ctx(manager).register_system_prompt_section("notes.small", "y" * 4_500)  # default max_chars 4,000
+    assert manager.render_system_prompt_sections({"session_id": "s"}) == []
+
+
+def test_aggregate_budget_grows_with_the_ceiling(monkeypatch):
+    _config(monkeypatch, {})
+    assert dispatch.system_prompt_sections_total_budget() == 8_000
+    _config(monkeypatch, {"max_section_chars": 12_000})
+    assert dispatch.system_prompt_sections_total_budget() == 16_000
+
+
+def test_a_persisted_long_section_is_restored(monkeypatch):
+    _config(monkeypatch, {"max_section_chars": 12_000})
+    manager = PluginManager()
+    text = "n" * 8_600
+    _ctx(manager).register_system_prompt_section("notes.big", text, max_chars=9_000)
+    block = format_system_prompt_sections(manager.render_system_prompt_sections({"session_id": "s"}))
+    restored = _restore_plugin_prompt_sections(f"intro\n{block}\n\nConversation started: now")
+    assert [item.content for item in restored] == [text]
+    _config(monkeypatch, {})
+    assert _restore_plugin_prompt_sections(f"intro\n{block}\n\nConversation started: now") == ()
