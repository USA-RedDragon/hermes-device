diff --git a/gateway/run_bootstrap.py b/gateway/run_bootstrap.py
index bfdca3a81a..8b41594075 100644
--- a/gateway/run_bootstrap.py
+++ b/gateway/run_bootstrap.py
@@ -622,6 +622,109 @@ def _reserve_waiting_out_browse_reconcile(ownership, homes, *, wait_s: float | N
     return reserve_waiting_out_transient_holders(ownership, homes, wait_s=wait_s)
 
 
+RUNTIME_LOCK_POLL_S = 0.2
+# Present while a warmed-up standby waits for the profile lock, so a supervisor can stop the owner
+# only once its successor is ready to take over (for example a Kubernetes preStop hook).
+STANDBY_MARKER = "gateway.standby"
+_RUNTIME_LOCK_PREWARM_MODULES = (
+    "gateway.run_runtime", "gateway.run_startup", "gateway.run_api", "gateway.run_adapters",
+    "gateway.session_authorities", "run_agent", "model_tools", "tui_gateway.server",
+)
+
+
+def _prewarm_before_runtime_lock() -> None:
+    """Imports and plugin discovery that the boot after the lock runs anyway, done while another
+    gateway still owns the profile so the takeover after it exits is short. Opens no profile store."""
+    import importlib
+    for name in _RUNTIME_LOCK_PREWARM_MODULES:
+        try:
+            importlib.import_module(name)
+        except Exception:
+            logger.debug("Prewarm import of %s failed", name, exc_info=True)
+    try:
+        from hermes_cli.plugins import discover_plugins
+        discover_plugins()
+    except Exception:
+        logger.debug("Prewarm plugin discovery failed", exc_info=True)
+
+
+def _host_lock_held_by_predecessor(home) -> bool:
+    """True while another process holds the host gateway lock for this same home: the gateway this
+    standby replaces, between releasing ``gateway.lock`` and exiting."""
+    from gateway import host_rendezvous as hr
+    from gateway.runtime_ownership import canonical_home
+    if hr.owns_host_lock(hr.ROLE_GATEWAY) or not hr.host_lock_is_held(hr.ROLE_GATEWAY):
+        return False
+    try:
+        record = hr.read_record(hr.ROLE_GATEWAY, include_stale=True)
+    except Exception:
+        record = None
+    return record is None or not record.home or canonical_home(Path(record.home)) == canonical_home(home)
+
+
+def _write_standby_marker(path) -> None:
+    from gateway.status import _build_pid_record
+    from utils import atomic_json_write
+    try:
+        atomic_json_write(path, {**_build_pid_record(), "since": time.time()}, indent=None)
+    except OSError:
+        logger.debug("Could not write %s", path, exc_info=True)
+
+
+def _remove_predecessor_pid_file() -> None:
+    """After a takeover the lock is ours, so a gateway.pid naming anyone else is stale: a predecessor
+    that died without removing it (SIGKILL at the end of its grace) would fail our O_EXCL claim."""
+    import os
+    from gateway.status import _get_pid_path, _pid_from_record, _read_pid_record
+    path = _get_pid_path()
+    record = _read_pid_record(path)
+    if record is not None and _pid_from_record(record) != os.getpid():
+        path.unlink(missing_ok=True)
+
+
+async def _start_gateway_wait_for_runtime_lock(profile_homes, wait_s: float) -> None:
+    """``gateway.runtime_lock_wait_seconds``: a standby gateway (the new pod of a rolling update on a
+    shared volume) warms up, then waits for the gateway that owns the profile to exit instead of
+    exiting 1, and takes over within one poll of it. When the wait runs out the boot goes on and
+    refuses exactly as it does without the wait."""
+    import asyncio
+    from gateway.run import get_hermes_home
+    from gateway.runtime_ownership import OwnershipConflict, process_ownership
+    from hermes_startup_watchdog import kick_startup_watchdog
+    launch_home = get_hermes_home()
+    homes = [launch_home, *(home for _, home in profile_homes)]
+    started = time.monotonic()
+    deadline = started + wait_s
+    _prewarm_before_runtime_lock()
+    marker = launch_home / STANDBY_MARKER
+    waited = False
+    try:
+        while True:
+            try:
+                process_ownership.reserve(homes)
+                break
+            except OwnershipConflict:
+                if time.monotonic() >= deadline:
+                    return
+            except OSError:
+                return
+            if not waited:
+                logger.info("Another gateway owns %s; waiting up to %.0fs for it to exit", launch_home, wait_s)
+                _write_standby_marker(marker)
+                waited = True
+            kick_startup_watchdog()  # an idle wait, not a stalled boot
+            await asyncio.sleep(RUNTIME_LOCK_POLL_S)
+        while _host_lock_held_by_predecessor(launch_home) and time.monotonic() < deadline:
+            waited = True
+            await asyncio.sleep(RUNTIME_LOCK_POLL_S / 4)
+    finally:
+        if waited:
+            marker.unlink(missing_ok=True)
+    if waited:
+        _remove_predecessor_pid_file()
+        logger.info("Took over %s after waiting %.1fs", launch_home, time.monotonic() - started)
+
+
 def _start_gateway_reserve_profiles(profile_homes) -> bool:
     """Reserve the launch home plus every served profile home; False when startup must abort."""
     from gateway.run import get_hermes_home
@@ -802,6 +905,9 @@ async def _start_gateway_runtime(config: Optional[GatewayConfig] = None, replace
         return False
 
     from gateway.status import remove_pid_file, release_gateway_runtime_lock
+    lock_wait_s = float(getattr(resolved_config, "runtime_lock_wait_seconds", 0) or 0)
+    if lock_wait_s > 0:
+        await _start_gateway_wait_for_runtime_lock(profile_homes, lock_wait_s)
     if not _start_gateway_reserve_profiles(profile_homes):
         return False
     # Freeze discovery: later profile additions must restart and reserve before opening stores.
