@@ -0,0 +1,185 @@
+"""gateway.runtime_lock_wait_seconds: a standby gateway waits for the profile owner to exit."""
+import asyncio
+import json
+import time
+
+import pytest
+
+from gateway import run_bootstrap, status
+from gateway.config import GatewayConfig, load_gateway_config
+from gateway.runtime_ownership import ProfileOwnership, process_ownership
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    home = tmp_path / "home"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr("gateway.run.get_hermes_home", lambda: home)
+    monkeypatch.setattr(run_bootstrap, "_prewarm_before_runtime_lock", lambda: None)
+    monkeypatch.setattr(run_bootstrap, "RUNTIME_LOCK_POLL_S", 0.02)
+    yield home
+    process_ownership.close()
+
+
+def test_default_keeps_exiting_on_a_held_lock():
+    assert GatewayConfig().runtime_lock_wait_seconds == 0
+    assert GatewayConfig.from_dict({}).runtime_lock_wait_seconds == 0
+
+
+@pytest.mark.parametrize("raw, expected", [(30, 30.0), ("45", 45.0), (-1, 0.0), ("bad", 0.0), (float("inf"), 0.0)])
+def test_from_dict_reads_the_nested_key(raw, expected):
+    config = GatewayConfig.from_dict({"gateway": {"runtime_lock_wait_seconds": raw}})
+    assert config.runtime_lock_wait_seconds == expected
+
+
+def test_config_yaml_key_reaches_the_runner_config(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    (tmp_path / "config.yaml").write_text("gateway:\n  runtime_lock_wait_seconds: 700\n", encoding="utf-8")
+    assert load_gateway_config().runtime_lock_wait_seconds == 700
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.asyncio
+async def test_standby_takes_the_lock_right_after_the_owner_lets_go(home, monkeypatch):
+    monkeypatch.setattr(run_bootstrap, "_host_lock_held_by_predecessor", lambda _home: False)
+    owner = ProfileOwnership()
+    owner.reserve([home])
+    waiter = asyncio.create_task(run_bootstrap._start_gateway_wait_for_runtime_lock([], 30))
+    await asyncio.sleep(0.3)
+    assert not waiter.done()
+    assert not process_ownership.owns(home)
+    assert json.loads((home / "gateway.standby").read_text())["pid"] > 0
+    released = time.monotonic()
+    owner.close()
+    await asyncio.wait_for(waiter, 5)
+    assert time.monotonic() - released < 1.0
+    assert process_ownership.owns(home)
+    assert not (home / "gateway.standby").exists()
+    assert json.loads((home / "gateway.lock").read_text())["pid"] > 0
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.asyncio
+async def test_wait_runs_out_without_taking_anything(home, monkeypatch):
+    monkeypatch.setattr(run_bootstrap, "_host_lock_held_by_predecessor", lambda _home: False)
+    owner = ProfileOwnership()
+    owner.reserve([home])
+    try:
+        started = time.monotonic()
+        await run_bootstrap._start_gateway_wait_for_runtime_lock([], 0.3)
+        assert 0.3 <= time.monotonic() - started < 2
+        assert not process_ownership.owns(home)
+        assert not (home / "gateway.standby").exists()
+        assert not run_bootstrap._start_gateway_reserve_profiles([])
+    finally:
+        owner.close()
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.asyncio
+async def test_free_profile_is_taken_without_waiting(home, monkeypatch):
+    monkeypatch.setattr(run_bootstrap, "_host_lock_held_by_predecessor", lambda _home: False)
+    started = time.monotonic()
+    await run_bootstrap._start_gateway_wait_for_runtime_lock([], 30)
+    assert time.monotonic() - started < 0.5
+    assert process_ownership.owns(home)
+    assert not (home / "gateway.standby").exists()
+    assert run_bootstrap._start_gateway_reserve_profiles([])
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.asyncio
+async def test_standby_also_waits_out_the_predecessor_host_lock(home, monkeypatch):
+    held = {"until": time.monotonic() + 0.3}
+    monkeypatch.setattr(run_bootstrap, "_host_lock_held_by_predecessor",
+                        lambda _home: time.monotonic() < held["until"])
+    started = time.monotonic()
+    await run_bootstrap._start_gateway_wait_for_runtime_lock([], 30)
+    assert time.monotonic() - started >= 0.3
+    assert process_ownership.owns(home)
+
+
+def test_prewarm_runs_before_the_wait(home, monkeypatch):
+    calls = []
+    monkeypatch.setattr(run_bootstrap, "_prewarm_before_runtime_lock", lambda: calls.append("prewarm"))
+    monkeypatch.setattr(run_bootstrap, "_host_lock_held_by_predecessor", lambda _home: False)
+    asyncio.run(run_bootstrap._start_gateway_wait_for_runtime_lock([], 1))
+    assert calls == ["prewarm"]
+
+
+def test_pid_record_carries_the_pid_namespace(monkeypatch):
+    monkeypatch.setattr("hermes_state_pidns.pid_namespace_id", lambda: "4026531836")
+    assert status._build_pid_record()["pidns"] == "4026531836"
+
+
+class TestOtherPidNamespaceHolder:
+    def _write(self, home, pidns):
+        record = {
+            "pid": 4242, "kind": "hermes-gateway", "start_time": 123,
+            "argv": ["python", "-m", "hermes_cli.main", "gateway", "run"],
+            "hermes_home": str(home.resolve()),
+        }
+        if pidns:
+            record["pidns"] = pidns
+        (home / "gateway.pid").write_text(json.dumps(record), encoding="utf-8")
+        (home / "gateway.lock").write_text(json.dumps(record), encoding="utf-8")
+
+    def _patch(self, monkeypatch):
+        monkeypatch.setattr(status, "is_gateway_runtime_lock_active", lambda _path=None: True)
+        monkeypatch.setattr(status, "_pid_exists", lambda _pid: False)
+        monkeypatch.setattr(status, "get_runtime_status_running_pid", lambda: None)
+        monkeypatch.setattr("hermes_state_pidns._LOCAL_PID_NS", None)
+        monkeypatch.setattr("hermes_state_pidns._resolve_local_pid_namespace",
+                            lambda: __import__("hermes_state_pidns").LocalPidNamespace("111", True))
+
+    def test_pid_file_of_a_holder_in_another_namespace_is_kept(self, tmp_path, monkeypatch):
+        monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+        self._write(tmp_path, "222")
+        self._patch(monkeypatch)
+        assert status.get_running_pid() is None
+        assert (tmp_path / "gateway.pid").exists()
+        assert (tmp_path / "gateway.lock").exists()
+
+    def test_unstamped_dead_holder_pid_file_is_still_cleaned(self, tmp_path, monkeypatch):
+        monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+        self._write(tmp_path, None)
+        self._patch(monkeypatch)
+        assert status.get_running_pid() is None
+        assert not (tmp_path / "gateway.pid").exists()
+        assert (tmp_path / "gateway.lock").exists()
+
+    def test_same_namespace_dead_holder_pid_file_is_still_cleaned(self, tmp_path, monkeypatch):
+        monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+        self._write(tmp_path, "111")
+        self._patch(monkeypatch)
+        assert status.get_running_pid() is None
+        assert not (tmp_path / "gateway.pid").exists()
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.asyncio
+async def test_takeover_removes_a_dead_predecessor_pid_file(home, monkeypatch):
+    monkeypatch.setattr(run_bootstrap, "_host_lock_held_by_predecessor", lambda _home: False)
+    owner = ProfileOwnership()
+    owner.reserve([home])
+    (home / "gateway.pid").write_text(json.dumps({"pid": 7, "kind": "hermes-gateway", "pidns": "1"}))
+    waiter = asyncio.create_task(run_bootstrap._start_gateway_wait_for_runtime_lock([], 30))
+    await asyncio.sleep(0.1)
+    owner.close()
+    await asyncio.wait_for(waiter, 5)
+    assert not (home / "gateway.pid").exists()
+
+
+@pytest.mark.asyncio
+async def test_wait_keeps_the_startup_watchdog_from_firing(home, monkeypatch):
+    kicks = []
+    monkeypatch.setattr("hermes_startup_watchdog.kick_startup_watchdog", lambda extra_s=0.0: kicks.append(1))
+    monkeypatch.setattr(run_bootstrap, "_host_lock_held_by_predecessor", lambda _home: False)
+    owner = ProfileOwnership()
+    owner.reserve([home])
+    try:
+        await run_bootstrap._start_gateway_wait_for_runtime_lock([], 0.2)
+    finally:
+        owner.close()
+    assert len(kicks) >= 3
diff --git a/website/docs/user-guide/messaging/index.md b/website/docs/user-guide/messaging/index.md
index a582528077..5c65a98320 100644
--- a/website/docs/user-guide/messaging/index.md
+++ b/website/docs/user-guide/messaging/index.md
@@ -707,6 +707,28 @@ An installed unit (or launchd plist) belongs to the `HERMES_HOME` it pins. A gat
 If you run multiple Hermes installations on the same machine (with different `HERMES_HOME` directories), each gets its own systemd service name. The default `~/.hermes` uses `hermes-gateway`; other installations use `hermes-gateway-<hash>`. The `hermes gateway` commands automatically target the correct service for your current `HERMES_HOME`.
 :::
 
+### Standby gateway for rolling updates
+
+One gateway owns a `HERMES_HOME` at a time; a second one exits with code `1`.
+When a new gateway must replace a running one that shares the home on the same
+volume (a Kubernetes rolling update with both pods on one node, two containers
+on one volume, each in its own PID namespace), let the new one wait instead:
+
+```yaml title="~/.hermes/config.yaml"
+gateway:
+  runtime_lock_wait_seconds: 700
+```
+
+A gateway started next to a running one in the same PID namespace still refuses
+or attaches as before. The waiting gateway loads its modules and plugins first, then retries the
+profile lock and takes over within a fraction of a second of the old gateway's
+exit. It opens no store, port or platform connection until it owns the
+profile. While it waits, `gateway.standby` exists in `HERMES_HOME`, so a
+supervisor can stop the old gateway only once its successor is ready (for
+example a Kubernetes `preStop` hook that waits for the file). When the wait runs out it exits as before. Set the wait above the old
+gateway's drain (`agent.restart_drain_timeout`) plus its shutdown. The default
+`0` keeps the immediate exit.
+
 ### macOS (launchd)
 
 ```bash
