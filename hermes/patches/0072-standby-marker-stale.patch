new file mode 100644
index 00000000..6dd8ce40
--- /dev/null
+++ b/tests/gateway/test_standby_marker_stale.py
@@ -0,0 +1,99 @@
+"""gateway.standby: a marker left by a killed standby does not outlive it."""
+import asyncio
+import json
+import os
+import socket
+import time
+
+import pytest
+
+from gateway import run_bootstrap
+from gateway.runtime_ownership import ProfileOwnership, process_ownership
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    home = tmp_path / "home"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr("gateway.run.get_hermes_home", lambda: home)
+    monkeypatch.setattr(run_bootstrap, "_prewarm_before_runtime_lock", lambda config=None: None)
+    monkeypatch.setattr(run_bootstrap, "_host_lock_held_by_predecessor", lambda _home: False)
+    monkeypatch.setattr(run_bootstrap, "RUNTIME_LOCK_POLL_S", 0.02)
+    yield home
+    process_ownership.close()
+
+
+def _leftover(home, age_s):
+    marker = home / "gateway.standby"
+    marker.write_text(json.dumps({"pid": 99999, "hostname": "gone-pod"}), encoding="utf-8")
+    then = time.time() - age_s
+    os.utime(marker, (then, then))
+    return marker
+
+
+@pytest.mark.platforms("linux")
+def test_owner_removes_a_marker_left_by_a_killed_standby(home):
+    marker = _leftover(home, run_bootstrap.STANDBY_MARKER_STALE_S + 5)
+    assert run_bootstrap._start_gateway_reserve_profiles([])
+    assert not marker.exists()
+
+
+@pytest.mark.platforms("linux")
+def test_owner_keeps_the_marker_of_a_standby_that_still_waits(home):
+    marker = _leftover(home, 0)
+    assert run_bootstrap._start_gateway_reserve_profiles([])
+    assert marker.exists()
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.asyncio
+async def test_free_profile_with_a_leftover_marker_is_taken_and_cleaned(home):
+    marker = _leftover(home, 3600)
+    await run_bootstrap._start_gateway_wait_for_runtime_lock([], 30)
+    assert run_bootstrap._start_gateway_reserve_profiles([])
+    assert not marker.exists()
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.asyncio
+async def test_waiting_standby_keeps_its_marker_fresh_and_names_its_host(home, monkeypatch):
+    monkeypatch.setattr(run_bootstrap, "STANDBY_MARKER_REFRESH_S", 0.1)
+    owner = ProfileOwnership()
+    owner.reserve([home])
+    waiter = asyncio.create_task(run_bootstrap._start_gateway_wait_for_runtime_lock([], 30))
+    try:
+        marker = home / "gateway.standby"
+        for _ in range(100):
+            if marker.exists():
+                break
+            await asyncio.sleep(0.02)
+        assert json.loads(marker.read_text())["hostname"] == socket.gethostname()
+        old = time.time() - 3600
+        os.utime(marker, (old, old))
+        assert not run_bootstrap.standby_marker_is_fresh(marker)
+        await asyncio.sleep(0.3)
+        assert run_bootstrap.standby_marker_is_fresh(marker)
+        assert not run_bootstrap.remove_stale_standby_marker(home)
+    finally:
+        owner.close()
+        await asyncio.wait_for(waiter, 5)
+    assert not (home / "gateway.standby").exists()
+
+
+def test_relay_ignores_a_stale_marker(home, monkeypatch):
+    marker = home / "gateway.standby"
+    marker.write_text(json.dumps({"listener": {"host": "10.0.0.9", "port": 9120, "netns": "net:[1]"}}),
+                      encoding="utf-8")
+    monkeypatch.setattr("gateway.listener_relay.net_namespace_id", lambda: "net:[2]")
+
+    class Runner:
+        _listener_handover = True
+
+        class config:
+            restart_listener_relay_seconds = 30
+
+    assert run_bootstrap._listener_relay_target(Runner()) == ("10.0.0.9", 9120)
+    old = time.time() - 3600
+    os.utime(marker, (old, old))
+    assert run_bootstrap._listener_relay_target(Runner()) is None
