diff --git a/gateway/run_bootstrap.py b/gateway/run_bootstrap.py
index c8b6c752..2aefec60 100644
--- a/gateway/run_bootstrap.py
+++ b/gateway/run_bootstrap.py
@@ -643,6 +643,11 @@ RUNTIME_LOCK_POLL_S = 0.2
 # Present while a warmed-up standby waits for the profile lock, so a supervisor can stop the owner
 # only once its successor is ready to take over (for example a Kubernetes preStop hook).
 STANDBY_MARKER = "gateway.standby"
+# The waiting standby touches its marker this often, and a marker untouched for STANDBY_MARKER_STALE_S
+# is left over from a standby that died (SIGKILL, OOM) while it waited: readers ignore it and the next
+# gateway that owns the profile removes it. A probe can test the same age (``find -newermt``).
+STANDBY_MARKER_REFRESH_S = 2.0
+STANDBY_MARKER_STALE_S = 10.0
 _RUNTIME_LOCK_PREWARM_MODULES = (
     "gateway.run_runtime", "gateway.run_startup", "gateway.run_api", "gateway.run_adapters",
     "gateway.session_authorities", "run_agent", "model_tools", "tui_gateway.server",
@@ -744,10 +749,53 @@ def _host_lock_held_by_predecessor(home) -> bool:
     return record is None or not record.home or canonical_home(Path(record.home)) == canonical_home(home)
 
 
+def standby_marker_is_fresh(path, now: Optional[float] = None) -> bool:
+    """True while a live standby keeps touching the marker at *path*."""
+    import os
+    try:
+        age = (time.time() if now is None else now) - os.stat(path).st_mtime
+    except OSError:
+        return False
+    return age < STANDBY_MARKER_STALE_S
+
+
+def remove_stale_standby_marker(home) -> bool:
+    """Remove a ``gateway.standby`` in *home* that no live standby touches any more. A fresh one is a
+    successor that waits for this gateway, so it stays. True when one was removed."""
+    path = Path(home) / STANDBY_MARKER
+    if not path.exists() or standby_marker_is_fresh(path):
+        return False
+    try:
+        path.unlink()
+    except FileNotFoundError:
+        return False
+    except OSError:
+        logger.debug("Could not remove the stale %s", path, exc_info=True)
+        return False
+    logger.info("Removed %s left by a standby that no longer runs", path)
+    return True
+
+
+def _touch_standby_marker(path) -> None:
+    import os
+    try:
+        os.utime(path)
+    except FileNotFoundError:
+        _write_standby_marker(path)
+    except OSError:
+        logger.debug("Could not touch %s", path, exc_info=True)
+
+
 def _write_standby_marker(path) -> None:
+    import socket
     from gateway.status import _build_pid_record
     from utils import atomic_json_write
     record = {**_build_pid_record(), "since": time.time()}
+    try:
+        # Which pod waits: a probe on a volume that two pods share reads only its own marker.
+        record["hostname"] = socket.gethostname()
+    except OSError:
+        pass
     try:
         # Where the gateway being replaced relays to (gateway.restart_listener_relay_seconds).
         from gateway.listener_relay import standby_listener_record
@@ -790,6 +838,7 @@ async def _start_gateway_wait_for_runtime_lock(profile_homes, wait_s: float, con
     _prewarm_before_runtime_lock(config)
     marker = launch_home / STANDBY_MARKER
     waited = False
+    touched = 0.0
     try:
         while True:
             try:
@@ -804,10 +853,17 @@ async def _start_gateway_wait_for_runtime_lock(profile_homes, wait_s: float, con
                 logger.info("Another gateway owns %s; waiting up to %.0fs for it to exit", launch_home, wait_s)
                 _write_standby_marker(marker)
                 waited = True
+                touched = time.monotonic()
+            elif time.monotonic() - touched >= STANDBY_MARKER_REFRESH_S:
+                _touch_standby_marker(marker)
+                touched = time.monotonic()
             kick_startup_watchdog()  # an idle wait, not a stalled boot
             await asyncio.sleep(RUNTIME_LOCK_POLL_S)
         while _host_lock_held_by_predecessor(launch_home) and time.monotonic() < deadline:
             waited = True
+            if time.monotonic() - touched >= STANDBY_MARKER_REFRESH_S:
+                _touch_standby_marker(marker)
+                touched = time.monotonic()
             await asyncio.sleep(RUNTIME_LOCK_POLL_S / 4)
     finally:
         if waited:
@@ -845,6 +901,9 @@ def _start_gateway_reserve_profiles(profile_homes) -> bool:
     except OSError as exc:
         logger.error("Cannot reserve gateway profiles: %s", exc)
         return False
+    # The profile is ours now: a standby marker nobody touches is left over from a killed standby, and
+    # a probe that reads it would skip this gateway's health check.
+    remove_stale_standby_marker(homes[0])
     return True
 
 
@@ -857,7 +916,10 @@ def _listener_relay_target(runner) -> Optional[tuple]:
     try:
         from gateway.listener_relay import successor_target
         from gateway.run import get_hermes_home
-        return successor_target(get_hermes_home() / STANDBY_MARKER)
+        marker = get_hermes_home() / STANDBY_MARKER
+        if not standby_marker_is_fresh(marker):
+            return None
+        return successor_target(marker)
     except Exception:
         logger.debug("No listener relay target", exc_info=True)
         return None
