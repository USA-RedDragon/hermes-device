+def test_rehydrated_previous_summary_and_salvage_carry_a_marker_not_the_body():
+    from agent.context_compressor import _SUMMARY_END_MARKER, COMPRESSED_SUMMARY_METADATA_KEY, salvage_grown_transcript
+    from agent.compaction_skill_pin import active_skill_block
+
+    handoff = SUMMARY_PREFIX + "\n\n## Goal\nOld work." + active_skill_block("pdf", PDF_BODY)
+    assert active_skills_as_markers(handoff).endswith(_skill_pruned_marker("pdf"))
+    # A restarted process rebuilds the summarizer's previous-summary input from the handoff row.
+    c = _compressor()
+    msgs = [{"role": "system", "content": "System prompt"}, {"role": "user", "content": handoff}] + _chatter(8)
+    response = MagicMock()
+    response.choices = [MagicMock()]
+    response.choices[0].message.content = "## Goal\nWork."
+    with (
+        patch.object(c, "_find_tail_cut_by_tokens", return_value=len(msgs) - 2),
+        patch("agent.context_compressor.call_llm", return_value=response) as call,
+    ):
+        c.compress(msgs, force=True)
+    prompt = json.dumps(call.call_args.kwargs.get("messages") or call.call_args.args)
+    assert "RULE: cite page numbers." not in prompt
+    assert "reload with skill_view(name='pdf')" in prompt
+    # The salvage cap cuts a long handoff from the end; it must not leave half a skill body behind.
+    original = msgs + [{"role": "tool", "tool_call_id": "x", "content": "z" * 200_000}]
+    long_handoff = SUMMARY_PREFIX + "\n\n## Goal\nOld work." + active_skill_block("pdf", PDF_BODY * 3)
+    carrier = {"role": "user", "content": f"{long_handoff}\n\n{_SUMMARY_END_MARKER}",
+               COMPRESSED_SUMMARY_METADATA_KEY: True}
+    candidate = [msgs[0], carrier, {"role": "user", "content": "latest"}]
+    salvaged = salvage_grown_transcript(original, candidate)
+    assert salvaged and "RULE: cite page numbers." not in salvaged[1]["content"]
+    assert _skill_pruned_marker("pdf") in salvaged[1]["content"]
+
