diff --git a/agent/compaction_skill_pin.py b/agent/compaction_skill_pin.py
new file mode 100644
index 0000000000..d81bf2fa82
--- /dev/null
+++ b/agent/compaction_skill_pin.py
@@ -0,0 +1,157 @@
+"""Opt-in ``compression.keep_last_skill_chars``: the most recently loaded skill stays usable across compaction.
+
+A skill loaded early in a session is far outside the just-loaded window that spares ``skill_view`` bodies
+from demotion, so compaction turns it into a ``[SKILL_PRUNED]`` reload marker and the model reloads the whole
+body. With the cap set, the newest skill's body rides the handoff when it is at most the cap, and when a kept
+head or tail row still holds the body, the markers for it are dropped instead of asking for a reload. Older
+skills keep their markers, and a body over the cap falls back to the marker, so a large skill cannot defeat
+compaction on a small window."""
+
+from __future__ import annotations
+
+import re
+from typing import Any, Optional
+
+ACTIVE_SKILL_HEADING = "## Active Skill"
+_ACTIVE_SKILL_OPEN = "<active-skill>"
+_ACTIVE_SKILL_CLOSE = "</active-skill>"
+_ACTIVE_SKILL_RE = re.compile(
+    r"\n*" + re.escape(ACTIVE_SKILL_HEADING) + r": (?P<name>[^\n]+)\n[^\n]*\n"
+    + re.escape(_ACTIVE_SKILL_OPEN) + r"\n(?P<body>.*?)\n" + re.escape(_ACTIVE_SKILL_CLOSE),
+    re.DOTALL,
+)
+
+
+def active_skill_block(name: str, body: str) -> str:
+    """The handoff section that carries *body* as the active instructions of skill *name*."""
+    return (
+        f"\n\n{ACTIVE_SKILL_HEADING}: {name}\n"
+        f"Exception to the reference-only note above: these are the current instructions of the skill '{name}', "
+        "the most recently loaded one, kept verbatim through compaction. Follow them; do not reload this skill, "
+        f"and treat any [SKILL_PRUNED] marker for '{name}' as satisfied by this copy.\n"
+        f"{_ACTIVE_SKILL_OPEN}\n{body}\n{_ACTIVE_SKILL_CLOSE}"
+    )
+
+
+def active_skills(text: str) -> list[tuple[str, str]]:
+    """``(name, body)`` of every active-skill section in *text*, in order."""
+    return [(m.group("name"), m.group("body")) for m in _ACTIVE_SKILL_RE.finditer(text or "")]
+
+
+def active_skills_as_markers(text: str) -> str:
+    """*text* with each active-skill section replaced by that skill's reload marker. For copies of a handoff
+    that must not carry a body: the summarizer's previous-summary input and the salvage cap."""
+    from agent.context_compressor import _skill_pruned_marker
+
+    return _ACTIVE_SKILL_RE.sub(lambda m: "\n" + _skill_pruned_marker(m.group("name")), text or "")
+
+
+def _skill_load(message: dict[str, Any], calls: dict[str, tuple]) -> Optional[tuple[str, Optional[str]]]:
+    """``(name, body)`` when *message* loaded a skill (body ``None`` once only a stub is left), else ``None``.
+    A ``skill_view`` of a supporting file, a failed view and a repeat-view dedup result load no skill."""
+    from agent.context_compressor import (
+        _content_text_for_contains, _json_dict, _skill_view_failed, is_compaction_summary_message,
+    )
+    from agent.skill_commands import skill_invocation_body, skills_loaded_by_scaffold
+
+    role, content = message.get("role"), message.get("content")
+    if role == "tool":
+        tool, raw_args = calls.get(str(message.get("tool_call_id") or ""), ("", ""))
+        args = _json_dict(raw_args)
+        name = args.get("name")
+        if (
+            tool != "skill_view" or args.get("file_path") or not isinstance(name, str) or not name
+            or not isinstance(content, str) or _skill_view_failed(content)
+        ):
+            return None
+        payload = _json_dict(content)
+        if payload.get("dedup"):
+            return None
+        body = payload.get("content") if payload.get("success") else None
+        if not isinstance(body, str) or not body.strip():
+            return name, None
+        linked = payload.get("linked_files") if isinstance(payload.get("linked_files"), dict) else {}
+        paths = [str(p) for group in linked.values() if isinstance(group, list) for p in group]
+        if paths:
+            body += f"\n\n[Linked files, load with skill_view(name='{name}', file_path=...): {', '.join(paths)}]"
+        return name, body
+    text = _content_text_for_contains(content)
+    if is_compaction_summary_message(message):
+        found = active_skills(text)
+        return found[-1] if found else None
+    if role == "user" and (names := skills_loaded_by_scaffold(text)):
+        return names[-1], skill_invocation_body(text) if len(names) == 1 else None
+    return None
+
+
+def _kept_note(name: str) -> str:
+    return f"[SKILL_KEPT: the body of '{name}' is still in context]"
+
+
+_KEPT_NOTE_RE = re.compile(r"\[SKILL_KEPT: the body of '([^']+)' is still in context\]")
+
+
+def _retag_kept_rows(rows: list[dict[str, Any]], indices: list[int], kept: Optional[str]) -> list[dict[str, Any]]:
+    """*rows* with the reload marker on kept tool rows for skill *kept* turned into a kept note, and the kept
+    note of any other skill turned back into its marker. Changed rows are copies."""
+    from agent.context_compressor import _skill_pruned_marker
+
+    out = rows
+    for i in indices:
+        content = rows[i].get("content")
+        if rows[i].get("role") != "tool" or not isinstance(content, str):
+            continue
+        new = content.replace(_skill_pruned_marker(kept), _kept_note(kept)) if kept else content
+        new = _KEPT_NOTE_RE.sub(lambda m: m.group(0) if m.group(1) == kept else _skill_pruned_marker(m.group(1)), new)
+        if new != content:
+            out = list(out) if out is rows else out
+            out[i] = {**rows[i], "content": new}
+    return out
+
+
+def keep_last_skill(
+    summary: str, messages: list[dict[str, Any]], working: list[dict[str, Any]], head_end: int, tail_start: int,
+    max_chars: int,
+) -> tuple[str, list[dict[str, Any]], Optional[str]]:
+    """``(summary, working, pinned_name)`` for one compaction. *messages* is the unpruned transcript, *working*
+    its pruned copy whose rows before *head_end* and from *tail_start* stay around the handoff.
+
+    The newest skill load in *messages* is kept when a kept row still holds its body, or else when its body is
+    at most *max_chars*: then it rides *summary* as an active-skill section (``pinned_name``). A kept skill's
+    reload markers leave the summary and the kept rows. A skill an earlier compaction kept that is not kept
+    now gets its markers back, also with ``max_chars <= 0`` (the key turned off); with nothing kept earlier
+    that returns the input unchanged."""
+    from agent.context_compressor import (
+        _PRUNED_SKILLS_SECTION_HEADING, _content_text_for_contains, _redact_compaction_text,
+        _reinject_pruned_skill_markers, _skill_pruned_marker, _tool_calls_by_id, is_compaction_summary_message,
+    )
+
+    carried: list[str] = []
+    for m in messages:
+        text = _content_text_for_contains(m.get("content"))
+        carried += _KEPT_NOTE_RE.findall(text)
+        if is_compaction_summary_message(m) and (found := active_skills(text)):
+            carried.append(found[-1][0])
+    kept_rows = [*range(min(head_end, len(working))), *range(tail_start, len(working))]
+    name = body = None
+    held = False
+    if max_chars > 0:
+        calls = _tool_calls_by_id(messages)
+        name, body = next(filter(None, (_skill_load(m, calls) for m in reversed(messages))), (None, None))
+        held = name is not None and any(
+            not is_compaction_summary_message(working[i]) and (load := _skill_load(working[i], calls))
+            and load[0] == name and load[1] for i in kept_rows
+        )
+        if not (held or (body is not None and len(body) <= max_chars)):
+            name = None
+    working = _retag_kept_rows(working, kept_rows, name)
+    carried = list(dict.fromkeys(n for n in carried if n != name))
+    if name is None:
+        return _reinject_pruned_skill_markers(summary, carried), working, None
+    marker = _skill_pruned_marker(name)
+    summary = summary.replace(marker + "\n", "").replace(marker, "")
+    summary = re.sub(r"\n*" + re.escape(_PRUNED_SKILLS_SECTION_HEADING) + r"\s*(?=\n\n## |\Z)", "", summary)
+    summary = _reinject_pruned_skill_markers(summary, carried)
+    if held:
+        return summary, working, None
+    return summary + _redact_compaction_text(active_skill_block(name, body)), working, name
