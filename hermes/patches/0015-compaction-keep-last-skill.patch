         # Usable input = context_length - max_tokens; only a positive int counts as a reservation.
@@ -5129,7 +5133,10 @@ Write only the summary body. Do not include any preamble or prefix."""
 
         summary_idx, summary_body = summary_hits[-1]
         if not self._previous_summary:
-            self._previous_summary = "\n\n".join(body for _, body in summary_hits if body) or self._previous_summary
+            from agent.compaction_skill_pin import active_skills_as_markers
+            self._previous_summary = "\n\n".join(
+                active_skills_as_markers(body) for _, body in summary_hits if body
+            ) or self._previous_summary
         # Zero-user provenance (#64650) rides on the newest handoff hit.
         provenance = messages[summary_idx].get(COMPRESSED_SUMMARY_HAS_USER_TURN_KEY)
         if real_user_present:
@@ -5532,10 +5539,27 @@ Write only the summary body. Do not include any preamble or prefix."""
             summary = self._fallback_summary_for_window(
                 telemetry, turns_to_summarize, compress_end - compress_start, feasibility_skip,
             )
+        summary, messages = self._keep_last_skill(
+            summary, canonical_messages, messages, compress_start, max(compress_end, scan.tail_start),
+        )
         # Phase 4: Assemble compressed message list
         compressed = self._assemble_compressed(messages, compress_start, compress_end, scan, summary)
         return self._finalize_compressed(compressed, canonical_messages, n_messages, spare_pending_images, pruned_count)
 
+    def _keep_last_skill(
+        self, summary: str, canonical: list[dict[str, Any]], messages: list[dict[str, Any]], head_end: int,
+        tail_start: int,
+    ) -> tuple[str, list[dict[str, Any]]]:
+        """``compression.keep_last_skill_chars``: keep the newest skill's body across this compaction."""
+        from agent.compaction_skill_pin import keep_last_skill
+
+        summary, messages, pinned = keep_last_skill(
+            summary, canonical, messages, head_end, tail_start, self.keep_last_skill_chars,
+        )
+        if pinned and not self.quiet_mode:
+            logger.info("Compaction kept the body of skill %r on the handoff", pinned)
+        return summary, messages
+
