+    assert active_skills(handoff) == [("pdf", PDF_BODY)]
+    assert _skill_pruned_marker("pdf") not in "\n".join(str(m.get("content")) for m in result)
+    assert "## Pruned Skills" not in handoff and SKILL_SAFETY_RULE not in handoff
+    # The iterative-summary base never carries the body: the next summarizer call would pay for it.
+    assert "RULE: cite page numbers." not in c._previous_summary
+
+
+def test_body_over_the_cap_keeps_the_marker():
