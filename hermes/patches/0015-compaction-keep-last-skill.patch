+
+def test_slash_skill_turn_keeps_the_body_but_not_the_typed_instruction():
+    note = ('[IMPORTANT: The user has invoked the "pdf" skill, indicating they want '
+            "you to follow its instructions. The full skill content is loaded below.]")
+    invocation = _build_skill_message({"name": "pdf", "content": PDF_BODY}, Path("/skills/pdf"), note,
+                                      user_instruction="remember PLUM-77")
+    body = skill_invocation_body(invocation)
+    assert body.startswith(PDF_BODY.strip()) and "PLUM-77" not in body and note not in body
+    msgs = _early_skill_transcript()
