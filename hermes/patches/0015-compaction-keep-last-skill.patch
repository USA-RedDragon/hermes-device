+def test_head_stub_does_not_ask_to_reload_a_body_the_head_still_holds():
+    """First compaction protects the head: a /skill turn keeps its body there while the skill_view right after
+    it is demoted to a stub whose marker asked for a needless reload of the same body."""
+    note = ('[IMPORTANT: The user has invoked the "pdf" skill, indicating they want '
+            "you to follow its instructions. The full skill content is loaded below.]")
+    big = PDF_BODY * 20
+    invocation = _build_skill_message({"name": "pdf", "content": big}, Path("/skills/pdf"), note, user_instruction="go")
+    msgs = (
+        [{"role": "system", "content": "System prompt"}, {"role": "user", "content": invocation}]
+        + _skill_view("call_pdf", "pdf", big) + _chatter(13)[1:]
+        + [{"role": "user", "content": "latest ask"}, {"role": "assistant", "content": "ack"}]
+    )
+    off = "\n".join(str(m.get("content")) for m in _compress(_compressor(protect_first_n=3), msgs))
+    assert _skill_pruned_marker("pdf") in off
+
+    c = _compressor(protect_first_n=3, keep_last_skill_chars=1_000)
+    result = _compress(c, msgs)
+    texts = "\n".join(str(m.get("content")) for m in result)
+    assert "[SKILL_PRUNED:" not in texts and SKILL_SAFETY_RULE not in texts
+    assert texts.count("RULE: cite page numbers.") == 20 and active_skills(texts) == []
+    assert "[SKILL_KEPT: the body of 'pdf' is still in context]" in result[3]["content"]
+
+    # Turned off, the next compaction folds the head away and lists the skill for reload again.
+    c.keep_last_skill_chars = 0
+    handoff = _handoff(_compress(c, result + _chatter(12) + _ask("next")))
+    assert _skill_pruned_marker("pdf") in handoff
