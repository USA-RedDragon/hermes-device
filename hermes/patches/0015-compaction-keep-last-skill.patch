@@ -203,6 +203,22 @@ def skills_loaded_by_scaffold(content: Any) -> list[str]:
     return [match.group(1)] if header.endswith(_SINGLE_SKILL_MARKER) and match and match.group(1) else []
 
 
+def skill_invocation_body(content: Any) -> Optional[str]:
+    """The skill payload a single ``/skill`` turn carries inline, without the activation note, the user's
+    instruction or a runtime note; ``None`` for any other text, bundles and gateway auto-loads included."""
+    if not isinstance(content, str) or not content.startswith(_SKILL_INVOCATION_PREFIX):
+        return None
+    header, _, payload = content.partition("\n")
+    if not header.endswith(_SINGLE_SKILL_MARKER) or _BUNDLE_MARKER in header:
+        return None
+    # The instruction follows the skill body (which may quote the marker): LAST marker is the user's.
+    for marker in ("\n" + _SINGLE_SKILL_INSTRUCTION, _RUNTIME_NOTE):
+        if (cut := payload.rfind(marker)) >= 0:
+            payload = payload[:cut]
+            break
+    return payload.strip() or None
+
+
 def _cut_after(message: str, marker: str, stop_marker: str, find) -> Optional[str]:
     """Text between *marker* (located with ``find``) and *stop_marker*, stripped; None if absent/empty."""
     marker_idx = find(marker)
