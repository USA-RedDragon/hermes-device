+    second = _compress(c, first + _chatter(12) + _ask("next ask"))
+    assert active_skills(_handoff(second)) == [("pdf", PDF_BODY)]
+    third = _compress(c, second + _skill_view("call_sheets", "sheets", SHEET_BODY) + _chatter(12) + _ask("third ask"))
+    handoff = _handoff(third)
+    assert active_skills(handoff) == [("sheets", SHEET_BODY)]
