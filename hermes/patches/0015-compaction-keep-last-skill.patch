diff --git a/tests/agent/test_compaction_skill_pin.py b/tests/agent/test_compaction_skill_pin.py
new file mode 100644
index 0000000000..ace3c43f28
--- /dev/null
+++ b/tests/agent/test_compaction_skill_pin.py
@@ -0,0 +1,244 @@
+"""``compression.keep_last_skill_chars``: the handoff keeps the most recently loaded skill's body.
+
+Without it, a skill loaded early in a session sits outside the just-loaded window
+(``_SKILL_PRUNE_RECENT_WINDOW``) and the protected tail, so compaction replaces its body with a
+``[SKILL_PRUNED]`` marker and the model reloads the whole skill on the next turn.
+"""
+
+import json
+from pathlib import Path
+from unittest.mock import MagicMock, patch
+
+from agent.compaction_skill_pin import ACTIVE_SKILL_HEADING, active_skills, active_skills_as_markers
+from agent.context_compressor import SUMMARY_PREFIX, ContextCompressor, _skill_pruned_marker
+from agent.context_compressor_tail import SKILL_SAFETY_RULE
+from agent.skill_commands import _build_skill_message, skill_invocation_body
+from hermes_cli.config_defaults import DEFAULT_CONFIG
+
+PDF_BODY = "# pdf\nRULE: cite page numbers.\n" + "pdf skill prose. " * 200
+SHEET_BODY = "# sheets\nRULE: freeze the header row.\n" + "sheet skill prose. " * 100
+
+
+def _compressor(**overrides):
+    kwargs = dict(model="test/model", quiet_mode=True, protect_first_n=1, protect_last_n=2)
+    kwargs.update(overrides)
+    with patch("agent.context_compressor.get_model_context_length", return_value=100_000):
+        return ContextCompressor(**kwargs)
+
+
+def _skill_view(call_id, name, body, file_path=None):
+    args = {"name": name, **({"file_path": file_path} if file_path else {})}
+    return [
+        {"role": "assistant", "content": "", "tool_calls": [{
+            "id": call_id, "type": "function", "function": {"name": "skill_view", "arguments": json.dumps(args)},
+        }]},
+        {"role": "tool", "tool_call_id": call_id,
+         "content": json.dumps({"success": True, "name": name, "content": body})},
+    ]
+
+
+def _chatter(n):
+    return [
+        {"role": "user" if i % 2 == 0 else "assistant", "content": f"turn {i} " + "w" * 300}
+        for i in range(n)
+    ]
+
+
+def _ask(text):
+    return [{"role": "user", "content": text}, {"role": "assistant", "content": "ok"}]
+
+
+def _compress(c, msgs, summary="## Goal\nWork on the report."):
+    response = MagicMock()
+    response.choices = [MagicMock()]
+    response.choices[0].message.content = summary
+    with (
+        patch.object(c, "_find_tail_cut_by_tokens", return_value=len(msgs) - 2),
+        patch("agent.context_compressor.call_llm", return_value=response),
+    ):
+        return c.compress(msgs, force=True)
+
+
+def _handoff(result):
+    return next(m["content"] for m in result if ContextCompressor.classify_summary_content(m.get("content")))
+
+
+def _early_skill_transcript(body=PDF_BODY):
+    return (
+        [{"role": "system", "content": "System prompt"}, {"role": "user", "content": "Build the PDF report"}]
+        + _skill_view("call_pdf", "pdf", body)
+        + _chatter(12)
+        + [{"role": "user", "content": "latest ask"}, {"role": "assistant", "content": "ack"}]
+    )
+
+
+def test_off_by_default_an_early_skill_becomes_a_reload_marker():
+    assert DEFAULT_CONFIG["compression"]["keep_last_skill_chars"] == 0
+    c = _compressor()
+    assert c.keep_last_skill_chars == 0
+    handoff = _handoff(_compress(c, _early_skill_transcript()))
+    assert _skill_pruned_marker("pdf") in handoff
+    assert "RULE: cite page numbers." not in handoff
+    assert ACTIVE_SKILL_HEADING not in handoff
